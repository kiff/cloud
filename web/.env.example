# .env.example, in the web module's directory
#
# Copy to .env beside it (gitignored) for local development.
# Production deploys resolve these from AWS Secrets Manager via
# the deploy script; this file documents what the binary reads.

# ─── Listen address ──────────────────────────────────────────────

# Default :8081. Override when running multiple web instances.
# KIFF_WEB_ADDR=:8181

# ─── Cross-binary calls to apps/api ──────────────────────────────

# apps/api root. Required when KIFF_AUTH_PROVIDER is set so the
# dashboard can hit /v1/me, /v1/templates, /v1/keys, /v1/receipts.
KIFF_API_BASE_URL=http://localhost:8080

# Operator API key for the legacy public-receipt-render path
# (/dashboard/receipts/{trace_id} when no session). Optional once
# the dashboard's per-session path is the primary surface.
# KIFF_DEMO_API_KEY=kiff_live_demo...

# ─── Dashboard auth path ─────────────────────────────────────────

# Selects the sign-in provider for /dashboard/*. Three states:
#
#   unset  — sign-in / dashboard routes are not mounted; web
#            serves only the marketing site.
#   stub   — local dev only. Renders a one-field email form;
#            the literal email is forwarded as the bearer to
#            apps/api (which must run with the same stub mode).
#   clerk  — production. Redirects /sign-in to Clerk's hosted
#            Account Portal; the callback verifies the dropped
#            __session JWT via clerksdk. Requires the three
#            CLERK_/KIFF_CLERK_ env vars below.
#
# KIFF_AUTH_PROVIDER=stub

# HMAC secret signing the dashboard's session + flash cookies.
# Required when the auth path is active. 32+ bytes. Rotate to
# invalidate every active session at once.
# Local dev: any 32-byte string.
# Prod: kiff/cloud/web-session-secret in AWS Secrets Manager.
# KIFF_SESSION_SECRET=local-dev-secret-32-bytes-or-more-please

# Comma-separated allow-list of stub-mode subjects. Empty allows
# any. Ignored in clerk mode.
# KIFF_STUB_SUBJECTS=alice@example.com

# Cookie security. Default true (HTTPS-only). Set false only for
# local plain-HTTP dev.
# KIFF_COOKIE_SECURE=false

# ─── Clerk (only when KIFF_AUTH_PROVIDER=clerk) ─────────────────

# Clerk Backend API secret. Same value the apps/api binary reads.
# Used here to verify Clerk's __session JWT on the callback.
# CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Clerk publishable key. Public; embedded in HTML for future
# Clerk-frontend-SDK integrations. Production uses pk_live_...
# KIFF_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Clerk frontend API host. For dev: <funny-name>-NN.clerk.accounts.dev.
# For prod with the custom CNAME wired: clerk.kiff.dev.
# KIFF_CLERK_FRONTEND_API=clerk.kiff.dev
