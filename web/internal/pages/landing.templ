package pages

import "github.com/kiff/cloud/web/internal/components"

// Landing is at most four phone screens: what KIFF is, how it works in
// three steps, one line of proof, and one action (/delegate, the sample
// walkthrough, before any sign-in). The detail lives on the pages it links.
// Components live in home.templ; styles in css/home.css.
templ Landing(activeExample, activeStack, activeAgent string) {
	@components.LayoutSiteWithMeta(
		"KIFF — Cards for AI agents",
		"Give each AI agent a KIFF Card: what it may do, and how much. Past it, the work waits for a person. Change or revoke the Card without changing the agent.",
		"website", "", "css/landing.css", "css/home.css",
	) {
		<div class="k-home">
			@homeHero()
			@homeSteps()
			@homeWhy()
			@homeProof()
			@homeAction()
		</div>
	}
}
