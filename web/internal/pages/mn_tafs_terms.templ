package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsTermsMN is tafs's terms (/tafs/terms) in Mongolian, at /mn/tafs/terms.
// It is a translation of TafsTerms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Mongolian has the legal
// texts only, so a link to any other page goes to English and says so.
templ TafsTermsMN() {
	@components.LayoutSiteWithMeta("tafs-ийн нөхцөл", "KIFF-ийн апп tafs-ийн нөхцөл: үүнийг хэн үзүүлдэг, таны бүртгэл, taf юу хийдэг, та түүнийг хэрхэн хянах, зөвшөөрөгдөх хэрэглээ, төлбөр, хариуцлага, дуусгавар болох.", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · нөхцөл</p>
				<h1>tafs-ийн нөхцөл</h1>
				<p class="legal-meta"><strong>Сүүлд шинэчилсэн:</strong> 2026 оны арваннэгдүгээр сарын 21.</p>
				<p class="legal-disclaimer">Эдгээр нөхцөл нь KIFF-ийн iPhone, iPad, Android болон компьютерт зориулсан апп tafs болон түүний цаадах үйлчилгээнд хамаарна. tafs нь KIFF Cloud-ын нэг хэсэг бөгөөд энэ хуудас нь <a href="/mn/terms">KIFF-ийн Үйлчилгээний нөхцөл</a>-д tafs-ийн тухай заасныг дахин өгүүлж байгаа бөгөөд тэдгээрт юу ч нэмэхгүй. Энэ хуудас хамрахгүй бүхэнд KIFF-ийн Нөхцөл хамаарна. Асуулт: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.</p>
			</header>
			<section id="provider">
				<h2>1. tafs-ийг хэн үзүүлдэг</h2>
				<p>tafs-ийг Эстонид бүртгэлтэй хувийн хязгаарлагдмал хариуцлагатай компани <strong>Kiff Agents OÜ</strong> (бүртгэлийн код 17372313) үзүүлдэг, хаяг: Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Эстони. Бүртгэл үүсгэх эсвэл tafs-ийг өөр байдлаар ашигласнаар та эдгээр нөхцөл болон KIFF-ийн Нөхцөлийг зөвшөөрнө. Хэрэв та компанийн өмнөөс зөвшөөрч байгаа бол түүнийг үүрэгжүүлэх эрхтэй гэдгээ баталж байна.</p>
			</section>
			<section id="account">
				<h2>2. Таны бүртгэл</h2>
				<p>Та tafs-д KIFF бүртгэлээрээ нэвтэрнэ. Үнэн зөв мэдээлэл өгч, нэвтрэх мэдээллээ нууцалж байх бөгөөд таны бүртгэлийн дор хийгдсэн бүх үйл ажиллагаа болон та бүртгэлд оруулсан хүн бүрийн төлөө та хариуцлага хүлээнэ. Та хамгийн багадаа 16 настай, эсвэл амьдарч буй газрынхаа дижитал зөвшөөрлийн насанд хүрсэн байх ёстой, аль нь өндөр байна. Та tafs-ийг зөвхөн <a href="https://www.anthropic.com/supported-countries">Anthropic-ийн жагсаасан</a> ёсоор Anthropic өөрийн үйлчилгээгээ санал болгодог улс эсвэл бүс нутгаас ашиглаж болно; тухайн жагсаалтаас гадуурх улс эсвэл бүс нутагт төвтэй, эсвэл тийм төвтэй компанийн дийлэнх өмчлөл эсвэл хяналтад байдаг компанид зориулж ашиглаж болохгүй; мөн та, эсвэл таны ашиглаж буй компани Европын Холбоо, Нэгдсэн Үндэстний Байгууллага эсвэл АНУ-ын хориг арга хэмжээнд хамрагдсан бол ашиглаж болохгүй (KIFF-ийн Нөхцөл, §4).</p>
			</section>
			<section id="what-a-taf-does">
				<h2>3. taf юу хийдэг</h2>
				<p>tafs-д та ажлыг taf-д даалгадаг: энэ нь таны холбосон хэрэгслүүдээр хуваарийн дагуу ажилладаг, таны түүнд олгосон KIFF Card-уудын хүрээнд ажилладаг AI агент юм. Түүний ашигладаг AI загварыг Anthropic хангана. tafs дахь AI агент Setup нь хэрэгсэл холбох, taf тохируулахад тусалдаг боловч өөрөө юу ч холбодоггүй: та хэрэгслийн өөрийн үйлчилгээ үзүүлэгчид нэвтэрч, холболт бүр, taf-ын ашиглаж болох хэрэгслүүд болон түүний Card-уудыг өөрийн төхөөрөмж дээр зөвшөөрнө.</p>
				<p>taf-ын тайлан, мессеж, санах ойн тэмдэглэлийг AI загвар бичдэг бөгөөд алдаатай байж болно. Найдахаасаа өмнө чухал зүйлээ шалгаарай. Taf таны компаниас гадуурх хэн нэгэнд бичсэн бүхэн AI агент бичсэн гэдгийг заана.</p>
			</section>
			<section id="control">
				<h2>4. Таны хяналт: Card болон зөвшөөрөл</h2>
				<p>Taf таны хэрэгслүүдэд зөвхөн KIFF-ээр дамжуулан хүрдэг бөгөөд KIFF дуудлага бүрийг илгээхээс өмнө taf-ын Card-уудтай тулгаж шалгана. Таны олгосон Card-ийн хүрээн доторх дуудлагыг таны зааврын дагуу хийдэг. Card-аас гадуурх дуудлагыг Card-д заасны дагуу барьж эсвэл татгалздаг. Баригдсан дуудлагыг таны бүртгэл баригдсан дуудлагад хариулахыг зөвшөөрсөн хүн зөвшөөрсний дараа л хийдэг.</p>
				<p>Та taf бүрийн ажил болон Card-уудыг сонгож, түүний баригдсан дуудлагад хариулж, холбосон хэрэгсэл, бүртгэлээ ашиглах эрхтэй эсэхээ шалгана. Та нэг taf эсвэл бүгдийг зогсоох, taf-ыг түр зогсоох, түүний аль ч Card-ийг хүчингүй болгох, эсвэл устгах боломжтой. Таныг taf-ыг зогсоосон эсвэл Card-ийг хүчингүй болгосон мөчөөс эхлэн KIFF тэр taf-аас эсвэл тэр Card-ийн дор шинэ дуудлага зөвшөөрөхгүй. Хэрэгслийн үйлчилгээ үзүүлэгчид аль хэдийн илгээсэн хүсэлт дуусч болзошгүй: бид шинэ дуудлагыг зогсооно, харин үйлчилгээ үзүүлэгчийн хийснийг буцааж чадахгүй. Дэлгэрэнгүйг <a href="/mn/terms#tafs">KIFF-ийн Нөхцөл, §3A</a>-аас үзнэ үү. taf төлбөрийн хуудсан дээр тэр сайтад хадгалсан аргаар төлөхдөө зөвхөн Card-ын хүрээнд, мөн та уг төлбөрийг утсан дээрээ зөвшөөрсний дараа л төлнө; сайт болон түүний төлбөрийн үйлчилгээ үзүүлэгч үүнийг боловсруулах бөгөөд KIFF болон planque таны мөнгийг хэзээ ч атгахгүй, картын мэдээллийг хэзээ ч хадгалахгүй, taf картын дугаар хэзээ ч бичихгүй.</p>
				<p>ЕХ-ны AI тухай хуулийн дагуу Kiff Agents OÜ нь tafs-ийн үйлчилгээ үзүүлэгч, та түүнийг ашиглагч юм. tafs-ийг зөвхөн санал болгодог ажлуудад ашиглаж, AI тухай хуулиар хориглосон эсвэл өндөр эрсдэлтэй гэж ангилсан ямар ч хэрэглээнд, тухайлбал хүний хөдөлмөр эрхлэлт, зээл эсвэл чухал үйлчилгээнд хүртээмжтэй холбоотой шийдвэрт ашиглаж болохгүй.</p>
			</section>
			<section id="acceptable-use">
				<h2>5. Зөвшөөрөгдөх хэрэглээ</h2>
				<p>Та, таны хүмүүс болон таны taf-ууд <a href="/acceptable-use">Зөвшөөрөгдөх хэрэглээний бодлого</a> (англиар)-ыг дагах ёстой. Агентийн үйлдэл бол таны үйлдэл. Бусад зүйлсийн дотор та tafs-ийг хууль зөрчихөд, ашиглах эрхгүй систем эсвэл бүртгэл дээр үйлдэл хийхэд, өөрийнх нь биш нэвтрэлтээр хэрэгсэл холбоход, спам илгээхэд, эсвэл Card, хязгаар, барилтыг тойрч гарахад ашиглаж болохгүй. Найдвартай зөрчлийн үед бид тэр дор нь түр зогсоож болно.</p>
			</section>
			<section id="fees">
				<h2>6. Төлбөр</h2>
				<p>Энэ шинэчлэлийн үед Solo нь сард { tafsCostMN.money(TafsSoloCents) }, НӨАТ орсон, сард { tafsCostMN.number(TafsSoloCredits) } кредиттэй, аппаар дамжуулан App Store эсвэл Google Play-ээр зарагддаг. Аппаас худалдан авсан кредитийн багцууд { tafsCostMN.money(TafsPackCents[TafsSoloCredits]) }-аас эхэлдэг; тэдгээр нь дуусдаггүй. Taf-ын ажиллалт бүр ашигласан AI-д кредит зарцуулна. Coach болон taf тохируулах нь Coach-ийн боломжийн хэрэглээний хүрээнд багтдаг. Эдгээр нь евро бүсийн үнэ. Бусад газарт App Store эсвэл Google Play таны валютаар үнийг харуулна, тухайн улсын дүрмээр шаардлагатай бол орон нутгийн татвартай эсвэл татваргүй, тэр нь таны төлөх үнэ. Одоогийн үнийг <a href="/pricing">үнийн хуудас</a> (англиар)-аас харна уу; tafs нь KIFF-ийн Company төлөвлөгөөний нэг хэсэг юм.</p>
				<p>Туршилтын хугацаа байхгүй. Аппаас худалдан авсан Solo-г таны Apple эсвэл Google Play захиалгад удирдаж цуцлах бөгөөд төлбөр, сунгалт, буцаан олголтын тухай тухайн дэлгүүрийн нөхцөлөөр явагдана. Төлөвлөгөө нь таны төлсөн хугацаа дуустал үргэлжилнэ. Хэрэв та ЕХ-ны хэрэглэгч бол худалдан авснаас хойш 14 хоногийн дотор татгалзаж болно. Дэлгэрэнгүйг <a href="/mn/terms#fees">KIFF-ийн Нөхцөл, §8</a>-аас үзнэ үү.</p>
			</section>
			<section id="liability">
				<h2>7. Хариуцлага</h2>
				<p>tafs-ийг KIFF-ийн Нөхцөл дэх баталгаа (§10)-ыг эс тооцвол "байгаагаар нь" болон "боломжтой байх хэмжээгээр" үзүүлнэ. Хуулиар зөвшөөрөгдсөн хэмжээнд аль ч тал шууд бус эсвэл үр дагаварт хохирлыг хариуцахгүй бөгөөд тал бүрийн нийт хариуцлага <a href="/mn/terms#liability">KIFF-ийн Нөхцөл, §12</a>-т заасны дагуу хязгаарлагдана. Хуулиар хязгаарлахыг зөвшөөрдөггүй хариуцлагыг юу ч хязгаарлахгүй.</p>
			</section>
			<section id="termination">
				<h2>8. Дуусгавар болох</h2>
				<p>Та хэзээ ч зогсоож болно: аппаас бүртгэлээ устга, Бүртгэл → <em>Бүртгэл устгах</em>. Эхлээд чатуудаа экспортлоорой, Бүртгэл → Миний чатуудыг экспортлох. Мэдэгдсэнээс хойш гучин хоногт арилгаагүй ноцтой зөрчил, эсвэл Зөвшөөрөгдөх хэрэглээний зөрчлийн үед бид таны хэрэглээг тэр дор нь дуусгавар болгож болно. Таны гарч өөрийн өгөгдлөө авч явах эрх <a href="/mn/terms#term">KIFF-ийн Нөхцөл, §9</a>-д бий.</p>
			</section>
			<section id="governing-law">
				<h2>9. Өөрчлөлт ба хэрэглэгдэх хууль</h2>
				<p>Бид эдгээр нөхцөлийг KIFF-ийн Нөхцөл өөрийнхөө талаар заасан (§16) аргаар өөрчилнө. Тэдгээрт Бүгд Найрамдах Эстони Улсын хууль хамаарах бөгөөд маргааныг Таллин дахь Харью мужийн шүүх шийдвэрлэнэ. Хэрэв та ЕХ-ны өөр гишүүн улсын хэрэглэгч бол таны орон нутгийн хэрэглэгчийн хамгааллын заавал дагах дүрмүүд үргэлжлэн хамаарна.</p>
			</section>
			<section id="contact">
				<h2>10. Холбоо барих</h2>
				<p>Гэрээний асуулт: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>. Аппын тусламж: <a href="mailto:support@kiff.dev">support@kiff.dev</a>. Нууцлал: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>, tafs хувийн мэдээллийг хэрхэн боловсруулдгийг <a href="/mn/tafs/privacy">tafs-ийн Нууцлалын бодлого</a>-оос үзнэ үү.</p>
			</section>
		</article>
	}
}
