package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// CookiesFR is the Cookie Policy (/cookies) in French, at /fr/cookies.
// It is a translation of Cookies: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English
// page governs. Change the English page first, then this one.
templ CookiesFR() {
	@components.LayoutSite("KIFF — politique relative aux cookies", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@cookiesHeadFR()
			@cookiesSummaryFR()
			@cookiesOursFR()
			@cookiesSignInFR()
			@cookiesStorageFR()
			@cookiesControlFR()
		</article>
	}
}

templ cookiesHeadFR() {
	<header class="legal-head">
		<p class="legal-badge">Politique relative aux cookies · v0.1</p>
		<h1>Politique relative aux cookies</h1>
		<p class="legal-meta">
			<strong>Dernière mise à jour :</strong> 23 octobre 2026.
		</p>
		<p class="legal-disclaimer">
			Quels cookies <code>kiff.dev</code> et
			<code>app.kiff.dev</code> déposent, à quoi sert chacun et
			combien de temps il dure. La <a href="/fr/privacy">politique
			de confidentialité</a> couvre le reste des données
			personnelles que nous traitons. Questions :
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</header>
}

templ cookiesSummaryFR() {
	<section id="summary">
		<h2>1. En bref</h2>
		<p>
			Nous ne déposons aucun cookie d'analyse, aucun cookie
			publicitaire et aucun traceur tiers. Les cookies ci-dessous
			n'existent que pour vous connecter et faire fonctionner le
			tableau de bord. Ils sont strictement nécessaires : ils ne
			demandent donc aucun consentement, et il n'y a pas de
			bandeau cookies. Si nous ajoutons un jour un cookie qui
			n'est pas strictement nécessaire, nous vous demanderons
			votre consentement avant de le déposer.
		</p>
		<p>
			Lire les pages publiques de <code>kiff.dev</code> sans vous
			connecter ne dépose aucun cookie.
		</p>
	</section>
}

templ cookiesOursFR() {
	<section id="ours">
		<h2>2. Nos cookies</h2>
		<div class="legal-table" tabindex="0">
			<table>
				<thead>
					<tr>
						<th>Cookie</th>
						<th>À quoi il sert</th>
						<th>Combien de temps il dure</th>
					</tr>
				</thead>
				<tbody>
					<tr id="kiff-session">
						<td><code>kiff_session</code></td>
						<td>Vous garde connecté. Il contient qui vous êtes (votre identifiant de connexion, votre adresse e-mail et votre nom) et l'identifiant d'accès que le tableau de bord utilise pour vous. Signé, donc impossible à modifier, et illisible par les scripts</td>
						<td>24 heures, ou jusqu'à votre déconnexion</td>
					</tr>
					<tr id="kiff-flash">
						<td><code>kiff_flash</code></td>
						<td>Porte un message ponctuel jusqu'à la page suivante, par exemple « votre clé a été créée ». Signé. Une nouvelle clé ne s'y trouve jamais</td>
						<td>Supprimé quand la page suivante le lit, et au plus tard après 5 minutes</td>
					</tr>
					<tr id="kiff-cb-attempts">
						<td><code>kiff_cb_attempts</code></td>
						<td>Compte combien de fois la page de connexion s'est rechargée, pour arrêter une connexion qui tourne en boucle. Envoyé uniquement à cette page</td>
						<td>5 minutes, et effacé quand une connexion commence ou réussit</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p>
			Les trois sont des cookies internes, envoyés uniquement en
			HTTPS et illisibles par les scripts de la page.
			<code>kiff_session</code> et <code>kiff_flash</code> sont
			déposés pour <code>.kiff.dev</code> : <code>kiff.dev</code> et
			<code>app.kiff.dev</code> les reçoivent donc tous les deux.
		</p>
	</section>
}

templ cookiesSignInFR() {
	<section id="sign-in">
		<h2>3. Les cookies de notre fournisseur de connexion</h2>
		<p>
			Nous utilisons Clerk pour la connexion (voir les
			<a href="/fr/subprocessors#clerk">sous-traitants ultérieurs</a>).
			Quand vous vous connectez, Clerk dépose ses propres cookies
			de connexion, sur notre site et sur le domaine que Clerk
			tient pour nous, <code>clerk.kiff.dev</code>. Ils sont
			strictement nécessaires à la connexion et ne servent ni à
			l'analyse ni à la publicité. La
			<a href="https://clerk.com/docs/guides/how-clerk-works/cookies" target="_blank" rel="noopener">documentation de Clerk sur les cookies</a>
			décrit chacun d'eux et sa durée.
		</p>
	</section>
}

templ cookiesStorageFR() {
	<section id="storage">
		<h2>4. Ce qui reste dans votre navigateur</h2>
		<p>
			Quelques pages retiennent un choix dans le stockage de
			votre navigateur plutôt que dans un cookie. Il ne nous est
			jamais envoyé.
		</p>
		<ul>
			<li><code>kiff-theme</code> : le thème clair ou sombre que vous avez choisi dans le tableau de bord. Conservé jusqu'à ce que vous l'effaciez.</li>
			<li><code>kiff.gatewayFormat</code> : le dernier format que vous avez choisi en connectant un agent. Conservé jusqu'à ce que vous l'effaciez.</li>
			<li><code>kiff-demo-tour-step</code>, <code>kiff-demo-tour-active</code> et <code>kiff-demo-theme-touched</code> : où vous en êtes dans la démo interactive. Disparaît quand vous fermez l'onglet.</li>
		</ul>
	</section>
}

templ cookiesControlFR() {
	<section id="control">
		<h2>5. Vos choix</h2>
		<p>
			Vous pouvez bloquer ou supprimer les cookies dans les
			réglages de votre navigateur. Si vous bloquez les nôtres ou
			ceux de Clerk, vous pouvez toujours lire le site public,
			mais vous ne pouvez pas vous connecter. Vous déconnecter
			supprime <code>kiff_session</code>.
		</p>
		<p>
			Si nous changeons les cookies que nous déposons, nous
			mettons à jour cette page et sa date.
		</p>

		<hr/>

		<p class="legal-footnote">
			<strong>Version du document :</strong> v0.1.<br/>
			<strong>Dernière mise à jour :</strong> 23 octobre 2026.
		</p>
	</section>
}
