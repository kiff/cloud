package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// Terms renders the public Terms of Service at /terms.
//
// v0.1 contract between Kiff Agents OÜ and customers using
// KIFF Cloud. Keep public text free of private repository
// links, internal review notes, and source paths.
//
// 21 sections covering definitions, the agreement, the
// service (with §3A on tafs), accounts, acceptable use, customer data,
// confidentiality, fees, term and termination, warranties,
// disclaimer, limitation of liability, indemnification, SLA,
// service modifications, terms modifications, force majeure,
// governing law, general clauses, and contact. Article order
// matches a standard SaaS ToS so a customer's procurement
// team sees what it expects to see.
//
// Page voice rule: no "Merkle", "Sepolia", "anchor",
// or "on-chain" tokens — implementation-detail crypto vocabulary stays in
// the anchoring design and the cloud's docs.
templ Terms() {
	@components.LayoutSite("KIFF — terms of service", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@termsHead()
			@termsDefinitions()
			@termsAgreement()
			@termsService()
			@termsTafs()
			@termsAccount()
			@termsAcceptableUse()
			@termsCustomerData()
			@termsConfidentiality()
			@termsFees()
			@termsTerm()
			@termsWarranties()
			@termsDisclaimer()
			@termsLiability()
			@termsIndemnity()
			@termsSLA()
			@termsServiceMods()
			@termsTermsMods()
			@termsForceMajeure()
			@termsGoverningLaw()
			@termsGeneral()
			@termsContact()
		</article>
	}
}

templ termsHead() {
	<header class="legal-head">
		<p class="legal-badge">Terms of service · v0.1</p>
		<h1>Terms of Service</h1>
		<p class="legal-meta">
			<strong>Last updated:</strong> 21 November 2026.
			<strong>Effective date:</strong> 24 May 2026.
		</p>
		<p class="legal-disclaimer">
			<strong>What changed:</strong> who may use the Service, by region, ownership and sanctions (§4). Earlier: the tafs app on Android, and
			Solo bought through Google Play (§1, §8). Before that: paid
			plans (§3A, §8), the
			<a href="/legal/sla">service-level agreement</a> (§14), and
			the list of forbidden uses, which now lives in the
			<a href="/acceptable-use">Acceptable Use Policy</a> (§5).
		</p>
		<p class="legal-disclaimer">
			These terms govern use of KIFF Cloud, including tafs. Contractual
			questions:
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</header>
}

templ termsDefinitions() {
	<section id="definitions">
		<h2>1. Definitions</h2>
		<ul>
			<li><strong>"Kiff Agents OÜ"</strong>, <strong>"we"</strong>, <strong>"us"</strong>, <strong>"our"</strong> — the Estonian private limited company providing the Service. Registry code 17372313.</li>
			<li><strong>"Customer"</strong>, <strong>"you"</strong>, <strong>"your"</strong> — the natural or legal person agreeing to these terms.</li>
			<li><strong>"User"</strong> — any individual the Customer authorizes to access the Service through the Customer's account.</li>
			<li><strong>"Service"</strong> — the KIFF Cloud product, including <code>api.kiff.dev</code>, <code>app.kiff.dev</code>, <code>kiff.dev</code>, tafs, and the documentation, dashboards, and APIs we publish there.</li>
			<li><strong>"tafs"</strong> — the tafs app for iPhone, iPad, Android and computers (Mac, Windows and Linux) and the service behind it, including Setup and planque (§3A), in which a Customer hands a job to an AI agent that works inside KIFF Cards. A <strong>"taf"</strong> is one such agent.</li>
			<li><strong>"Tenant"</strong> — a logically-isolated workspace inside the Service belonging to a single Customer.</li>
			<li><strong>"Audit Data"</strong> — the events, decisions, actions, approvals, and receipts the Service persists on the Customer's behalf via the runtime.</li>
			<li><strong>"tafs Data"</strong> — what tafs keeps on the Customer's behalf: each taf's runs and chats (including what the Customer's connected tools return to it), its reports, its memory notes, and the phones registered for its alerts.</li>
			<li><strong>"Receipt"</strong> — a signed, versioned decision record emitted by the Service for each governed action.</li>
			<li><strong>"Documentation"</strong> — the technical Service documentation and security measures in the dated revision linked from these Terms (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>). It excludes the strategic whitepaper, marketing materials and documentation for the separately licensed open-source framework.</li>
			<li><strong>"DPA"</strong> — the Data Processing Agreement at <a href="/legal/dpa">/legal/dpa</a>, governing our processor-side relationship.</li>
		</ul>
	</section>
}

templ termsAgreement() {
	<section id="agreement">
		<h2>2. The agreement</h2>
		<p>
			These terms govern your use of the Service. By creating
			an account, generating an API key, or otherwise using
			the Service, you agree to these terms. If you accept on
			behalf of a company or other legal entity, you represent
			that you have authority to bind that entity, and "you"
			and "your" refer to that entity.
		</p>
		<p>
			We may publish supplemental terms for specific features
			(beta features, third-party integrations). Where they
			conflict with these terms, the supplemental terms
			control for the specific feature.
		</p>
	</section>
}

templ termsService() {
	<section id="service">
		<h2>3. The Service</h2>
		<p>
			KIFF Cloud is a hosted service for governing delegated
			actions. It evaluates requests against the Customer's
			configured permissions and Cards, may require human
			approval, and records governance decisions. Depending on
			the configured integration, KIFF forwards an authorized
			request or provides authorization that the protected
			system verifies. The connected system performs the
			underlying action.
		</p>
		<p>
			The applicable technical behavior, evidence, integration
			requirements and execution limits are specified in the
			dated Documentation linked from these Terms. The
			strategic <a href="/whitepaper">whitepaper</a> explains
			KIFF's principles and model; it is not incorporated as
			technical Documentation under these Terms.
		</p>
		<p>
			KIFF Cloud's governance service is <em>not</em> an agent
			framework, a workflow engine, a model gateway, or a
			managed agent platform. It composes with whatever you
			already use. See <a href="/#not">"What KIFF is not"</a>
			on the homepage for the explicit list. tafs is the one
			part of the Service that runs agents for you, inside the
			Cards you issue; §3A describes it.
		</p>
		<p>
			The open-source <a href="https://github.com/kiff/kiff" target="_blank" rel="noopener">kiff/kiff</a>
			framework is governed by its own MIT license and falls
			outside these terms. When you run the framework on your
			own infrastructure, no contract with Kiff Agents OÜ is
			created.
		</p>
	</section>
}

templ termsTafs() {
	<section id="tafs">
		<h2>3A. tafs</h2>
		<p>
			In tafs you hand a job (for example refunds, bill pay or
			card disputes) to a taf: an AI agent that works on a
			schedule with the tools you connect, inside the KIFF Cards
			you issue for it. Each taf runs on our agent runtime, and
			Anthropic provides the AI model it uses. You answer its
			held calls in the tafs app.
		</p>
		<p>
			<strong>Connecting your tools.</strong> Setup, an AI agent
			in tafs that runs like a taf, helps you connect a tool and
			set up a taf for a job. It doesn't connect anything by
			itself. You sign in at the tool's own provider (for
			example Stripe), and you approve on your device each
			connection, the tools a taf may use, and its Cards. The
			token from that sign-in is kept by planque, our connection
			service. It is encrypted, used only to make a call KIFF has
			decided, and never given to a taf. Disconnecting a tool
			revokes the token at the provider and deletes it.
		</p>
		<p>
			<strong>Your Cards are your instructions.</strong> A taf
			reaches your tools only through KIFF, which checks every
			call against the taf's Cards before it is sent. A call
			within a Card you issued is made on your instruction. A
			call outside a Card is held or refused, as the Card says.
			A held call is made only after someone your account allows
			to answer held calls approves it. In the tafs app, the
			answer carries a signature from their device that KIFF
			verifies, and the receipt keeps that proof. Your account
			can also answer in KIFF itself (the dashboard, its
			command-line tool, or an approver you authorise there);
			the receipt then records who answered and how.
		</p>
		<p>
			<strong>What stays with you.</strong> You choose each
			taf's job and Cards, answer its held calls, and make sure
			you may use the tools and accounts you connect. A taf's
			reports, messages and memory notes are written by an AI
			model and can be wrong; check what matters before you
			rely on it.
		</p>
		<p>
			<strong>Stopping a taf.</strong> You can halt one taf or
			all of them, pause a taf, revoke any of its Cards, or
			remove it. From the moment you halt a taf or revoke a
			Card, KIFF allows no new call under it. The tafs app shows
			a taf as halted only once KIFF and planque have both
			confirmed the halt; from then planque sends none of its
			calls, including one KIFF allowed just before. A request
			already sent to a tool's provider may still complete: we
			stop new calls, and can't undo what a provider has done.
			A tool that checks KIFF's permits itself, without planque,
			may still accept a permit KIFF issued just before, for at
			most 90 seconds. Resuming a halted taf takes your approval
			on your device, and nothing held or queued before the halt
			runs after it.
		</p>
		<p>
			<strong>Removing a taf</strong> stops its
			schedule and deletes its runs, chats, memory and the key
			it used. Even before that, what your tools return to a taf
			is kept only until its run ends (what a chat only read,
			encrypted, for its next messages: used for at most four
			hours, then deleted), and its runs and chats for 30 days. KIFF keeps the receipts of what it did.
		</p>
		<p>
			<strong>The EU AI Act.</strong> For tafs, Kiff Agents OÜ
			is the provider of the AI system and you are its deployer.
			We make sure anything a taf writes to someone outside your
			company says that an AI agent wrote it. You use tafs only
			for the jobs it offers, and not for any use the AI Act
			prohibits or classes as high-risk, such as decisions about
			a person's employment, credit or access to essential
			services. You keep the human approvals your Cards require,
			and make sure the people who use tafs for you understand
			what it does and its limits.
		</p>
		<p>
			<strong>Costs.</strong> tafs is part of your KIFF plan
			(§8): each run of a taf uses credits for the AI it used.
			Coach, and setting tafs up, are included within Coach's
			fair use.
		</p>
	</section>
}

templ termsAccount() {
	<section id="account">
		<h2>4. Accounts and access</h2>
		<p>
			To use the Service you must create an account. You agree
			to provide accurate registration information, to keep
			your credentials confidential, and to be responsible for
			all activity under your account.
		</p>
		<p>
			You must be at least 16 years old, or the age of digital
			consent in your jurisdiction, whichever is higher. The
			Service is not directed at children.
		</p>
		<p>
			The Service is offered only in the countries and regions where Anthropic, which provides its AI model, offers its own service, as <a href="https://www.anthropic.com/supported-countries">Anthropic lists them</a>. You may not use it from anywhere else. A company may not use it if it is headquartered in, or majority-owned or controlled by a company headquartered in, a country or region outside that list, wherever its users are. Nor may you use it if you, or the company you use it for, are subject to sanctions of the European Union, the United Nations or the United States. We refuse accounts that break this rule and may suspend one that does.
		</p>
		<p>
			You are responsible for the actions of every User you
			authorize on your account. We may suspend an account or
			revoke access on reasonable notice if we detect a credible
			breach of these terms. For Acceptable Use violations
			(see §5) suspension may be immediate.
		</p>
	</section>
}

templ termsAcceptableUse() {
	<section id="acceptable-use">
		<h2>5. Acceptable use</h2>
		<p>
			You, your users and your agents must follow the
			<a href="/acceptable-use">Acceptable Use Policy</a>. It is
			part of these terms and lists what the Service may not be
			used for.
		</p>
		<p>
			We may suspend immediately on a credible AUP violation.
			We are not obligated to monitor Customer content but may
			act on credible reports.
		</p>
	</section>
}

templ termsCustomerData() {
	<section id="customer-data">
		<h2>6. Customer data and content</h2>
		<p>
			You own your Audit Data. You grant Kiff Agents OÜ a
			limited, non-exclusive, royalty-free, worldwide licence
			to host, copy, transmit, display, and otherwise process
			your Audit Data solely as necessary to operate, maintain,
			and improve the Service for you.
		</p>
		<p>
			We act as <strong>processor</strong> for your Audit Data
			and your tafs Data under Article 28 GDPR; the
			<a href="/legal/dpa">DPA</a> governs that relationship in
			detail. We act as <strong>controller</strong> for your
			account metadata; the
			<a href="/privacy">privacy policy</a> governs that
			relationship.
		</p>
		<p>
			You represent that you have all rights necessary to
			submit the data you submit, and that submission complies
			with applicable laws (including data-protection laws and,
			where applicable, the EU AI Act).
		</p>
	</section>
}

templ termsConfidentiality() {
	<section id="confidentiality">
		<h2>7. Confidentiality</h2>
		<p>
			Each party may receive non-public information from the
			other ("Confidential Information"). The receiving party
			will use Confidential Information only as necessary to
			perform its obligations and exercise its rights under
			these terms, and will protect it with at least the same
			degree of care it uses for its own confidential
			information.
		</p>
		<p>
			Confidential Information does not include information
			that (a) is or becomes publicly available without breach,
			(b) was known to the receiving party before disclosure,
			(c) is independently developed without use of the
			Confidential Information, or (d) must be disclosed by
			law (with notice to the other party where allowed).
		</p>
	</section>
}

templ termsFees() {
	<section id="fees">
		<h2>8. Fees and payment</h2>
		<p>
			<strong>Plans.</strong> Each account has one plan. The
			current prices are on the <a href="/pricing">pricing
			page</a>; at the time of this update:
		</p>
		<ul>
			<li><strong>Solo:</strong> one person, for tafs, sold in the tafs app through the App Store or Google Play at €12.50 a month, VAT included, with 500 credits a month included.</li>
			<li><strong>Company:</strong> €10.50 a month for each seat, with 500 credits a month for each seat, pooled, and, for your own agents' calls through KIFF Cloud, 500 actions a month for each seat, pooled.</li>
			<li><strong>An agreement:</strong> the fees and terms in its order form.</li>
		</ul>
		<p>
			Seats are an account's admins and editors. Approvers and
			viewers are free on every plan. On Company, past what's
			included, a credit costs €0.01 and an action €0.02.
			Credits past the included ones are billed up to the
			monthly spend limit the account sets (€50 when it starts):
			at the limit, KIFF starts no new run of the account's
			tafs until the next period begins, or someone who manages
			billing raises it.
		</p>
		<p>
			<strong>Packs of credits.</strong> On Solo, credits past
			the month's included ones come from packs of credits,
			bought in the tafs app. A pack is bought once, doesn't
			expire, and isn't a subscription; its credits are used
			after the month's included ones, the oldest pack first. A
			pack whose payment is refunded in full is taken back, with
			the credits it has left. When the month's credits and the
			packs are used, KIFF starts no new run of the account's
			tafs until the next period begins or a pack is added.
			Bonus credits that KIFF adds to an account
			don't expire either, like packs.
		</p>
		<p>
			<strong>What's counted.</strong> A <em>credit</em> pays
			for the AI a taf's run used, in whole credits, rounded up
			once per run and counted once, when the run ends. A run
			whose call KIFF refused still used its AI. Never counted:
			Coach, and setting tafs up, within Coach's fair use; a
			trial of a new version, which sends nothing; and a run
			that failed on our side. An <em>action</em> is a call by
			your own agent through KIFF Cloud that got something done:
			KIFF allowed it, it was sent, and the tool reported
			success. Never counted as an action: a call that was
			refused, held and then refused, stopped by a halt,
			invalid, failed at the tool, or whose outcome is unknown,
			and a call that only reads.
		</p>
		<p>
			<strong>No trial.</strong> An account pays from its first
			day. Before a plan starts, KIFF starts no run of its tafs,
			other than Coach's setting up; nothing is deleted.
		</p>
		<p>
			<strong>Payment and invoices.</strong> A plan is billed in
			one place. A plan bought on kiff.dev is bought, changed and
			cancelled there and in the billing portal it links to, and
			its payments are processed by Stripe. Solo bought in the
			tafs app is sold through the App Store on iPhone and iPad, or
			Google Play on Android, and managed in your Apple
			subscriptions or Google Play subscriptions, under that
			store's terms for payment, renewal and refunds. Packs of
			credits are bought in the app. Company is bought on
			kiff.dev. Fees are billed monthly in advance;
			usage past what's included is billed with the next
			invoice. A change in the number of people applies from the
			next invoice. If a payment fails and isn't made good, the
			plan ends and KIFF refuses the account's calls until a
			plan is chosen.
		</p>
		<p>
			<strong>Cancellation.</strong> You can cancel at any time
			in the billing portal, or, for Solo bought in the app, in
			your Apple subscriptions or Google Play subscriptions. The plan runs to the end of the
			period you paid for, and isn't renewed. Except as the law
			requires, fees already paid aren't refunded. If you are a
			consumer in the EU, you may withdraw within 14 days of
			purchase without giving a reason, and we refund what you
			paid less the share for the days the plan already ran.
			Solo purchases are refunded through the App Store or Google Play, under their terms.
		</p>
		<p>
			<strong>VAT.</strong> Company's prices exclude VAT; Solo
			and packs of credits are sold by the App Store or Google
			Play with VAT included. Kiff Agents OÜ
			(VAT number EE102924327) adds Estonian VAT where it
			applies. EU business-to-business sales to a Customer
			outside Estonia with a valid VAT identification number are
			invoiced under the EU reverse-charge mechanism.
		</p>
		<p>
			<strong>Changes.</strong> We give active accounts at least
			thirty days' written notice of a price increase (§16). A
			price decrease applies from the next invoice.
		</p>
	</section>
}

templ termsTerm() {
	<section id="term">
		<h2>9. Term and termination</h2>
		<p>
			These terms take effect when you first use the Service
			and continue until terminated.
		</p>
		<p>
			You may terminate at any time by deleting your account.
			We may terminate (a) for material breach not cured within
			thirty days of written notice, or (b) immediately for
			Acceptable Use violations or insolvency events.
		</p>
		<p id="leaving">
			<strong>Leaving, and taking your data with you.</strong>
			You can export your data at any time, in a structured,
			machine-readable format: in KIFF, Settings → Data gives a
			JSON file with your account, your Cards with every version,
			the decisions in your Record (the latest 10,000; ask us for
			more), the signed receipt of each one KIFF allowed, and your
			API keys' details (never the keys themselves). In the tafs app, each person exports their own
			chats, files and notes from Account →  Export my
			chats; chats are kept for thirty days in any case, as the
			privacy policy says. Deleting your account ends the Service
			at once, so export first.
		</p>
		<p>
			You may instead leave on notice, to switch to another
			provider or to your own systems, by writing to
			<a href="mailto:support@kiff.dev">support@kiff.dev</a>.
			We never require more than two months' notice: your notice
			takes effect on the date you choose, no later than two
			months after you send it. From that date, a transition
			period of thirty days follows, in which the Service keeps
			running, you export your data and move your work, and we
			help with reasonable requests to do so. You may extend the
			transition period once, for as long as you need. If we
			can't technically complete it in thirty days, we tell you
			within fourteen working days of your notice, with the
			reasons and a new period of no more than seven months.
			After the transition period, your data stays available for
			export for at least thirty more days. The plan's fees
			continue as usual until the transition period ends. Solo
			bought in the App Store or Google Play is cancelled in the
			store; the transition and export periods apply the same
			way.
		</p>
		<p>
			We don't charge for leaving, switching or exporting your
			data. This section gives the switching rights of Chapter
			VI of the EU Data Act (Regulation (EU) 2023/2854) to every
			customer.
		</p>
		<p>
			On termination, and after any transition and export
			period, we delete your Audit Data, your tafs Data and
			account metadata in line with the retention rules in the
			<a href="/privacy#retention">privacy policy</a>.
		</p>
		<p>
			Sections that by their nature should survive termination
			survive — including confidentiality, intellectual
			property, indemnification, limitation of liability,
			disclaimers, governing law, and any accrued fees.
		</p>
	</section>
}

templ termsWarranties() {
	<section id="warranties">
		<h2>10. Warranties</h2>
		<p>
			Each party represents that it has the right and authority
			to enter into and perform these terms.
		</p>
		<p>
			We warrant that we will provide the Service in a
			professional manner and in substantial conformity with
			the Documentation. Your sole remedy for breach of this
			warranty is, at our option, re-performance or pro-rata
			refund of fees attributable to the affected Service for
			the period of breach.
		</p>
		<p>
			You warrant that your use of the Service complies with
			applicable law and these terms.
		</p>
	</section>
}

templ termsDisclaimer() {
	<section id="disclaimer">
		<h2>11. Disclaimer</h2>
		<p>
			Except for the express warranties in §10, the Service is
			provided <strong>"as is" and "as available"</strong>. To
			the maximum extent permitted by law, we disclaim all
			other warranties, whether express, implied, or statutory,
			including warranties of merchantability, fitness for a
			particular purpose, non-infringement, and any warranty
			arising from course of dealing or usage of trade.
		</p>
		<p>
			We do not warrant that the Service will be uninterrupted,
			error-free, or free from harmful components, or that any
			data will not be lost or corrupted. You are responsible
			for backing up your data.
		</p>
	</section>
}

templ termsLiability() {
	<section id="liability">
		<h2>12. Limitation of liability</h2>
		<p>
			To the maximum extent permitted by law, neither party
			will be liable to the other for any indirect, incidental,
			consequential, special, exemplary, or punitive damages,
			including lost profits, lost revenue, lost data, or
			business interruption, arising out of or related to
			these terms or the Service, even if advised of the
			possibility of such damages.
		</p>
		<p>
			Each party's aggregate liability arising out of or
			related to these terms will not exceed the greater of
			(a) the fees paid or payable by the Customer to Kiff
			Agents OÜ in the twelve months preceding the event
			giving rise to liability, or (b) one hundred thousand
			euros (€100,000).
		</p>
		<p>
			Nothing in these terms limits or excludes liability that
			cannot be limited or excluded under applicable law,
			including liability for death, personal injury caused by
			negligence, fraud, or wilful misconduct, and liability for
			a defective product under the laws implementing Directive
			(EU) 2024/2853 on liability for defective products.
		</p>
	</section>
}

templ termsIndemnity() {
	<section id="indemnification">
		<h2>13. Indemnification</h2>
		<p>
			We will defend you against third-party claims that the
			Service, as provided by us and used by you in accordance
			with these terms, infringes that third party's
			intellectual property rights, and we will pay damages
			finally awarded against you (or the agreed settlement
			amount) for such claims.
		</p>
		<p>
			You will defend us against third-party claims arising
			from (a) your Customer data or content; (b) your use of
			the Service in breach of these terms (including the AUP);
			or (c) your gross negligence or wilful misconduct, and
			you will pay damages finally awarded against us (or the
			agreed settlement amount) for such claims.
		</p>
		<p>
			Indemnification is conditional on prompt notice of the
			claim, sole control of defence and settlement by the
			indemnifier, and reasonable cooperation by the
			indemnitee. The indemnifier may not settle a claim that
			imposes obligations on the indemnitee without consent.
		</p>
	</section>
}

templ termsSLA() {
	<section id="sla">
		<h2>14. Service-level commitment</h2>
		<p>
			On a paid plan, the <a href="/legal/sla">service-level
			agreement</a> sets the availability we commit to, how a
			slow or failed request counts, our support response times,
			and the service credits when we fall short. It is part of
			these terms.
		</p>
		<p>
			Operational practices, incident response, and breach
			notification commitments are documented in the dated
			revision linked from these Terms
			(<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>);
			<a href="/security">/security</a> shows the current
			practices.
		</p>
	</section>
}

templ termsServiceMods() {
	<section id="service-mods">
		<h2>15. Modifications to the Service</h2>
		<p>
			We may add, change, or remove features at any time.
			Material reductions of functionality or the deprecation
			of an API surface that breaks documented behaviour are
			notified to active customers at least thirty days in
			advance, with a published deprecation schedule.
			Security-driven changes may be made without notice where
			notice would itself create risk.
		</p>
	</section>
}

templ termsTermsMods() {
	<section id="terms-mods">
		<h2>16. Modifications to these terms</h2>
		<p>
			We may amend these terms from time to time. Material
			changes are notified by email and a prominent banner on
			this page at least thirty days in advance. Non-material
			changes (clarifications, references) are posted with a
			new "last updated" date. Your continued use of the
			Service after the effective date of an update
			constitutes acceptance.
		</p>
	</section>
}

templ termsForceMajeure() {
	<section id="force-majeure">
		<h2>17. Force majeure</h2>
		<p>
			Neither party is liable for any failure or delay in
			performance to the extent caused by circumstances beyond
			its reasonable control, including acts of God, war,
			terrorism, civil disturbance, labour disputes, fire,
			natural disaster, pandemic-related government action,
			internet or power outages, or actions of telecom
			providers or third-party hosting infrastructure.
		</p>
	</section>
}

templ termsGoverningLaw() {
	<section id="governing-law">
		<h2>18. Governing law and venue</h2>
		<p>
			These terms are governed by the laws of the Republic of
			Estonia, without regard to its conflicts of law rules.
			The exclusive forum for disputes is Harju County Court
			in Tallinn.
		</p>
		<p>
			Where you are a consumer resident in another EU member
			state, mandatory consumer-protection rules of your home
			jurisdiction continue to apply to the extent they grant
			you rights you cannot waive by contract; this clause does
			not deprive you of the protection of those rules.
		</p>
	</section>
}

templ termsGeneral() {
	<section id="general">
		<h2>19. General</h2>
		<p>
			<strong>Entire agreement.</strong> These terms, together
			with the privacy policy, the DPA, any order forms, and
			any supplemental terms expressly incorporated, are the
			entire agreement between us on their subject and
			supersede any prior or contemporaneous understanding.
		</p>
		<p>
			<strong>Severability.</strong> If a provision is held
			unenforceable, the rest remain in effect.
		</p>
		<p>
			<strong>Assignment.</strong> You may not assign these
			terms without our written consent. We may assign without
			consent in connection with a merger, acquisition, or
			sale of all or substantially all of our assets, on notice
			to you.
		</p>
		<p>
			<strong>No waiver.</strong> A failure to enforce any
			provision does not waive the right to enforce it later.
		</p>
		<p>
			<strong>Notices.</strong> Notices to Kiff Agents OÜ go to
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>
			or, by post, to Tööstuse tn 75-71, Põhja-Tallinna
			linnaosa, Tallinn 10416, Estonia. Notices to you go to
			the email associated with your account or, where you have
			provided one, your designated legal-notices address.
		</p>
		<p>
			<strong>Independent contractors.</strong> Nothing in
			these terms creates a partnership, agency, joint venture,
			or employment relationship.
		</p>
		<p>
			<strong>Third-party beneficiaries.</strong> There are
			none, except to the extent indemnified affiliates are
			expressly identified.
		</p>
	</section>
}

