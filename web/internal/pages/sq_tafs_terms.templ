package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsTermsSQ is tafs's terms (/tafs/terms) in Albanian, at /sq/tafs/terms.
// It is a translation of TafsTerms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Albanian has the legal
// texts only, so a link to any other page goes to English and says so.
templ TafsTermsSQ() {
	@components.LayoutSiteWithMeta("kushtet e tafs", "Kushtet për tafs, aplikacionin e KIFF: kush e ofron, llogaria juaj, çfarë bën një taf dhe si e kontrolloni, përdorimi i pranueshëm, tarifat, përgjegjësia dhe përfundimi.", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · kushtet</p>
				<h1>Kushtet e tafs</h1>
				<p class="legal-meta"><strong>Përditësuar së fundi:</strong> 21 nëntor 2026.</p>
				<p class="legal-disclaimer">Këto kushte janë për tafs, aplikacionin e KIFF për iPhone, iPad, Android dhe kompjuterë, dhe shërbimin pas tij. tafs është pjesë e KIFF Cloud, dhe kjo faqe përsërit çfarë thonë <a href="/sq/terms">Kushtet e shërbimit të KIFF</a> për të, pa i shtuar asgjë. Kushtet e KIFF zbatohen për çdo gjë që kjo faqe nuk mbulon. Pyetje: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.</p>
			</header>
			<section id="provider">
				<h2>1. Kush ofron tafs</h2>
				<p>tafs ofrohet nga <strong>Kiff Agents OÜ</strong>, një shoqëri private me përgjegjësi të kufizuar në Estoni (kodi i regjistrit 17372313), në Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estoni. Duke krijuar një llogari ose duke përdorur ndryshe tafs, i pranoni këto kushte dhe Kushtet e KIFF. Nëse pranoni për një kompani, konfirmoni se mund ta detyroni.</p>
			</section>
			<section id="account">
				<h2>2. Llogaria juaj</h2>
				<p>Hyni në tafs me një llogari KIFF. Jepni të dhëna të sakta, mbani kredencialet tuaja konfidenciale, dhe jeni përgjegjës për çdo veprimtari nën llogarinë tuaj dhe për çdo person që lini brenda. Duhet të jeni të paktën 16 vjeç, ose në moshën e pëlqimit dixhital ku jetoni, cilado që është më e lartë. Mund ta përdorni tafs vetëm nga një vend ose rajon ku Anthropic ofron shërbimin e vet, siç i <a href="https://www.anthropic.com/supported-countries">liston Anthropic</a>; jo për një kompani me seli, ose të zotëruar a të kontrolluar në shumicë nga një kompani me seli, në një vend ose rajon jashtë asaj liste; dhe jo nëse ju, ose kompania për të cilën e përdorni, jeni subjekt i sanksioneve të Bashkimit Evropian, Kombeve të Bashkuara ose Shteteve të Bashkuara (Kushtet e KIFF, §4).</p>
			</section>
			<section id="what-a-taf-does">
				<h2>3. Çfarë bën një taf</h2>
				<p>Në tafs ia besoni një punë një taf-i: një agjenti AI që punon sipas orarit me mjetet që lidhni, brenda KIFF Card-eve që lëshoni për të. Anthropic ofron modelin AI që përdor. Setup, një agjent AI në tafs, ju ndihmon të lidhni një mjet dhe të ngrini një taf, por nuk lidh asgjë vetë: hyni te ofruesi i vetë mjetit dhe miratoni çdo lidhje, mjetet që një taf mund të përdorë dhe Card-et e tij në pajisjen tuaj.</p>
				<p>Raportet, mesazhet dhe shënimet e kujtesës të një taf-i shkruhen nga një model AI dhe mund të jenë të gabuara. Kontrolloni atë që ka rëndësi para se të mbështeteni. Çdo gjë që një taf i shkruan dikujt jashtë kompanisë suaj thotë se e ka shkruar një agjent AI.</p>
			</section>
			<section id="control">
				<h2>4. Kontrolli juaj: Card-i dhe miratimet</h2>
				<p>Një taf arrin mjetet tuaja vetëm përmes KIFF, që kontrollon çdo thirrje kundrejt Card-eve të taf-it para se të dërgohet. Një thirrje brenda një Card-i që keni lëshuar bëhet sipas udhëzimit tuaj. Një thirrje jashtë një Card-i mbahet ose refuzohet, siç thotë Card-i. Një thirrje e mbajtur bëhet vetëm pasi ta miratojë dikush që llogaria juaj e lejon të përgjigjet ndaj thirrjeve të mbajtura.</p>
				<p>Ju zgjidhni punën dhe Card-et e çdo taf-i, u përgjigjeni thirrjeve të tij të mbajtura dhe sigurohuni që keni të drejtë të përdorni mjetet dhe llogaritë që lidhni. Mund të ndaloni (halt) një taf ose të gjithë, të pezulloni një taf, të revokoni cilindo nga Card-et e tij ose ta hiqni. Nga çasti kur ndaloni një taf ose revokoni një Card, KIFF nuk lejon asnjë thirrje të re nga ai taf ose nën atë Card. Një kërkesë e dërguar tashmë te ofruesi i një mjeti mund të plotësohet prapë: ndalojmë thirrjet e reja dhe nuk mund të zhbëjmë atë që ofruesi ka bërë. <a href="/sq/terms#tafs">Kushtet e KIFF, §3A</a> ka detajet.</p>
				<p>Sipas Aktit të BE-së për AI, Kiff Agents OÜ është ofruesi i tafs dhe ju jeni përdoruesi i tij (deployer). Përdoreni tafs vetëm për punët që ofron, dhe jo për ndonjë përdorim që Akti i AI e ndalon ose e klasifikon si me rrezik të lartë, si vendimet për punësimin, kreditin ose qasjen e një personi në shërbime thelbësore.</p>
			</section>
			<section id="acceptable-use">
				<h2>5. Përdorimi i pranueshëm</h2>
				<p>Ju, njerëzit tuaj dhe taf-et tuaja duhet të ndiqni <a href="/acceptable-use">Politikën e përdorimit të pranueshëm</a> (në anglisht). Veprimi i një agjenti është veprimi juaj. Ndër të tjera, nuk mund ta përdorni tafs për të shkelur ligjin, për të vepruar mbi një sistem ose llogari që nuk jeni të autorizuar ta përdorni, për të lidhur një mjet me një hyrje që nuk është e juaja ta jepni, për të dërguar spam ose për të anashkaluar një Card, një kufi ose një mbajtje. Mund të pezullojmë menjëherë për një shkelje të besueshme.</p>
			</section>
			<section id="fees">
				<h2>6. Tarifat</h2>
				<p>Në kohën e këtij përditësimi, Solo është { tafsCostSQ.money(TafsSoloCents) } në muaj, TVSH e përfshirë, me { tafsCostSQ.number(TafsSoloCredits) } kredite në muaj, e shitur në aplikacion përmes App Store ose Google Play. Paketat e krediteve, të blera në aplikacion, fillojnë nga { tafsCostSQ.money(TafsPackCents[TafsSoloCredits]) }; nuk skadojnë. Çdo ekzekutim i një taf-i përdor kredite për AI-n që përdori. Coach, dhe ngritja e taf-eve, përfshihen brenda përdorimit të drejtë të Coach. Këto janë çmimet në zonën e euros. Gjetkë, App Store ose Google Play tregon çmimin në monedhën tuaj, me ose pa taksën lokale siç kërkojnë rregullat e atij vendi, dhe ai është çmimi që paguani. Çmimet aktuale janë në <a href="/pricing">faqen e çmimeve</a> (në anglisht); tafs është edhe pjesë e planit Company të KIFF.</p>
				<p>Nuk ka provë. Solo i blerë në aplikacion menaxhohet dhe anulohet në abonimet tuaja Apple ose Google Play, sipas kushteve të atij dyqani për pagesën, rinovimin dhe rimbursimet. Një plan vazhdon deri në fund të periudhës që keni paguar. Nëse jeni konsumator në BE, mund të tërhiqeni brenda 14 ditëve nga blerja. <a href="/sq/terms#fees">Kushtet e KIFF, §8</a> ka detajet.</p>
			</section>
			<section id="liability">
				<h2>7. Përgjegjësia</h2>
				<p>tafs ofrohet „siç është“ dhe „siç disponohet“, me përjashtim të garancive në Kushtet e KIFF (§10). Në masën që e lejon ligji, asnjëra palë nuk është përgjegjëse për dëme indirekte ose pasojë, dhe përgjegjësia totale e secilës palë kufizohet siç thonë <a href="/sq/terms#liability">Kushtet e KIFF, §12</a>. Asgjë nuk kufizon përgjegjësinë që ligji nuk lejon ta kufizojë.</p>
			</section>
			<section id="termination">
				<h2>8. Përfundimi</h2>
				<p>Mund të ndaleni në çdo kohë: fshini llogarinë tuaj në aplikacion, te Llogari → <em>Fshi llogarinë</em>. Eksportoni bisedat tuaja së pari, nga Llogari → Eksporto bisedat e mia. Mund ta përfundojmë përdorimin tuaj për një shkelje thelbësore të pakorrigjuar brenda tridhjetë ditësh nga njoftimi, ose menjëherë për një shkelje të Përdorimit të Pranueshëm. Të drejtat tuaja për të ikur dhe për të marrë të dhënat tuaja me vete janë te <a href="/sq/terms#term">Kushtet e KIFF, §9</a>.</p>
			</section>
			<section id="governing-law">
				<h2>9. Ndryshimet dhe ligji i zbatueshëm</h2>
				<p>Këto kushte i ndryshojmë ashtu siç thonë Kushtet e KIFF për të vetat (§16). Rregullohen nga ligjet e Republikës së Estonisë, dhe mosmarrëveshjet shkojnë në Gjykatën e Qarkut Harju në Talin. Nëse jeni konsumator në një shtet tjetër anëtar të BE-së, rregullat e detyrueshme të mbrojtjes së konsumatorit të vendit tuaj vazhdojnë të zbatohen.</p>
			</section>
			<section id="contact">
				<h2>10. Kontakti</h2>
				<p>Pyetje kontraktore: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>. Ndihmë me aplikacionin: <a href="mailto:support@kiff.dev">support@kiff.dev</a>. Privatësia: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>, dhe si i trajton tafs të dhënat personale është te <a href="/sq/tafs/privacy">Politika e privatësisë së tafs</a>.</p>
			</section>
		</article>
	}
}
