package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// SupportES is the support page (/support) in Spanish, at /es/support.
// It is a translation of Support: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English
// page governs. Change the English page first, then this one.
templ SupportES() {
	@components.LayoutSite("KIFF — soporte", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@supportHeadES()
			@supportWriteES()
			@supportStatusES()
			@supportTafsES()
			@supportDataES()
			@supportSecurityES()
			if computerAppReleased() {
				@supportComputerES()
			}
		</article>
	}
}

templ supportHeadES() {
	<header class="legal-head">
		<p class="legal-badge">Soporte</p>
		<h1>Soporte</h1>
		<p class="legal-meta">
			<strong>Última actualización:</strong> 13 de noviembre de 2026.
		</p>
		<p class="legal-disclaimer">
			Para KIFF y para tafs, la app de KIFF para iPhone, iPad y Android.
			Ambos los gestiona Kiff Agents OÜ, Tallin, Estonia.
		</p>
	</header>
}

templ supportWriteES() {
	<section id="write">
		<h2>1. Escríbenos</h2>
		<p>
			Escribe a <a href="mailto:hello@kiff.dev">hello@kiff.dev</a> desde
			el correo de tu cuenta y cuéntanos qué ha pasado. Te responde una
			persona, dentro de los tiempos de respuesta del
			<a href="/legal/sla#support">acuerdo de nivel de servicio</a>{ " " + components.InEnglish("es") } (§5).
		</p>
	</section>
}

templ supportStatusES() {
	<section id="status">
		<h2>2. ¿Hay algo caído?</h2>
		<p>
			<a href="https://status.kiff.dev">status.kiff.dev</a> funciona
			aparte de KIFF, así que responde cuando KIFF no lo hace.
		</p>
	</section>
}

templ supportTafsES() {
	<section id="tafs">
		<h2>3. Eliminar tu cuenta</h2>
		<p>
			En tafs: Cuenta → <em>Eliminar cuenta</em>. KIFF detiene tus claves
			de inmediato y borra sus registros tras un periodo de gracia de 30
			días, como indica la <a href="/es/privacy">política de privacidad</a>.
			La ayuda sobre la app está en la
			<a href="/docs/tafs">documentación de tafs</a>{ " " + components.InEnglish("es") }.
			if WatchLive {
				<a href="/es/tafs/watch">tafs en tu reloj</a>: qué hace y cómo conseguirlo.
			}
		</p>
	</section>
}

templ supportDataES() {
	<section id="data">
		<h2>4. Tus datos</h2>
		<p>
			Para ver, exportar o eliminar tus datos, o una cuenta creada en la
			web, escribe a <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</section>
}

templ supportSecurityES() {
	<section id="security">
		<h2>5. Seguridad y asuntos legales</h2>
		<p>
			Problemas de seguridad: <a href="mailto:security@kiff.dev">security@kiff.dev</a>.
			Avisos legales: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</section>
}

templ supportComputerES() {
	<section id="computer">
		<h2>6. Añade un ordenador con tu teléfono</h2>
		<ol>
			<li>En el ordenador, abre tafs y elige <em>Añade este ordenador con tu teléfono</em>. Muestra un código para escanear.</li>
			<li>En el teléfono que ya usas con tafs, abre <em>Cuenta</em> → <em>Dispositivos</em> → <em>Añadir un dispositivo</em> y escanea ese código.</li>
			<li>Tu teléfono te pregunta si tu ordenador muestra un código. Comprueba que es el mismo y aprueba solo ese ordenador, con él delante de ti.</li>
		</ol>
		<p>Si el código caducó o ya se usó, elige <em>Mostrar un código nuevo</em> en el ordenador y vuelve a escanearlo. En Linux, y en un Mac sin Secure Enclave, tafs muestra lo que te espera pero no aprueba; apruebas en tu teléfono{ macSecurityKey("es") }.</p>
	</section>
}
