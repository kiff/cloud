package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// DPAFR is the Data Processing Agreement template (/legal/dpa) in
// French, at /fr/legal/dpa. It is a translation of DPA: the same
// sections, anchors, links and figures, held to it by
// TestTranslationsKeepTheEnglishPage. The English page governs. Change
// the English page first, then this one.
templ DPAFR() {
	@components.LayoutSite("KIFF — accord de traitement des données", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@dpaHeadFR()
			@dpaPartiesFR()
			@dpaDefinitionsFR()
			@dpaScopeFR()
			@dpaSubjectMatterFR()
			@dpaNaturePurposeFR()
			@dpaCategoriesFR()
			@dpaInstructionsFR()
			@dpaProcessorObligationsFR()
			@dpaConfidentialityFR()
			@dpaSubprocessorsFR()
			@dpaTransfersFR()
			@dpaSecurityFR()
			@dpaBreachNotificationFR()
			@dpaDataSubjectRequestsFR()
			@dpaAuditFR()
			@dpaReturnDeletionFR()
			@dpaLiabilityFR()
			@dpaTermFR()
			@dpaGoverningLawFR()
			@dpaAnnex1FR()
			@dpaAnnex2FR()
			@dpaAnnex3FR()
			@dpaAnnex4FR()
		</article>
	}
}

templ dpaHeadFR() {
	<header class="legal-head">
		<p class="legal-badge">Modèle de DPA · v0.1</p>
		<h1>Accord de traitement des données</h1>
		<p class="legal-meta">
			<strong>Version du modèle :</strong> v0.1.
			<strong>Dernière mise à jour :</strong> 17 novembre 2026.
		</p>
		<p class="legal-disclaimer">
			Ceci est un <em>modèle</em> publié, pas un contrat signé.
			Les clients peuvent s'en servir comme point de départ pour
			l'examen par leur service achats. Un DPA signé crée pour
			Kiff Agents OÜ de réelles obligations, dont les autorités
			de contrôle de l'UE peuvent exiger le respect. Contact pour
			les achats :
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</header>
}

templ dpaPartiesFR() {
	<section id="parties">
		<h2>1. Parties</h2>
		<p>Ce DPA est conclu entre :</p>
		<ul>
			<li><strong>Kiff Agents OÜ</strong>, société à responsabilité limitée estonienne, code d'immatriculation 17372313, numéro de TVA EE102924327, dont le siège social est situé Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estonie (le <strong>« Sous-traitant »</strong>) ; et</li>
			<li><strong>[DÉNOMINATION SOCIALE DU CLIENT]</strong>, dont le siège social est situé <strong>[ADRESSE]</strong>, code d'immatriculation <strong>[CODE D'IMMATRICULATION]</strong> (le <strong>« Responsable du traitement »</strong>).</li>
		</ul>
		<p>
			Chacune une « partie » et, ensemble, les « parties ». Ce
			DPA complète les Conditions d'utilisation publiées sur
			<a href="/fr/terms">/terms</a> et tout bon de commande
			commercial entre les parties ; en cas de conflit sur des
			questions de protection des données, ce DPA prévaut.
		</p>
	</section>
}

templ dpaDefinitionsFR() {
	<section id="definitions">
		<h2>2. Définitions</h2>
		<p>
			Les termes commençant par une majuscule qui ne sont pas
			définis ici ont le sens que leur donne le RGPD (règlement
			(UE) 2016/679).
		</p>
		<ul>
			<li><strong>« RGPD »</strong> — le règlement général sur la protection des données de l'UE.</li>
			<li><strong>« Données personnelles »</strong>, <strong>« Personne concernée »</strong>, <strong>« Traitement »</strong>, <strong>« Responsable du traitement »</strong>, <strong>« Sous-traitant »</strong>, <strong>« Sous-traitant ultérieur »</strong>, <strong>« Violation de données personnelles »</strong> — au sens de l'article 4 du RGPD ; « Données personnelles » désigne les « données à caractère personnel » au sens de cet article, et « Violation de données personnelles » la « violation de données à caractère personnel ».</li>
			<li><strong>« Données d'audit »</strong> — les Données personnelles que le Responsable du traitement soumet au Service ou génère dans celui-ci par le runtime, y compris les événements, les décisions, les actions, les approbations et les reçus.</li>
			<li><strong>« Données tafs »</strong> — les Données personnelles contenues dans ce que tafs conserve pour le compte du Responsable du traitement : les exécutions et les chats de chaque taf (y compris ce que les apps connectées du Responsable du traitement lui renvoient) et les chats de Setup, ses rapports, ses notes de mémoire, les appareils enregistrés pour ses alertes, et les connexions du Responsable du traitement à ses apps dans planque (l'enregistrement de chaque connexion et de ses approbations, et le jeton ou la clé que planque conserve pour elle). L'annexe 4 les décrit.</li>
			<li><strong>« Service »</strong> — le produit KIFF Cloud, tafs compris, tel que défini dans les Conditions d'utilisation.</li>
			<li><strong>« Clauses contractuelles types »</strong> ou <strong>« CCT »</strong> — les clauses contractuelles types de 2021 de la Commission européenne pour le transfert de Données personnelles vers des pays tiers.</li>
			<li><strong>« DPF »</strong> — la décision d'adéquation relative au cadre de protection des données UE–États-Unis (Data Privacy Framework).</li>
			<li><strong>« MTO »</strong> — les mesures techniques et organisationnelles décrites à l'annexe 2.</li>
		</ul>
	</section>
}

templ dpaScopeFR() {
	<section id="scope">
		<h2>3. Champ d'application et rôles</h2>
		<p>
			Ce DPA s'applique lorsque Kiff Agents OÜ traite des Données
			personnelles pour le compte du Responsable du traitement
			dans le cadre du Service. Pour les Données d'audit et les
			Données tafs, le Responsable du traitement est le
			Responsable du traitement et Kiff Agents OÜ est le
			Sous-traitant.
		</p>
		<p>
			Les Données personnelles que nous traitons au sujet des
			titulaires de compte du Responsable du traitement
			(métadonnées de connexion, contacts de facturation,
			correspondance avec l'assistance) sont régies par notre
			<a href="/fr/privacy">politique de confidentialité</a> ;
			pour ces données, nous sommes un Responsable du traitement
			indépendant, et non un Sous-traitant au titre de ce DPA.
		</p>
	</section>
}

templ dpaSubjectMatterFR() {
	<section id="subject-matter">
		<h2>4. Objet et durée</h2>
		<p>
			<strong>Objet :</strong> le Traitement des Données d'audit
			et des Données tafs pour fournir le Service.
		</p>
		<p>
			<strong>Durée :</strong> de la date d'entrée en vigueur de
			ce DPA jusqu'au plus tardif des deux événements suivants :
			(a) la résiliation des Conditions d'utilisation
			sous-jacentes, ou (b) la suppression de toutes les Données
			d'audit conformément au § 16. Les dispositions qui, par
			nature, survivent à la résiliation (audit, indemnisation,
			droit applicable) y survivent.
		</p>
	</section>
}

templ dpaNaturePurposeFR() {
	<section id="nature-purpose">
		<h2>5. Nature et finalité du traitement</h2>
		<p>
			Kiff Agents OÜ ne traite les Données d'audit que dans la
			mesure nécessaire pour fournir le Service : recevoir les
			propositions et les appels d'outils, les évaluer au regard
			de la configuration et des Cards du Responsable du
			traitement, les retenir pour approbation humaine lorsque la
			configuration l'exige, transmettre un appel autorisé à
			l'app connectée ou émettre une autorisation que l'app
			vérifie, enregistrer les décisions et le résultat que l'app
			signale, émettre des Reçus signés et (lorsque le
			Responsable du traitement l'a configuré ainsi) publier sur
			une piste publique vérifiable des empreintes de synthèse
			qui rendent toute altération détectable. C'est l'app
			connectée qui exécute l'action sous-jacente ; une décision
			d'autorisation ne prouve pas à elle seule que l'action a
			été exécutée.
		</p>
		<p>
			Pour tafs, Kiff Agents OÜ traite aussi les Données tafs
			pour faire tourner chaque taf que le Responsable du
			traitement lance : le faire tourner selon son planning et
			dans les chats avec les personnes du Responsable du
			traitement, envoyer ses appels d'outils par KIFF, conserver
			ses exécutions, ses chats et ses notes de mémoire pour
			qu'il puisse rendre compte et poursuivre son travail, et
			alerter les appareils enregistrés du Responsable du
			traitement quand un appel est retenu. Par Setup
			et planque, elle connecte aussi les apps du Responsable du
			traitement lorsque les personnes du Responsable du
			traitement se connectent chez le fournisseur de l'app et
			approuvent la connexion sur leur appareil : pour une app à laquelle planque se connecte lui-même, comme Stripe, ou une clé fournie par le Responsable du traitement, planque conserve ce jeton ou cette clé, chiffrés, et ne les utilise que pour effectuer un appel que KIFF a décidé ; pour une connexion gérée, Composio détient l'authentification et n'effectue que les appels que planque lui demande, et planque conserve l'enregistrement de la connexion et les outils approuvés. KIFF n'utilise des connexions gérées que pour les apps citées sur <a href="/fr/subprocessors#composio">kiff.dev/subprocessors</a>.
			L'annexe 4 précise les données, l'endroit où elles sont
			conservées et pour combien de temps.
		</p>
	</section>
}

templ dpaCategoriesFR() {
	<section id="categories">
		<h2>6. Catégories de Personnes concernées et de Données personnelles</h2>
		<p>
			Par défaut, Kiff Agents OÜ traite les catégories de Données
			personnelles suivantes, comme le décrit l'inventaire publié
			sur
			<a href="/fr/security#data-we-process">/security#data-we-process</a> :
		</p>
		<ul>
			<li><strong>Données de compte</strong> : qui sont les personnes du Responsable du traitement dans son compte (noms, adresses e-mail, rôles), et ses agents et leurs clés. Les métadonnées de connexion que Kiff Agents OÜ conserve en tant que responsable du traitement restent régies par le § 3.</li>
			<li><strong>Connexions aux apps</strong> : chaque connexion aux apps du Responsable du traitement, les outils approuvés, l'enregistrement de qui les a approuvés, et, lorsque planque le détient, son jeton ou sa clé (chiffrés).</li>
			<li><strong>Enregistrements des actions des agents</strong> : pour chaque appel, qui a demandé (l'agent et la clé), l'action, ce sur quoi elle a porté, le résultat et ses raisons, la Card en vigueur, les paramètres numériques, les appels retenus et leurs réponses, et les reçus.</li>
			<li><strong>Chats avec les tafs</strong> : les exécutions et les chats de chaque taf, ses rapports et ses notes de mémoire, et ce que les apps du Responsable du traitement lui renvoient, comme le décrit l'annexe 4.</li>
		</ul>
		<p>
			Les <strong>Personnes concernées</strong> sont les
			personnes du Responsable du traitement qui utilisent le
			Service, et les personnes dont les données apparaissent
			dans les actions de ses agents et dans les chats avec les
			tafs, comme les clients, les fournisseurs ou le personnel
			du Responsable du traitement.
		</p>
		<p>
			Ce qui atteint le Service par ailleurs dépend de la
			configuration du Responsable du traitement et des données
			qu'il envoie ; Kiff Agents OÜ ne contrôle pas les champs
			que le Responsable du traitement envoie. Le Responsable du
			traitement ajoute toute autre catégorie à l'annexe 1, qui
			est mise à jour lorsque la configuration change de façon
			substantielle.
		</p>
	</section>
}

templ dpaInstructionsFR() {
	<section id="instructions">
		<h2>7. Instructions du Responsable du traitement</h2>
		<p>
			Kiff Agents OÜ traitera les Données personnelles
			conformément aux instructions documentées du Responsable du
			traitement. Ces instructions comprennent ce DPA, les
			Conditions d'utilisation, la documentation technique du
			Service et les mesures de sécurité dans la révision datée
			publiée sur
			<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>,
			ainsi que les configurations et les instructions soumises
			via le Service par les utilisateurs autorisés du
			Responsable du traitement.
		</p>
		<p>
			Le livre blanc stratégique et la documentation du framework
			open source, qui fait l'objet d'une licence distincte, sont
			des références explicatives et ne font pas partie de ces
			instructions de traitement. La publication d'un document
			révisé ne modifie pas, à elle seule, les instructions
			applicables à un accord existant.
		</p>
		<p>
			Les instructions qui sortent de ce cadre exigent un accord
			écrit. Si Kiff Agents OÜ estime qu'une instruction est
			contraire au RGPD ou à une autre loi applicable sur la
			protection des données, elle en informera le Responsable du
			traitement.
		</p>
	</section>
}

templ dpaProcessorObligationsFR() {
	<section id="processor-obligations">
		<h2>8. Obligations du Sous-traitant (article 28, paragraphe 3)</h2>
		<p>
			Kiff Agents OÜ :
		</p>
		<ol>
			<li>ne traitera les Données personnelles que sur instruction documentée du Responsable du traitement, y compris en ce qui concerne les transferts internationaux, sauf si le droit de l'UE ou d'un État membre l'oblige à faire autrement (auquel cas Kiff Agents OÜ informera le Responsable du traitement de cette obligation légale avant le Traitement, sauf si ce droit interdit une telle information pour des motifs importants d'intérêt public) ;</li>
			<li>veillera à ce que les personnes autorisées à traiter les Données personnelles soient soumises à des obligations de confidentialité appropriées ;</li>
			<li>mettra en œuvre les mesures techniques et organisationnelles décrites à l'annexe 2 ;</li>
			<li>respectera les conditions de recours aux Sous-traitants ultérieurs prévues au § 10 ;</li>
			<li>compte tenu de la nature du Traitement, aidera le Responsable du traitement, par des mesures appropriées, à s'acquitter de ses obligations de répondre aux demandes des Personnes concernées au titre du chapitre III du RGPD ;</li>
			<li>aidera le Responsable du traitement à assurer le respect des articles 32 à 36 du RGPD (sécurité, notification des violations, analyse d'impact relative à la protection des données, consultation préalable), compte tenu de la nature du Traitement et des informations dont dispose Kiff Agents OÜ ;</li>
			<li>au choix du Responsable du traitement, supprimera ou restituera toutes les Données personnelles à la fin des services conformément au § 16, et supprimera les copies existantes, sauf si le droit de l'UE ou d'un État membre en exige la conservation ;</li>
			<li>mettra à la disposition du Responsable du traitement toutes les informations nécessaires pour démontrer le respect de l'article 28 du RGPD, et permettra la réalisation d'audits au titre du § 15 et y contribuera.</li>
		</ol>
	</section>
}

templ dpaConfidentialityFR() {
	<section id="confidentiality">
		<h2>9. Confidentialité</h2>
		<p>
			Kiff Agents OÜ veille à ce que les personnes ayant accès
			aux Données personnelles soient liées par des obligations
			de confidentialité écrites ou soumises à une obligation
			légale de confidentialité appropriée. L'accès est accordé
			selon le principe du moindre privilège et il est
			journalisé.
		</p>
	</section>
}

templ dpaSubprocessorsFR() {
	<section id="sub-processors">
		<h2>10. Sous-traitants ultérieurs</h2>
		<p>
			Le Responsable du traitement autorise Kiff Agents OÜ à
			recourir aux Sous-traitants ultérieurs énumérés à
			l'annexe 3 et sur
			<a href="/fr/subprocessors">/subprocessors</a>, qui est la
			liste officielle. Kiff Agents OÜ impose à chaque
			Sous-traitant ultérieur des obligations de protection des
			données qui ne sont pas moins protectrices que ce DPA.
		</p>
		<p>
			La piste publique vérifiable n'est pas un Sous-traitant
			ultérieur. Elle ne reçoit que des empreintes de synthèse et
			aucune Donnée personnelle.
		</p>
		<p>
			La révision datée citée au § 7 consigne la liste telle
			qu'elle était à sa date. Un changement ultérieur prend
			effet en vertu de la présente section, et non par la
			publication d'une révision.
		</p>
		<p>
			Lorsque Kiff Agents OÜ a l'intention de recourir à un
			nouveau Sous-traitant ultérieur ou d'en remplacer un pour
			le Traitement des Données personnelles du Responsable du
			traitement, Kiff Agents OÜ en informe le Responsable du
			traitement au moins trente jours à l'avance. Le Responsable
			du traitement peut s'opposer au changement pour des motifs
			raisonnables de protection des données dans les quinze
			jours suivant la notification ; si une opposition
			raisonnable ne peut pas être résolue, chaque partie peut
			résilier la partie concernée du Service par notification
			écrite.
		</p>
	</section>
}

templ dpaTransfersFR() {
	<section id="transfers">
		<h2>11. Transferts internationaux</h2>
		<p>
			Lorsque le Traitement de Données personnelles implique un
			transfert vers un pays situé hors de l'Espace économique
			européen qui ne fait pas l'objet d'une décision
			d'adéquation au titre de l'article 45 du RGPD, les parties
			conviennent que :
		</p>
		<ul>
			<li>pour les transferts vers des Sous-traitants ultérieurs certifiés au titre du cadre de protection des données UE–États-Unis, le DPF est le mécanisme de transfert tant qu'il reste en vigueur ;</li>
			<li>dans les autres cas, les parties intègrent par renvoi les Clauses contractuelles types de 2021 de la Commission européenne, le module 2 (de responsable du traitement à sous-traitant) s'appliquant aux transferts du Responsable du traitement vers Kiff Agents OÜ et le module 3 (de sous-traitant à sous-traitant ultérieur) s'appliquant aux transferts de Kiff Agents OÜ vers un Sous-traitant ultérieur ;</li>
			<li>la clause d'adhésion (clause 7) n'est pas utilisée ; les parties aux CCT sont le Responsable du traitement et Kiff Agents OÜ ;</li>
			<li>les annexes I.A et I.B des CCT sont complétées par renvoi à l'annexe 1 de ce DPA ; l'annexe II des CCT par renvoi à l'annexe 2 de ce DPA ; l'annexe III par renvoi à l'annexe 3 de ce DPA ;</li>
			<li>l'option 2 de la clause 9, point a) (autorisation écrite générale) s'applique, avec le délai de notification de trente jours prévu au § 10 ci-dessus.</li>
		</ul>
		<p>
			Lorsque des mesures supplémentaires sont appropriées à la
			suite d'une analyse d'impact du transfert, Kiff Agents OÜ
			les met en œuvre (chiffrement en transit et au repos,
			journalisation des accès, minimisation des données, comme
			le décrit l'annexe 2).
		</p>
	</section>
}

templ dpaSecurityFR() {
	<section id="security">
		<h2>12. Mesures de sécurité</h2>
		<p>
			Kiff Agents OÜ met en œuvre les mesures techniques et
			organisationnelles appropriées pour garantir un niveau de
			sécurité adapté au risque, conformément à l'article 32 du
			RGPD. Les mesures de l'annexe 2 et de la révision datée
			publiée sur
			<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>
			constituent le socle convenu.
			<a href="/fr/security">/security</a> décrit les mesures
			actuelles. Kiff Agents OÜ peut mettre à jour les mesures, à
			condition que le niveau global de sécurité ne descende pas
			sous ce socle, et informe à l'avance le Responsable du
			traitement de tout changement substantiel de celles-ci.
		</p>
	</section>
}

templ dpaBreachNotificationFR() {
	<section id="breach-notification">
		<h2>13. Notification des Violations de données personnelles</h2>
		<p>
			Kiff Agents OÜ notifie au Responsable du traitement toute
			Violation de données personnelles touchant les Données
			personnelles du Responsable du traitement dans les
			meilleurs délais et, en tout état de cause, dans les
			soixante-douze (72) heures après en avoir pris
			connaissance. La notification comprend, dans la mesure de
			ce qui est connu à ce moment-là, et elle est complétée à
			mesure que d'autres informations deviennent disponibles :
		</p>
		<ul>
			<li>la nature de la Violation, y compris les catégories et le nombre approximatif de Personnes concernées et d'enregistrements concernés ;</li>
			<li>les conséquences probables de la Violation ;</li>
			<li>les mesures prises ou proposées pour remédier à la Violation et en atténuer les éventuels effets négatifs ;</li>
			<li>le nom et les coordonnées d'un point de contact unique chez Kiff Agents OÜ pour toute information complémentaire.</li>
		</ul>
		<p>
			Le délai propre au Responsable du traitement pour notifier
			la Violation à son autorité de contrôle au titre de l'article 33 du RGPD
			court à partir du moment où le Responsable du traitement a
			lui-même connaissance de la Violation ; la présente
			notification vient à l'appui de cette obligation.
		</p>
	</section>
}

templ dpaDataSubjectRequestsFR() {
	<section id="data-subject-requests">
		<h2>14. Demandes des Personnes concernées</h2>
		<p>
			Kiff Agents OÜ aide le Responsable du traitement, par des
			mesures techniques et organisationnelles appropriées et
			compte tenu de la nature du Traitement, à s'acquitter de
			ses obligations de répondre aux demandes des Personnes
			concernées qui exercent leurs droits au titre des articles
			15 à 22 du RGPD.
		</p>
		<p>
			Kiff Agents OÜ accuse réception des demandes d'assistance
			du Responsable du traitement dans un délai de cinq (5)
			jours ouvrés. Les demandes reçues directement de Personnes
			concernées sont transmises au Responsable du traitement
			dans les meilleurs délais ; Kiff Agents OÜ ne répond pas à
			ces demandes en son nom propre, sauf pour en accuser
			réception et orienter la Personne concernée vers le
			Responsable du traitement.
		</p>
	</section>
}

templ dpaAuditFR() {
	<section id="audit">
		<h2>15. Droits d'audit</h2>
		<p>
			Kiff Agents OÜ met à la disposition du Responsable du
			traitement toutes les informations raisonnablement
			nécessaires pour démontrer le respect de l'article 28 du
			RGPD. Moyennant un préavis écrit raisonnable (au moins
			trente jours, sauf pour un audit déclenché par une
			violation substantielle confirmée), le Responsable du
			traitement peut auditer Kiff Agents OÜ une fois par période
			de douze mois.
		</p>
		<p>
			Kiff Agents OÜ n'a pas encore de rapport SOC 2 ou
			ISO 27001. Sur demande, elle communique sa présentation de
			la sécurité publiée sur
			<a href="/fr/security">/security</a> et répond aux
			questionnaires de sécurité du Responsable du traitement.
		</p>
		<p>
			Les audits sont menés pendant les heures normales de
			bureau, ne perturbent pas le Service de façon
			déraisonnable et respectent la confidentialité des autres
			clients de Kiff Agents OÜ. Le Responsable du traitement
			supporte ses propres frais d'audit ; lorsqu'un audit révèle
			une non-conformité substantielle de Kiff Agents OÜ, Kiff
			Agents OÜ rembourse les frais d'audit raisonnables du
			Responsable du traitement.
		</p>
	</section>
}

templ dpaReturnDeletionFR() {
	<section id="return-deletion">
		<h2>16. Restitution ou suppression des Données personnelles</h2>
		<p>
			Au choix du Responsable du traitement, et dans les trente
			jours suivant la fin du Service pour le Responsable du
			traitement, Kiff Agents OÜ soit restitue les Données
			d'audit dans un format structuré, couramment utilisé et
			lisible par machine, soit les supprime. Le même choix
			s'applique aux Données tafs. En l'absence de choix dans ce
			délai, Kiff Agents OÜ supprime les unes et les autres. Les
			Données tafs sont supprimées en supprimant chaque taf,
			comme le décrit l'annexe 4 : après la restitution des
			données du Responsable du traitement, ou tout de suite
			lorsqu'il a choisi la suppression, Kiff Agents OÜ supprime
			tout taf que le Responsable du traitement n'a pas supprimé,
			et déconnecte et supprime les connexions du Responsable du
			traitement et leurs enregistrements dans planque.
		</p>
		<p>
			Les empreintes déjà publiées sur la piste publique
			vérifiable demeurent, parce que cette piste est immuable.
			Comme la piste publique utilise un salage cryptographique
			par locataire (voir
			<a href="/fr/security#public-trail">/security#public-trail</a>),
			la destruction du sel du locataire rend ces
			empreintes publiées définitivement impossibles à relier aux
			enregistrements qui les ont produites.
		</p>
		<p>
			La base de données de KIFF est sauvegardée chaque jour,
			chiffrée, et chaque sauvegarde est gardée sept jours : un
			enregistrement supprimé en a donc disparu dans les sept
			jours suivant sa suppression. Les stockages de tafs et de
			planque gardent des copies chiffrées à un instant donné
			pendant 35 jours : un enregistrement supprimé en a donc
			disparu dans les 35 jours suivant sa suppression ; elles
			ne servent qu'à restaurer un stockage après une panne. Les
			journaux de service, qui peuvent nommer le compte, sont
			supprimés sous 30 jours. Kiff Agents OÜ peut conserver
			des Données personnelles lorsque le droit de l'UE ou d'un
			État membre en exige la conservation (par exemple, la loi
			comptable estonienne, § 12).
		</p>
	</section>
}

templ dpaLiabilityFR() {
	<section id="liability">
		<h2>17. Responsabilité</h2>
		<p>
			La responsabilité de chaque partie au titre de ce DPA est
			soumise aux limitations et aux exclusions prévues dans les
			Conditions d'utilisation, sauf lorsque la loi applicable
			interdit une telle limitation. Chaque partie répond du
			dommage causé par sa propre violation du RGPD,
			conformément à l'article 82 du RGPD.
		</p>
	</section>
}

templ dpaTermFR() {
	<section id="term">
		<h2>18. Durée et résiliation</h2>
		<p>
			Ce DPA prend effet à sa signature par les deux parties et
			reste en vigueur pendant la durée décrite au § 4. La
			résiliation des Conditions d'utilisation met
			automatiquement fin à ce DPA, sous réserve des obligations
			qui lui survivent.
		</p>
	</section>
}

templ dpaGoverningLawFR() {
	<section id="governing-law">
		<h2>19. Droit applicable</h2>
		<p>
			Ce DPA est régi par le droit de la République d'Estonie,
			sans préjudice des dispositions impératives du RGPD ni,
			le cas échéant, des règles de protection des
			consommateurs. Les litiges nés de ce DPA sont soumis aux
			règles de juridiction compétente et de droit applicable du
			§ 18 des Conditions d'utilisation.
		</p>
	</section>
}

templ dpaAnnex1FR() {
	<section id="annex-1">
		<h2>Annexe 1 — Description du Traitement</h2>
		<p>À compléter pour chaque exemplaire signé.</p>
		<dl class="legal-annex">
			<div>
				<dt>A. Liste des parties</dt>
				<dd>Le Responsable du traitement et le Sous-traitant identifiés au § 1.</dd>
			</div>
			<div>
				<dt>B. Description du transfert</dt>
				<dd>
					<strong>Catégories de Personnes concernées :</strong> celles énumérées au § 6, plus [toute autre catégorie que le Responsable du traitement déclare].
					<br/>
					<strong>Catégories de Données personnelles :</strong> celles énumérées au § 6 (données de compte, connexions aux apps, enregistrements des actions des agents, chats avec les tafs), plus [toute autre catégorie que le Responsable du traitement déclare].
					<br/>
					<strong>Données sensibles :</strong> [déclaration du Responsable du traitement ; par défaut : aucune].
					<br/>
					<strong>Fréquence du transfert :</strong> continue (chaque requête adressée au Service).
					<br/>
					<strong>Nature du Traitement :</strong> celle décrite au § 5.
					<br/>
					<strong>Finalités du Traitement :</strong> celles décrites au § 5.
					<br/>
					<strong>Durée de conservation :</strong> selon <a href="/fr/privacy#retention">/privacy#retention</a> et le § 16.
				</dd>
			</div>
			<div>
				<dt>C. Autorité de contrôle compétente</dt>
				<dd>L'Inspection estonienne de la protection des données (Andmekaitse Inspektsioon).</dd>
			</div>
		</dl>
	</section>
}

templ dpaAnnex2FR() {
	<section id="annex-2">
		<h2>Annexe 2 — Mesures techniques et organisationnelles</h2>
		<p>
			Un résumé adapté à un DPA au titre de l'article 28. Cette
			annexe et la révision datée publiée sur
			<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>
			constituent le socle convenu au titre du § 12.
			<a href="/fr/security">/security</a> présente les mesures
			actuelles et est mise à jour dans les 30 jours suivant un
			changement substantiel.
		</p>
		<div class="legal-table" tabindex="0">
			<table>
				<thead>
					<tr>
						<th>Dimension de l'article 32</th>
						<th>Mesures</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Pseudonymisation et chiffrement</td>
						<td>TLS 1.2+ en transit. Chiffrement au repos avec les réglages par défaut du fournisseur de base de données gérée. Clés de signature par locataire conservées dans un service de clés géré. Le stockage des adresses e-mail sous forme d'empreinte est prévu.</td>
					</tr>
					<tr>
						<td>Confidentialité</td>
						<td>Isolation des locataires au niveau de la base de données (un schéma Postgres par locataire, avec un <code>search_path</code> fixé). Accès selon le principe du moindre privilège, authentification unique (SSO) pour le personnel, accords de confidentialité pour tout le personnel.</td>
					</tr>
					<tr>
						<td>Intégrité</td>
						<td>Chaîne d'audit en ajout seul au niveau du framework. Empreintes de synthèse qui rendent toute altération détectable, publiées sur une piste publique vérifiable.</td>
					</tr>
					<tr>
						<td>Disponibilité et résilience</td>
						<td>Calcul et base de données gérés dans <code>eu-west-1</code> (Irlande). Contrôles d'état. Notes d'exploitation sur <a href="/fr/security#incident">/security#incident</a>.</td>
					</tr>
					<tr>
						<td>Rétablissement de l'accès</td>
						<td>Runbook de réponse aux incidents documenté, à usage interne uniquement.</td>
					</tr>
					<tr>
						<td>Tests d'efficacité</td>
						<td>Tests unitaires et d'intégration, exécutés avant chaque mise en production ; revue de sécurité périodique.</td>
					</tr>
				</tbody>
			</table>
		</div>
	</section>
}

templ dpaAnnex3FR() {
	<section id="annex-3">
		<h2>Annexe 3 — Sous-traitants ultérieurs</h2>
		<p>
			La liste officielle se trouve sur
			<a href="/fr/subprocessors">/subprocessors</a> ;
			cette liste fait foi pour les Sous-traitants ultérieurs
			actuels, ne change que selon la procédure du § 10, et est
			mise à jour dans les 30 jours suivant toute modification.
			À la date de cette version du modèle :
		</p>
		<div class="legal-table" tabindex="0">
			<table>
				<thead>
					<tr>
						<th>Sous-traitant ultérieur</th>
						<th>Service fourni</th>
						<th>Région</th>
						<th>Mécanisme de transfert</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Amazon Web Services EMEA SARL / Amazon Web Services Inc.</td>
						<td>Calcul, Postgres géré, gestion des clés, réseau, stockage des secrets ; pour tafs, aussi ses exécutions, ses chats et ses notes de mémoire, et les connexions de planque</td>
						<td>Irlande (eu-west-1) : KIFF Cloud, le service tafs, les exécutions, les chats et les appels de modèle de tafs, et planque, avec tout ce qu'ils stockent. L'Irlande sert aussi les démos publiques de KIFF et les vidéos du site. La seule chose située aux États-Unis (us-east-1), ce sont les certificats que CloudFront exige là-bas, et ils ne contiennent aucune donnée de client</td>
						<td>Cadre de protection des données UE–États-Unis / CCT à défaut</td>
					</tr>
					<tr>
						<td>Clerk, Inc.</td>
						<td>Authentification des utilisateurs et gestion des sessions : l'adresse e-mail et le nom des personnes qui se connectent, leurs sessions, leur adresse IP, leur appareil et leur navigateur, et l'identité fournie par Apple, Google ou GitHub quand quelqu'un se connecte avec l'un d'eux</td>
						<td>États-Unis</td>
						<td>Cadre de protection des données UE–États-Unis / CCT à défaut</td>
					</tr>
					<tr>
						<td>Anthropic, PBC</td>
						<td>tafs uniquement : le modèle d'IA derrière Coach et chaque taf (Claude API), qui ne reçoit des données qu'une fois que la personne l'a autorisé dans l'app tafs. Anthropic supprime ce qu'il reçoit et renvoie sous 30 jours, sauf s'il doit le conserver plus longtemps pour respecter la loi, pour faire appliquer sa politique d'utilisation, ou si ses conditions commerciales en disposent autrement</td>
						<td>États-Unis, appelé depuis l'Irlande (eu-west-1) ; l'inférence peut s'exécuter aux États-Unis, en Europe, en Asie ou en Australie</td>
						<td>CCT</td>
					</tr>
					<tr>
						<td>Apple Inc.</td>
						<td>tafs uniquement : remet les alertes d'appel retenu aux appareils enregistrés (Apple Push Notification service). Une alerte ne contient aucun détail de la demande</td>
						<td>États-Unis</td>
						<td>CCT</td>
					</tr>
					<tr>
						<td>Resend, Inc.</td>
						<td>Les e-mails aux personnes du Responsable du traitement : les notifications d'appel retenu et d'avertissement de Card, les notifications d'utilisation et de compte, et les réponses de l'assistance ; pour tafs, la porte e-mail d'un taf, les messages qui lui sont envoyés et ses réponses</td>
						<td>États-Unis</td>
						<td>CCT</td>
					</tr>
					<tr>
						<td>Sampark Inc. (Composio)</td>
						<td>tafs uniquement, via planque : détient les identifiants des connexions gérées et le bot Slack derrière une porte Slack, et effectue chaque appel que planque demande, avec ses données d'entrée et la réponse du service. Ni un taf ni planque ne reçoivent ces identifiants</td>
						<td>États-Unis</td>
						<td>CCT (module 3)</td>
					</tr>
					<tr>
						<td>Stripe Payments Europe, Ltd. / Stripe, Inc.</td>
						<td>La facturation, quand elle est active : le contact de facturation du compte, et les relevés d'utilisation transmis pour la facturation</td>
						<td>UE et États-Unis</td>
						<td>Cadre de protection des données UE–États-Unis / CCT à défaut</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p>
			La piste publique vérifiable n'est pas un Sous-traitant
			ultérieur : elle ne reçoit que des empreintes de synthèse
			et aucune Donnée personnelle.
		</p>
	</section>
}

templ dpaAnnex4FR() {
	<section id="annex-4">
		<h2>Annexe 4 — tafs</h2>
		<p>
			Ce que tafs conserve pour le compte du Responsable du
			traitement, où, et pour combien de temps. Le Responsable du
			traitement supprime un taf dans l'app tafs ; cette
			suppression efface tout ce qui, ci-dessous, est conservé
			« jusqu'à la suppression du taf ».
		</p>
		<div class="legal-table" tabindex="0">
			<table>
				<thead>
					<tr>
						<th>Données</th>
						<th>Où</th>
						<th>Ce qu'elles peuvent contenir</th>
						<th>Combien de temps</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Les exécutions et les chats, y compris ceux de Setup</td>
						<td>Le stockage propre à tafs (AWS, une région de l'UE)</td>
						<td>Les messages des personnes du Responsable du traitement au taf, ses réponses et ses rapports, un résumé des premiers messages d'un long chat, les appels d'outils qu'il a faits, et ce que chaque exécution a coûté</td>
						<td>30 jours, ou jusqu'à la suppression du taf si elle intervient avant</td>
					</tr>
					<tr>
						<td>Ce que les apps renvoient</td>
						<td>Le stockage propre à tafs (AWS, une région de l'UE)</td>
						<td>Les résultats des apps du Responsable du traitement, qui peuvent inclure des données sur ses clients, ses fournisseurs ou son personnel</td>
						<td>Jusqu'à la fin de l'exécution qui les a lus. Dans un chat, les résultats des appels qui ne font que lire sont conservés pour les messages suivants de ce chat, chiffrés avec une clé du compte du Responsable du traitement, et utilisés jusqu'à ce que le chat soit resté inactif une heure, et jamais plus de quatre heures après la lecture. Ils sont ensuite supprimés automatiquement, ce qui peut prendre jusqu'à quelques jours, pendant lesquels ils ne sont pas utilisés. Ils n'apparaissent dans aucun écran, rapport ou export</td>
					</tr>
					<tr>
						<td>Ce sur quoi chaque appel a agi</td>
						<td>Le stockage propre à tafs (AWS, une région de l'UE)</td>
						<td>Pour chaque appel qu'un taf fait via KIFF, la référence de KIFF pour l'appel et l'identifiant de ce sur quoi il a agi (par exemple un identifiant de paiement, jamais les données du client), pour l'afficher dans le Registre du taf. Rien d'autre des données d'entrée de l'appel</td>
						<td>30 jours, ou jusqu'à la suppression du taf si elle intervient avant</td>
					</tr>
					<tr>
						<td>Les notes de mémoire</td>
						<td>Le stockage propre à tafs (AWS, une région de l'UE)</td>
						<td>Ce que le taf a appris sur la façon dont le Responsable du traitement veut que la mission soit faite</td>
						<td>Jusqu'à ce que la note soit oubliée ou que le taf soit supprimé</td>
					</tr>
					<tr>
						<td>Les requêtes au modèle</td>
						<td>Anthropic</td>
						<td>Ce qu'une personne écrit à Coach et aux tafs, les fichiers joints, ce que les apps connectées renvoient à un taf pendant une exécution, et ce qui est à l'écran quand Coach aide dans l'app ; et ce que le modèle renvoie. Jamais les mots de passe et clés des apps connectées, ni une empreinte</td>
						<td>Supprimées par Anthropic sous 30 jours par défaut ; plus tard lorsqu'Anthropic doit les conserver pour respecter la loi, pour faire appliquer sa politique d'utilisation, ou si ses conditions commerciales en disposent autrement</td>
					</tr>
					<tr>
						<td>La clé KIFF du taf</td>
						<td>Le service propre à tafs (AWS), conservée comme un secret</td>
						<td>L'identifiant d'accès que le taf utilise pour joindre KIFF. Jamais écrit dans une exécution ou un chat</td>
						<td>Jusqu'à la suppression du taf</td>
					</tr>
					<tr>
						<td>La configuration du taf</td>
						<td>Le service propre à tafs (AWS)</td>
						<td>Son nom, sa mission, son planning et son budget, et le compte KIFF et l'agent auxquels il appartient</td>
						<td>Jusqu'à la suppression du taf</td>
					</tr>
					<tr>
						<td>Les appareils pour les alertes</td>
						<td>Le service propre à tafs (AWS, eu-west-1)</td>
						<td>Le jeton push de chaque appareil enregistré et la personne qui l'a enregistré</td>
						<td>Jusqu'à ce que cette personne se déconnecte, que l'appareil soit retiré, ou qu'Apple signale que le jeton n'existe plus</td>
					</tr>
					<tr>
						<td>Le jeton ou la clé d'une connexion dans planque</td>
						<td>planque (AWS, eu-west-1), chiffré avec AWS KMS</td>
						<td>Pour une app à laquelle planque se connecte lui-même, comme Stripe, le jeton issu de l'authentification du Responsable du traitement chez son fournisseur, et le compte chez ce fournisseur auquel il est lié ; pour une connexion par clé, la clé fournie par le Responsable du traitement. Jamais remis à un taf</td>
						<td>Jusqu'à ce que la connexion soit déconnectée, ce qui révoque un jeton chez le fournisseur et supprime le jeton ou la clé; une authentification qu'une autre connexion du compte utilise encore est conservée jusqu'à ce que la dernière prenne fin. Une authentification faite uniquement pour voir le catalogue d'une app ne peut pas servir à des appels ; si aucun outil n'est approuvé dans un délai d'un jour, elle est révoquée dans l'heure qui suit</td>
					</tr>
					<tr>
						<td>L'authentification d'une connexion gérée</td>
						<td>Composio (Sampark Inc., États-Unis)</td>
						<td>Le jeton ou la clé issu de l'authentification du Responsable du traitement chez le fournisseur d'une connexion gérée. Détenu par Composio et jamais remis à un taf ni à planque, qui ne conserve que l'enregistrement de la connexion et les outils approuvés. Composio la détient même lorsque l'authentification passe par l'app propre de KIFF chez le fournisseur</td>
						<td>Jusqu'à ce que la connexion soit déconnectée : planque la fait alors supprimer chez Composio, qui demande au fournisseur de la révoquer. Une authentification qu'une autre connexion du compte utilise encore est conservée jusqu'à ce que la dernière prenne fin. Si aucun outil n'est approuvé dans un délai d'un jour après l'authentification, elle est supprimée de la même façon</td>
					</tr>
					<tr>
						<td>Les appels d'une connexion gérée</td>
						<td>Composio (Sampark Inc., États-Unis)</td>
						<td>L'entrée de chaque appel et la réponse du service, pour un appel que planque demande à Composio</td>
						<td>Jusqu'à un an, dans les journaux de Composio ; supprimés dans les 30 jours après que KIFF a cessé d'utiliser Composio</td>
					</tr>
					<tr>
						<td>L'enregistrement d'une connexion</td>
						<td>planque (AWS, eu-west-1)</td>
						<td>Les outils approuvés, le statut de la connexion, et ses événements : qui a approuvé chaque étape, depuis quel appareil, et sa signature</td>
						<td>Jusqu'à la clôture du compte ; conservé après une déconnexion comme enregistrement des approbations</td>
					</tr>
					<tr>
						<td>La clé de connecteur du compte</td>
						<td>planque (AWS, eu-west-1), chiffrée avec AWS KMS</td>
						<td>La clé KIFF que planque utilise pour ajouter les outils d'une connexion au compte KIFF du Responsable du traitement. Elle ne peut qu'ajouter les outils d'une connexion</td>
						<td>Jusqu'à ce qu'elle soit remplacée, ou jusqu'à la clôture du compte</td>
					</tr>
					<tr>
						<td>Les journaux de service de planque</td>
						<td>planque (AWS, eu-west-1)</td>
						<td>Ce que chaque requête a fait, et pourquoi un appel a été refusé, ce qui peut nommer le compte, une connexion ou un taf ; jamais le jeton d'une connexion</td>
						<td>30 jours</td>
					</tr>
					<tr>
						<td>Les journaux de service</td>
						<td>Le service propre à tafs (AWS, eu-west-1)</td>
						<td>Les erreurs rencontrées par une requête, qui peuvent nommer un taf ou une session ; jamais le contenu des messages, ni des clés ou des jetons</td>
						<td>30 jours</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p>
			Les Cards d'un taf, ses appels retenus, leurs réponses et
			ses reçus sont des Données d'audit, conservées par KIFF
			selon le reste de ce DPA.
		</p>

		<hr/>

		<p class="legal-footnote">
			<strong>Version du document :</strong> modèle v0.1.<br/>
			<strong>Dernière mise à jour :</strong> 17 novembre 2026.
		</p>
	</section>
}
