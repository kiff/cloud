package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// PrivacySR is KIFF's privacy policy (/privacy) in Serbian, at /sr/privacy.
// It is a translation of Privacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Serbian has the legal
// texts only, so a link to any other page goes to English and says so.
templ PrivacySR() {
	@components.LayoutSite("KIFF — privacy policy", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@privacyHeadSR()
			@privacyWhoWeAreSR()
			@privacyScopeSR()
			@privacyRolesSR()
			@privacyCategoriesSR()
			@privacyLawfulBasesSR()
			@privacySubprocessorsSR()
			@privacyTransfersSR()
			@privacyRetentionSR()
			@privacyRightsSR()
			@privacyCookiesSR()
			@privacySecuritySR()
			@privacyChildrenSR()
			@privacyAutomatedSR()
			@privacyChangesSR()
			@privacyContactSR()
		</article>
	}
}

templ privacyHeadSR() {
	<header class="legal-head">
		<p class="legal-badge">Politika privatnosti · v0.1</p>
		<h1>Politika privatnosti</h1>
		<p class="legal-meta">
			<strong>Poslednje ažuriranje:</strong> 25. novembar 2026. <strong>Datum stupanja na snagu:</strong> 24. maj 2026.
		</p>
		<p class="legal-disclaimer">
			Ova politika objašnjava kako KIFF Cloud obrađuje podatke o ličnosti na veb-sajtu, kontrolnoj tabli, API-ju i u aplikaciji tafs za iPhone, iPad, Android i računare. Pitanja: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</header>
}

templ privacyWhoWeAreSR() {
	<section id="who-we-are">
		<h2>1. Ko smo mi</h2>
		<p>
			KIFF Cloud vodi <strong>Kiff Agents OÜ</strong>, privatno društvo sa ograničenom odgovornošću osnovano u Estoniji. Podaci iz registra:
		</p>
		<ul>
			<li><strong>Matični broj:</strong> 17372313 (estonski e-Business Register)</li>
			<li><strong>PDV broj:</strong> EE102924327</li>
			<li><strong>Registrovana adresa:</strong> Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estonija</li>
			<li><strong>Kontakt za privatnost:</strong> <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a></li>
			<li><strong>Zvanična pravna obaveštenja:</strong> <a href="mailto:legal@kiff.dev">legal@kiff.dev</a></li>
		</ul>
		<p>
			Pošto je Kiff Agents OÜ osnovan u Evropskoj uniji, Opšta uredba EU o zaštiti podataka (<abbr title="General Data Protection Regulation">GDPR</abbr>) primenjuje se neposredno na našu obradu. Ne zahtevamo predstavnika u EU prema članu 27.
		</p>
	</section>
}

templ privacyScopeSR() {
	<section id="scope">
		<h2>2. Obim ove politike</h2>
		<p>
			Ova politika obuhvata podatke o ličnosti koje obrađujemo kada koristite:
		</p>
		<ul>
			<li><a href="https://kiff.dev"><code>kiff.dev</code></a> — naš marketinški sajt, ovu stranicu politike i javnu površinu za prikaz potvrda.</li>
			<li><a href="https://app.kiff.dev"><code>app.kiff.dev</code></a> — našu kontrolnu tablu za prijavljene korisnike.</li>
			<li><a href="https://api.kiff.dev"><code>api.kiff.dev</code></a> — naš HTTP API.</li>
			<li id="tafs"><strong>tafs</strong> — našu aplikaciju za iPhone, iPad, Android i računare (Mac, Windows i Linux) i uslugu iza nje (uključujući Setup, koji povezuje alate kompanije, i planque, koji čuva te veze), u kojoj kompanija poverava posao AI agentu koji radi unutar KIFF Card-ova.</li>
		</ul>
		<p>
			Ova politika <em>ne</em> obuhvata open-source okvir <code>kiff/kiff</code> koji možete sami pokretati. Kada okvir pokrećete na sopstvenoj infrastrukturi, vi ste rukovalac svim podacima koje on obrađuje, a Kiff Agents OÜ nije uključen u tu obradu.
		</p>
	</section>
}

templ privacyRolesSR() {
	<section id="roles">
		<h2>3. Naše uloge prema GDPR-u</h2>
		<p>
			Delujemo u dva svojstva, zavisno od podataka:
		</p>
		<ul>
			<li>
				<strong>Rukovalac</strong> za metapodatke o nalogu i prijavi, podatke o naplati (kada je naplata aktivna), marketinške poruke na koje pristanete i operativnu telemetriju naše usluge.
			</li>
			<li>
				<strong>Obrađivač</strong> za revizijske podatke, zapise o radnjama, potvrde o odlukama i drugi sadržaj koji prolazi kroz runtime u ime naših kupaca, kao i za ono što tafs čuva za njih (izvršavanja, razgovore, izveštaje, beleške iz memorije svakog taf-a i datoteke koje isporučuju). Kupci (zakupci) su rukovaoci tim podacima; oni nam daju uputstva preko podešavanja naloga i konfiguracije domena. Ugovor o obradi podataka (<abbr title="Data Processing Agreement">DPA</abbr>) uređuje taj odnos; objavljene uslove potražite u <a href="/legal/dpa">šablonu DPA</a> (na engleskom).
			</li>
		</ul>
		<p>
			Ova politika prvenstveno se bavi našom obradom u svojstvu rukovaoca. Kada pominjemo podatke koje obrađujemo kao obrađivač, DPA je precizniji dokument.
		</p>
	</section>
}

templ privacyCategoriesSR() {
	<section id="categories">
		<h2>4. Kategorije podataka o ličnosti koje obrađujemo</h2>
		<p>
			Kategorije u nastavku usklađene su sa tehničkim pregledom na <a href="/security#data-we-process">/security#data-we-process</a> (na engleskom). Gde se dve strane razlikuju, tehnička stranica je izvor istine, a mi ovaj odeljak ažuriramo da se podudara.
		</p>
		<ul>
			<li>
				<strong>Identifikatori naloga</strong> — vaš identifikator iz sistema za potvrdu identiteta (koji izdaje naš provajder identiteta) i adresa e-pošte kojom se prijavljujete. Čuvaju se u izvornom obliku; heširanje pri čuvanju je planirano.
				Ako uključite prijavu kodom poslatim e-poštom (isključena je dok to ne učinite), KIFF čuva to podešavanje sa vašim ID-jem za prijavu i datumom promene. Kod koji vam šaljemo e-poštom čuva se samo kao ključani heš, dok se ne iskoristi ili ne prođe deset minuta. Da bismo ograničili zloupotrebe, do jednog dana čuvamo broj zahteva po ključanom hešu adrese koja je zatražila kod i IP adrese. Nakon prijave kodom to beležimo petnaest minuta, kako bi vas promene koje traže svežu prijavu zamolile da se prijavite drugačije.
			</li>
			<li>
				<strong>Metapodaci zakupca</strong> — id zakupca, slug, prikazano ime, vreme kreiranja i jezik koji je aplikacija svake osobe poslednji put koristila, kako bi e-poruke koje KIFF šalje stizale na tom jeziku.
			</li>
			<li>
				<strong>API akreditivi</strong> — neprozirni zapisi API ključeva (čuvamo heševe, nikada otvoreni tekst).
			</li>
			<li>
				<strong>Podaci kolačića sesije</strong> — kolačić sesije potpisan HMAC-om, postavljen posle prijave. Pogledajte odeljak o kolačićima ispod.
			</li>
			<li>
				<strong>Metapodaci HTTP zahteva</strong> — IP adresa, korisnički agent, putanja zahteva, status odgovora, kašnjenje. Čuvaju se u pristupnim zapisima našeg reverznog proksija tokom ograničenog roka čuvanja radi bezbednosti i sprečavanja zloupotrebe.
			</li>
			<li>
				<strong>Sadržaj pod kontrolom zakupca</strong> — podaci <code>parameters</code>, <code>actor</code> i <code>entity</code> koje šaljete runtime-u. Ove podatke čuvamo <em>kao obrađivač</em> u ime kupca; kupac je odgovoran za ono što stiže na mrežu. Redakcija po domenu je planirana.
			</li>
			<li>
				<strong>Komunikacija</strong> — e-poruke koje šaljete našim poštanskim sandučićima za podršku, prodaju, bezbednost ili privatnost.
			</li>
			<li>
				<strong>Aplikacija tafs</strong> — u tafs se prijavljujete svojim KIFF nalogom. Na telefonu ili tabletu aplikacija čuva vašu sesiju u Keychain-u uređaja (na Androidu u njegovom šifrovanom skladištu). Na računaru je čuva zapečaćenu za vaš korisnički nalog: na Windows računaru uz Windows-ovu zaštitu podataka, na Linuxu u vašem keyring-u, na Mac-u u njegovom Keychain-u. Sesija na računaru traje do 90 dana. Aplikacija pravi ključ za potpisivanje koji nikada ne napušta uređaj: u Secure Enclave-u iPhone-a, iPad-a ili Mac-a, u Keystore-u Android uređaja ili u TPM-u Windows računara. Na Linuxu i na Mac-u bez Secure Enclave-a ključ je softverski ključ koji se čuva u vašem keyring-u ili Keychain-u, a taj računar može da prikaže šta vas čeka, ali ne i da to odobri; odobravate na telefonu{ macSecurityKey("sr") }. Windows računar bez TPM-a ne može da se prijavi u tafs. KIFF čuva javni deo ključa, ime i platformu uređaja i kada je dodat i poslednji put korišćen, kako bi mogao da proveri vaše odgovore na zadržane pozive i vaša odobrenja veza. Ako odobravate passkey-em na računaru, kao što je Windows Hello ili bezbednosni ključ, vaše lice, otisak prsta ili PIN ostaju u sistemu samog računara; KIFF čuva javni ključ passkey-a, njegov id, brojač i ime, nikada ništa tajno, i odbija passkey koji se sinhronizuje na druge uređaje. Ako uključite obaveštenja na telefonu, tabletu ili Mac-u koji pokreće iPad aplikaciju, čuvamo push token uređaja sa vašim KIFF id-jem osobe i jezik koji je aplikacija prikazivala, kako bi njena obaveštenja stizala na tom jeziku. Usluga tafs takođe čuva jezik naloga, od osobe koja je poslednja razgovarala sa Coach-om, do tri meseca, kako bi izveštaji taf-a stizali na njemu. Obaveštenje na telefonu prolazi kroz Apple ili Google samo sa podatkom o tome koji taf i šta traži, a u obaveštenju vrata ime ili adresa e-pošte osobe koja je pisala: nikada iznos ni pojedinosti zahteva. Aplikacija ih dodaje na samom uređaju, iz KIFF-a, pa obaveštenje na otključanom telefonu može da prikaže iznos, trgovca ili osobu. Na zaključanom Android telefonu prikazuje samo „Taf vas treba“, isto i na zaključanom iPhone-u, osim ako ste podesili da se pregledi uvek prikazuju. <strong>Vaš sat:</strong> sat ne čuva lozinku ni ključ, razgovara samo sa vašim uparenim telefonom i nikada ne odobrava. Ono što kažete šalje Coach-u, ili taf-u koji ste izabrali, samo kao tekst, preko telefona, pošto ste dozvolili AI. Sopstvena usluga govora na satu, Apple-ova ili Google-ova, pretvara vaše reči u taj tekst. Na Wear OS-u, ako se zaustavi pre nego što završite, to umesto nje radi sopstveni prepoznavač na telefonu. Sat može da odbije, zaustavi ili pošalje Coach-u ili taf-u samo dok ima zaključavanje ekrana ili šifru i dok je otključan. Ono što pošaljete taf-u ide u sopstveni razgovor tog taf-a, kao da ste to napisali na telefonu. Razgovor taf-a, uključujući iznose, čita se preko telefona svaki put kad se otvori, a sat čuva samo nedavne poruke koje opisuje njegov odeljak ispod. Kada su aplikacije zatvorene, telefon prosleđuje nove odgovore i poruke satu preko sopstvene veze sistema između telefona i sata (Appleove na Apple Watch-u, veze usluga Google Play na Wear OS-u), koja ih na telefonu i satu čuva samo dok ih sat ne preuzme; obaveštenje koje budi vaš telefon ne nosi reči. Odgovor koji stigne dok ne gledate sat prikazuje se i kao obaveštenje, na vašem iPhone-u i Apple Watch-u ili na vašem satu sa Wear OS-om, sa svojim rečima, ali nikada sa iznosom, i ostaje dok ga ne odbacite; zaključan sat sa Wear OS-om pokazuje samo da je odgovor spreman. <strong>Apple Watch:</strong> prikazuje vaše tafs i njihove stranice bez čuvanja. Čuva vaše Sanduče, u datoteci koju ne može da pročita dok je zaključan: svaki zadržani poziv kao ime njegovog taf-a i ono što traži, nikada iznos, i Coach-ove odgovore na ono što ste poslali sa sata, kao tekst. Ako se odjavite na satu, čuva i to da ste se odjavili, dok se ponovo ne prijavite na satu. Osim toga, ne čuva ništa ako sat nema šifru. Sanduče nestaje kada se odjavite na satu ili se vaš iPhone odjavi, ili sledeći put kada se aplikacija otvori ili zatvori bez šifre. Ne pravi snimak, a jedina obaveštenja koja prikazuje su ona sa vašeg iPhone-a. Da bi se razgovor odmah otvorio, čuva i poslednjih 30 poruka svakog od najviše 20 razgovora koje ste na njemu otvorili, Coach-ovih i vaših tafs-a, samo kao tekst i nikada iznos, zaključane kao Sanduče; brišu se zajedno sa Sandučetom i kada razgovor nije otvoren 30 dana. <strong>Wear OS:</strong> prikazuje e-poštu vašeg naloga i današnji kalendar bez čuvanja. Da bi se odmah otvorio, čuva, šifrovano, broj stvari koje vas čekaju i ime svakog taf-a i da li je zaustavljen ili pauziran: nikada iznos, pojedinosti zadržanog poziva ni razgovor taf-a. To se briše kada se odjavite, kada se sat zaključa ili skine sa zgloba i posle 24 sata. Čuva vaše Sanduče, u kome je svaka linija ime taf-a i ono što kaže, nikada iznos, i jednu poruku sačuvanu za kasnije, kao tekst. Odjava, na satu ili na telefonu, briše sve to. Za svoju pločicu čuva i broj stvari koje vas čekaju, prikazan samo dok je sat otključan, a briše se kada se odjavite ili sledeći put kada se pločica prikaže dok je sat zaključan ili nema zaključavanje ekrana. Pošto se odjavite na satu, čuva belešku da jeste, dok se ponovo ne prijavite. Sanduče nestaje i sledeći put kada se aplikacija otvori ili zatvori dok je sat zaključan ili nema zaključavanje ekrana. Poruka sačuvana za kasnije ostaje dok je ne pošaljete ili obrišete, jer ste tražili da se pošalje. Ako se usluga govora na satu zaustavi pre nego što završite, sat šalje snimak vašem telefonu, koji ga sam pretvara u tekst na telefonu, nikada na serveru. Snimak se briše na oba uređaja kada se tekst vrati ili otkažete, a najkasnije posle 2 minuta. Samo tekst ide dalje Coach-u ili vašem taf-u. Rezultat taf-a može ostati u obaveštenjima na satu dok ga ne odbacite ili se ne odjavite na satu. Da bi se razgovor odmah otvorio, čuva i poslednjih 30 poruka svakog od najviše 20 razgovora koje ste na njemu otvorili, Coach-ovih i vaših tafs-a, samo kao tekst i nikada iznos, šifrovane; brišu se kada se odjavite, na satu ili na telefonu, i kada razgovor nije otvoren 30 dana, a sat bez zaključavanja ekrana ne čuva nijedan. Na Windows računaru, Linux računaru ili Mac-u sa aplikacijom za macOS 12, obaveštenja pravi sama aplikacija dok radi, bez push tokena i preko nijedne druge kompanije. Na Windows-u i Linuxu prikazuju koji taf, šta želi da uradi, iznos, zašto i do kada; u aplikaciji za macOS 12 prikazuju KIFF-ove reči za poziv, pošto ih uključite, a zaključan ekran prikazuje ono što dozvoljava podešavanje pregleda na Mac-u. Na Windows-u su isključena dok ih ne uključite i prikazuju samo „Taf vas treba“ dok je ekran zaključan. Obaveštenje prikazano pre zaključavanja ekrana zadržava svoje pojedinosti u Windows-ovoj listi obaveštenja. Na Linuxu su uključena dok ih ne isključite, a ono što zaključan ekran prikazuje zavisi od vašeg desktopa. Kada povežete alat, prijavljujete se kod sopstvenog provajdera tog alata. Za aplikaciju u koju planque sam ulazi, kao što je Stripe, ili za ključ koji date, planque čuva taj token ili ključ za vašu kompaniju, šifrovan; za upravljanu vezu, Composio, usluga povezivanja sa kojom planque radi, drži prijavu, a planque čuva samo zapis veze i alate koje ste odobrili (sve kao obrađivač, pogledajte ispod). Ako uparite proširenje tafs, taf može i da čita stranice sajtova koje dozvolite i da na njima deluje, u vašem Chrome-u (kao obrađivač; <a href="/sr/tafs/privacy">stranica o privatnosti tafs-a</a> kaže šta se čita, šta se čuva i koliko dugo). Zapis veze može da sadrži nalog u koji je prijavljen (njegovo ime ili e-poštu), kako bi vam aplikacija mogla pokazati koji je. KIFF koristi upravljane veze samo za aplikacije navedene na <a href="/subprocessors#composio">/subprocessors</a> (na engleskom). Aplikacija nema analitičke ni reklamne trackere.
			</li>
			<li>
				<strong>Kupovine u App Store-u</strong> — kada u tafs kupite Solo ili paket kredita, prodaje vam ih Apple: Apple je prodavac u evidenciji, naplaćuje i čuva vaše platne podatke. Apple nam javlja šta je kupljeno, za koji KIFF nalog (nasumični id koji aplikacija prilaže kupovini), kada, Apple-ov id transakcije i, za Solo, kada period ističe ili se obnavlja. To koristimo da dodamo kredite ili plan vašem nalogu. Apple nam ne daje vaš Apple ID, ime, adresu e-pošte ni karticu.
			</li>
			<li>
				<strong>Kupovine na Google Play-u</strong> — na Androidu iste kupovine idu preko naplate Google Play-a: Google naplaćuje i čuva vaše platne podatke. Google nam javlja šta je kupljeno, za koji KIFF nalog (isti nasumični id), kada, token kupovine i id porudžbine i, za Solo, kada period ističe ili se obnavlja, a mi to koristimo na isti način. Google nam ne daje vaš Google nalog, ime, adresu e-pošte ni karticu.
			</li>
		</ul>
	</section>
}

templ privacyLawfulBasesSR() {
	<section id="lawful-bases">
		<h2>5. Pravni osnovi za obradu</h2>
		<p>
			Prema članu 6 GDPR-a oslanjamo se na sledeće pravne osnove:
		</p>
		<ul>
			<li>
				<strong>Izvršenje ugovora</strong> (član 6(1)(b)) — za otvaranje naloga, potvrdu identiteta, rad runtime-a u vaše ime, naplatu (kada je aktivna) i osnovne površine usluge.
			</li>
			<li>
				<strong>Legitimni interesi</strong> (član 6(1)(f)) — za bezbednost, sprečavanje prevara, otkrivanje zloupotrebe, operativnu telemetriju i zaštitu usluge. Svoje interese vagamo naspram vaših prava i na zahtev ćemo vam reći šta je taj test ravnoteže dao.
			</li>
			<li>
				<strong>Pristanak</strong> (član 6(1)(a)) — za AI u aplikaciji tafs: ono što se šalje AI modelu koji pokreće Coach i vaše tafs, kako je opisano <a href="#ai-in-tafs">ispod</a>. Ništa se ne šalje dok ne dozvolite, a možete da povučete pristanak u Nalogu. Pristanak je i ono što bismo tražili pre bilo kakvih analitičkih kolačića, izbornih marketinških poruka ili nove obrade koja bitno proširuje našu upotrebu vaših podataka. Ne koristimo analitiku, reklamiranje ni nepotrebno praćenje.
			</li>
			<li>
				<strong>Zakonska obaveza</strong> (član 6(1)(c)) — za poreske evidencije (estonski Zakon o računovodstvu §12, 7 godina), odgovore na zakonite zahteve organa i čuvanje koje zahtevaju propisi o sprečavanju pranja novca gde se primenjuju.
			</li>
		</ul>
		<h3 id="ai-in-tafs">AI u aplikaciji tafs</h3>
		<p>Aplikacija tafs pita vas pre nego što bilo šta ode AI-ju, ovim rečima:</p>
		<ul>
			<li>tafs koristi Anthropic-ov Claude AI za Coach i vaše tafs. Za nas ga pokreće Anthropic ili jedan od dobavljača usluga u oblaku sa naše stranice podobrađivača. Ta stranica navodi koji i gde.</li>
			<li>Coach i vaši tafs su AI agenti: ono što pišu generiše AI i može biti pogrešno. Poruka koju taf pošalje izvan vaše kompanije kaže da ju je napisao AI agent.</li>
			<li>Šta se šalje: ono što pišete Coach-u i svojim tafs, datoteke koje priložite, ono što vaše povezane aplikacije vrate taf-u dok radi i ono što je na vašem ekranu dok vam Coach pomaže u aplikaciji.</li>
			<li>Šta se nikada ne šalje: lozinke i ključevi koje koriste vaše povezane aplikacije ili vaš otisak prsta.</li>
			<li>Kompanija koja ga pokreće koristi ga za odgovor i briše ga u roku od 30 dana, osim ako nije označen kao kršenje njenih pravila korišćenja ili zakon zahteva da se čuva.</li>
			<li>Ništa se ne šalje dok ne dozvolite. Možete da povučete pristanak u Nalogu.</li>
		</ul>
		<p>Taf koji radi bez ikoga u tom trenutku (po rasporedu ili kada nešto stigne) oslanja se na pristanak osobe koja ga je napravila ili preuzela, a ako nje nema, prve osobe koja upravlja tafs naloga i dozvoli.</p>
		<p><strong>Kada povučete pristanak,</strong> Coach i vaši tafs prestaju da vam odgovaraju. Taf čija se izvršavanja oslanjaju na vaš pristanak pauzira: rasporedi staju, a ono što stiže čeka. Nastavlja kada se pristanak ponovo da ili kada ga neko ko upravlja tafs naloga preuzme sa svojim. Povlačenje ne menja ono što je ranije poslato.</p>
		<p>Anthropic je naveden na <a href="/subprocessors">/subprocessors</a> (na engleskom), sa mestom obrade i kada može duže da čuva podatke.</p>
	</section>
}

templ privacySubprocessorsSR() {
	<section id="sub-processors">
		<h2>6. Podobrađivači</h2>
		<p>Ne prodajemo vaše podatke o ličnosti i ne delimo ih radi reklamiranja.</p>
		<p>
			Angažujemo mali skup dobavljača da bismo pružali uslugu. Zvanična, aktuelna lista nalazi se na <a href="/subprocessors">/subprocessors</a> (na engleskom); ta stranica se ažurira u roku od 30 dana od svake promene. Od svakog podobrađivača zahtevamo zaštitu ekvivalentnu našoj po pisanim ugovorima, uključujući EU standardne ugovorne klauzule gde podaci o ličnosti napuštaju EU.
		</p>
		<p>
			O bitnim dodavanjima ili zamenama podobrađivača koje utiču na podatke o ličnosti unapred obaveštavamo aktivne kupce, uz pravo na prigovor.
		</p>
	</section>
}

templ privacyTransfersSR() {
	<section id="transfers">
		<h2>7. Međunarodni transferi</h2>
		<p>
			Neki naši podobrađivači su osnovani izvan Evropskog ekonomskog prostora, uglavnom u Sjedinjenim Državama. Za svaki takav transfer oslanjamo se na najmanje jednu od sledećih zaštita:
		</p>
		<ul>
			<li>
				<strong>Okvir EU–SAD za privatnost podataka</strong> — za podobrađivače u SAD koji su se certifikovali za Okvir. Odluka o adekvatnosti na snazi od sredine 2023; pratimo svaku promenu njenog statusa.
			</li>
			<li>
				<strong>Standardne ugovorne klauzule</strong> — modul 2 (rukovalac–obrađivač) za naše neposredne podobrađivače i modul 3 (obrađivač–podobrađivač) gde se primenjuju lančani obrađivači. Koristimo SCC iz 2021. koje je odobrila Komisija.
			</li>
			<li>
				<strong>Dopunske mere</strong> — gde procena rizika pokazuje da su opravdane dodatne zaštite (šifrovanje u prenosu i u mirovanju, evidentiranje pristupa, minimizacija podataka).
			</li>
		</ul>
		<p>
			Konkretan instrument transfera koji se primenjuje na određenog podobrađivača možete zatražiti slanjem e-poruke na <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
		<p><strong>Vaša zemlja.</strong> Zakoni nekih zemalja traže više nego što ova politika kaže. Ono što dodaju, na engleskom i na jeziku te zemlje, nalazi se na <a href="/privacy/countries">Vaša zemlja</a> (na engleskom).</p>
	</section>
}

templ privacyRetentionSR() {
	<section id="retention">
		<h2>8. Čuvanje podataka</h2>
		<p>
			Podatke o ličnosti čuvamo najkraće moguće u skladu sa svrhama radi kojih ih obrađujemo i svakom primenljivom zakonskom obavezom.
		</p>
		<ul>
			<li>
				<strong>Metapodaci o nalogu i prijavi</strong> — dok se nalog ne obriše. U aplikaciji tafs vlasnik ga briše u Nalog → <em>Obriši nalog</em>. Nalog napravljen na vebu briše se slanjem e-poruke na <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>, u roku od mesec dana iz člana 12(3) GDPR-a. U oba slučaja ključevi naloga prestaju da važe odmah. Obrisan u aplikaciji tafs, ne može se vratiti: njegovi tafs razgovori, beleške i veze brišu se odmah, a ono što KIFF čuva briše se u roku od 30 dana. Obrisan na vebu, njegove podatke čuvamo još 30 dana, za slučaj da ih vlasnik želi nazad, a zatim ih brišemo.
			</li>
			<li>
				<strong>Zapisi API ključeva</strong> — do brisanja naloga, uključujući i posle opoziva ključa. Ključ koji pripada vezi za prijavu agenta briše se zajedno sa tom vezom, 30 dana pošto se završi.
			</li>
			<li>
				<strong>Kolačići sesije</strong> — do isteka (podrazumevano 24 sata) ili dok se ne odjavite.
			</li>
			<li>
				<strong>Pristupni zapisi reverznog proksija</strong> — do 90 dana, zatim se agregiraju ili brišu.
			</li>
			<li>
				<strong>Zapisi usluge</strong> — ono što KIFF-ove usluge i planque beleže dok rade: greške i zahtevi, koji mogu imenovati nalog, osobu ili agenta. 30 dana, zatim se brišu.
			</li>
			<li>
				<strong>Rezervne kopije</strong> — KIFF-ova baza podataka kopira se svakodnevno, šifrovano, a svaka kopija se čuva 7 dana, pa obrisan zapis nestaje iz njih u roku od 7 dana. Skladišta tafs i planque čuvaju šifrovane kopije u određenom trenutku 35 dana, koje se koriste samo za obnovu skladišta posle kvara, pa obrisan zapis nestaje iz njih u roku od 35 dana.
			</li>
			<li>
				<strong>Revizijski podaci zakupca</strong> — čuvaju se kao obrađivač prema konfiguraciji zakupca kupca. Podrazumevano: čuvaju se tokom života zakupca; brišu se brisanjem zakupca. Pogledajte <a href="/security#deletion">/security#deletion</a> (na engleskom).
			</li>
			<li>
				<strong>Pozivi kroz KIFF gateway</strong> — argumenti poziva dok se ne pošalje, odbije ili ne propadne, zatim se brišu; rezultat alata 24 sata, zatim se briše. Zapis o odluci i heš argumenata čuvaju se kao revizijski podaci zakupca. Pogledajte <a href="/security#data-kept">/security#data-kept</a> (na engleskom).
			</li>
			<li>
				<strong>Korišćenje</strong> — za svaki poziv kroz gateway, kada se završi: koji agent ga je uputio, alat i da li se računao kao radnja ili je bio besplatan (i zašto). Za svako izvršavanje taf-a ili Coach-a, kada se završi: taf, kada, krediti koje je njegov AI iskoristio i da li su se računali ili zašto nisu. Dok se nalog ne obriše; ono što se prijavljuje našem procesoru plaćanja radi naplate čuva se sa evidencijom o naplati.
			</li>
			<li>
				<strong>Veze za prijavu agenta</strong> — koji agent, ime aplikacije, ko je dozvolio, kada i poslednja upotreba: dok je veza aktivna, zatim 30 dana pošto se završi (u tom periodu ostaje navedena na kontrolnoj tabli), zatim se briše zajedno sa tokenima i API ključem. Sve se briše sa nalogom.
			</li>
			<li>
				<strong>tafs</strong> — push token uređaja do odjave iz aplikacije, uklanjanja uređaja ili dok Apple ili Google ne prijavi da token više ne postoji. Javni ključ uređaja, ime, platforma i datumi dok ga koristite; pošto ga odjavite, označava se kao uklonjen i čuva do brisanja naloga, kako bi KIFF mogao da odbije zakasneli odgovor sa njega i da pokaže koji je uređaj potpisao raniji. Javni ključ passkey-a, id i ime čuvaju se kao oni njegovog uređaja. Računar čuva sesiju do 90 dana ili dok se ne odjavite. Ono što tafs čuva za vašu kompaniju čuva se kao obrađivač: izvršavanja i razgovori taf-a, sa sažetkom razgovora (i Setup-a), 30 dana; ono što vaši alati vrate samo do kraja izvršavanja (u razgovoru, ono što je samo pročitano čuva se šifrovano za njegove sledeće poruke, koristi se dok razgovor nije mirovao sat vremena i najviše četiri sata posle čitanja, a zatim se automatski briše, u roku od nekoliko dana), a beleške iz memorije dok se taf ne ukloni; datoteke koje isporučuje 30 dana od izvršavanja koje ih je napravilo, zatim se automatski brišu u roku od jednog dana, ili ranije ako ih neko na vašem nalogu obriše; token ili ključ veze u planque-u, ili prijava upravljane veze u Composio-u, dok je ne prekinete (ako druga vaša veza sme da koristi isti nalog kod tog dobavljača, čuva se neiskorišćen dok se i ona ne prekine), a zapis njenih odobrenja do kraja naloga; pogledajte <a href="/legal/dpa#annex-4">Prilog 4 DPA-a</a> (na engleskom).
			</li>
			<li>
				<strong>Evidencija o naplati</strong> — 7 godina od kraja finansijske godine (estonski Zakon o računovodstvu §12).
			</li>
			<li>
				<strong>Kupovine u App Store-u i na Google Play-u</strong> — ono što su nam Apple ili Google javili o svakoj kupovini ostaje u vašem nalogu dok se nalog ne obriše. Njihovi izveštaji o prodaji i isplatama, koje čuvamo kao evidenciju o naplati 7 godina, ne imenuju vas.
			</li>
			<li>
				<strong>Prepiska sa podrškom</strong> — 3 godine od poslednje interakcije, zatim se briše.
			</li>
		</ul>
	</section>
}

templ privacyRightsSR() {
	<section id="rights">
		<h2>9. Vaša prava</h2>
		<p>
			Prema GDPR-u imate sledeća prava u vezi sa svojim podacima o ličnosti:
		</p>
		<ul>
			<li><strong>Pristup</strong> (član 15) — potvrda da li obrađujemo vaše podatke i njihova kopija.</li>
			<li><strong>Ispravka</strong> (član 16) — ispravka netačnih ili nepotpunih podataka.</li>
			<li><strong>Brisanje</strong> (član 17) — brisanje vaših podataka, uz izuzetke zbog zakonskog čuvanja.</li>
			<li><strong>Ograničenje</strong> (član 18) — pauziranje obrade dok se spor ne reši.</li>
			<li><strong>Prenosivost</strong> (član 20) — izvoz podataka koje ste dali u mašinski čitljivom obliku.</li>
			<li><strong>Prigovor</strong> (član 21) — na obradu zasnovanu na legitimnim interesima; prestajemo osim ako ne možemo da pokažemo nadređene razloge.</li>
			<li><strong>Povlačenje pristanka</strong> (član 7(3)) — za svaku obradu zasnovanu na pristanku, kao što je AI u aplikaciji tafs (u Nalogu, kao <a href="#ai-in-tafs">gore</a>). Povlačenje ne utiče na prethodnu zakonitu obradu.</li>
		</ul>
		<p>
			Da ostvarite bilo koje od ovih prava, pošaljite e-poruku na <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>. Odgovaramo bez nepotrebnog odlaganja, a najkasnije u roku od mesec dana, prema članu 12(3); za složene zahteve možemo produžiti rok za najviše još dva meseca i obavestićemo vas ako to učinimo.
		</p>
		<h3 id="export-chats">Vaši sopstveni tafs razgovori</h3>
		<p>
			U aplikaciji tafs, Nalog → Izvezi moje razgovore preuzima vaše sopstvene razgovore sa svakim taf-om, uključujući Coach-ov, nazive datoteka koje ste priložili i vaše sopstvene beleške, kao čitljivu datoteku i kao JSON. Samo vi možete da ih izvezete: administrator ili vlasnik naloga ne mogu, a KIFF-ov izvoz naloga ih ne uključuje.
		</p>
		<h3 id="delete-account">Brisanje vašeg tafs naloga</h3>
		<p>
			tafs je KIFF-ova aplikacija. Da biste obrisali svoj tafs nalog i njegove podatke:
		</p>
		<ol>
			<li>Otvorite aplikaciju tafs i prijavite se.</li>
			<li>Idite na Nalog, pa dodirnite <em>Obriši nalog</em>.</li>
			<li>Potvrdite. Brisanje naloga ne može se poništiti.</li>
		</ol>
		<p>
			<em>Obriši nalog</em> prikazuje se onome ko sme da briše nalog kompanije, obično vlasniku. Ako ga ne vidite ili više nemate aplikaciju, pošaljite e-poruku na <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> sa adrese kojom se prijavljujete i mi ćemo obrisati vaše podatke bez nepotrebnog odlaganja, a najkasnije u roku od mesec dana.
		</p>
		<p>
			Šta se briše: ključevi naloga prestaju da važe odmah. Njegovi tafs, razgovori, beleške, priložene datoteke i veze brišu se odmah, a iz kopija u određenom trenutku u roku od 35 dana. Ono što KIFF čuva za nalog briše se u roku od 30 dana, a iz rezervnih kopija u roku od 7 dana posle toga. Zapisi usluge koji imenuju nalog nestaju u roku od 30 dana. Revizijski podaci zakupca brišu se sa zakupcem. Pogledajte <a href="#retention">Čuvanje podataka</a> za svaku vrstu podataka.
		</p>
		<p id="delete-data">
			Da biste obrisali neke svoje podatke, a zadržali nalog: u aplikaciji obrišite razgovor i njegove poruke i priložene datoteke odlaze sa njim; uklonite taf i njegovi razgovori, beleške i veze odlaze sa njim. Za sve ostalo pošaljite e-poruku na <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> i navedite šta da obrišemo. To radimo bez nepotrebnog odlaganja, a najkasnije u roku od mesec dana.
		</p>
		<p>
			Imate pravo da podnesete pritužbu nadzornom organu. Naš vodeći nadzorni organ je <a href="https://www.aki.ee/en" target="_blank" rel="noopener">Estonski inspektorat za zaštitu podataka (Andmekaitse Inspektsioon)</a>. Pritužbu možete podneti i nadzornom organu u državi članici u kojoj živite.
		</p>
		<p><strong>Vaša zemlja.</strong> Zakoni nekih zemalja traže više nego što ova politika kaže. Ono što dodaju, na engleskom i na jeziku te zemlje, nalazi se na <a href="/privacy/countries">Vaša zemlja</a> (na engleskom).</p>
	</section>
}

templ privacyCookiesSR() {
	<section id="cookies">
		<h2>10. Kolačići</h2>
		<p>
			Postavljamo tri kolačića, svi su strogo neophodni, od prve strane, šalju se samo preko HTTPS-a i skripte na stranici ih ne mogu čitati. Prema EU pravilima o e-privatnosti ne zahtevaju pristanak; navodimo ih da biste znali da postoje. <a href="/cookies">Politika kolačića</a> (na engleskom) ima pojedinosti.
		</p>
		<ul>
			<li>
				<strong><code>kiff_session</code></strong> — održava vas prijavljenim. Potpisani kolačić sesije koji nosi vaš id prijave, e-poštu i ime, kao i akreditiv koji kontrolna tabla koristi za vas. Postavlja se za <code>.kiff.dev</code>. Traje 24 sata ili dok se ne odjavite.
			</li>
			<li>
				<strong><code>kiff_flash</code></strong> — nosi jednokratnu poruku na sledeću stranicu, kao što je „vaš ključ je napravljen“. Potpisan; novi ključ nikada nije u njemu. Postavlja se za <code>.kiff.dev</code>. Briše se kada ga sledeća stranica pročita, a najduže posle 5 minuta.
			</li>
			<li>
				<strong><code>kiff_cb_attempts</code></strong> — broji koliko puta se stranica za prijavu ponovo učitala, kako bi se zaustavila prijava koja se vrti u krug. Šalje se samo toj stranici. Traje 5 minuta i briše se kada prijava počne ili uspe.
			</li>
		</ul>
		<p>
			Ne koristimo analitičke kolačiće, reklamne kolačiće ni bilo kakve trackere trećih strana. Ako ikada dodamo neke, prikazaćemo baner za pristanak pre nego što se kolačić postavi, u skladu sa e-privatnošću i smernicama EDPB-a iz 2023. o tehnologijama praćenja.
		</p>
		<p>
			Ako se prijavljujete preko Clerk-a (našeg podobrađivača za potvrdu identiteta), Clerk postavlja kolačiće i na sopstvenom frontend domenu (<code>clerk.kiff.dev</code>). Ti kolačići su neophodni da bi vas Clerk prepoznao tokom svog toka prijave i uređeni su Clerk-ovom politikom privatnosti kao i našom. Pojedinosti potražite na listi podobrađivača.
		</p>
	</section>
}

templ privacySecuritySR() {
	<section id="security">
		<h2>11. Bezbednost</h2>
		<p>
			Naše tehničke i organizacione mere bezbednosti dokumentovane su na <a href="/security">/security</a> (na engleskom). Obuhvataju izolaciju zakupaca na sloju baze podataka, TLS 1.2+ u prenosu, šifrovanje u mirovanju podrazumevanim podešavanjima upravljanog provajdera i kontrole pristupa zasnovane na principu najmanjih privilegija.
		</p>
		<p>
			Pogođene kupce obaveštavamo o povredi podataka o ličnosti bez nepotrebnog odlaganja i u roku od 72 sata od potvrde, u skladu sa članom 33 GDPR-a. Obaveštenje obuhvata prirodu povrede, kategorije i približan broj lica i zapisa na koje se odnosi, verovatne posledice i preduzete ili predložene mere.
		</p>
	</section>
}

templ privacyChildrenSR() {
	<section id="children">
		<h2>12. Deca</h2>
		<p>
			KIFF Cloud je proizvod razvojne infrastrukture koji nije namenjen deci. Svesno ne prikupljamo podatke o ličnosti dece mlađe od 16 godina. Ako verujete da je dete dalo podatke o ličnosti nama, obratite se na <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> i mi ćemo ih obrisati.
		</p>
	</section>
}

templ privacyAutomatedSR() {
	<section id="automated">
		<h2>13. Automatizovano donošenje odluka</h2>
		<p>
			Runtime KIFF Cloud-a donosi determinističke odluke o politici na osnovu podataka koje šalju naši kupci. To nisu odluke o vama koje proizvode pravne ili slično značajne posledice u smislu člana 22 GDPR-a; to su odluke o radnjama kupca (povraćaji, porudžbine, poruke i tako dalje) koje se izvršavaju prema sopstvenoj politici kupca.
		</p>
		<p>
			Kupci koji koriste KIFF Cloud za donošenje odluka koje utiču na njihove sopstvene krajnje korisnike sami su odgovorni za usklađenost sa članom 22. Naše potvrde o upravljanju osmišljene su da tim kupcima daju revizijski trag koji im je potreban da dokažu ljudski nadzor, ali zakonska obaveza da se taj nadzor obezbedi ostaje na kupcu.
		</p>
	</section>
}

templ privacyChangesSR() {
	<section id="changes">
		<h2>14. Izmene ove politike</h2>
		<p>
			Povremeno možemo ažurirati ovu politiku. O bitnim izmenama obaveštavamo aktivne kupce e-poštom i istaknutim banerom na ovoj stranici najmanje 30 dana. Nebitne izmene objavljuju se sa novim datumom „poslednjeg ažuriranja“.
		</p>
	</section>
}

templ privacyContactSR() {
	<section id="contact">
		<h2>15. Kontaktirajte nas</h2>
		<p>
			Pitanja o privatnosti i zahtevi za ostvarivanje prava: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
		<p>
			Zvanična pravna obaveštenja za Kiff Agents OÜ: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a> ili poštom na adresu Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estonija.
		</p>
		<p>
			Vodeći nadzorni organ za pritužbe: <a href="https://www.aki.ee/en" target="_blank" rel="noopener">Estonski inspektorat za zaštitu podataka (Andmekaitse Inspektsioon)</a>.
		</p>

		<hr/>

		<p class="legal-footnote">
			<strong>Verzija dokumenta:</strong> v0.1.<br/> <strong>Poslednje ažuriranje:</strong> 25. novembar 2026.
		</p>
	</section>
}
