package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// PrivacyNE is KIFF's privacy policy (/privacy) in Nepali, at /ne/privacy.
// It is a translation of Privacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Nepali has the legal
// texts only, so a link to any other page goes to English and says so.
templ PrivacyNE() {
	@components.LayoutSite("KIFF — privacy policy", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@privacyHeadNE()
			@privacyWhoWeAreNE()
			@privacyScopeNE()
			@privacyRolesNE()
			@privacyCategoriesNE()
			@privacyLawfulBasesNE()
			@privacySubprocessorsNE()
			@privacyTransfersNE()
			@privacyRetentionNE()
			@privacyRightsNE()
			@privacyCookiesNE()
			@privacySecurityNE()
			@privacyChildrenNE()
			@privacyAutomatedNE()
			@privacyChangesNE()
			@privacyContactNE()
		</article>
	}
}

templ privacyHeadNE() {
	<header class="legal-head">
		<p class="legal-badge">गोपनीयता नीति · v0.1</p>
		<h1>गोपनीयता नीति</h1>
		<p class="legal-meta">
			<strong>पछिल्लो पटक अद्यावधिक:</strong> 24 नोभेम्बर 2026। <strong>लागू हुने मिति:</strong> 24 मे 2026।
		</p>
		<p class="legal-disclaimer">
			यो नीतिले KIFF Cloud ले वेबसाइट, ड्यासबोर्ड, API र iPhone, iPad, Android र कम्प्युटरका लागि tafs एपमा व्यक्तिगत डेटा कसरी प्रशोधन गर्छ भन्ने बताउँछ। प्रश्नहरू: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>।
		</p>
	</header>
}

templ privacyWhoWeAreNE() {
	<section id="who-we-are">
		<h2>1. हामी को हौं</h2>
		<p>
			KIFF Cloud एस्टोनियामा स्थापित निजी सीमित दायित्व कम्पनी <strong>Kiff Agents OÜ</strong> ले सञ्चालन गर्छ। दर्ता जानकारी:
		</p>
		<ul>
			<li><strong>दर्ता कोड:</strong> 17372313 (एस्टोनियाली e-Business दर्ता)</li>
			<li><strong>VAT नम्बर:</strong> EE102924327</li>
			<li><strong>दर्ता गरिएको ठेगाना:</strong> Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, एस्टोनिया</li>
			<li><strong>गोपनीयता सम्पर्क:</strong> <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a></li>
			<li><strong>औपचारिक कानुनी सूचना:</strong> <a href="mailto:legal@kiff.dev">legal@kiff.dev</a></li>
		</ul>
		<p>
			Kiff Agents OÜ यूरोपेली संघमा स्थापित भएकाले EU को सामान्य डेटा संरक्षण नियमन (<abbr title="सामान्य डेटा संरक्षण नियमन">GDPR</abbr>) हाम्रो प्रशोधनमा सिधै लागू हुन्छ। हामीलाई धारा 27 को EU प्रतिनिधि चाहिँदैन।
		</p>
	</section>
}

templ privacyScopeNE() {
	<section id="scope">
		<h2>2. यो नीतिको दायरा</h2>
		<p>
			यो नीतिले तपाईंले निम्नसँग अन्तर्क्रिया गर्दा हामीले प्रशोधन गर्ने व्यक्तिगत डेटालाई समेट्छ:
		</p>
		<ul>
			<li><a href="https://kiff.dev"><code>kiff.dev</code></a> — हाम्रो मार्केटिङ साइट, यो नीति पृष्ठ, र सार्वजनिक रसिद-प्रदर्शन सतह।</li>
			<li><a href="https://app.kiff.dev"><code>app.kiff.dev</code></a> — हाम्रो प्रमाणीकृत ड्यासबोर्ड।</li>
			<li><a href="https://api.kiff.dev"><code>api.kiff.dev</code></a> — हाम्रो HTTP API।</li>
			<li id="tafs"><strong>tafs</strong> — iPhone, iPad, Android र कम्प्युटर (Mac, Windows र Linux) का लागि हाम्रो एप, र यसको पछाडिको सेवा (कम्पनीका औजार जोड्ने Setup र ती जडान राख्ने planque सहित), जसमा कम्पनीले काम KIFF Card हरूभित्र काम गर्ने AI एजेन्टलाई सुम्पन्छ।</li>
		</ul>
		<p>
			यो नीतिले तपाईंले आफैं चलाउन सक्ने खुला-स्रोत <code>kiff/kiff</code> फ्रेमवर्कलाई <em>समेट्दैन</em>। तपाईंले फ्रेमवर्क आफ्नै पूर्वाधारमा चलाउँदा, यसले प्रशोधन गर्ने कुनै पनि डेटाको नियन्त्रक तपाईं हुनुहुन्छ, र Kiff Agents OÜ त्यो प्रशोधनमा संलग्न हुँदैन।
		</p>
	</section>
}

templ privacyRolesNE() {
	<section id="roles">
		<h2>3. GDPR अन्तर्गत हाम्रा भूमिका</h2>
		<p>
			हामी डेटाअनुसार दुई हैसियतमा काम गर्छौं:
		</p>
		<ul>
			<li>
				<strong>नियन्त्रक</strong> खाता र साइन इन मेटाडेटा, बिलिङ डेटा (बिलिङ सक्रिय हुँदा), तपाईंले रोजेका मार्केटिङ सञ्चार, र हाम्रो आफ्नै सेवाको सञ्चालन टेलिमेट्रीका लागि।
			</li>
			<li>
				<strong>प्रशोधक</strong> अडिट डेटा, कार्य रेकर्ड, निर्णय रसिद, र हाम्रा ग्राहकहरूको तर्फबाट runtime मार्फत बग्ने अन्य सामग्रीका लागि, र tafs ले तिनका लागि राख्ने कुरा (हरेक taf का रन, च्याट, प्रतिवेदन, मेमोरी नोट र तिनले पुर्‍याउने फाइलहरू) का लागि। ग्राहकहरू (टेनेन्ट) त्यो डेटाका नियन्त्रक हुन्; तिनले आफ्ना खाता सेटिङ र डोमेन कन्फिगरेसन मार्फत हामीलाई निर्देशन दिन्छन्। डेटा प्रशोधन सम्झौता (<abbr title="डेटा प्रशोधन सम्झौता">DPA</abbr>) ले त्यो सम्बन्ध नियमन गर्छ; प्रकाशित सर्तहरूका लागि <a href="/legal/dpa">DPA टेम्प्लेट</a> (अङ्ग्रेजीमा) हेर्नुहोस्।
			</li>
		</ul>
		<p>
			यो नीतिले मुख्यतः हाम्रो नियन्त्रक-पक्षको प्रशोधनलाई सम्बोधन गर्छ। जहाँ हामी प्रशोधक-पक्षको डेटा उल्लेख गर्छौं, DPA अझ विशिष्ट कागजात हो।
		</p>
	</section>
}

templ privacyCategoriesNE() {
	<section id="categories">
		<h2>4. हामीले प्रशोधन गर्ने व्यक्तिगत डेटाका श्रेणी</h2>
		<p>
			तलका श्रेणी <a href="/security#data-we-process">/security#data-we-process</a> (अङ्ग्रेजीमा) मा रहेको प्राविधिक सूचीसँग मिल्छन्। जहाँ दुई बाझिन्छन्, प्राविधिक पृष्ठ सत्यको स्रोत हो र हामी यो खण्डलाई मिल्ने गरी अद्यावधिक गर्छौं।
		</p>
		<ul>
			<li>
				<strong>खाता पहिचानकर्ता</strong> — तपाईंको अपस्ट्रिम प्रमाणीकरण विषय (हाम्रो पहिचान प्रदायकले जारी गरेको) र तपाईंले साइन इन गर्ने इमेल ठेगाना। आजका दिनमा जस्ताको तस्तै राखिएको; भण्डारणमा ह्यास गर्ने योजना छ।
				यदि तपाईंले इमेलमा पठाइएको कोडबाट साइन इन गर्ने सुविधा खोल्नुभयो भने (तपाईंले नखोलेसम्म यो बन्द रहन्छ), KIFF ले त्यो सेटिङ तपाईंको साइन इन आईडी र परिवर्तन गरेको मितिसँगै राख्छ। हामीले तपाईंलाई इमेलमा पठाएको कोड प्रयोग नभएसम्म वा दस मिनेट नबितेसम्म केवल कुञ्जीयुक्त ह्यासका रूपमा राखिन्छ। दुरुपयोग सीमित गर्न हामी, बढीमा एक दिनसम्म, कोड मागेको ठेगाना र आईपी ठेगानाको कुञ्जीयुक्त ह्यास अनुसार अनुरोधको गणना राख्छौं। कोडबाट साइन इन गरेपछि हामी यसलाई एक चौथाई घण्टा टिपोट गर्छौं, ताकि हालै साइन इन चाहिने परिवर्तनहरूले तपाईंलाई अर्कै तरिकाले साइन इन गर्न भनून्।
			</li>
			<li>
				<strong>टेनेन्ट मेटाडेटा</strong> — टेनेन्ट id, slug, प्रदर्शित नाम, सिर्जना समय, र हरेक व्यक्तिको एपले पछिल्लो पटक प्रयोग गरेको भाषा, ताकि KIFF ले तिनलाई पठाउने इमेल त्यही भाषामा आऊन्।
			</li>
			<li>
				<strong>API प्रमाण</strong> — अपारदर्शी API कुञ्जीका रेकर्ड (हामी ह्यास राख्छौं, सादा पाठ कहिल्यै होइन)।
			</li>
			<li>
				<strong>सत्र कुकी डेटा</strong> — साइन इनपछि सेट गरिएको HMAC-हस्ताक्षरित सत्र कुकी। तलको कुकी खण्ड हेर्नुहोस्।
			</li>
			<li>
				<strong>HTTP अनुरोध मेटाडेटा</strong> — IP ठेगाना, प्रयोगकर्ता एजेन्ट, अनुरोध पथ, प्रतिक्रिया स्थिति, विलम्ब। सुरक्षा र दुरुपयोग रोकथामका लागि सीमित अवधारण अवधिमा हाम्रो रिभर्स प्रोक्सीको पहुँच लगमा राखिन्छ।
			</li>
			<li>
				<strong>टेनेन्टले नियन्त्रण गर्ने सामग्री</strong> — तपाईंले runtime लाई पठाउने <code>parameters</code>, <code>actor</code> र <code>entity</code> डेटा। हामी यसलाई ग्राहकको तर्फबाट <em>प्रशोधकको रूपमा</em> राख्छौं; तारमा के पुग्छ त्यसका लागि ग्राहक जिम्मेवार हुन्छ। प्रति-डोमेन रिडक्सन कन्फिग योजनामा छ।
			</li>
			<li>
				<strong>सञ्चार</strong> — तपाईंले हाम्रा सहयोग, बिक्री, सुरक्षा वा गोपनीयता मेलबक्समा पठाउने इमेल।
			</li>
			<li>
				<strong>tafs एप</strong> — तपाईं आफ्नो KIFF खाताबाट tafs मा साइन इन गर्नुहुन्छ। फोन वा ट्याब्लेटमा एपले तपाईंको सत्र उपकरणको Keychain मा (Android मा, यसको इन्क्रिप्टेड भण्डारणमा) राख्छ। कम्प्युटरमा यसलाई तपाईंको प्रयोगकर्ता खाताका लागि सिल गरेर राख्छ: Windows PC मा Windows कै डेटा सुरक्षाले, Linux मा तपाईंको keyring मा, Mac मा यसको Keychain मा। कम्प्युटरको सत्र 90 दिनसम्म चल्छ। एपले उपकरण नछाड्ने हस्ताक्षर कुञ्जी बनाउँछ: iPhone, iPad वा Mac को Secure Enclave मा, Android उपकरणको Keystore मा, वा Windows PC को TPM मा। Linux मा, र Secure Enclave नभएको Mac मा, कुञ्जी तपाईंको keyring वा Keychain मा राखिएको सफ्टवेयर कुञ्जी हो, र त्यो कम्प्युटरले तपाईंलाई के पर्खिरहेको छ देखाउन सक्छ तर स्वीकृत गर्न सक्दैन; तपाईं आफ्नो फोनमा स्वीकृत गर्नुहुन्छ{ macSecurityKey("ne") }। TPM नभएको Windows PC ले tafs मा साइन इन गर्न सक्दैन। KIFF ले कुञ्जीको सार्वजनिक आधा, उपकरणको नाम र प्लेटफर्म, र कहिले थपियो र अन्तिम पटक प्रयोग भयो राख्छ, ताकि रोकिएका कलमा तपाईंका जवाफ र जडानका तपाईंका स्वीकृति जाँच्न सकोस्। यदि तपाईं आफ्नो कम्प्युटरमा passkey ले स्वीकृत गर्नुहुन्छ भने, जस्तै Windows Hello वा सुरक्षा कुञ्जी, तपाईंको अनुहार, औँठाछाप वा PIN कम्प्युटरकै आफ्नै प्रणालीमा रहन्छ; KIFF ले passkey को सार्वजनिक कुञ्जी, यसको id, एउटा काउन्टर र नाम राख्छ, कहिल्यै गोप्य कुरा होइन, र अन्य उपकरणमा सिङ्क हुने passkey अस्वीकार गर्छ। यदि तपाईं फोन, ट्याब्लेट वा iPad एप चलाउने Mac मा सतर्कता खोल्नुहुन्छ भने, हामी उपकरणको push टोकन तपाईंको KIFF व्यक्ति id र एपले देखाएको भाषासँगै राख्छौं, ताकि यसका सतर्कता त्यही भाषामा आऊन्। tafs सेवाले खाताको भाषा, Coach सँग पछिल्लो पटक च्याट गर्नेबाट, तीन महिनासम्म पनि राख्छ, ताकि taf का प्रतिवेदन त्यही भाषामा आऊन्। फोनको सतर्कता Apple वा Google मार्फत जान्छ केवल कुन taf र के चाहन्छ भनेर, र ढोकाको सतर्कतामा कसले लेख्यो त्यसको नाम वा इमेल ठेगाना: कहिल्यै रकम वा अनुरोधको विवरण होइन। एपले ती विवरण उपकरणमै KIFF बाट थप्छ, त्यसैले अनलक फोनको सतर्कताले रकम, व्यापारी वा व्यक्ति देखाउन सक्छ। लक भएको Android फोनमा यसले केवल "Taf लाई तपाईं चाहियो" देखाउँछ, र लक भएको iPhone मा पनि, तपाईंले यसको पूर्वावलोकन सधैँ देखाउने गरी सेट नगरेसम्म। <strong>तपाईंको घडी:</strong> घडीले कुनै पासवर्ड वा कुञ्जी राख्दैन, केवल तपाईंको जोडिएको फोनसँग कुरा गर्छ, र कहिल्यै स्वीकृत गर्दैन। तपाईंले AI लाई अनुमति दिएपछि यसले तपाईंले Coach, वा छानेको taf लाई भनेको कुरा फोन मार्फत केवल पाठको रूपमा पठाउँछ। घडीको आफ्नै बोली सेवा, Apple वा Google को, ले तपाईंका शब्दलाई त्यो पाठ बनाउँछ। Wear OS मा, तपाईंले सक्नुअघि रोकिए, तपाईंको फोनको आफ्नै पहिचानकर्ताले त्यो फोनमै गर्छ। यसले स्क्रिन लक वा पासकोड भएको र अनलक भएको बेलामा मात्र अस्वीकार, रोक्न, वा Coach वा taf लाई पठाउन सक्छ। तपाईंले taf लाई पठाएको कुरा त्यो taf को आफ्नै च्याटमा जान्छ, मानौं तपाईंले फोनमा लेख्नुभएको हो। taf को च्याट, रकमसहित, प्रत्येक पटक खुल्दा फोनमार्फत पढिन्छ, र घडीले तल आफ्नै खण्डमा वर्णन गरिएका हालका सन्देश मात्र राख्छ। एपहरू बन्द हुँदा, तपाईंको फोनले नयाँ जवाफ र सन्देशहरू प्रणालीकै फोन-घडी लिङ्कमार्फत घडीमा पठाउँछ (Apple Watch मा Apple को, Wear OS मा Google Play सेवाहरूको), जसले तिनलाई घडीले नलिएसम्म मात्र फोन र घडीमा राख्छ; तपाईंको फोन ब्युँझाउने पुसमा कुनै शब्द हुँदैन। तपाईं घडी नहेर्दा आउने जवाफ सूचनाका रूपमा पनि देखिन्छ, तपाईंको iPhone र Apple Watch मा वा तपाईंको Wear OS घडीमा, यसका शब्दसहित तर कहिल्यै रकमबिना, र तपाईंले नहटाउञ्जेल रहन्छ; लक गरिएको Wear OS घडीले जवाफ तयार भएको मात्र देखाउँछ। <strong>Apple Watch:</strong> यसले तपाईंका taf र तिनका पृष्ठ राख्दैन, देखाउँछ मात्र। यसले तपाईंको Inbox राख्छ, लक हुँदा पढ्न नसक्ने फाइलमा: हरेक रोकिएको कल यसको taf को नाम र यसले के सोध्छ भनेर, कहिल्यै रकम होइन, र घडीबाट तपाईंले पठाएकामा Coach का जवाफ, पाठको रूपमा। यदि तपाईं घडीमा साइन आउट गर्नुहुन्छ भने, यसले तपाईंले गर्नुभयो भन्ने पनि राख्छ, घडीमा फेरि साइन इन नगरेसम्म। त्योबाहेक, घडीमा पासकोड नभएसम्म यसले केही राख्दैन। तपाईंले घडीमा साइन आउट गर्दा वा तपाईंको iPhone साइन आउट हुँदा, वा पासकोडबिना एप अर्को पटक खुल्दा वा बन्द हुँदा Inbox जान्छ। यसले कुनै रेकर्डिङ गर्दैन, र यसले देखाउने सूचनाहरू तपाईंको iPhone का मात्र हुन्। कुराकानी तुरुन्त खुलोस् भनेर, यसले त्यसमा खोलिएका बढीमा 20 कुराकानीमध्ये प्रत्येकका अन्तिम 30 सन्देश पनि राख्छ, Coach का र तपाईंका tafs का, पाठका रूपमा मात्र र कहिल्यै रकम होइन, Inbox जस्तै लक गरेर; Inbox मेटिँदा र कुनै कुराकानी 30 दिनसम्म नखोलिँदा ती मेटिन्छन्। <strong>Wear OS:</strong> यसले तपाईंको खाताको इमेल र आजको क्यालेन्डर राख्दैन, देखाउँछ मात्र। तुरुन्तै खुल्न, यसले इन्क्रिप्ट गरेर तपाईंलाई पर्खिरहेका कुराको गणना, र हरेक taf को नाम र यो रोकिएको वा विराम दिएको छ कि छैन राख्छ: कहिल्यै रकम, रोकिएको कलको विवरण वा taf को च्याट होइन। तपाईं साइन आउट गर्दा, घडी लक हुँदा वा नाडीबाट झिक्दा, र 24 घण्टापछि त्यो हटाइन्छ। यसले तपाईंको Inbox राख्छ, जहाँ हरेक लाइन taf को नाम र यसले के भन्छ हो, कहिल्यै रकम होइन, र पछिका लागि राखिएको एउटा सन्देश, पाठको रूपमा। घडी वा फोनमा साइन आउट गर्दा सबै हटाइन्छ। यसको टाइलका लागि, यसले तपाईंलाई पर्खिरहेका कुराको गणना पनि राख्छ, घडी अनलक भएको बेलामा मात्र देखाइन्छ, र साइन आउट गर्दा, वा घडी लक भएको वा स्क्रिन लक नभएको बेला टाइल अर्को पटक देखिँदा हटाइन्छ। घडीमा साइन आउट गरेपछि, यसले तपाईंले गर्नुभयो भन्ने टिपोट राख्छ, फेरि साइन इन नगरेसम्म। घडी लक भएको वा स्क्रिन लक नभएको बेला एप अर्को पटक खुल्दा वा बन्द हुँदा पनि Inbox जान्छ। पछिका लागि राखिएको सन्देश तपाईंले पठाउने वा मेट्नेसम्म रहन्छ, किनभने तपाईंले यसलाई पठाउन भन्नुभएको थियो। यदि घडीको बोली सेवा तपाईंले सक्नुअघि रोकियो भने, घडीले रेकर्डिङ तपाईंको फोनमा पठाउँछ, जसले यसलाई फोनमै पाठ बनाउँछ, सर्भरमा कहिल्यै होइन। पाठ फर्किएपछि वा तपाईंले रद्द गरेपछि, र बढीमा 2 मिनेटपछि रेकर्डिङ दुवैमा मेटिन्छ। केवल पाठ Coach वा तपाईंको taf सम्म जान्छ। Taf को नतिजा तपाईंले हटाउने वा घडीमा साइन आउट गर्नेसम्म घडीका सूचनाहरूमा रहन सक्छ। कुराकानी तुरुन्त खुलोस् भनेर, यसले त्यसमा खोलिएका बढीमा 20 कुराकानीमध्ये प्रत्येकका अन्तिम 30 सन्देश पनि राख्छ, Coach का र तपाईंका tafs का, पाठका रूपमा मात्र र कहिल्यै रकम होइन, इन्क्रिप्ट गरेर; तपाईंले घडी वा फोनमा साइन आउट गर्दा र कुनै कुराकानी 30 दिनसम्म नखोलिँदा ती मेटिन्छन्, र स्क्रिन लक नभएको घडीले कुनै पनि राख्दैन। Windows PC, Linux कम्प्युटर वा macOS 12 एप भएको Mac मा सतर्कता एप आफैंले चल्दा बनाउँछ, push टोकनबिना र अरू कुनै कम्पनी मार्फत नगई। Windows र Linux मा तिनले कुन taf, के गर्न चाहन्छ, रकम, किन र कहिलेसम्म देखाउँछन्; macOS 12 एपमा तपाईंले खोलेपछि कलका लागि KIFF का शब्द देखाउँछन्, र लक स्क्रिनले Mac को पूर्वावलोकन सेटिङले अनुमति दिएको देखाउँछ। Windows मा तपाईंले खोल्नुअघिसम्म बन्द छन्, र स्क्रिन लक हुँदा केवल "Taf लाई तपाईं चाहियो" देखाउँछन्। स्क्रिन लक हुनुअघि देखाइएकोले Windows को सूचना सूचीमा आफ्नो विवरण राख्छ। Linux मा तपाईंले बन्द गर्नुअघिसम्म खुला छन्, र लक स्क्रिनले के देखाउँछ त्यो तपाईंको डेस्कटपमा निर्भर गर्छ। औजार जोड्दा, तपाईं औजारको आफ्नै प्रदायकमा साइन इन गर्नुहुन्छ। planque आफैं साइन इन गर्ने एप, जस्तै Stripe, वा तपाईंले दिएको कुञ्जीका लागि, planque ले त्यो टोकन वा कुञ्जी तपाईंको कम्पनीका लागि इन्क्रिप्ट गरेर राख्छ; व्यवस्थित जडानका लागि, planque ले काम गर्ने जडान सेवा Composio ले साइन इन राख्छ, र planque ले केवल जडानको रेकर्ड र तपाईंले स्वीकृत गरेका औजार राख्छ (सबै प्रशोधकको रूपमा, तल हेर्नुहोस्)। यदि तपाईंले tafs एक्सटेन्सन जोड्नुभयो भने, taf ले तपाईंको आफ्नै Chrome मा तपाईंले अनुमति दिएका साइटका पृष्ठहरू पनि पढ्न र तिनमा कार्य गर्न सक्छ (प्रशोधकका रूपमा; के पढिन्छ, के राखिन्छ र कति समयसम्म भनेर <a href="/ne/tafs/privacy">tafs को गोपनीयता पृष्ठ</a> ले बताउँछ)। जडानको रेकर्डमा यो कुन खातामा साइन इन छ (यसको नाम वा इमेल) समावेश हुन सक्छ, ताकि एपले कुन हो भनेर तपाईंलाई देखाउन सकोस्। KIFF ले व्यवस्थित जडान <a href="/subprocessors#composio">/subprocessors</a> (अङ्ग्रेजीमा) मा नाम दिइएका एपका लागि मात्र प्रयोग गर्छ। एपमा कुनै एनालिटिक्स वा विज्ञापन ट्र्याकर छैन।
			</li>
			<li>
				<strong>App Store खरिद</strong> — तपाईंले tafs मा Solo वा क्रेडिटको प्याक किन्दा, Apple ले तपाईंलाई बेच्छ: Apple अभिलेखमा बिक्रेता हो, भुक्तानी लिन्छ र तपाईंको भुक्तानी विवरण राख्छ। Apple ले हामीलाई के किनियो, कुन KIFF खाताका लागि (एपले खरिदसँग जोड्ने अनियमित id), कहिले, Apple को कारोबार id, र Solo का लागि अवधि कहिले सकिन्छ वा नवीकरण हुन्छ बताउँछ। हामी यसलाई तपाईंको खातामा क्रेडिट वा योजना थप्न प्रयोग गर्छौं। Apple ले हामीलाई तपाईंको Apple ID, नाम, इमेल ठेगाना वा कार्ड दिँदैन।
			</li>
			<li>
				<strong>Google Play खरिद</strong> — Android मा, उही खरिद Google Play को बिलिङ मार्फत जान्छ: Google ले भुक्तानी लिन्छ र तपाईंको भुक्तानी विवरण राख्छ। Google ले हामीलाई के किनियो, कुन KIFF खाताका लागि (उही अनियमित id), कहिले, खरिदको टोकन र अर्डर id, र Solo का लागि अवधि कहिले सकिन्छ वा नवीकरण हुन्छ बताउँछ, र हामी यसलाई उसरी नै प्रयोग गर्छौं। Google ले हामीलाई तपाईंको Google खाता, नाम, इमेल ठेगाना वा कार्ड दिँदैन।
			</li>
		</ul>
	</section>
}

templ privacyLawfulBasesNE() {
	<section id="lawful-bases">
		<h2>5. प्रशोधनका कानुनी आधार</h2>
		<p>
			GDPR को धारा 6 अन्तर्गत, हामी निम्न कानुनी आधारमा भर पर्छौं:
		</p>
		<ul>
			<li>
				<strong>सम्झौताको कार्यान्वयन</strong> (धारा 6(1)(b)) — खाता सिर्जना, प्रमाणीकरण, तपाईंको तर्फबाट runtime चलाउने, बिलिङ (सक्रिय हुँदा), र सेवाका मुख्य सतहका लागि।
			</li>
			<li>
				<strong>वैध हित</strong> (धारा 6(1)(f)) — सुरक्षा, ठगी रोकथाम, दुरुपयोग पत्ता लगाउने, सञ्चालन टेलिमेट्री, र सेवाको सुरक्षाका लागि। हामी आफ्ना हितलाई तपाईंका अधिकारसँग सन्तुलित गर्छौं र माग्दा त्यो सन्तुलन परीक्षणले के निकाल्यो भनेर बताउनेछौं।
			</li>
			<li>
				<strong>सहमति</strong> (धारा 6(1)(a)) — tafs एपमा AI का लागि: Coach र तपाईंका taf हरू चलाउने AI मोडेललाई के पठाइन्छ, <a href="#ai-in-tafs">तल</a> वर्णन गरिएझैं। तपाईंले अनुमति नदिँदासम्म केही पठाइँदैन, र तपाईं खातामा फिर्ता लिन सक्नुहुन्छ। सहमति कुनै पनि एनालिटिक्स कुकी, ऐच्छिक मार्केटिङ सञ्चार, वा तपाईंको डेटाको हाम्रो प्रयोगलाई भौतिक रूपमा विस्तार गर्ने नयाँ प्रशोधनअघि हामीले माग्ने कुरा पनि हो। हामी कुनै एनालिटिक्स, विज्ञापन, र अनावश्यक ट्र्याकिङ चलाउँदैनौं।
			</li>
			<li>
				<strong>कानुनी दायित्व</strong> (धारा 6(1)(c)) — कर अभिलेख (एस्टोनियाली लेखा ऐन §12, 7 वर्ष), वैध प्राधिकरणका अनुरोधमा प्रतिक्रिया, र लागू हुने ठाउँमा मनी-लाउन्डरिङ विरोधी नियमले चाहेको अवधारण।
			</li>
		</ul>
		<h3 id="ai-in-tafs">tafs एपमा AI</h3>
		<p>केही पनि AI मा जानुअघि tafs एपले तपाईंलाई यी शब्दमा सोध्छ:</p>
		<ul>
			<li>tafs ले Coach र तपाईंका taf हरूका लागि Anthropic को Claude AI प्रयोग गर्छ।</li>
			<li>Coach र तपाईंका taf हरू AI एजेन्ट हुन्: तिनले लेखेको कुरा AI ले बनाएको हुन्छ र गलत हुन सक्छ। Taf ले तपाईंको कम्पनीबाहिर पठाएको सन्देशले AI एजेन्टले लेखेको भनेर बताउँछ।</li>
			<li>त्यसलाई के पठाइन्छ: तपाईंले Coach र आफ्ना taf हरूलाई लेख्नुभएको कुरा, तपाईंले जोड्ने फाइलहरू, तपाईंका जोडिएका एपले taf लाई काम गर्दा फर्काउने कुरा, र Coach ले तपाईंलाई एपमा मद्दत गर्दा तपाईंको स्क्रिनमा के छ।</li>
			<li>के कहिल्यै पठाइँदैन: तपाईंका जोडिएका एपले प्रयोग गर्ने पासवर्ड र कुञ्जी, वा तपाईंको औँठाछाप।</li>
			<li>Anthropic ले यसलाई जवाफ दिन प्रयोग गर्छ र 30 दिनसम्म राख्छ।</li>
			<li>तपाईंले अनुमति नदिँदासम्म केही पठाइँदैन। तपाईं खातामा फिर्ता लिन सक्नुहुन्छ।</li>
		</ul>
		<p>त्यो क्षणमा कोही नभएको बेला चल्ने taf (यसको तालिकामा, वा केही आउँदा) यसलाई बनाउने वा लिने व्यक्तिको सहमतिमा, नत्र खाताका taf हरू व्यवस्थापन गर्ने पहिलो व्यक्तिले अनुमति दिएको सहमतिमा आधारित हुन्छ।</p>
		<p><strong>तपाईंले फिर्ता लिँदा,</strong> Coach र तपाईंका taf हरूले तपाईंलाई जवाफ दिन छोड्छन्। रन तपाईंको सहमतिमा आधारित taf ले विराम लिन्छ: यसका तालिका रोकिन्छन्, र आउने कुरा पर्खन्छ। सहमति फेरि दिइएपछि, वा खाताका taf हरू व्यवस्थापन गर्ने कसैले आफ्नो सहमतिसँग यसलाई लिएपछि यो जारी रहन्छ। फिर्ता लिनुले पहिले पठाइएकामा परिवर्तन गर्दैन।</p>
		<p>Anthropic <a href="/subprocessors">/subprocessors</a> (अङ्ग्रेजीमा) मा सूचीबद्ध छ, यसले कहाँ प्रशोधन गर्छ र कहिले डेटा लामो समय राख्न सक्छ भन्ने सहित।</p>
	</section>
}

templ privacySubprocessorsNE() {
	<section id="sub-processors">
		<h2>6. उप-प्रशोधकहरू</h2>
		<p>हामी तपाईंको व्यक्तिगत डेटा बेच्दैनौं, र विज्ञापनका लागि साझा गर्दैनौं।</p>
		<p>
			हामी सेवा प्रदान गर्न थोरै विक्रेता प्रयोग गर्छौं। आधिकारिक, हालको सूची <a href="/subprocessors">/subprocessors</a> (अङ्ग्रेजीमा) मा छ; त्यो पृष्ठ कुनै पनि परिवर्तनको 30 दिनभित्र अद्यावधिक हुन्छ। हामी हरेक उप-प्रशोधकबाट लिखित सम्झौताअन्तर्गत हाम्रोसँग बराबरको सुरक्षा माग्छौं, व्यक्तिगत डेटाले EU छाड्ने ठाउँमा EU को मानक सम्झौता खण्डसहित।
		</p>
		<p>
			व्यक्तिगत डेटालाई असर गर्ने उप-प्रशोधकका भौतिक थप वा प्रतिस्थापन सक्रिय ग्राहकहरूलाई पहिल्यै, आपत्तिको अधिकारसहित सूचित गरिन्छ।
		</p>
	</section>
}

templ privacyTransfersNE() {
	<section id="transfers">
		<h2>7. अन्तर्राष्ट्रिय स्थानान्तरण</h2>
		<p>
			हाम्रा केही उप-प्रशोधक यूरोपेली आर्थिक क्षेत्रबाहिर, मुख्यतः संयुक्त राज्य अमेरिकामा स्थापित छन्। यस्तो हरेक स्थानान्तरणका लागि हामी निम्न सुरक्षामध्ये कम्तीमा एकमा भर पर्छौं:
		</p>
		<ul>
			<li>
				<strong>EU–US डेटा गोपनीयता फ्रेमवर्क</strong> — फ्रेमवर्कमा प्रमाणित भएका US उप-प्रशोधकका लागि। पर्याप्तता निर्णय 2023 को मध्यदेखि लागू; हामी यसको स्थितिमा कुनै परिवर्तन भए अनुगमन गर्छौं।
			</li>
			<li>
				<strong>मानक सम्झौता खण्ड</strong> — हाम्रा प्रत्यक्ष उप-प्रशोधकका लागि मोड्युल 2 (नियन्त्रकदेखि प्रशोधक) र शृङ्खलाबद्ध प्रशोधक लागू हुने ठाउँमा मोड्युल 3 (प्रशोधकदेखि उप-प्रशोधक)। हामी आयोगले स्वीकृत गरेको 2021 का SCC प्रयोग गर्छौं।
			</li>
			<li>
				<strong>पूरक उपाय</strong> — जहाँ जोखिम मूल्याङ्कनले थप सुरक्षा आवश्यक देखाउँछ (पारगमन र भण्डारणमा इन्क्रिप्सन, पहुँच लगिङ, डेटा न्यूनीकरण)।
			</li>
		</ul>
		<p>
			तपाईं <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> मा इमेल गरेर कुनै उप-प्रशोधकमा लागू हुने खास स्थानान्तरण उपकरण माग्न सक्नुहुन्छ।
		</p>
		<p><strong>तपाईंको देश।</strong> केही देशका कानुनले यो नीतिले भनेभन्दा बढी माग गर्छन्। तिनले थप्ने कुरा, अङ्ग्रेजीमा र देशको भाषामा, <a href="/privacy/countries">तपाईंको देश</a> (अङ्ग्रेजीमा) मा छन्।</p>
	</section>
}

templ privacyRetentionNE() {
	<section id="retention">
		<h2>8. अवधारण</h2>
		<p>
			हामी व्यक्तिगत डेटा प्रशोधन गर्ने उद्देश्य र लागू हुने कानुनी दायित्वसँग मिल्ने सबैभन्दा छोटो अवधिका लागि राख्छौं।
		</p>
		<ul>
			<li>
				<strong>खाता र साइन इन मेटाडेटा</strong> — खाता मेटिँदासम्म। tafs एपमा, मालिकले यसलाई खाता → <em>खाता मेट्नुहोस्</em> मा मेट्छ। वेबमा बनाइएको खाता <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> मा इमेल गरेर, GDPR धारा 12(3) को एक महिनाको अवधिभित्र मेटिन्छ। जुनसुकै अवस्थामा, खाताका कुञ्जीहरू तुरुन्तै काम गर्न छाड्छन्। tafs एपमा मेटिए, यसलाई फर्काउन सकिँदैन: यसका tafs च्याट, नोट र जडान तुरुन्तै मेटिन्छन्, र KIFF ले राखेको कुरा 30 दिनभित्र मेटिन्छ। वेबमा मेटिए, मालिकले फिर्ता चाहेमा भनेर हामी यसको डेटा 30 दिनको ग्रेस अवधिसम्म राख्छौं, त्यसपछि मेट्छौं।
			</li>
			<li>
				<strong>API कुञ्जी रेकर्ड</strong> — खाता मेटिँदासम्म, कुञ्जी रद्द भएपछि पनि। एजेन्ट साइन इन जडानको कुञ्जी त्यो जडानसँगै, यो समाप्त भएको 30 दिनपछि मेटिन्छ।
			</li>
			<li>
				<strong>सत्र कुकी</strong> — म्याद सकिँदासम्म (पूर्वनिर्धारित 24 घण्टा) वा तपाईंले साइन आउट गर्नेसम्म।
			</li>
			<li>
				<strong>रिभर्स-प्रोक्सी पहुँच लग</strong> — 90 दिनसम्म, त्यसपछि समेटिन्छ वा मेटिन्छ।
			</li>
			<li>
				<strong>सेवा लग</strong> — KIFF का सेवा र planque ले चल्दा रेकर्ड गर्ने कुरा: त्रुटि, र अनुरोध, जसले खाता, व्यक्ति वा एजेन्टको नाम राख्न सक्छन्। 30 दिन, त्यसपछि मेटिन्छ।
			</li>
			<li>
				<strong>ब्याकअप</strong> — KIFF को डेटाबेस दैनिक इन्क्रिप्ट गरेर ब्याकअप गरिन्छ, र हरेक ब्याकअप 7 दिन राखिन्छ, त्यसैले मेटिएको रेकर्ड तिनबाट 7 दिनभित्र जान्छ। tafs र planque का भण्डारले इन्क्रिप्टेड बिन्दु-समयका प्रति 35 दिन राख्छन्, केवल विफलतापछि भण्डार पुनर्स्थापना गर्न प्रयोग गरिने, त्यसैले मेटिएको रेकर्ड तिनबाट 35 दिनभित्र जान्छ।
			</li>
			<li>
				<strong>टेनेन्ट अडिट डेटा</strong> — ग्राहकको टेनेन्ट कन्फिगरेसनअनुसार प्रशोधकको रूपमा राखिन्छ। पूर्वनिर्धारित: टेनेन्टको जीवनकालसम्म राखिन्छ; टेनेन्ट मेटिँदा मेटिन्छ। <a href="/security#deletion">/security#deletion</a> (अङ्ग्रेजीमा) हेर्नुहोस्।
			</li>
			<li>
				<strong>KIFF गेटवे मार्फत कल</strong> — कलका तर्क यो पठाइने, अस्वीकार हुने वा असफल हुनेसम्म, त्यसपछि मेटिन्छन्; औजारको नतिजा 24 घण्टा, त्यसपछि मेटिन्छ। निर्णय रेकर्ड र तर्कहरूको ह्यास टेनेन्ट अडिट डेटाको रूपमा राखिन्छ। <a href="/security#data-kept">/security#data-kept</a> (अङ्ग्रेजीमा) हेर्नुहोस्।
			</li>
			<li>
				<strong>प्रयोग</strong> — गेटवे मार्फत हरेक कलका लागि, यो समाप्त भएपछि: कुन एजेन्टले गर्‍यो, औजार, र यो कार्यको रूपमा गणना भयो वा निःशुल्क थियो (र किन)। Taf वा Coach को हरेक रनका लागि, यो समाप्त भएपछि: taf, कहिले, यसको AI ले प्रयोग गरेको क्रेडिट, र गणना भए वा किन भएनन्। खाता मेटिँदासम्म; बिलिङका लागि हाम्रो भुक्तानी प्रोसेसरलाई जे रिपोर्ट गरिन्छ त्यो बिलिङ रेकर्डसँग राखिन्छ।
			</li>
			<li>
				<strong>एजेन्ट साइन इन जडान</strong> — कुन एजेन्ट, एपको नाम, कसले अनुमति दियो, कहिले, र यसको पछिल्लो प्रयोग: जडान सक्रिय रहँदासम्म, त्यसपछि यो समाप्त भएको 30 दिन (त्यो समयसम्म ड्यासबोर्डमा सूचीबद्ध रहन्छ), त्यसपछि यसका टोकन र यसको API कुञ्जीसँगै मेटिन्छ। सबै खातासँगै मेटिन्छ।
			</li>
			<li>
				<strong>tafs</strong> — उपकरणको push टोकन तपाईंले एपबाट साइन आउट नगरेसम्म, उपकरण हटाउनुअघिसम्म, वा Apple वा Google ले टोकन गयो भनी रिपोर्ट नगरेसम्म। उपकरणको सार्वजनिक कुञ्जी, नाम, प्लेटफर्म र मिति तपाईंले प्रयोग गर्दासम्म; तपाईंले यसलाई साइन आउट गरेपछि, यो हटाइएको चिह्नित हुन्छ र खाता नमेटिएसम्म राखिन्छ, ताकि KIFF ले त्यसबाट आएको ढिलो जवाफ अस्वीकार गर्न र पहिलेको जवाफमा कुन उपकरणले हस्ताक्षर गर्‍यो देखाउन सकोस्। Passkey को सार्वजनिक कुञ्जी, id र नाम यसको उपकरणको जस्तै राखिन्छन्। कम्प्युटरले आफ्नो सत्र 90 दिनसम्म, वा तपाईंले साइन आउट नगरेसम्म राख्छ। tafs ले तपाईंको कम्पनीका लागि राख्ने कुरा प्रशोधकको रूपमा राखिन्छ: taf का रन र च्याट, च्याटको सारांशसहित (र Setup को), 30 दिन; तपाईंका औजारले फर्काएको कुरा रन समाप्त नहुँदासम्म मात्र (च्याटमा, यसले पढेको मात्र कुरा यसका अर्का सन्देशहरूका लागि इन्क्रिप्ट गरेर राखिन्छ, च्याट एक घण्टा निष्क्रिय नहुँदासम्म र पढेपछि बढीमा चार घण्टासम्म प्रयोग गरिन्छ, त्यसपछि केही दिनभित्र स्वचालित रूपमा मेटिन्छ); यसका मेमोरी नोट taf हटाइँदासम्म; यसले पुर्‍याउने फाइलहरू तिनलाई बनाउने रनदेखि 30 दिन, त्यसपछि एक दिनभित्र स्वचालित रूपमा मेटिन्छन्, वा तपाईंको खाताको कसैले एउटा मेटे त्योभन्दा छिटो; planque मा जडानको टोकन वा कुञ्जी, वा Composio मा व्यवस्थित जडानको साइन इन, तपाईंले डिस्कनेक्ट नगरेसम्म (यदि तपाईंको अर्को जडानले त्यही विक्रेताको उही खाता प्रयोग गर्न सक्छ भने, त्यो पनि डिस्कनेक्ट नहुँदासम्म प्रयोगबिना राखिन्छ); र यसका स्वीकृतिको रेकर्ड खाता समाप्त नहुँदासम्म; <a href="/legal/dpa#annex-4">DPA को Annex 4</a> (अङ्ग्रेजीमा) हेर्नुहोस्।
			</li>
			<li>
				<strong>बिलिङ रेकर्ड</strong> — आर्थिक वर्षको अन्त्यदेखि 7 वर्ष (एस्टोनियाली लेखा ऐन §12)।
			</li>
			<li>
				<strong>App Store र Google Play खरिद</strong> — Apple वा Google ले हामीलाई हरेक खरिदबारे बताएको कुरा खाता मेटिँदासम्म तपाईंको खातामा रहन्छ। तिनका बिक्री र भुक्तानी प्रतिवेदन, जुन हामी बिलिङ रेकर्डको रूपमा 7 वर्ष राख्छौं, ले तपाईंलाई नाम लिँदैनन्।
			</li>
			<li>
				<strong>सहयोग पत्राचार</strong> — पछिल्लो अन्तर्क्रियादेखि 3 वर्ष, त्यसपछि मेटिन्छ।
			</li>
		</ul>
	</section>
}

templ privacyRightsNE() {
	<section id="rights">
		<h2>9. तपाईंका अधिकार</h2>
		<p>
			GDPR अन्तर्गत तपाईंका व्यक्तिगत डेटाको सम्बन्धमा तपाईंसँग निम्न अधिकार छन्:
		</p>
		<ul>
			<li><strong>पहुँच</strong> (धारा 15) — हामीले तपाईंको डेटा प्रशोधन गर्छौं कि गर्दैनौं भन्ने पुष्टि, र यसको प्रति।</li>
			<li><strong>सच्याउने</strong> (धारा 16) — गलत वा अधुरो डेटाको सुधार।</li>
			<li><strong>मेटाउने</strong> (धारा 17) — कानुनी-अवधारण अपवादको अधीनमा तपाईंको डेटा मेट्ने।</li>
			<li><strong>सीमित गर्ने</strong> (धारा 18) — विवाद समाधान हुँदासम्म प्रशोधन रोक्ने।</li>
			<li><strong>पोर्टेबिलिटी</strong> (धारा 20) — तपाईंले दिएको डेटाको मेसिन-पठनीय निर्यात।</li>
			<li><strong>आपत्ति</strong> (धारा 21) — वैध हितमा आधारित प्रशोधनमा; हामी अति आवश्यक आधार देखाउन नसके रोक्छौं।</li>
			<li><strong>सहमति फिर्ता</strong> (धारा 7(3)) — सहमतिमा आधारित कुनै पनि प्रशोधनका लागि, जस्तै tafs एपमा AI (खातामा, <a href="#ai-in-tafs">माथि</a> भनिएझैं)। फिर्ता लिनुले अघिल्लो वैध प्रशोधनमा असर गर्दैन।</li>
		</ul>
		<p>
			यी कुनै पनि अधिकार प्रयोग गर्न, <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> मा इमेल गर्नुहोस्। हामी धारा 12(3) अनुसार अनुचित ढिलाइ नगरी र बढीमा एक महिनाभित्र जवाफ दिन्छौं; जटिल अनुरोधका लागि थप दुई महिनासम्म बढाउन सक्छौं र त्यसो गरे तपाईंलाई बताउँछौं।
		</p>
		<h3 id="export-chats">तपाईंका आफ्नै tafs च्याट</h3>
		<p>
			tafs एपमा, खाता → मेरा च्याटहरू निर्यात गर्नुहोस् ले हरेक taf सँग, Coach को सहित, तपाईंका आफ्नै च्याट, तपाईंले जोडेका फाइलका नाम, र तपाईंका आफ्नै नोट, पढ्न सकिने फाइल र JSON का रूपमा डाउनलोड गर्छ। तपाईंले मात्र तिनलाई निर्यात गर्न सक्नुहुन्छ: एडमिन वा खाताको मालिकले सक्दैन, र KIFF को खाता निर्यातले तिनलाई समावेश गर्दैन।
		</p>
		<h3 id="delete-account">तपाईंको tafs खाता मेट्ने</h3>
		<p>
			tafs KIFF को एप हो। आफ्नो tafs खाता र यसको डेटा मेट्न:
		</p>
		<ol>
			<li>tafs एप खोल्नुहोस् र साइन इन गर्नुहोस्।</li>
			<li>खातामा जानुहोस्, त्यसपछि <em>खाता मेट्नुहोस्</em> ट्याप गर्नुहोस्।</li>
			<li>पुष्टि गर्नुहोस्। खाता मेट्नुलाई फर्काउन सकिँदैन।</li>
		</ol>
		<p>
			<em>खाता मेट्नुहोस्</em> कम्पनीको खाता मेट्न पाउने कसैलाई, प्रायः यसका मालिकलाई, देखिन्छ। यदि तपाईंले यो देख्नुभएन, वा अब एप छैन भने, तपाईंले साइन इन गर्ने ठेगानाबाट <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> मा इमेल गर्नुहोस्, र हामी तपाईंको डेटा अनुचित ढिलाइ नगरी र बढीमा एक महिनाभित्र मेट्छौं।
		</p>
		<p>
			के मेटिन्छ: खाताका कुञ्जीहरू तुरुन्तै काम गर्न छाड्छन्। यसका taf, च्याट, नोट, जोडिएका फाइल र जडान तुरुन्तै मेटिन्छन्, र तिनका बिन्दु-समयका प्रतिबाट 35 दिनभित्र। KIFF ले खाताका लागि राखेको कुरा 30 दिनभित्र, र ब्याकअपबाट त्यसपछि 7 दिनभित्र मेटिन्छ। खातालाई नाम लिने सेवा लग 30 दिनभित्र जान्छन्। टेनेन्ट अडिट डेटा टेनेन्टसँगै मेटिन्छ। हरेक प्रकारको डेटाका लागि <a href="#retention">अवधारण</a> हेर्नुहोस्।
		</p>
		<p id="delete-data">
			आफ्नो केही डेटा मेटेर खाता राख्न: एपमा, एउटा च्याट मेट्नुहोस्, र यसका सन्देश र जोडिएका फाइल त्यससँगै जान्छन्; taf हटाउनुहोस्, र यसका च्याट, नोट र जडान त्यससँगै जान्छन्। अरू जे कुराका लागि, <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> मा इमेल गरी के मेट्ने भन्नुहोस्। हामी यो अनुचित ढिलाइ नगरी र बढीमा एक महिनाभित्र गर्छौं।
		</p>
		<p>
			तपाईंलाई सुपरिवेक्षक प्राधिकरणमा उजुरी गर्ने अधिकार छ। हाम्रो नेतृत्वकारी सुपरिवेक्षक प्राधिकरण <a href="https://www.aki.ee/en" target="_blank" rel="noopener">एस्टोनियाको डेटा संरक्षण निरीक्षणालय (Andmekaitse Inspektsioon)</a> हो। तपाईं आफू बस्ने सदस्य राष्ट्रको सुपरिवेक्षक प्राधिकरणमा पनि उजुरी गर्न सक्नुहुन्छ।
		</p>
		<p><strong>तपाईंको देश।</strong> केही देशका कानुनले यो नीतिले भनेभन्दा बढी माग गर्छन्। तिनले थप्ने कुरा, अङ्ग्रेजीमा र देशको भाषामा, <a href="/privacy/countries">तपाईंको देश</a> (अङ्ग्रेजीमा) मा छन्।</p>
	</section>
}

templ privacyCookiesNE() {
	<section id="cookies">
		<h2>10. कुकी</h2>
		<p>
			हामी तीन कुकी सेट गर्छौं, सबै कडाइका साथ आवश्यक, पहिलो-पक्षका, केवल HTTPS मार्फत पठाइने र पृष्ठका स्क्रिप्टले पढ्न नसक्ने। EU ePrivacy नियमअनुसार तिनलाई सहमति चाहिँदैन; हामी तिनको अस्तित्व थाहा होस् भनेर सूचीबद्ध गर्छौं। विवरण <a href="/cookies">कुकी नीति</a> (अङ्ग्रेजीमा) मा छन्।
		</p>
		<ul>
			<li>
				<strong><code>kiff_session</code></strong> — तपाईंलाई साइन इन राख्छ। तपाईंको साइन इन id, इमेल र नाम, र ड्यासबोर्डले तपाईंका लागि प्रयोग गर्ने प्रमाण बोक्ने हस्ताक्षरित सत्र कुकी। <code>.kiff.dev</code> का लागि सेट गरिएको। यो 24 घण्टा, वा तपाईंले साइन आउट नगरेसम्म रहन्छ।
			</li>
			<li>
				<strong><code>kiff_flash</code></strong> — अर्को पृष्ठमा एकपटकको सन्देश बोक्छ, जस्तै "तपाईंको कुञ्जी बनाइयो"। हस्ताक्षरित; नयाँ कुञ्जी यसमा कहिल्यै हुँदैन। <code>.kiff.dev</code> का लागि सेट गरिएको। अर्को पृष्ठले पढ्दा मेटिन्छ, र बढीमा 5 मिनेट।
			</li>
			<li>
				<strong><code>kiff_cb_attempts</code></strong> — साइन इन पृष्ठ कति पटक रिलोड भयो गणना गर्छ, ताकि लुप भइरहेको साइन इन रोकियोस्। केवल त्यो पृष्ठमा पठाइन्छ। यो 5 मिनेट रहन्छ, र साइन इन सुरु हुँदा वा सफल हुँदा खाली गरिन्छ।
			</li>
		</ul>
		<p>
			हामी एनालिटिक्स कुकी, विज्ञापन कुकी, वा कुनै तेस्रो-पक्ष ट्र्याकर प्रयोग गर्दैनौं। यदि हामीले कहिल्यै थप्यौं भने, ePrivacy र ट्र्याकिङ प्रविधिबारे EDPB को 2023 को मार्गदर्शनअनुरूप कुकी सेट गर्नुअघि सहमति ब्यानर प्रस्तुत गर्नेछौं।
		</p>
		<p>
			यदि तपाईं Clerk (हाम्रो प्रमाणीकरण उप-प्रशोधक) मार्फत साइन इन गर्नुहुन्छ भने, Clerk ले आफ्नै फ्रन्टएन्ड डोमेन (<code>clerk.kiff.dev</code>) मा पनि कुकी सेट गर्छ। ती कुकी Clerk ले तपाईंलाई यसको साइन इन प्रवाहमा चिन्न आवश्यक छन् र हाम्रो जस्तै Clerk को गोपनीयता नीतिले पनि नियमन हुन्छन्। विवरणका लागि उप-प्रशोधक सूची हेर्नुहोस्।
		</p>
	</section>
}

templ privacySecurityNE() {
	<section id="security">
		<h2>11. सुरक्षा</h2>
		<p>
			हाम्रा प्राविधिक र संगठनात्मक सुरक्षा उपाय <a href="/security">/security</a> (अङ्ग्रेजीमा) मा कागजात गरिएका छन्। तिनमा डेटाबेस तहमा टेनेन्ट पृथकीकरण, पारगमनमा TLS 1.2+, व्यवस्थित प्रदायकका पूर्वनिर्धारित मार्फत भण्डारणमा इन्क्रिप्सन, र न्यूनतम विशेषाधिकारको सिद्धान्तमा आधारित पहुँच नियन्त्रण पर्छन्।
		</p>
		<p>
			हामी प्रभावित ग्राहकहरूलाई व्यक्तिगत डेटा उल्लंघनबारे अनावश्यक ढिलाइबिना र पुष्टिको 72 घण्टाभित्र, GDPR धारा 33 अनुरूप सूचित गर्छौं। सूचनामा उल्लंघनको प्रकृति, सम्बन्धित डेटा विषय र रेकर्डका श्रेणी र अनुमानित सङ्ख्या, सम्भावित परिणाम, र लिइएका वा प्रस्ताव गरिएका उपाय समावेश हुन्छन्।
		</p>
	</section>
}

templ privacyChildrenNE() {
	<section id="children">
		<h2>12. बालबालिका</h2>
		<p>
			KIFF Cloud बालबालिकाका लागि नभएको विकासकर्ता पूर्वाधार उत्पादन हो। हामी 16 वर्षमुनिका बालबालिकाको व्यक्तिगत डेटा जानीजानी सङ्कलन गर्दैनौं। यदि तपाईंलाई लाग्छ कि कुनै बालबालिकाले हामीलाई व्यक्तिगत डेटा दिएको छ भने, <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> मा सम्पर्क गर्नुहोस् र हामी यसलाई मेट्नेछौं।
		</p>
	</section>
}

templ privacyAutomatedNE() {
	<section id="automated">
		<h2>13. स्वचालित निर्णय-निर्माण</h2>
		<p>
			KIFF Cloud को runtime ले हाम्रा ग्राहकले पठाएको डेटामा निर्धारणात्मक नीति निर्णय गर्छ। यी GDPR धारा 22 को अर्थमा तपाईंबारे कानुनी वा त्यस्तै उल्लेखनीय प्रभाव पार्ने निर्णय होइनन्; यी ग्राहकको आफ्नै नीतिअन्तर्गत कार्यान्वयन गरिएका ग्राहकका कार्य (फिर्ता, अर्डर, सन्देश, आदि) बारेका निर्णय हुन्।
		</p>
		<p>
			KIFF Cloud लाई आफ्ना अन्तिम प्रयोगकर्तामा असर पार्ने निर्णय गर्न प्रयोग गर्ने ग्राहकहरू धारा 22 अनुपालनका लागि आफैं जिम्मेवार हुन्छन्। हाम्रा शासन रसिद ती ग्राहकहरूलाई मानव निरीक्षण प्रदर्शन गर्न चाहिने अडिट ट्रेल दिन डिजाइन गरिएका हुन्, तर त्यो निरीक्षण प्रदान गर्ने कानुनी दायित्व ग्राहकमा हुन्छ।
		</p>
	</section>
}

templ privacyChangesNE() {
	<section id="changes">
		<h2>14. यो नीतिमा परिवर्तन</h2>
		<p>
			हामी यो नीति समय-समयमा अद्यावधिक गर्न सक्छौं। भौतिक परिवर्तन सक्रिय ग्राहकहरूलाई इमेलद्वारा र यो पृष्ठमा कम्तीमा 30 दिन प्रमुख ब्यानरद्वारा सूचित गरिन्छ। गैर-भौतिक परिवर्तन नयाँ "पछिल्लो पटक अद्यावधिक" मितिसहित पोस्ट गरिन्छन्।
		</p>
	</section>
}

