package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// DPADE is the Data Processing Agreement template (/legal/dpa) in
// German, at /de/legal/dpa. It is a translation of DPA: the same
// sections, anchors, links and figures, held to it by
// TestTranslationsKeepTheEnglishPage. The English page governs. Change
// the English page first, then this one.
templ DPADE() {
	@components.LayoutSite("KIFF — Auftragsverarbeitungsvertrag", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@dpaHeadDE()
			@dpaPartiesDE()
			@dpaDefinitionsDE()
			@dpaScopeDE()
			@dpaSubjectMatterDE()
			@dpaNaturePurposeDE()
			@dpaCategoriesDE()
			@dpaInstructionsDE()
			@dpaProcessorObligationsDE()
			@dpaConfidentialityDE()
			@dpaSubprocessorsDE()
			@dpaTransfersDE()
			@dpaSecurityDE()
			@dpaBreachNotificationDE()
			@dpaDataSubjectRequestsDE()
			@dpaAuditDE()
			@dpaReturnDeletionDE()
			@dpaLiabilityDE()
			@dpaTermDE()
			@dpaGoverningLawDE()
			@dpaAnnex1DE()
			@dpaAnnex2DE()
			@dpaAnnex3DE()
			@dpaAnnex4DE()
		</article>
	}
}

templ dpaHeadDE() {
	<header class="legal-head">
		<p class="legal-badge">AVV-Vorlage · v0.1</p>
		<h1>Auftragsverarbeitungsvertrag</h1>
		<p class="legal-meta">
			<strong>Version der Vorlage:</strong> v0.1.
			<strong>Zuletzt aktualisiert:</strong> 28. November 2026.
		</p>
		<p class="legal-disclaimer">
			Dies ist eine veröffentlichte <em>Vorlage</em>, kein
			unterzeichneter Vertrag. Kunden können sie als
			Ausgangspunkt für die Prüfung im Einkauf nutzen. Ein
			unterzeichneter AVV begründet echte Pflichten für Kiff
			Agents OÜ, die Aufsichtsbehörden der EU durchsetzen können.
			Kontakt für den Einkauf:
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</header>
}

templ dpaPartiesDE() {
	<section id="parties">
		<h2>1. Parteien</h2>
		<p>Dieser AVV wird geschlossen zwischen:</p>
		<ul>
			<li><strong>Kiff Agents OÜ</strong>, einer estnischen Gesellschaft mit beschränkter Haftung, Registernummer 17372313, Umsatzsteuer-Identifikationsnummer EE102924327, eingetragen unter der Anschrift Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estland (der <strong>„Auftragsverarbeiter“</strong>); und</li>
			<li><strong>[RECHTLICHER NAME DES KUNDEN]</strong>, eingetragen unter der Anschrift <strong>[ANSCHRIFT]</strong>, Registernummer <strong>[REGISTERNUMMER]</strong> (der <strong>„Verantwortliche“</strong>).</li>
		</ul>
		<p>
			Jede eine „Partei“ und zusammen die „Parteien“. Dieser AVV
			ergänzt die Nutzungsbedingungen unter
			<a href="/de/terms">/terms</a> und jedes kommerzielle
			Bestellformular zwischen den Parteien; bei einem
			Widerspruch in Fragen des Datenschutzes geht dieser AVV
			vor.
		</p>
	</section>
}

templ dpaDefinitionsDE() {
	<section id="definitions">
		<h2>2. Begriffe</h2>
		<p>
			Begriffe, die hier nicht definiert sind, haben die
			Bedeutung, die ihnen die DSGVO (Verordnung (EU) 2016/679)
			gibt.
		</p>
		<ul>
			<li><strong>„DSGVO“</strong> — die Datenschutz-Grundverordnung der EU.</li>
			<li><strong>„Personenbezogene Daten“</strong>, <strong>„betroffene Person“</strong>, <strong>„Verarbeitung“</strong>, <strong>„Verantwortlicher“</strong>, <strong>„Auftragsverarbeiter“</strong>, <strong>„Unterauftragsverarbeiter“</strong>, <strong>„Verletzung des Schutzes personenbezogener Daten“</strong> — wie in Artikel 4 DSGVO definiert.</li>
			<li><strong>„Audit-Daten“</strong> — personenbezogene Daten, die der Verantwortliche über die Runtime an den Dienst übermittelt oder darin erzeugt, einschließlich Ereignissen, Entscheidungen, Aktionen, Genehmigungen und Belegen.</li>
			<li><strong>„tafs-Daten“</strong> — personenbezogene Daten in dem, was tafs im Auftrag des Verantwortlichen aufbewahrt: die Läufe und Chats jedes tafs (einschließlich dessen, was die verbundenen Apps des Verantwortlichen ihm zurückgeben) und die Chats von Setup, seine Berichte, seine Gedächtnisnotizen, die Geräte, die für seine Benachrichtigungen registriert sind, und die Verbindungen des Verantwortlichen zu seinen Apps in planque (die Aufzeichnung jeder Verbindung und ihrer Genehmigungen sowie das Token oder der Schlüssel, den planque für sie aufbewahrt). Anhang 4 beschreibt sie.</li>
			<li><strong>„Dienst“</strong> — das Produkt KIFF Cloud, einschließlich tafs, wie in den Nutzungsbedingungen definiert.</li>
			<li><strong>„Standardvertragsklauseln“</strong> oder <strong>„SCC“</strong> — die Standardvertragsklauseln der Europäischen Kommission von 2021 für die Übermittlung personenbezogener Daten in Drittländer.</li>
			<li><strong>„DPF“</strong> — der Angemessenheitsbeschluss zum EU-US-Datenschutzrahmen (EU–US Data Privacy Framework).</li>
			<li><strong>„TOM“</strong> — die technischen und organisatorischen Maßnahmen, die Anhang 2 beschreibt.</li>
		</ul>
	</section>
}

templ dpaScopeDE() {
	<section id="scope">
		<h2>3. Geltungsbereich und Rollen</h2>
		<p>
			Dieser AVV gilt, wo Kiff Agents OÜ im Zusammenhang mit dem
			Dienst personenbezogene Daten im Auftrag des
			Verantwortlichen verarbeitet. Für Audit-Daten und
			tafs-Daten ist der Verantwortliche der Verantwortliche und
			Kiff Agents OÜ der Auftragsverarbeiter.
		</p>
		<p>
			Für personenbezogene Daten, die wir über die Kontoinhaber
			des Verantwortlichen verarbeiten (Anmelde-Metadaten,
			Rechnungskontakte, Support-Korrespondenz), gilt unsere
			<a href="/de/privacy">Datenschutzerklärung</a>; für diese
			Daten sind wir ein eigenständiger Verantwortlicher, kein
			Auftragsverarbeiter nach diesem AVV.
		</p>
	</section>
}

templ dpaSubjectMatterDE() {
	<section id="subject-matter">
		<h2>4. Gegenstand und Dauer</h2>
		<p>
			<strong>Gegenstand:</strong> die Verarbeitung von
			Audit-Daten und tafs-Daten, um den Dienst zu erbringen.
		</p>
		<p>
			<strong>Dauer:</strong> ab dem Datum, an dem dieser AVV
			wirksam wird, bis zum späteren der folgenden Zeitpunkte:
			(a) der Beendigung der zugrunde liegenden
			Nutzungsbedingungen oder (b) der Löschung aller Audit-Daten
			nach § 16. Bestimmungen, die ihrer Natur nach die
			Beendigung überdauern (Audit, Freistellung, anwendbares
			Recht), gelten weiter.
		</p>
	</section>
}

templ dpaNaturePurposeDE() {
	<section id="nature-purpose">
		<h2>5. Art und Zweck der Verarbeitung</h2>
		<p>
			Kiff Agents OÜ verarbeitet Audit-Daten nur, soweit es nötig
			ist, um den Dienst zu erbringen: Vorschläge und
			Tool-Aufrufe entgegennehmen, sie anhand der Konfiguration
			und der Cards des Verantwortlichen prüfen, sie für eine
			menschliche Genehmigung zurückhalten, wo die Konfiguration
			das verlangt, einen autorisierten Aufruf an die verbundene
			App weiterleiten oder eine Autorisierung ausstellen, die
			die App prüft, die Entscheidungen und das Ergebnis
			aufzeichnen, das die App meldet, signierte Belege ausgeben
			und (wo der Verantwortliche das so konfiguriert hat)
			zusammenfassende Hashes, an denen Manipulationen erkennbar
			sind, in einem öffentlichen, nachprüfbaren Pfad
			veröffentlichen. Die zugrunde liegende Aktion führt die
			verbundene App aus; eine Autorisierungsentscheidung allein
			ist kein Nachweis, dass die Aktion ausgeführt wurde.
		</p>
		<p>
			Für tafs verarbeitet Kiff Agents OÜ außerdem tafs-Daten, um
			jeden taf zu betreiben, den der Verantwortliche startet:
			ihn nach seinem Zeitplan und in Chats mit den Personen des
			Verantwortlichen laufen zu lassen, seine Tool-Aufrufe über
			KIFF zu senden, seine Läufe, Chats und Gedächtnisnotizen
			aufzubewahren, damit er berichten und seine Arbeit
			fortsetzen kann, und die registrierten Geräte des
			Verantwortlichen zu benachrichtigen, wenn ein Aufruf
			zurückgehalten wird. Über Setup und planque verbindet sie
			außerdem die Apps des Verantwortlichen, wenn sich dessen
			Personen beim Anbieter der App anmelden und die
			Verbindung auf ihrem Gerät genehmigen: Bei einer App, bei der sich planque selbst anmeldet, etwa Stripe, oder bei einem Schlüssel, den der Verantwortliche angibt, bewahrt planque dieses Token oder diesen Schlüssel verschlüsselt auf und nutzt es nur, um einen Aufruf auszuführen, über den KIFF entschieden hat; bei einer verwalteten Verbindung verwahrt Composio die Anmeldung und führt nur die Aufrufe aus, die planque anfordert, und planque bewahrt die Aufzeichnung der Verbindung und die genehmigten Tools auf. Verwaltete Verbindungen nutzt KIFF nur für die Apps, die unter <a href="/de/subprocessors#composio">kiff.dev/subprocessors</a> genannt sind. Anhang 4 legt dar, um welche Daten es geht, wo sie
			aufbewahrt werden und wie lange.
		</p>
	</section>
}

templ dpaCategoriesDE() {
	<section id="categories">
		<h2>6. Kategorien betroffener Personen und personenbezogener Daten</h2>
		<p>
			Standardmäßig verarbeitet Kiff Agents OÜ diese Kategorien
			personenbezogener Daten, wie das Verzeichnis unter
			<a href="/de/security#data-we-process">/security#data-we-process</a>
			sie beschreibt:
		</p>
		<ul>
			<li><strong>Kontodaten</strong>: wer die Personen des Verantwortlichen in seinem Konto sind (Namen, E-Mail-Adressen, Rollen), und seine Agenten und deren Schlüssel. Die Anmelde-Metadaten, die Kiff Agents OÜ als Verantwortlicher aufbewahrt, bleiben unter § 3.</li>
			<li><strong>App-Verbindungen</strong>: jede Verbindung zu den Apps des Verantwortlichen, die genehmigten Tools, die Aufzeichnung, wer sie genehmigt hat, und, wo planque es aufbewahrt, ihr Token oder ihr Schlüssel (verschlüsselt).</li>
			<li><strong>Aufzeichnungen über Aktionen von Agenten</strong>: für jeden Aufruf, wer gefragt hat (Agent und Schlüssel), die Aktion, worauf sie gewirkt hat, das Ergebnis und seine Gründe, die geltende Card, numerische Parameter, zurückgehaltene Aufrufe und ihre Antworten und die Belege.</li>
			<li><strong>Chats mit tafs</strong>: die Läufe und Chats jedes tafs, seine Berichte und Gedächtnisnotizen und was die Apps des Verantwortlichen ihm zurückgeben, wie Anhang 4 es beschreibt.</li>
		</ul>
		<p>
			Die <strong>betroffenen Personen</strong> sind die Personen
			des Verantwortlichen, die den Dienst nutzen, und die
			Personen, deren Daten in den Aktionen seiner Agenten und in
			Chats mit tafs vorkommen, etwa Kunden, Lieferanten oder
			Beschäftigte des Verantwortlichen.
		</p>
		<p>
			Was sonst den Dienst erreicht, hängt von der Konfiguration
			des Verantwortlichen und den Daten ab, die er sendet; Kiff
			Agents OÜ steuert nicht, welche Felder der Verantwortliche
			sendet. Weitere Kategorien trägt der Verantwortliche in
			Anhang 1 ein, der aktualisiert wird, wenn sich die
			Konfiguration wesentlich ändert.
		</p>
	</section>
}

templ dpaInstructionsDE() {
	<section id="instructions">
		<h2>7. Weisungen des Verantwortlichen</h2>
		<p>
			Kiff Agents OÜ verarbeitet personenbezogene Daten nach den
			dokumentierten Weisungen des Verantwortlichen. Diese
			Weisungen bestehen aus diesem AVV, den Nutzungsbedingungen,
			der technischen Dokumentation des Dienstes und den
			Sicherheitsmaßnahmen in der datierten Fassung unter
			<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>
			sowie den Konfigurationen und Weisungen, die die
			autorisierten Nutzer des Verantwortlichen über den Dienst
			übermitteln.
		</p>
		<p>
			Das strategische Whitepaper und die Dokumentation des
			gesondert lizenzierten Open-Source-Frameworks dienen der
			Erläuterung und sind nicht Teil dieser Weisungen zur
			Verarbeitung. Die Veröffentlichung eines überarbeiteten
			Dokuments ändert für sich allein nicht die Weisungen, die
			für eine bestehende Vereinbarung gelten.
		</p>
		<p>
			Weisungen außerhalb dieses Rahmens brauchen eine
			schriftliche Vereinbarung. Hält Kiff Agents OÜ eine Weisung
			für einen Verstoß gegen die DSGVO oder ein anderes
			geltendes Datenschutzgesetz, teilt sie das dem
			Verantwortlichen mit.
		</p>
	</section>
}

templ dpaProcessorObligationsDE() {
	<section id="processor-obligations">
		<h2>8. Pflichten des Auftragsverarbeiters (Artikel 28 Absatz 3)</h2>
		<p>
			Kiff Agents OÜ wird:
		</p>
		<ol>
			<li>personenbezogene Daten nur auf dokumentierte Weisung des Verantwortlichen verarbeiten, auch in Bezug auf internationale Übermittlungen, es sei denn, das Recht der EU oder eines Mitgliedstaats verlangt etwas anderes (in diesem Fall teilt Kiff Agents OÜ dem Verantwortlichen diese rechtliche Anforderung vor der Verarbeitung mit, es sei denn, dieses Recht verbietet eine solche Mitteilung wegen eines wichtigen öffentlichen Interesses);</li>
			<li>sicherstellen, dass die Personen, die zur Verarbeitung personenbezogener Daten befugt sind, angemessenen Vertraulichkeitspflichten unterliegen;</li>
			<li>die technischen und organisatorischen Maßnahmen umsetzen, die Anhang 2 beschreibt;</li>
			<li>die Bedingungen für den Einsatz von Unterauftragsverarbeitern in § 10 einhalten;</li>
			<li>den Verantwortlichen unter Berücksichtigung der Art der Verarbeitung mit geeigneten Maßnahmen dabei unterstützen, seine Pflicht zu erfüllen, Anträge betroffener Personen nach Kapitel III der DSGVO zu beantworten;</li>
			<li>den Verantwortlichen dabei unterstützen, die Artikel 32 bis 36 DSGVO einzuhalten (Sicherheit, Meldung von Verletzungen, Datenschutz-Folgenabschätzung, vorherige Konsultation), unter Berücksichtigung der Art der Verarbeitung und der Informationen, die Kiff Agents OÜ zur Verfügung stehen;</li>
			<li>nach Wahl des Verantwortlichen alle personenbezogenen Daten bei Beendigung der Leistungen nach § 16 löschen oder zurückgeben und vorhandene Kopien löschen, es sei denn, das Recht der EU oder eines Mitgliedstaats verlangt die Speicherung;</li>
			<li>dem Verantwortlichen alle Informationen zur Verfügung stellen, die nötig sind, um die Einhaltung von Artikel 28 DSGVO nachzuweisen, und Audits nach § 15 ermöglichen und dazu beitragen.</li>
		</ol>
	</section>
}

templ dpaConfidentialityDE() {
	<section id="confidentiality">
		<h2>9. Vertraulichkeit</h2>
		<p>
			Kiff Agents OÜ stellt sicher, dass Personen mit Zugriff auf
			personenbezogene Daten schriftlichen
			Vertraulichkeitspflichten oder einer angemessenen
			gesetzlichen Verschwiegenheitspflicht unterliegen. Zugriff
			wird nach dem Prinzip der geringsten Rechte gewährt und
			protokolliert.
		</p>
	</section>
}

templ dpaSubprocessorsDE() {
	<section id="sub-processors">
		<h2>10. Unterauftragsverarbeiter</h2>
		<p>
			Der Verantwortliche erlaubt Kiff Agents OÜ, die
			Unterauftragsverarbeiter einzusetzen, die in Anhang 3 und
			unter <a href="/de/subprocessors">/subprocessors</a>
			aufgeführt sind; diese Seite ist die offizielle Liste. Kiff
			Agents OÜ erlegt jedem Unterauftragsverarbeiter
			Datenschutzpflichten auf, die nicht weniger Schutz bieten
			als dieser AVV.
		</p>
		<p>
			Der öffentliche, nachprüfbare Pfad ist kein
			Unterauftragsverarbeiter. Er erhält nur zusammenfassende
			Hashes und keine personenbezogenen Daten.
		</p>
		<p>
			Die datierte Fassung, auf die Abschnitt 7 verlinkt, hält
			die Liste zum Stand ihres Datums fest. Eine spätere
			Änderung wird nach diesem Abschnitt wirksam, nicht durch
			die Veröffentlichung einer Fassung.
		</p>
		<p>
			Will Kiff Agents OÜ für die Verarbeitung der
			personenbezogenen Daten des Verantwortlichen einen neuen
			Unterauftragsverarbeiter einsetzen oder einen bestehenden
			ersetzen, teilt sie das dem Verantwortlichen mindestens
			dreißig Tage im Voraus mit. Der Verantwortliche kann der
			Änderung innerhalb von fünfzehn Tagen nach der Mitteilung
			aus angemessenen Gründen des Datenschutzes widersprechen;
			lässt sich ein angemessener Widerspruch nicht ausräumen,
			kann jede Partei den betroffenen Teil des Dienstes
			schriftlich kündigen.
		</p>
	</section>
}

templ dpaTransfersDE() {
	<section id="transfers">
		<h2>11. Internationale Übermittlungen</h2>
		<p>
			Wo die Verarbeitung personenbezogener Daten eine
			Übermittlung in ein Land außerhalb des Europäischen
			Wirtschaftsraums ohne Angemessenheitsbeschluss nach
			Artikel 45 DSGVO einschließt, vereinbaren die Parteien:
		</p>
		<ul>
			<li>für Übermittlungen an Unterauftragsverarbeiter, die nach dem EU-US-Datenschutzrahmen zertifiziert sind, ist der DPF der Übermittlungsmechanismus, solange er in Kraft ist;</li>
			<li>andernfalls beziehen die Parteien die Standardvertragsklauseln der Europäischen Kommission von 2021 durch Verweis ein, wobei Modul 2 (Verantwortlicher an Auftragsverarbeiter) für Übermittlungen vom Verantwortlichen an Kiff Agents OÜ gilt und Modul 3 (Auftragsverarbeiter an Unterauftragsverarbeiter) für Übermittlungen von Kiff Agents OÜ an einen Unterauftragsverarbeiter;</li>
			<li>die Kopplungsklausel (Klausel 7) wird nicht verwendet; Parteien der SCC sind der Verantwortliche und Kiff Agents OÜ;</li>
			<li>Anhang I.A und I.B der SCC werden durch Verweis auf Anhang 1 dieses AVV ausgefüllt; Anhang II der SCC durch Verweis auf Anhang 2 dieses AVV; Anhang III durch Verweis auf Anhang 3 dieses AVV;</li>
			<li>es gilt Option 2 der Klausel 9 Buchstabe a (allgemeine schriftliche Genehmigung), mit der Mitteilungsfrist von dreißig Tagen aus § 10 oben.</li>
		</ul>
		<p>
			Wo nach einer Transfer-Folgenabschätzung (TIA)
			zusätzliche Maßnahmen angebracht sind, setzt Kiff Agents OÜ
			sie um (Verschlüsselung bei der Übertragung und im
			Ruhezustand, Protokollierung von Zugriffen,
			Datenminimierung, wie in Anhang 2 dokumentiert).
		</p>
	</section>
}

templ dpaSecurityDE() {
	<section id="security">
		<h2>12. Sicherheitsmaßnahmen</h2>
		<p>
			Kiff Agents OÜ setzt geeignete technische und
			organisatorische Maßnahmen um, um ein dem Risiko
			angemessenes Schutzniveau nach Artikel 32 DSGVO zu
			gewährleisten. Die Maßnahmen in Anhang 2 und in der
			datierten Fassung unter
			<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>
			sind die vereinbarte Grundlage.
			<a href="/de/security">/security</a> beschreibt die
			aktuellen Maßnahmen. Kiff Agents OÜ kann die Maßnahmen
			aktualisieren, solange das Schutzniveau insgesamt nicht
			unter diese Grundlage sinkt, und teilt dem Verantwortlichen
			eine wesentliche Änderung daran im Voraus mit.
		</p>
	</section>
}

templ dpaBreachNotificationDE() {
	<section id="breach-notification">
		<h2>13. Meldung einer Verletzung des Schutzes personenbezogener Daten</h2>
		<p>
			Kiff Agents OÜ meldet dem Verantwortlichen eine Verletzung
			des Schutzes personenbezogener Daten, die personenbezogene
			Daten des Verantwortlichen betrifft, unverzüglich und in
			jedem Fall innerhalb von zweiundsiebzig (72) Stunden,
			nachdem sie ihr bekannt geworden ist. Die Meldung enthält,
			soweit zu diesem Zeitpunkt bekannt und ergänzt, sobald
			weitere Informationen vorliegen:
		</p>
		<ul>
			<li>die Art der Verletzung, einschließlich der Kategorien und der ungefähren Zahl der betroffenen Personen und Datensätze;</li>
			<li>die wahrscheinlichen Folgen der Verletzung;</li>
			<li>die Maßnahmen, die ergriffen oder vorgeschlagen wurden, um die Verletzung zu beheben und ihre möglichen nachteiligen Auswirkungen zu mildern;</li>
			<li>den Namen und die Kontaktdaten einer zentralen Anlaufstelle bei Kiff Agents OÜ für weitere Informationen.</li>
		</ul>
		<p>
			Die eigene Frist des Verantwortlichen nach Artikel 33 DSGVO
			gegenüber seiner Aufsichtsbehörde beginnt, wenn dem
			Verantwortlichen selbst die Verletzung bekannt wird; diese
			Meldung unterstützt ihn bei dieser Pflicht.
		</p>
	</section>
}

templ dpaDataSubjectRequestsDE() {
	<section id="data-subject-requests">
		<h2>14. Anträge betroffener Personen</h2>
		<p>
			Kiff Agents OÜ unterstützt den Verantwortlichen mit
			geeigneten technischen und organisatorischen Maßnahmen und
			unter Berücksichtigung der Art der Verarbeitung dabei,
			seine Pflicht zu erfüllen, Anträge betroffener Personen zu
			beantworten, die ihre Rechte nach den Artikeln 15 bis 22
			DSGVO ausüben.
		</p>
		<p>
			Kiff Agents OÜ bestätigt Bitten des Verantwortlichen um
			Unterstützung innerhalb von fünf (5) Arbeitstagen. Anträge,
			die direkt von betroffenen Personen eingehen, werden
			unverzüglich an den Verantwortlichen weitergeleitet; Kiff
			Agents OÜ beantwortet diese Anträge nicht selbst, außer um
			den Eingang zu bestätigen und die betroffene Person an den
			Verantwortlichen zu verweisen.
		</p>
	</section>
}

templ dpaAuditDE() {
	<section id="audit">
		<h2>15. Auditrechte</h2>
		<p>
			Kiff Agents OÜ stellt dem Verantwortlichen alle
			Informationen zur Verfügung, die vernünftigerweise nötig
			sind, um die Einhaltung von Artikel 28 DSGVO nachzuweisen.
			Mit angemessener schriftlicher Vorankündigung (mindestens
			dreißig Tage, außer bei einem Audit, das durch eine
			bestätigte wesentliche Verletzung ausgelöst wurde) kann der
			Verantwortliche bei Kiff Agents OÜ einmal je Zeitraum von
			zwölf Monaten ein Audit durchführen.
		</p>
		<p>
			Kiff Agents OÜ hat noch keinen Bericht nach SOC 2 oder
			ISO 27001. Auf Anfrage stellt sie ihre Sicherheitsübersicht
			unter <a href="/de/security">/security</a> bereit und beantwortet
			die Sicherheitsfragebögen des Verantwortlichen.
		</p>
		<p>
			Audits finden während der üblichen Geschäftszeiten statt,
			stören den Dienst nicht unangemessen und wahren die
			Vertraulichkeit der anderen Kunden von Kiff Agents OÜ. Der
			Verantwortliche trägt seine eigenen Auditkosten; deckt ein
			Audit auf, dass Kiff Agents OÜ wesentliche Pflichten nicht
			einhält, erstattet Kiff Agents OÜ dem Verantwortlichen
			seine angemessenen Auditkosten.
		</p>
	</section>
}

templ dpaReturnDeletionDE() {
	<section id="return-deletion">
		<h2>16. Rückgabe oder Löschung personenbezogener Daten</h2>
		<p>
			Nach Wahl des Verantwortlichen und innerhalb von dreißig
			Tagen nach Beendigung des Dienstes für den
			Verantwortlichen gibt Kiff Agents OÜ die Audit-Daten
			entweder in einem strukturierten, gängigen und
			maschinenlesbaren Format zurück oder löscht sie. Dieselbe
			Wahl gilt für tafs-Daten. Trifft der Verantwortliche in
			dieser Frist keine Wahl, löscht Kiff Agents OÜ beides.
			tafs-Daten werden gelöscht, indem jeder taf entfernt wird,
			wie Anhang 4 es beschreibt: Nachdem die Daten des
			Verantwortlichen zurückgegeben sind, oder sofort, wenn er
			die Löschung gewählt hat, entfernt Kiff Agents OÜ jeden
			taf, den der Verantwortliche nicht selbst entfernt hat, und
			trennt und löscht die Verbindungen des Verantwortlichen und
			ihre Aufzeichnungen in planque.
		</p>
		<p>
			Hashes, die schon im öffentlichen, nachprüfbaren Pfad
			veröffentlicht sind, bleiben, weil der Pfad
			unveränderlich ist. Weil der öffentliche Pfad kryptografisches
			Salting je Mandant verwendet (siehe
			<a href="/de/security#public-trail">/security#public-trail</a>),
			sorgt die Vernichtung des Salts des
			Mandanten dafür, dass sich diese veröffentlichten Hashes
			dauerhaft nicht mehr mit den Aufzeichnungen verknüpfen
			lassen, aus denen sie entstanden sind.
		</p>
		<p>
			KIFFs Datenbank wird täglich verschlüsselt gesichert, und
			jedes Backup wird sieben Tage aufbewahrt; ein gelöschter
			Eintrag ist also innerhalb von sieben Tagen nach seiner
			Löschung aus den Backups verschwunden. Die Speicher von
			tafs und planque halten verschlüsselte
			Point-in-Time-Kopien 35 Tage lang vor; ein gelöschter
			Eintrag ist also innerhalb von 35 Tagen nach seiner
			Löschung aus ihnen verschwunden. Sie dienen nur dazu,
			einen Speicher nach einem Ausfall wiederherzustellen.
			Dienstlogs, die das Konto nennen können, werden innerhalb
			von 30 Tagen gelöscht. Kiff Agents OÜ kann personenbezogene
			Daten aufbewahren, wo das Recht der EU oder eines
			Mitgliedstaats die Speicherung verlangt (zum Beispiel § 12
			des estnischen Rechnungslegungsgesetzes).
		</p>
	</section>
}

templ dpaLiabilityDE() {
	<section id="liability">
		<h2>17. Haftung</h2>
		<p>
			Die Haftung jeder Partei aus diesem AVV unterliegt den
			Beschränkungen und Ausschlüssen in den Nutzungsbedingungen,
			außer wo geltendes Recht eine solche Beschränkung
			verbietet. Jede Partei haftet nach Artikel 82 DSGVO für
			Schäden, die ihr eigener Verstoß gegen die DSGVO
			verursacht.
		</p>
	</section>
}

templ dpaTermDE() {
	<section id="term">
		<h2>18. Laufzeit und Beendigung</h2>
		<p>
			Dieser AVV wird mit der Unterschrift beider Parteien
			wirksam und gilt für die in § 4 beschriebene Dauer. Die
			Beendigung der Nutzungsbedingungen beendet automatisch
			diesen AVV, vorbehaltlich der Pflichten, die fortgelten.
		</p>
	</section>
}

templ dpaGoverningLawDE() {
	<section id="governing-law">
		<h2>19. Anwendbares Recht</h2>
		<p>
			Für diesen AVV gilt das Recht der Republik Estland,
			unbeschadet zwingender Bestimmungen der DSGVO oder, wo sie
			gelten, der Verbraucherschutzvorschriften. Für
			Streitigkeiten aus diesem AVV gelten die Regeln zu
			Gerichtsstand und Rechtswahl in § 18 der
			Nutzungsbedingungen.
		</p>
	</section>
}

templ dpaAnnex1DE() {
	<section id="annex-1">
		<h2>Anhang 1 — Beschreibung der Verarbeitung</h2>
		<p>Wird für jede unterzeichnete Fassung ausgefüllt.</p>
		<dl class="legal-annex">
			<div>
				<dt>A. Liste der Parteien</dt>
				<dd>Verantwortlicher und Auftragsverarbeiter, wie in § 1 benannt.</dd>
			</div>
			<div>
				<dt>B. Beschreibung der Übermittlung</dt>
				<dd>
					<strong>Kategorien betroffener Personen:</strong> wie in § 6 aufgeführt, dazu [weitere Kategorien, die der Verantwortliche angibt].
					<br/>
					<strong>Kategorien personenbezogener Daten:</strong> wie in § 6 aufgeführt (Kontodaten, App-Verbindungen, Aufzeichnungen über Aktionen von Agenten, Chats mit tafs), dazu [weitere Kategorien, die der Verantwortliche angibt].
					<br/>
					<strong>Sensible Daten:</strong> [Angabe des Verantwortlichen; Standard: keine].
					<br/>
					<strong>Häufigkeit der Übermittlung:</strong> fortlaufend (jede Anfrage an den Dienst).
					<br/>
					<strong>Art der Verarbeitung:</strong> wie in § 5 beschrieben.
					<br/>
					<strong>Zwecke der Verarbeitung:</strong> wie in § 5 beschrieben.
					<br/>
					<strong>Aufbewahrungsfrist:</strong> nach <a href="/de/privacy#retention">/privacy#retention</a> und § 16.
				</dd>
			</div>
			<div>
				<dt>C. Zuständige Aufsichtsbehörde</dt>
				<dd>Die Estnische Datenschutzinspektion (Andmekaitse Inspektsioon).</dd>
			</div>
		</dl>
	</section>
}

templ dpaAnnex2DE() {
	<section id="annex-2">
		<h2>Anhang 2 — Technische und organisatorische Maßnahmen</h2>
		<p>
			Eine Zusammenfassung, wie sie zu einem AVV nach Artikel 28
			passt. Dieser Anhang und die datierte Fassung unter
			<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>
			sind die vereinbarte Grundlage nach Abschnitt 12.
			<a href="/de/security">/security</a> zeigt die aktuellen
			Maßnahmen und wird innerhalb von 30 Tagen nach einer
			wesentlichen Änderung aktualisiert.
		</p>
		<div class="legal-table" tabindex="0">
			<table>
				<thead>
					<tr>
						<th>Aspekt nach Artikel 32</th>
						<th>Maßnahmen</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Pseudonymisierung und Verschlüsselung</td>
						<td>TLS 1.2+ bei der Übertragung. Verschlüsselung im Ruhezustand mit den Standardeinstellungen des Anbieters der verwalteten Datenbank. Signaturschlüssel je Mandant in einem verwalteten Schlüsseldienst. Hashen der E-Mail-Adressen im Ruhezustand geplant.</td>
					</tr>
					<tr>
						<td>Vertraulichkeit</td>
						<td>Mandantentrennung auf der Ebene der Datenbank (ein Postgres-Schema je Mandant mit festgelegtem <code>search_path</code>). Zugriff nach dem Prinzip der geringsten Rechte, Single Sign-on für das Personal, Vertraulichkeitsvereinbarungen für alle Beschäftigten.</td>
					</tr>
					<tr>
						<td>Integrität</td>
						<td>Eine Audit-Kette auf der Ebene des Frameworks, an die nur angehängt wird. Zusammenfassende Hashes, an denen Manipulationen erkennbar sind, veröffentlicht in einem öffentlichen, nachprüfbaren Pfad.</td>
					</tr>
					<tr>
						<td>Verfügbarkeit und Belastbarkeit</td>
						<td>Verwaltete Rechenleistung und Datenbank in <code>eu-west-1</code> (Irland). Health-Checks. Hinweise zum Betrieb unter <a href="/de/security#incident">/security#incident</a>.</td>
					</tr>
					<tr>
						<td>Wiederherstellung des Zugangs</td>
						<td>Dokumentiertes Runbook für die Reaktion auf Vorfälle, nur intern.</td>
					</tr>
					<tr>
						<td>Prüfung der Wirksamkeit</td>
						<td>Unit- und Integrationstests, vor jedem Release ausgeführt; regelmäßige Sicherheitsprüfung.</td>
					</tr>
				</tbody>
			</table>
		</div>
	</section>
}

templ dpaAnnex3DE() {
	<section id="annex-3">
		<h2>Anhang 3 — Unterauftragsverarbeiter</h2>
		<p>
			Die offizielle Liste steht unter
			<a href="/de/subprocessors">/subprocessors</a>;
			diese Liste ist für die aktuellen Unterauftragsverarbeiter
			maßgeblich, ändert sich nur nach dem Verfahren in
			Abschnitt 10 und wird innerhalb von 30 Tagen nach jeder
			Änderung aktualisiert.
			Stand dieser Version der Vorlage:
		</p>
		<div class="legal-table" tabindex="0">
			<table>
				<thead>
					<tr>
						<th>Unterauftragsverarbeiter</th>
						<th>Erbrachte Leistung</th>
						<th>Region</th>
						<th>Übermittlungsmechanismus</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Amazon Web Services EMEA SARL / Amazon Web Services Inc.</td>
						<td>Rechenleistung, verwaltetes Postgres, Schlüsselverwaltung, Netzwerk, Speicherung von Secrets; für tafs auch dessen Läufe, Chats und Gedächtnisnotizen, die Verbindungen von planque und die Mails der E-Mail-Tür eines tafs (chutchut); für tafs: eine Antwort, die jemand in der App meldet, an das Team von KIFF</td>
						<td>Irland (eu-west-1): KIFF Cloud, der tafs-Dienst, die Läufe, Chats und Modellaufrufe von tafs sowie planque, mit allem, was sie speichern. Aus Irland kommen auch KIFFs öffentliche Demos und die Videos der Website. In den Vereinigten Staaten (us-east-1) liegen nur die Zertifikate, die CloudFront dort verlangt; sie enthalten keine Kundendaten</td>
						<td>EU-US-Datenschutzrahmen / ersatzweise SCC</td>
					</tr>
					<tr>
						<td>Clerk, Inc.</td>
						<td>Authentifizierung der Nutzer und Sitzungsverwaltung: E-Mail-Adresse und Name der Personen, die sich anmelden, ihre Sitzungen, IP-Adresse, Gerät und Browser sowie die Identität von Apple, Google oder GitHub, wenn sich jemand über einen von ihnen anmeldet</td>
						<td>Vereinigte Staaten</td>
						<td>EU-US-Datenschutzrahmen / ersatzweise SCC</td>
					</tr>
					<tr>
						<td>Anthropic, PBC</td>
						<td>Nur tafs: das KI-Modell hinter Coach und jedem taf (Claude API), das Daten erst erhält, wenn die Person es in der tafs-App erlaubt hat. Anthropic löscht, was es empfängt und zurückgibt, innerhalb von 30 Tagen, es sei denn, es muss es länger aufbewahren, um das Gesetz einzuhalten oder um seine Nutzungsrichtlinie durchzusetzen, oder seine kommerziellen Bedingungen sehen etwas anderes vor. Derzeit nicht im Einsatz.</td>
						<td>Vereinigte Staaten, aufgerufen aus Irland (eu-west-1); die Inferenz kann in den Vereinigten Staaten, Europa, Asien oder Australien laufen</td>
						<td>SCC</td>
					</tr>
					<tr>
						<td>Amazon Web Services EMEA SARL (Amazon Bedrock)</td>
						<td>Nur tafs, und nur solange es der eingesetzte Anbieter ist, immer nur einer: betreibt Claude, das Modell hinter Coach und jedem taf, über Amazon Bedrock, mit Daten erst, wenn die Person es in der tafs-App erlaubt hat. Nicht zum Trainieren von Modellen genutzt; im Standard-Aufbewahrungsmodus von Bedrock bewahren manche Modelle es bis zu 30 Tage für Vertrauen und Sicherheit auf. Derzeit im Einsatz.</td>
						<td>Nur EU-Regionen (EU-regionsübergreifende Inferenzprofile von Bedrock), aufgerufen aus Irland (eu-west-1)</td>
						<td>Innerhalb der EU; EU-US-Datenschutzrahmen / ersatzweise SCC</td>
					</tr>
					<tr>
						<td>Google Cloud EMEA Limited (Vertex AI)</td>
						<td>Nur tafs, und nur solange es der eingesetzte Anbieter ist, immer nur einer: betreibt Claude über Vertex AI, mit Daten erst, wenn die Person es in der tafs-App erlaubt hat. Bei manchen Anthropic-Modellen bis zu 30 Tage zur Missbrauchsüberwachung aufbewahrt und dafür mit Anthropic geteilt</td>
						<td>Nur EU (regionale europe-west-Endpunkte)</td>
						<td>Innerhalb der EU; EU-US-Datenschutzrahmen / ersatzweise SCC</td>
					</tr>
					<tr>
						<td>Microsoft Ireland Operations Limited (Azure AI Foundry)</td>
						<td>Nur tafs, und nur solange es der eingesetzte Anbieter ist, immer nur einer: hostet den Claude-Endpunkt auf Azure, mit Daten erst, wenn die Person es in der tafs-App erlaubt hat; Anthropic verarbeitet das Gesendete nach seinen eigenen Bedingungen, wie in der Zeile von Anthropic</td>
						<td>Nur EU-Datenzone (eine auf Azure gehostete Bereitstellung)</td>
						<td>Innerhalb der EU; EU-US-Datenschutzrahmen / ersatzweise SCC</td>
					</tr>
					<tr>
						<td>Apple Inc.</td>
						<td>Nur tafs: stellt Benachrichtigungen über zurückgehaltene Aufrufe an registrierte Geräte zu (Apple Push Notification service). Eine Benachrichtigung enthält keine Details der Anfrage</td>
						<td>Vereinigte Staaten</td>
						<td>SCC</td>
					</tr>
					<tr>
						<td>Resend, Inc.</td>
						<td>E-Mail an die Personen des Verantwortlichen: Hinweise zu zurückgehaltenen Aufrufen und Card-Warnungen, Hinweise zu Nutzung und Konto sowie Antworten des Supports</td>
						<td>Vereinigte Staaten</td>
						<td>SCC</td>
					</tr>
					<tr>
						<td>Sampark Inc. (Composio)</td>
						<td>Nur tafs, über planque: verwahrt die Anmeldungen verwalteter Verbindungen und den Slack-Bot hinter einer Slack-Tür und führt jeden Aufruf aus, den planque anfordert, mit seiner Eingabe und der Antwort des Dienstes. Weder ein taf noch planque erhält diese Anmeldungen</td>
						<td>Vereinigte Staaten</td>
						<td>SCC (Modul 3)</td>
					</tr>
					<tr>
						<td>Stripe Payments Europe, Ltd. / Stripe, Inc.</td>
						<td>Abrechnung, wenn sie aktiv ist: der Rechnungskontakt des Kontos und die Nutzungszahlen, die für die Rechnungsstellung gemeldet werden</td>
						<td>EU und Vereinigte Staaten</td>
						<td>EU-US-Datenschutzrahmen / ersatzweise SCC</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p>
			Der öffentliche, nachprüfbare Pfad ist kein
			Unterauftragsverarbeiter: Er erhält nur zusammenfassende
			Hashes und keine personenbezogenen Daten.
		</p>
	</section>
}

templ dpaAnnex4DE() {
	<section id="annex-4">
		<h2>Anhang 4 — tafs</h2>
		<p>
			Was tafs im Auftrag des Verantwortlichen aufbewahrt, wo und
			wie lange. Der Verantwortliche entfernt einen taf in der
			tafs-App; damit wird alles unten gelöscht, was aufbewahrt
			wird, „bis der taf entfernt wird“.
		</p>
		<div class="legal-table" tabindex="0">
			<table>
				<thead>
					<tr>
						<th>Daten</th>
						<th>Wo</th>
						<th>Was sie enthalten können</th>
						<th>Wie lange</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Läufe und Chats, auch die von Setup</td>
						<td>Der eigene Speicher von tafs (AWS, eine Region in der EU)</td>
						<td>Die Nachrichten der Personen des Verantwortlichen an den taf, seine Antworten und Berichte, eine Zusammenfassung der früheren Nachrichten eines langen Chats, die Tool-Aufrufe, die er gemacht hat, und was jeder Lauf gekostet hat</td>
						<td>30 Tage oder bis der taf entfernt wird, falls das früher ist</td>
					</tr>
					<tr>
						<td>Was die Apps zurückgeben</td>
						<td>Der eigene Speicher von tafs (AWS, eine Region in der EU)</td>
						<td>Ergebnisse aus den Apps des Verantwortlichen, die Daten über seine Kunden, Lieferanten oder Beschäftigten enthalten können</td>
						<td>Bis der Lauf endet, der sie gelesen hat. In einem Chat werden die Ergebnisse von Aufrufen, die nur lesen, für die nächsten Nachrichten dieses Chats aufbewahrt, verschlüsselt mit einem Schlüssel des Kontos des Verantwortlichen, und genutzt, bis der Chat eine Stunde lang ruht, und nie länger als vier Stunden nach dem Lesen. Danach werden sie automatisch gelöscht, was bis zu einigen Tagen dauern kann; in dieser Zeit werden sie nicht genutzt. Sie erscheinen in keiner Ansicht, keinem Bericht und keinem Export</td>
					</tr>
					<tr>
						<td>Worauf jeder Aufruf gewirkt hat</td>
						<td>Der eigene Speicher von tafs (AWS, eine Region in der EU)</td>
						<td>Für jeden Aufruf, den ein taf über KIFF macht: KIFFs Referenz für den Aufruf und die Kennung dessen, worauf er gewirkt hat (zum Beispiel eine Zahlungs-ID, nie die Angaben des Kunden), um ihn im Protokoll des tafs zu zeigen. Sonst nichts aus der Eingabe des Aufrufs</td>
						<td>30 Tage oder bis der taf entfernt wird, falls das früher ist</td>
					</tr>
					<tr>
						<td>Gedächtnisnotizen</td>
						<td>Der eigene Speicher von tafs (AWS, eine Region in der EU)</td>
						<td>Was der taf darüber gelernt hat, wie der Verantwortliche die Aufgabe erledigt haben möchte</td>
						<td>Bis die Notiz vergessen oder der taf entfernt wird</td>
					</tr>
					<tr>
						<td>Modellanfragen</td>
						<td>Anthropic oder der eingesetzte Cloud-Anbieter (siehe die Unterauftragsverarbeiter)</td>
						<td>Was eine Person Coach und den tafs schreibt, angehängte Dateien, was verbundene Apps einem taf während eines Laufs zurückgeben, und was auf dem Bildschirm ist, während Coach in der App hilft; und was das Modell zurückgibt. Nie die Passwörter und Schlüssel verbundener Apps oder ein Fingerabdruck</td>
						<td>Vom Unternehmen, das das Modell betreibt, innerhalb von 30 Tagen gelöscht, außer es wird als Verstoß gegen dessen Nutzungsregeln markiert oder das Gesetz verlangt, es aufzubewahren</td>
					</tr>
					<tr>
						<td>Der KIFF-Schlüssel des tafs</td>
						<td>Der eigene Dienst von tafs (AWS), als Secret aufbewahrt</td>
						<td>Die Zugangsdaten, mit denen der taf KIFF erreicht. Sie werden nie in einen Lauf oder Chat geschrieben</td>
						<td>Bis der taf entfernt wird</td>
					</tr>
					<tr>
						<td>Die Einrichtung des tafs</td>
						<td>Der eigene Dienst von tafs (AWS)</td>
						<td>Sein Name, seine Aufgabe, sein Zeitplan und sein Budget sowie das KIFF-Konto und der Agent, zu denen er gehört</td>
						<td>Bis der taf entfernt wird</td>
					</tr>
					<tr>
						<td>Geräte für Benachrichtigungen</td>
						<td>Der eigene Dienst von tafs (AWS, eu-west-1)</td>
						<td>Das Push-Token jedes registrierten Geräts und die Person, die es registriert hat</td>
						<td>Bis sich diese Person abmeldet, das Gerät entfernt wird oder Apple meldet, dass es das Token nicht mehr gibt</td>
					</tr>
					<tr>
						<td>Das Token oder der Schlüssel einer Verbindung in planque</td>
						<td>planque (AWS, eu-west-1), verschlüsselt mit AWS KMS</td>
						<td>Bei einer App, bei der sich planque selbst anmeldet, etwa Stripe, das Token aus der Anmeldung des Verantwortlichen bei ihrem Anbieter und das Konto beim Anbieter, an das es gebunden ist; bei einer Verbindung per Schlüssel der Schlüssel, den der Verantwortliche angegeben hat. Es wird nie einem taf gegeben</td>
						<td>Bis die Verbindung getrennt wird, was ein Token beim Anbieter widerruft und das Token oder den Schlüssel löscht; eine Anmeldung, die eine andere Verbindung des Kontos noch nutzt, bleibt bis zur letzten bestehen. Eine Anmeldung, die nur dazu dient, den Katalog einer App zu sehen, kann nicht für Aufrufe genutzt werden; werden innerhalb eines Tages keine Tools genehmigt, wird sie innerhalb der folgenden Stunde widerrufen</td>
					</tr>
					<tr>
						<td>Die Anmeldung einer verwalteten Verbindung</td>
						<td>Composio (Sampark Inc., Vereinigte Staaten)</td>
						<td>Das Token oder der Schlüssel aus der Anmeldung des Verantwortlichen beim Anbieter einer verwalteten Verbindung. Von Composio verwahrt und nie einem taf oder planque gegeben; planque bewahrt nur die Aufzeichnung der Verbindung und die genehmigten Tools auf. Composio verwahrt sie auch dann, wenn die Anmeldung KIFFs eigene App beim Anbieter nutzt</td>
						<td>Bis die Verbindung getrennt wird: Dann lässt planque sie bei Composio löschen, das den Anbieter bittet, sie zu widerrufen. Eine Anmeldung, die eine andere Verbindung des Kontos noch nutzt, bleibt bis zur letzten bestehen. Werden innerhalb eines Tages nach der Anmeldung keine Tools genehmigt, wird sie auf dieselbe Weise gelöscht</td>
					</tr>
					<tr>
						<td>Die Aufrufe einer verwalteten Verbindung</td>
						<td>Composio (Sampark Inc., Vereinigte Staaten)</td>
						<td>Die Eingabe jedes Aufrufs und die Antwort des Dienstes, für einen Aufruf, den planque bei Composio anfordert</td>
						<td>Bis zu ein Jahr in den Logs von Composio; innerhalb von 30 Tagen gelöscht, nachdem KIFF Composio nicht mehr nutzt</td>
					</tr>
					<tr>
						<td>Die Aufzeichnung einer Verbindung</td>
						<td>planque (AWS, eu-west-1)</td>
						<td>Die genehmigten Tools, der Status der Verbindung und ihre Ereignisse: wer jeden Schritt genehmigt hat, von welchem Gerät, und die Signatur dieser Person</td>
						<td>Bis das Konto endet; nach dem Trennen als Aufzeichnung der Genehmigungen aufbewahrt</td>
					</tr>
					<tr>
						<td>Der Connector-Schlüssel des Kontos</td>
						<td>planque (AWS, eu-west-1), verschlüsselt mit AWS KMS</td>
						<td>Der KIFF-Schlüssel, mit dem planque die Tools einer Verbindung dem KIFF-Konto des Verantwortlichen hinzufügt. Er kann nur die Tools einer Verbindung hinzufügen</td>
						<td>Bis er ersetzt wird oder das Konto endet</td>
					</tr>
					<tr>
						<td>Die Dienstlogs von planque</td>
						<td>planque (AWS, eu-west-1)</td>
						<td>Was jede Anfrage getan hat und warum ein Aufruf abgelehnt wurde, was das Konto, eine Verbindung oder einen taf nennen kann; nie das Token einer Anmeldung</td>
						<td>30 Tage</td>
					</tr>
					<tr>
						<td>Dienstlogs</td>
						<td>Der eigene Dienst von tafs (AWS, eu-west-1)</td>
						<td>Fehler, auf die eine Anfrage gestoßen ist und die einen taf oder eine Sitzung nennen können; nie Nachrichtentexte, Schlüssel oder Token</td>
						<td>30 Tage</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p>
			Die Cards, zurückgehaltenen Aufrufe, Antworten und Belege
			eines tafs sind Audit-Daten, die KIFF nach dem Rest dieses
			AVV aufbewahrt.
		</p>

		<hr/>

		<p class="legal-footnote">
			<strong>Dokumentversion:</strong> v0.1 Vorlage.<br/>
