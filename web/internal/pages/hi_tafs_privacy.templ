// and says so.
templ TafsPrivacyHI() {
	@components.LayoutSiteWithMeta("tafs गोपनीयता नीति", "KIFF का ऐप tafs व्यक्तिगत डेटा को कैसे संभालता है, जिसमें वह डेटा भी शामिल है जो आपके Google खाते को जोड़ने पर उसे Google से मिलता है।", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · गोपनीयता नीति</p>
				<h1>tafs गोपनीयता नीति</h1>
				<p class="legal-meta"><strong>अंतिम अपडेट:</strong> 25 नवंबर 2026।</p>
				<p class="legal-disclaimer">यह नीति बताती है कि KIFF का ऐप tafs (iPhone, iPad, Android और कंप्यूटर के लिए) व्यक्तिगत डेटा को कैसे संभालता है। tafs, KIFF Cloud का हिस्सा है, इसलिए <a href="/hi/privacy">KIFF की गोपनीयता नीति</a> भी उस पर लागू होती है, और उस हर बात पर जो इस पृष्ठ में नहीं है। प्रश्न: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>।</p>
			</header>
			<section id="who-we-are">
				<h2>1. हम कौन हैं</h2>
				<p>tafs को <strong>Kiff Agents OÜ</strong> उपलब्ध कराती है, जो एस्टोनिया में पंजीकृत एक निजी सीमित देयता कंपनी है (पंजीकरण कोड 17372313, VAT संख्या EE102924327), पता: Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, एस्टोनिया। यूरोपीय संघ का सामान्य डेटा संरक्षण विनियमन (GDPR) हमारी प्रोसेसिंग पर लागू होता है।</p>
			</section>
			<section id="scope">
				<h2>2. यह नीति क्या कवर करती है</h2>
				<p>iPhone, iPad, Android और कंप्यूटर (Mac, Windows और Linux) के लिए tafs ऐप और उसके पीछे की सेवा, जिसमें कंपनी के टूल जोड़ने वाला Setup और उन कनेक्शनों को रखने वाला planque शामिल हैं। tafs में कंपनी एक AI एजेंट, यानी taf, को काम सौंपती है, जो KIFF Card के भीतर काम करता है।</p>
			</section>
			<section id="roles">
				<h2>3. हमारी भूमिकाएँ</h2>
				<p>हम आपके खाते और साइन-इन डेटा के, और अपनी सेवा के परिचालन डेटा के <strong>नियंत्रक</strong> हैं। tafs आपकी कंपनी के लिए जो रखता है, यानी हर taf की रन, चैट, रिपोर्ट, मेमोरी नोट और उनके सौंपे गए फ़ाइलें, उनके लिए हम आपकी कंपनी की ओर से <strong>प्रोसेसर</strong> के रूप में काम करते हैं। उस डेटा की नियंत्रक आपकी कंपनी है, और उस संबंध को <a href="/legal/dpa">DPA</a> नियंत्रित करता है।</p>
			</section>
			<section id="data">
				<h2>4. tafs क्या एकत्र करता है</h2>
				<ul>
					<li><strong>आपका खाता:</strong> आप tafs में अपने KIFF खाते से साइन इन करते हैं। फ़ोन या टैबलेट पर ऐप आपका सत्र डिवाइस की Keychain में (Android पर उसके एन्क्रिप्टेड स्टोरेज में) रखता है। कंप्यूटर पर वह उसे आपके उपयोगकर्ता खाते के लिए सील करके रखता है: Windows PC पर Windows की अपनी डेटा सुरक्षा से, Linux पर आपकी कीरिंग में, Mac पर उसकी Keychain में। कंप्यूटर का सत्र 90 दिनों तक चलता है।</li>
					<li><strong>आपका डिवाइस:</strong> ऐप एक साइनिंग कुंजी बनाता है जो डिवाइस से कभी बाहर नहीं जाती: iPhone, iPad या Mac के Secure Enclave में, Android डिवाइस के Keystore में, या Windows PC के TPM में। Linux पर, और Secure Enclave के बिना Mac पर, कुंजी एक सॉफ़्टवेयर कुंजी है जो आपकी कीरिंग या Keychain में रहती है, और वह कंप्यूटर आपके लिए क्या इंतज़ार कर रहा है यह दिखा सकता है पर उसे मंज़ूर नहीं कर सकता; आप अपने फ़ोन पर मंज़ूर करते हैं{ macSecurityKey("hi") }। TPM के बिना Windows PC tafs में साइन इन नहीं कर सकता। KIFF कुंजी का सार्वजनिक आधा हिस्सा, डिवाइस का नाम और प्लेटफ़ॉर्म, और यह कि वह कब जोड़ा गया और आखिरी बार कब उपयोग हुआ, रखता है, ताकि रोकी गई कॉल पर आपके उत्तर और कनेक्शनों की आपकी मंज़ूरियाँ जाँच सके।</li>
					<li><strong>आपकी घड़ी:</strong> घड़ी में कोई पासवर्ड या कुंजी नहीं होती, वह केवल आपके जोड़े गए फ़ोन से बात करती है, और कभी मंज़ूर नहीं करती। आप Coach या अपने चुने taf से जो कहते हैं, वह AI की अनुमति देने के बाद, फ़ोन के ज़रिए, केवल टेक्स्ट के रूप में भेजती है। घड़ी की अपनी बोली सेवा, Apple की या Google की, आपके शब्दों को उस टेक्स्ट में बदलती है। Wear OS पर, यदि आपके पूरा करने से पहले वह रुक जाए, तो आपके फ़ोन की अपनी पहचान सेवा यह काम फ़ोन पर ही करती है। वह अस्वीकार करने, रोकने या Coach या taf को भेजने का काम केवल तब कर सकती है जब उसमें स्क्रीन लॉक या पासकोड हो और वह अनलॉक हो। आप taf को जो भेजते हैं वह उस taf की अपनी चैट में जाता है, मानो आपने उसे अपने फ़ोन पर लिखा हो। किसी taf की चैट, रकम सहित, हर बार खुलने पर फ़ोन के ज़रिए पढ़ी जाती है, और घड़ी केवल वे हाल के संदेश रखती है जिनका वर्णन नीचे उसके अपने हिस्से में है। ऐप बंद होने पर, आपका फ़ोन नए जवाब और संदेश सिस्टम के अपने फ़ोन-से-घड़ी लिंक के ज़रिए घड़ी तक पहुँचाता है (Apple Watch पर Apple का, Wear OS पर Google Play सेवाओं का), जो उन्हें फ़ोन और घड़ी पर केवल तब तक रखता है जब तक घड़ी उन्हें ले न ले; आपके फ़ोन को जगाने वाले पुश में कोई शब्द नहीं होते। जब आप घड़ी नहीं देख रहे होते तब आने वाला जवाब एक सूचना के रूप में भी दिखता है, आपके iPhone और Apple Watch पर या आपकी Wear OS घड़ी पर, अपने शब्दों के साथ लेकिन कभी कोई रकम नहीं, और तब तक रहता है जब तक आप उसे हटा न दें; लॉक की गई Wear OS घड़ी केवल यह दिखाती है कि जवाब तैयार है।</li>
					<li><strong>Apple Watch:</strong> वह आपके tafs और उनके पृष्ठ बिना रखे दिखाती है। वह आपका Inbox रखती है, एक ऐसी फ़ाइल में जिसे लॉक रहते वह पढ़ नहीं सकती: हर रोकी गई कॉल taf के नाम और वह क्या माँगता है के रूप में, कभी कोई रकम नहीं, और घड़ी से आपके भेजे पर Coach के उत्तर, टेक्स्ट के रूप में। यदि आप घड़ी पर साइन आउट करते हैं, तो वह यह भी रखती है कि आपने किया, जब तक आप घड़ी पर फिर साइन इन न करें। इसके अलावा, घड़ी में पासकोड न हो तो वह कुछ नहीं रखती। Inbox तब चला जाता है जब आप घड़ी पर साइन आउट करते हैं या आपका iPhone साइन आउट होता है, या ऐप अगली बार बिना पासकोड के खुलता या बंद होता है। वह कोई रिकॉर्डिंग नहीं करती, और वह जो सूचनाएँ दिखाती है वे केवल आपके iPhone की होती हैं। ताकि बातचीत तुरंत खुले, वह उस पर खोली गई अधिकतम 20 बातचीतों में से हर एक के आख़िरी 30 संदेश भी रखती है, Coach के और आपके tafs के, केवल पाठ के रूप में और कभी कोई रकम नहीं, Inbox की तरह लॉक; वे Inbox के साथ हट जाते हैं, और तब जब कोई बातचीत 30 दिन तक नहीं खोली गई हो। यदि आप Coach के लिए कोई संदेश बाद के लिए रखते हैं, तो वह उस एक संदेश को भी पाठ के रूप में इनबॉक्स की तरह लॉक की गई अपनी अलग फ़ाइल में रखती है, और आपका iPhone वापस आने पर उसे भेजती है। भेजे जाने पर, आपके हटाने पर, आपके या आपके iPhone के साइन आउट करने पर, या घड़ी में पासकोड न रहने पर वह हटा दिया जाता है।</li>
					<li><strong>Wear OS:</strong> वह आपके खाते का ईमेल और आज का कैलेंडर बिना रखे दिखाती है। तुरंत खुलने के लिए वह एन्क्रिप्टेड रूप में आपके लिए इंतज़ार करने वाली चीज़ों की गिनती, और हर taf का नाम और वह रुका या थमा हुआ है या नहीं रखती: कभी कोई रकम, रोकी गई कॉल का विवरण या taf की चैट नहीं। यह तब साफ़ हो जाता है जब आप साइन आउट करते हैं, जब घड़ी लॉक होती है या कलाई से उतरती है, और 24 घंटे बाद। वह आपका Inbox रखती है, जिसमें हर पंक्ति taf का नाम और वह जो कहता है है, कभी कोई रकम नहीं, और बाद के लिए रखा एक संदेश, टेक्स्ट के रूप में। घड़ी या फ़ोन पर साइन आउट करने से यह सब साफ़ हो जाता है। अपनी टाइल के लिए वह आपके लिए इंतज़ार करने वाली चीज़ों की गिनती भी रखती है, जो केवल घड़ी के अनलॉक रहते दिखती है, और जब आप साइन आउट करते हैं, या अगली बार टाइल घड़ी के लॉक या बिना स्क्रीन लॉक के रहते दिखती है, तब साफ़ हो जाती है। घड़ी पर साइन आउट के बाद वह इसका नोट रखती है कि आपने किया, जब तक आप फिर साइन इन न करें। Inbox भी तब चला जाता है जब ऐप अगली बार घड़ी के लॉक या बिना स्क्रीन लॉक के रहते खुलता या बंद होता है। बाद के लिए रखा संदेश तब तक रहता है जब तक आप उसे भेजें या हटाएँ, क्योंकि आपने उसे भेजने को कहा था। यदि घड़ी की बोली सेवा आपके पूरा करने से पहले रुक जाए, तो घड़ी रिकॉर्डिंग आपके फ़ोन को भेजती है, जो उसे फ़ोन पर ही टेक्स्ट में बदलता है, कभी किसी सर्वर पर नहीं। टेक्स्ट वापस आने या आपके रद्द करने पर, और अधिकतम 2 मिनट बाद, रिकॉर्डिंग दोनों जगह मिटा दी जाती है। केवल टेक्स्ट आगे Coach या आपके taf तक जाता है। taf का नतीजा घड़ी की सूचनाओं में तब तक रह सकता है जब तक आप उसे खारिज न करें या घड़ी पर साइन आउट न करें। ताकि बातचीत तुरंत खुले, वह उस पर खोली गई अधिकतम 20 बातचीतों में से हर एक के आख़िरी 30 संदेश भी रखती है, Coach के और आपके tafs के, केवल पाठ के रूप में और कभी कोई रकम नहीं, एन्क्रिप्ट करके; आप घड़ी या फ़ोन पर साइन आउट करें तो, और कोई बातचीत 30 दिन तक न खोली जाए तो, वे हट जाते हैं, और बिना स्क्रीन लॉक वाली घड़ी इनमें से कुछ नहीं रखती। बाद के लिए रखा संदेश भी हट जाता है, अगर घड़ी में अब स्क्रीन लॉक न हो।</li>
					<li><strong>Passkey:</strong> जब आप अपने कंप्यूटर पर passkey से मंज़ूर करते हैं, जैसे Windows Hello या सुरक्षा कुंजी, तो आपका चेहरा, फ़िंगरप्रिंट या PIN कंप्यूटर के अपने सिस्टम में रहता है। KIFF passkey की सार्वजनिक कुंजी, उसकी id, एक काउंटर और एक नाम रखता है, कभी कुछ गोपनीय नहीं, और दूसरे डिवाइस पर सिंक होने वाली passkey को अस्वीकार करता है।</li>
					<li><strong>अलर्ट:</strong> फ़ोन, टैबलेट या iPad ऐप चलाने वाले Mac पर, जब आप उन्हें चालू करते हैं, तो हम डिवाइस का push टोकन आपकी KIFF व्यक्ति id के साथ, और ऐप ने जो भाषा दिखाई वह रखते हैं। अलर्ट Apple या Google से होकर केवल यह बताकर जाता है कि कौन सा taf और वह क्या चाहता है, और किसी द्वार के अलर्ट में लिखने वाले का नाम या ईमेल पता: कभी कोई रकम या अनुरोध का विवरण नहीं। ऐप ये बातें डिवाइस पर ही, KIFF से, जोड़ता है, इसलिए अनलॉक फ़ोन का अलर्ट रकम, व्यापारी या व्यक्ति दिखा सकता है। लॉक Android फ़ोन पर वह केवल "किसी taf को आपकी ज़रूरत है" दिखाता है, और लॉक iPhone पर भी, जब तक आपने उसके पूर्वावलोकन हमेशा दिखाने पर न रखे हों। Windows PC, Linux कंप्यूटर या macOS 12 ऐप वाले Mac पर अलर्ट ऐप खुद चलते हुए बनाता है, बिना push टोकन के और किसी और कंपनी के ज़रिए नहीं। Windows और Linux पर वे दिखाते हैं कि कौन सा taf, वह क्या करना चाहता है, रकम, क्यों और कब तक; macOS 12 ऐप पर, आपके उन्हें चालू करने के बाद, वे कॉल के लिए KIFF के शब्द दिखाते हैं, और लॉक स्क्रीन वह दिखाती है जो Mac की पूर्वावलोकन सेटिंग अनुमति देती है। Windows पर वे आपके चालू करने तक बंद रहते हैं, और स्क्रीन लॉक होने पर केवल "किसी taf को आपकी ज़रूरत है" दिखाते हैं। स्क्रीन लॉक होने से पहले दिखाया गया अलर्ट अपना विवरण Windows की सूचना सूची में रखता है। Linux पर वे आपके बंद करने तक चालू रहते हैं, और लॉक स्क्रीन क्या दिखाती है वह आपके डेस्कटॉप पर निर्भर है। जो फ़ोन घड़ी तक अपडेट पहुँचाता है, वह अलर्ट बंद होने पर भी अपना push टोकन पंजीकृत रखता है, केवल इसलिए कि एक मौन push उसे जगाकर अपडेट घड़ी तक पहुँचा सके; उस push में कोई शब्द नहीं होते और वह कुछ नहीं दिखाता।</li>
					<li><strong>भाषा:</strong> tafs सेवा खाते की भाषा, जिसने आखिरी बार Coach से चैट की उसकी, तीन महीने तक रखती है, ताकि taf की रिपोर्ट उसी में आएँ।</li>
					<li><strong>आपके टूल:</strong> जब आप कोई टूल जोड़ते हैं, तो आप टूल के अपने प्रदाता पर साइन इन करते हैं। जिस ऐप में planque खुद साइन इन करता है, जैसे Stripe, या आपके दिए गए key के लिए, planque वह टोकन या key आपकी कंपनी के लिए एन्क्रिप्टेड रूप में रखता है। प्रबंधित कनेक्शन के लिए, planque की सहयोगी कनेक्शन सेवा Composio साइन-इन रखती है, और planque केवल कनेक्शन का रिकॉर्ड और आपके मंज़ूर किए टूल रखता है (देखें: <a href="#google">Google उपयोगकर्ता डेटा</a>)। कनेक्शन के रिकॉर्ड में वह खाता (उसका नाम या ईमेल) हो सकता है जिसमें वह साइन इन है, ताकि ऐप आपको दिखा सके कि वह कौन सा है। KIFF प्रबंधित कनेक्शनों का उपयोग केवल <a href="/subprocessors#composio">/subprocessors</a> पर बताए गए ऐप्स के लिए करता है।</li>
					<li><strong>आपका ब्राउज़र (Chrome):</strong> जब आप tafs एक्सटेंशन को अपने फ़ोन से जोड़ते हैं, तो taf आपके जोड़े गए Chrome प्रोफ़ाइल में काम कर सकता है, केवल उन साइटों पर जो उसके कनेक्शन में सूचीबद्ध हैं। वह अपने टैब एक ऐसे टैब समूह में खोलता है जिसे आप देख, रोक या बंद कर सकते हैं, और जब आप उनमें से किसी को छूते हैं तो वह रुक जाता है। एक्सटेंशन के साइड पैनल से आप जो taf शुरू करते हैं, वह इसके बजाय उस विंडो में उस टैब में काम करता है जिस पर आप हैं, यदि वह उसके कनेक्शन की किसी साइट पर है: टैब उसके समूह में जुड़ जाता है और उसके अपने टैब की तरह माना जाता है, और taf रुकने पर खुला रहता है। वह उस टैब से तभी जुड़ता है जब वही पेज उसे सबसे पहले चाहिए हो। वहाँ वह क्लिक कर सकता है और टाइप कर सकता है, केवल अपनी साइटों पर। उस टैब में वह पेज को वहीं पढ़ता है जहाँ वह है, और कोई भी दूसरा पेज अपने टैब में खोलता है; केवल वहाँ उसका उठाया कोई कदम, जैसे एक क्लिक, आपके टैब को आगे ले जा सकता है, और वह भी केवल उसकी साइटों के भीतर। वह उन पृष्ठों को टेक्स्ट और फ़ॉर्म फ़ील्ड के रूप में पढ़ता है, पासवर्ड, कार्ड और कोड फ़ील्ड हटाकर, कभी आपके अन्य टैब या अन्य साइटें नहीं। वह टेक्स्ट रन के हिस्से के रूप में हमारे AI प्रदाता को जाता है, और किसी टूल के नतीजे की तरह रन के साथ रखा जाता है। हर कदम साइट और फ़ील्ड के नाम के साथ Record में जाता है, गोपनीय फ़ील्ड में जो टाइप हुआ वह कभी नहीं। taf के हर बदलाव के लिए KIFF पृष्ठ को पहले और बाद में, उन फ़ील्ड हटाकर टेक्स्ट के रूप में, अधिकतम 30 दिन रखता है, और आपके डिस्कनेक्ट करने या खाता हटाने पर उससे पहले हटा देता है। इन पृष्ठों में दूसरों के विवरण हो सकते हैं, जैसे आपके ग्राहकों के; KIFF उन्हें आपके लिए प्रोसेसर के रूप में प्रोसेस करता है। एक्सटेंशन आपके कंप्यूटर पर सिर्फ़ अपनी कुंजी, KIFF के साथ अपना सत्र और उसमें शुरू हुई Coach चैट की सूची रखता है, आपके पासवर्ड कभी नहीं: साइन-इन पृष्ठ पर taf रुक जाता है और आपसे अपने टैब में खुद साइन इन करने को कहता है। आप एक्सटेंशन के साइड पैनल से Coach से भी बात कर सकते हैं। Coach पृष्ठ तभी पढ़ता है जब आप एक्सटेंशन में इसकी अनुमति दे चुके हों, एक अलग सहमति से जिसे आप वहीं वापस ले सकते हैं, और आप हमेशा पृष्ठ के बिना संदेश भेज सकते हैं। जब आप वहाँ से उसे संदेश भेजते हैं, तो सामने वाला पृष्ठ केवल अपने दिखने वाले पाठ के रूप में उस संदेश के साथ जाता है, आपका टाइप किया कुछ भी नहीं, बैंक, भुगतान, मेल या स्वास्थ्य साइट या Coach के लिए आपकी बंद की गई साइट को छोड़कर। फ़ील्ड के मान और पासवर्ड नहीं पढ़े जाते; कार्ड नंबर उनके आख़िरी चार अंकों तक काट दिए जाते हैं; कुंजियाँ और लेबल वाले गुप्त मान छिपा दिए जाते हैं। पेज के पाठ में अंग्रेज़ी, फ़्रेंच, स्पैनिश या जर्मन में एक बार के कोड के रूप में बताए गए कोड भी छिपा दिए जाते हैं। यह केवल उसी संदेश के लिए हमारे AI प्रदाता को जाता है; tafs पृष्ठ को केवल उत्तर पूरा होने तक रखता है, और साइट का नाम आपकी चैट के साथ “पढ़ रहा है:” के रूप में 30 दिन रखता है। Coach का उत्तर पृष्ठ से उद्धरण दे सकता है और किसी भी उत्तर की तरह आपकी चैट के साथ रखा जाता है। वहाँ किसी taf को भेजे गए संदेश के लिए भी यही बात है, उसी सहमति से, लेकिन केवल उस taf की अपनी किसी साइट पर: कहीं और कुछ नहीं पढ़ा जाता, उस बारी में taf केवल पढ़ता है, और उसके जवाब में पेज का उद्धरण हो सकता है। taf के मामले में, पेज का टेक्स्ट उसके रन के साथ केवल उस रन के खत्म होने तक रखा जाता है। साइड पैनल वे चैट दिखाता है जो उस Chrome को पेयर करने के बाद से उसमें शुरू हुई हैं; आपकी बाकी चैट आपके फ़ोन और आपके दूसरे डिवाइस पर रहती हैं। जब कोई taf आपके दूसरे डिवाइस से भेजे गए संदेश के लिए उस Chrome में काम करता है, तो पैनल वह रन भी दिखाता है: संदेश, उसके चरण और उसका जवाब, उस चैट का बाकी हिस्सा कभी नहीं, जब तक आप वह चैट नहीं हटाते, Chrome की पेयरिंग नहीं हटाते या taf को किसी दूसरे Chrome पर नहीं ले जाते। आप वहाँ संदेश के साथ फ़ाइलें भी जोड़ सकते हैं: tafs ऐप में जोड़ी गई फ़ाइलों की तरह, वे उस संदेश के साथ हमारे AI प्रदाता के पास जाती हैं और उसके साथ 30 दिन रखी जाती हैं, या चैट हटाए जाने पर उससे पहले (कोई संदेश जिस फ़ाइल का उपयोग नहीं करता, लगभग एक घंटा), और फ़ाइल केवल वही व्यक्ति खोल सकता है जिसने उसे जोड़ा। पेयरिंग हटाने या अनइंस्टॉल करने से वह सब मिट जाता है जो एक्सटेंशन रखता है। taf आपके फ़ोन पर आपकी मंज़ूरी के बिना कभी भुगतान नहीं करता। कार्रवाई वाले हर कदम (क्लिक, टाइपिंग, सबमिट) के लिए, आपके मंज़ूर किए कदम सहित, वह कार्रवाई से ठीक पहले लिए गए पृष्ठ का एक स्क्रीनशॉट रिकॉर्ड के लिए रखता है; केवल पढ़े जाने वाले पृष्ठ के लिए कभी नहीं, बैंक, वॉलेट, पासवर्ड मैनेजर, भुगतान, स्वास्थ्य या सरकारी साइट पर कभी नहीं, और पासवर्ड, कार्ड और कोड फ़ील्ड उसके लेने से पहले छिपा दिए जाते हैं। कार्ड नंबर या कुंजी जैसा दिखने वाला टेक्स्ट भी काला कर दिया जाता है, पर किसी और तरह से लिखी चीज़ फिर भी दिख सकती है। स्क्रीनशॉट एन्क्रिप्टेड स्टोरेज में, उस कदम से जुड़े, 30 दिन रखे जाते हैं, फिर अपने आप मिट जाते हैं, या आपके डिस्कनेक्ट करने, Chrome की पेयरिंग हटाने या खाता हटाने पर उससे पहले, और वे कभी हमारे AI प्रदाता के पास नहीं जाते। आप हर एक को taf की गतिविधि में उसके कदम के नीचे देखते हैं।</li>
					<li><strong>आपके taf का काम:</strong> हर taf की रन, चैट, रिपोर्ट, मेमोरी नोट और उनकी सौंपी फ़ाइलें, प्रोसेसर के रूप में रखी जाती हैं। आपके खाते का हर व्यक्ति आपके taf की सौंपी फ़ाइलें देख सकता है।</li>
					<li><strong>द्वार:</strong> जब आप कोई द्वार खोलते हैं ताकि लोग ईमेल, Slack या Telegram से किसी taf को लिख सकें, तो tafs सेवा आपके जोड़े हर प्रेषक को उसके ईमेल पते, Slack सदस्य ID या Telegram उपयोगकर्ता ID (WhatsApp द्वार के लिए फ़ोन नंबर) से, आपके दिए नाम के साथ, तब तक रखती है जब तक आप द्वार या taf हटा नहीं देते। जिसे आपने नहीं जोड़ा, उसका संदेश दस्तक के रूप में, किसने लिखा और उसमें क्या है इसके साथ, आख़िरी दस्तक के बाद 30 दिन तक आपका इंतज़ार करता है। जोड़े गए प्रेषक का संदेश taf की चैट में जाता है और बाकी चैट की तरह रखा जाता है। Slack और Telegram संदेशों को अपनी शर्तों पर पहुँचाते हैं।</li>
					<li><strong>खरीदारी:</strong> Solo और क्रेडिट पैक Apple द्वारा App Store के ज़रिए, या Google द्वारा Google Play की बिलिंग से बेचे जाते हैं। वे हमें बताते हैं कि क्या खरीदा गया, किस KIFF खाते के लिए (एक यादृच्छिक id), कब, और उनके लेन-देन या ऑर्डर संदर्भ। वे हमें आपकी Apple ID या Google खाता, नाम, ईमेल पता या कार्ड नहीं देते।</li>
				</ul>
				<p>ऐप में कोई एनालिटिक्स या विज्ञापन ट्रैकर नहीं हैं।</p>
			</section>
			<section id="ai">
				<h2>5. tafs में AI</h2>
				<p>tafs, Coach और आपके tafs के लिए Anthropic के Claude AI का उपयोग करता है। इसे हमारे लिए Anthropic या हमारे सबप्रोसेसर पेज पर दिए क्लाउड प्रदाताओं में से कोई एक चलाता है। वह पेज बताता है कि कौन और कहाँ। उसे कुछ भी जाने से पहले ऐप आपसे पूछता है।</p>
				<ul>
					<li>उसे क्या भेजा जाता है: आप Coach और अपने tafs को जो लिखते हैं, आपकी जोड़ी फ़ाइलें, काम करते समय आपके जुड़े ऐप्स taf को जो लौटाते हैं, और ऐप में Coach आपकी मदद करते समय आपकी स्क्रीन पर क्या है।</li>
					<li>Chrome से: सामने वाला पृष्ठ, जब आप एक्सटेंशन के साइड पैनल में Coach को लिखते हैं, जब आप वहाँ Coach को पृष्ठ पढ़ने की अनुमति दे चुके हों। वहाँ अपनी किसी साइट पर मौजूद किसी taf को लिखने पर भी।</li>
					<li>जो कभी नहीं भेजा जाता: आपके जुड़े ऐप्स के उपयोग किए पासवर्ड और कुंजियाँ, या आपका फ़िंगरप्रिंट।</li>
					<li>इसे चलाने वाली कंपनी इसका उपयोग जवाब देने के लिए करती है और इसे 30 दिनों के भीतर मिटा देती है, जब तक कि इसे उस कंपनी के उपयोग नियमों के उल्लंघन के रूप में चिह्नित न किया जाए या कानून इसे रखने को न कहे।</li>
					<li>आपके अनुमति देने तक कुछ नहीं भेजा जाता। आप खाता में वापस ले सकते हैं।</li>
				</ul>
				<p>जब आप वापस लेते हैं, तो Coach और आपके tafs आपको उत्तर देना बंद कर देते हैं, और जिस taf की रन आपकी सहमति पर टिकी हैं वह थम जाता है। आपने किस बात पर सहमति दी, यह दिखाने के लिए tafs आपकी दी गई या वापस ली गई हर सहमति का रिकॉर्ड, कब और उसके शब्दों के किस संस्करण के साथ, उसके आख़िरी बदलाव से 10 साल तक रखता है; आपका खाता हटाने पर वह पहले ही हट जाता है। विवरण <a href="/hi/privacy#ai-in-tafs">KIFF की गोपनीयता नीति</a> में हैं।</p>
			</section>
			@tafsPrivacyGoogleHI()
			<section id="sharing">
				<h2>7. डेटा और किसे मिलता है</h2>
				<p>हम आपका व्यक्तिगत डेटा नहीं बेचते, और विज्ञापन के लिए साझा नहीं करते।</p>
				<p>tafs के लिए हम इन कंपनियों का उपयोग करते हैं: Amazon Web Services (होस्टिंग, जिसमें tafs का स्टोर और planque के कनेक्शन शामिल हैं), Clerk (KIFF खातों के लिए साइन-इन), Anthropic (AI मॉडल, जिसे Anthropic, Amazon Web Services, Google Cloud या Microsoft Azure चलाता है), Composio (प्रबंधित कनेक्शनों के साइन-इन, और वे कॉल जो planque उससे करवाता है), Apple (push अलर्ट), Google (Android पर push अलर्ट, और Google Play की बिलिंग), और Resend (taf का ईमेल द्वार)। आधिकारिक, मौजूदा सूची, हर एक क्या छूता है और कहाँ के साथ, <a href="/subprocessors">/subprocessors</a> (अंग्रेज़ी में) पर है।</p>
				<p>उनमें से कुछ यूरोपीय आर्थिक क्षेत्र से बाहर हैं, ज़्यादातर संयुक्त राज्य अमेरिका में। उन हस्तांतरणों की सुरक्षा कैसे की जाती है, यह <a href="/hi/privacy#transfers">KIFF की गोपनीयता नीति</a> बताती है।</p>
				<p><strong>आपका देश।</strong> कुछ देशों के कानून इस नीति से अधिक माँगते हैं। वे जो जोड़ते हैं, अंग्रेज़ी में और उस देश की भाषा में, <a href="/privacy/countries">आपका देश</a> (अंग्रेज़ी में) पर है।</p>
			</section>
			<section id="retention">
				<h2>8. हम इसे कितने समय रखते हैं</h2>
				<ul>
					<li>आपके टूल taf को जो लौटाते हैं: केवल रन खत्म होने तक। चैट में, जो उसने केवल पढ़ा वह उसके अगले संदेशों के लिए एन्क्रिप्टेड रूप में रखा जाता है, चैट के एक घंटे निष्क्रिय रहने तक और पढ़ने के बाद अधिकतम चार घंटे तक उपयोग होता है, फिर कुछ दिनों के भीतर अपने आप मिटा दिया जाता है।</li>
					<li>taf की रन और चैट, चैट के सारांश के साथ: 30 दिन। उसके मेमोरी नोट: taf के हटाए जाने तक। आप Coach के साथ अपनी कोई चैट पहले भी हटा सकते हैं: उसके संदेश और आपकी जोड़ी फ़ाइलें तुरंत हट जाती हैं, जबकि उसकी हर रन हुई, कब हुई और कितना खर्च हुआ, इसका रिकॉर्ड उन 30 दिनों तक रहता है। अगर आप किसी जवाब की रिपोर्ट करते हैं, तो KIFF वह जवाब, आपका कारण और आपका नोट 180 दिन रखता है, या तब तक जब तक आप वह चैट या अपना खाता नहीं हटाते। KIFF उन्हें रिपोर्ट पढ़ने वाली टीम को ईमेल भी करता है, जहाँ वह ईमेल KIFF के सहायता मेल की तरह रखा जाता है।</li>
					<li>Coach के अगले उत्तर के लिए छोटे नोट, जैसे चैट में कनेक्शन क्यों नहीं बन सका, या Card मंज़ूर हुआ: उस उत्तर के उन्हें लेने तक, अधिकतम 7 दिन; उसके बाद, उस चैट के हिस्से के रूप में, जब तक चैट रखी जाती है। दोबारा भेजे संदेश को वही नोट मिले, इसलिए एक प्रति 24 घंटे रखी जाती है। चैट का नोट केवल उसी चैट में उपयोग होता है।</li>
					<li>चैट में आपकी जोड़ी फ़ाइलें: जिस संदेश से जुड़ी हैं उसके साथ, 30 दिन, या चैट हटने पर उससे पहले, और हर हाल में 38 दिन के भीतर। जिस फ़ाइल को कोई संदेश उपयोग नहीं करता वह अपलोड के लगभग एक घंटे बाद हटा दी जाती है। खाता हटाने से वे मिट जाती हैं।</li>
					<li>आपके tafs की सौंपी फ़ाइलें: रन द्वारा बनाए जाने से 30 दिन, फिर एक दिन के भीतर अपने आप मिटा दी जाती हैं। आपके खाते का कोई भी व्यक्ति उसे अभी हटाएँ से पहले हटा सकता है: फ़ाइल खुद तुरंत चली जाती है, कोई प्रति नहीं रखी जाती; उसका नाम, आकार और उसे बनाने वाला taf और रन tafs के स्टोर की एन्क्रिप्टेड पॉइंट-इन-टाइम प्रतियों में 35 दिन तक रह सकते हैं, केवल विफलता के बाद उसे बहाल करने के लिए उपयोग होते हैं। taf हटाने या आपका खाता हटाने से उसकी फ़ाइलें मिट जाती हैं। फ़ाइल साझा करने से फ़ाइल खुद भेजी जाती है, और आपकी साझा की हुई प्रति उस ऐप के पास रहती है जिसे आपने भेजी। फ़ाइल डाउनलोड करने के लिए हम आपके खाते के साइन-इन सदस्य के लिए एक लिंक बनाते हैं जो एक मिनट बाद काम करना बंद कर देता है; उसका कोई और लिंक नहीं बनाते।</li>
					<li>planque के हर कॉल के रिकॉर्ड में टूल ने जो लौटाया: 24 घंटे। उसके बाद रिकॉर्ड केवल यह रखता है कि कॉल भेजी गई या नहीं, ताकि वह कभी दो बार न भेजी जाए।</li>
					<li>planque में कनेक्शन का टोकन या key, या Composio पर प्रबंधित कनेक्शन का साइन-इन: आपके डिस्कनेक्ट करने तक। यदि आपका कोई और कनेक्शन उस विक्रेता पर वही खाता उपयोग कर सकता हो, तो वह, अनुपयोगी, तब तक रखा जाता है जब तक वह भी डिस्कनेक्ट न हो जाए, फिर रद्द कर दिया जाता है। उसकी मंज़ूरियों का रिकॉर्ड: खाता समाप्त होने तक।</li>
					<li>डिवाइस का push टोकन: आपके ऐप से साइन आउट करने, डिवाइस हटाने, या Apple या Google के टोकन के चले जाने की सूचना देने तक। डिवाइस की सार्वजनिक कुंजी, नाम, प्लेटफ़ॉर्म और तारीखें: जब तक आप उसका उपयोग करते हैं; उसे साइन आउट करने के बाद वह हटाया हुआ चिह्नित होता है और खाता हटने तक रखा जाता है, ताकि KIFF उससे देर से आया उत्तर अस्वीकार कर सके और दिखा सके कि पहले वाले पर किस डिवाइस ने हस्ताक्षर किए थे। Passkey की सार्वजनिक कुंजी, id और नाम: उसके डिवाइस की तरह। कंप्यूटर का सत्र: 90 दिन तक, या आपके साइन आउट करने तक।</li>
					<li>आपका खाता: उसके हटाए जाने तक। सेवा लॉग: 30 दिन। tafs और planque के स्टोर एन्क्रिप्टेड पॉइंट-इन-टाइम प्रतियाँ 35 दिन रखते हैं, केवल विफलता के बाद स्टोर बहाल करने के लिए उपयोग होती हैं।</li>
				</ul>
				<p>बाकी सब कुछ <a href="/hi/privacy#retention">KIFF के प्रतिधारण अनुभाग</a> में है।</p>
			</section>
			<section id="lawful-bases">
				<h2>9. वैध आधार</h2>
				<p>अनुबंध का निष्पादन, आपके खाते और आपके tafs को चलाने के लिए। वैध हित, सुरक्षा, धोखाधड़ी रोकने और दुरुपयोग पहचानने के लिए। सहमति, tafs में AI के लिए (<a href="#ai">खंड 5</a>)। कानूनी बाध्यता, कर रिकॉर्ड के लिए। विवरण <a href="/hi/privacy#lawful-bases">KIFF की गोपनीयता नीति</a> में हैं।</p>
			</section>
			<section id="rights">
				<h2>10. आपके अधिकार</h2>
				<p>GDPR के तहत आप अपने डेटा तक पहुँच, उसके सुधार, मिटाने, प्रतिबंध या पोर्टेबल प्रति का अनुरोध कर सकते हैं, वैध हितों पर आधारित प्रोसेसिंग पर आपत्ति कर सकते हैं, और सहमति वापस ले सकते हैं। <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> पर ईमेल करें; हम बिना अनुचित देरी के और ज़्यादा से ज़्यादा एक महीने के भीतर उत्तर देते हैं; जटिल अनुरोध में हमें दो महीने और लग सकते हैं, और यह हम आपको पहले महीने के भीतर बता देते हैं। ऐप में, खाता → मेरी चैट निर्यात करें आपकी अपनी चैट और नोट डाउनलोड करता है।</p>
				<p>अपना tafs खाता हटाने के लिए ऐप खोलें, खाता पर जाएँ और <em>खाता हटाएँ</em> पर टैप करें, फिर पुष्टि करें। इसे पलटा नहीं जा सकता। क्या और कब हटाया जाता है, और ईमेल से कैसे अनुरोध करें, यह <a href="/hi/privacy#delete-account">KIFF की गोपनीयता नीति</a> बताती है।</p>
				<p>आप <a href="https://www.aki.ee/en" target="_blank" rel="noopener">एस्टोनियाई डेटा संरक्षण निरीक्षणालय (Andmekaitse Inspektsioon)</a> से, या अपने निवास स्थान के पर्यवेक्षी प्राधिकरण से शिकायत कर सकते हैं।</p>
				<p><strong>आपका देश।</strong> कुछ देशों के कानून इस नीति से अधिक माँगते हैं। वे जो जोड़ते हैं, अंग्रेज़ी में और उस देश की भाषा में, <a href="/privacy/countries">आपका देश</a> (अंग्रेज़ी में) पर है।</p>
			</section>
			<section id="more">
				<h2>11. सुरक्षा, बच्चे और बदलाव</h2>
				<p>हमारे सुरक्षा उपाय <a href="/security">/security</a> (अंग्रेज़ी में) पर हैं। tafs बच्चों के लिए नहीं है, और हम जानबूझकर 16 वर्ष से कम आयु के बच्चों से व्यक्तिगत डेटा एकत्र नहीं करते। हम इस नीति को उसी तरह बदलते हैं जैसा <a href="/hi/privacy#changes">KIFF की गोपनीयता नीति</a> अपने लिए कहती है।</p>
			</section>
			<section id="contact">
				<h2>12. संपर्क</h2>
				<p>गोपनीयता संबंधी प्रश्न और अनुरोध: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>। औपचारिक कानूनी सूचनाएँ: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>। ऐप की अपनी शर्तें <a href="/hi/tafs/terms">/tafs/terms</a> पर हैं।</p>
			</section>
		</article>
	}
}

// tafsPrivacyGoogleHI is what tafs does with the data it receives from Google,
// for Google's review of tafs's sign-in, with the Limited Use statement in
// Google's own words.
templ tafsPrivacyGoogleHI() {
	<section id="google">
		<h2>6. Google उपयोगकर्ता डेटा</h2>
		if len(googleManaged()) == 0 && len(googleInHouse("hi")) > 0 {
			<p>जब आप कहते हैं, तो tafs किसी taf को आपके Google खाते से जोड़ता है, जैसे उसके काम में उपयोग होने वाले Google Sheets या Google Calendar से, ऐप के Connect apps में। यह खंड बताता है कि tafs उस डेटा के साथ क्या करता है जो उसे Google से मिलता है।</p>
		} else {
			<p>जब आप कहते हैं, तो tafs किसी taf को आपके Google खाते से जोड़ता है, जैसे आपके Gmail से, या उसके काम में उपयोग होने वाले Google Calendar या Google Sheets से, ऐप के Connect apps में। यह खंड बताता है कि tafs उस डेटा के साथ क्या करता है जो उसे Google से मिलता है।</p>
		}
		<ul>
			if len(googleManaged()) == 0 && len(googleInHouse("hi")) > 0 {
				<li><strong>वह क्या पढ़ता और लिखता है:</strong> जो taf के काम के लिए चाहिए: जो स्प्रेडशीट वह अपडेट रखता है, या जिन कैलेंडरों की वह देखभाल करता है उनके इवेंट। वह उन्हें केवल वहीं बदलता है जहाँ taf का Card अनुमति देता है, और Card की सीमाओं से ऊपर कुछ भी आपकी मंज़ूरी का इंतज़ार करता है।</li>
			} else {
				<li><strong>वह क्या पढ़ता और लिखता है:</strong> जो taf के काम के लिए चाहिए। आपके Gmail में वह उन संदेशों और थ्रेड को पढ़ता है जिनका उत्तर चाहिए, और ड्राफ़्ट लिखता है; वह मेल केवल वहीं भेजता है जहाँ taf का Card अनुमति देता है। Google Calendar और Google Sheets में वह जिन कैलेंडरों की देखभाल करता है उनके इवेंट, या जो स्प्रेडशीट अपडेट रखता है उन्हें पढ़ता है, और उन्हें केवल वहीं बदलता है जहाँ taf का Card अनुमति देता है।
					if googleListed("Google Tasks") {
						Google Tasks में वह जिन कार्य सूचियों की देखभाल करता है उन्हें पढ़ता है, और कार्य केवल वहीं जोड़ता, पूरे करता, हटाता या स्थानांतरित करता है जहाँ taf का Card अनुमति देता है।
					}
					Card की सीमाओं से ऊपर कुछ भी आपकी मंज़ूरी का इंतज़ार करता है।</li>
			}
			<li><strong>क्यों:</strong> केवल उस taf के लिए आपके तय किए काम को करने के लिए, और आपको यह दिखाने के लिए कि वह किस Google खाते से जुड़ा है: उसका ईमेल पता, जो कनेक्शन के साथ आपके डिस्कनेक्ट करने तक रखा जाता है।</li>
			if len(googleManaged()) > 0 || len(googleInHouse("hi")) > 0 {
				<li>
					<strong>हर Google ऐप कैसे जुड़ता है:</strong>
					<ul>
						if len(googleManaged()) > 0 {
							<li>हमारे साइन-इन सहयोगी के ज़रिए, जो <a href="/subprocessors">/subprocessors</a> (अंग्रेज़ी में) पर सूचीबद्ध है: { appList(googleManaged()) }.</li>
						}
						if len(googleInHouse("hi")) > 0 {
							<li>tafs के अपने Google साइन-इन के ज़रिए, बीच में किसी और कंपनी के बिना: { appList(googleInHouseNames()) }.</li>
						}
					</ul>
					if googleBoth() {
						जो ऐप दोनों के अंतर्गत नामित है, वह आपके खाते के आधार पर एक या दूसरे तरीके से जुड़ता है। Google का अपना साइन-इन पृष्ठ दिखाता है कि आप किसे अनुमति दे रहे हैं।
					}
				</li>
			}
			if googleBoth() {
				<li>
					<strong>आप क्या अनुमति देते हैं:</strong> आप Google के अपने पृष्ठ पर साइन इन करते हैं और चुनते हैं कि क्या अनुमति दें।
					<ul>
						<li><strong>हमारे साइन-इन सहयोगी के ज़रिए:</strong> tafs केवल वही पहुँच माँगता है जो taf के टूल को चाहिए। यदि वह संकरी पहुँच संभव नहीं है, तो वह ऐप की सामान्य पहुँच माँगता है, और साइन इन से पहले यह बताता है। यदि सामान्य पहुँच में ऐसा व्यक्तिगत डेटा आएगा जो taf उपयोग नहीं करता, तो tafs नहीं जोड़ता।</li>
						<li><strong>tafs के अपने Google साइन-इन के ज़रिए:</strong> साइन-इन उस ऐप के लिए नीचे सूचीबद्ध सारी पहुँच एक साथ माँगता है, भले taf केवल पढ़ता हो।</li>
					</ul>
				</li>
			} else if len(googleInHouse("hi")) > 0 {
				<li><strong>आप क्या अनुमति देते हैं:</strong> आप Google के अपने पृष्ठ पर साइन इन करते हैं और चुनते हैं कि क्या अनुमति दें। साइन-इन उस ऐप के लिए नीचे सूचीबद्ध सारी पहुँच एक साथ माँगता है, भले taf केवल पढ़ता हो।</li>
			} else {
