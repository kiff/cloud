package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// SubprocessorsFR is the list of subprocessors (/subprocessors) in
// French, at /fr/subprocessors. It is a translation of Subprocessors:
// the same sections, anchors, links and figures, held to it by
// TestTranslationsKeepTheEnglishPage. The English page governs. Change
// the English page first, then this one.
templ SubprocessorsFR() {
	@components.LayoutSite("KIFF — sous-traitants ultérieurs", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@subprocessorsHeadFR()
			@subprocessorsListFR()
			@subprocessorsNotListedFR()
			@subprocessorsChangesFR()
		</article>
	}
}

templ subprocessorsHeadFR() {
	<header class="legal-head">
		<p class="legal-badge">Sous-traitants ultérieurs · v0.1</p>
		<h1>Sous-traitants ultérieurs</h1>
		<p class="legal-meta">
			<strong>Dernière mise à jour :</strong> 25 novembre 2026.
		</p>
		<p class="legal-disclaimer">
			Les sociétés auxquelles Kiff Agents OÜ fait appel pour
			faire fonctionner KIFF Cloud et tafs, et qui traitent des
			données personnelles pour son compte. Cette liste est la
			liste officielle. L'<a href="/fr/legal/dpa">accord de
			traitement des données (DPA)</a> régit la façon dont nous
			faisons appel à elles. Questions :
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</header>
}

templ subprocessorsListFR() {
	<section id="list">
		<h2>1. La liste</h2>
		<div class="legal-table" tabindex="0">
			<table>
				<thead>
					<tr>
						<th>Sous-traitant ultérieur</th>
						<th>Ce qu'il fait pour KIFF</th>
						<th>Données concernées</th>
						<th>Lieu</th>
					</tr>
				</thead>
				<tbody>
					<tr id="aws">
						<td>Amazon Web Services</td>
						<td>Hébergement : les serveurs, la base de données et ses sauvegardes, la gestion des clés, les secrets et la supervision. Pour tafs, son propre stockage et les connexions de planque</td>
						<td>Tout ce que KIFF conserve : les comptes et les personnes qui se connectent, les Cards, les décisions, les reçus, les journaux. Pour tafs, les exécutions, les chats, les notes de mémoire et les jetons de connexion (chiffrés) et, une fois les captures d'écran de Chrome activées, l'image prise avant une étape de Chrome, scellée et conservée 30 jours au plus</td>
						<td>Irlande (eu-west-1) : KIFF Cloud, le service tafs, les exécutions, les chats et les appels de modèle de tafs, et planque, avec tout ce qu'ils stockent. L'Irlande sert aussi les démos publiques de KIFF et les vidéos du site. La seule chose située aux États-Unis (us-east-1), ce sont les certificats que CloudFront exige là-bas, et ils ne contiennent aucune donnée de client</td>
					</tr>
					<tr id="clerk">
						<td>Clerk</td>
						<td>Identité : la connexion et les sessions des comptes KIFF</td>
						<td>L'adresse e-mail et le nom des personnes qui se connectent, leurs sessions, leur adresse IP, leur appareil et leur navigateur, et l'identité fournie par Apple, Google ou GitHub quand quelqu'un se connecte avec l'un d'eux</td>
						<td>États-Unis</td>
					</tr>
					<tr id="stripe">
						<td>Stripe</td>
						<td>Paiement : le paiement en ligne, les factures et le portail de facturation d'un forfait payant</td>
						<td>Le contact de facturation et les informations de paiement saisies sur la page de paiement de Stripe, et les relevés d'utilisation transmis pour la facturation</td>
						<td>UE et États-Unis</td>
					</tr>
					<tr id="resend">
						<td>Resend</td>
						<td>E-mail : les notifications d'appel retenu et d'avertissement de Card, les notifications d'utilisation et de compte, le code de connexion, les notifications de nouvel appareil, les notifications d'activation ou de désactivation de la connexion par code, la réponse à un code demandé quand elle est désactivée, les e-mails d'appartenance comme les invitations et les réponses de l'assistance. Pour tafs, la porte e-mail d'un taf : les messages que des personnes lui envoient, et ses réponses</td>
						<td>L'adresse e-mail du destinataire et la notification. Une notification d'appel retenu nomme l'agent, l'action, son montant et la Card dont elle sort. Un e-mail de code de connexion contient le code, l'heure, le navigateur et le pays d'où il a été demandé ; une notification de nouvel appareil nomme l'appareil, son navigateur, le mode de connexion, l'heure et une estimation de la ville et du pays ; une notification d'activation ou de désactivation indique que le réglage a été activé ou désactivé, et quand ; un code demandé quand le réglage est désactivé reçoit un e-mail qui donne l'heure, le navigateur et le pays d'où il a été demandé ; un e-mail d'appartenance, comme une invitation, nomme le compte et le rôle, et la personne qui a invité seulement comme administrateur ; une notification de nouvel approbateur ou de téléphone relié de nouveau nomme l'appareil. Pour une porte e-mail, les messages, leurs expéditeurs et leurs pièces jointes</td>
						<td>États-Unis</td>
					</tr>
					<tr id="cloudflare">
						<td>Cloudflare</td>
						<td>E-mail : reçoit les messages envoyés aux adresses kiff.dev, comme les demandes d'assistance et de confidentialité, et les transfère vers les boîtes de l'équipe (Email Routing)</td>
						<td>Les messages envoyés aux adresses kiff.dev : expéditeur, destinataires, objet, corps et pièces jointes</td>
						<td>États-Unis, sur le réseau mondial de Cloudflare</td>
					</tr>
					<tr id="google-workspace">
						<td>Google Workspace</td>
						<td>E-mail : les boîtes de l'équipe, où arrivent les messages envoyés aux adresses kiff.dev une fois transférés par Cloudflare, dont les demandes d'assistance et de confidentialité</td>
						<td>Les messages envoyés aux adresses kiff.dev : expéditeur, destinataires, objet, corps et pièces jointes</td>
						<td>États-Unis, et les autres pays où Google conserve les données de Workspace</td>
					</tr>
					<tr id="composio">
						<td>Composio</td>
						<td>Pour tafs, via planque : détient les identifiants des connexions gérées (les services qu'un client connecte par sa page de connexion) et le bot Slack derrière une porte Slack, et effectue chaque appel que planque demande.
							@composioUse("fr")
						</td>
						<td>Les identifiants des services connectés (jetons ou clés), détenus par Composio et jamais remis à un taf ni à planque ; les données d'entrée de chaque appel et la réponse du service ; les messages d'une porte Slack</td>
						<td>États-Unis</td>
					</tr>
					<tr id="apple">
						<td>Apple</td>
						<td>Les notifications push vers les appareils enregistrés dans l'app tafs (Apple Push Notification service) : les appels retenus, les messages d'une porte, et une app qui a déconnecté un taf</td>
						<td>Le jeton push de l'appareil et le texte de l'alerte : quel taf, et, dans l'alerte d'une porte, le nom ou l'adresse e-mail de la personne qui a écrit. Ni montants ni détails de la demande</td>
						<td>États-Unis</td>
					</tr>
					<tr id="google">
						<td>Google</td>
						<td>L'app tafs sur Android : les notifications push vers les appareils enregistrés pour les alertes (Firebase Cloud Messaging), et les achats via la facturation de Google Play</td>
						<td>Le jeton push de l'appareil et le texte de l'alerte : quel taf, et, dans l'alerte d'une porte, le nom ou l'adresse e-mail de la personne qui a écrit, sans montants ni détails de la demande ; pour un achat, ce qui a été acheté, l'identifiant aléatoire du compte, le jeton de l'achat et l'identifiant de la commande</td>
						<td>États-Unis</td>
					</tr>
					<tr id="anthropic">
						<td>Anthropic</td>
						<td>Modèles d'IA : le modèle derrière Coach et chaque taf (Claude API). Pas utilisé actuellement. tafs uniquement</td>
						<td>Ce qui lui est envoyé : ce que vous écrivez à Coach et à vos tafs, les fichiers que vous joignez, ce que vos apps connectées renvoient à un taf pendant qu'il travaille, et ce qui est à l'écran quand Coach vous aide dans l'app ; et la réponse du modèle. Jamais envoyé : les mots de passe et clés qu'utilisent vos apps connectées, ni votre empreinte. Envoyé seulement une fois que vous l'autorisez dans l'app tafs (voir <a href="/fr/privacy#ai-in-tafs">Confidentialité</a>). Anthropic le garde jusqu'à 30 jours, plus longtemps seulement si la loi, sa politique d'utilisation ou ses conditions l'exigent</td>
						<td>États-Unis, appelé depuis l'Irlande (eu-west-1) ; l'inférence peut s'exécuter aux États-Unis, en Europe, en Asie ou en Australie</td>
					</tr>
					<tr id="bedrock">
						<td>Amazon Web Services (Amazon Bedrock)</td>
						<td>Modèles d'IA : le même modèle Claude, exécuté via Amazon Bedrock. Utilisé actuellement. tafs uniquement</td>
						<td>Ce qui lui est envoyé : comme dans la ligne d'Anthropic, et seulement tant qu'il est le fournisseur utilisé. AWS ne s'en sert pas pour entraîner des modèles. Dans le mode de conservation par défaut de Bedrock, certains modèles le gardent jusqu'à 30 jours pour la confiance et la sécurité</td>
						<td>Union européenne : appelé depuis l'Irlande (eu-west-1), uniquement via les profils d'inférence interrégionaux UE de Bedrock, qui s'exécutent dans des régions de l'UE</td>
					</tr>
					<tr id="vertex">
						<td>Google Cloud (Vertex AI)</td>
						<td>Modèles d'IA : le même modèle Claude, exécuté via Vertex AI. Pas utilisé actuellement ; peut l'exécuter à la place d'Anthropic, un seul fournisseur à la fois. tafs uniquement</td>
						<td>Ce qui lui est envoyé : comme dans la ligne d'Anthropic, et seulement tant qu'il est le fournisseur utilisé. Pour certains modèles d'Anthropic, Google le garde jusqu'à 30 jours pour la surveillance des abus et le partage avec Anthropic à cette fin</td>
						<td>Union européenne : uniquement un point de terminaison régional europe-west, jamais le point de terminaison mondial de Google</td>
					</tr>
					<tr id="foundry">
						<td>Microsoft Azure (AI Foundry)</td>
						<td>Modèles d'IA : le même modèle Claude, via Azure AI Foundry, hébergé sur Azure. Pas utilisé actuellement ; peut l'exécuter à la place d'Anthropic, un seul fournisseur à la fois. tafs uniquement</td>
						<td>Ce qui lui est envoyé : comme dans la ligne d'Anthropic, et seulement tant qu'il est le fournisseur utilisé. Microsoft gère le point de terminaison ; Anthropic traite ce qui est envoyé, selon ses propres conditions, comme dans la ligne d'Anthropic</td>
						<td>Union européenne : uniquement un déploiement hébergé sur Azure dans la zone de données UE</td>
					</tr>
				</tbody>
			</table>
		</div>
		@composioApps("fr")
		<p>
			Lorsqu'un sous-traitant ultérieur se trouve hors de
			l'Espace économique européen, le transfert repose sur le
			cadre de protection des données UE–États-Unis ou sur les
			clauses contractuelles types, comme le prévoit le § 11 du
			<a href="/fr/legal/dpa#transfers">DPA</a>.
		</p>
	</section>
}

templ subprocessorsNotListedFR() {
	<section id="not-listed">
		<h2>2. Qui n'est pas sur la liste</h2>
		<ul>
			<li>
				<strong>Vos propres apps.</strong> Quand KIFF envoie
				l'appel d'un agent à une app que vous avez connectée,
				comme votre système de paiement ou d'assistance, cette
				app travaille pour vous, pas pour nous. Son fournisseur
				est votre prestataire.
			</li>
			<li>
				<strong>La piste publique vérifiable.</strong> Seules
				des empreintes de synthèse y sont publiées.
				Elle ne reçoit aucune donnée personnelle.
			</li>
		</ul>
	</section>
}

templ subprocessorsChangesFR() {
	<section id="changes">
		<h2>3. Modifications</h2>
		<p>
			Avant d'ajouter ou de remplacer un sous-traitant ultérieur
			qui traite vos données personnelles, nous vous prévenons au
			moins trente jours à l'avance, et vous pouvez vous y
			opposer, comme le prévoit le § 10 du
			<a href="/fr/legal/dpa#sub-processors">DPA</a>. Nous
			mettons cette page à jour dans les 30 jours suivant toute
			modification.
		</p>

		<hr/>

		<p class="legal-footnote">
			<strong>Version du document :</strong> v0.1.<br/>
			<strong>Dernière mise à jour :</strong> 25 novembre 2026.
		</p>
	</section>
}
