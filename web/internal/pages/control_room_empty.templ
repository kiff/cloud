package pages

// ControlRoomEmptyState is a first-class launch state, not a fallback. It never
// renders a synthetic proof-run: the buyer-facing Control Room shows only real
// evidence — or an honest preview of what real traffic will
// fill. The way to see a decision is a card's real
// test request (the first-decision design, as amended for the card-first journey).
templ ControlRoomEmptyState(v DashboardControlsView) {
	if len(v.Controls) == 0 {
		<section class="dash-card cr-card cr-empty">
			<p class="eyebrow">Setup</p>
			<h2>No governed actions yet</h2>
			<p class="dash-note">Draft a domain in Build, review the action to govern, and activate it.</p>
			<div class="cr-preview" aria-label="Setup steps">
				<div class="cr-preview-step"><b>Choose action</b><span>Pick the action to govern.</span></div>
				<div class="cr-preview-step"><b>Install guard</b><span>Your runtime calls KIFF before the action runs.</span></div>
				<div class="cr-preview-step"><b>Start observe</b><span>Record real traffic without blocking it.</span></div>
				<div class="cr-preview-step"><b>Review evidence</b><span>Counts and rows come from your own runtime.</span></div>
			</div>
			<div class="dash-plan-actions">
				<a class="btn btn-primary" href="/dashboard/build">Open Build</a>
			</div>
		</section>
	} else {
		<section class="dash-card cr-card cr-empty">
			<p class="eyebrow">No real traffic yet</p>
			<h2>This control is ready</h2>
			<p class="dash-note">Decisions show here once your runtime sends real calls. To see one now, send a test request from a Card.</p>
			<div class="cr-preview" aria-label="What live traffic will fill">
				<div class="cr-preview-step"><b>Decisions</b><span>Allowed, blocked, and held counts over the selected window.</span></div>
				<div class="cr-preview-step"><b>Receipts</b><span>Signed receipts for this control's decisions.</span></div>
				<div class="cr-preview-step"><b>Approvals</b><span>Who reviewed, and the outcome.</span></div>
				<div class="cr-preview-step"><b>Alerts</b><span>Each delivery, with the decision that triggered it.</span></div>
			</div>
			<div class="dash-plan-actions">
				<a class="btn btn-primary" href="/cards">Test a card</a>
			</div>
		</section>
	}
}
