package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsPrivacyMN is tafs's privacy policy (/tafs/privacy) in Mongolian, at /mn/tafs/privacy.
// It is a translation of TafsPrivacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Mongolian has the legal
// texts only, so a link to any other page goes to English and says so.
templ TafsPrivacyMN() {
	@components.LayoutSiteWithMeta("tafs-ийн нууцлалын бодлого", "KIFF-ийн апп tafs хувийн мэдээллийг хэрхэн боловсруулдаг, түүний дотор таныг Google бүртгэлээ холбоход Google-ээс авдаг мэдээллийг.", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · нууцлалын бодлого</p>
				<h1>tafs-ийн нууцлалын бодлого</h1>
				<p class="legal-meta"><strong>Сүүлд шинэчилсэн:</strong> 2026 оны арваннэгдүгээр сарын 25.</p>
				<p class="legal-disclaimer">Энэ бодлого нь KIFF-ийн iPhone, iPad, Android болон компьютерт зориулсан апп tafs хувийн мэдээллийг хэрхэн боловсруулдгийг тайлбарлана. tafs нь KIFF Cloud-ын нэг хэсэг тул <a href="/mn/privacy">KIFF-ийн Нууцлалын бодлого</a> түүнд мөн хамаарах бөгөөд энэ хуудас хамрахгүй бүхэнд хамаарна. Асуулт: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.</p>
			</header>
			<section id="who-we-are">
				<h2>1. Бид хэн бэ</h2>
				<p>tafs-ийг Эстонид байгуулагдсан хувийн хязгаарлагдмал хариуцлагатай компани <strong>Kiff Agents OÜ</strong> (бүртгэлийн код 17372313, НӨАТ-ын дугаар EE102924327) үзүүлдэг, хаяг: Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Эстони. Манай боловсруулалтад ЕХ-ны Хувийн мэдээлэл хамгаалах ерөнхий журам (GDPR) хамаарна.</p>
			</section>
			<section id="scope">
				<h2>2. Энэ бодлого юуг хамарна</h2>
				<p>iPhone, iPad, Android болон компьютерт (Mac, Windows, Linux) зориулсан tafs апп болон түүний цаадах үйлчилгээ, түүний дотор компанийн хэрэгслүүдийг холбодог Setup, тэдгээр холболтыг хадгалдаг planque. tafs-д компани ажлыг KIFF Card-уудын хүрээнд ажилладаг AI агент буюу taf-д даалгадаг.</p>
			</section>
			<section id="roles">
				<h2>3. Бидний үүрэг</h2>
				<p>Бид таны бүртгэл болон нэвтрэх мэдээллийн, мөн өөрийн үйлчилгээний үйл ажиллагааны өгөгдлийн <strong>хянагч</strong> юм. Бид tafs таны компанид хадгалдаг зүйлийн хувьд таны компанийн нэрийн өмнөөс <strong>боловсруулагч</strong> байдлаар ажиллана: taf бүрийн ажиллалт, чат, тайлан, санах ойн тэмдэглэл болон тэдний хүргэсэн файлууд. Эдгээр өгөгдлийн хянагч нь таны компани бөгөөд тэр харилцааг <a href="/legal/dpa">Өгөгдөл боловсруулах гэрээ (DPA)</a> (англиар) зохицуулна.</p>
			</section>
			<section id="data">
				<h2>4. tafs юу цуглуулдаг</h2>
				<ul>
					<li><strong>Таны бүртгэл:</strong> та tafs-д KIFF бүртгэлээрээ нэвтэрнэ. Утас эсвэл таблет дээр апп таны сессийг төхөөрөмжийн Keychain-д (Android дээр шифрлэгдсэн хадгалалтад) хадгална. Компьютер дээр тэр нь таны хэрэглэгчийн бүртгэлд битүүмжлэгдэн хадгалагдана: Windows компьютер дээр Windows-ийн өөрийн өгөгдөл хамгаалалтаар, Linux дээр таны keyring-д, Mac дээр түүний Keychain-д. Компьютерийн сесс 90 хоног хүртэл үргэлжилнэ.</li>
					<li><strong>Таны төхөөрөмж:</strong> апп төхөөрөмжөөс хэзээ ч гардаггүй гарын үсгийн түлхүүр үүсгэнэ: iPhone, iPad эсвэл Mac-ийн Secure Enclave-д, Android төхөөрөмжийн Keystore-д, эсвэл Windows компьютерийн TPM-д. Linux дээр, мөн Secure Enclave-гүй Mac дээр түлхүүр нь таны keyring эсвэл Keychain-д хадгалагдсан программ хангамжийн түлхүүр бөгөөд тэр компьютер таныг хүлээж буй зүйлийг харуулж чадах боловч зөвшөөрч чадахгүй; та утсан дээрээ зөвшөөрнө{ macSecurityKey("mn") }. TPM-гүй Windows компьютер tafs-д нэвтэрч чадахгүй. KIFF түлхүүрийн нийтийн хагас, төхөөрөмжийн нэр болон платформ, нэмэгдсэн ба сүүлд ашиглагдсан цагийг хадгалдаг тул таны баригдсан дуудлагад өгсөн хариулт болон холболтуудад өгсөн зөвшөөрлийг шалгаж чадна.</li>
					<li><strong>Таны цаг:</strong> цаг нууц үг эсвэл түлхүүр хадгалдаггүй, зөвхөн хослуулсан утастайгаа харилцдаг бөгөөд хэзээ ч зөвшөөрдөггүй. Та AI-д зөвшөөрсний дараа цаг таны Coach эсвэл сонгосон taf-д хэлснийг зөвхөн текст хэлбэрээр утсаар дамжуулан илгээнэ. Цагийн өөрийн ярианы үйлчилгээ, Apple-ийнх эсвэл Google-ийнх, таны үгийг тэр текст болгон хөрвүүлнэ. Wear OS дээр та дуусгахаас өмнө зогсвол таны утасны өөрийн таних систем утсан дээр түүнийг орлож хийнэ. Тэр нь дэлгэцийн түгжээ эсвэл нууц код байгаа бөгөөд түгжээ тайлагдсан үед л татгалзах, зогсоох, Coach эсвэл taf руу илгээх боломжтой. Таны taf-д илгээсэн зүйл тэр taf-ын өөрийн чат руу орно, та утсан дээрээ бичсэн мэт. Taf-ын чатыг, дүнгийн хамт, нээх бүрд утсаар дамжуулан уншдаг бөгөөд цаг доорх өөрийн хэсэгт тайлбарласан сүүлийн мессежүүдийг л хадгална. Аппууд хаалттай үед таны утас шинэ хариулт, мессежийг системийн өөрийн утас-цагны холболтоор (Apple Watch дээр Apple-ийн, Wear OS дээр Google Play үйлчилгээний) цаг руу дамжуулдаг бөгөөд тэр холболт тэдгээрийг цаг хүлээж авах хүртэл л утас болон цаг дээр хадгална; таны утсыг сэрээх мэдэгдэлд ямар ч үг байхгүй. Таныг цаг руу харахгүй байх үед ирсэн хариулт нь мөн мэдэгдэл болж таны iPhone болон Apple Watch эсвэл Wear OS цаг дээр үгтэйгээ, гэхдээ хэзээ ч дүнгүйгээр харагдах бөгөөд та арилгах хүртэл үлдэнэ; түгжигдсэн Wear OS цаг зөвхөн хариулт бэлэн болсныг харуулна.</li>
					<li><strong>Apple Watch:</strong> таны taf-ууд болон тэдний хуудсыг хадгалахгүйгээр харуулна. Түгжээтэй үед уншиж чадахгүй файлд таны Ирсэн хайрцгийг хадгална: баригдсан дуудлага бүрийг тэр taf-ын нэр болон юу асуудгаар нь, хэзээ ч дүн биш, мөн цагаас илгээсэн зүйлд Coach-ийн хариуг текстээр. Хэрэв та цаг дээр гарвал цаг дээр дахин нэвтрэх хүртэл тэр нь та гарсныг мөн хадгална. Үүнээс гадна цагт нууц код байхгүй бол юу ч хадгалахгүй. Та цаг дээр гарах эсвэл iPhone-оос чинь гарах үед, эсвэл апп нууц кодгүйгээр дараагийн удаа нээгдэх эсвэл хаагдах үед Ирсэн хайрцаг устана. Тэр бичлэг хийдэггүй бөгөөд түүний харуулдаг цорын ганц мэдэгдэл бол таны iPhone-ынх. Яриа шууд нээгдэхийн тулд түүн дээр нээсэн 20 хүртэлх яриа тус бүрийн сүүлийн 30 мессежийг ч, Coach болон таны tafs-ынхыг, зөвхөн текст хэлбэрээр, хэзээ ч дүнгүйгээр, Ирсэн хайрцаг шиг түгжээтэй хадгална; Ирсэн хайрцаг устахад болон яриаг 30 хоног нээгээгүй үед эдгээр устана. Coach-д илгээх мессежийг дараа илгээхээр хадгалвал тэр нэг мессежийг ч мөн текстээр, Ирсэн хайрцагтай адил түгжигдсэн тусдаа файлд хадгалж, таны iPhone эргэж холбогдоход илгээнэ. Илгээгдсэний дараа, та устгахад, та эсвэл таны iPhone гарахад, эсвэл цагт нууц код байхгүй болоход устгагдана.</li>
					<li><strong>Wear OS:</strong> таны бүртгэлийн имэйл болон өнөөдрийн хуанлийг хадгалахгүйгээр харуулна. Тэр нэн даруй нээгдэхийн тулд таныг хүлээж буй зүйлийн тоог, мөн taf бүрийн нэр, зогссон эсвэл түр зогссон эсэхийг шифрлэгдсэн байдлаар хадгална: хэзээ ч дүн, баригдсан дуудлагын дэлгэрэнгүй эсвэл taf-ын чат биш. Та гарах, цаг түгжигдэх эсвэл бугуйгаас салах үед, мөн 24 цагийн дараа энэ нь цэвэрлэгдэнэ. Тэр таны Ирсэн хайрцгийг хадгална, түүн дэх мөр бүр taf-ын нэр болон юу хэлснийг, хэзээ ч дүн биш, мөн дараа илгээхээр хадгалсан нэг мессежийг текстээр. Цаг дээр эсвэл утсан дээр гарах нь бүгдийг цэвэрлэнэ. Өөрийн хавтан (tile)-д зориулж тэр таныг хүлээж буй зүйлийн тоог мөн хадгална, цагийн түгжээ тайлагдсан үед л харуулж, та гарах үед, эсвэл хавтан цагийн түгжээтэй эсвэл дэлгэцийн түгжээгүй үед дараагийн удаа харагдахад цэвэрлэгдэнэ. Цаг дээр гарсны дараа та дахин нэвтрэх хүртэл гарсныг тэмдэглэж хадгална. Цаг түгжээтэй эсвэл дэлгэцийн түгжээгүй үед апп дараагийн удаа нээгдэх эсвэл хаагдах үед Ирсэн хайрцаг мөн устана. Дараа илгээхээр хадгалсан мессеж таныг илгээх эсвэл устгах хүртэл үлдэнэ, учир нь та түүнийг илгээхийг хүссэн. Хэрэв цагийн ярианы үйлчилгээ та дуусгахаас өмнө зогсвол цаг бичлэгийг утас руу чинь илгээх бөгөөд утас түүнийг сервер дээр биш, утсан дээрээ текст болгоно. Текст буцаж ирсний дараа эсвэл та цуцалсны дараа бичлэг хоёулангаас нь устах бөгөөд хамгийн ихдээ 2 минутын дараа. Зөвхөн текст Coach эсвэл таны taf руу цааш явна. Taf-ын үр дүн цаг дээр гарах эсвэл та үүнийг хаах хүртэл цагийн мэдэгдэлд үлдэж болно. Яриа шууд нээгдэхийн тулд түүн дээр нээсэн 20 хүртэлх яриа тус бүрийн сүүлийн 30 мессежийг ч, Coach болон таны tafs-ынхыг, зөвхөн текст хэлбэрээр, хэзээ ч дүнгүйгээр, шифрлэн хадгална; цаг эсвэл утсан дээр гарахад болон яриаг 30 хоног нээгээгүй үед эдгээр устах ба дэлгэцийн түгжээгүй цаг нэгийг ч хадгалахгүй. Дараа илгээхээр хадгалсан мессеж нь цагт дэлгэцийн түгжээ байхгүй болоход мөн устгагдана.</li>
					<li><strong>Passkey-ууд:</strong> та компьютер дээрээ passkey-ээр зөвшөөрөхөд, жишээлбэл Windows Hello эсвэл аюулгүй байдлын түлхүүр, таны нүүр, хурууны хээ эсвэл PIN компьютерийн өөрийн системд үлдэнэ. KIFF passkey-ийн нийтийн түлхүүр, түүний id, тоолуур болон нэрийг хадгалдаг, хэзээ ч нууц зүйл биш, мөн бусад төхөөрөмжтэй синк хийдэг passkey-г татгалздаг.</li>
					<li><strong>Мэдэгдэл:</strong> утас, таблет эсвэл iPad апп ажиллуулдаг Mac дээр та тэдгээрийг асаахад бид төхөөрөмжийн push токеныг таны KIFF хүний id болон апп харуулсан хэлтэй хамт хадгална. Мэдэгдэл Apple эсвэл Google-ээр зөвхөн аль taf, юу хүсч байгаагаар, мөн хаалганы мэдэгдэлд бичсэн хүний нэр эсвэл имэйл хаягаар дамжина: хэзээ ч дүн эсвэл хүсэлтийн дэлгэрэнгүй биш. Апп тэдгээрийг төхөөрөмж дээр өөрөө KIFF-ээс нэмдэг тул түгжээ тайлагдсан утасны мэдэгдэл дүн, худалдагч эсвэл хүнийг харуулж болно. Түгжээтэй Android утсан дээр зөвхөн "Taf таныг хэрэгтэй байна" харуулна, түгжээтэй iPhone дээр ч мөн, таныг урьдчилан харахыг үргэлж харуулахаар тохируулаагүй бол. Windows компьютер, Linux компьютер эсвэл macOS 12 апптай Mac дээр мэдэгдлийг апп өөрөө ажиллаж байх үедээ үүсгэнэ, push токенгүйгээр, өөр ямар ч компаниар дамжихгүйгээр. Windows болон Linux дээр аль taf, юу хийхийг хүсч байгаа, дүн, яагаад, хэзээ хүртэл гэдгийг харуулна; macOS 12 апп дээр та асаасны дараа дуудлагын тухай KIFF-ийн үгсийг харуулах бөгөөд түгжээтэй дэлгэц Mac-ийн урьдчилан харах тохиргоо зөвшөөрснийг харуулна. Windows дээр та асаах хүртэл унтраалттай, дэлгэц түгжээтэй үед зөвхөн "Taf таныг хэрэгтэй байна" харуулна. Дэлгэц түгжигдэхээс өмнө харагдсан нэг нь Windows-ийн мэдэгдлийн жагсаалтад дэлгэрэнгүйгээ хадгална. Linux дээр та унтраах хүртэл асаалттай, түгжээтэй дэлгэц юу харуулах нь таны ширээний орчноос хамаарна. Цаг руу шинэчлэлт дамжуулдаг утас мэдэгдэл унтраастай байсан ч push токеноо бүртгэлтэй хэвээр хадгална. Энэ нь зөвхөн чимээгүй push утсыг сэрээж, шинэчлэлтийг цаг руу дамжуулахын тулд юм; тэр push ямар ч үг агуулахгүй, юу ч харуулахгүй.</li>
					<li><strong>Хэл:</strong> tafs үйлчилгээ бүртгэлийн хэлийг, Coach-той хамгийн сүүлд чатласан хүнээс, гурван сар хүртэл хадгална, taf-ын тайлан тэр хэлээр ирэхийн тулд.</li>
					<li><strong>Таны хэрэгслүүд:</strong> хэрэгсэл холбохдоо та хэрэгслийн өөрийн үйлчилгээ үзүүлэгчид нэвтэрнэ. planque өөрөө нэвтэрдэг апп, жишээлбэл Stripe, эсвэл таны өгсөн түлхүүрийн хувьд planque тэр токен эсвэл түлхүүрийг таны компанид шифрлэгдсэн байдлаар хадгална. Удирдагдсан холболтын хувьд planque-ийн хамтран ажилладаг холболтын үйлчилгээ Composio нэвтрэлтийг хадгалах бөгөөд planque зөвхөн холболтын бүртгэл болон таны зөвшөөрсөн хэрэгслүүдийг хадгална (<a href="#google">Google хэрэглэгчийн өгөгдөл</a>-ийг үзнэ үү). Холболтын бүртгэлд нэвтэрсэн бүртгэл (түүний нэр эсвэл имэйл) багтаж болох бөгөөд ингэснээр апп аль нь болохыг танд харуулж чадна. KIFF удирдагдсан холболтыг зөвхөн <a href="/subprocessors#composio">/subprocessors</a> (англиар)-д нэрлэсэн аппуудад ашигладаг.</li>
					<li><strong>Таны хөтөч (Chrome):</strong> та tafs өргөтгөлийг утастайгаа хослуулахад taf таны хослуулсан Chrome профайл дотор, зөвхөн холболтод нь жагсаасан сайтууд дээр ажиллаж чадна. Энэ нь өөрийн табуудыг таны харж, түр зогсоож, зогсоож болох табын бүлэгт нээх бөгөөд та тэдгээрийн аль нэгэнд хүрэхэд түр зогсоно. Өргөтгөлийн хажуугийн самбараас эхлүүлсэн taf тухайн цонхонд таны байгаа таб түүний холболтын сайтуудын нэг дээр байвал оронд нь тэр табад ажиллана: таб түүний бүлэгт нэгдэж, өөрийнх нь таб гэж тооцогдох бөгөөд taf зогсоход нээлттэй үлдэнэ. Тэр хуудас түүнд хэрэгтэй эхний хуудас байх үед л тэр табад нэгддэг. Тэнд зөвхөн өөрийн сайтууд дээр товшиж, бичиж чадна. Тэр табад хуудсыг байгаа газарт нь уншиж, бусад хуудсыг өөрийн табад нээдэг; таны табыг зөвхөн тэнд хийсэн алхам нь, жишээ нь товшилт, шилжүүлж болох бөгөөд зөвхөн түүний сайтуудын дотор. Эдгээр хуудсыг нууц үг, карт, кодын талбаруудыг хасаад текст ба маягтын талбар болгон уншина, таны бусад таб эсвэл бусад сайтыг хэзээ ч уншихгүй. Тэр текст ажиллагааны нэг хэсэг болгон манай хиймэл оюун ухаан үйлчилгээ үзүүлэгчид очиж, ямар ч хэрэгслийн үр дүн шиг ажиллагаатай хамт хадгалагдана. Алхам бүр Бүртгэлд сайт болон талбарын нэртэй орох бөгөөд нууц талбарт юу бичсэнийг хэзээ ч оруулахгүй. taf-ын хийсэн өөрчлөлт бүрт KIFF өмнөх болон дараах хуудсыг эдгээр талбарыг хассан текстээр хамгийн ихдээ 30 хоног хадгалж, таныг салгах эсвэл бүртгэлээ устгах үед түүнээс өмнө устгана. Эдгээр хуудас бусдын мэдээлэл, жишээлбэл таны үйлчлүүлэгчдийн мэдээллийг харуулж болно; KIFF тэдгээрийг танд зориулан боловсруулагчийн хувиар боловсруулна. Өргөтгөл таны компьютерт өөрийн түлхүүр, KIFF дахь сешн болон түүнд эхэлсэн Coach-ийн чатуудын жагсаалтыг хадгална, таны нууц үгийг хэзээ ч үгүй: нэвтрэх хуудсан дээр taf зогсож, таныг өөрийн табад өөрөө нэвтрэхийг хүснэ. Та өргөтгөлийн хажуугийн самбараас Coach-тай ярилцаж бас болно. Coach хуудсыг зөвхөн та өргөтгөлд зөвшөөрсний дараа уншина, тэнд цуцалж болох тусдаа зөвшөөрлөөр, мөн та хэзээ ч хуудасгүйгээр мессеж илгээж болно. Тэндээс түүнд мессеж илгээхэд өмнөх хуудасны зөвхөн харагдах текст тэр мессежтэй хамт явна, таны бичсэн зүйл хэзээ ч явахгүй; банк, төлбөр, шуудан эсвэл эрүүл мэндийн сайт, эсвэл таны Coach-д унтраасан сайтаас бусад тохиолдолд. Талбарын утга болон нууц үгийг уншдаггүй; картын дугаарыг сүүлийн дөрвөн оронтой болтол таслана; түлхүүр болон шошготой нууц мэдээллийг далдална. Хуудасны текстэд англи, франц, испани эсвэл герман хэлээр нэг удаагийн код гэж нэрлэсэн кодыг мөн далдална. Энэ нь зөвхөн тэр мессежийн тулд манай AI нийлүүлэгч рүү явна; tafs хуудсыг зөвхөн хариулт дуустал хадгалж, сайтын нэрийг таны чаттай хамт “Уншсан:” хэлбэрээр 30 хоног хадгална. Coach-ийн хариулт хуудаснаас иш татаж болох бөгөөд бусад хариулттай адил таны чаттай хамт хадгалагдана. Тэнд taf руу илгээх мессеж ч мөн адил, ижил зөвшөөрлөөр, гэхдээ зөвхөн тэр taf-ын өөрийн сайтуудын нэг дээр: бусад газарт юу ч уншихгүй, тэр ээлжинд taf зөвхөн уншдаг бөгөөд хариулт нь хуудаснаас эшлэл авч болно. Taf-ын хувьд хуудасны текстийг түүний ажиллагаатай хамт зөвхөн тэр ажиллагаа дуусах хүртэл хадгална. Хажуугийн самбар нь тухайн Chrome-ыг хослуулснаас хойш тэнд эхэлсэн чатыг харуулна; таны бусад чат утас болон бусад төхөөрөмж дээр тань үлдэнэ. Таны өөр төхөөрөмжөөс илгээсэн мессежийн төлөө taf тухайн Chrome-д ажиллавал самбар тэр ажиллагааг ч харуулна: мессеж, түүний алхмууд болон хариултыг, харин тэр чатын бусад хэсгийг хэзээ ч харуулахгүй, та тэр чатыг устгах, Chrome-ын хослолыг цуцлах эсвэл taf-ыг өөр Chrome руу шилжүүлэх хүртэл. Тэнд мессежид файл хавсаргаж бас болно: tafs аппад хавсаргасан файлын адил, тэдгээр нь тухайн мессежтэй хамт манай AI үйлчилгээ үзүүлэгч рүү очиж, түүнтэй хамт 30 хоног, чатыг устгавал түүнээс өмнө хадгалагдана (ямар ч мессеж ашиглаагүй файл ойролцоогоор нэг цаг), мөн файлыг зөвхөн хавсаргасан хүн нь нээж чадна. Мөн таны утастай хийсэн хослол, таны Coach-д унтраасан сайтууд болон энэ Chrome профайлын санамсаргүй танигчийг хадгална; энэ танигч таны утас энэ Chrome-ыг таних зорилгоор хослол бүрт KIFF рүү очно. Устгах нь бүгдийг устгана; хослолыг салгах нь энэ танигч болон Coach-д унтраасан сайтуудаас бусдыг устгана. Taf таны утсан дээрх зөвшөөрөлгүйгээр хэзээ ч төлбөр хийхгүй. Үйлдэл хийдэг алхам бүрт (дарах, бичих, илгээх), таны зөвшөөрсөн алхмыг оруулаад, тэр бүртгэлд зориулж үйлдлийн яг өмнө авсан хуудасны нэг дэлгэцийн зургийг мөн хадгална; зөвхөн уншдаг хуудасны хувьд хэзээ ч, банк, түрийвч, нууц үгийн менежер, төлбөр, эрүүл мэнд, төрийн сайтууд дээр хэзээ ч хадгалахгүй, мөн авахын өмнө нууц үг, карт, кодын талбарыг нууна. Картын дугаар эсвэл түлхүүр шиг харагдах текстийг мөн хар болгоно, гэхдээ өөр байдлаар бичсэн зүйл харагдсаар байж болно. Дэлгэцийн зургийг тухайн алхамтай холбож, шифрлэсэн хадгалалтад 30 хоног хадгалж, дараа нь автоматаар устгана, эсвэл таныг холболтыг салгах, энэ Chrome-ын хослуулалтыг салгах эсвэл бүртгэлээ устгахад түүнээс өмнө устгана, мөн бидний хиймэл оюун ухааны үйлчилгээ үзүүлэгчид хэзээ ч очихгүй. Тус бүрийг tafын Үйл ажиллагаанд түүний алхмын доор харна. Хэрэв та хариултыг мэдээлбэл, KIFF тэр хариулт, таны шалтгаан болон тэмдэглэлийг 180 хоног, эсвэл та тэр чат буюу бүртгэлээ устгах хүртэл хадгална. KIFF эдгээрийг мэдээлэл уншдаг багт мөн имэйлээр илгээх бөгөөд тэр имэйлийг KIFF-ийн тусламжийн шуудантай адил хадгална. tafs банк, түрийвч, нууц үгийн менежер, төлбөр, шуудан, эрүүл мэнд, төрийн сайтуудыг жагсаалт болон хаягийнх нь үгсээр таньдаг тул таньж чадаагүй сайтыг бусадтай адил үзнэ.</li>
					if HostedBrowserForCustomers {
						<li><strong>{ hostedBrowserWords("mn").Label }</strong> { hostedBrowserWords("mn").Text }</li>
					}
					<li><strong>Таны taf-уудын ажил:</strong> taf бүрийн ажиллалт, чат, тайлан, санах ойн тэмдэглэл болон тэдний хүргэсэн файлууд, боловсруулагчийн хувиар хадгалагддаг. Таны бүртгэл дэх хүн бүр таны taf-уудын хүргэсэн файлыг харж болно.</li>
					<li><strong>Хаалганууд:</strong> хүмүүс taf руу и-мэйл, Slack эсвэл Telegram-аар бичих боломжтой болгохын тулд хаалга нээхэд tafs үйлчилгээ таны хослуулсан илгээгч бүрийг түүний и-мэйл хаяг, Slack гишүүний ID эсвэл Telegram хэрэглэгчийн ID-гаар (WhatsApp хаалганы хувьд утасны дугаараар), таны өгсөн нэрийн хамт, хаалга эсвэл taf-г устгах хүртэл хадгална. Таны хослуулаагүй хүний мессеж хэн бичсэн, юу гэснийх нь хамт тогшилт болж, сүүлчийнхээс хойш 30 хүртэл хоног таныг хүлээнэ. Хослуулсан илгээгчийн мессеж taf-ын чатад орж, чатын бусад хэсгийн адил хадгалагдана. Slack болон Telegram мессежийг өөрсдийн нөхцөлөөр дамжуулна.</li>
					<li><strong>Худалдан авалт:</strong> Solo болон кредитийн багцыг Apple App Store-оор, эсвэл Google Play-ийн төлбөрөөр зардаг. Тэд бидэнд юу худалдан авсан, аль KIFF бүртгэлд (санамсаргүй id), хэзээ, мөн тэдний гүйлгээ эсвэл захиалгын лавлагааг мэдэгддэг. Тэд бидэнд таны Apple ID эсвэл Google бүртгэл, нэр, имэйл хаяг эсвэл картыг өгдөггүй.</li>
				</ul>
				<p>Апп нь аналитик эсвэл сурталчилгааны хянагчгүй.</p>
			</section>
			<section id="ai">
				<h2>5. tafs дахь AI</h2>
				<p>tafs нь Coach болон таны taf-уудад Anthropic-ийн Claude AI-г ашигладаг. Үүнийг бидний өмнөөс Anthropic эсвэл манай туслан боловсруулагчдын хуудсанд байгаа үүлэн үйлчилгээ үзүүлэгчдийн аль нэг нь ажиллуулдаг. Аль нь, хаана болохыг тэр хуудас хэлдэг. Апп аливаа зүйл түүнд очихоос өмнө танаас асууна.</p>
				<ul>
					<li>Түүнд юу илгээгддэг: та Coach болон taf-уудадаа бичсэн зүйл, хавсаргасан файлууд, таны холбосон аппууд taf-д ажиллаж байх үед буцаасан зүйл, мөн Coach танд аппад тусалж байх үед таны дэлгэц дээр байгаа зүйл.</li>
					<li>Chrome-оос: өргөтгөлийн хажуугийн самбарт Coach-д бичихэд өмнөх хуудас, тэнд Coach-д хуудас унших зөвшөөрөл өгсний дараа. Тэнд өөрийн сайтуудын нэг дээрх taf руу бичих үед ч мөн адил.</li>
					<li>Юу хэзээ ч илгээгддэггүй: таны холбосон аппуудын ашигладаг нууц үг, түлхүүр, мөн таны хурууны хээ.</li>
					<li>Үүнийг ажиллуулж буй компани хариулахад ашиглаж, 30 хоногийн дотор устгадаг; хэрэв тэр компанийн ашиглалтын дүрмийг зөрчсөн гэж тэмдэглэгдсэн эсвэл хууль хадгалахыг шаардсан бол хамаарахгүй.</li>
					<li>Та зөвшөөрөх хүртэл юу ч илгээгддэггүй. Та Бүртгэл хэсэгт татгалзаж болно.</li>
				</ul>
				<p>Та татгалзвал Coach болон таны taf-ууд танд хариулахаа больж, ажиллалт нь таны зөвшөөрөл дээр тулгуурласан taf түр зогсоно. Та юунд зөвшөөрснөө харуулахын тулд tafs таны өгсөн эсвэл буцаасан зөвшөөрөл бүрийн бүртгэлийг, хэзээ, текстийн аль хувилбараар болохыг сүүлийн өөрчлөлтөөс хойш 10 жил хадгална; бүртгэлээ устгавал түүнээс өмнө устна. <a href="/mn/privacy#ai-in-tafs">KIFF-ийн Нууцлалын бодлого</a> дэлгэрэнгүйг агуулна.</p>
			</section>
			@tafsPrivacyGoogleMN()
			<section id="sharing">
				<h2>7. Өөр хэн өгөгдөл авдаг</h2>
				<p>Бид таны хувийн мэдээллийг зарахгүй, сурталчилгааны зорилгоор хуваалцахгүй.</p>
				<p>tafs-д бид эдгээр компаниудыг ашигладаг: Amazon Web Services (хостинг, tafs-ийн хадгалалт болон planque-ийн холболтыг оруулан), Clerk (KIFF бүртгэлийн нэвтрэлт), Anthropic (AI загвар, Anthropic, Amazon Web Services, Google Cloud эсвэл Microsoft Azure ажиллуулдаг), Composio (удирдагдсан холболтын нэвтрэлт болон planque-ийн түүнээс хийлгэдэг дуудлага), Apple (push мэдэгдэл), Google (Android дээрх push мэдэгдэл болон Google Play-ийн төлбөр), Resend (taf-ын имэйл хаалга). Албан ёсны, одоогийн жагсаалт, тус бүр юуг хөндөж, хаана гэсэн мэдээлэлтэй хамт <a href="/subprocessors">/subprocessors</a> (англиар)-д байна.</p>
				<p>Тэдний зарим нь Европын эдийн засгийн бүсээс гадна, голдуу АНУ-д байдаг. Тэдгээр шилжүүлгийг хэрхэн хамгаалдгийг <a href="/mn/privacy#transfers">KIFF-ийн Нууцлалын бодлого</a> хэлнэ.</p>
				<p><strong>Таны улс.</strong> Зарим улсын хууль энэ бодлогоос илүү зүйл шаарддаг. Тэдний нэмсэн зүйлийг англиар болон тухайн улсын хэлээр <a href="/privacy/countries">Таны улс</a> (англиар) хуудаснаас үзнэ үү.</p>
			</section>
			<section id="retention">
				<h2>8. Хэр удаан хадгалдаг</h2>
				<ul>
					<li>Таны хэрэгслүүд taf-д буцаасан зүйл: зөвхөн ажиллалт дуустал. Чатад зөвхөн уншсан зүйлийг дараагийн мессежүүдэд зориулан шифрлэж хадгалах бөгөөд чат нэг цаг идэвхгүй болтол, уншсанаас хойш хамгийн ихдээ дөрвөн цаг ашиглаад дараа нь хэдэн хоногийн дотор автоматаар устгана.</li>
					<li>Taf-ын ажиллалт, чат, чатын хураангуйгийн хамт: 30 хоног. Түүний санах ойн тэмдэглэл: taf устгагдтал. Та Coach-тай хийсэн өөрийн чатыг түүнээс өмнө устгаж болно: түүний мессеж болон таны нэмсэн файлууд шууд устгагдах бөгөөд түүний ажиллалт бүр болсон, хэзээ, ямар өртөгтэй болсон тухай бүртгэл тэр 30 хоногийн турш үлдэнэ.</li>
					<li>Coach-ийн дараагийн хариултад зориулсан товч тэмдэглэл, жишээлбэл чатад холболт яагаад хийгдэж чадаагүй, эсвэл Card зөвшөөрөгдсөн: тэр хариулт тэдгээрийг авах хүртэл, хамгийн ихдээ 7 хоног; дараа нь тэр чатын нэг хэсэг болгон чатыг хадгалах хугацаанд. Дахин илгээсэн мессеж ижил тэмдэглэл авахын тулд хуулбарыг 24 цаг хадгална. Чатын тэмдэглэлийг зөвхөн тэр чатад ашиглана.</li>
					<li>Чатад хавсаргасан файлууд: хавсаргасан мессежийн хамт 30 хоног, эсвэл чат устгагдвал түүнээс өмнө, ямар ч тохиолдолд 38 хоногийн дотор. Ямар ч мессеж ашигладаггүй файлыг таныг байршуулснаас хойш ойролцоогоор нэг цагийн дараа устгана. Бүртгэлээ устгах нь тэдгээрийг устгана.</li>
					<li>Таны taf-уудын хүргэсэн файлууд: ажиллалт тэдгээрийг үүсгэснээс хойш 30 хоног, дараа нь нэг өдрийн дотор автоматаар устгана. Таны бүртгэл дэх хэн ч түүнийг Одоо устгах-аар эрт устгаж болно: файл нь тэр дор нь алга болж, хуулбар хадгалагдахгүй; түүний нэр, хэмжээ, үүсгэсэн taf болон ажиллалт tafs-ийн хадгалалтын шифрлэгдсэн цаг хугацааны хуулбарт 35 хоног хүртэл үлдэж болох бөгөөд зөвхөн доголдлын дараа сэргээхэд ашиглагдана. Taf устгах эсвэл бүртгэлээ устгах нь түүний файлуудыг устгана. Файл хуваалцах нь файлыг өөрийг нь илгээдэг бөгөөд таны хуваалцсан хуулбар таны хуваалцсан аппад үлдэнэ. Файл татахын тулд бид таны бүртгэлийн нэвтэрсэн гишүүнд нэг минутын дараа ажиллахаа болих холбоос үүсгэдэг; түүнд өөр холбоос үүсгэдэггүй.</li>
					<li>Хэрэгслийн буцаасан зүйл, planque-ийн дуудлага бүрийн бүртгэлд: 24 цаг. Үүний дараа бүртгэл зөвхөн дуудлага илгээгдсэн эсэхийг хадгалах бөгөөд ингэснээр хэзээ ч хоёр удаа илгээгдэхгүй.</li>
					<li>planque дахь холболтын токен эсвэл түлхүүр, эсвэл Composio дахь удирдагдсан холболтын нэвтрэлт: та салгах хүртэл. Хэрэв таны өөр холболт тэр үйлчилгээ үзүүлэгч дэх ижил бүртгэлийг ашиглаж болох бол энэ нь ашиглагдалгүй, тэр нь бас салгагдтал хадгалагдаж, дараа нь хүчингүй болгогдоно. Түүний зөвшөөрлийн бүртгэл: бүртгэл дуустал.</li>
					<li>Төхөөрөмжийн push токен: та аппаас гарах, төхөөрөмжийг устгах, эсвэл Apple эсвэл Google токен алга болсныг мэдээлэх хүртэл. Төхөөрөмжийн нийтийн түлхүүр, нэр, платформ болон огноо: та ашиглаж байх хугацаанд; та үүнээс гармагц устгагдсан гэж тэмдэглэгдэж бүртгэл устгагдтал хадгалагдах бөгөөд ингэснээр KIFF түүнээс ирсэн хоцорсон хариултаас татгалзаж, өмнөх хариултад аль төхөөрөмж гарын үсэг зурсныг харуулж чадна. Passkey-ийн нийтийн түлхүүр, id болон нэр: түүний төхөөрөмжийнхтэй адил. Компьютерийн сесс: 90 хоног хүртэл, эсвэл та гарах хүртэл.</li>
					<li>Таны бүртгэл: устгагдтал. Үйлчилгээний лог: 30 хоног. tafs болон planque-ийн хадгалалт шифрлэгдсэн цаг хугацааны хуулбарыг 35 хоног хадгалах бөгөөд зөвхөн доголдлын дараа хадгалалтыг сэргээхэд ашиглана.</li>
				</ul>
				<p>Бусад бүх зүйл <a href="/mn/privacy#retention">KIFF-ийн Хадгалалтын хэсэг</a>-т байна.</p>
			</section>
			<section id="lawful-bases">
				<h2>9. Хууль ёсны үндэслэл</h2>
				<p>Гэрээний гүйцэтгэл, таны бүртгэл болон taf-уудыг ажиллуулахад. Хууль ёсны ашиг сонирхол, аюулгүй байдал, залилангаас сэргийлэх болон буруу хэрэглээг илрүүлэхэд. Зөвшөөрөл, tafs дахь AI-д (<a href="#ai">5-р хэсэг</a>). Хуулийн үүрэг, татварын бүртгэлд. <a href="/mn/privacy#lawful-bases">KIFF-ийн Нууцлалын бодлого</a> дэлгэрэнгүйг агуулна.</p>
			</section>
			<section id="rights">
				<h2>10. Таны эрх</h2>
				<p>GDPR-ийн дагуу та өөрийн өгөгдөлд хандах, засуулах, устгуулах, хязгаарлуулах эсвэл зөөвөрлөх хуулбар авахыг хүсч, хууль ёсны ашиг сонирхол дээр суурилсан боловсруулалтыг эсэргүүцэж, зөвшөөрлөө буцааж татаж болно. <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> руу имэйл бичнэ үү; бид үндэслэлгүй саатуулалгүй, хамгийн оройдоо нэг сарын дотор хариулна; нарийн төвөгтэй хүсэлтэд дахиад хоёр сар шаардагдаж болох бөгөөд энэ тухай эхний сард мэдэгдэнэ. Аппад Бүртгэл → Миний чатуудыг экспортлох нь таны өөрийн чат болон тэмдэглэлийг татаж авна.</p>
				<p>tafs бүртгэлээ устгахын тулд аппаа нээж, Бүртгэл рүү орж <em>Бүртгэл устгах</em>-ыг товшоод баталгаажуулна уу. Үүнийг буцаах боломжгүй. Юу, хэзээ устгагдах, имэйлээр хэрхэн хүсэхийг <a href="/mn/privacy#delete-account">KIFF-ийн Нууцлалын бодлого</a> хэлнэ.</p>
				<p>Та <a href="https://www.aki.ee/en" target="_blank" rel="noopener">Эстонийн Өгөгдөл хамгааллын хяналтын газар (Andmekaitse Inspektsioon)</a>-т, эсвэл амьдарч буй газрынхаа хяналтын байгууллагад гомдол гаргаж болно.</p>
				<p><strong>Таны улс.</strong> Зарим улсын хууль энэ бодлогоос илүү зүйл шаарддаг. Тэдний нэмсэн зүйлийг англиар болон тухайн улсын хэлээр <a href="/privacy/countries">Таны улс</a> (англиар) хуудаснаас үзнэ үү.</p>
			</section>
			<section id="more">
				<h2>11. Аюулгүй байдал, хүүхдүүд ба өөрчлөлт</h2>
				<p>Манай аюулгүй байдлын арга хэмжээ <a href="/security">/security</a> (англиар)-д байна. tafs хүүхдэд чиглээгүй бөгөөд бид 16-аас доош насны хүүхдийн хувийн мэдээллийг санаатайгаар цуглуулдаггүй. Бид энэ бодлогыг <a href="/mn/privacy#changes">KIFF-ийн Нууцлалын бодлого</a> өөрийнхөө талаар заасан аргаар өөрчилнө.</p>
			</section>
			<section id="contact">
				<h2>12. Холбоо барих</h2>
				<p>Нууцлалын асуулт, хүсэлт: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>. Албан ёсны хуулийн мэдэгдэл: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>. Аппын өөрийн нөхцөл <a href="/mn/tafs/terms">/tafs/terms</a>-д байна.</p>
			</section>
		</article>
	}
}

// tafsPrivacyGoogle is what tafs does with the data it receives from Google,
// for Google's review of tafs's sign-in, with the Limited Use statement in
// Google's own words.
templ tafsPrivacyGoogleMN() {
	<section id="google">
		<h2>6. Google хэрэглэгчийн өгөгдөл</h2>
		if len(googleManaged()) == 0 && len(googleInHouse("mn")) > 0 {
			<p>Таныг хүссэн үед tafs taf-ыг таны Google бүртгэлтэй холбодог, жишээлбэл түүний ажил ашигладаг Google Sheets эсвэл Google Calendar-тай, аппын Аппууд холбох хэсэгт. Энэ хэсэг tafs Google-ээс авсан өгөгдлийг юу хийдгийг хэлнэ.</p>
		} else {
			<p>Таныг хүссэн үед tafs taf-ыг таны Google бүртгэлтэй холбодог, жишээлбэл таны Gmail-тэй, эсвэл түүний ажил ашигладаг Google Calendar эсвэл Google Sheets-тэй, аппын Аппууд холбох хэсэгт. Энэ хэсэг tafs Google-ээс авсан өгөгдлийг юу хийдгийг хэлнэ.</p>
		}
		<ul>
			if len(googleManaged()) == 0 && len(googleInHouse("mn")) > 0 {
				<li><strong>Юу уншиж, бичдэг:</strong> taf-ын ажилд хэрэгтэй зүйл: шинэчилж байдаг хүснэгтүүд, эсвэл тэр хариуцдаг хуанлийн үйл явдлууд. Taf-ын Card зөвшөөрсөн газарт л тэдгээрийг өөрчилдөг бөгөөд Card-ийн хязгаараас хэтэрсэн бүхэн таны зөвшөөрлийг хүлээнэ.</li>
			} else {
				<li><strong>Юу уншиж, бичдэг:</strong> taf-ын ажилд хэрэгтэй зүйл. Таны Gmail-д хариу шаардлагатай мессеж, цувралыг олохын тулд уншиж, ноорог бичнэ; зөвхөн taf-ын Card зөвшөөрсөн газарт л имэйл илгээнэ. Google Calendar болон Google Sheets-д тэр хариуцдаг хуанлийн үйл явдлууд, эсвэл шинэчилж байдаг хүснэгтүүдийг уншиж, taf-ын Card зөвшөөрсөн газарт л өөрчилдөг.
					if googleListed("Google Tasks") {
						Google Tasks-д тэр хариуцдаг даалгаврын жагсаалтуудыг уншиж, taf-ын Card зөвшөөрсөн газарт л даалгавар нэмэх, дуусгах, зөөх эсвэл устгана.
					}
					Card-ийн хязгаараас хэтэрсэн бүхэн таны зөвшөөрлийг хүлээнэ.</li>
			}
			<li><strong>Яагаад:</strong> зөвхөн тэр taf-д та тохируулсан ажлыг хийхийн тулд, мөн түүнийг аль Google бүртгэлтэй холбосныг танд харуулахын тулд: түүний имэйл хаяг, та салгах хүртэл холболттой хамт хадгалагдана.</li>
			if len(googleManaged()) > 0 || len(googleInHouse("mn")) > 0 {
				<li>
					<strong>Google апп бүр хэрхэн холбогддог:</strong>
					<ul>
						if len(googleManaged()) > 0 {
							<li>Манай нэвтрэлтийн түнш, <a href="/subprocessors">/subprocessors</a> (англиар)-д жагсаасан, -ээр дамжуулан: { appList(googleManaged()) }.</li>
						}
						if len(googleInHouse("mn")) > 0 {
							<li>tafs-ийн өөрийн Google нэвтрэлтээр, дунд нь өөр компанигүйгээр: { appList(googleInHouseNames()) }.</li>
						}
						for _, a := range googlePending("mn") {
							<li>
								{ a.Name }{ googlePendingSep("mn") }{ googlePendingWords("mn").Line }
								{ googlePendingWords("mn").AsksFor }
								<ul>
									for _, s := range a.Scopes {
										<li><code>{ s.ID }</code>: { s.What }</li>
									}
								</ul>
							</li>
						}
					</ul>
					if googleBoth() {
						Хоёуланд нь нэрлэгдсэн апп таны бүртгэлээс хамаарч нэг арга эсвэл нөгөө аргаар холбогдоно. Google-ийн өөрийн нэвтрэх хуудас та алийг зөвшөөрч байгааг харуулна.
					}
				</li>
			}
			if googleBoth() {
				<li>
					<strong>Та юуг зөвшөөрдөг:</strong> та Google-ийн өөрийн хуудсанд нэвтэрч, юуг зөвшөөрөхөө сонгоно.
					<ul>
						<li><strong>Манай нэвтрэлтийн түншээр дамжуулан:</strong> tafs зөвхөн taf-ын хэрэгслүүдэд хэрэгтэй хандалтыг асууна. Хэрэв тэр нарийн хандалт боломжгүй бол апп-ын ердийн хандалтыг асууж, та нэвтрэхээс өмнө тэр тухай хэлнэ. Хэрэв ердийн хандалт taf-ын ашигладаггүй хувийн мэдээллийг агуулах бол tafs холбогдохгүй.</li>
						<li><strong>tafs-ийн өөрийн Google нэвтрэлтээр:</strong> нэвтрэлт taf зөвхөн уншиж байсан ч тэр апп-ын доор жагсаасан бүх хандалтыг нэг дор асууна.</li>
					</ul>
				</li>
			} else if len(googleInHouse("mn")) > 0 {
				<li><strong>Та юуг зөвшөөрдөг:</strong> та Google-ийн өөрийн хуудсанд нэвтэрч, юуг зөвшөөрөхөө сонгоно. Нэвтрэлт taf зөвхөн уншиж байсан ч тэр апп-ын доор жагсаасан бүх хандалтыг нэг дор асууна.</li>
			} else {
				<li><strong>Та юуг зөвшөөрдөг:</strong> та Google-ийн өөрийн хуудсанд нэвтэрч, юуг зөвшөөрөхөө сонгоно. tafs зөвхөн taf-ын хэрэгслүүдэд хэрэгтэй хандалтыг асууна. Хэрэв тэр нарийн хандалт боломжгүй бол апп-ын ердийн хандалтыг асууж, та нэвтрэхээс өмнө тэр тухай хэлнэ. Хэрэв ердийн хандалт taf-ын ашигладаггүй хувийн мэдээллийг агуулах бол tafs холбогдохгүй.</li>
			}
			<li><strong>Taf үүнийг хэрхэн ашигладаг:</strong> taf зөвхөн өөрийн Card дээр зөвшөөрсөн хэрэгслүүдийг ашигладаг. Дуудлага бүрийг юу ч илгээхээс өмнө яг тэр хэрэгсэл болон тэдгээр аргументад зориулсан зөвшөөрлийн эсрэг шалгадаг бөгөөд таны өгсөн хандалтаас гадуурх дуудлагаас татгалздаг. Аль үйлдэл тухай бүр таны зөвшөөрлийг асуухыг Card дээр тогтооно.</li>
			if len(googleInHouse("mn")) > 0 {
				<li>
					if googleBoth() {
						<strong>tafs-ийн өөрийн Google нэвтрэлт асууж буй хандалт:</strong>
					} else {
						<strong>tafs асууж буй хандалт:</strong>
					}
					<ul>
						for _, a := range googleInHouse("mn") {
							<li>
								{ a.Name }
								<ul>
									for _, s := range a.Scopes {
										<li><code>{ s.ID }</code>: { s.What }</li>
									}
								</ul>
							</li>
						}
					</ul>
					Нэвтрэлт хичнээн зөвшөөрсөн ч taf зөвхөн өөрийн Card дээрх хэрэгслүүдийг ашигладаг.
				</li>
			}
			if googleBoth() {
				<li>
					<strong>Таны нэвтрэлтийг хэн хадгалдаг:</strong>
					<ul>
						<li><strong>Манай нэвтрэлтийн түншээр дамжуулан:</strong> таны Google нэвтрэлтийг манай нэвтрэлтийн түнш, <a href="/subprocessors">/subprocessors</a> (англиар)-д жагсаасан, хадгалах бөгөөд taf эсвэл planque-д хэзээ ч өгдөггүй. Taf ч, tafs ч таны нууц үг эсвэл Google токенуудыг хардаггүй. Ижил хандалт хэрэгтэй таны өөр taf нэвтрэлтийг дахин ашиглах бөгөөд taf бүр зөвхөн таны түүнд зөвшөөрсөн хэрэгслүүдийг ашигладаг.</li>
