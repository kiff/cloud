package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// TermsDE is the Terms of Service (/terms) in German, at /de/terms. It
// is a translation of Terms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English
// page governs. Change the English page first, then this one.
templ TermsDE() {
	@components.LayoutSite("KIFF — Nutzungsbedingungen", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@termsHeadDE()
			@termsDefinitionsDE()
			@termsAgreementDE()
			@termsServiceDE()
			@termsTafsDE()
			@termsAccountDE()
			@termsAcceptableUseDE()
			@termsCustomerDataDE()
			@termsConfidentialityDE()
			@termsFeesDE()
			@termsTermDE()
			@termsWarrantiesDE()
			@termsDisclaimerDE()
			@termsLiabilityDE()
			@termsIndemnityDE()
			@termsSLADE()
			@termsServiceModsDE()
			@termsTermsModsDE()
			@termsForceMajeureDE()
			@termsGoverningLawDE()
			@termsGeneralDE()
			@termsContactDE()
		</article>
	}
}

templ termsHeadDE() {
	<header class="legal-head">
		<p class="legal-badge">Nutzungsbedingungen · v0.1</p>
		<h1>Nutzungsbedingungen</h1>
		<p class="legal-meta">
			<strong>Zuletzt aktualisiert:</strong> 9. November 2026.
			<strong>Gültig ab:</strong> 24. Mai 2026.
		</p>
		<p class="legal-disclaimer">
			<strong>Was sich geändert hat:</strong> die tafs-App auf
			Android und Solo, gekauft über Google Play (§ 1, § 8).
			Davor: kostenpflichtige Tarife (§ 3A, § 8), die
			<a href="/legal/sla">Service-Level-Vereinbarung</a> (auf Englisch)
			(§ 14) und die Liste der verbotenen Nutzungen, die jetzt in
			der
			<a href="/de/acceptable-use">Richtlinie zur zulässigen Nutzung</a>
			steht (§ 5).
		</p>
		<p class="legal-disclaimer">
			Diese Bedingungen regeln die Nutzung von KIFF Cloud,
			einschließlich tafs. Fragen zum Vertrag:
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</header>
}

templ termsDefinitionsDE() {
	<section id="definitions">
		<h2>1. Begriffe</h2>
		<ul>
			<li><strong>„Kiff Agents OÜ“</strong>, <strong>„wir“</strong>, <strong>„uns“</strong>, <strong>„unser“</strong> — die estnische Gesellschaft mit beschränkter Haftung, die den Dienst erbringt. Registernummer 17372313.</li>
			<li><strong>„Kunde“</strong>, <strong>„du“</strong>, <strong>„dein“</strong> — die natürliche oder juristische Person, die diesen Bedingungen zustimmt.</li>
			<li><strong>„Nutzer“</strong> — jede Person, der der Kunde erlaubt, über das Konto des Kunden auf den Dienst zuzugreifen.</li>
			<li><strong>„Dienst“</strong> — das Produkt KIFF Cloud, einschließlich <code>api.kiff.dev</code>, <code>app.kiff.dev</code>, <code>kiff.dev</code>, tafs und der Dokumentation, Dashboards und APIs, die wir dort veröffentlichen.</li>
			<li><strong>„tafs“</strong> — die tafs-App für iPhone, iPad, Android und Computer (Mac, Windows und Linux) und der Dienst dahinter, einschließlich Setup und planque (§ 3A); darin übergibt ein Kunde eine Aufgabe an einen KI-Agenten, der innerhalb von KIFF Cards arbeitet. Ein <strong>„taf“</strong> ist ein solcher Agent.</li>
			<li><strong>„Mandant“</strong> — ein logisch getrennter Workspace innerhalb des Dienstes, der einem einzelnen Kunden gehört.</li>
			<li><strong>„Audit-Daten“</strong> — die Ereignisse, Entscheidungen, Aktionen, Genehmigungen und Belege, die der Dienst über die Runtime im Auftrag des Kunden speichert.</li>
			<li><strong>„tafs-Daten“</strong> — was tafs im Auftrag des Kunden aufbewahrt: die Läufe und Chats jedes tafs (einschließlich dessen, was die verbundenen Apps des Kunden ihm zurückgeben), seine Berichte, seine Gedächtnisnotizen und die Telefone, die für seine Benachrichtigungen registriert sind.</li>
			<li><strong>„Beleg“</strong> — eine signierte, versionierte Aufzeichnung der Entscheidung, die der Dienst für jede geregelte Aktion ausgibt.</li>
			<li><strong>„Dokumentation“</strong> — die technische Dokumentation des Dienstes und die Sicherheitsmaßnahmen in der datierten Fassung, auf die diese Bedingungen verlinken (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>). Nicht dazu gehören das strategische Whitepaper, Marketingmaterial und die Dokumentation des gesondert lizenzierten Open-Source-Frameworks.</li>
			<li><strong>„AVV“</strong> — der Auftragsverarbeitungsvertrag unter <a href="/de/legal/dpa">/legal/dpa</a>, der unser Verhältnis als Auftragsverarbeiter regelt.</li>
		</ul>
	</section>
}

templ termsAgreementDE() {
	<section id="agreement">
		<h2>2. Die Vereinbarung</h2>
		<p>
			Diese Bedingungen regeln deine Nutzung des Dienstes. Indem
			du ein Konto anlegst, einen API-Schlüssel erzeugst oder den
			Dienst auf andere Weise nutzt, stimmst du diesen
			Bedingungen zu. Wenn du für ein Unternehmen oder eine andere
			juristische Person zustimmst, sicherst du zu, dass du
			befugt bist, sie zu binden, und „du“ und „dein“ beziehen
			sich auf sie.
		</p>
		<p>
			Wir können ergänzende Bedingungen für bestimmte Funktionen
			veröffentlichen (Beta-Funktionen, Integrationen Dritter).
			Wo sie diesen Bedingungen widersprechen, gehen für die
			jeweilige Funktion die ergänzenden Bedingungen vor.
		</p>
	</section>
}

templ termsServiceDE() {
	<section id="service">
		<h2>3. Der Dienst</h2>
		<p>
			KIFF Cloud ist ein gehosteter Dienst, der delegierte
			Aktionen regelt. Er prüft Anfragen anhand der
			Berechtigungen und Cards, die der Kunde konfiguriert hat,
			kann eine menschliche Genehmigung verlangen und zeichnet
			Governance-Entscheidungen auf. Je nach konfigurierter
			Integration leitet KIFF eine autorisierte Anfrage weiter
			oder stellt eine Autorisierung aus, die das geschützte
			System prüft. Die zugrunde liegende Aktion führt das
			verbundene System aus.
		</p>
		<p>
			Das maßgebliche technische Verhalten, die Nachweise, die
			Anforderungen an die Integration und die Grenzen der
			Ausführung sind in der datierten Dokumentation festgelegt,
			auf die diese Bedingungen verlinken. Das strategische
			<a href="/whitepaper">Whitepaper</a> (auf Englisch) erklärt
			KIFFs Grundsätze und Modell; es ist nicht als technische
			Dokumentation Teil dieser Bedingungen.
		</p>
		<p>
			Der Governance-Dienst von KIFF Cloud ist <em>kein</em>
			Agenten-Framework, keine Workflow-Engine, kein
			Modell-Gateway und keine verwaltete Agentenplattform. Er
			lässt sich mit dem kombinieren, was du schon nutzt. Die
			ausdrückliche Liste steht unter
			<a href="/#not">„Was KIFF nicht ist“</a> auf der Startseite.
			tafs ist der eine Teil des Dienstes, der Agenten für dich
			betreibt, innerhalb der Cards, die du ausstellst; § 3A
			beschreibt ihn.
		</p>
		<p>
			Für das Open-Source-Framework
			<a href="https://github.com/kiff/kiff" target="_blank" rel="noopener">kiff/kiff</a>
			gilt seine eigene MIT-Lizenz; es fällt nicht unter diese
			Bedingungen. Betreibst du das Framework auf deiner eigenen
			Infrastruktur, entsteht kein Vertrag mit Kiff Agents OÜ.
		</p>
	</section>
}

templ termsTafsDE() {
	<section id="tafs">
		<h2>3A. tafs</h2>
		<p>
			In tafs übergibst du eine Aufgabe (zum Beispiel
			Erstattungen, das Bezahlen von Rechnungen oder
			Anfechtungen von Kartenzahlungen) an einen taf: einen
			KI-Agenten, der nach einem Zeitplan mit den Apps arbeitet,
			die du verbindest, innerhalb der KIFF Cards, die du für ihn
			ausstellst. Jeder taf läuft auf unserer Agenten-Runtime,
			und Anthropic stellt das KI-Modell bereit, das er nutzt.
			Seine zurückgehaltenen Aufrufe beantwortest du in der
			tafs-App.
		</p>
		<p>
			<strong>Deine Apps verbinden.</strong> Setup, ein KI-Agent
			in tafs, der wie ein taf läuft, hilft dir, eine App zu
			verbinden und einen taf für eine Aufgabe einzurichten. Setup
			verbindet nichts von sich aus. Du meldest dich beim eigenen
			Anbieter der App an (zum Beispiel Stripe), und du
			genehmigst auf deinem Gerät jede Verbindung, die Tools, die
			ein taf nutzen darf, und seine Cards. Das Token aus dieser
			Anmeldung bewahrt planque auf, unser Verbindungsdienst. Es
			ist verschlüsselt, wird nur genutzt, um einen Aufruf
			auszuführen, über den KIFF entschieden hat, und wird nie
			einem taf gegeben. Wenn du eine App trennst, wird das Token
			beim Anbieter widerrufen und gelöscht.
		</p>
		<p>
			<strong>Deine Cards sind deine Anweisungen.</strong> Ein taf
			erreicht deine Apps nur über KIFF, das jeden Aufruf anhand
			der Cards des tafs prüft, bevor er gesendet wird. Ein
			Aufruf innerhalb einer Card, die du ausgestellt hast,
			erfolgt auf deine Anweisung. Ein Aufruf außerhalb einer
			Card wird zurückgehalten oder abgelehnt, wie die Card es
			sagt. Ein zurückgehaltener Aufruf wird erst ausgeführt,
			nachdem ihn jemand genehmigt hat, dem dein Konto erlaubt,
			zurückgehaltene Aufrufe zu beantworten. In der tafs-App
			trägt die Antwort eine Signatur vom Gerät dieser Person,
			die KIFF prüft, und der Beleg bewahrt diesen Nachweis auf.
			Dein Konto kann auch in KIFF selbst antworten (im
			Dashboard, mit seinem Kommandozeilen-Tool oder über einen
			Genehmiger, den du dort autorisierst); der Beleg hält dann
			fest, wer geantwortet hat und wie.
		</p>
		<p>
			<strong>Was bei dir bleibt.</strong> Du wählst die Aufgabe
			und die Cards jedes tafs, beantwortest seine
			zurückgehaltenen Aufrufe und stellst sicher, dass du die
			Apps und Konten, die du verbindest, nutzen darfst. Die
			Berichte, Nachrichten und Gedächtnisnotizen eines tafs
			schreibt ein KI-Modell, und sie können falsch sein; prüfe,
			worauf es ankommt, bevor du dich darauf verlässt.
		</p>
		<p>
			<strong>Einen taf stoppen.</strong> Du kannst einen taf
			oder alle anhalten, einen taf pausieren, jede seiner Cards
			widerrufen oder ihn entfernen. Von dem Moment an, in dem du
			einen taf anhältst oder eine Card widerrufst, erlaubt KIFF
			darunter keinen neuen Aufruf. Die tafs-App zeigt einen taf
			erst dann als angehalten, wenn KIFF und planque beide das
			Anhalten bestätigt haben; von da an sendet planque keinen
			seiner Aufrufe, auch keinen, den KIFF kurz zuvor erlaubt
			hat. Eine Anfrage, die schon an den Anbieter einer App
			gesendet wurde, kann noch abgeschlossen werden: Wir stoppen
			neue Aufrufe und können nicht rückgängig machen, was ein
			Anbieter getan hat.
			Eine App, die KIFFs Freigaben selbst prüft, ohne planque,
			kann eine Freigabe, die KIFF kurz zuvor ausgestellt hat,
			noch annehmen, höchstens 90 Sekunden lang. Einen
			angehaltenen taf fortzusetzen, braucht deine Genehmigung
			auf deinem Gerät, und nichts, was vor dem Anhalten
			zurückgehalten oder eingereiht war, läuft danach.
		</p>
		<p>
			<strong>Das Entfernen eines tafs</strong> stoppt seinen
			Zeitplan und löscht seine Läufe, seine Chats, sein
			Gedächtnis und den Schlüssel, den er genutzt hat. Schon
			davor wird das, was deine Apps einem taf zurückgeben, nur
			aufbewahrt, bis sein Lauf endet (was ein Chat nur gelesen
			hat, verschlüsselt, für seine nächsten Nachrichten:
			höchstens vier Stunden lang genutzt, dann gelöscht), und
			seine Läufe und Chats 30 Tage lang. KIFF bewahrt die Belege
			dessen auf, was er getan hat.
		</p>
		<p>
			<strong>Die KI-Verordnung der EU.</strong> Bei tafs ist
			Kiff Agents OÜ der Anbieter des KI-Systems, und du bist
			sein Betreiber. Wir sorgen dafür, dass alles, was ein taf
			an jemanden außerhalb deines Unternehmens schreibt, sagt,
			dass ein KI-Agent es geschrieben hat. Du nutzt tafs nur für
			die Aufgaben, die es anbietet, und nicht für eine Nutzung,
			die die KI-Verordnung verbietet oder als hochriskant
			einstuft, etwa Entscheidungen über die Beschäftigung einer
			Person, ihren Kredit oder ihren Zugang zu grundlegenden
			Diensten. Du behältst die menschlichen Genehmigungen bei,
			die deine Cards verlangen, und stellst sicher, dass die
			Personen, die tafs für dich nutzen, verstehen, was es tut
			und wo seine Grenzen liegen.
		</p>
		<p>
			<strong>Kosten.</strong> tafs ist Teil deines KIFF-Tarifs
			(§ 8): Jeder Lauf eines tafs verbraucht Credits für die KI,
			die er genutzt hat. Coach und das Einrichten von tafs sind
			enthalten, im Rahmen der fairen Nutzung von Coach.
		</p>
	</section>
}

templ termsAccountDE() {
	<section id="account">
		<h2>4. Konten und Zugang</h2>
		<p>
			Um den Dienst zu nutzen, musst du ein Konto anlegen. Du
			verpflichtest dich, bei der Registrierung richtige Angaben
			zu machen, deine Zugangsdaten vertraulich zu halten und für
			alle Aktivitäten in deinem Konto verantwortlich zu sein.
		</p>
		<p>
			Du musst mindestens 16 Jahre alt sein oder das Alter der
			digitalen Einwilligung in deiner Rechtsordnung erreicht
			haben, je nachdem, welches höher ist. Der Dienst richtet sich nicht
			an Kinder.
		</p>
		<p>
			Du bist für die Handlungen jedes Nutzers verantwortlich,
			den du in deinem Konto zulässt. Wir können ein Konto
			sperren oder den Zugang entziehen, mit angemessener
			Vorankündigung, wenn wir einen glaubhaften Verstoß gegen
			diese Bedingungen feststellen. Bei Verstößen gegen die
			Richtlinie zur zulässigen Nutzung (siehe § 5) kann die
			Sperrung sofort erfolgen.
		</p>
	</section>
}

templ termsAcceptableUseDE() {
	<section id="acceptable-use">
		<h2>5. Zulässige Nutzung</h2>
		<p>
			Du, deine Nutzer und deine Agenten müsst die
			<a href="/de/acceptable-use">Richtlinie zur zulässigen Nutzung</a>
			einhalten. Sie ist Teil dieser Bedingungen und führt auf,
			wofür der Dienst nicht genutzt werden darf.
		</p>
		<p>
			Bei einem glaubhaften Verstoß gegen die Richtlinie können
			wir sofort sperren. Wir sind nicht verpflichtet, Inhalte
			des Kunden zu überwachen, können aber auf glaubhafte
			Meldungen hin handeln.
		</p>
	</section>
}

templ termsCustomerDataDE() {
	<section id="customer-data">
		<h2>6. Kundendaten und Inhalte</h2>
		<p>
			Deine Audit-Daten gehören dir. Du räumst Kiff Agents OÜ
			eine beschränkte, nicht ausschließliche, gebührenfreie,
			weltweite Lizenz ein, deine Audit-Daten zu hosten, zu
			kopieren, zu übertragen, anzuzeigen und auf andere Weise zu
			verarbeiten, und zwar nur, soweit es nötig ist, um den
			Dienst für dich zu betreiben, zu warten und zu verbessern.
		</p>
		<p>
			Für deine Audit-Daten und deine tafs-Daten handeln wir als
			<strong>Auftragsverarbeiter</strong> nach Artikel 28 DSGVO;
			der <a href="/de/legal/dpa">AVV</a> regelt dieses
			Verhältnis im Einzelnen. Für die Metadaten deines Kontos
			handeln wir als <strong>Verantwortlicher</strong>; die
			<a href="/de/privacy">Datenschutzerklärung</a> regelt
			dieses Verhältnis.
		</p>
		<p>
			Du sicherst zu, dass du alle Rechte hast, die nötig sind,
			um die Daten zu übermitteln, die du übermittelst, und dass
			die Übermittlung dem geltenden Recht entspricht
			(einschließlich des Datenschutzrechts und, wo sie gilt, der
			KI-Verordnung der EU).
		</p>
	</section>
}

templ termsConfidentialityDE() {
	<section id="confidentiality">
		<h2>7. Vertraulichkeit</h2>
		<p>
			Jede Partei kann von der anderen nicht öffentliche
			Informationen erhalten („Vertrauliche Informationen“). Die
			empfangende Partei nutzt Vertrauliche Informationen nur,
			soweit es nötig ist, um ihre Pflichten aus diesen
			Bedingungen zu erfüllen und ihre Rechte daraus auszuüben,
			und schützt sie mindestens mit derselben Sorgfalt, die sie
			für ihre eigenen vertraulichen Informationen anwendet.
		</p>
		<p>
			Keine Vertraulichen Informationen sind Informationen, die
			(a) ohne Pflichtverletzung öffentlich zugänglich sind oder
			werden, (b) der empfangenden Partei vor der Offenlegung
			bekannt waren, (c) unabhängig und ohne Nutzung der
			Vertraulichen Informationen entwickelt werden oder (d) nach
			dem Gesetz offengelegt werden müssen (mit Mitteilung an die
			andere Partei, wo das erlaubt ist).
		</p>
	</section>
}

templ termsFeesDE() {
	<section id="fees">
		<h2>8. Gebühren und Zahlung</h2>
		<p>
			<strong>Tarife.</strong> Jedes Konto hat einen Tarif. Die
			aktuellen Preise stehen auf der
			<a href="/pricing">Preisseite</a> (auf Englisch); zum
			Zeitpunkt dieser Aktualisierung:
		</p>
		<ul>
			<li><strong>Solo:</strong> eine Person, für tafs, verkauft in der tafs-App über den App Store oder Google Play für 12,50 € pro Monat, inklusive Mehrwertsteuer, mit 500 Credits pro Monat inklusive.</li>
			<li><strong>Company:</strong> 10,50 € pro Monat für jeden Platz, mit 500 Credits pro Monat für jeden Platz, gemeinsam genutzt, und, für die Aufrufe deiner eigenen Agenten über KIFF Cloud, 500 Aktionen pro Monat für jeden Platz, gemeinsam genutzt.</li>
			<li><strong>Eine Vereinbarung:</strong> die Gebühren und Bedingungen in ihrem Bestellformular.</li>
		</ul>
		<p>
			Plätze sind die Admins und Bearbeiter eines Kontos.
			Genehmiger und Betrachter sind in jedem Tarif kostenlos.
			Bei Company kostet über das Enthaltene hinaus ein Credit
			0,01 € und eine Aktion 0,02 €. Credits über die enthaltenen
			hinaus werden bis zu dem monatlichen Ausgabenlimit
			berechnet, das das Konto festlegt (50 € zu Beginn): Ist
			das Limit erreicht, startet KIFF keinen neuen Lauf der tafs des Kontos,
			bis der nächste Zeitraum beginnt oder jemand, der die
			Abrechnung verwaltet, das Limit erhöht.
		</p>
		<p>
			<strong>Credit-Pakete.</strong> Bei Solo kommen Credits über
			die enthaltenen des Monats hinaus aus Credit-Paketen, die
			in der tafs-App gekauft werden. Ein Paket wird einmal
			gekauft, verfällt nicht und ist kein Abonnement; seine
			Credits werden nach den enthaltenen des Monats verbraucht,
			das älteste Paket zuerst. Ein Paket, dessen Zahlung
			vollständig erstattet wird, wird zurückgenommen, mit den
			Credits, die es noch hat. Sind die Credits des Monats und
			die Pakete verbraucht, startet KIFF keinen neuen Lauf der
			tafs des Kontos, bis der nächste Zeitraum beginnt oder ein
			Paket hinzugefügt wird.
			Bonus-Credits, die KIFF einem Konto hinzufügt, verfallen
			ebenfalls nicht, wie Pakete.
		</p>
		<p>
			<strong>Was gezählt wird.</strong> Ein <em>Credit</em> zahlt
			für die KI, die der Lauf eines tafs genutzt hat, in ganzen
			Credits, einmal pro Lauf aufgerundet und einmal gezählt,
			wenn der Lauf endet. Ein Lauf, dessen Aufruf KIFF abgelehnt
			hat, hat seine KI trotzdem genutzt. Nie gezählt: Coach und
			das Einrichten von tafs, im Rahmen der fairen Nutzung von
			Coach; ein Test einer neuen Version, der nichts sendet; und
			ein Lauf, der auf unserer Seite fehlgeschlagen ist. Eine
			<em>Aktion</em> ist ein Aufruf deines eigenen Agenten über
			KIFF Cloud, der etwas erledigt hat: KIFF hat ihn erlaubt,
			er wurde gesendet, und die App hat Erfolg gemeldet. Nie
			als Aktion gezählt: ein Aufruf, der abgelehnt wurde,
			zurückgehalten und dann abgelehnt wurde, durch ein Anhalten
			gestoppt wurde, ungültig war, bei der App fehlgeschlagen ist
			oder dessen Ergebnis unbekannt ist, und ein Aufruf, der nur
			liest.
		</p>
		<p>
			<strong>Keine Testphase.</strong> Ein Konto zahlt ab seinem
			ersten Tag. Bevor ein Tarif beginnt, startet KIFF keinen
			Lauf seiner tafs, außer für das Einrichten durch Coach;
			nichts wird gelöscht.
		</p>
		<p>
			<strong>Zahlung und Rechnungen.</strong> Ein Tarif wird an
			einer Stelle abgerechnet. Ein auf kiff.dev gekaufter Tarif
			wird dort und in dem Abrechnungsportal, auf das die Seite
			verlinkt, gekauft, geändert und gekündigt, und seine
			Zahlungen wickelt Stripe ab. Solo, in der tafs-App gekauft,
			wird auf iPhone und iPad über den App Store verkauft oder
			auf Android über Google Play und in deinen
			Apple-Abonnements oder Google-Play-Abonnements verwaltet,
			nach den Bedingungen des jeweiligen Stores für Zahlung,
			Verlängerung und Erstattungen. Credit-Pakete werden in der
			App gekauft. Company wird auf kiff.dev gekauft. Gebühren
			werden monatlich im Voraus berechnet; Nutzung über das
			Enthaltene hinaus wird mit der nächsten Rechnung berechnet.
			Eine Änderung der Zahl der Personen gilt ab der nächsten
			Rechnung. Schlägt eine Zahlung fehl und wird sie nicht
			nachgeholt, endet der Tarif, und KIFF lehnt die Aufrufe des
			Kontos ab, bis ein Tarif gewählt ist.
		</p>
		<p>
			<strong>Kündigung.</strong> Du kannst jederzeit im
			Abrechnungsportal kündigen oder, bei Solo aus der App, in
			deinen Apple-Abonnements oder Google-Play-Abonnements. Der
			Tarif läuft bis zum Ende des Zeitraums, den du bezahlt
			hast, und wird nicht verlängert. Soweit das Gesetz nichts
			anderes verlangt, werden bereits gezahlte Gebühren nicht
			erstattet. Bist du Verbraucher in der EU, kannst du
			innerhalb von 14 Tagen nach dem Kauf ohne Angabe von
			Gründen widerrufen, und wir erstatten, was du gezahlt hast,
			abzüglich des Anteils für die Tage, an denen der Tarif
			schon lief.
			Solo-Käufe werden über den App Store oder Google Play
			erstattet, nach deren Bedingungen.
		</p>
		<p>
			<strong>Mehrwertsteuer.</strong> Die Preise von Company
			verstehen sich ohne Mehrwertsteuer; Solo und Credit-Pakete
			verkauft der App Store oder Google Play inklusive
			Mehrwertsteuer. Kiff Agents OÜ
			(Umsatzsteuer-Identifikationsnummer EE102924327) schlägt
			estnische Mehrwertsteuer auf, wo sie anfällt. Verkäufe
			zwischen Unternehmen in der EU an einen Kunden außerhalb
			Estlands mit gültiger Umsatzsteuer-Identifikationsnummer
			werden nach dem Reverse-Charge-Verfahren der EU
			abgerechnet.
		</p>
		<p>
			<strong>Änderungen.</strong> Eine Preiserhöhung kündigen
			wir aktiven Konten mindestens dreißig Tage vorher
			schriftlich an (§ 16). Eine Preissenkung gilt ab der
			nächsten Rechnung.
		</p>
	</section>
}

templ termsTermDE() {
	<section id="term">
		<h2>9. Laufzeit und Kündigung</h2>
		<p>
			Diese Bedingungen gelten ab deiner ersten Nutzung des
			Dienstes und so lange, bis sie gekündigt werden.
		</p>
		<p>
			Du kannst jederzeit kündigen, indem du dein Konto löschst.
			Wir können kündigen (a) wegen einer wesentlichen
			Vertragsverletzung, die nicht innerhalb von dreißig Tagen
			nach schriftlicher Mitteilung behoben wird, oder (b) sofort
			bei Verstößen gegen die Richtlinie zur zulässigen Nutzung
			oder bei Insolvenzereignissen.
		</p>
		<p id="leaving">
			<strong>Gehen und deine Daten mitnehmen.</strong>
			Du kannst deine Daten jederzeit exportieren, in einem
			strukturierten, maschinenlesbaren Format: In KIFF liefert
			Settings → Data (das Dashboard ist auf Englisch) eine JSON-Datei mit deinem Konto,
			deinen Cards mit jeder Version, den Entscheidungen in
			deinem Protokoll (die letzten 10.000; frag uns nach mehr),
			dem signierten Beleg jeder Entscheidung, die KIFF erlaubt
			hat, und den Angaben zu deinen API-Schlüsseln (nie die
			Schlüssel selbst). In der tafs-App exportiert jede Person
			ihre eigenen Chats, Dateien und Notizen unter Konto
			→  Meine Chats exportieren; Chats werden ohnehin
			dreißig Tage aufbewahrt, wie die Datenschutzerklärung sagt.
			Das Löschen deines Kontos beendet den Dienst sofort,
			exportiere also vorher.
		</p>
		<p>
			Du kannst stattdessen mit einer Kündigungsfrist gehen, um zu einem
			anderen Anbieter oder zu deinen eigenen Systemen zu
			wechseln, indem du an
			<a href="mailto:support@kiff.dev">support@kiff.dev</a>
			schreibst. Wir verlangen nie mehr als zwei Monate Kündigungsfrist:
			Deine Kündigung wird an dem Datum wirksam, das du wählst,
			spätestens zwei Monate, nachdem du sie gesendet hast. Ab
			diesem Datum folgt eine Übergangszeit von dreißig Tagen, in
			der der Dienst weiterläuft, du deine Daten exportierst und
			deine Arbeit verlagerst und wir dir bei angemessenen Bitten
			dabei helfen. Du kannst die Übergangszeit einmal verlängern, so
			lange du brauchst. Können wir sie technisch nicht in
			dreißig Tagen abschließen, sagen wir es dir innerhalb von
			vierzehn Arbeitstagen nach deiner Kündigung, mit den
			Gründen und einer neuen Frist von höchstens sieben Monaten.
			Nach der Übergangszeit bleiben deine Daten mindestens
			dreißig weitere Tage für den Export verfügbar. Die Gebühren
			des Tarifs laufen wie gewohnt weiter, bis die Übergangszeit
			endet. Solo, im App Store oder bei Google Play gekauft,
			wird im Store gekündigt; die Übergangszeit und die
			Exportzeit gelten genauso.
		</p>
		<p>
			Wir berechnen nichts für das Gehen, den Wechsel oder den
			Export deiner Daten. Dieser Abschnitt gibt jedem Kunden die
			Wechselrechte aus Kapitel VI der Datenverordnung der EU
			(Verordnung (EU) 2023/2854).
		</p>
		<p>
			Bei Kündigung und nach einer etwaigen Übergangs- und
			Exportzeit löschen wir deine Audit-Daten, deine tafs-Daten und die
			Metadaten deines Kontos nach den Aufbewahrungsregeln in der
			<a href="/de/privacy#retention">Datenschutzerklärung</a>.
		</p>
		<p>
			Abschnitte, die ihrer Natur nach die Kündigung überdauern
			sollen, gelten weiter — darunter Vertraulichkeit, geistiges
			Eigentum, Freistellung, Haftungsbeschränkung,
			Haftungsausschlüsse, anwendbares Recht und alle
			aufgelaufenen Gebühren.
		</p>
	</section>
}

templ termsWarrantiesDE() {
	<section id="warranties">
		<h2>10. Gewährleistungen</h2>
		<p>
			Jede Partei sichert zu, dass sie berechtigt und befugt ist,
			diese Bedingungen einzugehen und zu erfüllen.
		</p>
		<p>
			Wir gewährleisten, dass wir den Dienst fachgerecht und im
			Wesentlichen in Übereinstimmung mit der Dokumentation
			erbringen. Dein einziger Rechtsbehelf bei einer Verletzung
			dieser Gewährleistung ist nach unserer Wahl die erneute
			Leistung oder die anteilige Erstattung der Gebühren, die
			auf den betroffenen Dienst für die Dauer der Verletzung
			entfallen.
		</p>
		<p>
			Du gewährleistest, dass deine Nutzung des Dienstes dem
			geltenden Recht und diesen Bedingungen entspricht.
		</p>
	</section>
}

templ termsDisclaimerDE() {
	<section id="disclaimer">
		<h2>11. Haftungsausschluss</h2>
		<p>
			Abgesehen von den ausdrücklichen Gewährleistungen in § 10
			wird der Dienst <strong>„wie besehen“ und „wie
			verfügbar“</strong> bereitgestellt. Soweit das Gesetz es
			zulässt, schließen wir alle anderen Gewährleistungen aus,
			ob ausdrücklich, stillschweigend oder gesetzlich,
			einschließlich Gewährleistungen der Marktgängigkeit, der
			Eignung für einen bestimmten Zweck, der Nichtverletzung von
			Rechten und jeder Gewährleistung, die sich aus
			Geschäftsgepflogenheiten oder Handelsbrauch ergibt.
		</p>
		<p>
			Wir gewährleisten nicht, dass der Dienst ununterbrochen,
			fehlerfrei oder frei von schädlichen Bestandteilen ist oder
			dass keine Daten verloren gehen oder beschädigt werden. Für
			die Sicherung deiner Daten bist du verantwortlich.
		</p>
	</section>
}

templ termsLiabilityDE() {
	<section id="liability">
		<h2>12. Haftungsbeschränkung</h2>
		<p>
			Soweit das Gesetz es zulässt, haftet keine Partei der
			anderen für mittelbare, beiläufige oder besondere Schäden,
			Folgeschäden, exemplarischen Schadensersatz oder
			Strafschadensersatz, einschließlich entgangenen Gewinns,
			entgangener Einnahmen, verlorener Daten oder
			Betriebsunterbrechung, die sich aus diesen Bedingungen oder
			dem Dienst ergeben oder damit zusammenhängen, auch wenn sie
			auf die Möglichkeit solcher Schäden hingewiesen wurde.
		</p>
		<p>
			Die Gesamthaftung jeder Partei aus oder im Zusammenhang mit
			diesen Bedingungen übersteigt nicht den höheren der
			folgenden Beträge: (a) die Gebühren, die der Kunde in den
			zwölf Monaten vor dem Ereignis, das die Haftung auslöst, an
			Kiff Agents OÜ gezahlt hat oder zu zahlen hatte, oder (b)
			einhunderttausend Euro (100.000 €).
		</p>
		<p>
			Nichts in diesen Bedingungen beschränkt eine Haftung oder
			schließt sie aus, die nach geltendem Recht nicht beschränkt
			oder ausgeschlossen werden kann, einschließlich der Haftung
			für Tod, für fahrlässig verursachte Körperverletzung, für
			Betrug oder Vorsatz und der Haftung für ein fehlerhaftes
			Produkt nach den Gesetzen zur Umsetzung der Richtlinie (EU)
			2024/2853 über die Haftung für fehlerhafte Produkte.
		</p>
	</section>
}

templ termsIndemnityDE() {
	<section id="indemnification">
		<h2>13. Freistellung</h2>
		<p>
			Wir verteidigen dich gegen Ansprüche Dritter, die geltend
			machen, dass der Dienst, wie wir ihn bereitstellen und du
			ihn nach diesen Bedingungen nutzt, die Rechte des geistigen
			Eigentums dieses Dritten verletzt, und wir zahlen den Schadensersatz,
			der dir wegen solcher Ansprüche rechtskräftig auferlegt
			wird (oder den vereinbarten Vergleichsbetrag).
		</p>
		<p>
			Du verteidigst uns gegen Ansprüche Dritter, die sich
			ergeben aus (a) deinen Kundendaten oder Inhalten; (b)
			deiner Nutzung des Dienstes unter Verstoß gegen diese
			Bedingungen (einschließlich der Richtlinie zur zulässigen
			Nutzung); oder (c) deiner groben Fahrlässigkeit oder deinem
			Vorsatz, und du zahlst den Schadensersatz, der uns wegen
			solcher Ansprüche rechtskräftig auferlegt wird (oder den
			vereinbarten Vergleichsbetrag).
		</p>
		<p>
			Die Freistellung setzt voraus, dass der Anspruch
			unverzüglich mitgeteilt wird, dass die freistellende Partei
			Verteidigung und Vergleich allein steuert und dass die
			freigestellte Partei angemessen mitwirkt. Die freistellende
			Partei darf ohne Zustimmung keinen Vergleich schließen, der
			der freigestellten Partei Pflichten auferlegt.
		</p>
	</section>
}

templ termsSLADE() {
	<section id="sla">
		<h2>14. Service-Level-Zusage</h2>
		<p>
			Bei einem kostenpflichtigen Tarif legt die
			<a href="/legal/sla">Service-Level-Vereinbarung</a> (auf Englisch)
			fest, welche Verfügbarkeit wir zusagen, wie eine langsame
			oder fehlgeschlagene Anfrage zählt, wie schnell unser
			Support antwortet und welche Service-Gutschriften es gibt,
			wenn wir das nicht einhalten. Sie ist Teil dieser
			Bedingungen.
		</p>
		<p>
			Betriebspraktiken, die Reaktion auf Vorfälle und die
			Zusagen zur Meldung von Datenschutzverletzungen sind in der
			datierten Fassung dokumentiert, auf die diese Bedingungen
			verlinken
			(<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>);
			<a href="/de/security">/security</a> zeigt die aktuellen
			Praktiken.
		</p>
	</section>
}

templ termsServiceModsDE() {
	<section id="service-mods">
		<h2>15. Änderungen am Dienst</h2>
		<p>
			Wir können jederzeit Funktionen hinzufügen, ändern oder
			entfernen. Wesentliche Einschränkungen der Funktionalität
			oder die Abkündigung einer API-Oberfläche, die
			dokumentiertes Verhalten bricht, teilen wir aktiven Kunden
			mindestens dreißig Tage im Voraus mit, mit einem
			veröffentlichten Zeitplan für die Abkündigung. Änderungen
			aus Sicherheitsgründen können ohne Ankündigung erfolgen,
			wenn die Ankündigung selbst ein Risiko schaffen würde.
		</p>
	</section>
}

templ termsTermsModsDE() {
	<section id="terms-mods">
		<h2>16. Änderungen dieser Bedingungen</h2>
		<p>
			Wir können diese Bedingungen von Zeit zu Zeit ändern.
			Wesentliche Änderungen teilen wir mindestens dreißig Tage
			im Voraus per E-Mail und in einem gut sichtbaren Banner auf
			dieser Seite mit. Nicht wesentliche Änderungen
			(Klarstellungen, Verweise) werden mit einem neuen Datum bei
			„Zuletzt aktualisiert“ veröffentlicht. Nutzt du den Dienst
			nach dem Datum weiter, an dem eine Aktualisierung wirksam
			wird, gilt das als Zustimmung.
		</p>
	</section>
}

templ termsForceMajeureDE() {
	<section id="force-majeure">
		<h2>17. Höhere Gewalt</h2>
		<p>
			Keine Partei haftet für eine Nichterfüllung oder
			Verzögerung, soweit sie durch Umstände verursacht wird, die
			sie nicht mit zumutbaren Mitteln beherrschen kann,
			einschließlich Naturereignissen, Krieg, Terrorismus,
			Unruhen, Arbeitskämpfen, Feuer, Naturkatastrophen,
			staatlicher Maßnahmen wegen einer Pandemie, Ausfällen des
			Internets oder der Stromversorgung oder Handlungen von
			Telekommunikationsanbietern oder der Hosting-Infrastruktur
			Dritter.
		</p>
	</section>
}

templ termsGoverningLawDE() {
	<section id="governing-law">
		<h2>18. Anwendbares Recht und Gerichtsstand</h2>
		<p>
			Für diese Bedingungen gilt das Recht der Republik Estland,
			ohne Rücksicht auf seine Kollisionsnormen. Ausschließlicher
			Gerichtsstand für Streitigkeiten ist das Gericht des Landkreises Harju
			(Harju Maakohus) in Tallinn.
		</p>
		<p>
			Bist du Verbraucher mit Wohnsitz in einem anderen
			Mitgliedstaat der EU, gelten die zwingenden
			Verbraucherschutzvorschriften deines Heimatlandes weiter,
			soweit sie dir Rechte geben, auf die du vertraglich nicht
			verzichten kannst; diese Klausel entzieht dir den Schutz
			dieser Vorschriften nicht.
		</p>
	</section>
}

templ termsGeneralDE() {
	<section id="general">
		<h2>19. Allgemeines</h2>
		<p>
			<strong>Gesamte Vereinbarung.</strong> Diese Bedingungen
			bilden zusammen mit der Datenschutzerklärung, dem AVV,
			etwaigen Bestellformularen und ausdrücklich einbezogenen
			ergänzenden Bedingungen die gesamte Vereinbarung zwischen
			uns über ihren Gegenstand und ersetzen jede frühere oder
			gleichzeitige Absprache.
		</p>
		<p>
			<strong>Salvatorische Klausel.</strong> Ist eine Bestimmung
			nicht durchsetzbar, bleiben die übrigen wirksam.
		</p>
		<p>
			<strong>Abtretung.</strong> Du darfst diese Bedingungen
			nicht ohne unsere schriftliche Zustimmung abtreten. Wir
			dürfen sie ohne Zustimmung im Zusammenhang mit einer
			Fusion, einer Übernahme oder dem Verkauf aller oder im
			Wesentlichen aller unserer Vermögenswerte abtreten und
			teilen es dir mit.
		</p>
		<p>
			<strong>Kein Verzicht.</strong> Wird eine Bestimmung nicht
			durchgesetzt, liegt darin kein Verzicht auf das Recht, sie
			später durchzusetzen.
		</p>
		<p>
			<strong>Mitteilungen.</strong> Mitteilungen an Kiff Agents
			OÜ gehen an
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>
			oder per Post an Tööstuse tn 75-71, Põhja-Tallinna
			linnaosa, Tallinn 10416, Estland. Mitteilungen an dich
			gehen an die E-Mail-Adresse deines Kontos oder, wenn du
			eine angegeben hast, an deine Adresse für rechtliche
			Mitteilungen.
		</p>
		<p>
			<strong>Unabhängige Vertragspartner.</strong> Nichts in
			diesen Bedingungen begründet eine Partnerschaft, eine
			Vertretung, ein Gemeinschaftsunternehmen oder ein
			Arbeitsverhältnis.
		</p>
		<p>
			<strong>Begünstigte Dritte.</strong> Es gibt keine, außer
			soweit freigestellte verbundene Unternehmen ausdrücklich
			benannt sind.
		</p>
	</section>
}

templ termsContactDE() {
	<section id="contact">
		<h2>20. Kontakt</h2>
		<p>
			Fragen zu Geschäft und Vertrag:
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
		<p>
			Allgemeine Fragen zum Produkt:
			<a href="mailto:hello@kiff.dev">hello@kiff.dev</a>.
			Fragen zum Datenschutz:
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
			Meldungen zur Sicherheit:
			<a href="mailto:security@kiff.dev">security@kiff.dev</a>.
		</p>

		<hr/>

		<p class="legal-footnote">
			<strong>Dokumentversion:</strong> v0.1.<br/>
			<strong>Zuletzt aktualisiert:</strong> 9. November 2026.
		</p>
	</section>
}
