package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// TermsSR is KIFF's terms (/terms) in Serbian, at /sr/terms.
// It is a translation of Terms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Serbian has the legal
// texts only, so a link to any other page goes to English and says so.
templ TermsSR() {
	@components.LayoutSite("KIFF — terms of service", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@termsHeadSR()
			@termsDefinitionsSR()
			@termsAgreementSR()
			@termsServiceSR()
			@termsTafsSR()
			@termsAccountSR()
			@termsAcceptableUseSR()
			@termsCustomerDataSR()
			@termsConfidentialitySR()
			@termsFeesSR()
			@termsTermSR()
			@termsWarrantiesSR()
			@termsDisclaimerSR()
			@termsLiabilitySR()
			@termsIndemnitySR()
			@termsSLASR()
			@termsServiceModsSR()
			@termsTermsModsSR()
			@termsForceMajeureSR()
			@termsGoverningLawSR()
			@termsGeneralSR()
			@termsContactSR()
		</article>
	}
}

templ termsHeadSR() {
	<header class="legal-head">
		<p class="legal-badge">Uslovi korišćenja · v0.1</p>
		<h1>Uslovi korišćenja</h1>
		<p class="legal-meta">
			<strong>Poslednje ažuriranje:</strong> 22. novembar 2026. <strong>Datum stupanja na snagu:</strong> 24. maj 2026.
		</p>
		<p class="legal-disclaimer">
			<strong>Šta se promenilo:</strong> sa kim je vaš ugovor kada vas je upoznalo drugo preduzeće (§2) i mikropreduzeća (§8). Ranije: ko sme da koristi Uslugu, po regionu, vlasništvu i sankcijama (§4); aplikacija tafs na Androidu i Solo kupljen preko Google Play-a (§1, §8). Pre toga: plaćeni planovi (§3A, §8), <a href="/legal/sla">ugovor o nivou usluge</a> (na engleskom) (§14) i spisak zabranjenih upotreba, koji sada živi u <a href="/acceptable-use">Politici prihvatljive upotrebe</a> (na engleskom) (§5).
		</p>
		<p class="legal-disclaimer">
			Ovi uslovi uređuju korišćenje KIFF Cloud-a, uključujući tafs. Ugovorna pitanja: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</header>
}

templ termsDefinitionsSR() {
	<section id="definitions">
		<h2>1. Definicije</h2>
		<ul>
			<li><strong>„Kiff Agents OÜ“</strong>, <strong>„mi“</strong>, <strong>„nas“</strong>, <strong>„naš“</strong> — estonsko privatno društvo sa ograničenom odgovornošću koje pruža Uslugu. Matični broj 17372313.</li>
			<li><strong>„Kupac“</strong>, <strong>„vi“</strong>, <strong>„vaš“</strong> — fizičko ili pravno lice koje prihvata ove uslove.</li>
			<li><strong>„Korisnik“</strong> — svaka osoba kojoj Kupac dozvoli pristup Usluzi preko naloga Kupca.</li>
			<li><strong>„Usluga“</strong> — proizvod KIFF Cloud, uključujući <code>api.kiff.dev</code>, <code>app.kiff.dev</code>, <code>kiff.dev</code>, tafs i dokumentaciju, kontrolne table i API-je koje tamo objavljujemo.</li>
			<li><strong>„tafs“</strong> — aplikacija tafs za iPhone, iPad, Android i računare (Mac, Windows i Linux) i usluga iza nje, uključujući Setup i planque (§3A), u kojoj Kupac poverava posao AI agentu koji radi unutar KIFF Card-ova. <strong>„taf“</strong> je jedan takav agent.</li>
			<li><strong>„Zakupac“</strong> — logički izolovan radni prostor unutar Usluge koji pripada jednom Kupcu.</li>
			<li><strong>„Revizijski podaci“</strong> — događaji, odluke, radnje, odobrenja i potvrde koje Usluga čuva u ime Kupca preko runtime-a.</li>
			<li><strong>„tafs podaci“</strong> — ono što tafs čuva u ime Kupca: izvršavanja i razgovori svakog taf-a (uključujući ono što mu vraćaju alati koje je Kupac povezao), njegovi izveštaji, beleške iz memorije i telefoni registrovani za njegova obaveštenja.</li>
			<li><strong>„Potvrda“</strong> — potpisan, verzionisan zapis odluke koji Usluga izdaje za svaku upravljanu radnju.</li>
			<li><strong>„Dokumentacija“</strong> — tehnička dokumentacija Usluge i mere bezbednosti u datiranoj reviziji povezanoj iz ovih Uslova (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>). Isključuje stratešku belu knjigu, marketinške materijale i dokumentaciju za zasebno licenciran open-source okvir.</li>
			<li><strong>„DPA“</strong> — Ugovor o obradi podataka na <a href="/legal/dpa">/legal/dpa</a> (na engleskom), koji uređuje naš odnos u svojstvu obrađivača.</li>
		</ul>
	</section>
}

templ termsAgreementSR() {
	<section id="agreement">
		<h2>2. Ugovor</h2>
		<p>
			Ovi uslovi uređuju vaše korišćenje Usluge. Otvaranjem naloga, generisanjem API ključa ili drugim korišćenjem Usluge prihvatate ove uslove. Ako prihvatate u ime kompanije ili drugog pravnog lica, izjavljujete da imate ovlašćenje da obavežete to lice, a „vi“ i „vaš“ odnose se na to lice.
		</p>
		<p>
			Ako vas je programer, partner ili drugo preduzeće upoznalo sa KIFF-om ili je napravilo agenta koji koristite, vaš ugovor o Usluzi je direktno sa nama, po ovim uslovima, i vi ih sami prihvatate. To preduzeće nije naš zastupnik: ne može da prihvati ove uslove, da da pristanak ili da odobri plaćanje umesto vas, i ne prodaje Uslugu za nas.
		</p>
		<p>
			Možemo objaviti dopunske uslove za određene funkcije (beta funkcije, integracije trećih strana). Gde su u sukobu sa ovim uslovima, dopunski uslovi važe za tu funkciju.
		</p>
	</section>
}

templ termsServiceSR() {
	<section id="service">
		<h2>3. Usluga</h2>
		<p>
			KIFF Cloud je hostovana usluga za upravljanje delegiranim radnjama. Ocenjuje zahteve prema podešenim dozvolama i Card-ovima Kupca, može zahtevati ljudsko odobrenje i beleži odluke o upravljanju. U zavisnosti od podešene integracije, KIFF prosleđuje ovlašćen zahtev ili daje ovlašćenje koje zaštićeni sistem proverava. Povezani sistem izvodi samu radnju.
		</p>
		<p>
			Primenljivo tehničko ponašanje, dokazi, zahtevi za integraciju i ograničenja izvršavanja navedeni su u datiranoj Dokumentaciji povezanoj iz ovih Uslova. Strateška <a href="/whitepaper">bela knjiga</a> (na engleskom) objašnjava KIFF-ove principe i model; nije uključena kao tehnička Dokumentacija po ovim Uslovima.
		</p>
		<p>
			KIFF Cloud-ova usluga upravljanja <em>nije</em> okvir za agente, mašina za tokove rada, gateway za modele niti upravljana platforma za agente. Radi zajedno sa onim što već koristite. Eksplicitan spisak potražite u <a href="/#not">„Šta KIFF nije“</a> (na engleskom) na početnoj stranici. tafs je jedini deo Usluge koji za vas pokreće agente, unutar Card-ova koje izdate; §3A ga opisuje.
		</p>
		<p>
			Open-source okvir <a href="https://github.com/kiff/kiff" target="_blank" rel="noopener">kiff/kiff</a> uređen je sopstvenom MIT licencom i nalazi se izvan ovih uslova. Kada okvir pokrećete na sopstvenoj infrastrukturi, ne nastaje ugovor sa Kiff Agents OÜ.
		</p>
	</section>
}

templ termsTafsSR() {
	<section id="tafs">
		<h2>3A. tafs</h2>
		<p>
			U tafs poveravate posao (na primer povraćaje, plaćanje računa ili sporove oko kartica) taf-u: AI agentu koji radi po rasporedu sa alatima koje povežete, unutar KIFF Card-ova koje za njega izdate. Svaki taf radi na našem runtime-u za agente, a AI model koji koristi obezbeđuje Anthropic. Na njegove zadržane pozive odgovarate u aplikaciji tafs.
		</p>
		<p>
			<strong>Povezivanje vaših alata.</strong> Setup, AI agent u tafs koji radi kao taf, pomaže vam da povežete alat i podesite taf za posao. Sam ništa ne povezuje. Prijavljujete se kod sopstvenog provajdera alata (na primer Stripe) i na svom uređaju odobravate svaku vezu, alate koje taf sme da koristi i njegove Card-ove. Token iz te prijave čuva planque, naša usluga povezivanja. Šifrovan je, koristi se samo za poziv o kome je KIFF odlučio i nikada se ne daje taf-u. Prekid veze alata opoziva token kod provajdera i briše ga.
		</p>
		<p>
			<strong>Vaši Card-ovi su vaša uputstva.</strong> Taf dopire do vaših alata samo preko KIFF-a, koji svaki poziv proverava prema Card-ovima taf-a pre slanja. Poziv unutar Card-a koji ste izdali upućuje se po vašem uputstvu. Poziv izvan Card-a se zadržava ili odbija, kako Card kaže. Zadržan poziv se upućuje tek pošto ga odobri neko kome vaš nalog dozvoljava da odgovara na zadržane pozive. U aplikaciji tafs odgovor nosi potpis sa njihovog uređaja koji KIFF proverava, a potvrda čuva taj dokaz. Vaš nalog može da odgovori i u samom KIFF-u (kontrolna tabla, njen alat komandne linije ili odobravalac koga tamo ovlastite); potvrda tada beleži ko je odgovorio i kako.
		</p>
		<p>
			<strong>Plaćanja.</strong> Kada taf plaća umesto vas na kasi nekog sajta, karticom ili drugim načinom plaćanja koji ste sačuvali na tom sajtu, to radi samo unutar Card i tek pošto to plaćanje odobrite na telefonu. Vaše odobrenje ovlašćuje samo to jedno plaćanje u vaše ime. Sajt i njegov pružalac usluga plaćanja ga obrađuju. KIFF i planque nikada ne drže vaš novac, nikada ne čuvaju podatke o vašoj kartici, a taf nikada ne ukucava broj kartice.
		</p>
		<p>
			<strong>Šta ostaje vama.</strong> Vi birate posao i Card-ove svakog taf-a, odgovarate na njegove zadržane pozive i brinete da smete da koristite alate i naloge koje povezujete. Izveštaje, poruke i beleške iz memorije taf-a piše AI model i oni mogu biti pogrešni; proverite ono što je važno pre nego što se na to oslonite.
		</p>
		<p>
			<strong>Zaustavljanje taf-a.</strong> Možete zaustaviti (halt) jedan taf ili sve, pauzirati taf, opozvati bilo koji njegov Card ili ga ukloniti. Od trenutka kada zaustavite taf ili opozovete Card, KIFF ne dozvoljava nijedan novi poziv pod njim. Aplikacija tafs prikazuje taf kao zaustavljen tek pošto su KIFF i planque oba potvrdili zaustavljanje; od tada planque ne šalje nijedan njegov poziv, uključujući i onaj koji je KIFF dozvolio malopre. Zahtev koji je već poslat provajderu alata može još da se završi: zaustavljamo nove pozive i ne možemo poništiti ono što je provajder već uradio. Alat koji sam proverava KIFF-ove dozvole, bez planque-a, može još da prihvati dozvolu koju je KIFF izdao malopre, najviše 90 sekundi. Nastavak zaustavljenog taf-a zahteva vaše odobrenje na vašem uređaju, a ništa što je bilo zadržano ili stavljeno u red pre zaustavljanja ne izvršava se posle njega.
		</p>
		<p>
			<strong>Uklanjanje taf-a</strong> zaustavlja njegov raspored i briše njegova izvršavanja, razgovore, memoriju i ključ koji je koristio. I pre toga, ono što vaši alati vrate taf-u čuva se samo do kraja njegovog izvršavanja (ono što je razgovor samo pročitao, šifrovano, za njegove sledeće poruke: koristi se najviše četiri sata, a zatim se briše), a njegova izvršavanja i razgovori 30 dana. KIFF čuva potvrde o onome što je uradio.
		</p>
		<p>
			<strong>Zakon EU o veštačkoj inteligenciji.</strong> Za tafs je Kiff Agents OÜ pružalac AI sistema, a vi ste njegov korisnik (deployer). Brinemo da sve što taf napiše nekome izvan vaše kompanije kaže da je to napisao AI agent. Tafs koristite samo za poslove koje nudi, a ne za upotrebu koju Zakon o AI zabranjuje ili svrstava u visokorizičnu, kao što su odluke o zaposlenju, kreditu ili pristupu osnovnim uslugama neke osobe. Zadržavate ljudska odobrenja koja vaši Card-ovi zahtevaju i brinete da ljudi koji koriste tafs za vas razumeju šta on radi i njegova ograničenja.
		</p>
		<p>
			<strong>Troškovi.</strong> tafs je deo vašeg KIFF plana (§8): svako izvršavanje taf-a troši kredite za AI koji je koristio. Coach i podešavanje taf-ova uključeni su u okviru Coach-ove poštene upotrebe.
		</p>
	</section>
}

templ termsAccountSR() {
	<section id="account">
		<h2>4. Nalozi i pristup</h2>
		<p>
			Da biste koristili Uslugu, morate otvoriti nalog. Pristajete da dajete tačne podatke pri registraciji, da čuvate svoje akreditive poverljivim i da odgovarate za svu aktivnost pod vašim nalogom.
		</p>
		<p>
			Morate imati najmanje 16 godina ili uzrast za digitalni pristanak u vašoj jurisdikciji, šta god je veće. Usluga nije namenjena deci.
		</p>
		<p>
			Usluga se nudi samo u zemljama i regionima u kojima Anthropic, koji obezbeđuje njen AI model, nudi sopstvenu uslugu, kako <a href="https://www.anthropic.com/supported-countries">Anthropic navodi</a>. Ne smete je koristiti ni iz jednog drugog mesta. Kompanija je ne sme koristiti ako joj je sedište, ili sedište kompanije koja je većinski poseduje ili kontroliše, u zemlji ili regionu izvan te liste, bez obzira na to gde su njeni korisnici. Ne smete je koristiti ni ako ste vi ili kompanija za koju je koristite predmet sankcija Evropske unije, Ujedinjenih nacija ili Sjedinjenih Država. Odbijamo naloge koji krše ovo pravilo i možemo suspendovati nalog koji ga krši.
		</p>
		<p>
			Odgovorni ste za radnje svakog Korisnika koga ovlastite na svom nalogu. Možemo suspendovati nalog ili opozvati pristup uz razumno obaveštenje ako otkrijemo verodostojno kršenje ovih uslova. Za kršenja prihvatljive upotrebe (pogledajte §5) suspenzija može biti trenutna.
		</p>
	</section>
}

templ termsAcceptableUseSR() {
	<section id="acceptable-use">
		<h2>5. Prihvatljiva upotreba</h2>
		<p>
			Vi, vaši korisnici i vaši agenti morate poštovati <a href="/acceptable-use">Politiku prihvatljive upotrebe</a> (na engleskom). Ona je deo ovih uslova i navodi za šta se Usluga ne sme koristiti.
		</p>
		<p>
			Možemo odmah suspendovati zbog verodostojnog kršenja Politike prihvatljive upotrebe. Nismo dužni da pratimo sadržaj Kupca, ali možemo postupiti po verodostojnim prijavama.
		</p>
	</section>
}

templ termsCustomerDataSR() {
	<section id="customer-data">
		<h2>6. Podaci i sadržaj Kupca</h2>
		<p>
			Vi ste vlasnik svojih Revizijskih podataka. Kiff Agents OÜ dajete ograničenu, neisključivu, besplatnu, svetsku licencu da hostuje, kopira, prenosi, prikazuje i na drugi način obrađuje vaše Revizijske podatke isključivo koliko je neophodno da za vas pokreće, održava i poboljšava Uslugu.
		</p>
		<p>
			Delujemo kao <strong>obrađivač</strong> vaših Revizijskih podataka i vaših tafs podataka prema članu 28 GDPR-a; <a href="/legal/dpa">DPA</a> (na engleskom) detaljno uređuje taj odnos. Delujemo kao <strong>rukovalac</strong> metapodataka vašeg naloga; <a href="/sr/privacy">politika privatnosti</a> uređuje taj odnos.
		</p>
		<p>
			Izjavljujete da imate sva prava potrebna za podnošenje podataka koje podnosite i da je podnošenje u skladu sa primenljivim zakonima (uključujući zakone o zaštiti podataka i, gde se primenjuje, Zakon EU o veštačkoj inteligenciji).
		</p>
	</section>
}

templ termsConfidentialitySR() {
	<section id="confidentiality">
		<h2>7. Poverljivost</h2>
		<p>
			Svaka strana može primiti nejavne informacije od druge („Poverljive informacije“). Strana koja prima koristiće Poverljive informacije samo koliko je potrebno za izvršavanje svojih obaveza i ostvarivanje svojih prava po ovim uslovima i štitiće ih najmanje istom pažnjom kojom štiti sopstvene poverljive informacije.
		</p>
		<p>
			Poverljive informacije ne uključuju informacije koje (a) jesu ili postanu javno dostupne bez povrede, (b) su strani koja prima bile poznate pre otkrivanja, (c) su nezavisno razvijene bez korišćenja Poverljivih informacija ili (d) moraju biti otkrivene po zakonu (uz obaveštenje drugoj strani gde je dozvoljeno).
		</p>
	</section>
}

templ termsFeesSR() {
	<section id="fees">
		<h2>8. Naknade i plaćanje</h2>
		<p>
			<strong>Planovi.</strong> Svaki nalog ima jedan plan. Trenutne cene su na <a href="/pricing">stranici sa cenama</a> (na engleskom); u trenutku ove izmene:
		</p>
		<ul>
			<li><strong>Solo:</strong> jedna osoba, za tafs, prodaje se u aplikaciji tafs preko App Store-a ili Google Play-a po ceni od 12,50 € mesečno, sa uključenim PDV-om, sa 500 uključenih kredita mesečno.</li>
			<li><strong>Company:</strong> 10,50 € mesečno po mestu, sa 500 kredita mesečno po mestu, objedinjenih, i, za pozive vaših sopstvenih agenata preko KIFF Cloud-a, 500 radnji mesečno po mestu, objedinjenih.</li>
			<li><strong>Ugovor:</strong> naknade i uslovi iz njegovog obrasca porudžbine.</li>
		</ul>
		<p>
			Mesta su administratori i urednici naloga. Odobravaoci i posmatrači su besplatni u svakom planu. U planu Company, preko uključenog, kredit košta 0,01 €, a radnja 0,02 €. Krediti preko uključenih naplaćuju se do mesečnog limita potrošnje koji nalog podesi (50 € na početku): na limitu KIFF ne pokreće nijedno novo izvršavanje tafs-a naloga dok ne počne sledeći period ili dok ga neko ko upravlja naplatom ne podigne.
		</p>
		<p>
			<strong>Paketi kredita.</strong> U planu Solo, krediti preko mesečno uključenih dolaze iz paketa kredita, koji se kupuju u aplikaciji tafs. Paket se kupuje jednom, ne ističe i nije pretplata; njegovi krediti se troše posle mesečno uključenih, najstariji paket prvi. Paket čije je plaćanje u celosti vraćeno oduzima se, zajedno sa kreditima koji su mu ostali. Kada se potroše mesečni krediti i paketi, KIFF ne pokreće nijedno novo izvršavanje tafs-a naloga dok ne počne sledeći period ili se doda paket. Bonus krediti koje KIFF dodaje nalogu takođe ne ističu, kao i paketi.
		</p>
		<p>
			<strong>Šta se računa.</strong> <em>Kredit</em> plaća AI koji je izvršavanje taf-a upotrebilo, u celim kreditima, zaokruženo naviše jednom po izvršavanju i računa se jednom, kada se izvršavanje završi. Izvršavanje čiji je poziv KIFF odbio ipak je upotrebilo svoj AI. Nikada se ne računaju: Coach i podešavanje tafs-a, u okviru Coach-ove poštene upotrebe; probna verzija nove verzije, koja ništa ne šalje; i izvršavanje koje je propalo na našoj strani. <em>Radnja</em> je poziv vašeg sopstvenog agenta preko KIFF Cloud-a koji je nešto obavio: KIFF ga je dozvolio, poslat je i alat je javio uspeh. Nikada se ne računa kao radnja: poziv koji je odbijen, zadržan pa odbijen, zaustavljen zaustavljanjem (halt), nevažeći, propao kod alata ili čiji je ishod nepoznat, kao ni poziv koji samo čita.
		</p>
		<p>
			<strong>Bez probnog perioda.</strong> Nalog plaća od prvog dana. Pre nego što plan počne, KIFF ne pokreće nijedno izvršavanje svojih tafs-a, osim Coach-ovog podešavanja; ništa se ne briše.
		</p>
		<p>
			<strong>Plaćanje i fakture.</strong> Plan se naplaćuje na jednom mestu. Plan kupljen na kiff.dev kupuje se, menja i otkazuje tamo i u portalu za naplatu na koji vodi, a njegova plaćanja obrađuje Stripe. Solo kupljen u aplikaciji tafs prodaje se preko App Store-a na iPhone-u i iPad-u ili Google Play-a na Androidu i njime se upravlja u vašim Apple pretplatama ili Google Play pretplatama, po uslovima te prodavnice za plaćanje, obnavljanje i povraćaj. Paketi kredita kupuju se u aplikaciji. Company se kupuje na kiff.dev. Naknade se naplaćuju mesečno unapred; upotreba preko uključene naplaćuje se sa sledećom fakturom. Promena broja osoba važi od sledeće fakture. Ako plaćanje ne uspe i ne bude izmireno, plan se završava i KIFF odbija pozive naloga dok se ne izabere plan.
		</p>
		<p>
			<strong>Otkazivanje.</strong> Možete otkazati u bilo kom trenutku u portalu za naplatu ili, za Solo kupljen u aplikaciji, u svojim Apple pretplatama ili Google Play pretplatama. Plan traje do kraja perioda koji ste platili i ne obnavlja se. Osim ako zakon ne zahteva drugačije, već plaćene naknade se ne vraćaju. Ako ste potrošač u EU, možete odustati u roku od 14 dana od kupovine bez navođenja razloga, a mi vraćamo ono što ste platili umanjeno za deo za dane koje je plan već trajao. Kupovine Solo-a vraćaju se preko App Store-a ili Google Play-a, po njihovim uslovima.
		</p>
		<p>
			<strong>Mikropreduzeća.</strong> Ako vaše preduzeće ima manje od 10 ljudi i godišnji promet ili zbir bilansa stanja od najviše 2 miliona €, tretiramo ga kao potrošača za svako pravilo u ovim uslovima o plaćanjima karticom, uključujući Company.
		</p>
		<p>
			<strong>PDV.</strong> Cene plana Company ne uključuju PDV; Solo i pakete kredita prodaju App Store ili Google Play sa uključenim PDV-om. Kiff Agents OÜ (PDV broj EE102924327) dodaje estonski PDV gde se primenjuje. Prodaja između preduzeća u EU Kupcu izvan Estonije sa važećim identifikacionim brojem za PDV fakturiše se po EU mehanizmu obrnutog obračuna.
		</p>
		<p>
			<strong>Izmene.</strong> Aktivnim nalozima dajemo pisano obaveštenje od najmanje trideset dana o povećanju cene (§16). Smanjenje cene važi od sledeće fakture.
		</p>
	</section>
}

templ termsTermSR() {
	<section id="term">
		<h2>9. Trajanje i raskid</h2>
		<p>
			Ovi uslovi stupaju na snagu kada prvi put koristite Uslugu i traju do raskida.
		</p>
		<p>
			Možete raskinuti u bilo kom trenutku brisanjem naloga. Mi možemo raskinuti (a) zbog bitne povrede koja nije otklonjena u roku od trideset dana od pisanog obaveštenja ili (b) odmah zbog kršenja prihvatljive upotrebe ili slučajeva nesolventnosti.
		</p>
		<p id="leaving">
			<strong>Odlazak i nošenje svojih podataka sa sobom.</strong> Svoje podatke možete izvesti u bilo kom trenutku, u strukturisanom, mašinski čitljivom formatu: u KIFF-u, Podešavanja → Podaci daju JSON datoteku sa vašim nalogom, vašim Card-ovima sa svakom verzijom, odlukama u vašem Zapisu (poslednjih 10.000; tražite nas za više), potpisanom potvrdom svake koju je KIFF dozvolio i pojedinostima vaših API ključeva (nikada samim ključevima). U aplikaciji tafs svaka osoba izvozi sopstvene razgovore, datoteke i beleške iz Nalog → Izvezi moje razgovore; razgovori se u svakom slučaju čuvaju trideset dana, kako politika privatnosti kaže. Brisanje naloga odmah okončava Uslugu, pa prvo izvezite.
		</p>
		<p>
			Umesto toga možete otići uz otkazni rok, radi prelaska kod drugog provajdera ili na sopstvene sisteme, pisanjem na <a href="mailto:support@kiff.dev">support@kiff.dev</a>. Nikada ne tražimo više od dva meseca otkaznog roka: vaše obaveštenje stupa na snagu na datum koji izaberete, najkasnije dva meseca pošto ga pošaljete. Od tog datuma sledi prelazni period od trideset dana, u kome Usluga nastavlja da radi, vi izvozite svoje podatke i premeštate svoj rad, a mi pomažemo oko razumnih zahteva za to. Prelazni period možete jednom produžiti, koliko god vam je potrebno. Ako ga tehnički ne možemo završiti za trideset dana, obavestićemo vas u roku od četrnaest radnih dana od vašeg obaveštenja, sa razlozima i novim periodom od najviše sedam meseci. Posle prelaznog perioda, vaši podaci ostaju dostupni za izvoz još najmanje trideset dana. Naknade plana teku kao i obično do kraja prelaznog perioda. Solo kupljen u App Store-u ili na Google Play-u otkazuje se u prodavnici; periodi prelaza i izvoza primenjuju se na isti način.
		</p>
		<p>
			Ne naplaćujemo odlazak, prelazak ni izvoz podataka. Ovaj odeljak daje svakom kupcu prava na prelazak iz Poglavlja VI Zakona EU o podacima (Uredba (EU) 2023/2854).
		</p>
		<p>
			Po raskidu, i posle bilo kog prelaznog perioda i perioda izvoza, brišemo vaše Revizijske podatke, vaše tafs podatke i metapodatke naloga u skladu sa pravilima o čuvanju u <a href="/sr/privacy#retention">politici privatnosti</a>.
		</p>
		<p>
			Odeljci koji po svojoj prirodi treba da prežive raskid prežive — uključujući poverljivost, intelektualnu svojinu, obeštećenje, ograničenje odgovornosti, odricanja, merodavno pravo i sve dospele naknade.
		</p>
	</section>
}

templ termsWarrantiesSR() {
	<section id="warranties">
		<h2>10. Garancije</h2>
		<p>
			Svaka strana izjavljuje da ima pravo i ovlašćenje da zaključi i izvršava ove uslove.
		</p>
		<p>
			Garantujemo da ćemo Uslugu pružati profesionalno i u suštinskoj saglasnosti sa Dokumentacijom. Vaš jedini lek za povredu ove garancije je, po našem izboru, ponovno izvršenje ili srazmeran povraćaj naknada koje se odnose na pogođenu Uslugu za period povrede.
		</p>
		<p>
			Garantujete da je vaše korišćenje Usluge u skladu sa primenljivim pravom i ovim uslovima.
		</p>
	</section>
}

templ termsDisclaimerSR() {
	<section id="disclaimer">
		<h2>11. Odricanje</h2>
		<p>
			Osim izričitih garancija iz §10, Usluga se pruža <strong>„onakva kakva jeste“ i „kako je dostupna“</strong>. U najvećoj meri dozvoljenoj zakonom odričemo se svih drugih garancija, izričitih, podrazumevanih ili zakonskih, uključujući garancije utrživosti, podobnosti za određenu svrhu, nepovređivanja i svake garancije koja proizlazi iz poslovne prakse ili običaja u trgovini.
		</p>
		<p>
			Ne garantujemo da će Usluga biti neprekidna, bez grešaka ili bez štetnih komponenti, niti da podaci neće biti izgubljeni ili oštećeni. Vi ste odgovorni za pravljenje rezervnih kopija svojih podataka.
		</p>
	</section>
}

templ termsLiabilitySR() {
	<section id="liability">
		<h2>12. Ograničenje odgovornosti</h2>
		<p>
			U najvećoj meri dozvoljenoj zakonom nijedna strana neće odgovarati drugoj za bilo kakvu indirektnu, slučajnu, posledičnu, posebnu, uzornu ili kaznenu štetu, uključujući izgubljenu dobit, izgubljen prihod, izgubljene podatke ili prekid poslovanja, koja proizlazi iz ovih uslova ili Usluge ili je u vezi s njima, čak i ako je upozorena na mogućnost takve štete.
		</p>
		<p>
			Ukupna odgovornost svake strane koja proizlazi iz ovih uslova ili je u vezi s njima neće premašiti veći iznos od (a) naknada koje je Kupac platio ili treba da plati Kiff Agents OÜ u dvanaest meseci pre događaja koji je doveo do odgovornosti ili (b) sto hiljada evra (100.000 €).
		</p>
		<p>
			Ništa u ovim uslovima ne ograničava niti isključuje odgovornost koja se po primenljivom pravu ne može ograničiti niti isključiti, uključujući odgovornost za smrt, telesnu povredu prouzrokovanu nepažnjom, prevaru ili namerno nedolično postupanje, i odgovornost za neispravan proizvod po zakonima kojima se sprovodi Direktiva (EU) 2024/2853 o odgovornosti za neispravne proizvode.
		</p>
	</section>
}

templ termsIndemnitySR() {
	<section id="indemnification">
		<h2>13. Obeštećenje</h2>
		<p>
			Branićemo vas od zahteva trećih strana da Usluga, kako je mi pružamo, a vi koristite u skladu sa ovim uslovima, krši prava intelektualne svojine te treće strane i platićemo štetu koja vam je pravnosnažno dosuđena (ili dogovoreni iznos poravnanja) za takve zahteve.
		</p>
		<p>
			Vi ćete braniti nas od zahteva trećih strana koji proizlaze iz (a) vaših podataka ili sadržaja Kupca; (b) vašeg korišćenja Usluge uz kršenje ovih uslova (uključujući Politiku prihvatljive upotrebe); ili (c) vaše grube nepažnje ili namernog nedoličnog postupanja i platićete štetu koja nam je pravnosnažno dosuđena (ili dogovoreni iznos poravnanja) za takve zahteve.
		</p>
		<p>
			Obeštećenje je uslovljeno hitnim obaveštenjem o zahtevu, isključivom kontrolom odbrane i poravnanja od strane davaoca obeštećenja i razumnom saradnjom primaoca obeštećenja. Davalac obeštećenja ne sme da poravna zahtev koji primaocu obeštećenja nameće obaveze bez saglasnosti.
		</p>
	</section>
}

templ termsSLASR() {
	<section id="sla">
		<h2>14. Obaveza nivoa usluge</h2>
		<p>
			U plaćenom planu, <a href="/legal/sla">ugovor o nivou usluge</a> (na engleskom) određuje dostupnost koju obećavamo, kako se računa spor ili neuspešan zahtev, naše rokove odgovora podrške i kredite za uslugu kada zaostanemo. On je deo ovih uslova.
		</p>
		<p>
			Operativne prakse, odgovor na incidente i obaveze obaveštavanja o povredama dokumentovani su u datiranoj reviziji povezanoj iz ovih Uslova (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>); <a href="/security">/security</a> (na engleskom) prikazuje aktuelne prakse.
		</p>
	</section>
}

templ termsServiceModsSR() {
	<section id="service-mods">
		<h2>15. Izmene Usluge</h2>
		<p>
			Možemo dodavati, menjati ili uklanjati funkcije u bilo kom trenutku. O bitnim smanjenjima funkcionalnosti ili ukidanju API površine koje narušava dokumentovano ponašanje obaveštavamo aktivne kupce najmanje trideset dana unapred, uz objavljen raspored ukidanja. Izmene vođene bezbednošću mogu se izvršiti bez obaveštenja gde bi samo obaveštenje stvorilo rizik.
		</p>
	</section>
}

templ termsTermsModsSR() {
	<section id="terms-mods">
		<h2>16. Izmene ovih uslova</h2>
		<p>
			Povremeno možemo menjati ove uslove. O bitnim izmenama obaveštavamo e-poštom i istaknutim banerom na ovoj stranici najmanje trideset dana unapred. Nebitne izmene (pojašnjenja, reference) objavljuju se sa novim datumom „poslednjeg ažuriranja“. Vaše nastavljeno korišćenje Usluge posle datuma stupanja izmene na snagu predstavlja prihvatanje.
		</p>
	</section>
}

templ termsForceMajeureSR() {
	<section id="force-majeure">
		<h2>17. Viša sila</h2>
		<p>
			Nijedna strana ne odgovara za neizvršenje ili kašnjenje u izvršenju u meri u kojoj ga uzrokuju okolnosti van njene razumne kontrole, uključujući više silu, rat, terorizam, građanske nemire, radne sporove, požar, elementarne nepogode, vladine mere povezane sa pandemijom, prekide interneta ili struje ili radnje telekomunikacionih provajdera ili infrastrukture hostinga trećih strana.
		</p>
	</section>
}

templ termsGoverningLawSR() {
	<section id="governing-law">
		<h2>18. Merodavno pravo i nadležnost</h2>
		<p>
			Ovi uslovi su uređeni zakonima Republike Estonije, bez obzira na njena pravila o sukobu zakona. Isključivo nadležan za sporove je Okružni sud Harju u Talinu.
		</p>
		<p>
			Ako ste potrošač sa prebivalištem u drugoj državi članici EU, obavezna pravila o zaštiti potrošača vaše matične jurisdikcije nastavljaju da se primenjuju u meri u kojoj vam daju prava kojih se ne možete odreći ugovorom; ova odredba vas ne lišava zaštite tih pravila.
		</p>
	</section>
}

templ termsGeneralSR() {
	<section id="general">
		<h2>19. Opšte odredbe</h2>
		<p>
			<strong>Ceo sporazum.</strong> Ovi uslovi, zajedno sa politikom privatnosti, DPA, svim porudžbenicama i svim dopunskim uslovima koji su izričito uključeni, čine ceo sporazum među nama o svom predmetu i zamenjuju svako prethodno ili istovremeno razumevanje.
		</p>
		<p>
			<strong>Odvojivost.</strong> Ako se odredba proglasi neprimenljivom, ostale ostaju na snazi.
		</p>
		<p>
			<strong>Ustupanje.</strong> Ne smete ustupiti ove uslove bez naše pisane saglasnosti. Mi možemo ustupiti bez saglasnosti u vezi sa spajanjem, preuzimanjem ili prodajom celokupne ili u suštini cele naše imovine, uz obaveštenje vama.
		</p>
		<p>
			<strong>Bez odricanja.</strong> Propust da se sprovede neka odredba ne predstavlja odricanje od prava da se ona kasnije sprovede.
		</p>
		<p>
			<strong>Obaveštenja.</strong> Obaveštenja za Kiff Agents OÜ šalju se na <a href="mailto:legal@kiff.dev">legal@kiff.dev</a> ili poštom na adresu Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estonija. Obaveštenja vama šalju se na e-poštu povezanu sa vašim nalogom ili, ako ste dali, na vašu određenu adresu za pravna obaveštenja.
		</p>
		<p>
			<strong>Nezavisni izvođači.</strong> Ništa u ovim uslovima ne stvara ortakluk, zastupanje, zajedničko ulaganje ni radni odnos.
		</p>
		<p>
			<strong>Treće strane korisnici.</strong> Nema ih, osim u meri u kojoj su pridružena lica koja se obeštećuju izričito navedena.
		</p>
	</section>
}

templ termsContactSR() {
	<section id="contact">
		<h2>20. Kontaktirajte nas</h2>
		<p>
			Komercijalna i ugovorna pitanja: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
		<p>
			Opšta pitanja o proizvodu: <a href="mailto:hello@kiff.dev">hello@kiff.dev</a>. Pitanja o privatnosti: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>. Prijave bezbednosnih ranjivosti: <a href="mailto:security@kiff.dev">security@kiff.dev</a>.
		</p>

		<hr/>

		<p class="legal-footnote">
			<strong>Verzija dokumenta:</strong> v0.1.<br/> <strong>Poslednje ažuriranje:</strong> 22. novembar 2026.
		</p>
	</section>
}
