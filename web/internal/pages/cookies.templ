package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// Cookies renders the Cookie Policy at /cookies: every cookie kiff.dev
// and app.kiff.dev set, what each is for and how long it lasts, the
// sign-in provider's cookies, and the browser storage the pages use.
// Built from the cookies the web binary sets (the session, the one-shot
// flash, the sign-in loop guard) and the storage keys its scripts use.
// If a new cookie or storage key is added, add it here.
//
// Draft for legal review. Keep public text free of private repository
// links, internal review notes, and source paths.
templ Cookies() {
	@components.LayoutSite("KIFF — cookie policy", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@cookiesHead()
			@cookiesSummary()
			@cookiesOurs()
			@cookiesSignIn()
			@cookiesStorage()
			@cookiesControl()
		</article>
	}
}

templ cookiesHead() {
	<header class="legal-head">
		<p class="legal-badge">Cookie policy · v0.1</p>
		<h1>Cookie Policy</h1>
		<p class="legal-meta">
			<strong>Last updated:</strong> 23 October 2026.
		</p>
		<p class="legal-disclaimer">
			Which cookies <code>kiff.dev</code> and
			<code>app.kiff.dev</code> set, what each one is for, and how
			long it lasts. The <a href="/privacy">privacy policy</a>
			covers the rest of the personal data we process. Questions:
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</header>
}

templ cookiesSummary() {
	<section id="summary">
		<h2>1. In short</h2>
		<p>
			We set no analytics cookies, no advertising cookies, and
			no third-party trackers. The cookies below exist only to
			sign you in and keep the dashboard working. They are
			strictly necessary, so they need no consent, and there is
			no cookie banner. If we ever add a cookie that is not
			strictly necessary, we will ask for your consent before
			setting it.
		</p>
		<p>
			Reading the public pages of <code>kiff.dev</code> without
			signing in sets no cookie.
		</p>
	</section>
}

templ cookiesOurs() {
	<section id="ours">
		<h2>2. Our cookies</h2>
		<div class="legal-table" tabindex="0">
			<table>
				<thead>
					<tr>
						<th>Cookie</th>
						<th>What it is for</th>
						<th>How long it lasts</th>
					</tr>
				</thead>
				<tbody>
					<tr id="kiff-session">
						<td><code>kiff_session</code></td>
						<td>Keeps you signed in. It carries who you are (your sign-in id, email and name) and the credential the dashboard uses for you. Signed, so it can't be changed, and not readable by scripts</td>
						<td>24 hours, or until you sign out</td>
					</tr>
					<tr id="kiff-flash">
						<td><code>kiff_flash</code></td>
						<td>Carries a one-time message to the next page, such as "your key was made". Signed. A new key is never in it</td>
						<td>Deleted when the next page reads it, and at most 5 minutes</td>
					</tr>
					<tr id="kiff-cb-attempts">
						<td><code>kiff_cb_attempts</code></td>
						<td>Counts how often the sign-in page has reloaded, so a sign-in that loops is stopped. Sent only to that page</td>
						<td>5 minutes, and cleared when a sign-in starts or succeeds</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p>
			All three are first-party, sent only over HTTPS, and
			unreadable by scripts on the page.
			<code>kiff_session</code> and <code>kiff_flash</code> are set
			for <code>.kiff.dev</code>, so both <code>kiff.dev</code> and
			<code>app.kiff.dev</code> receive them.
		</p>
	</section>
}

templ cookiesSignIn() {
	<section id="sign-in">
		<h2>3. Our sign-in provider's cookies</h2>
		<p>
			We use Clerk for sign-in (see the
			<a href="/subprocessors#clerk">subprocessors</a>). When you
			sign in, Clerk sets its own sign-in cookies, on our site and
			on Clerk's domain for us, <code>clerk.kiff.dev</code>. They
			are strictly necessary for signing in, and they are not used
			for analytics or advertising. Clerk's
			<a href="https://clerk.com/docs/guides/how-clerk-works/cookies" target="_blank" rel="noopener">cookie documentation</a>
			describes each one and how long it lasts.
		</p>
	</section>
}

templ cookiesStorage() {
	<section id="storage">
		<h2>4. What stays in your browser</h2>
		<p>
			A few pages remember a choice in your browser's storage
			instead of a cookie. It is never sent to us.
		</p>
		<ul>
			<li><code>kiff-theme</code>: the light or dark theme you picked in the dashboard. Kept until you clear it.</li>
			<li><code>kiff.gatewayFormat</code>: the last format you picked when connecting an agent. Kept until you clear it.</li>
			<li><code>kiff-demo-tour-step</code>, <code>kiff-demo-tour-active</code> and <code>kiff-demo-theme-touched</code>: where you are in the interactive demo. Gone when you close the tab.</li>
		</ul>
	</section>
}

templ cookiesControl() {
	<section id="control">
		<h2>5. Your choices</h2>
		<p>
			You can block or delete cookies in your browser's settings.
			If you block ours or Clerk's, you can still read the public
			site, but you can't sign in. Signing out deletes
			<code>kiff_session</code>.
		</p>
		<p>
			If we change the cookies we set, we update this page and
			its date.
		</p>

		<hr/>

		<p class="legal-footnote">
			<strong>Document version:</strong> v0.1.<br/>
			<strong>Last updated:</strong> 23 October 2026.
		</p>
	</section>
}
