package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsPrivacyTH is tafs's privacy policy (/tafs/privacy) in Thai, at /th/tafs/privacy.
// It is a translation of TafsPrivacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Thai has the legal
// texts only, so a link to any other page goes to English and says so.
templ TafsPrivacyTH() {
	@components.LayoutSiteWithMeta("นโยบายความเป็นส่วนตัวของ tafs", "วิธีที่ tafs แอปของ KIFF จัดการข้อมูลส่วนบุคคล รวมถึงข้อมูลที่ได้รับจาก Google เมื่อคุณเชื่อมต่อบัญชี Google ของคุณ", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · นโยบายความเป็นส่วนตัว</p>
				<h1>นโยบายความเป็นส่วนตัวของ tafs</h1>
				<p class="legal-meta"><strong>อัปเดตล่าสุด:</strong> 22 พฤศจิกายน ค.ศ. 2026</p>
				<p class="legal-disclaimer">นโยบายนี้อธิบายวิธีที่ tafs แอปของ KIFF สำหรับ iPhone, iPad, Android และคอมพิวเตอร์ จัดการข้อมูลส่วนบุคคล tafs เป็นส่วนหนึ่งของ KIFF Cloud ดังนั้น <a href="/th/privacy">นโยบายความเป็นส่วนตัวของ KIFF</a> จึงใช้กับ tafs ด้วย และกับสิ่งใดที่หน้านี้ไม่ครอบคลุม คำถาม: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a></p>
			</header>
			<section id="who-we-are">
				<h2>1. เราคือใคร</h2>
				<p>tafs ให้บริการโดย <strong>Kiff Agents OÜ</strong> บริษัทจำกัดเอกชนที่จดทะเบียนในเอสโตเนีย (รหัสทะเบียน 17372313 หมายเลข VAT EE102924327) ที่อยู่ Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estonia ระเบียบการคุ้มครองข้อมูลส่วนบุคคลของสหภาพยุโรป (GDPR) ใช้กับการประมวลผลของเรา</p>
			</section>
			<section id="scope">
				<h2>2. นโยบายนี้ครอบคลุมอะไร</h2>
				<p>แอป tafs สำหรับ iPhone, iPad, Android และคอมพิวเตอร์ (Mac, Windows และ Linux) และบริการเบื้องหลัง รวมถึง Setup ที่เชื่อมต่อเครื่องมือของบริษัท และ planque ที่เก็บการเชื่อมต่อเหล่านั้น ใน tafs บริษัทมอบงานให้เอเจนต์ AI หรือ taf ที่ทำงานภายใน KIFF Card</p>
			</section>
			<section id="roles">
				<h2>3. บทบาทของเรา</h2>
				<p>เราเป็น<strong>ผู้ควบคุมข้อมูลส่วนบุคคล</strong>ของบัญชีและข้อมูลการลงชื่อเข้าใช้ของคุณ และของข้อมูลการดำเนินงานของบริการของเราเอง เราทำหน้าที่เป็น<strong>ผู้ประมวลผลข้อมูลส่วนบุคคล</strong> ในนามบริษัทของคุณ สำหรับสิ่งที่ tafs เก็บไว้ให้บริษัท: การทำงาน แชต รายงาน บันทึกความจำของ taf แต่ละตัว และไฟล์ที่ taf ส่งมอบ บริษัทของคุณเป็นผู้ควบคุมข้อมูลนั้น และ <a href="/legal/dpa">DPA</a> (ภาษาอังกฤษ) กำกับความสัมพันธ์นั้น</p>
			</section>
			<section id="data">
				<h2>4. tafs เก็บอะไร</h2>
				<ul>
					<li><strong>บัญชีของคุณ:</strong> คุณลงชื่อเข้าใช้ tafs ด้วยบัญชี KIFF บนโทรศัพท์หรือแท็บเล็ต แอปเก็บเซสชันของคุณใน Keychain ของอุปกรณ์ (บน Android คือที่เก็บที่เข้ารหัส) บนคอมพิวเตอร์ แอปเก็บเซสชันแบบผนึกสำหรับบัญชีผู้ใช้ของคุณ: บน PC Windows ด้วยการปกป้องข้อมูลของ Windows เอง บน Linux ใน keyring ของคุณ บน Mac ใน Keychain เซสชันของคอมพิวเตอร์มีอายุไม่เกิน 90 วัน</li>
					<li><strong>อุปกรณ์ของคุณ:</strong> แอปสร้างกุญแจลงนามที่ไม่เคยออกจากอุปกรณ์: ใน Secure Enclave ของ iPhone, iPad หรือ Mac, Keystore ของอุปกรณ์ Android หรือ TPM ของ PC Windows บน Linux และบน Mac ที่ไม่มี Secure Enclave กุญแจเป็นกุญแจซอฟต์แวร์ที่เก็บใน keyring หรือ Keychain ของคุณ และคอมพิวเตอร์เครื่องนั้นแสดงสิ่งที่รอคุณได้แต่อนุมัติไม่ได้ คุณอนุมัติบนโทรศัพท์ของคุณ{ macSecurityKey("th") } PC Windows ที่ไม่มี TPM ลงชื่อเข้าใช้ tafs ไม่ได้ KIFF เก็บครึ่งสาธารณะของกุญแจ ชื่อและแพลตฟอร์มของอุปกรณ์ และเวลาที่เพิ่มและใช้ครั้งล่าสุด เพื่อตรวจสอบคำตอบของคุณต่อการเรียกที่ถูกพักไว้และการอนุมัติการเชื่อมต่อของคุณ</li>
					<li><strong>นาฬิกาของคุณ:</strong> นาฬิกาไม่เก็บรหัสผ่านหรือกุญแจ คุยกับโทรศัพท์ที่จับคู่ของคุณเท่านั้น และไม่เคยอนุมัติ นาฬิกาส่งสิ่งที่คุณพูดไปยัง Coach หรือ taf ที่คุณเลือก เป็นข้อความเท่านั้น ผ่านโทรศัพท์ หลังจากที่คุณอนุญาต AI แล้ว บริการเสียงพูดของนาฬิกาเอง ของ Apple หรือ Google แปลงคำพูดของคุณเป็นข้อความนั้น บน Wear OS หากหยุดก่อนที่คุณพูดจบ ตัวรู้จำเสียงของโทรศัพท์คุณเองทำแทน บนโทรศัพท์ นาฬิกาปฏิเสธ หยุด หรือส่งไปยัง Coach หรือ taf ได้เฉพาะเมื่อมีล็อกหน้าจอหรือรหัสผ่านและปลดล็อกอยู่ สิ่งที่คุณส่งให้ taf เข้าไปในแชตของ taf นั้นเอง เหมือนคุณเขียนบนโทรศัพท์ แชตของ taf รวมถึงจำนวนเงิน แสดงบนนาฬิกาเฉพาะเมื่อเปิดอยู่ อ่านผ่านโทรศัพท์ทุกครั้ง นาฬิกาไม่เก็บสิ่งใดไว้</li>
					<li><strong>Apple Watch:</strong> แสดง taf ของคุณและหน้าของ taf โดยไม่เก็บไว้ เก็บเฉพาะกล่องข้อความของคุณ ในไฟล์ที่อ่านไม่ได้ขณะล็อก: การเรียกที่ถูกพักไว้แต่ละรายการเป็นชื่อ taf และสิ่งที่ขอ ไม่เคยเป็นจำนวนเงิน และคำตอบของ Coach ต่อสิ่งที่คุณส่งจากนาฬิกา เป็นข้อความ หากคุณลงชื่อออกบนนาฬิกา นาฬิกาจะเก็บด้วยว่าคุณทำเช่นนั้น จนกว่าคุณจะลงชื่อเข้าใช้อีกครั้งบนนาฬิกา นอกจากนั้นไม่เก็บสิ่งใดเว้นแต่นาฬิกามีรหัสผ่าน กล่องข้อความหายไปเมื่อคุณลงชื่อออกบนนาฬิกาหรือ iPhone ของคุณลงชื่อออก หรือครั้งถัดไปที่แอปเปิดหรือปิดโดยไม่มีรหัสผ่าน ไม่มีการบันทึกเสียง และการแจ้งเตือนเดียวที่แสดงคือของ iPhone ของคุณ</li>
					<li><strong>Wear OS:</strong> แสดงอีเมลของบัญชีคุณและปฏิทินของวันนี้โดยไม่เก็บไว้ เพื่อให้เปิดได้ทันที นาฬิกาเก็บแบบเข้ารหัสซึ่งจำนวนสิ่งที่รอคุณ และชื่อ taf แต่ละตัวพร้อมสถานะว่าถูกหยุดหรือพักอยู่หรือไม่: ไม่เคยเป็นจำนวนเงิน รายละเอียดของการเรียกที่ถูกพักไว้ หรือแชตของ taf ข้อมูลนี้ถูกล้างเมื่อคุณลงชื่อออก เมื่อนาฬิกาล็อกหรือถูกถอดออกจากข้อมือ และหลัง 24 ชั่วโมง นาฬิกาเก็บกล่องข้อความของคุณ ซึ่งแต่ละบรรทัดเป็นชื่อ taf และสิ่งที่ taf พูด ไม่เคยเป็นจำนวนเงิน และข้อความหนึ่งข้อความที่เก็บไว้ส่งทีหลัง เป็นข้อความ การลงชื่อออก บนนาฬิกาหรือบนโทรศัพท์ ล้างทั้งหมด สำหรับไทล์ (tile) ของนาฬิกา เก็บจำนวนสิ่งที่รอคุณด้วย แสดงเฉพาะเมื่อนาฬิกาปลดล็อก และล้างเมื่อคุณลงชื่อออก หรือครั้งถัดไปที่ไทล์แสดงขณะนาฬิกาล็อกหรือไม่มีล็อกหน้าจอ หลังจากคุณลงชื่อออกบนนาฬิกา นาฬิกาเก็บบันทึกว่าคุณทำเช่นนั้น จนกว่าคุณจะลงชื่อเข้าใช้อีกครั้ง กล่องข้อความหายไปด้วยเมื่อแอปเปิดหรือปิดครั้งถัดไปขณะนาฬิกาล็อกหรือไม่มีล็อกหน้าจอ ข้อความที่เก็บไว้ส่งทีหลังคงอยู่จนกว่าคุณจะส่งหรือลบ เพราะคุณขอให้ส่ง หากบริการเสียงพูดของนาฬิกาหยุดก่อนที่คุณพูดจบ นาฬิกาส่งเสียงบันทึกไปยังโทรศัพท์ของคุณ ซึ่งแปลงเป็นข้อความบนโทรศัพท์เอง ไม่เคยบนเซิร์ฟเวอร์ เสียงบันทึกถูกลบทั้งสองฝั่งเมื่อข้อความกลับมาหรือคุณยกเลิก และไม่เกิน 2 นาที มีเพียงข้อความที่ส่งต่อไปยัง Coach หรือ taf ของคุณ ผลลัพธ์ของ taf อาจอยู่ในการแจ้งเตือนของนาฬิกาจนกว่าคุณจะปิดหรือลงชื่อออกบนนาฬิกา</li>
					<li><strong>พาสคีย์ (passkey):</strong> เมื่อคุณอนุมัติด้วยพาสคีย์บนคอมพิวเตอร์ เช่น Windows Hello หรือกุญแจความปลอดภัย ใบหน้า ลายนิ้วมือ หรือ PIN ของคุณอยู่กับระบบของคอมพิวเตอร์เอง KIFF เก็บกุญแจสาธารณะของพาสคีย์ รหัสของมัน ตัวนับ และชื่อ ไม่เคยเก็บสิ่งที่เป็นความลับ และปฏิเสธพาสคีย์ที่ซิงก์ไปยังอุปกรณ์อื่น</li>
					<li><strong>การแจ้งเตือน:</strong> บนโทรศัพท์ แท็บเล็ต หรือ Mac ที่รันแอป iPad เมื่อคุณเปิดใช้ เราเก็บโทเค็นพุชของอุปกรณ์พร้อมรหัสบุคคล KIFF ของคุณ และภาษาที่แอปแสดง การแจ้งเตือนผ่าน Apple หรือ Google พร้อมเพียงว่า taf ตัวไหนและต้องการอะไร และในการแจ้งเตือนของประตู ชื่อหรืออีเมลของผู้ที่เขียนเข้ามา: ไม่เคยมีจำนวนเงินหรือรายละเอียดของคำขอ แอปเพิ่มสิ่งเหล่านั้นบนอุปกรณ์เองจาก KIFF ดังนั้นการแจ้งเตือนของโทรศัพท์ที่ปลดล็อกอยู่อาจแสดงจำนวนเงิน ร้านค้า หรือบุคคล บนโทรศัพท์ Android ที่ล็อกอยู่ แสดงเพียง “taf ต้องการคุณ” และบน iPhone ที่ล็อกอยู่ก็เช่นกัน เว้นแต่คุณตั้งการแสดงตัวอย่างเป็นแสดงเสมอ บน PC Windows คอมพิวเตอร์ Linux หรือ Mac ที่มีแอป macOS 12 แอปสร้างการแจ้งเตือนเองขณะทำงาน โดยไม่มีโทเค็นพุชและไม่ผ่านบริษัทอื่น บน Windows และ Linux การแจ้งเตือนแสดง taf ตัวไหน สิ่งที่ต้องการทำ จำนวนเงิน เหตุผล และภายในเมื่อใด บนแอป macOS 12 แสดงถ้อยคำของ KIFF สำหรับการเรียก เมื่อคุณเปิดใช้ และหน้าจอล็อกแสดงสิ่งที่การตั้งค่าตัวอย่างของ Mac อนุญาต บน Windows ปิดอยู่จนกว่าคุณเปิด และแสดงเพียง “taf ต้องการคุณ” ขณะหน้าจอล็อก การแจ้งเตือนที่แสดงก่อนหน้าจอล็อกเก็บรายละเอียดไว้ในรายการแจ้งเตือนของ Windows บน Linux เปิดอยู่จนกว่าคุณปิด และสิ่งที่หน้าจอล็อกแสดงขึ้นกับเดสก์ท็อปของคุณ</li>
					<li><strong>ภาษา:</strong> บริการ tafs เก็บภาษาของบัญชี จากผู้ที่คุยกับ Coach ล่าสุด นานถึงสามเดือน เพื่อให้รายงานของ taf มาในภาษานั้น</li>
					<li><strong>เครื่องมือของคุณ:</strong> เมื่อคุณเชื่อมต่อเครื่องมือ คุณลงชื่อเข้าใช้ที่ผู้ให้บริการของเครื่องมือนั้นเอง สำหรับแอปที่ planque ลงชื่อเข้าใช้เอง เช่น Stripe หรือกุญแจที่คุณให้ planque เก็บโทเค็นหรือกุญแจนั้นให้บริษัทของคุณ แบบเข้ารหัส สำหรับการเชื่อมต่อที่มีการจัดการ Composio บริการเชื่อมต่อที่ planque ทำงานด้วย เก็บการลงชื่อเข้าใช้ และ planque เก็บเฉพาะบันทึกของการเชื่อมต่อและเครื่องมือที่คุณอนุมัติ (ดู <a href="#google">ข้อมูลผู้ใช้ Google</a>) บันทึกของการเชื่อมต่ออาจรวมบัญชีที่ลงชื่อเข้าใช้ (ชื่อหรืออีเมล) เพื่อให้แอปแสดงให้คุณเห็นว่าเป็นบัญชีไหน KIFF ใช้การเชื่อมต่อที่มีการจัดการเฉพาะกับแอปที่ระบุที่ <a href="/subprocessors#composio">/subprocessors</a> (ภาษาอังกฤษ)</li>
					<li><strong>เบราว์เซอร์ของคุณ (Chrome):</strong> เมื่อคุณจับคู่ส่วนขยาย tafs กับโทรศัพท์ของคุณ taf ทำงานในโปรไฟล์ Chrome ที่คุณจับคู่ไว้ได้ เฉพาะบนเว็บไซต์ที่การเชื่อมต่อของมันระบุไว้ มันเปิดแท็บของตัวเองในกลุ่มแท็บที่คุณดู หยุดชั่วคราว หรือหยุดได้ และมันหยุดชั่วคราวเมื่อคุณแตะแท็บเหล่านั้นแท็บใดแท็บหนึ่ง มันอ่านหน้าเหล่านั้นเป็นข้อความและช่องฟอร์ม โดยตัดช่องรหัสผ่าน บัตร และรหัสออก ไม่เคยอ่านแท็บอื่นหรือเว็บไซต์อื่นของคุณ ข้อความนั้นถูกส่งไปยังผู้ให้บริการ AI ของเราเป็นส่วนหนึ่งของการทำงาน และเก็บไว้กับการทำงานนั้นเหมือนผลลัพธ์ของเครื่องมือใดๆ ทุกขั้นตอนลงในบันทึกพร้อมเว็บไซต์และชื่อช่อง ไม่เคยบันทึกสิ่งที่พิมพ์ลงในช่องลับ สำหรับทุกการเปลี่ยนแปลงที่ taf ทำ KIFF เก็บหน้าก่อนและหลังเป็นข้อความที่ตัดช่องเหล่านั้นออก ไม่เกิน 30 วัน และลบเร็วกว่านั้นเมื่อคุณยกเลิกการเชื่อมต่อหรือลบบัญชี หน้าเหล่านี้อาจแสดงข้อมูลของผู้อื่น เช่นลูกค้าของคุณ KIFF ประมวลผลให้คุณในฐานะผู้ประมวลผล ส่วนขยายเก็บกุญแจของตัวเองไว้ในคอมพิวเตอร์ของคุณ และหากคุณเลือก จะเก็บรายละเอียดการลงชื่อเข้าใช้ที่ผนึกไว้ซึ่งมีเพียงการอนุมัติของคุณบนโทรศัพท์เท่านั้นที่เปิดได้ สำหรับการกรอกหนึ่งครั้งบนเว็บไซต์นั้นพอดี KIFF ไม่เคยเก็บสิ่งเหล่านี้ คุณยังคุยกับ Coach จากแผงด้านข้างของส่วนขยายได้ Coach เห็นหน้าก็ต่อเมื่อคุณคลิก“Share this page”และอนุญาตให้ tafs เข้าเว็บไซต์นั้นใน Chrome และเห็นเฉพาะหน้านั้น อ่านด้วยวิธีเดียวกัน เป็นส่วนหนึ่งของแชตของคุณ การเลิกจับคู่หรือถอนการติดตั้งส่วนขยายจะลบสิ่งที่ส่วนขยายเก็บไว้ taf ไม่เคยชำระเงิน หรือกรอกการลงชื่อเข้าใช้ที่ผนึกไว้ โดยไม่มีการอนุมัติของคุณบนโทรศัพท์ สำหรับทุกขั้นตอนที่ลงมือทำ (การคลิก การพิมพ์ การส่ง) รวมถึงขั้นตอนที่คุณอนุมัติ มันจะเก็บภาพหน้าจอของหน้านั้นไว้หนึ่งภาพ ถ่ายก่อนลงมือทำเล็กน้อย เพื่อบันทึก ไม่เคยทำกับหน้าที่อ่านอย่างเดียว ไม่เคยทำบนเว็บไซต์ของธนาคาร กระเป๋าเงิน ตัวจัดการรหัสผ่าน การชำระเงิน สุขภาพ หรือหน่วยงานรัฐ และช่องรหัสผ่าน บัตร และรหัสกับทุกอย่างที่พิมพ์จากการเข้าสู่ระบบที่บันทึกไว้ของคุณจะถูกซ่อนก่อนถ่าย ข้อความที่ดูเหมือนหมายเลขบัตรหรือคีย์ก็ถูกปิดทึบด้วย แต่สิ่งที่เขียนในรูปแบบอื่นอาจยังมองเห็นได้ ภาพหน้าจอถูกเก็บไว้ในที่เก็บข้อมูลที่เข้ารหัส ผูกกับขั้นตอนนั้น เป็นเวลา 30 วัน แล้วลบโดยอัตโนมัติ หรือเร็วกว่านั้นเมื่อคุณยกเลิกการเชื่อมต่อ เลิกจับคู่ Chrome นี้ หรือลบบัญชี และจะไม่ถูกส่งไปยังผู้ให้บริการ AI ของเราเลย คุณเห็นแต่ละภาพใต้ขั้นตอนของมันในกิจกรรมของ taf</li>
					<li><strong>งานของ taf คุณ:</strong> การทำงาน แชต รายงาน บันทึกความจำของ taf แต่ละตัวและไฟล์ที่ส่งมอบ เก็บในฐานะผู้ประมวลผล ทุกคนในบัญชีของคุณเห็นไฟล์ที่ taf ของคุณส่งมอบได้</li>
					<li><strong>การซื้อ:</strong> Solo และแพ็กเครดิตจำหน่ายโดย Apple ผ่าน App Store หรือโดย Google ผ่านการเรียกเก็บเงินของ Google Play ทั้งสองแจ้งเราว่าซื้ออะไร ให้บัญชี KIFF ใด (รหัสสุ่ม) เมื่อใด และเลขอ้างอิงธุรกรรมหรือคำสั่งซื้อของตน ทั้งสองไม่ให้ Apple ID หรือบัญชี Google ชื่อ อีเมล หรือบัตรของคุณแก่เรา</li>
				</ul>
				<p>แอปไม่มีตัวติดตามด้านการวิเคราะห์หรือโฆษณา</p>
			</section>
			<section id="ai">
				<h2>5. AI ใน tafs</h2>
				<p>tafs ใช้ AI Claude ของ Anthropic สำหรับ Coach และ taf ของคุณ แอปถามคุณก่อนที่สิ่งใดจะไปยัง AI</p>
				<ul>
					<li>สิ่งที่ส่งไป: สิ่งที่คุณเขียนถึง Coach และ taf ของคุณ ไฟล์ที่คุณแนบ สิ่งที่แอปที่คุณเชื่อมต่อส่งคืนให้ taf ขณะทำงาน และสิ่งที่อยู่บนหน้าจอของคุณขณะ Coach ช่วยคุณในแอป</li>
					<li>สิ่งที่ไม่เคยส่ง: รหัสผ่านและกุญแจที่แอปที่คุณเชื่อมต่อใช้ หรือลายนิ้วมือของคุณ</li>
					<li>Anthropic ใช้ข้อมูลนั้นเพื่อตอบและเก็บไว้นานถึง 30 วัน</li>
					<li>ไม่มีการส่งสิ่งใดจนกว่าคุณอนุญาต คุณถอนความยินยอมได้ในบัญชี</li>
				</ul>
				<p>เมื่อคุณถอน Coach และ taf ของคุณหยุดตอบคุณ และ taf ที่การทำงานอาศัยความยินยอมของคุณจะหยุดพัก <a href="/th/privacy#ai-in-tafs">นโยบายความเป็นส่วนตัวของ KIFF</a> มีรายละเอียด</p>
			</section>
			@tafsPrivacyGoogleTH()
			<section id="sharing">
				<h2>7. ใครอื่นที่ได้รับข้อมูล</h2>
				<p>เราไม่ขายข้อมูลส่วนบุคคลของคุณ และไม่แบ่งปันเพื่อการโฆษณา</p>
				<p>สำหรับ tafs เราใช้บริษัทเหล่านี้: Amazon Web Services (โฮสติ้ง รวมที่เก็บของ tafs และการเชื่อมต่อของ planque) Clerk (การลงชื่อเข้าใช้สำหรับบัญชี KIFF) Anthropic (โมเดล AI) Composio (การลงชื่อเข้าใช้ของการเชื่อมต่อที่มีการจัดการ และการเรียกที่ planque ขอให้ทำ) Apple (การแจ้งเตือนแบบพุช) Google (การแจ้งเตือนแบบพุชบน Android และการเรียกเก็บเงินของ Google Play) และ Resend (ประตูอีเมลของ taf) รายการทางการปัจจุบัน พร้อมสิ่งที่แต่ละรายแตะต้องและที่ใด อยู่ที่ <a href="/subprocessors">/subprocessors</a> (ภาษาอังกฤษ)</p>
				<p>บางรายอยู่นอกเขตเศรษฐกิจยุโรป ส่วนใหญ่ในสหรัฐอเมริกา <a href="/th/privacy#transfers">นโยบายความเป็นส่วนตัวของ KIFF</a> ระบุว่าการโอนเหล่านั้นได้รับการคุ้มครองอย่างไร</p>
				<p><strong>ประเทศของคุณ</strong> กฎหมายของบางประเทศกำหนดมากกว่าที่นโยบายนี้ระบุ สิ่งที่กฎหมายเหล่านั้นเพิ่มเติม ทั้งเป็นภาษาอังกฤษและภาษาของประเทศนั้น อยู่ที่ <a href="/privacy/countries">ประเทศของคุณ</a> (ภาษาอังกฤษ)</p>
			</section>
			<section id="retention">
				<h2>8. เราเก็บไว้นานเท่าใด</h2>
				<ul>
					<li>สิ่งที่เครื่องมือของคุณส่งคืนให้ taf: จนกว่าการทำงานจะจบเท่านั้น ในแชต สิ่งที่ taf เพียงอ่านถูกเก็บแบบเข้ารหัสสำหรับข้อความถัดไป ใช้จนกว่าแชตว่างหนึ่งชั่วโมงและไม่เกินสี่ชั่วโมงหลังอ่าน แล้วลบโดยอัตโนมัติภายในไม่กี่วัน</li>
					<li>การทำงานและแชตของ taf พร้อมสรุปของแชต: 30 วัน บันทึกความจำ: จนกว่าจะลบ taf</li>
					<li>บันทึกสั้น ๆ ของ Coach สำหรับคำตอบถัดไป เช่น เหตุที่การเชื่อมต่อทำไม่ได้ในแชต หรือว่า Card ได้รับอนุมัติ: จนกว่าคำตอบนั้นนำไปใช้ ไม่เกิน 7 วัน หลังจากนั้นเป็นส่วนหนึ่งของแชตนั้น ตราบที่แชตยังถูกเก็บ สำเนาถูกเก็บ 24 ชั่วโมง เพื่อให้ข้อความที่ส่งซ้ำได้บันทึกเดียวกัน บันทึกของแชตใช้ในแชตนั้นเท่านั้น</li>
					<li>ไฟล์ที่คุณแนบในแชต: พร้อมข้อความที่แนบ 30 วัน หรือเร็วกว่านั้นหากแชตถูกลบ และไม่ว่ากรณีใดภายใน 38 วัน ไฟล์ที่ไม่มีข้อความใดใช้ถูกลบประมาณหนึ่งชั่วโมงหลังอัปโหลด การลบบัญชีของคุณลบไฟล์เหล่านั้น</li>
					<li>ไฟล์ที่ taf ของคุณส่งมอบ: 30 วันนับจากที่การทำงานสร้างไฟล์ แล้วลบโดยอัตโนมัติภายในหนึ่งวัน ทุกคนในบัญชีของคุณลบไฟล์ได้เร็วกว่านั้นด้วย ลบทันที: ตัวไฟล์หายไปทันทีโดยไม่เก็บสำเนา ชื่อ ขนาด และ taf และการทำงานที่สร้างไฟล์อาจอยู่ในสำเนา ณ จุดเวลาที่เข้ารหัสของที่เก็บ tafs นานถึง 35 วัน ใช้เพื่อกู้คืนหลังเกิดความล้มเหลวเท่านั้น การลบ taf หรือบัญชีของคุณลบไฟล์ของ taf การแชร์ไฟล์ส่งตัวไฟล์เอง และสำเนาที่คุณแชร์อยู่กับแอปที่คุณแชร์ไป เพื่อดาวน์โหลดไฟล์ เราสร้างลิงก์สำหรับสมาชิกบัญชีของคุณที่ลงชื่อเข้าใช้อยู่ ซึ่งหยุดใช้งานได้หลังหนึ่งนาที เราไม่สร้างลิงก์อื่นไปยังไฟล์นั้น</li>
					<li>สิ่งที่เครื่องมือส่งคืนในบันทึกของ planque ของแต่ละการเรียก: 24 ชั่วโมง หลังจากนั้นบันทึกเก็บเพียงว่าส่งการเรียกแล้วหรือไม่ เพื่อไม่ให้ส่งซ้ำสองครั้ง</li>
					<li>โทเค็นหรือกุญแจของการเชื่อมต่อใน planque หรือการลงชื่อเข้าใช้ของการเชื่อมต่อที่มีการจัดการที่ Composio: จนกว่าคุณจะตัดการเชื่อมต่อ หากการเชื่อมต่ออื่นของคุณอาจใช้บัญชีเดียวกันที่ผู้ให้บริการนั้น จะเก็บไว้โดยไม่ใช้จนกว่าการเชื่อมต่อนั้นถูกตัดด้วย แล้วจึงเพิกถอน บันทึกการอนุมัติ: จนกว่าบัญชีสิ้นสุด</li>
					<li>โทเค็นพุชของอุปกรณ์: จนกว่าคุณลงชื่อออกจากแอป ลบอุปกรณ์ หรือ Apple หรือ Google แจ้งว่าโทเค็นหายไป กุญแจสาธารณะ ชื่อ แพลตฟอร์ม และวันที่ของอุปกรณ์: ขณะที่คุณใช้ เมื่อคุณลงชื่อออกจากอุปกรณ์ จะถูกทำเครื่องหมายว่าลบแล้วและเก็บไว้จนกว่าบัญชีถูกลบ เพื่อให้ KIFF ปฏิเสธคำตอบที่มาช้าจากอุปกรณ์นั้นและแสดงว่าอุปกรณ์ใดลงนามคำตอบก่อนหน้า กุญแจสาธารณะ รหัส และชื่อของพาสคีย์: เหมือนของอุปกรณ์ เซสชันของคอมพิวเตอร์: ไม่เกิน 90 วัน หรือจนกว่าคุณลงชื่อออก</li>
					<li>บัญชีของคุณ: จนกว่าจะถูกลบ บันทึกบริการ: 30 วัน ที่เก็บของ tafs และ planque เก็บสำเนา ณ จุดเวลาที่เข้ารหัสไว้ 35 วัน ใช้เพื่อกู้คืนที่เก็บหลังเกิดความล้มเหลวเท่านั้น</li>
				</ul>
				<p>อย่างอื่นทั้งหมดอยู่ใน <a href="/th/privacy#retention">หัวข้อการเก็บรักษาของ KIFF</a></p>
			</section>
			<section id="lawful-bases">
				<h2>9. ฐานทางกฎหมาย</h2>
				<p>การปฏิบัติตามสัญญา เพื่อดำเนินบัญชีและ taf ของคุณ ประโยชน์โดยชอบด้วยกฎหมาย เพื่อความปลอดภัย การป้องกันการฉ้อโกง และการตรวจจับการใช้ในทางที่ผิด ความยินยอม สำหรับ AI ใน tafs (<a href="#ai">ส่วนที่ 5</a>) หน้าที่ตามกฎหมาย สำหรับบันทึกภาษี <a href="/th/privacy#lawful-bases">นโยบายความเป็นส่วนตัวของ KIFF</a> มีรายละเอียด</p>
			</section>
			<section id="rights">
				<h2>10. สิทธิของคุณ</h2>
				<p>ภายใต้ GDPR คุณขอเข้าถึงข้อมูลของคุณ แก้ไข ลบ จำกัดการประมวลผล หรือขอสำเนาแบบโอนย้ายได้ คัดค้านการประมวลผลที่อาศัยประโยชน์โดยชอบด้วยกฎหมาย และถอนความยินยอม อีเมลถึง <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> เราตอบภายในหนึ่งเดือน ในแอป บัญชี → ส่งออกแชตของฉัน ดาวน์โหลดแชตและบันทึกของคุณเอง</p>
				<p>หากต้องการลบบัญชี tafs ของคุณ เปิดแอป ไปที่บัญชี แล้วแตะ <em>ลบบัญชี</em> จากนั้นยืนยัน ย้อนกลับไม่ได้ <a href="/th/privacy#delete-account">นโยบายความเป็นส่วนตัวของ KIFF</a> ระบุว่าอะไรถูกลบและเมื่อใด และวิธีขอทางอีเมล</p>
				<p>คุณร้องเรียนต่อ<a href="https://www.aki.ee/en" target="_blank" rel="noopener">สำนักงานตรวจสอบการคุ้มครองข้อมูลเอสโตเนีย (Andmekaitse Inspektsioon)</a> หรือต่อหน่วยงานกำกับดูแลในที่ที่คุณอาศัยอยู่ได้</p>
				<p><strong>ประเทศของคุณ</strong> กฎหมายของบางประเทศกำหนดมากกว่าที่นโยบายนี้ระบุ สิ่งที่กฎหมายเหล่านั้นเพิ่มเติม ทั้งเป็นภาษาอังกฤษและภาษาของประเทศนั้น อยู่ที่ <a href="/privacy/countries">ประเทศของคุณ</a> (ภาษาอังกฤษ)</p>
			</section>
			<section id="more">
				<h2>11. ความปลอดภัย เด็ก และการเปลี่ยนแปลง</h2>
				<p>มาตรการรักษาความปลอดภัยของเราอยู่ที่ <a href="/security">/security</a> (ภาษาอังกฤษ) tafs ไม่ได้มุ่งสำหรับเด็ก และเราไม่เก็บข้อมูลส่วนบุคคลของเด็กอายุต่ำกว่า 16 ปีโดยรู้ตัว เราเปลี่ยนนโยบายนี้ตามที่ <a href="/th/privacy#changes">นโยบายความเป็นส่วนตัวของ KIFF</a> ระบุไว้สำหรับตัวมันเอง</p>
			</section>
			<section id="contact">
				<h2>12. ติดต่อ</h2>
				<p>คำถามและคำขอเกี่ยวกับความเป็นส่วนตัว: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> หนังสือแจ้งทางกฎหมายอย่างเป็นทางการ: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a> ข้อกำหนดของแอปเองอยู่ที่ <a href="/th/tafs/terms">/tafs/terms</a></p>
			</section>
		</article>
	}
}

// tafsPrivacyGoogle is what tafs does with the data it receives from Google,
// for Google's review of tafs's sign-in, with the Limited Use statement in
// Google's own words.
templ tafsPrivacyGoogleTH() {
	<section id="google">
		<h2>6. ข้อมูลผู้ใช้ Google</h2>
		if len(googleManaged()) == 0 && len(googleInHouse("th")) > 0 {
			<p>เมื่อคุณขอ tafs เชื่อมต่อ taf กับบัญชี Google ของคุณ เช่น กับ Google Sheets หรือ Google Calendar ที่งานของ taf ใช้ ในการเชื่อมต่อแอปของแอป ส่วนนี้ระบุว่า tafs ทำอะไรกับข้อมูลที่ได้รับจาก Google</p>
		} else {
			<p>เมื่อคุณขอ tafs เชื่อมต่อ taf กับบัญชี Google ของคุณ เช่น กับ Gmail ของคุณ หรือกับ Google Calendar หรือ Google Sheets ที่งานของ taf ใช้ ในการเชื่อมต่อแอปของแอป ส่วนนี้ระบุว่า tafs ทำอะไรกับข้อมูลที่ได้รับจาก Google</p>
		}
		<ul>
			if len(googleManaged()) == 0 && len(googleInHouse("th")) > 0 {
				<li><strong>สิ่งที่อ่านและเขียน:</strong> สิ่งที่งานของ taf ต้องการ: สเปรดชีตที่ taf อัปเดตให้เป็นปัจจุบัน หรือเหตุการณ์ในปฏิทินที่ taf ดูแล taf เปลี่ยนแปลงสิ่งเหล่านี้เฉพาะเมื่อ Card ของ taf อนุญาต และสิ่งใดที่เกินขีดจำกัดของ Card รอการอนุมัติของคุณ</li>
			} else {
				<li><strong>สิ่งที่อ่านและเขียน:</strong> สิ่งที่งานของ taf ต้องการ ใน Gmail ของคุณ taf อ่านข้อความและเธรดของคุณเพื่อหาอันที่ต้องตอบ และเขียนฉบับร่าง taf ส่งอีเมลเฉพาะเมื่อ Card ของ taf อนุญาต ใน Google Calendar และ Google Sheets taf อ่านเหตุการณ์ในปฏิทินที่ดูแล หรือสเปรดชีตที่อัปเดตให้เป็นปัจจุบัน และเปลี่ยนแปลงเฉพาะเมื่อ Card ของ taf อนุญาต
					if googleListed("Google Tasks") {
						ใน Google Tasks taf อ่านรายการงานที่ดูแล และเพิ่ม ทำให้เสร็จ ย้าย หรือลบงานเฉพาะเมื่อ Card ของ taf อนุญาต
					}
					สิ่งใดที่เกินขีดจำกัดของ Card รอการอนุมัติของคุณ</li>
			}
			<li><strong>เหตุผล:</strong> เพียงเพื่อทำงานที่คุณตั้งไว้ให้ taf นั้น และเพื่อแสดงให้คุณเห็นว่า taf เชื่อมต่อกับบัญชี Google ใด: ที่อยู่อีเมลของบัญชี เก็บไว้กับการเชื่อมต่อจนกว่าคุณจะตัดการเชื่อมต่อ</li>
			if len(googleManaged()) > 0 || len(googleInHouse("th")) > 0 {
				<li>
					<strong>แอป Google แต่ละแอปเชื่อมต่ออย่างไร:</strong>
					<ul>
						if len(googleManaged()) > 0 {
							<li>ผ่านพาร์ตเนอร์การลงชื่อเข้าใช้ของเรา ที่ระบุที่ <a href="/subprocessors">/subprocessors</a> (ภาษาอังกฤษ): { appList(googleManaged()) }.</li>
						}
						if len(googleInHouse("th")) > 0 {
							<li>ผ่านการลงชื่อเข้าใช้ Google ของ tafs เอง โดยไม่มีบริษัทอื่นคั่นกลาง: { appList(googleInHouseNames()) }.</li>
						}
					</ul>
					if googleBoth() {
						แอปที่ระบุไว้ทั้งสองแห่งเชื่อมต่อด้วยวิธีใดวิธีหนึ่ง ขึ้นกับบัญชีของคุณ หน้าลงชื่อเข้าใช้ของ Google เองแสดงว่าคุณกำลังอนุญาตวิธีใด
					}
				</li>
			}
			if googleBoth() {
				<li>
					<strong>สิ่งที่คุณอนุญาต:</strong> คุณลงชื่อเข้าใช้บนหน้าของ Google เองและเลือกสิ่งที่จะอนุญาต
					<ul>
						<li><strong>ผ่านพาร์ตเนอร์การลงชื่อเข้าใช้ของเรา:</strong> tafs ขอเฉพาะสิทธิ์ที่เครื่องมือของ taf ต้องการ หากสิทธิ์ที่แคบกว่านั้นเป็นไปไม่ได้ จะขอสิทธิ์ตามปกติของแอป และแจ้งก่อนที่คุณจะลงชื่อเข้าใช้ หากสิทธิ์ตามปกติรวมข้อมูลส่วนบุคคลที่ taf ไม่ใช้ tafs จะไม่เชื่อมต่อ</li>
						<li><strong>ผ่านการลงชื่อเข้าใช้ Google ของ tafs เอง:</strong> การลงชื่อเข้าใช้ขอสิทธิ์ทั้งหมดที่ระบุด้านล่างสำหรับแอปนั้นพร้อมกัน แม้ taf เพียงอ่าน</li>
					</ul>
				</li>
			} else if len(googleInHouse("th")) > 0 {
				<li><strong>สิ่งที่คุณอนุญาต:</strong> คุณลงชื่อเข้าใช้บนหน้าของ Google เองและเลือกสิ่งที่จะอนุญาต การลงชื่อเข้าใช้ขอสิทธิ์ทั้งหมดที่ระบุด้านล่างสำหรับแอปนั้นพร้อมกัน แม้ taf เพียงอ่าน</li>
			} else {
				<li><strong>สิ่งที่คุณอนุญาต:</strong> คุณลงชื่อเข้าใช้บนหน้าของ Google เองและเลือกสิ่งที่จะอนุญาต tafs ขอเฉพาะสิทธิ์ที่เครื่องมือของ taf ต้องการ หากสิทธิ์ที่แคบกว่านั้นเป็นไปไม่ได้ จะขอสิทธิ์ตามปกติของแอป และแจ้งก่อนที่คุณจะลงชื่อเข้าใช้ หากสิทธิ์ตามปกติรวมข้อมูลส่วนบุคคลที่ taf ไม่ใช้ tafs จะไม่เชื่อมต่อ</li>
			}
			<li><strong>taf ใช้อย่างไร:</strong> taf ใช้เฉพาะเครื่องมือที่ได้รับอนุมัติบน Card ของ taf ทุกการเรียกถูกตรวจสอบเทียบกับใบอนุญาตสำหรับเครื่องมือและอาร์กิวเมนต์นั้นโดยเฉพาะก่อนส่งสิ่งใด และการเรียกที่อยู่นอกสิทธิ์ที่คุณให้ถูกปฏิเสธ การดำเนินการใดที่ถามการอนุมัติของคุณทุกครั้งกำหนดไว้บน Card</li>
			if len(googleInHouse("th")) > 0 {
				<li>
					if googleBoth() {
						<strong>สิทธิ์ที่การลงชื่อเข้าใช้ Google ของ tafs เองขอ:</strong>
					} else {
						<strong>สิทธิ์ที่ tafs ขอ:</strong>
					}
					<ul>
						for _, a := range googleInHouse("th") {
							<li>
								{ a.Name }
								<ul>
									for _, s := range a.Scopes {
										<li><code>{ s.ID }</code>: { s.What }</li>
									}
								</ul>
							</li>
						}
					</ul>
					ไม่ว่าการลงชื่อเข้าใช้จะอนุญาตมากเพียงใด taf ใช้เฉพาะเครื่องมือบน Card ของ taf
				</li>
			}
			if googleBoth() {
				<li>
					<strong>ใครเก็บการลงชื่อเข้าใช้ของคุณ:</strong>
					<ul>
						<li><strong>ผ่านพาร์ตเนอร์การลงชื่อเข้าใช้ของเรา:</strong> การลงชื่อเข้าใช้ Google ของคุณถูกเก็บโดยพาร์ตเนอร์การลงชื่อเข้าใช้ของเรา ที่ระบุที่ <a href="/subprocessors">/subprocessors</a> (ภาษาอังกฤษ) และไม่เคยมอบให้ taf หรือ planque ทั้ง taf และ tafs ไม่เห็นรหัสผ่านหรือโทเค็น Google ของคุณ taf อีกตัวของคุณที่ต้องการสิทธิ์เดียวกันใช้การลงชื่อเข้าใช้นั้นซ้ำ และ taf แต่ละตัวใช้เฉพาะเครื่องมือที่คุณอนุมัติให้</li>
						<li><strong>ผ่านการลงชื่อเข้าใช้ Google ของ tafs เอง:</strong> planque บริการเชื่อมต่อของ tafs เอง เก็บโทเค็น Google ของคุณให้บริษัทของคุณ เข้ารหัสด้วย AWS KMS ในสหภาพยุโรป (ไอร์แลนด์) และใช้เฉพาะเพื่อทำการเรียกที่ Card ของ taf อนุญาต ไม่เคยมอบให้ taf และทั้ง taf และโมเดล AI ไม่เห็นรหัสผ่านหรือโทเค็น Google ของคุณ taf อีกตัวของคุณที่ต้องการสิทธิ์เดียวกันใช้การลงชื่อเข้าใช้นั้นซ้ำ และ taf แต่ละตัวใช้เฉพาะเครื่องมือที่คุณอนุมัติให้</li>
					</ul>
				</li>
			} else if len(googleInHouse("th")) > 0 {
				<li><strong>ใครเก็บการลงชื่อเข้าใช้ของคุณ:</strong> planque บริการเชื่อมต่อของ tafs เอง เก็บโทเค็น Google ของคุณให้บริษัทของคุณ เข้ารหัสด้วย AWS KMS ในสหภาพยุโรป (ไอร์แลนด์) และใช้เฉพาะเพื่อทำการเรียกที่ Card ของ taf อนุญาต ไม่เคยมอบให้ taf และทั้ง taf และโมเดล AI ไม่เห็นรหัสผ่านหรือโทเค็น Google ของคุณ taf อีกตัวของคุณที่ต้องการสิทธิ์เดียวกันใช้การลงชื่อเข้าใช้นั้นซ้ำ และ taf แต่ละตัวใช้เฉพาะเครื่องมือที่คุณอนุมัติให้</li>
			} else {
				<li><strong>ใครเก็บการลงชื่อเข้าใช้ของคุณ:</strong> การลงชื่อเข้าใช้ Google ของคุณถูกเก็บโดยพาร์ตเนอร์การลงชื่อเข้าใช้ของเรา ที่ระบุที่ <a href="/subprocessors">/subprocessors</a> (ภาษาอังกฤษ) และไม่เคยมอบให้ taf หรือ planque ทั้ง taf และ tafs ไม่เห็นรหัสผ่านหรือโทเค็น Google ของคุณ taf อีกตัวของคุณที่ต้องการสิทธิ์เดียวกันใช้การลงชื่อเข้าใช้นั้นซ้ำ และ taf แต่ละตัวใช้เฉพาะเครื่องมือที่คุณอนุมัติให้</li>
			}
			if googleBoth() {
				<li>
					<strong>ใครอื่นที่ได้รับ:</strong> สิ่งที่ taf อ่านจาก Google ไปยังโมเดล AI ที่รัน taf เฉพาะหลังจากคุณอนุญาต (ดู <a href="#ai">AI ใน tafs</a>) ซึ่งเก็บไว้นานถึง 30 วันตามข้อกำหนดของผู้ให้บริการ
					<ul>
						<li><strong>ผ่านพาร์ตเนอร์การลงชื่อเข้าใช้ของเรา:</strong> ข้อมูลยังผ่านพาร์ตเนอร์การลงชื่อเข้าใช้ของเรา ซึ่งทำการเรียกแต่ละครั้ง</li>
						<li><strong>ผ่านการลงชื่อเข้าใช้ Google ของ tafs เอง:</strong> planque เรียก Google เอง ดังนั้นไม่มีบริษัทอื่นทำการเรียกหรือเก็บการลงชื่อเข้าใช้ของคุณ</li>
					</ul>
					ทั้งสองรายระบุที่ <a href="/subprocessors">/subprocessors</a> (ภาษาอังกฤษ)
				</li>
			} else if len(googleInHouse("th")) > 0 {
				<li><strong>ใครอื่นที่ได้รับ:</strong> สิ่งที่ taf อ่านจาก Google ไปยังโมเดล AI ที่รัน taf เฉพาะหลังจากคุณอนุญาต (ดู <a href="#ai">AI ใน tafs</a>) ซึ่งเก็บไว้นานถึง 30 วันตามข้อกำหนดของผู้ให้บริการ planque เรียก Google เอง ดังนั้นไม่มีบริษัทอื่นทำการเรียกหรือเก็บการลงชื่อเข้าใช้ของคุณ ผู้ให้บริการโมเดล AI ระบุที่ <a href="/subprocessors">/subprocessors</a> (ภาษาอังกฤษ)</li>
			} else {
				<li><strong>ใครอื่นที่ได้รับ:</strong> สิ่งที่ taf อ่านจาก Google ไปยังโมเดล AI ที่รัน taf เฉพาะหลังจากคุณอนุญาต (ดู <a href="#ai">AI ใน tafs</a>) ซึ่งเก็บไว้นานถึง 30 วันตามข้อกำหนดของผู้ให้บริการ ข้อมูลยังผ่านพาร์ตเนอร์การลงชื่อเข้าใช้ของเรา ซึ่งทำการเรียกแต่ละครั้ง ทั้งสองรายระบุที่ <a href="/subprocessors">/subprocessors</a> (ภาษาอังกฤษ)</li>
			}
			<li><strong>การฝึก AI:</strong> ข้อมูลผู้ใช้ Google ไม่ถูกใช้เพื่อฝึกโมเดล AI</li>
			<li><strong>รูปภาพ:</strong> tafs ไม่สร้างหรือแก้ไขรูปภาพหรือวิดีโอ: AI ของ tafs เขียนข้อความ tafs ไม่เคยใช้ API ของ Google หรือข้อมูลผู้ใช้ Google เพื่อสร้าง แก้ไข หรือแชร์ภาพส่วนตัวของผู้ใดก็ตาม (ภาพส่วนตัวที่ไม่ได้รับความยินยอม, NCII) หรือภาพอื่นใดของบุคคล</li>
			if len(googleManaged()) == 0 && len(googleInHouse("th")) > 0 {
				<li><strong>นานเท่าใด และที่ไหน:</strong> สเปรดชีตและเหตุการณ์ของคุณอยู่ในบัญชี Google ของคุณ ในที่เก็บของ tafs เอง สิ่งที่เครื่องมือส่งคืนถูกเก็บจนกว่าการทำงานของ taf จบเท่านั้น planque ซึ่งส่งต่อแต่ละการเรียก เก็บสิ่งที่ Google ส่งคืน 24 ชั่วโมง เพื่อให้การเรียกซ้ำได้คำตอบเดียวกันและไม่ถูกส่งซ้ำสองครั้ง หลังจากนั้นเก็บเพียงว่าส่งการเรียกแล้วหรือไม่ ในแชต สิ่งที่เพียงอ่านถูกเก็บแบบเข้ารหัส ใช้จนกว่าแชตว่างหนึ่งชั่วโมงและไม่เกินสี่ชั่วโมงหลังอ่าน แล้วลบโดยอัตโนมัติภายในไม่กี่วัน บันทึกของการทำงานและแชตของ taf ถูกเก็บ 30 วัน และบันทึกของ taf จนกว่าคุณลบ taf (ดู <a href="#retention">เราเก็บไว้นานเท่าใด</a>)</li>
			} else {
				<li><strong>นานเท่าใด และที่ไหน:</strong> ฉบับร่าง เหตุการณ์ และสเปรดชีตของคุณอยู่ในบัญชี Google ของคุณ ในที่เก็บของ tafs เอง สิ่งที่เครื่องมือส่งคืนถูกเก็บจนกว่าการทำงานของ taf จบเท่านั้น planque ซึ่งส่งต่อแต่ละการเรียก เก็บสิ่งที่ Google ส่งคืน 24 ชั่วโมง เพื่อให้การเรียกซ้ำได้คำตอบเดียวกันและไม่ถูกส่งซ้ำสองครั้ง หลังจากนั้นเก็บเพียงว่าส่งการเรียกแล้วหรือไม่ ในแชต สิ่งที่เพียงอ่านถูกเก็บแบบเข้ารหัส ใช้จนกว่าแชตว่างหนึ่งชั่วโมงและไม่เกินสี่ชั่วโมงหลังอ่าน แล้วลบโดยอัตโนมัติภายในไม่กี่วัน บันทึกของการทำงานและแชตของ taf ถูกเก็บ 30 วัน และบันทึกของ taf จนกว่าคุณลบ taf (ดู <a href="#retention">เราเก็บไว้นานเท่าใด</a>)</li>
			}
			<li>
				<strong>การหยุด:</strong>
				<ul>
					<li>ตัดการเชื่อมต่อ Google ในแอป ในการเชื่อมต่อแอปหรือบนแท็บ Card ของ taf เครื่องมือ Google ของ taf หยุดทันที และ tafs ขอให้ Google เพิกถอนการลงชื่อเข้าใช้ทันที ซึ่งอาจเสร็จช้ากว่านั้นเล็กน้อย</li>
					<li>ลบ taf แล้วการเชื่อมต่อของ taf สิ้นสุดไปด้วย การลงชื่อเข้าใช้ Google ที่ taf อีกตัวของคุณยังใช้อยู่คงอยู่จนกว่าตัวสุดท้ายหายไป</li>
					<li>ถอนสิทธิ์ของ tafs เมื่อใดก็ได้ในบัญชี Google ของคุณ ที่ <a href="https://myaccount.google.com/permissions">myaccount.google.com/permissions</a> taf ของคุณหยุดเข้าถึง Google และแอปแจ้งคุณว่าการเชื่อมต่อ Google ลงชื่อออกแล้ว</li>
					<li>ลบบัญชีของคุณ: taf แชต บันทึก ไฟล์ และการเชื่อมต่อถูกลบทันที และจากสำเนา ณ จุดเวลาภายใน 35 วัน และโทเค็น Google ถูกเพิกถอนเท่าที่ Google อนุญาต</li>
				</ul>
			</li>
		</ul>
		<p lang="en">tafs's use and transfer to any other app of information received from Google APIs will adhere to <a href="https://developers.google.com/terms/api-services-user-data-policy">Google API Services User Data Policy</a>, including the Limited Use requirements.</p>
	</section>
