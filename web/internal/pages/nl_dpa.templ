package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// DPANL is the Data Processing Agreement template (/legal/dpa) in
// Dutch, at /nl/legal/dpa. It is a translation of DPA: the same
// sections, anchors, links and figures, held to it by
// TestTranslationsKeepTheEnglishPage. The English page governs. Change
// the English page first, then this one. The defined terms are the
// Dutch GDPR's (AVG): Verwerkingsverantwoordelijke, Verwerker,
// Subverwerker, Betrokkene, Persoonsgegevens.
templ DPANL() {
	@components.LayoutSite("KIFF — verwerkersovereenkomst", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@dpaHeadNL()
			@dpaPartiesNL()
			@dpaDefinitionsNL()
			@dpaScopeNL()
			@dpaSubjectMatterNL()
			@dpaNaturePurposeNL()
			@dpaCategoriesNL()
			@dpaInstructionsNL()
			@dpaProcessorObligationsNL()
			@dpaConfidentialityNL()
			@dpaSubprocessorsNL()
			@dpaTransfersNL()
			@dpaSecurityNL()
			@dpaBreachNotificationNL()
			@dpaDataSubjectRequestsNL()
			@dpaAuditNL()
			@dpaReturnDeletionNL()
			@dpaLiabilityNL()
			@dpaTermNL()
			@dpaGoverningLawNL()
			@dpaAnnex1NL()
			@dpaAnnex2NL()
			@dpaAnnex3NL()
			@dpaAnnex4NL()
		</article>
	}
}

templ dpaHeadNL() {
	<header class="legal-head">
		<p class="legal-badge">Sjabloon verwerkersovereenkomst · v0.1</p>
		<h1>Verwerkersovereenkomst</h1>
		<p class="legal-meta">
			<strong>Versie van het sjabloon:</strong> v0.1.
			<strong>Laatst bijgewerkt:</strong> 17 november 2026.
		</p>
		<p class="legal-disclaimer">
			Dit is een gepubliceerd <em>sjabloon</em>, geen getekend
			contract. Klanten mogen het gebruiken als vertrekpunt
			voor de beoordeling door hun inkoopafdeling. Een getekende
			verwerkersovereenkomst schept echte verplichtingen voor
			Kiff Agents OÜ, die toezichthoudende autoriteiten in de
			EU kunnen afdwingen. Contact voor inkoop:
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</header>
}

templ dpaPartiesNL() {
	<section id="parties">
		<h2>1. Partijen</h2>
		<p>Deze Verwerkersovereenkomst wordt gesloten tussen:</p>
		<ul>
			<li><strong>Kiff Agents OÜ</strong>, een Estse besloten vennootschap, registratienummer 17372313, btw-nummer EE102924327, gevestigd aan Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estland (de <strong>“Verwerker”</strong>); en</li>
			<li><strong>[JURIDISCHE NAAM VAN DE KLANT]</strong>, gevestigd aan <strong>[ADRES]</strong>, registratienummer <strong>[REGISTRATIENUMMER]</strong> (de <strong>“Verwerkingsverantwoordelijke”</strong>).</li>
		</ul>
		<p>
			Elk een “partij” en samen de “partijen”. Deze
			Verwerkersovereenkomst vult de Gebruiksvoorwaarden op
			<a href="/nl/terms">/terms</a> aan, en elk commercieel
			bestelformulier tussen de partijen; bij strijdigheid over
			gegevensbescherming gaat deze Verwerkersovereenkomst
			voor.
		</p>
	</section>
}

templ dpaDefinitionsNL() {
	<section id="definitions">
		<h2>2. Definities</h2>
		<p>
			Begrippen met een hoofdletter die hier niet zijn
			gedefinieerd, hebben de betekenis die de AVG (Verordening
			(EU) 2016/679) eraan geeft.
		</p>
		<ul>
			<li><strong>“AVG”</strong> — de Algemene verordening gegevensbescherming van de EU.</li>
			<li><strong>“Persoonsgegevens”</strong>, <strong>“Betrokkene”</strong>, <strong>“Verwerking”</strong>, <strong>“Verwerkingsverantwoordelijke”</strong>, <strong>“Verwerker”</strong>, <strong>“Subverwerker”</strong>, <strong>“Inbreuk in verband met Persoonsgegevens”</strong> — zoals gedefinieerd in artikel 4 van de AVG.</li>
			<li><strong>“Auditgegevens”</strong> — Persoonsgegevens die de Verwerkingsverantwoordelijke via de runtime bij de Dienst aanlevert of binnen de Dienst laat ontstaan, waaronder gebeurtenissen, beslissingen, acties, goedkeuringen en ontvangstbewijzen.</li>
			<li><strong>“tafs-gegevens”</strong> — Persoonsgegevens in wat tafs namens de Verwerkingsverantwoordelijke bewaart: de runs en chats van elk taf (inclusief wat de gekoppelde apps van de Verwerkingsverantwoordelijke eraan teruggeven) en de chats van Setup, zijn rapporten, zijn geheugennotities, de apparaten die voor zijn meldingen zijn geregistreerd, en de koppelingen van de Verwerkingsverantwoordelijke met zijn apps in planque (het logboek van elke koppeling en de goedkeuringen ervan, en het token of de sleutel die planque ervoor bewaart). Bijlage 4 beschrijft ze.</li>
			<li><strong>“Dienst”</strong> — het product KIFF Cloud, inclusief tafs, zoals gedefinieerd in de Gebruiksvoorwaarden.</li>
			<li><strong>“Standaardcontractbepalingen”</strong> of <strong>“SCC's”</strong> — de standaardcontractbepalingen van de Europese Commissie uit 2021 voor de doorgifte van Persoonsgegevens aan derde landen.</li>
			<li><strong>“DPF”</strong> — het adequaatheidsbesluit over het EU-VS Data Privacy Framework.</li>
			<li><strong>“TOM's”</strong> — de technische en organisatorische maatregelen die in bijlage 2 zijn beschreven.</li>
		</ul>
	</section>
}

templ dpaScopeNL() {
	<section id="scope">
		<h2>3. Reikwijdte en rollen</h2>
		<p>
			Deze Verwerkersovereenkomst geldt waar Kiff Agents OÜ in
			verband met de Dienst Persoonsgegevens verwerkt namens de
			Verwerkingsverantwoordelijke. Voor Auditgegevens en
			tafs-gegevens is de Verwerkingsverantwoordelijke de
			Verwerkingsverantwoordelijke en is Kiff Agents OÜ de
			Verwerker.
		</p>
		<p>
			Voor Persoonsgegevens die we verwerken over de
			accounthouders van de Verwerkingsverantwoordelijke
			(metadata over het inloggen, contactpersonen voor
			facturering, correspondentie met support) geldt ons
			<a href="/nl/privacy">privacybeleid</a>; voor die
			gegevens zijn we een zelfstandige
			Verwerkingsverantwoordelijke, geen Verwerker onder deze
			Verwerkersovereenkomst.
		</p>
	</section>
}

templ dpaSubjectMatterNL() {
	<section id="subject-matter">
		<h2>4. Onderwerp en duur</h2>
		<p>
			<strong>Onderwerp:</strong> Verwerking van Auditgegevens
			en tafs-gegevens om de Dienst te leveren.
		</p>
		<p>
			<strong>Duur:</strong> vanaf de ingangsdatum van deze
			Verwerkersovereenkomst tot (a) de beëindiging van de
			onderliggende Gebruiksvoorwaarden of (b) de verwijdering
			van alle Auditgegevens volgens §16, afhankelijk van wat
			later is.
			Bepalingen die naar hun aard na beëindiging blijven
			gelden (audit, vrijwaring, toepasselijk recht), blijven
			gelden.
		</p>
	</section>
}

templ dpaNaturePurposeNL() {
	<section id="nature-purpose">
		<h2>5. Aard en doel van de verwerking</h2>
		<p>
			Kiff Agents OÜ verwerkt Auditgegevens alleen voor zover
			dat nodig is om de Dienst te leveren: voorstellen en
			toolaanroepen ontvangen, ze toetsen aan de configuratie
			en de Cards van de Verwerkingsverantwoordelijke, ze
			vasthouden voor menselijke goedkeuring waar de
			configuratie dat vereist, een toegestane aanroep
			doorsturen naar de gekoppelde app of een autorisatie
			afgeven die de app verifieert, de beslissingen en de
			uitkomst die de app meldt vastleggen, ondertekende
			Ontvangstbewijzen uitgeven, en (waar de
			Verwerkingsverantwoordelijke dat zo heeft ingesteld)
			samenvattende hashes waaraan manipulatie te zien is
			publiceren in een openbaar, verifieerbaar spoor. De
			gekoppelde app voert de onderliggende actie uit; een
			autorisatiebeslissing alleen is geen bewijs dat de actie
			is uitgevoerd.
		</p>
		<p>
			Voor tafs verwerkt Kiff Agents OÜ ook tafs-gegevens om
			elk taf te draaien dat de Verwerkingsverantwoordelijke
			start: het taf draaien volgens zijn planning en in chats
			met de mensen van de Verwerkingsverantwoordelijke, zijn
			toolaanroepen via KIFF versturen, zijn runs, chats en
			geheugennotities bewaren zodat het kan rapporteren en
			zijn werk kan voortzetten, en de geregistreerde apparaten
			van de Verwerkingsverantwoordelijke een melding sturen
			wanneer een aanroep wordt vastgehouden. Via Setup en
			planque koppelt Kiff Agents OÜ ook de apps van de
			Verwerkingsverantwoordelijke, wanneer de mensen van de
			Verwerkingsverantwoordelijke inloggen bij de aanbieder
			van de app en de koppeling op hun apparaat goedkeuren:
			voor een app waarbij planque zelf inlogt, zoals Stripe, of een sleutel die de Verwerkingsverantwoordelijke opgeeft, bewaart planque dat token of die sleutel, versleuteld, en gebruikt het alleen voor een aanroep waarover KIFF heeft beslist; voor een beheerde koppeling bewaart Composio de login en doet het alleen de aanroepen die planque vraagt, en bewaart planque het logboek van de koppeling en de goedgekeurde tools. KIFF gebruikt beheerde koppelingen alleen voor de apps die op <a href="/nl/subprocessors#composio">kiff.dev/subprocessors</a> staan. Bijlage 4 beschrijft de gegevens, waar ze worden
			bewaard en hoe lang.
		</p>
	</section>
}

templ dpaCategoriesNL() {
	<section id="categories">
		<h2>6. Categorieën Betrokkenen en Persoonsgegevens</h2>
		<p>
			Standaard verwerkt Kiff Agents OÜ deze categorieën
			Persoonsgegevens, zoals de inventaris op
			<a href="/nl/security#data-we-process">/security#data-we-process</a>
			beschrijft:
		</p>
		<ul>
			<li><strong>Accountgegevens</strong>: wie de mensen van de Verwerkingsverantwoordelijke in zijn account zijn (namen, e-mailadressen, rollen), en zijn agents en hun sleutels. De metadata over het inloggen die Kiff Agents OÜ als verwerkingsverantwoordelijke bewaart, blijft onder §3 vallen.</li>
			<li><strong>Koppelingen met apps</strong>: elke koppeling met de apps van de Verwerkingsverantwoordelijke, de goedgekeurde tools, het logboek van wie ze heeft goedgekeurd en, waar planque het bewaart, het token of de sleutel ervan (versleuteld).</li>
			<li><strong>Records van acties van agents</strong>: voor elke aanroep wie het vroeg (agent en sleutel), de actie, waarop die betrekking had, de uitkomst en de redenen ervoor, de geldende Card, numerieke parameters, vastgehouden aanroepen en de antwoorden daarop, en de ontvangstbewijzen.</li>
			<li><strong>Chats met tafs</strong>: de runs en chats van elk taf, zijn rapporten en geheugennotities, en wat de apps van de Verwerkingsverantwoordelijke eraan teruggeven, zoals bijlage 4 beschrijft.</li>
		</ul>
		<p>
			De <strong>Betrokkenen</strong> zijn de mensen van de
			Verwerkingsverantwoordelijke die de Dienst gebruiken, en
			de mensen van wie gegevens voorkomen in de acties van
			zijn agents en in chats met tafs, zoals de klanten,
			leveranciers of medewerkers van de
			Verwerkingsverantwoordelijke.
		</p>
		<p>
			Wat er verder bij de Dienst terechtkomt, hangt af van de
			configuratie van de Verwerkingsverantwoordelijke en van
			de gegevens die hij verstuurt; Kiff Agents OÜ heeft geen
			zeggenschap over welke velden de
			Verwerkingsverantwoordelijke verstuurt. De
			Verwerkingsverantwoordelijke voegt eventuele verdere
			categorieën toe in bijlage 1, die wordt bijgewerkt
			wanneer de configuratie wezenlijk verandert.
		</p>
	</section>
}

templ dpaInstructionsNL() {
	<section id="instructions">
		<h2>7. Instructies van de Verwerkingsverantwoordelijke</h2>
		<p>
			Kiff Agents OÜ zal Persoonsgegevens verwerken volgens de
			gedocumenteerde instructies van de
			Verwerkingsverantwoordelijke. Die instructies bestaan uit
			deze Verwerkersovereenkomst, de Gebruiksvoorwaarden, de
			technische documentatie van de Dienst en de
			beveiligingsmaatregelen in de gedateerde revisie op
			<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>,
			en de configuraties en instructies die de bevoegde
			gebruikers van de Verwerkingsverantwoordelijke via de
			Dienst indienen.
		</p>
		<p>
			De strategische whitepaper en de documentatie van het
			opensourceframework, dat een eigen licentie heeft, zijn
			toelichtende naslagwerken en maken geen deel uit van die
			verwerkingsinstructies. De publicatie van een herzien
			document wijzigt op zichzelf niet de instructies die voor
			een bestaande overeenkomst gelden.
		</p>
		<p>
			Voor instructies buiten dat bereik is een schriftelijke
			afspraak nodig. Als Kiff Agents OÜ een instructie in
			strijd acht met de AVG of met andere geldende wetgeving
			over gegevensbescherming, zal het de
			Verwerkingsverantwoordelijke daarvan op de hoogte
			stellen.
		</p>
	</section>
}

templ dpaProcessorObligationsNL() {
	<section id="processor-obligations">
		<h2>8. Verplichtingen van de Verwerker (artikel 28, lid 3)</h2>
		<p>
			Kiff Agents OÜ zal:
		</p>
		<ol>
			<li>Persoonsgegevens alleen verwerken op basis van de gedocumenteerde instructies van de Verwerkingsverantwoordelijke, ook wat internationale doorgiften betreft, tenzij het recht van de EU of van een lidstaat iets anders vereist (in dat geval zal Kiff Agents OÜ de Verwerkingsverantwoordelijke vóór de Verwerking van dat wettelijke vereiste op de hoogte stellen, tenzij die wetgeving zo'n kennisgeving verbiedt om gewichtige redenen van algemeen belang);</li>
			<li>waarborgen dat personeel dat bevoegd is Persoonsgegevens te verwerken, gebonden is aan passende geheimhoudingsverplichtingen;</li>
			<li>de technische en organisatorische maatregelen treffen die in bijlage 2 zijn beschreven;</li>
			<li>de voorwaarden voor het inschakelen van Subverwerkers in §10 naleven;</li>
			<li>rekening houdend met de aard van de Verwerking, de Verwerkingsverantwoordelijke met passende maatregelen bijstaan bij het nakomen van verplichtingen om te antwoorden op verzoeken van Betrokkenen op grond van hoofdstuk III van de AVG;</li>
			<li>de Verwerkingsverantwoordelijke bijstaan bij het waarborgen van de naleving van de artikelen 32 tot en met 36 van de AVG (beveiliging, melding van inbreuken, gegevensbeschermingseffectbeoordeling (DPIA), voorafgaande raadpleging), rekening houdend met de aard van de Verwerking en de informatie waarover Kiff Agents OÜ beschikt;</li>
			<li>naar keuze van de Verwerkingsverantwoordelijke alle Persoonsgegevens verwijderen of teruggeven bij beëindiging van de diensten volgens §16, en bestaande kopieën verwijderen, tenzij het recht van de EU of van een lidstaat opslag vereist;</li>
			<li>de Verwerkingsverantwoordelijke alle informatie ter beschikking stellen die nodig is om de naleving van artikel 28 van de AVG aan te tonen, en audits volgens §15 mogelijk maken en eraan bijdragen.</li>
		</ol>
	</section>
}

templ dpaConfidentialityNL() {
	<section id="confidentiality">
		<h2>9. Vertrouwelijkheid</h2>
		<p>
			Kiff Agents OÜ waarborgt dat personeel met toegang tot
			Persoonsgegevens gebonden is aan schriftelijke
			geheimhoudingsverplichtingen of aan een passende
			wettelijke geheimhoudingsplicht. Toegang wordt verleend
			volgens het principe van de minste rechten en wordt
			gelogd.
		</p>
	</section>
}

templ dpaSubprocessorsNL() {
	<section id="sub-processors">
		<h2>10. Subverwerkers</h2>
		<p>
			De Verwerkingsverantwoordelijke geeft Kiff Agents OÜ
			toestemming de Subverwerkers in te schakelen die zijn
			vermeld in bijlage 3 en op
			<a href="/nl/subprocessors">/subprocessors</a>, dat de
			officiële lijst is. Kiff Agents OÜ legt elke Subverwerker
			verplichtingen voor gegevensbescherming op die niet
			minder bescherming bieden dan deze
			Verwerkersovereenkomst.
		</p>
		<p>
			Het openbare, verifieerbare spoor is geen Subverwerker.
			Het ontvangt alleen samenvattende hashes en geen
			Persoonsgegevens.
		</p>
		<p>
			De gedateerde revisie waarnaar paragraaf 7 verwijst, legt
			de lijst vast zoals die op haar datum was. Een latere
			wijziging gaat in volgens deze paragraaf, niet door de
			publicatie van een revisie.
		</p>
		<p>
			Wanneer Kiff Agents OÜ van plan is een nieuwe
			Subverwerker in te schakelen of een bestaande te
			vervangen voor de Verwerking van de Persoonsgegevens van
			de Verwerkingsverantwoordelijke, stelt Kiff Agents OÜ de
			Verwerkingsverantwoordelijke daarvan minstens dertig
			dagen van tevoren op de hoogte. De
			Verwerkingsverantwoordelijke mag binnen vijftien dagen na
			de kennisgeving bezwaar maken tegen de wijziging op
			redelijke gronden van gegevensbescherming; als een
			redelijk bezwaar niet kan worden opgelost, mag elke
			partij het getroffen deel van de Dienst met een
			schriftelijke kennisgeving beëindigen.
		</p>
	</section>
}

templ dpaTransfersNL() {
	<section id="transfers">
		<h2>11. Internationale doorgiften</h2>
		<p>
			Waar de Verwerking van Persoonsgegevens een doorgifte
			inhoudt naar een land buiten de Europese Economische
			Ruimte zonder adequaatheidsbesluit op grond van artikel
			45 van de AVG, komen de partijen overeen dat:
		</p>
		<ul>
			<li>voor doorgiften aan Subverwerkers die zijn gecertificeerd onder het EU-VS Data Privacy Framework, het DPF het doorgiftemechanisme is zolang het van kracht blijft;</li>
			<li>de partijen in andere gevallen de Standaardcontractbepalingen van de Europese Commissie uit 2021 door verwijzing opnemen, waarbij module 2 (verwerkingsverantwoordelijke naar verwerker) geldt voor doorgiften van de Verwerkingsverantwoordelijke aan Kiff Agents OÜ en module 3 (verwerker naar subverwerker) voor doorgiften van Kiff Agents OÜ aan een Subverwerker;</li>
			<li>het toetredingsbeding (bepaling 7) niet wordt gebruikt; de partijen bij de SCC's zijn de Verwerkingsverantwoordelijke en Kiff Agents OÜ;</li>
			<li>bijlage I.A en I.B van de SCC's worden ingevuld door verwijzing naar bijlage 1 van deze Verwerkersovereenkomst; bijlage II van de SCC's door verwijzing naar bijlage 2 van deze Verwerkersovereenkomst; bijlage III door verwijzing naar bijlage 3 van deze Verwerkersovereenkomst;</li>
			<li>optie 2 van bepaling 9, punt a) (algemene schriftelijke toestemming) geldt, met de kennisgevingstermijn van dertig dagen uit §10 hierboven.</li>
		</ul>
		<p>
			Waar na een beoordeling van de gevolgen van de doorgifte
			aanvullende maatregelen passend zijn, treft Kiff Agents
			OÜ die (versleuteling onderweg en in rust, logging van
			toegang, dataminimalisatie zoals beschreven in bijlage
			2).
		</p>
	</section>
}

templ dpaSecurityNL() {
	<section id="security">
		<h2>12. Beveiligingsmaatregelen</h2>
		<p>
			Kiff Agents OÜ treft passende technische en
			organisatorische maatregelen om een beveiligingsniveau te
			waarborgen dat op het risico is afgestemd, volgens
			artikel 32 van de AVG. De maatregelen in bijlage 2 en in
			de gedateerde revisie op
			<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>
			zijn de overeengekomen basis.
			<a href="/nl/security">/security</a> beschrijft de
			huidige maatregelen. Kiff Agents OÜ mag de maatregelen
			aanpassen, mits het algehele beveiligingsniveau niet
			onder die basis daalt, en stelt de
			Verwerkingsverantwoordelijke vooraf op de hoogte van een
			wezenlijke wijziging ervan.
		</p>
	</section>
}

templ dpaBreachNotificationNL() {
	<section id="breach-notification">
		<h2>13. Melding van een Inbreuk in verband met Persoonsgegevens</h2>
		<p>
			Kiff Agents OÜ meldt de Verwerkingsverantwoordelijke een
			Inbreuk in verband met Persoonsgegevens die de
			Persoonsgegevens van de Verwerkingsverantwoordelijke
			raakt zonder onredelijke vertraging, en in elk geval
			binnen tweeënzeventig (72) uur nadat het er kennis van
			heeft gekregen. De melding bevat, voor zover op dat
			moment bekend en aangevuld naarmate er meer informatie
			beschikbaar komt:
		</p>
		<ul>
			<li>de aard van de Inbreuk, met de categorieën en het aantal Betrokkenen en records bij benadering;</li>
			<li>de waarschijnlijke gevolgen van de Inbreuk;</li>
			<li>de maatregelen die zijn genomen of voorgesteld om de Inbreuk aan te pakken en de mogelijke nadelige gevolgen ervan te beperken;</li>
			<li>de naam en de contactgegevens van één aanspreekpunt bij Kiff Agents OÜ voor meer informatie.</li>
		</ul>
		<p>
			De eigen termijn van de Verwerkingsverantwoordelijke
			volgens artikel 33 van de AVG voor de melding aan zijn
			toezichthoudende autoriteit begint te lopen wanneer de
			Verwerkingsverantwoordelijke zelf kennis krijgt van de
			Inbreuk; deze melding ondersteunt die verplichting.
		</p>
	</section>
}

templ dpaDataSubjectRequestsNL() {
	<section id="data-subject-requests">
		<h2>14. Verzoeken van Betrokkenen</h2>
		<p>
			Kiff Agents OÜ staat de Verwerkingsverantwoordelijke met
			passende technische en organisatorische maatregelen bij,
			rekening houdend met de aard van de Verwerking, bij het
			nakomen van de verplichtingen van de
			Verwerkingsverantwoordelijke om te antwoorden op
			verzoeken van Betrokkenen die hun rechten uitoefenen op
			grond van de artikelen 15 tot en met 22 van de AVG.
		</p>
		<p>
			Kiff Agents OÜ bevestigt de ontvangst van verzoeken om
			bijstand van de Verwerkingsverantwoordelijke binnen vijf
			(5) werkdagen. Verzoeken die rechtstreeks van Betrokkenen
			komen, worden zonder onredelijke vertraging aan de
			Verwerkingsverantwoordelijke doorgestuurd; Kiff Agents OÜ
			antwoordt niet namens zichzelf op die verzoeken, behalve
			om de ontvangst te bevestigen en de Betrokkene naar de
			Verwerkingsverantwoordelijke te verwijzen.
		</p>
	</section>
}

templ dpaAuditNL() {
	<section id="audit">
		<h2>15. Auditrechten</h2>
		<p>
			Kiff Agents OÜ stelt de Verwerkingsverantwoordelijke alle
			informatie ter beschikking die redelijkerwijs nodig is om
			de naleving van artikel 28 van de AVG aan te tonen. Na
			een redelijke voorafgaande schriftelijke kennisgeving
			(minstens dertig dagen, behalve bij een audit naar
			aanleiding van een bevestigde wezenlijke inbreuk) mag de
			Verwerkingsverantwoordelijke Kiff Agents OÜ één keer per
			periode van twaalf maanden auditen.
		</p>
		<p>
			Kiff Agents OÜ heeft nog geen SOC 2- of ISO 27001-rapport.
			Op verzoek deelt het zijn beveiligingsoverzicht op
			<a href="/nl/security">/security</a> en beantwoordt het
			de beveiligingsvragenlijsten van de
			Verwerkingsverantwoordelijke.
		</p>
		<p>
			Audits vinden plaats tijdens normale kantooruren,
			verstoren de Dienst niet onredelijk en respecteren de
			vertrouwelijkheid van de andere klanten van Kiff Agents
			OÜ. De Verwerkingsverantwoordelijke draagt zijn eigen
			auditkosten; als een audit een wezenlijke niet-naleving
			door Kiff Agents OÜ aan het licht brengt, vergoedt Kiff
			Agents OÜ de redelijke auditkosten van de
			Verwerkingsverantwoordelijke.
		</p>
	</section>
}

templ dpaReturnDeletionNL() {
	<section id="return-deletion">
		<h2>16. Teruggave of verwijdering van Persoonsgegevens</h2>
		<p>
			Naar keuze van de Verwerkingsverantwoordelijke en binnen
			dertig dagen na beëindiging van de Dienst voor de
			Verwerkingsverantwoordelijke geeft Kiff Agents OÜ de
			Auditgegevens terug in een gestructureerd, gangbaar en
			machineleesbaar formaat, of verwijdert het ze. Dezelfde
			keuze geldt voor tafs-gegevens. Wordt er binnen die
			termijn geen keuze gemaakt, dan verwijdert Kiff Agents OÜ
			beide. tafs-gegevens worden verwijderd door elk taf te
			verwijderen, zoals bijlage 4 beschrijft: nadat de
			gegevens van de Verwerkingsverantwoordelijke zijn
			teruggegeven, of meteen als die voor verwijdering koos,
			verwijdert Kiff Agents OÜ elk taf dat de
			Verwerkingsverantwoordelijke niet zelf heeft verwijderd,
			en ontkoppelt en verwijdert het de koppelingen van de
			Verwerkingsverantwoordelijke en de logboeken ervan in
			planque.
		</p>
		<p>
			Hashes die al in het openbare, verifieerbare spoor zijn
			gepubliceerd, blijven staan omdat het spoor
			onveranderlijk is. Omdat het openbare spoor cryptografische
			salting per tenant gebruikt (volgens
			<a href="/nl/security#public-trail">/security#public-trail</a>),
			zorgt het vernietigen van de salt van de
			tenant ervoor dat die gepubliceerde hashes blijvend niet
			meer te koppelen zijn aan de records waaruit ze zijn
			voortgekomen.
		</p>
		<p>
			Van de database van KIFF wordt dagelijks een versleutelde
			back-up gemaakt, en elke back-up wordt zeven dagen
			bewaard, dus een verwijderd record is er binnen zeven
			dagen na de verwijdering uit verdwenen. De opslag van
			tafs en planque houdt 35 dagen versleutelde
			point-in-time-kopieën bij, dus een verwijderd record is er
			binnen 35 dagen na de verwijdering uit verdwenen; ze
			dienen alleen om een opslag na een storing te herstellen.
			Servicelogs, die het account kunnen noemen, worden binnen
			30 dagen verwijderd. Kiff Agents OÜ mag
			Persoonsgegevens bewaren waar het recht van de EU of van
			een lidstaat opslag vereist (bijvoorbeeld de Estse
			boekhoudwet §12).
		</p>
	</section>
}

templ dpaLiabilityNL() {
	<section id="liability">
		<h2>17. Aansprakelijkheid</h2>
		<p>
			Voor de aansprakelijkheid van elke partij onder deze
			Verwerkersovereenkomst gelden de beperkingen en
			uitsluitingen uit de Gebruiksvoorwaarden, behalve waar de
			geldende wetgeving zo'n beperking verbiedt. Elke partij
			is aansprakelijk voor schade die wordt veroorzaakt door
			haar eigen inbreuk op de AVG, volgens artikel 82 van de
			AVG.
		</p>
	</section>
}

templ dpaTermNL() {
	<section id="term">
		<h2>18. Looptijd en beëindiging</h2>
		<p>
			Deze Verwerkersovereenkomst gaat in bij ondertekening
			door beide partijen en loopt voor de duur die in §4 is
			beschreven. Beëindiging van de Gebruiksvoorwaarden
			beëindigt automatisch deze Verwerkersovereenkomst,
			onverminderd de verplichtingen die blijven gelden.
		</p>
	</section>
}

templ dpaGoverningLawNL() {
	<section id="governing-law">
		<h2>19. Toepasselijk recht</h2>
		<p>
			Op deze Verwerkersovereenkomst is het recht van de
			Republiek Estland van toepassing, onverminderd dwingende
			bepalingen van de AVG of, waar die gelden, regels voor
			consumentenbescherming. Voor geschillen die uit deze
			Verwerkersovereenkomst voortkomen, gelden de regels over
			de bevoegde rechter en de rechtskeuze in §18 van de
			Gebruiksvoorwaarden.
		</p>
	</section>
}

templ dpaAnnex1NL() {
	<section id="annex-1">
		<h2>Bijlage 1 — Beschrijving van de Verwerking</h2>
		<p>Wordt ingevuld per getekend exemplaar.</p>
		<dl class="legal-annex">
			<div>
				<dt>A. Lijst van partijen</dt>
				<dd>Verwerkingsverantwoordelijke en Verwerker zoals aangeduid in §1.</dd>
			</div>
			<div>
				<dt>B. Beschrijving van de doorgifte</dt>
				<dd>
					<strong>Categorieën Betrokkenen:</strong> zoals vermeld in §6, plus [eventuele verdere categorieën die de Verwerkingsverantwoordelijke opgeeft].
					<br/>
					<strong>Categorieën Persoonsgegevens:</strong> zoals vermeld in §6 (accountgegevens, koppelingen met apps, records van acties van agents, chats met tafs), plus [eventuele verdere categorieën die de Verwerkingsverantwoordelijke opgeeft].
					<br/>
					<strong>Gevoelige gegevens:</strong> [opgave van de Verwerkingsverantwoordelijke; standaard: geen].
					<br/>
					<strong>Frequentie van de doorgifte:</strong> doorlopend (elk verzoek aan de Dienst).
					<br/>
					<strong>Aard van de Verwerking:</strong> zoals beschreven in §5.
					<br/>
					<strong>Doelen van de Verwerking:</strong> zoals beschreven in §5.
					<br/>
					<strong>Bewaartermijn:</strong> volgens <a href="/nl/privacy#retention">/privacy#retention</a> en §16.
				</dd>
			</div>
			<div>
				<dt>C. Bevoegde toezichthoudende autoriteit</dt>
				<dd>De Estse Inspectie voor gegevensbescherming (Andmekaitse Inspektsioon).</dd>
			</div>
		</dl>
	</section>
}

templ dpaAnnex2NL() {
	<section id="annex-2">
		<h2>Bijlage 2 — Technische en organisatorische maatregelen</h2>
		<p>
			Een samenvatting die past bij een verwerkersovereenkomst
			volgens artikel 28. Deze bijlage en de gedateerde revisie
			op
			<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>
			zijn de overeengekomen basis volgens paragraaf 12.
			<a href="/nl/security">/security</a> toont de huidige
			maatregelen en wordt bijgewerkt binnen 30 dagen na een
			wezenlijke wijziging.
		</p>
		<div class="legal-table" tabindex="0">
			<table>
				<thead>
					<tr>
						<th>Aspect van artikel 32</th>
						<th>Maatregelen</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Pseudonimisering en versleuteling</td>
						<td>TLS 1.2+ onderweg. Versleuteling in rust met de standaardinstellingen van de aanbieder van de beheerde database. Ondertekeningssleutels per tenant, bewaard in een beheerde sleuteldienst. Het hashen van e-mailadressen in rust is gepland.</td>
					</tr>
					<tr>
						<td>Vertrouwelijkheid</td>
						<td>Isolatie van tenants op de databaselaag (een Postgres-schema per tenant met een vastgelegd <code>search_path</code>). Toegang volgens het principe van de minste rechten, single sign-on voor personeel, geheimhoudingsovereenkomsten voor alle medewerkers.</td>
					</tr>
					<tr>
						<td>Integriteit</td>
						<td>Een auditketen waaraan alleen kan worden toegevoegd, op het niveau van het framework. Samenvattende hashes waaraan manipulatie te zien is, gepubliceerd in een openbaar, verifieerbaar spoor.</td>
					</tr>
					<tr>
						<td>Beschikbaarheid en veerkracht</td>
						<td>Beheerde rekenkracht en database in <code>eu-west-1</code> (Ierland). Healthchecks. Notities voor operators op <a href="/nl/security#incident">/security#incident</a>.</td>
					</tr>
					<tr>
						<td>Herstel van toegang</td>
						<td>Gedocumenteerd draaiboek voor de reactie op incidenten, alleen intern.</td>
					</tr>
					<tr>
						<td>Testen van de doeltreffendheid</td>
						<td>Unit- en integratietests, gedraaid vóór elke release; periodieke beveiligingsbeoordeling.</td>
					</tr>
				</tbody>
			</table>
		</div>
	</section>
}

templ dpaAnnex3NL() {
	<section id="annex-3">
		<h2>Bijlage 3 — Subverwerkers</h2>
		<p>
			De officiële lijst staat op
			<a href="/nl/subprocessors">/subprocessors</a>; die lijst
			is gezaghebbend voor de huidige Subverwerkers, verandert
			alleen volgens de procedure in paragraaf 10 en wordt
			bijgewerkt binnen 30 dagen na elke wijziging. Op het
			moment van deze versie van het sjabloon:
		</p>
		<div class="legal-table" tabindex="0">
			<table>
				<thead>
					<tr>
						<th>Subverwerker</th>
						<th>Geleverde dienst</th>
						<th>Regio</th>
						<th>Doorgiftemechanisme</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Amazon Web Services EMEA SARL / Amazon Web Services Inc.</td>
						<td>Rekenkracht, beheerde Postgres, sleutelbeheer, netwerk, opslag van geheimen; voor tafs ook de runs, chats en geheugennotities ervan, en de koppelingen van planque</td>
						<td>Ierland (eu-west-1): KIFF Cloud, de tafs-dienst, de runs, chats en modelaanroepen van tafs, en planque, met alles wat ze opslaan. Ook de openbare demo's van KIFF en de video's van de site komen uit Ierland. Het enige in de Verenigde Staten (us-east-1) zijn de certificaten die CloudFront daar vereist; die bevatten geen klantgegevens</td>
						<td>EU-VS Data Privacy Framework / SCC's als terugvaloptie</td>
					</tr>
					<tr>
						<td>Clerk, Inc.</td>
						<td>Authenticatie van gebruikers en sessiebeheer: het e-mailadres en de naam van de mensen die inloggen, hun sessies, IP-adres, apparaat en browser, en de identiteit van Apple, Google of GitHub als iemand met een daarvan inlogt</td>
						<td>Verenigde Staten</td>
						<td>EU-VS Data Privacy Framework / SCC's als terugvaloptie</td>
					</tr>
					<tr>
						<td>Anthropic, PBC</td>
						<td>Alleen tafs: het AI-model achter Coach en elk taf (Claude API), dat pas gegevens krijgt als de persoon het in de tafs-app heeft toegestaan. Anthropic verwijdert wat het ontvangt en teruggeeft binnen 30 dagen, tenzij het dat langer moet bewaren om aan de wet te voldoen, om zijn gebruiksbeleid te handhaven, of zoals zijn commerciële voorwaarden anders bepalen</td>
						<td>Verenigde Staten, aangeroepen vanuit Ierland (eu-west-1); de inferentie kan draaien in de Verenigde Staten, Europa, Azië of Australië</td>
						<td>SCC's</td>
					</tr>
					<tr>
						<td>Apple Inc.</td>
						<td>Alleen tafs: bezorgt meldingen over vastgehouden aanroepen op geregistreerde apparaten (Apple Push Notification service). Een melding bevat geen details van het verzoek</td>
						<td>Verenigde Staten</td>
						<td>SCC's</td>
					</tr>
					<tr>
						<td>Resend, Inc.</td>
						<td>E-mail aan de mensen van de Verwerkingsverantwoordelijke: meldingen over vastgehouden aanroepen en Card-waarschuwingen, meldingen over gebruik en het account, en antwoorden van support; voor tafs: de e-maildeur van een taf, de mail die ernaartoe wordt gestuurd en zijn antwoorden</td>
						<td>Verenigde Staten</td>
						<td>SCC's</td>
					</tr>
					<tr>
						<td>Sampark Inc. (Composio)</td>
						<td>Alleen tafs, via planque: bewaart de logins van beheerde koppelingen en de Slack-bot achter een Slack-deur, en doet elke aanroep waar planque om vraagt, met de invoer ervan en het antwoord van de dienst. Een taf en planque krijgen die logins geen van beide</td>
						<td>Verenigde Staten</td>
						<td>SCC's (module 3)</td>
					</tr>
					<tr>
						<td>Stripe Payments Europe, Ltd. / Stripe, Inc.</td>
						<td>Facturering, wanneer die actief is: de contactpersoon voor facturering van het account, en de gebruikstellingen die voor de facturering worden doorgegeven</td>
						<td>EU en Verenigde Staten</td>
						<td>EU-VS Data Privacy Framework / SCC's als terugvaloptie</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p>
			Het openbare, verifieerbare spoor is geen Subverwerker:
			het ontvangt alleen samenvattende hashes en geen
			Persoonsgegevens.
		</p>
	</section>
}

templ dpaAnnex4NL() {
	<section id="annex-4">
		<h2>Bijlage 4 — tafs</h2>
		<p>
			Wat tafs namens de Verwerkingsverantwoordelijke bewaart,
			waar en hoe lang. De Verwerkingsverantwoordelijke
			verwijdert een taf in de tafs-app; daarmee wordt alles
			hieronder verwijderd wat wordt bewaard “tot het taf wordt
			verwijderd”.
		</p>
		<div class="legal-table" tabindex="0">
			<table>
				<thead>
					<tr>
						<th>Gegevens</th>
						<th>Waar</th>
						<th>Wat erin kan staan</th>
						<th>Hoe lang</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Runs en chats, ook die van Setup</td>
						<td>De eigen opslag van tafs (AWS, een EU-regio)</td>
						<td>De berichten van de mensen van de Verwerkingsverantwoordelijke aan het taf, zijn antwoorden en rapporten, een samenvatting van de eerdere berichten van een lange chat, de toolaanroepen die het deed, en wat elke run kostte</td>
						<td>30 dagen, of tot het taf wordt verwijderd als dat eerder is</td>
					</tr>
					<tr>
						<td>Wat de apps teruggeven</td>
						<td>De eigen opslag van tafs (AWS, een EU-regio)</td>
						<td>Resultaten van de apps van de Verwerkingsverantwoordelijke, die gegevens over zijn klanten, leveranciers of medewerkers kunnen bevatten</td>
						<td>Tot de run die ze las eindigt. In een chat worden de resultaten van aanroepen die alleen lezen bewaard voor de volgende berichten van die chat, versleuteld met een sleutel van het account van de Verwerkingsverantwoordelijke, en gebruikt tot de chat één uur stil heeft gelegen en nooit langer dan vier uur na het lezen. Daarna worden ze automatisch verwijderd, wat tot een paar dagen kan duren; in die tijd worden ze niet gebruikt. Ze worden in geen enkele weergave, rapportage of export getoond</td>
					</tr>
					<tr>
						<td>Waarop elke aanroep betrekking had</td>
						<td>De eigen opslag van tafs (AWS, een EU-regio)</td>
						<td>Voor elke aanroep die een taf via KIFF doet: de referentie van KIFF voor de aanroep en de identificator van datgene waarop die aanroep betrekking had (bijvoorbeeld een betalings-id, nooit de gegevens van de klant), om die in het Logboek van het taf te tonen. Niets anders uit de invoer van de aanroep</td>
						<td>30 dagen, of tot het taf wordt verwijderd als dat eerder is</td>
					</tr>
					<tr>
						<td>Geheugennotities</td>
						<td>De eigen opslag van tafs (AWS, een EU-regio)</td>
						<td>Wat het taf heeft geleerd over hoe de Verwerkingsverantwoordelijke de taak gedaan wil hebben</td>
						<td>Tot de notitie wordt vergeten of het taf wordt verwijderd</td>
					</tr>
					<tr>
						<td>Modelverzoeken</td>
						<td>Anthropic</td>
						<td>Wat iemand aan Coach en de tafs schrijft, bijgevoegde bestanden, wat gekoppelde apps een taf tijdens een run teruggeven, en wat er op het scherm staat terwijl Coach in de app helpt; en wat het model teruggeeft. Nooit de wachtwoorden en sleutels van gekoppelde apps, of een vingerafdruk</td>
						<td>Standaard binnen 30 dagen door Anthropic verwijderd; langer waar Anthropic het moet bewaren om aan de wet te voldoen, om zijn gebruiksbeleid te handhaven, of zoals zijn commerciële voorwaarden anders bepalen</td>
					</tr>
					<tr>
						<td>De KIFF-sleutel van het taf</td>
						<td>De eigen dienst van tafs (AWS), bewaard als geheim</td>
						<td>Het toegangsbewijs waarmee het taf KIFF bereikt. Nooit in een run of chat geschreven</td>
						<td>Tot het taf wordt verwijderd</td>
					</tr>
					<tr>
						<td>De instellingen van het taf</td>
						<td>De eigen dienst van tafs (AWS)</td>
						<td>Zijn naam, taak, planning en budget, en het KIFF-account en de agent waar het bij hoort</td>
						<td>Tot het taf wordt verwijderd</td>
					</tr>
					<tr>
						<td>Apparaten voor meldingen</td>
						<td>De eigen dienst van tafs (AWS, eu-west-1)</td>
						<td>Het pushtoken van elk geregistreerd apparaat en de persoon die het heeft geregistreerd</td>
						<td>Tot die persoon uitlogt, het apparaat wordt verwijderd, of Apple meldt dat het token weg is</td>
					</tr>
					<tr>
						<td>Het token of de sleutel van een koppeling in planque</td>
						<td>planque (AWS, eu-west-1), versleuteld met AWS KMS</td>
						<td>Voor een app waarbij planque zelf inlogt, zoals Stripe, het token van de login van de Verwerkingsverantwoordelijke bij de aanbieder ervan, en het account bij de aanbieder waaraan het is gebonden; voor een koppeling met een sleutel, de sleutel die de Verwerkingsverantwoordelijke heeft opgegeven. Nooit aan een taf gegeven</td>
						<td>Tot de koppeling wordt ontkoppeld, waarbij een token bij de aanbieder wordt ingetrokken en het token of de sleutel wordt verwijderd; een login die een andere koppeling van het account nog gebruikt, blijft tot de laatste verdwijnt. Een login die alleen is gedaan om de catalogus van een app te bekijken, kan niet voor aanroepen worden gebruikt; als er binnen een dag geen tools zijn goedgekeurd, wordt die login binnen het uur daarna ingetrokken</td>
					</tr>
					<tr>
						<td>De login van een beheerde koppeling</td>
						<td>Composio (Sampark Inc., Verenigde Staten)</td>
						<td>Het token of de sleutel van de login van de Verwerkingsverantwoordelijke bij de aanbieder van een beheerde koppeling. Bewaard door Composio en nooit aan een taf of aan planque gegeven, dat alleen het logboek van de koppeling en de goedgekeurde tools bewaart. Composio bewaart die ook als de login de eigen app van KIFF bij de aanbieder gebruikt</td>
						<td>Tot de koppeling wordt ontkoppeld: planque laat de login dan bij Composio verwijderen, dat de aanbieder vraagt die in te trekken. Een login die een andere koppeling van het account nog gebruikt, blijft tot de laatste verdwijnt. Als er binnen een dag na de login geen tools zijn goedgekeurd, wordt die op dezelfde manier verwijderd</td>
					</tr>
					<tr>
						<td>De aanroepen van een beheerde koppeling</td>
						<td>Composio (Sampark Inc., Verenigde Staten)</td>
						<td>De invoer van elke aanroep en het antwoord van de dienst, voor een aanroep die planque Composio laat doen</td>
						<td>Tot een jaar, in de logs van Composio; binnen 30 dagen verwijderd nadat KIFF Composio niet meer gebruikt</td>
					</tr>
					<tr>
						<td>Het logboek van een koppeling</td>
						<td>planque (AWS, eu-west-1)</td>
						<td>De goedgekeurde tools, de status van de koppeling en de gebeurtenissen ervan: wie elke stap heeft goedgekeurd, vanaf welk apparaat, en de handtekening van die persoon</td>
						<td>Tot het account eindigt; na het ontkoppelen bewaard als het logboek van de goedkeuringen</td>
					</tr>
					<tr>
						<td>De connectorsleutel van het account</td>
						<td>planque (AWS, eu-west-1), versleuteld met AWS KMS</td>
						<td>De KIFF-sleutel waarmee planque de tools van een koppeling aan het KIFF-account van de Verwerkingsverantwoordelijke toevoegt. Die kan alleen de tools van een koppeling toevoegen</td>
						<td>Tot die wordt vervangen, of het account eindigt</td>
					</tr>
					<tr>
						<td>De servicelogs van planque</td>
						<td>planque (AWS, eu-west-1)</td>
						<td>Wat elk verzoek deed, en waarom een aanroep is geweigerd, wat het account, een koppeling of een taf kan noemen; nooit het token van een login</td>
						<td>30 dagen</td>
					</tr>
					<tr>
						<td>Servicelogs</td>
						<td>De eigen dienst van tafs (AWS, eu-west-1)</td>
						<td>Fouten waar een verzoek op stuitte, die een taf of een sessie kunnen noemen; nooit de inhoud van berichten, sleutels of tokens</td>
						<td>30 dagen</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p>
			De Cards, vastgehouden aanroepen, antwoorden en
			ontvangstbewijzen van een taf zijn Auditgegevens, die KIFF
			bewaart volgens de rest van deze Verwerkersovereenkomst.
		</p>

		<hr/>

