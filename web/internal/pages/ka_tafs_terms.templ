package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsTermsKA is tafs's terms (/tafs/terms) in Georgian, at /ka/tafs/terms.
// It is a translation of TafsTerms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Georgian has the legal
// texts only, so a link to any other page goes to English and says so.
templ TafsTermsKA() {
	@components.LayoutSiteWithMeta("tafs პირობები", "პირობები tafs-ისთვის, KIFF-ის აპისთვის: ვინ გთავაზობთ, თქვენი ანგარიში, რას აკეთებს taf და როგორ აკონტროლებთ, დასაშვები გამოყენება, გადასახადები, პასუხისმგებლობა და დასრულება.", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · პირობები</p>
				<h1>tafs პირობები</h1>
				<p class="legal-meta"><strong>ბოლო განახლება:</strong> 2026 წლის 21 ნოემბერი.</p>
				<p class="legal-disclaimer">ეს პირობები ეხება tafs-ს, KIFF-ის აპს iPhone-ის, iPad-ის, Android-ისა და კომპიუტერებისთვის, და მის უკან მდგომ სერვისს. tafs არის KIFF Cloud-ის ნაწილი, და ეს გვერდი იმეორებს, რასაც <a href="/ka/terms">KIFF-ის მომსახურების პირობები</a> ამბობს მასზე, მათთვის არაფრის დამატების გარეშე. KIFF-ის პირობები ვრცელდება ყველაფერზე, რასაც ეს გვერდი არ მოიცავს. კითხვები: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.</p>
			</header>
			<section id="provider">
				<h2>1. ვინ გთავაზობთ tafs-ს</h2>
				<p>tafs-ს გთავაზობთ <strong>Kiff Agents OÜ</strong>, შეზღუდული პასუხისმგებლობის კერძო კომპანია ესტონეთში (რეესტრის კოდი 17372313), მისამართზე Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, ესტონეთი. ანგარიშის შექმნით ან სხვაგვარად tafs-ის გამოყენებით ეთანხმებით ამ პირობებს და KIFF-ის პირობებს. თუ კომპანიის სახელით ეთანხმებით, ადასტურებთ, რომ შეგიძლიათ მისი დაკავშირება.</p>
			</section>
			<section id="account">
				<h2>2. თქვენი ანგარიში</h2>
				<p>tafs-ში შედიხართ KIFF ანგარიშით. მიუთითეთ ზუსტი ინფორმაცია, შეინახეთ თქვენი რწმუნებათა სიგელები კონფიდენციალურად, და პასუხისმგებელი ხართ თქვენი ანგარიშის ქვეშ ყველა აქტივობაზე და ყველა ადამიანზე, ვისაც შიგნით უშვებთ. უნდა იყოთ სულ მცირე 16 წლის ან იმ ადგილას ციფრული თანხმობის ასაკის, სადაც ცხოვრობთ, რომელიც უფრო მაღალია. tafs შეგიძლიათ გამოიყენოთ მხოლოდ იმ ქვეყნიდან ან რეგიონიდან, სადაც Anthropic საკუთარ სერვისს გთავაზობთ, როგორც <a href="https://www.anthropic.com/supported-countries">Anthropic ჩამოთვლის</a>; არა იმ კომპანიისთვის, რომლის სათაო ოფისი, ან მასზე უმრავლესობით მფლობელი ან მაკონტროლებელი კომპანიის სათაო ოფისი, ამ სიის გარეთ მდებარე ქვეყანაში ან რეგიონშია; და არა თუ თქვენ ან კომპანია, რომლისთვისაც იყენებთ, ევროკავშირის, გაერთიანებული ერების ორგანიზაციის ან შეერთებული შტატების სანქციებს ექვემდებარება (KIFF-ის პირობები, §4).</p>
			</section>
			<section id="what-a-taf-does">
				<h2>3. რას აკეთებს taf</h2>
				<p>tafs-ში სამუშაოს ანდობთ taf-ს: AI აგენტს, რომელიც განრიგით მუშაობს თქვენ მიერ დაკავშირებული ინსტრუმენტებით, მისთვის გაცემული KIFF Card-ების ფარგლებში. AI მოდელს, რომელსაც ის იყენებს, Anthropic უზრუნველყოფს. Setup, AI აგენტი tafs-ში, გეხმარებათ ინსტრუმენტის დაკავშირებასა და taf-ის მოწყობაში, მაგრამ თავად არაფერს აკავშირებს: შედიხართ ინსტრუმენტის საკუთარ პროვაიდერთან და თქვენს მოწყობილობაზე ამტკიცებთ თითოეულ კავშირს, ინსტრუმენტებს, რომლებსაც taf შეიძლება იყენებდეს, და მის Card-ებს.</p>
				<p>taf-ის ანგარიშებს, შეტყობინებებსა და მეხსიერების ჩანაწერებს წერს AI მოდელი და ისინი შეიძლება არასწორი იყოს. შეამოწმეთ ის, რაც მნიშვნელოვანია, სანამ დაეყრდნობით. ყველაფერი, რასაც taf თქვენი კომპანიის გარეთ ვინმეს წერს, ამბობს, რომ დაწერილია AI აგენტის მიერ.</p>
			</section>
			<section id="control">
				<h2>4. თქვენი კონტროლი: Card და დადასტურებები</h2>
				<p>taf თქვენს ინსტრუმენტებს აღწევს მხოლოდ KIFF-ის გავლით, რომელიც ყოველ გამოძახებას გაგზავნამდე taf-ის Card-ებს ადარებს. გამოძახება თქვენ მიერ გაცემული Card-ის ფარგლებში თქვენი მითითებით ხდება. გამოძახება Card-ის გარეთ ჩერდება ან უარყოფილია, როგორც Card ამბობს. შეჩერებული გამოძახება სრულდება მხოლოდ მას შემდეგ, რაც დაამტკიცებს ვინმე, ვისაც თქვენი ანგარიში შეჩერებულ გამოძახებებზე პასუხის უფლებას აძლევს.</p>
				<p>თქვენ ირჩევთ თითოეული taf-ის სამუშაოს და Card-ებს, პასუხობთ მის შეჩერებულ გამოძახებებს და ზრუნავთ, რომ გქონდეთ უფლება გამოიყენოთ ინსტრუმენტები და ანგარიშები, რომლებსაც აკავშირებთ. შეგიძლიათ შეაჩეროთ (halt) ერთი taf ან ყველა, დააპაუზოთ taf, გააუქმოთ მისი ნებისმიერი Card ან ამოიღოთ. იმ მომენტიდან, როცა taf-ს აჩერებთ ან Card-ს აუქმებთ, KIFF არ უშვებს ახალ გამოძახებას იმ taf-ის ან იმ Card-ის ქვეშ. ინსტრუმენტის პროვაიდერისთვის უკვე გაგზავნილი მოთხოვნა შეიძლება მაინც დასრულდეს: ჩვენ ახალ გამოძახებებს ვაჩერებთ და ვერ გავაუქმებთ იმას, რაც პროვაიდერმა უკვე გააკეთა. <a href="/ka/terms#tafs">KIFF-ის პირობები, §3A</a> დეტალებს შეიცავს.</p>
				<p>ევროკავშირის AI აქტის მიხედვით, Kiff Agents OÜ არის tafs-ის პროვაიდერი, ხოლო თქვენ — მისი დეპლოერი. tafs გამოიყენეთ მხოლოდ იმ სამუშაოებისთვის, რასაც გთავაზობთ, და არა რაიმე გამოყენებისთვის, რომელსაც AI აქტი კრძალავს ან მაღალი რისკის კლასად მიიჩნევს, როგორიცაა გადაწყვეტილებები პირის დასაქმების, კრედიტის ან აუცილებელ სერვისებზე წვდომის შესახებ.</p>
			</section>
			<section id="acceptable-use">
				<h2>5. დასაშვები გამოყენება</h2>
				<p>თქვენ, თქვენმა ადამიანებმა და თქვენმა taf-ებმა უნდა დაიცვათ <a href="/acceptable-use">დასაშვები გამოყენების პოლიტიკა</a> (ინგლისურად). აგენტის მოქმედება თქვენი მოქმედებაა. სხვა საკითხებთან ერთად, tafs ვერ გამოიყენებთ კანონის დასარღვევად, სისტემაზე ან ანგარიშზე სამოქმედოდ, რომლის გამოყენების უფლებაც არ გაქვთ, ინსტრუმენტის დასაკავშირებლად შესვლით, რომლის გაცემის უფლებაც თქვენ არ გაქვთ, სპამის გასაგზავნად ან Card-ის, ლიმიტის ან შეჩერების გვერდის ავლით. შეგვიძლია დაუყოვნებლივ შევაჩეროთ სარწმუნო დარღვევისას.</p>
			</section>
			<section id="fees">
				<h2>6. გადასახადები</h2>
				<p>ამ განახლების დროს, Solo არის { tafsCostKA.money(TafsSoloCents) } თვეში, დღგ-ის ჩათვლით, თვეში { tafsCostKA.number(TafsSoloCredits) } კრედიტით, იყიდება აპში App Store-ის ან Google Play-ის გავლით. კრედიტების პაკეტები, შეძენილი აპში, იწყება { tafsCostKA.money(TafsPackCents[TafsSoloCredits]) }-დან; ვადა არ გასდით. taf-ის თითოეული გაშვება იყენებს კრედიტებს AI-სთვის, რომელიც გამოიყენა. Coach და taf-ების მოწყობა შედის Coach-ის სამართლიანი გამოყენების ფარგლებში. ეს არის ფასები ევროს ზონაში. სხვაგან App Store ან Google Play ფასს გაჩვენებთ თქვენს ვალუტაში, ადგილობრივი გადასახადით ან მის გარეშე, როგორც ამ ქვეყნის წესები მოითხოვს, და ეს არის ფასი, რომელსაც იხდით. მიმდინარე ფასები <a href="/pricing">ფასების გვერდზეა</a> (ინგლისურად); tafs ასევე KIFF-ის Company გეგმის ნაწილია.</p>
				<p>საცდელი პერიოდი არ არსებობს. აპში შეძენილი Solo იმართება და უქმდება თქვენს Apple-ის ან Google Play-ის გამოწერებში, იმ მაღაზიის პირობებით გადახდის, განახლებისა და დაბრუნებისთვის. გეგმა გრძელდება გადახდილი პერიოდის ბოლომდე. თუ ევროკავშირში მომხმარებელი ხართ, შეგიძლიათ შეძენიდან 14 დღეში უარი თქვათ. <a href="/ka/terms#fees">KIFF-ის პირობები, §8</a> დეტალებს შეიცავს.</p>
			</section>
			<section id="liability">
				<h2>7. პასუხისმგებლობა</h2>
				<p>tafs მიეწოდება „როგორც არის“ და „როგორც ხელმისაწვდომია“, KIFF-ის პირობების (§10) გარანტიების გარდა. კანონით დასაშვები ზომით, არც ერთი მხარე არ აგებს პასუხს ირიბ ან თანმდევ ზიანზე, და თითოეული მხარის ჯამური პასუხისმგებლობა შეზღუდულია, როგორც <a href="/ka/terms#liability">KIFF-ის პირობები, §12</a> ამბობს. არაფერი ზღუდავს პასუხისმგებლობას, რომლის შეზღუდვასაც კანონი არ უშვებს.</p>
			</section>
			<section id="termination">
				<h2>8. დასრულება</h2>
				<p>შეგიძლიათ ნებისმიერ დროს შეწყვიტოთ: წაშალეთ თქვენი ანგარიში აპში, ანგარიში → <em>ანგარიშის წაშლა</em>. ჯერ ექსპორტი გააკეთეთ თქვენი საუბრების, ანგარიში → ჩემი საუბრების ექსპორტი. შეგვიძლია თქვენი გამოყენება დავასრულოთ არსებითი დარღვევისთვის, რომელიც შეტყობინებიდან ოცდაათ დღეში არ გამოსწორდა, ან დაუყოვნებლივ დასაშვები გამოყენების დარღვევისთვის. თქვენი უფლებები, წახვიდეთ და თქვენი მონაცემები წაიღოთ, არის <a href="/ka/terms#term">KIFF-ის პირობები, §9</a>-ში.</p>
			</section>
			<section id="governing-law">
				<h2>9. ცვლილებები და მოქმედი სამართალი</h2>
				<p>ამ პირობებს ვცვლით ისე, როგორც KIFF-ის პირობები ამბობს საკუთარისთვის (§16). ისინი რეგულირდება ესტონეთის რესპუბლიკის კანონებით, და დავები განიხილება ჰარიუს საოლქო სასამართლოში ტალინში. თუ ევროკავშირის სხვა წევრ სახელმწიფოში მომხმარებელი ხართ, თქვენი ქვეყნის სავალდებულო სამომხმარებლო დაცვის ნორმები კვლავ მოქმედებს.</p>
			</section>
			<section id="contact">
				<h2>10. კონტაქტი</h2>
				<p>სახელშეკრულებო კითხვები: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>. დახმარება აპთან დაკავშირებით: <a href="mailto:support@kiff.dev">support@kiff.dev</a>. კონფიდენციალურობა: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>, და როგორ ამუშავებს tafs პერსონალურ მონაცემებს, <a href="/ka/tafs/privacy">tafs კონფიდენციალურობის პოლიტიკაშია</a>.</p>
			</section>
		</article>
	}
