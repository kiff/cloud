package pages

import (
	"html/template"
	"strconv"

	"github.com/kiff/cloud/web/internal/components"
	"github.com/kiff/cloud/web/internal/content/blog"
)

// BlogIndexView is the index: posts grouped by year. When Tag is set the
// page is a filtered view for that tag (reached from a post's tags).
type BlogIndexView struct {
	Years []blog.Year
	Tag   string
	Total int
}

// BlogPostView is one article plus its rendered body.
type BlogPostView struct {
	Post blog.Post
	Body template.HTML
	Related []blog.Post
}

// blogKindClass keeps the kind chip's colour in CSS rather than markup.
func blogKindClass(k blog.Kind) string {
	return "blog-kind blog-kind-" + string(k)
}

templ blogTagList(tags []string) {
	if len(tags) > 0 {
		<ul class="blog-tags">
			for _, t := range tags {
				<li>
					<a class="blog-tag" href={ templ.SafeURL("/blog/tags/" + t) }>{ t }</a>
				</li>
			}
		</ul>
	}
}

templ blogCard(p blog.Post) {
	<article class="blog-card">
		<p class="blog-card-meta">
			<time class="blog-date" datetime={ p.Date }>{ p.Date }</time>
			<span class={ blogKindClass(p.Kind) }>{ p.Kind.Label() }</span>
			<span class="blog-read-time">{ strconv.Itoa(p.ReadMinutes()) } min read</span>
			if p.Draft {
				<span class="blog-kind blog-kind-draft">Draft</span>
			}
		</p>
		<h3 class="blog-card-title">
			<a href={ templ.SafeURL("/blog/" + p.Slug) }>{ p.Title }</a>
		</h3>
		<p class="blog-card-summary">{ p.Summary }</p>
		@blogTagList(p.Tags)
	</article>
}

// blogListItem is one line of the index: the title, the date and the
// summary, which blog.css clamps to one line. Kind, reading time and
// tags are on the post itself.
templ blogListItem(p blog.Post) {
	<li class="blog-item">
		<a class="blog-item-title" href={ templ.SafeURL("/blog/" + p.Slug) }>{ p.Title }</a>
		<p class="blog-item-meta">
			<time class="blog-date" datetime={ p.Date }>{ p.Date }</time>
			if p.Draft {
				<span class="blog-kind blog-kind-draft">Draft</span>
			}
		</p>
		<p class="blog-item-summary">{ p.Summary }</p>
	</li>
}

// BlogIndex lists posts newest first, grouped by year: a title, a date
// and one line each. Grouping happens inside this page rather than across
// /blog/{year} archives, so the structure reads correctly at three posts
// and still at sixty.
templ BlogIndex(view BlogIndexView) {
	@components.LayoutSite(blogIndexTitle(view), "blog", "css/prose.css", "css/blog.css") {
		<section class="blog-index">
			<header class="blog-index-head">
				if view.Tag != "" {
					<p class="eyebrow"><a href="/blog">← All articles</a></p>
					<h1>Tagged &ldquo;{ view.Tag }&rdquo;</h1>
				} else {
					<h1>Blog</h1>
				}
			</header>
			if view.Total == 0 {
				<p class="blog-empty">Nothing published yet.</p>
			} else {
				for _, y := range view.Years {
					<section class="blog-year">
						<h2 class="blog-year-head">{ strconv.Itoa(y.Year) }</h2>
						<ol class="blog-list">
							for _, p := range y.Posts {
								@blogListItem(p)
							}
						</ol>
					</section>
				}
			}
		</section>
	}
}

func blogIndexTitle(view BlogIndexView) string {
	if view.Tag != "" {
		return "KIFF — writing tagged " + view.Tag
	}
	return "KIFF — writing"
}

templ blogToc(headings []blog.Heading) {
	<nav class="blog-toc" aria-label="Contents">
		<p class="blog-toc-label">Contents</p>
		<ol>
			for _, h := range headings {
				<li class={ "blog-toc-h" + strconv.Itoa(h.Level) }>
					<a href={ templ.SafeURL("#" + h.ID) }>{ h.Text }</a>
				</li>
			}
		</ol>
	</nav>
}

// BlogPost renders one article in a reading column, with a contents nav
// alongside it once the post is long enough (3+ headings) to need one.
// The wrapper only ever gets a second grid child when the nav actually
// renders — a two-column grid with one child auto-places that child into
// the first (narrow) column instead of spanning it, so the layout class
// has to track blogToc's own threshold exactly.
templ BlogPost(view BlogPostView) {
	{{ headings := blog.Headings(view.Post.Body) }}
	{{ hasToc := len(headings) >= 3 }}
	@components.LayoutSiteWithMeta("KIFF — "+view.Post.Title, view.Post.Summary, "article", "blog", "css/prose.css", "css/blog.css") {
		<div class={ "blog-post-layout", templ.KV("blog-post-layout-with-toc", hasToc) }>
			if hasToc {
				@templ.Raw("<style>" + blog.TocFallbackCSS(headings) + "</style>")
				<aside class="blog-toc-desktop">@blogToc(headings)</aside>
			}
			<article class="blog-post">
				<header class="blog-post-head">
					<p class="eyebrow"><a class="blog-back" href="/blog">← All articles</a></p>
					<h1>{ view.Post.Title }</h1>
					<p class="blog-post-meta">
						<time datetime={ view.Post.Date }>{ view.Post.Date }</time>
						<span aria-hidden="true">·</span>
						<span>{ view.Post.Author }</span>
						<span aria-hidden="true">·</span>
						<span class="blog-read-time" title="Estimated reading time">{ strconv.Itoa(view.Post.ReadMinutes()) } min read</span>
						<span class={ blogKindClass(view.Post.Kind) }>{ view.Post.Kind.Label() }</span>
						if view.Post.Draft {
							<span class="blog-kind blog-kind-draft">Draft</span>
						}
					</p>
					<p class="blog-post-summary">{ view.Post.Summary }</p>
					@blogTagList(view.Post.Tags)
				</header>
				if hasToc {
					<details class="blog-toc-mobile">
						<summary>On this page</summary>
						@blogToc(headings)
					</details>
				}
				<div class="prose">
					@templ.Raw(view.Body)
				</div>
				if len(view.Related) > 0 {
					<section class="blog-related" aria-labelledby="blog-related-heading">
						<h2 id="blog-related-heading">Read next</h2>
						<div class="blog-cards">
							for _, p := range view.Related {
								@blogCard(p)
								}
						</div>
					</section>
				}
				<nav class="blog-post-footer" aria-label="Blog navigation">
					<a class="blog-back" href="/blog">← All articles</a>
				</nav>
			</article>
		</div>
	}
}
