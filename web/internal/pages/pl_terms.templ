package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// TermsPL is the Terms of Service (/terms) in Polish, at /pl/terms. It is
// a translation of Terms: the same sections, anchors, links and figures,
// held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one.
templ TermsPL() {
	@components.LayoutSite("KIFF — warunki korzystania z usługi", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@termsHeadPL()
			@termsDefinitionsPL()
			@termsAgreementPL()
			@termsServicePL()
			@termsTafsPL()
			@termsAccountPL()
			@termsAcceptableUsePL()
			@termsCustomerDataPL()
			@termsConfidentialityPL()
			@termsFeesPL()
			@termsTermPL()
			@termsWarrantiesPL()
			@termsDisclaimerPL()
			@termsLiabilityPL()
			@termsIndemnityPL()
			@termsSLAPL()
			@termsServiceModsPL()
			@termsTermsModsPL()
			@termsForceMajeurePL()
			@termsGoverningLawPL()
			@termsGeneralPL()
			@termsContactPL()
		</article>
	}
}

templ termsHeadPL() {
	<header class="legal-head">
		<p class="legal-badge">Warunki korzystania z usługi · v0.1</p>
		<h1>Warunki korzystania z usługi</h1>
		<p class="legal-meta">
			<strong>Ostatnia aktualizacja:</strong> 22 listopada 2026.
			<strong>Data wejścia w życie:</strong> 24 maja 2026.
		</p>
		<p class="legal-disclaimer">
			<strong>Co się zmieniło:</strong> z kim zawierasz umowę, gdy poleciła Cię inna firma (§2), oraz mikroprzedsiębiorstwa (§8). Wcześniej: kto może korzystać z Usługi, według regionu, własności i sankcji (§4); aplikacja tafs na Androidzie
			i Solo kupowany przez Google Play (§1, §8). Jeszcze wcześniej: płatne
			plany (§3A, §8),
			<a href="/legal/sla">umowa o gwarantowanym poziomie usług</a> (po angielsku) (§14)
			oraz lista zakazanych zastosowań, która znajduje się teraz
			w <a href="/pl/acceptable-use">Zasadach dopuszczalnego użytkowania</a> (§5).
		</p>
		<p class="legal-disclaimer">
			Te warunki regulują korzystanie z KIFF Cloud, w tym z tafs.
			Pytania dotyczące umowy:
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</header>
}

templ termsDefinitionsPL() {
	<section id="definitions">
		<h2>1. Definicje</h2>
		<ul>
			<li><strong>„Kiff Agents OÜ”</strong>, <strong>„my”</strong>, <strong>„nas”</strong>, <strong>„nasz”</strong> — estońska spółka z ograniczoną odpowiedzialnością, która świadczy Usługę. Numer rejestrowy 17372313.</li>
			<li><strong>„Klient”</strong>, <strong>„Ty”</strong>, <strong>„Twój”</strong> — osoba fizyczna lub prawna, która akceptuje te warunki.</li>
			<li><strong>„Użytkownik”</strong> — każda osoba, którą Klient upoważnia do dostępu do Usługi przez konto Klienta.</li>
			<li><strong>„Usługa”</strong> — produkt KIFF Cloud, w tym <code>api.kiff.dev</code>, <code>app.kiff.dev</code>, <code>kiff.dev</code>, tafs oraz dokumentacja, panele i API, które tam publikujemy.</li>
			<li><strong>„tafs”</strong> — aplikacja tafs na iPhone’a, iPada, Androida i komputery (Mac, Windows i Linux) oraz usługa, która za nią stoi, w tym Setup i planque (§3A), w której Klient przekazuje zadanie agentowi AI pracującemu w ramach Card KIFF. <strong>„Taf”</strong> to jeden taki agent.</li>
			<li><strong>„Tenant”</strong> — logicznie odizolowana przestrzeń robocza wewnątrz Usługi, należąca do jednego Klienta.</li>
			<li><strong>„Dane Audytowe”</strong> — zdarzenia, decyzje, akcje, zatwierdzenia i potwierdzenia, które Usługa utrwala w imieniu Klienta przez środowisko wykonawcze.</li>
			<li><strong>„Dane tafs”</strong> — to, co tafs przechowuje w imieniu Klienta: uruchomienia i czaty każdego tafa (w tym to, co zwracają mu połączone aplikacje Klienta), jego raporty, jego notatki pamięci oraz telefony zarejestrowane do jego alertów.</li>
			<li><strong>„Potwierdzenie”</strong> — podpisany, wersjonowany zapis decyzji wystawiany przez Usługę dla każdej kontrolowanej akcji.</li>
			<li><strong>„Dokumentacja”</strong> — dokumentacja techniczna Usługi i środki bezpieczeństwa w datowanej wersji, do której prowadzą te Warunki (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>). Nie obejmuje strategicznego whitepaper, materiałów marketingowych ani dokumentacji osobno licencjonowanego frameworka open source.</li>
			<li><strong>„DPA”</strong> — umowa powierzenia przetwarzania danych na stronie <a href="/pl/legal/dpa">/legal/dpa</a>, która reguluje naszą relację jako podmiotu przetwarzającego.</li>
		</ul>
	</section>
}

templ termsAgreementPL() {
	<section id="agreement">
		<h2>2. Umowa</h2>
		<p>
			Te warunki regulują Twoje korzystanie z Usługi. Zakładając
			konto, generując klucz API lub w inny sposób korzystając
			z Usługi, akceptujesz te warunki. Jeśli akceptujesz je
			w imieniu spółki lub innego podmiotu prawnego, oświadczasz,
			że masz umocowanie do zaciągania zobowiązań w imieniu tego
			podmiotu, a „Ty” i „Twój” oznaczają ten podmiot.
		</p>
		<p>
			Jeśli programista, partner lub inna firma poleciła Ci KIFF albo zbudowała agenta, z którego korzystasz, Twoja umowa o Usługę jest zawierana bezpośrednio z nami, na tych warunkach, i akceptujesz je samodzielnie. Ta firma nie jest naszym przedstawicielem: nie może zaakceptować tych warunków, wyrazić zgody ani zatwierdzić płatności w Twoim imieniu i nie sprzedaje Usługi w naszym imieniu.
		</p>
		<p>
			Możemy publikować warunki uzupełniające dla konkretnych
			funkcji (funkcje beta, integracje z usługami innych firm).
			Gdy są one sprzeczne z tymi warunkami, w odniesieniu do
			danej funkcji rozstrzygają warunki uzupełniające.
		</p>
	</section>
}

templ termsServicePL() {
	<section id="service">
		<h2>3. Usługa</h2>
		<p>
			KIFF Cloud to hostowana usługa do kontroli delegowanych
			akcji. Ocenia żądania według skonfigurowanych przez Klienta
			uprawnień i Card, może wymagać zatwierdzenia przez
			człowieka i zapisuje decyzje kontrolne. Zależnie od
			skonfigurowanej integracji KIFF przekazuje dalej
			autoryzowane żądanie albo wydaje autoryzację, którą
			weryfikuje chroniony system. Samą akcję wykonuje połączony
			system.
		</p>
		<p>
			Obowiązujące zachowanie techniczne, dowody, wymagania
			integracyjne i limity wykonania określa datowana
			Dokumentacja, do której prowadzą te Warunki. Strategiczny
			<a href="/whitepaper">whitepaper</a> (po angielsku) wyjaśnia
			zasady i model KIFF; nie jest włączony do tych Warunków jako
			Dokumentacja techniczna.
		</p>
		<p>
			Usługa kontroli KIFF Cloud <em>nie</em> jest frameworkiem
			agentów, silnikiem przepływów pracy, bramą do modeli ani
			zarządzaną platformą agentów. Współdziała z tym, czego już
			używasz. Pełną listę znajdziesz w sekcji
			<a href="/#not">„Czym KIFF nie jest”</a> na stronie głównej.
			tafs to jedyna część Usługi, która prowadzi agentów dla
			Ciebie, w ramach Card, które wydajesz; opisuje ją §3A.
		</p>
		<p>
			Framework open source <a href="https://github.com/kiff/kiff" target="_blank" rel="noopener">kiff/kiff</a>
			podlega własnej licencji MIT i nie jest objęty tymi
			warunkami. Gdy uruchamiasz framework na własnej
			infrastrukturze, nie powstaje żadna umowa z Kiff Agents OÜ.
		</p>
	</section>
}

templ termsTafsPL() {
	<section id="tafs">
		<h2>3A. tafs</h2>
		<p>
			W tafs przekazujesz zadanie (na przykład zwroty, płacenie
			rachunków lub spory dotyczące płatności kartą) tafowi: agentowi AI, który
			pracuje według harmonogramu z aplikacjami, które łączysz,
			w ramach Card KIFF, które dla niego wydajesz. Każdy taf
			działa w naszym środowisku wykonawczym agentów, a model AI,
			którego używa, dostarcza Anthropic. Na jego oczekujące
			wywołania odpowiadasz w aplikacji tafs.
		</p>
		<p>
			<strong>Łączenie Twoich aplikacji.</strong> Setup,
			agent AI w tafs, który działa jak taf, pomaga Ci połączyć
			aplikację i skonfigurować tafa do zadania. Sam niczego nie
			łączy. Logujesz się u własnego dostawcy aplikacji (na
			przykład Stripe) i zatwierdzasz na swoim urządzeniu każde
			połączenie, narzędzia, których taf może używać, oraz jego
			Card. Token z tego logowania przechowuje planque, nasza
			usługa połączeń. Jest zaszyfrowany, używany wyłącznie do
			wykonania wywołania, o którym zdecydował KIFF, i nigdy nie
			jest przekazywany tafowi. Rozłączenie aplikacji unieważnia
			token u dostawcy i usuwa go.
		</p>
		<p>
			<strong>Twoje Card są Twoimi poleceniami.</strong> Taf
			dociera do Twoich aplikacji tylko przez KIFF, który
			sprawdza każde wywołanie względem Card tafa, zanim zostanie
			wysłane. Wywołanie mieszczące się w wydanej przez Ciebie
			Card jest wykonywane na Twoje polecenie. Wywołanie poza Card
			pozostaje oczekujące albo jest odrzucane, zgodnie z tym, co
			mówi Card. Oczekujące wywołanie jest wykonywane dopiero
			wtedy, gdy zatwierdzi je osoba, której Twoje konto pozwala
			odpowiadać na oczekujące wywołania. W aplikacji tafs
			odpowiedź zawiera podpis z urządzenia tej osoby, który KIFF
			weryfikuje, a potwierdzenie zachowuje ten dowód. Twoje konto
			może też odpowiadać w samym KIFF (w panelu, w jego narzędziu
			wiersza poleceń albo przez zatwierdzającego, którego tam
			upoważnisz); potwierdzenie zapisuje wtedy, kto odpowiedział
			i w jaki sposób.
		</p>
		<p>
			<strong>Płatności.</strong> Gdy taf płaci za Ciebie przy kasie w sklepie internetowym, kartą lub inną metodą płatności zapisaną w tym serwisie, robi to wyłącznie w ramach Card i dopiero po tym, jak zatwierdzisz tę płatność w telefonie. Twoje zatwierdzenie upoważnia do tej jednej płatności w Twoim imieniu. Serwis i jego operator płatności ją przetwarzają. KIFF i planque nigdy nie przechowują Twoich pieniędzy, nigdy nie zapisują danych Twojej karty, a taf nigdy nie wpisuje numeru karty.
		</p>
		<p>
			<strong>Co pozostaje po Twojej stronie.</strong> Wybierasz
			zadanie i Card każdego tafa, odpowiadasz na jego oczekujące
			wywołania i upewniasz się, że wolno Ci używać aplikacji
			i kont, które łączysz. Raporty, wiadomości i notatki pamięci
			tafa pisze model AI i mogą one być błędne; sprawdź to, co
			ważne, zanim na tym polegasz.
		</p>
		<p>
			<strong>Zatrzymywanie tafa.</strong> Możesz zablokować
			jednego tafa albo wszystkie, wstrzymać tafa, unieważnić
			dowolną z jego Card albo go usunąć. Od chwili, gdy
			zablokujesz tafa lub unieważnisz Card, KIFF nie dopuszcza
			żadnego nowego wywołania tego tafa ani tej Card. Aplikacja
			tafs pokazuje tafa jako zablokowanego dopiero wtedy, gdy
			blokadę potwierdziły i KIFF, i planque; od tej chwili
			planque nie wysyła żadnego z jego wywołań, także takiego,
			które KIFF dopuścił tuż przedtem. Żądanie już wysłane do
			dostawcy aplikacji może się jeszcze wykonać: zatrzymujemy
			nowe wywołania i nie możemy cofnąć tego, co dostawca już
			zrobił. Aplikacja, która sama sprawdza uprawnienia KIFF, bez
			planque, może jeszcze przyjąć uprawnienie wydane przez KIFF
			tuż przedtem, najwyżej przez 90 sekund. Wznowienie
			zablokowanego tafa wymaga Twojego zatwierdzenia na Twoim
			urządzeniu, a nic, co przed blokadą było oczekujące lub
			czekało w kolejce, nie zostanie po niej wykonane.
		</p>
		<p>
			<strong>Usunięcie tafa</strong> zatrzymuje jego harmonogram
			i usuwa jego uruchomienia, czaty, pamięć oraz klucz, którego
			używał. Jeszcze przedtem to, co Twoje aplikacje zwracają
			tafowi, jest przechowywane tylko do końca jego uruchomienia
			(to, co czat jedynie odczytał, w postaci zaszyfrowanej, na
			potrzeby jego kolejnych wiadomości: używane najwyżej przez
			cztery godziny, potem usuwane), a jego uruchomienia i czaty przez 30 dni. KIFF zachowuje potwierdzenia tego, co taf zrobił.
		</p>
		<p>
			<strong>Unijny akt o sztucznej inteligencji (AI Act).</strong>
			W przypadku tafs Kiff Agents OÜ jest dostawcą systemu AI,
			a Ty jesteś podmiotem stosującym ten system. Dbamy o to, aby
			wszystko, co taf pisze do kogoś spoza Twojej firmy,
			informowało, że napisał to agent AI. Używasz tafs wyłącznie
			do zadań, które oferuje, a nie do żadnego zastosowania,
			którego akt o sztucznej inteligencji zakazuje lub które
			klasyfikuje jako zastosowanie wysokiego ryzyka, takiego jak
			decyzje o czyimś zatrudnieniu, kredycie lub dostępie do
			podstawowych usług. Utrzymujesz zatwierdzenia przez
			człowieka, których wymagają Twoje Card, i dbasz o to, aby
			osoby, które używają tafs w Twoim imieniu, rozumiały, co
			robi i jakie ma ograniczenia.
		</p>
		<p>
			<strong>Koszty.</strong> tafs jest częścią Twojego planu
			KIFF (§8): każde uruchomienie tafa zużywa kredyty za AI,
			której użyło. Coach i konfiguracja tafs są wliczone,
			w ramach uczciwego użycia Coacha.
		</p>
	</section>
}

templ termsAccountPL() {
	<section id="account">
		<h2>4. Konta i dostęp</h2>
		<p>
			Aby korzystać z Usługi, musisz założyć konto. Zobowiązujesz
			się podać prawdziwe dane rejestracyjne, zachować swoje dane
			uwierzytelniające w poufności i odpowiadać za wszelką
			aktywność na swoim koncie.
		</p>
		<p>
			Musisz mieć co najmniej 16 lat albo wiek wymagany do
			wyrażenia zgody cyfrowej w Twojej jurysdykcji, zależnie od
			tego, który jest wyższy. Usługa nie jest skierowana do
			dzieci.
		</p>
		<p>
			Usługa jest oferowana tylko w krajach i regionach, w których Anthropic, dostawca jej modelu AI, oferuje własną usługę, zgodnie z <a href="https://www.anthropic.com/supported-countries">listą Anthropic</a>. Nie możesz korzystać z niej z innych miejsc. Firma nie może z niej korzystać, jeśli ma siedzibę w kraju lub regionie spoza tej listy albo jest w większości własnością lub pod kontrolą firmy z siedzibą w takim miejscu, niezależnie od tego, gdzie są jej użytkownicy. Nie możesz z niej korzystać również wtedy, gdy Ty lub firma, dla której z niej korzystasz, podlegacie sankcjom Unii Europejskiej, Organizacji Narodów Zjednoczonych lub Stanów Zjednoczonych. Odmawiamy kont naruszających tę zasadę i możemy zawiesić konto, które ją narusza.
		</p>
		<p>
			Odpowiadasz za działania każdego Użytkownika, którego
			upoważniasz na swoim koncie. Możemy zawiesić konto lub
			cofnąć dostęp z odpowiednim wyprzedzeniem, jeśli wykryjemy
			wiarygodne naruszenie tych warunków. Przy naruszeniach
			Zasad dopuszczalnego użytkowania (zob. §5) zawieszenie może
			być natychmiastowe.
		</p>
	</section>
}

templ termsAcceptableUsePL() {
	<section id="acceptable-use">
		<h2>5. Dopuszczalne użytkowanie</h2>
		<p>
			Ty, Twoi użytkownicy i Twoi agenci musicie przestrzegać
			<a href="/pl/acceptable-use">Zasad dopuszczalnego użytkowania</a>.
			Są one częścią tych warunków i wymieniają, do czego Usługi
			nie wolno używać.
		</p>
		<p>
			Możemy zawiesić dostęp natychmiast przy wiarygodnym
			naruszeniu Zasad dopuszczalnego użytkowania. Nie mamy
			obowiązku monitorować treści Klienta, ale możemy reagować
			na wiarygodne zgłoszenia.
		</p>
	</section>
}

templ termsCustomerDataPL() {
	<section id="customer-data">
		<h2>6. Dane i treści Klienta</h2>
		<p>
			Twoje Dane Audytowe należą do Ciebie. Udzielasz Kiff Agents
			OÜ ograniczonej, niewyłącznej, nieodpłatnej, ogólnoświatowej
			licencji na hostowanie, kopiowanie, przesyłanie,
			wyświetlanie i inne przetwarzanie Twoich Danych Audytowych
			wyłącznie w zakresie niezbędnym do prowadzenia, utrzymywania
			i ulepszania Usługi dla Ciebie.
		</p>
		<p>
			W odniesieniu do Twoich Danych Audytowych i Twoich Danych
			tafs działamy jako <strong>podmiot przetwarzający</strong>
			na podstawie artykułu 28 RODO; tę relację szczegółowo
			reguluje <a href="/pl/legal/dpa">DPA</a>. W odniesieniu do
			metadanych Twojego konta działamy jako
			<strong>administrator</strong>; tę relację reguluje
			<a href="/pl/privacy">polityka prywatności</a>.
		</p>
		<p>
			Oświadczasz, że masz wszelkie prawa niezbędne do
			przekazywania danych, które przekazujesz, i że ich
			przekazywanie jest zgodne z obowiązującym prawem (w tym
			z przepisami o ochronie danych oraz, w stosownych
			przypadkach, z unijnym aktem o sztucznej inteligencji).
		</p>
	</section>
}

templ termsConfidentialityPL() {
	<section id="confidentiality">
		<h2>7. Poufność</h2>
		<p>
			Każda ze stron może otrzymać od drugiej strony informacje
			niepubliczne („Informacje Poufne”). Strona otrzymująca
			będzie wykorzystywać Informacje Poufne wyłącznie w zakresie
			niezbędnym do wykonywania swoich obowiązków i praw
			wynikających z tych warunków oraz będzie je chronić z co
			najmniej taką samą starannością, z jaką chroni własne
			informacje poufne.
		</p>
		<p>
			Informacje Poufne nie obejmują informacji, które (a) są lub
			staną się publicznie dostępne bez naruszenia, (b) były
			znane stronie otrzymującej przed ujawnieniem, (c) zostały
			opracowane niezależnie, bez użycia Informacji Poufnych, lub
			(d) muszą zostać ujawnione na mocy prawa (z zawiadomieniem
			drugiej strony, o ile jest to dozwolone).
		</p>
	</section>
}

templ termsFeesPL() {
	<section id="fees">
		<h2>8. Opłaty i płatności</h2>
		<p>
			<strong>Plany.</strong> Każde konto ma jeden plan. Aktualne
			ceny są na <a href="/pricing">stronie z
			cennikiem</a> (po angielsku); w chwili tej aktualizacji:
		</p>
		<ul>
			<li><strong>Solo:</strong> jedna osoba, dla tafs, sprzedawany w aplikacji tafs przez App Store lub Google Play za 12,50 € miesięcznie, z VAT, z 500 kredytami miesięcznie w cenie.</li>
			<li><strong>Company:</strong> 10,50 € miesięcznie za każde miejsce, z 500 kredytami miesięcznie na każde miejsce, we wspólnej puli, oraz, dla wywołań Twoich własnych agentów przez KIFF Cloud, z 500 akcjami miesięcznie na każde miejsce, we wspólnej puli.</li>
			<li><strong>Umowa:</strong> opłaty i warunki z jej formularza zamówienia.</li>
		</ul>
		<p>
			Miejsca zajmują administratorzy i edytorzy konta.
			Zatwierdzający i przeglądający są bezpłatni w każdym planie.
			W Company, ponad to, co jest w cenie, kredyt kosztuje
			0,01 €, a akcja 0,02 €. Kredyty ponad te w cenie są
			naliczane do miesięcznego limitu wydatków, który ustala
			konto (50 € na początku): po osiągnięciu limitu KIFF nie
			rozpoczyna żadnego nowego uruchomienia tafs konta, dopóki
			nie zacznie się następny okres albo dopóki osoba
			zarządzająca rozliczeniami go nie podniesie.
		</p>
		<p>
			<strong>Pakiety kredytów.</strong> W Solo kredyty ponad te
			w cenie na dany miesiąc pochodzą z pakietów kredytów,
			kupowanych w aplikacji tafs. Pakiet kupuje się raz, nie
			wygasa on i nie jest subskrypcją; jego kredyty są zużywane
			po kredytach w cenie na dany miesiąc, począwszy od
			najstarszego pakietu. Pakiet, za który płatność została
			zwrócona w całości, jest odbierany razem z kredytami, które
			w nim zostały. Gdy kredyty z danego miesiąca i pakiety
			zostaną zużyte, KIFF nie rozpoczyna żadnego nowego
			uruchomienia tafs konta, dopóki nie zacznie się następny
			okres albo nie zostanie dodany pakiet.
			Kredyty bonusowe, które KIFF dodaje do konta, też nie
			wygasają, tak jak pakiety.
		</p>
		<p>
			<strong>Co jest liczone.</strong> <em>Kredyt</em> pokrywa
			AI, której użyło uruchomienie tafa, w pełnych kredytach,
			zaokrąglanych w górę raz na uruchomienie i liczonych raz,
			gdy uruchomienie się kończy. Uruchomienie, którego
			wywołanie KIFF odrzucił, i tak użyło swojej AI. Nigdy nie
			są liczone: Coach i konfiguracja tafs, w ramach uczciwego
			użycia Coacha; próba nowej wersji, która niczego nie
			wysyła; oraz uruchomienie, które nie powiodło się po
			naszej stronie. <em>Akcja</em> to wywołanie Twojego
			własnego agenta przez KIFF Cloud, które coś załatwiło: KIFF
			je dopuścił, zostało wysłane, a narzędzie zgłosiło
			powodzenie. Nigdy nie liczy się jako akcja: wywołanie,
			które zostało odrzucone, było oczekujące, a potem zostało
			odrzucone, zostało zatrzymane przez blokadę, było
			nieprawidłowe, nie powiodło się po stronie narzędzia albo
			którego wynik jest nieznany, oraz wywołanie, które tylko
			odczytuje dane.
		</p>
		<p>
			<strong>Bez okresu próbnego.</strong> Konto płaci od
			pierwszego dnia. Zanim zacznie się plan, KIFF nie rozpoczyna
			żadnego uruchomienia jego tafs, poza konfiguracją prowadzoną
			przez Coacha; nic nie jest usuwane.
		</p>
		<p>
			<strong>Płatności i faktury.</strong> Plan jest rozliczany
			w jednym miejscu. Plan kupiony na kiff.dev kupuje się,
			zmienia i anuluje tam oraz w portalu rozliczeniowym, do
			którego prowadzi ta strona, a jego płatności przetwarza
			Stripe. Solo kupiony w aplikacji tafs jest sprzedawany
			przez App Store na iPhonie i iPadzie albo przez Google Play
			na Androidzie i zarządza się nim w subskrypcjach Apple lub
			subskrypcjach Google Play, na warunkach danego sklepu
			dotyczących płatności, odnawiania i zwrotów. Pakiety
			kredytów kupuje się w aplikacji. Company kupuje się na
			kiff.dev. Opłaty są naliczane miesięcznie z góry;
			wykorzystanie ponad to, co jest w cenie, jest naliczane
			z następną fakturą. Zmiana liczby osób obowiązuje od
			następnej faktury. Jeśli płatność się nie powiedzie i nie
			zostanie uregulowana, plan się kończy, a KIFF odrzuca
			wywołania konta, dopóki nie zostanie wybrany plan.
		</p>
		<p>
			<strong>Anulowanie.</strong> Możesz anulować plan
			w dowolnym momencie w portalu rozliczeniowym albo,
			w przypadku Solo kupionego w aplikacji, w subskrypcjach
			Apple lub subskrypcjach Google Play. Plan działa do końca
			opłaconego okresu i nie jest odnawiany. Z wyjątkiem
			przypadków, w których wymaga tego prawo, opłaty już
			uiszczone nie podlegają zwrotowi. Jeśli jesteś konsumentem
			w UE, możesz odstąpić od umowy w ciągu 14 dni od zakupu bez
			podawania przyczyny, a my zwracamy zapłaconą kwotę
			pomniejszoną o część przypadającą na dni, w których plan
			już działał.
			Zwroty za zakupy Solo realizuje App Store lub Google Play, na ich warunkach.
		</p>
		<p>
			<strong>Mikroprzedsiębiorstwa.</strong> Jeśli Twoja firma zatrudnia mniej niż 10 osób, a jej roczny obrót lub suma bilansowa nie przekracza 2 mln euro, traktujemy ją jak konsumenta we wszystkich zasadach tych warunków dotyczących płatności kartą, także w planie Company.
		</p>
		<p>
			<strong>VAT.</strong> Ceny Company nie zawierają VAT; Solo
			i pakiety kredytów są sprzedawane przez App Store lub
			Google Play z VAT w cenie. Kiff Agents OÜ
			(numer VAT EE102924327) dolicza estoński VAT tam, gdzie ma
			on zastosowanie. Sprzedaż między przedsiębiorcami w UE na
			rzecz Klienta spoza Estonii, który ma ważny numer
			identyfikacyjny VAT, jest fakturowana w unijnym mechanizmie
			odwrotnego obciążenia.
		</p>
		<p>
			<strong>Zmiany.</strong> O podwyżce cen zawiadamiamy
			aktywne konta na piśmie z co najmniej trzydziestodniowym
			wyprzedzeniem (§16). Obniżka cen obowiązuje od następnej
			faktury.
		</p>
	</section>
}

templ termsTermPL() {
	<section id="term">
		<h2>9. Okres obowiązywania i rozwiązanie</h2>
		<p>
			Te warunki zaczynają obowiązywać, gdy po raz pierwszy
			korzystasz z Usługi, i obowiązują do rozwiązania umowy.
		</p>
		<p>
			Możesz rozwiązać umowę w dowolnym momencie, usuwając swoje
			konto. My możemy ją rozwiązać (a) z powodu istotnego
			naruszenia, które nie zostało usunięte w ciągu trzydziestu
			dni od pisemnego zawiadomienia, albo (b) natychmiast
			w przypadku naruszeń Zasad dopuszczalnego użytkowania lub
			zdarzeń niewypłacalności.
		</p>
		<p id="leaving">
			<strong>Odejście i zabranie swoich danych.</strong>
			Możesz wyeksportować swoje dane w dowolnym momencie,
			w ustrukturyzowanym formacie nadającym się do odczytu
			maszynowego: w KIFF Settings → Data (panel jest po angielsku) udostępnia plik JSON
			z Twoim kontem, Twoimi Card ze wszystkimi wersjami,
			decyzjami z Twojego Rejestru (ostatnie 10 000; o więcej
			poproś nas), podpisanym potwierdzeniem każdej z nich, którą
			KIFF dopuścił, oraz szczegółami Twoich kluczy API (nigdy
			samymi kluczami). W aplikacji tafs każda osoba eksportuje własne
			czaty, pliki i notatki przez Konto →  Eksportuj
			moje czaty; czaty są w każdym razie przechowywane przez
			trzydzieści dni, jak mówi polityka prywatności. Usunięcie
			konta natychmiast kończy Usługę, więc najpierw wykonaj
			eksport.
		</p>
		<p>
			Zamiast tego możesz odejść za wypowiedzeniem, aby przejść
			do innego dostawcy lub na własne systemy, pisząc na
			<a href="mailto:support@kiff.dev">support@kiff.dev</a>.
			Nigdy nie wymagamy okresu wypowiedzenia dłuższego niż dwa
			miesiące: Twoje wypowiedzenie staje się skuteczne
			w wybranym przez Ciebie dniu, nie później niż dwa miesiące
			po jego wysłaniu. Od tego dnia biegnie trzydziestodniowy
			okres przejściowy, w którym Usługa nadal działa, Ty
			eksportujesz swoje dane i przenosisz swoją pracę, a my
			pomagamy przy uzasadnionych prośbach z tym związanych.
			Okres przejściowy możesz przedłużyć raz, na tak długo, jak
			potrzebujesz. Jeśli z przyczyn technicznych nie możemy
			zakończyć go w trzydzieści dni, informujemy Cię o tym
			w ciągu czternastu dni roboczych od Twojego wypowiedzenia,
			podając powody i nowy okres, nie dłuższy niż siedem
			miesięcy. Po okresie przejściowym Twoje dane pozostają
			dostępne do eksportu jeszcze przez co najmniej trzydzieści
			dni. Opłaty za plan są naliczane jak zwykle do końca okresu
			przejściowego. Solo kupiony w App Store lub Google Play
			anuluje się w sklepie; okres przejściowy i okres eksportu
			obowiązują tak samo.
		</p>
		<p>
			Nie pobieramy opłat za odejście, zmianę dostawcy ani eksport
			Twoich danych. Ta sekcja przyznaje każdemu klientowi prawa
			do zmiany dostawcy z rozdziału VI unijnego aktu w sprawie
			danych (rozporządzenie (UE) 2023/2854).
		</p>
		<p>
			Po rozwiązaniu umowy oraz po ewentualnym okresie
			przejściowym i okresie eksportu usuwamy Twoje Dane
			Audytowe, Twoje Dane tafs i metadane konta zgodnie
			z zasadami przechowywania opisanymi w
			<a href="/pl/privacy#retention">polityce prywatności</a>.
		</p>
		<p>
			Postanowienia, które ze swej natury powinny obowiązywać po
			rozwiązaniu umowy, pozostają w mocy — w tym postanowienia
			o poufności, własności intelektualnej, zwolnieniu
			z odpowiedzialności, ograniczeniu odpowiedzialności,
			wyłączeniach gwarancji, prawie właściwym i wszelkich
			należnych opłatach.
		</p>
	</section>
}

templ termsWarrantiesPL() {
	<section id="warranties">
		<h2>10. Gwarancje</h2>
		<p>
			Każda ze stron oświadcza, że ma prawo i umocowanie do
			zawarcia i wykonywania tych warunków.
		</p>
		<p>
			Gwarantujemy, że będziemy świadczyć Usługę w sposób
			profesjonalny i zasadniczo zgodny z Dokumentacją. Twoim
			jedynym środkiem ochrony w razie naruszenia tej gwarancji
			jest, według naszego wyboru, ponowne wykonanie świadczenia
			albo proporcjonalny zwrot opłat przypadających na Usługę,
			której dotyczy naruszenie, za okres naruszenia.
		</p>
		<p>
			Gwarantujesz, że Twoje korzystanie z Usługi jest zgodne
			z obowiązującym prawem i tymi warunkami.
		</p>
	</section>
}

templ termsDisclaimerPL() {
	<section id="disclaimer">
		<h2>11. Wyłączenie gwarancji</h2>
		<p>
			Z wyjątkiem wyraźnych gwarancji z §10 Usługa jest
			świadczona <strong>„w stanie, w jakim jest” i „w miarę
			dostępności”</strong>. W najszerszym zakresie dozwolonym
			przez prawo wyłączamy wszelkie inne gwarancje, wyraźne,
			dorozumiane lub ustawowe, w tym gwarancje wartości
			handlowej, przydatności do określonego celu, nienaruszania
			praw oraz wszelkie gwarancje wynikające z dotychczasowej
			współpracy lub zwyczajów handlowych.
		</p>
		<p>
			Nie gwarantujemy, że Usługa będzie działać bez przerw,
			bez błędów ani bez szkodliwych składników ani że żadne dane
			nie zostaną utracone lub uszkodzone. Za tworzenie kopii
			zapasowych swoich danych odpowiadasz Ty.
		</p>
	</section>
}

templ termsLiabilityPL() {
	<section id="liability">
		<h2>12. Ograniczenie odpowiedzialności</h2>
		<p>
			W najszerszym zakresie dozwolonym przez prawo żadna ze
			stron nie będzie odpowiadać wobec drugiej za szkody
			pośrednie, uboczne, następcze, szczególne ani za
			odszkodowania o charakterze przykładowym lub karnym, w tym
			za utracone zyski, utracone przychody, utracone dane lub
			przerwę w działalności, wynikające z tych warunków lub
			Usługi albo z nimi związane, nawet jeśli została
			poinformowana o możliwości wystąpienia takich szkód.
		</p>
		<p>
			Łączna odpowiedzialność każdej ze stron wynikająca z tych
			warunków lub z nimi związana nie przekroczy wyższej
			z kwot: (a) opłat zapłaconych lub należnych od Klienta na
			rzecz Kiff Agents OÜ w ciągu dwunastu miesięcy
			poprzedzających zdarzenie, z którego wynika
			odpowiedzialność, albo (b) stu tysięcy euro
			(100 000 €).
		</p>
		<p>
			Nic w tych warunkach nie ogranicza ani nie wyłącza
			odpowiedzialności, której nie można ograniczyć ani wyłączyć
			na mocy obowiązującego prawa, w tym odpowiedzialności za
			śmierć lub uszkodzenie ciała spowodowane niedbalstwem, za
			oszustwo lub winę umyślną oraz odpowiedzialności za produkt
			wadliwy na podstawie przepisów wdrażających dyrektywę (UE)
			2024/2853 w sprawie odpowiedzialności za produkty wadliwe.
		</p>
	</section>
}

templ termsIndemnityPL() {
	<section id="indemnification">
		<h2>13. Zwolnienie z odpowiedzialności</h2>
		<p>
			Będziemy Cię bronić przed roszczeniami osób trzecich, że
			Usługa, w postaci świadczonej przez nas i używanej przez
			Ciebie zgodnie z tymi warunkami, narusza prawa własności
			intelektualnej tej osoby trzeciej, i zapłacimy
			odszkodowanie prawomocnie zasądzone od Ciebie (lub
			uzgodnioną kwotę ugody) z tytułu takich roszczeń.
		</p>
		<p>
			Będziesz nas bronić przed roszczeniami osób trzecich
			wynikającymi z (a) Twoich danych lub treści Klienta;
			(b) Twojego korzystania z Usługi z naruszeniem tych
			warunków (w tym Zasad dopuszczalnego użytkowania); lub
			(c) Twojego rażącego niedbalstwa lub winy umyślnej,
			i zapłacisz odszkodowanie prawomocnie zasądzone od nas (lub
			uzgodnioną kwotę ugody) z tytułu takich roszczeń.
		</p>
		<p>
			Zwolnienie z odpowiedzialności jest uzależnione od
			niezwłocznego zawiadomienia o roszczeniu, wyłącznej kontroli
			strony zwalniającej nad obroną i ugodą oraz rozsądnej
			współpracy strony zwalnianej. Strona zwalniająca nie może
			bez zgody zawrzeć ugody, która nakłada obowiązki na stronę
			zwalnianą.
		</p>
	</section>
}

templ termsSLAPL() {
	<section id="sla">
		<h2>14. Zobowiązanie dotyczące poziomu usług</h2>
		<p>
			W płatnym planie <a href="/legal/sla">umowa o gwarantowanym
			poziomie usług</a> (po angielsku) określa dostępność, do
			której się zobowiązujemy, sposób liczenia wolnego lub
			nieudanego żądania, nasze czasy reakcji wsparcia oraz
			rekompensaty, gdy nie dotrzymamy zobowiązań. Jest ona
			częścią tych warunków.
		</p>
		<p>
			Praktyki operacyjne, reagowanie na incydenty i zobowiązania
			dotyczące zawiadamiania o naruszeniach są opisane
			w datowanej wersji, do której prowadzą te Warunki
			(<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>);
			strona <a href="/pl/security">/security</a> pokazuje
			aktualne praktyki.
		</p>
	</section>
}

templ termsServiceModsPL() {
	<section id="service-mods">
		<h2>15. Zmiany w Usłudze</h2>
		<p>
			Możemy w dowolnym momencie dodawać, zmieniać lub usuwać
			funkcje. O istotnym ograniczeniu funkcjonalności lub
			wycofaniu części API, które narusza udokumentowane
			zachowanie, zawiadamiamy aktywnych klientów z co najmniej
			trzydziestodniowym wyprzedzeniem, publikując harmonogram
			wycofania. Zmiany podyktowane bezpieczeństwem mogą zostać
			wprowadzone bez zawiadomienia, gdy samo zawiadomienie
			stwarzałoby ryzyko.
		</p>
	</section>
}

templ termsTermsModsPL() {
	<section id="terms-mods">
		<h2>16. Zmiany tych warunków</h2>
		<p>
			Możemy od czasu do czasu zmieniać te warunki. O istotnych
			zmianach zawiadamiamy e-mailem i wyraźnym banerem na tej
			stronie z co najmniej trzydziestodniowym wyprzedzeniem.
			Zmiany nieistotne (doprecyzowania, odesłania) publikujemy
			z nową datą „ostatniej aktualizacji”. Dalsze korzystanie
			z Usługi po dniu wejścia aktualizacji w życie oznacza jej
			akceptację.
		</p>
	</section>
}

templ termsForceMajeurePL() {
	<section id="force-majeure">
		<h2>17. Siła wyższa</h2>
		<p>
			Żadna ze stron nie odpowiada za niewykonanie lub opóźnienie
			w wykonaniu zobowiązań w zakresie, w jakim spowodowały je
			okoliczności pozostające poza jej rozsądną kontrolą, w tym
			zdarzenia losowe, wojna, terroryzm, zamieszki, spory
			pracownicze, pożar, klęska żywiołowa, działania władz
			związane z pandemią, awarie internetu lub zasilania albo
			działania operatorów telekomunikacyjnych lub zewnętrznej
			infrastruktury hostingowej.
		</p>
	</section>
}

templ termsGoverningLawPL() {
	<section id="governing-law">
		<h2>18. Prawo właściwe i sąd</h2>
		<p>
			Te warunki podlegają prawu Republiki Estońskiej,
			z wyłączeniem jej norm kolizyjnych. Sądem wyłącznie
			właściwym do rozstrzygania sporów jest Sąd Rejonowy Harju
			(Harju Maakohus) w Tallinie.
		</p>
		<p>
			Jeśli jesteś konsumentem mieszkającym w innym państwie
			członkowskim UE, bezwzględnie obowiązujące przepisy
			o ochronie konsumentów Twojego państwa nadal mają
			zastosowanie w zakresie, w jakim przyznają Ci prawa,
			których nie możesz zrzec się umownie; to postanowienie nie
			pozbawia Cię ochrony wynikającej z tych przepisów.
		</p>
	</section>
}

templ termsGeneralPL() {
	<section id="general">
		<h2>19. Postanowienia ogólne</h2>
		<p>
			<strong>Całość umowy.</strong> Te warunki, wraz z polityką
			prywatności, DPA, wszelkimi formularzami zamówienia
			i wszelkimi wyraźnie włączonymi warunkami uzupełniającymi,
			stanowią całość umowy między nami w ich przedmiocie
			i zastępują wszelkie wcześniejsze lub równoczesne
			uzgodnienia.
		</p>
		<p>
			<strong>Rozdzielność postanowień.</strong> Jeśli któreś
			postanowienie zostanie uznane za niewykonalne, pozostałe
			pozostają w mocy.
		</p>
		<p>
			<strong>Cesja.</strong> Nie możesz przenieść tych warunków
			bez naszej pisemnej zgody. My możemy je przenieść bez zgody
			w związku z fuzją, przejęciem lub sprzedażą całości albo
			zasadniczo całości naszych aktywów, za zawiadomieniem
			Ciebie.
		</p>
		<p>
			<strong>Brak zrzeczenia się praw.</strong> Niewyegzekwowanie
			któregoś postanowienia nie oznacza zrzeczenia się prawa do
			jego późniejszego egzekwowania.
		</p>
		<p>
			<strong>Zawiadomienia.</strong> Zawiadomienia do Kiff
			Agents OÜ kieruje się na adres
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>
			lub pocztą na adres Tööstuse tn 75-71, Põhja-Tallinna
			linnaosa, Tallinn 10416, Estonia. Zawiadomienia do Ciebie
			kierujemy na adres e-mail powiązany z Twoim kontem albo,
			jeśli został podany, na wskazany przez Ciebie adres do
			zawiadomień prawnych.
		</p>
		<p>
			<strong>Niezależni kontrahenci.</strong> Nic w tych
			warunkach nie tworzy spółki, stosunku agencji, wspólnego
			przedsięwzięcia ani stosunku pracy.
		</p>
		<p>
			<strong>Osoby trzecie jako beneficjenci.</strong> Nie ma
			takich osób, z wyjątkiem zakresu, w jakim wyraźnie wskazano
			podmioty powiązane objęte zwolnieniem z odpowiedzialności.
		</p>
	</section>
}

