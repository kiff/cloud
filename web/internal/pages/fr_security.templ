package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// SecurityFR is the security posture page (/security) in French, at
// /fr/security. It is a translation of Security: the same sections,
// anchors, links and figures, held to it by
// TestTranslationsKeepTheEnglishPage. The English page governs. Change
// the English page first, then this one.
templ SecurityFR() {
	@components.LayoutSiteWithMeta("KIFF — sécurité et posture", "Ce que KIFF Cloud signe, conserve, et ce dont il répond : ce qu'il fait appliquer, les pratiques opérationnelles actuelles, les sous-traitants ultérieurs, la réponse aux incidents, les données qu'il traite, et ce qu'il n'a pas encore.", "website", "", "css/security.css") {
		@SecurityBodyFR()
	}
}

// SecurityBodyFR is the page's content without the site layout, as
// SecurityBody is for the English page.
templ SecurityBodyFR() {
	<article class="security">
		<header class="security-head">
			<h1>Ce que KIFF Cloud signe, conserve, et ce dont il répond.</h1>
			<p class="security-lede">Si une affirmation faite ici ne peut pas être vérifiée par un tiers, nous la présentons comme un point de la feuille de route, pas comme une garantie.</p>
		</header>
		<section class="security-section security-trust" id="trust">
			<h2>La confiance en un coup d'œil</h2>
			<table class="security-table security-trust-table">
				<thead>
					<tr>
						<th>Référentiel / domaine</th>
						<th>Statut</th>
						<th>Détail</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Droits des personnes concernées (RGPD)</td>
						<td><span class="security-pill security-pill-ok">en place</span></td>
						<td>Accès, export et effacement pris en charge (<a href="#deletion">suppression</a>) ; <a href="/fr/legal/dpa">DPA</a> disponible.</td>
					</tr>
					<tr>
						<td>PCI DSS</td>
						<td><span class="security-pill security-pill-na">hors périmètre</span></td>
						<td>KIFF ne détient jamais de données de titulaires de carte, le paiement passe par la page hébergée de Stripe, donc le périmètre PCI relève du prestataire de paiement.</td>
					</tr>
					<tr>
						<td>HIPAA</td>
						<td><span class="security-pill security-pill-na">hors périmètre aujourd'hui</span></td>
						<td>Aucune PHI traitée par défaut.</td>
					</tr>
					<tr>
						<td>Isolation des locataires</td>
						<td><span class="security-pill security-pill-ok">en place</span></td>
						<td>Un schéma Postgres par locataire ; les requêtes entre locataires sont <a href="#artifacts">impossibles par architecture</a> depuis le chemin d'exécution.</td>
					</tr>
					<tr>
						<td>Chiffrement</td>
						<td><span class="security-pill security-pill-ok">en place</span></td>
						<td>TLS 1.2+ en transit ; chiffrement au repos. Les clés client par ligne sont sur la <a href="#roadmap">feuille de route</a>.</td>
					</tr>
					<tr>
						<td>Preuves d'audit pour vos revues</td>
						<td><span class="security-pill security-pill-ok">en place</span></td>
						<td>Chaque décision est un reçu signé, en ajout seul, dont toute altération est détectable, conçu pour être la pièce que demande <em>votre</em> audit SOC 2 ou sectoriel.</td>
					</tr>
				</tbody>
			</table>
			<h3>Ce que nous pouvons remettre aujourd'hui à la personne qui évalue notre sécurité</h3>
			<ul class="security-handover">
				<li><a href="/fr/legal/dpa">Accord de traitement des données (DPA)</a>, signé avant toute utilisation en production.</li>
				<li>Un questionnaire de sécurité rempli et le statut SOC 2 actuel, sur demande, <a href="mailto:security@kiff.dev">security@kiff.dev</a>.</li>
			</ul>
		</section>
		<section class="security-section" id="posture">
			<h2>Posture</h2>
			<p>La garde des clés de signature par locataire, où chaque locataire a sa propre clé dédiée avec laquelle le cloud signe, avec une voie de migration facultative pour remettre la clé au locataire lui-même, est sur la feuille de route ci-dessous, pas en place aujourd'hui. D'ici là, le cloud est le tiers nommé derrière chaque enregistrement signé.</p>
		</section>
		<section class="security-section" id="enforcement">
			<h2>Ce que KIFF fait appliquer</h2>
			<p class="section-lede">En clair : KIFF renvoie une <strong>décision</strong> ; c'est votre intégration qui exécute l'effet réel (l'action elle-même). KIFF est la barrière, pas l'exécutant.</p>
			<p>L'application des décisions est un réglage que vous contrôlez, par espace de travail, et elle est stricte par défaut. Le mode observe est facultatif et réglé par nous à votre demande, jamais par l'agent et jamais par défaut, un espace de travail n'est jamais en mode observe par accident.</p>
			<h3>KIFF n'arrête pas</h3>
			<ul class="security-levels">
				<li>Un effet de bord atteint par un <strong>chemin de code non gouverné</strong>: par exemple, appeler directement l'API de paiement en contournant la barrière.</li>
				<li>Un intégrateur qui reçoit une décision en mode enforce et <strong>l'ignore</strong>, ou un espace de travail réglé délibérément sur <strong>observe</strong> (consultatif par choix, toujours enregistré, jamais accidentel), une application coopérative, comme avec tout moteur de politiques.</li>
				<li>Une demande qui <strong>n'atteint jamais</strong> la barrière.</li>
			</ul>
			<h3>Rendre la barrière plus difficile à contourner</h3>
			<ul class="security-levels">
				<li>Observe — consultatif uniquement, en place</li>
				<li>Le guard au point de passage, en place</li>
				<li>Proxy en ligne, prévu</li>
				<li>Barrière d'outil, prévu</li>
			</ul>
		</section>
		<section class="security-section" id="artifacts">
			<details class="security-more">
			<summary><h2>Pratiques opérationnelles actuelles</h2></summary>
			<dl class="security-grid">
				<div class="security-row">
					<dt>Garde du portefeuille de signature</dt>
					<dd>Le portefeuille qui signe les reçus et soumet les engagements sur la chaîne publique est détenu dans notre infrastructure, sous des contrôles d'accès séparés des ingénieurs applicatifs. Le code applicatif signe par une interface de service ; il ne peut pas extraire la clé.</dd>
				</div>
				<div class="security-row">
					<dt>Localisation des données</dt>
					<dd><code>eu-west-1</code> (Irlande) : KIFF Cloud, le service tafs et planque, avec leurs bases de données, leurs sauvegardes, leurs secrets et leurs journaux.</dd>
				</div>
				<div class="security-row">
					<dt>Journaux</dt>
					<dd>Durée de conservation des journaux : les journaux d'accès du serveur web, qui contiennent des adresses IP, 90 jours ; le journal de service de KIFF, 30 jours ; les journaux de supervision de KIFF, 7 jours ; les journaux du service tafs et de planque, 30 jours.</dd>
				</div>
			</dl>
			</details>
		</section>
		<section class="security-section" id="subprocessors">
			<h2>Sous-traitants ultérieurs</h2>
			<p class="section-lede">Les prestataires qui traitent des données des locataires pour notre compte. La liste officielle, avec les données que chacun touche, se trouve sur <a href="/fr/subprocessors">/subprocessors</a>. Nous la mettons à jour dans les 30 jours suivant toute modification.</p>
			<p>Amazon Web Services · Clerk · Anthropic · Apple · Resend · Composio · Stripe</p>
		</section>
		<section class="security-section" id="incident">
			<h2>Réponse aux incidents</h2>
			<p>Signalez un problème de sécurité présumé à <a href="mailto:security@kiff.dev">security@kiff.dev</a>. Nous visons à en accuser réception sous un jour ouvré, puis à donner une première évaluation sous cinq jours ouvrés.</p>
			<p>Les incidents qui touchent des données de locataires déclenchent une notification écrite aux clients concernés dans les 72 heures suivant leur confirmation, puis un rapport public après incident une fois la réponse immédiate terminée.</p>
			<h3 id="updates">Mises à jour de sécurité</h3>
			<p>Nous fournissons des mises à jour de sécurité aussi longtemps que nous proposons le Service.</p>
		</section>
		<section class="security-section" id="data-we-process">
			<details class="security-more">
			<summary><h2>Les données que nous traitons</h2></summary>
			<h3 id="identifiers">Les identifiants que nous conservons tels quels</h3>
			<p>L'identifiant du locataire, de l'acteur et de l'entité, le nom de l'action, le libellé de la décision, les horodatages de la requête et de la réponse, les empreintes des reçus, et les empreintes des transactions de la piste publique qui fixent ces reçus.</p>
			<h3 id="parameters">Les champs contrôlés par le locataire que nous conservons</h3>
			<p>De l'objet <code>parameters</code> d'une proposition, seuls les paramètres numériques (montants, quantités) sont conservés, parce que les limites les comptent. La requête complète est conservée sous forme d'empreinte, pour qu'une nouvelle tentative puisse être distinguée d'une requête différente. Par la passerelle KIFF, aussi la valeur de l'argument sur lequel un appel agit (comme un identifiant de paiement), pour que le registre du propriétaire et le reçu puissent montrer de laquelle il s'agit à quelqu'un qui la détient.</p>
			<h3 id="never-persisted">Les identifiants que nous ne conservons jamais</h3>
			<p>Les prompts bruts envoyés aux modèles et leurs réponses. Le cloud transmet le trafic d'inférence au fournisseur de modèle configuré et n'en garde aucune copie.</p>
			<p>Pour chaque appel qu'un taf fait via KIFF, tafs conserve la référence de KIFF pour l'appel et l'identifiant de ce sur quoi il a agi (par exemple un identifiant de paiement, jamais les données du client) pendant 30 jours, pour l'afficher dans le Registre du taf ; le reste des données d'entrée d'un appel n'est conservé que jusqu'à la fin de l'exécution. L'<a href="/fr/legal/dpa#annex-4">annexe 4 du DPA</a> énumère ce que tafs conserve et pour combien de temps.</p>
			<h3 id="public-trail">Les données que nous ne publions jamais sur la piste vérifiable</h3>
			<p>La synthèse engage les enregistrements sous-jacents sans les révéler ; les enregistrements eux-mêmes ne quittent jamais la base de données du cloud.</p>
			<h3 id="deletion">Les données que nous supprimons à la suppression d'un locataire</h3>
			<p>Une demande de suppression d'un locataire efface son schéma Postgres, ses enregistrements d'audit, ses clés d'API et ses références de clés de signature.</p>
			<h3 id="people-data">Les données sur les personnes qui se connectent</h3>
			<p>Quand un utilisateur se connecte, le cloud stocke l'identifiant d'authentification fourni en amont et l'adresse e-mail utilisée pour se connecter.</p>
			<h3 id="terminology">Pseudonymisé, pas anonymisé</h3>
			<p>KIFF Cloud <em>pseudonymise</em> les identifiants des locataires : les identifiants directs sont remplacés par des jetons opaques stables, mais les données concernent toujours une personne et les règles européennes de protection des données continuent de s'appliquer.</p>
			<h3 id="not-today">Ce que nous ne faisons pas aujourd'hui</h3>
			<ul class="security-roadmap-list">
				<li>Pas de masquage automatique du texte libre <code>reasoning_summary</code> de l'agent : il est conservé tel qu'il a été écrit, pour que l'approbateur et l'audit voient le récit de l'agent lui-même. N'y mettez pas de données personnelles.</li>
				<li>Pas de hachage automatique des adresses e-mail dans la table des métadonnées d'authentification. Prévu.</li>
			</ul>
			</details>
		</section>
		<section class="security-section security-roadmap" id="roadmap">
			<h2>Ce que nous n'avons pas encore</h2>
			<ul class="security-roadmap-list">
				<li><strong>SOC 2 Type I</strong>: prévu, pas commencé.</li>
				<li><strong>ISO 42001 (management de l'IA) ou ISO 27001</strong>: à l'étude.</li>
				<li><strong>Partenariat de cyberassurance</strong>: un assureur nommé évalue notre format de preuve d'action attestée.</li>
				<li><strong>Garde des clés de signature par locataire</strong>: chaque locataire reçoit son propre portefeuille dédié, avec une voie de migration définie pour en prendre lui-même la garde.</li>
				<li><strong>Signature adossée à KMS</strong>: placer le portefeuille de signature derrière AWS KMS, pour que la clé privée ne puisse pas être extraite du plan applicatif.</li>
				<li><strong>Suppression d'un locataire en libre-service</strong>: un outil en ligne de commande <code>kiff-tenant delete</code> et un écran du tableau de bord. Aujourd'hui, la suppression est faite par un opérateur, sur demande par e-mail à <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>, et suit notre runbook interne dans le délai d'un mois de l'article 12, paragraphe 3, du RGPD.</li>
				<li><strong>Application des durées de conservation d'audit</strong>: Aujourd'hui, la conservation est assurée au mieux et n'est pas différenciée par niveau.</li>
				<li><strong>Chiffrement par ligne avec des clés client (BYOK)</strong>: en attente d'une vraie demande de client.</li>
			</ul>
		</section>
	</article>
}
