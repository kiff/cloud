package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// PrivacyHI is KIFF's privacy policy (/privacy) in Hindi, at /hi/privacy.
// It is a translation of Privacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Hindi has the legal
// texts only, so a link to any other page goes to English and says so.
templ PrivacyHI() {
	@components.LayoutSite("KIFF — privacy policy", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@privacyHeadHI()
			@privacyWhoWeAreHI()
			@privacyScopeHI()
			@privacyRolesHI()
			@privacyCategoriesHI()
			@privacyLawfulBasesHI()
			@privacySubprocessorsHI()
			@privacyTransfersHI()
			@privacyRetentionHI()
			@privacyRightsHI()
			@privacyCookiesHI()
			@privacySecurityHI()
			@privacyChildrenHI()
			@privacyAutomatedHI()
			@privacyChangesHI()
			@privacyContactHI()
		</article>
	}
}

templ privacyHeadHI() {
	<header class="legal-head">
		<p class="legal-badge">गोपनीयता नीति · v0.1</p>
		<h1>गोपनीयता नीति</h1>
		<p class="legal-meta">
			<strong>अंतिम अपडेट:</strong> 24 नवंबर 2026।
			<strong>प्रभावी तिथि:</strong> 24 मई 2026।
		</p>
		<p class="legal-disclaimer">
			यह नीति बताती है कि KIFF Cloud वेबसाइट, डैशबोर्ड, API और iPhone, iPad, Android और कंप्यूटर के लिए tafs ऐप में व्यक्तिगत डेटा को कैसे प्रोसेस करता है। प्रश्न:
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>।
		</p>
	</header>
}

templ privacyWhoWeAreHI() {
	<section id="who-we-are">
		<h2>1. हम कौन हैं</h2>
		<p>
			KIFF Cloud का संचालन <strong>Kiff Agents OÜ</strong> करती है, जो एस्टोनिया में पंजीकृत एक निजी सीमित देयता कंपनी है। पंजीकरण की जानकारी:
		</p>
		<ul>
			<li><strong>पंजीकरण कोड:</strong> 17372313 (एस्टोनियाई e-Business Register)</li>
			<li><strong>VAT संख्या:</strong> EE102924327</li>
			<li><strong>पंजीकृत पता:</strong> Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, एस्टोनिया</li>
			<li><strong>गोपनीयता संपर्क:</strong> <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a></li>
			<li><strong>औपचारिक कानूनी सूचनाएँ:</strong> <a href="mailto:legal@kiff.dev">legal@kiff.dev</a></li>
		</ul>
		<p>
			क्योंकि Kiff Agents OÜ यूरोपीय संघ में स्थापित है, यूरोपीय संघ का सामान्य डेटा संरक्षण विनियमन
			(<abbr title="सामान्य डेटा संरक्षण विनियमन">GDPR</abbr>)
			हमारी प्रोसेसिंग पर सीधे लागू होता है। हमें अनुच्छेद 27 के EU प्रतिनिधि की आवश्यकता नहीं है।
		</p>
	</section>
}

templ privacyScopeHI() {
	<section id="scope">
		<h2>2. इस नीति का दायरा</h2>
		<p>
			यह नीति उस व्यक्तिगत डेटा को कवर करती है जिसे हम तब प्रोसेस करते हैं जब आप इनके साथ संवाद करते हैं:
		</p>
		<ul>
			<li><a href="https://kiff.dev"><code>kiff.dev</code></a> — हमारी मार्केटिंग साइट, यह नीति पृष्ठ और सार्वजनिक रसीद दिखाने वाला पृष्ठ।</li>
			<li><a href="https://app.kiff.dev"><code>app.kiff.dev</code></a> — हमारा प्रमाणीकृत डैशबोर्ड।</li>
			<li><a href="https://api.kiff.dev"><code>api.kiff.dev</code></a> — हमारी HTTP API।</li>
			<li id="tafs"><strong>tafs</strong> — iPhone, iPad, Android और कंप्यूटर (Mac, Windows और Linux) के लिए हमारा ऐप और उसके पीछे की सेवा (जिसमें कंपनी के टूल जोड़ने वाला Setup और उन कनेक्शनों को रखने वाला planque शामिल हैं), जिसमें कंपनी KIFF Card के भीतर काम करने वाले AI एजेंट को काम सौंपती है।</li>
		</ul>
		<p>
			यह नीति ओपन-सोर्स <code>kiff/kiff</code> फ्रेमवर्क को कवर <em>नहीं</em> करती, जिसे आप खुद चला सकते हैं।
			जब आप फ्रेमवर्क अपने बुनियादी ढाँचे पर चलाते हैं, तो वह जो भी डेटा प्रोसेस करता है उसके नियंत्रक आप हैं, और
			Kiff Agents OÜ उस प्रोसेसिंग में शामिल नहीं है।
		</p>
	</section>
}

templ privacyRolesHI() {
	<section id="roles">
		<h2>3. GDPR के तहत हमारी भूमिकाएँ</h2>
		<p>
			हम डेटा के अनुसार दो हैसियतों में काम करते हैं:
		</p>
		<ul>
			<li>
				<strong>नियंत्रक</strong> खाते और साइन-इन मेटाडेटा, बिलिंग डेटा (बिलिंग सक्रिय होने पर), आपके चुने गए मार्केटिंग संचार, और हमारी अपनी सेवा की परिचालन टेलीमेट्री के लिए।
			</li>
			<li>
				<strong>प्रोसेसर</strong> ऑडिट डेटा, कार्रवाई रिकॉर्ड, निर्णय रसीदों और उस अन्य सामग्री के लिए जो हमारे ग्राहकों की ओर से रनटाइम से गुज़रती है, और tafs उनके लिए जो रखता है उसके लिए (हर taf की रन, चैट, रिपोर्ट, मेमोरी नोट और उनकी सौंपी फ़ाइलें)।
				ग्राहक (टेनेंट) उस डेटा के नियंत्रक हैं;
				वे अपनी खाता सेटिंग और डोमेन कॉन्फ़िगरेशन के ज़रिए हमें निर्देश देते हैं। डेटा प्रोसेसिंग अनुबंध
				(<abbr title="डेटा प्रोसेसिंग अनुबंध">DPA</abbr>)
				उस संबंध को नियंत्रित करता है; प्रकाशित शर्तों के लिए
				<a href="/legal/dpa">DPA टेम्पलेट</a>
				देखें।
			</li>
		</ul>
		<p>
			यह नीति मुख्यतः हमारी नियंत्रक-पक्ष की प्रोसेसिंग को संबोधित करती है। जहाँ हम प्रोसेसर-पक्ष के डेटा का उल्लेख करते हैं, वहाँ DPA अधिक विशिष्ट दस्तावेज़ है।
		</p>
	</section>
}

templ privacyCategoriesHI() {
	<section id="categories">
		<h2>4. हम किन श्रेणियों का व्यक्तिगत डेटा प्रोसेस करते हैं</h2>
		<p>
			नीचे की श्रेणियाँ
			<a href="/security#data-we-process">/security#data-we-process</a>
			पर दी तकनीकी सूची के अनुरूप हैं।
			जहाँ दोनों में अंतर हो, तकनीकी पृष्ठ ही सत्य का स्रोत है और हम इस खंड को उसके अनुसार अपडेट करते हैं।
		</p>
		<ul>
			<li>
				<strong>खाता पहचानकर्ता</strong> — हमारे पहचान प्रदाता द्वारा जारी आपका अपस्ट्रीम प्रमाणीकरण विषय और वह ईमेल पता जिससे आप साइन इन करते हैं।
				आज यह जस का तस रखा जाता है; हैश करके रखना नियोजित है।
				यदि आप ईमेल से भेजे कोड से साइन-इन चालू करते हैं (आप न करें तो वह बंद रहता है), तो KIFF वह सेटिंग आपकी साइन-इन id और उसे बदलने की तारीख के साथ रखता है। हम आपको जो कोड ईमेल करते हैं वह केवल कुंजीबद्ध हैश के रूप में, उपयोग होने तक या दस मिनट बीतने तक रखा जाता है। दुरुपयोग रोकने के लिए, हम अनुरोध करने वाले पते के कुंजीबद्ध हैश और IP पते के हिसाब से अनुरोधों की गिनती एक दिन तक रखते हैं। कोड से साइन इन करने के बाद, हम उसे एक चौथाई घंटे तक नोट करते हैं, ताकि हाल के साइन-इन की ज़रूरत वाले बदलाव आपसे किसी और तरीके से साइन इन करने को कहें।
			</li>
			<li>
				<strong>टेनेंट मेटाडेटा</strong> — टेनेंट id, स्लग, प्रदर्शन नाम, निर्माण का समय-चिह्न, और हर व्यक्ति के ऐप की आखिरी भाषा, ताकि KIFF जो ईमेल उन्हें भेजता है वे उसी में आएँ।
			</li>
			<li>
				<strong>API क्रेडेंशियल</strong> — अस्पष्ट API key रिकॉर्ड
				(हम हैश रखते हैं, सादा पाठ कभी नहीं)।
			</li>
			<li>
				<strong>सत्र कुकी डेटा</strong> — साइन-इन के बाद लगाई गई HMAC-हस्ताक्षरित सत्र कुकी। नीचे कुकी खंड देखें।
			</li>
			<li>
				<strong>HTTP अनुरोध मेटाडेटा</strong> — IP पता, यूज़र एजेंट, अनुरोध का पथ, प्रतिक्रिया की स्थिति, विलंब।
				सुरक्षा और दुरुपयोग रोकने के लिए सीमित प्रतिधारण अवधि तक हमारे रिवर्स प्रॉक्सी के एक्सेस लॉग में रखा जाता है।
			</li>
			<li>
				<strong>टेनेंट-नियंत्रित सामग्री</strong> —
				वह <code>parameters</code>, <code>actor</code> और
				<code>entity</code> डेटा जो आप रनटाइम को भेजते हैं।
				हम इसे ग्राहक की ओर से <em>प्रोसेसर के रूप में</em> रखते हैं;
				तार पर क्या पहुँचता है, इसकी ज़िम्मेदारी ग्राहक की है। प्रति-डोमेन रिडैक्शन कॉन्फ़िगरेशन नियोजित है।
			</li>
			<li>
				<strong>संचार</strong> — आप हमारे सपोर्ट, सेल्स, सुरक्षा या गोपनीयता मेलबॉक्स को जो ईमेल भेजते हैं।
			</li>
			<li>
				<strong>tafs ऐप</strong> — आप tafs में अपने KIFF खाते से साइन इन करते हैं। फ़ोन या टैबलेट पर ऐप आपका सत्र डिवाइस की Keychain में (Android पर उसके एन्क्रिप्टेड स्टोरेज में) रखता है। कंप्यूटर पर वह उसे आपके उपयोगकर्ता खाते के लिए सील करके रखता है: Windows PC पर Windows की अपनी डेटा सुरक्षा से, Linux पर आपकी कीरिंग में, Mac पर उसकी Keychain में। कंप्यूटर का सत्र 90 दिनों तक चलता है।
				ऐप एक साइनिंग कुंजी बनाता है जो डिवाइस से कभी बाहर नहीं जाती:
				iPhone, iPad या Mac के Secure Enclave में, Android डिवाइस के
				Keystore में, या Windows PC के TPM में। Linux पर, और Secure Enclave के बिना Mac पर,
				कुंजी एक सॉफ़्टवेयर कुंजी है जो आपकी कीरिंग या Keychain में रहती है,
				और वह कंप्यूटर आपके लिए क्या इंतज़ार कर रहा है यह दिखा सकता है पर उसे मंज़ूर नहीं कर सकता; आप अपने फ़ोन पर मंज़ूर करते हैं{ macSecurityKey("hi") }। TPM के बिना Windows PC
				tafs में साइन इन नहीं कर सकता। KIFF कुंजी का सार्वजनिक आधा हिस्सा, डिवाइस का
				नाम और प्लेटफ़ॉर्म, और यह कि वह कब जोड़ा गया और आखिरी बार कब उपयोग हुआ, रखता है,
				ताकि रोकी गई कॉल पर आपके उत्तर और कनेक्शनों की आपकी मंज़ूरियाँ जाँच सके। यदि आप अपने कंप्यूटर पर passkey से मंज़ूर करते हैं, जैसे Windows Hello या सुरक्षा
				कुंजी, तो आपका चेहरा,
				फ़िंगरप्रिंट या PIN कंप्यूटर के अपने सिस्टम में रहता है;
				KIFF passkey की सार्वजनिक कुंजी, उसकी id, एक काउंटर
				और एक नाम रखता है, कभी कुछ गोपनीय नहीं, और दूसरे डिवाइस पर सिंक होने वाली passkey को अस्वीकार करता है। यदि आप फ़ोन, टैबलेट या iPad ऐप चलाने वाले Mac पर अलर्ट चालू करते हैं, तो हम डिवाइस का push टोकन
				आपकी KIFF व्यक्ति id के साथ, और ऐप ने जो भाषा दिखाई वह रखते हैं, ताकि
				उसके अलर्ट उसी में आएँ। tafs सेवा खाते की भाषा भी, जिसने आखिरी बार Coach से चैट की उसकी, तीन महीने तक रखती है, ताकि taf की रिपोर्ट उसी में आएँ।
				फ़ोन का अलर्ट Apple या Google से होकर केवल यह बताकर जाता है कि कौन सा taf और वह क्या चाहता है,
				और किसी द्वार के अलर्ट में लिखने वाले का नाम या ईमेल पता: कभी कोई
				रकम या अनुरोध का विवरण नहीं। ऐप ये बातें डिवाइस पर
				ही, KIFF से, जोड़ता है, इसलिए अनलॉक फ़ोन का अलर्ट रकम, व्यापारी या व्यक्ति दिखा सकता है। लॉक
				Android फ़ोन पर वह केवल "किसी taf को आपकी ज़रूरत है" दिखाता है, और लॉक iPhone पर भी, जब तक आपने उसके पूर्वावलोकन
				हमेशा दिखाने पर न रखे हों। <strong>आपकी घड़ी:</strong> घड़ी में कोई पासवर्ड या कुंजी नहीं होती, वह केवल आपके जोड़े गए फ़ोन से बात करती है, और कभी मंज़ूर नहीं करती। आप Coach या अपने चुने taf से जो कहते हैं, वह AI की अनुमति देने के बाद, फ़ोन के ज़रिए, केवल टेक्स्ट के रूप में भेजती है। घड़ी की अपनी बोली सेवा, Apple की या Google की, आपके शब्दों को उस टेक्स्ट में बदलती है। Wear OS पर, यदि आपके पूरा करने से पहले वह रुक जाए, तो आपके फ़ोन की अपनी पहचान सेवा यह काम फ़ोन पर ही करती है। वह अस्वीकार करने, रोकने या Coach या taf को भेजने का काम केवल तब कर सकती है जब उसमें स्क्रीन लॉक या पासकोड हो और वह अनलॉक हो। आप taf को जो भेजते हैं वह उस taf की अपनी चैट में जाता है, मानो आपने उसे अपने फ़ोन पर लिखा हो। किसी taf की चैट, रकम सहित, हर बार खुलने पर फ़ोन के ज़रिए पढ़ी जाती है, और घड़ी केवल वे हाल के संदेश रखती है जिनका वर्णन नीचे उसके अपने हिस्से में है। <strong>Apple Watch:</strong> वह आपके tafs और उनके पृष्ठ बिना रखे दिखाती है। वह आपका Inbox रखती है, एक ऐसी फ़ाइल में जिसे लॉक रहते वह पढ़ नहीं सकती: हर रोकी गई कॉल taf के नाम और वह क्या माँगता है के रूप में, कभी कोई रकम नहीं, और घड़ी से आपके भेजे पर Coach के उत्तर, टेक्स्ट के रूप में। यदि आप घड़ी पर साइन आउट करते हैं, तो वह यह भी रखती है कि आपने किया, जब तक आप घड़ी पर फिर साइन इन न करें। इसके अलावा, घड़ी में पासकोड न हो तो वह कुछ नहीं रखती। Inbox तब चला जाता है जब आप घड़ी पर साइन आउट करते हैं या आपका iPhone साइन आउट होता है, या ऐप अगली बार बिना पासकोड के खुलता या बंद होता है। वह कोई रिकॉर्डिंग नहीं करती, और वह जो सूचनाएँ दिखाती है वे केवल आपके iPhone की होती हैं। ताकि बातचीत तुरंत खुले, वह उस पर खोली गई अधिकतम 20 बातचीतों में से हर एक के आख़िरी 30 संदेश भी रखती है, Coach के और आपके tafs के, केवल पाठ के रूप में और कभी कोई रकम नहीं, Inbox की तरह लॉक; वे Inbox के साथ हट जाते हैं, और तब जब कोई बातचीत 30 दिन तक नहीं खोली गई हो। <strong>Wear OS:</strong> वह आपके खाते का ईमेल और आज का कैलेंडर बिना रखे दिखाती है। तुरंत खुलने के लिए वह एन्क्रिप्टेड रूप में आपके लिए इंतज़ार करने वाली चीज़ों की गिनती, और हर taf का नाम और वह रुका या थमा हुआ है या नहीं रखती: कभी कोई रकम, रोकी गई कॉल का विवरण या taf की चैट नहीं। यह तब साफ़ हो जाता है जब आप साइन आउट करते हैं, जब घड़ी लॉक होती है या कलाई से उतरती है, और 24 घंटे बाद। वह आपका Inbox रखती है, जिसमें हर पंक्ति taf का नाम और वह जो कहता है है, कभी कोई रकम नहीं, और बाद के लिए रखा एक संदेश, टेक्स्ट के रूप में। घड़ी या फ़ोन पर साइन आउट करने से यह सब साफ़ हो जाता है। अपनी टाइल के लिए वह आपके लिए इंतज़ार करने वाली चीज़ों की गिनती भी रखती है, जो केवल घड़ी के अनलॉक रहते दिखती है, और जब आप साइन आउट करते हैं, या अगली बार टाइल घड़ी के लॉक या बिना स्क्रीन लॉक के रहते दिखती है, तब साफ़ हो जाती है। घड़ी पर साइन आउट के बाद वह इसका नोट रखती है कि आपने किया, जब तक आप फिर साइन इन न करें। Inbox भी तब चला जाता है जब ऐप अगली बार घड़ी के लॉक या बिना स्क्रीन लॉक के रहते खुलता या बंद होता है। बाद के लिए रखा संदेश तब तक रहता है जब तक आप उसे भेजें या हटाएँ, क्योंकि आपने उसे भेजने को कहा था। यदि घड़ी की बोली सेवा आपके पूरा करने से पहले रुक जाए, तो घड़ी रिकॉर्डिंग आपके फ़ोन को भेजती है, जो उसे फ़ोन पर ही टेक्स्ट में बदलता है, कभी किसी सर्वर पर नहीं। टेक्स्ट वापस आने या आपके रद्द करने पर, और अधिकतम 2 मिनट बाद, रिकॉर्डिंग दोनों जगह मिटा दी जाती है। केवल टेक्स्ट आगे Coach या आपके taf तक जाता है। taf का नतीजा घड़ी की सूचनाओं में तब तक रह सकता है जब तक आप उसे खारिज न करें या घड़ी पर साइन आउट न करें। ताकि बातचीत तुरंत खुले, वह उस पर खोली गई अधिकतम 20 बातचीतों में से हर एक के आख़िरी 30 संदेश भी रखती है, Coach के और आपके tafs के, केवल पाठ के रूप में और कभी कोई रकम नहीं, एन्क्रिप्ट करके; आप घड़ी या फ़ोन पर साइन आउट करें तो, और कोई बातचीत 30 दिन तक न खोली जाए तो, वे हट जाते हैं, और बिना स्क्रीन लॉक वाली घड़ी इनमें से कुछ नहीं रखती। Windows PC,
				Linux कंप्यूटर या macOS 12 ऐप वाले Mac पर अलर्ट ऐप खुद चलते हुए बनाता है,
				बिना push टोकन के और किसी और कंपनी के ज़रिए नहीं। Windows और Linux पर
				वे दिखाते हैं कि कौन सा taf, वह क्या करना चाहता है, रकम, क्यों
				और कब तक; macOS 12 ऐप पर, आपके उन्हें चालू करने के बाद, वे कॉल के लिए KIFF के शब्द दिखाते हैं,
				और लॉक स्क्रीन वह दिखाती है जो Mac की पूर्वावलोकन सेटिंग अनुमति देती है। Windows पर
				वे आपके चालू करने तक बंद रहते हैं, और स्क्रीन लॉक होने पर केवल "किसी taf को आपकी ज़रूरत है" दिखाते हैं। स्क्रीन लॉक होने से पहले दिखाया गया अलर्ट
				अपना विवरण Windows की सूचना सूची में रखता है। Linux पर वे आपके
				बंद करने तक चालू रहते हैं, और लॉक स्क्रीन क्या दिखाती है वह आपके डेस्कटॉप पर निर्भर है। जब आप
				कोई टूल जोड़ते हैं, तो आप टूल के अपने प्रदाता पर साइन इन करते हैं। जिस ऐप में planque खुद साइन इन करता है, जैसे Stripe, या आपके दिए गए key के लिए, planque वह टोकन या key आपकी कंपनी के लिए एन्क्रिप्टेड रूप में रखता है; प्रबंधित कनेक्शन के लिए, planque की सहयोगी कनेक्शन सेवा Composio साइन-इन रखती है, और planque केवल कनेक्शन का रिकॉर्ड और आपके मंज़ूर किए टूल रखता है (सब प्रोसेसर के रूप में, नीचे देखें)। यदि आप tafs एक्सटेंशन को जोड़ते हैं, तो taf आपके अपने Chrome में, आपके अनुमति दी हुई साइटों के पृष्ठ पढ़ और उन पर कार्रवाई भी कर सकता है (प्रोसेसर के रूप में; <a href="/hi/tafs/privacy">tafs गोपनीयता पृष्ठ</a> बताता है कि क्या पढ़ा जाता है, क्या रखा जाता है और कितने समय)। कनेक्शन के रिकॉर्ड में वह खाता (उसका नाम या ईमेल) हो सकता है जिसमें वह साइन इन है, ताकि ऐप आपको दिखा सके कि वह कौन सा है। KIFF प्रबंधित कनेक्शनों का उपयोग केवल <a href="/subprocessors#composio">/subprocessors</a> पर बताए गए ऐप्स के लिए करता है। ऐप में कोई एनालिटिक्स या
				विज्ञापन ट्रैकर नहीं हैं।
			</li>
			<li>
				<strong>App Store खरीदारी</strong> — जब आप tafs में Solo या क्रेडिट पैक खरीदते हैं, तो Apple उसे आपको बेचती है: Apple
				रिकॉर्ड की विक्रेता है, भुगतान लेती है और आपके भुगतान का विवरण रखती है। Apple हमें बताती है कि क्या खरीदा गया,
				किस KIFF खाते के लिए (ऐप खरीद से जो यादृच्छिक id जोड़ता है), कब, Apple की लेन-देन id, और Solo के लिए
				अवधि कब समाप्त या नवीनीकृत होती है। हम इसका उपयोग आपके खाते में
				क्रेडिट या योजना जोड़ने के लिए करते हैं। Apple हमें
				आपकी Apple ID, नाम, ईमेल पता या कार्ड नहीं देती।
			</li>
			<li>
				<strong>Google Play खरीदारी</strong> — Android पर
				वही खरीदारी Google Play की बिलिंग से होती है:
				Google भुगतान लेती है और आपके भुगतान का विवरण रखती है। Google हमें बताती है कि क्या खरीदा गया, किस
				KIFF खाते के लिए (वही यादृच्छिक id), कब, खरीद का टोकन और ऑर्डर id, और Solo के लिए
				अवधि कब समाप्त या नवीनीकृत होती है, और हम उसका उपयोग उसी तरह करते हैं।
				Google हमें आपका Google खाता, नाम,
				ईमेल पता या कार्ड नहीं देती।
			</li>
		</ul>
	</section>
}

templ privacyLawfulBasesHI() {
	<section id="lawful-bases">
		<h2>5. प्रोसेसिंग के वैध आधार</h2>
		<p>
			GDPR के अनुच्छेद 6 के तहत, हम इन वैध आधारों पर निर्भर करते हैं:
		</p>
		<ul>
			<li>
				<strong>अनुबंध का निष्पादन</strong> (अनुच्छेद
				6(1)(b)) — खाता बनाने, प्रमाणीकरण, आपकी ओर से रनटाइम चलाने, बिलिंग (सक्रिय होने पर) और मुख्य सेवा सतहों के लिए।
			</li>
			<li>
				<strong>वैध हित</strong> (अनुच्छेद 6(1)(f))
				— सुरक्षा, धोखाधड़ी रोकने, दुरुपयोग पहचानने,
				परिचालन टेलीमेट्री और सेवा की रक्षा के लिए।
				हम अपने हितों को आपके अधिकारों से तौलते हैं और अनुरोध पर बताएँगे कि उस संतुलन परीक्षण का
				क्या नतीजा रहा।
			</li>
			<li>
				<strong>सहमति</strong> (अनुच्छेद 6(1)(a)) — tafs ऐप में AI के लिए: Coach और आपके tafs को चलाने वाले AI मॉडल को जो भेजा जाता है, जैसा <a href="#ai-in-tafs">नीचे</a> बताया गया है। आपके अनुमति देने तक कुछ नहीं भेजा जाता, और आप खाता में वापस ले सकते हैं। सहमति वह भी है जो हम किसी एनालिटिक्स कुकी, वैकल्पिक मार्केटिंग संचार, या ऐसी नई प्रोसेसिंग से पहले माँगेंगे जो आपके डेटा के हमारे उपयोग को वास्तव में बढ़ाती हो। हम कोई एनालिटिक्स, कोई विज्ञापन और कोई गैर-ज़रूरी ट्रैकिंग नहीं चलाते।
			</li>
			<li>
				<strong>कानूनी बाध्यता</strong> (अनुच्छेद 6(1)(c))
				— कर रिकॉर्ड (एस्टोनियाई लेखा अधिनियम §12, 7
				वर्ष), वैध प्राधिकारियों के अनुरोधों के उत्तर, और जहाँ लागू हो
				धन-शोधन विरोधी नियमों द्वारा अपेक्षित प्रतिधारण के लिए।
			</li>
		</ul>
		<h3 id="ai-in-tafs">tafs ऐप में AI</h3>
		<p>tafs ऐप कुछ भी AI को जाने से पहले आपसे इन शब्दों में पूछता है:</p>
		<ul>
			<li>tafs, Coach और आपके tafs के लिए Anthropic के Claude AI का उपयोग करता है।</li>
			<li>Coach और आपके tafs AI एजेंट हैं: वे जो लिखते हैं वह AI से बना होता है और गलत हो सकता है। taf आपकी कंपनी के बाहर जो संदेश भेजता है, उसमें बताया जाता है कि उसे एक AI एजेंट ने लिखा है।</li>
			<li>उसे क्या भेजा जाता है: आप Coach और अपने tafs को जो लिखते हैं, आपकी जोड़ी फ़ाइलें, काम करते समय आपके जुड़े ऐप्स taf को जो लौटाते हैं, और ऐप में Coach आपकी मदद करते समय आपकी स्क्रीन पर क्या है।</li>
			<li>जो कभी नहीं भेजा जाता: आपके जुड़े ऐप्स के उपयोग किए पासवर्ड और कुंजियाँ, या आपका फ़िंगरप्रिंट।</li>
			<li>Anthropic इसे उत्तर देने के लिए उपयोग करती है और 30 दिन तक रखती है।</li>
			<li>आपके अनुमति देने तक कुछ नहीं भेजा जाता। आप खाता में वापस ले सकते हैं।</li>
		</ul>
		<p>जो taf उस समय बिना किसी के मौजूद रहे चलता है (अपने निर्धारित समय पर, या जब कुछ आता है), वह उस व्यक्ति की सहमति पर टिका है जिसने उसे बनाया या सँभाला, या फिर खाते के taf सँभालने वाले पहले व्यक्ति की जिसने अनुमति दी।</p>
		<p><strong>जब आप वापस लेते हैं,</strong> Coach और आपके tafs आपको उत्तर देना बंद कर देते हैं। जिस taf की रन आपकी सहमति पर टिकी हैं वह थम जाता है: उसके निर्धारित समय रुक जाते हैं, और जो आता है वह इंतज़ार करता है। वह तब फिर चलता है जब सहमति दोबारा दी जाए, या खाते के taf सँभालने वाला कोई अपनी सहमति से उसे सँभाल ले। वापस लेने से पहले जो भेजा गया उसमें बदलाव नहीं होता।</p>
		<p>Anthropic <a href="/subprocessors">/subprocessors</a> (अंग्रेज़ी में) पर सूचीबद्ध है, जिसमें बताया है कि वह कहाँ प्रोसेस करती है और कब डेटा लंबे समय तक रख सकती है।</p>
	</section>
}

templ privacySubprocessorsHI() {
	<section id="sub-processors">
		<h2>6. उप-प्रोसेसर</h2>
		<p>हम आपका व्यक्तिगत डेटा नहीं बेचते, और विज्ञापन के लिए साझा नहीं करते।</p>
		<p>
			हम सेवा देने के लिए कुछ विक्रेताओं को लगाते हैं।
			आधिकारिक, मौजूदा सूची
			<a href="/subprocessors">/subprocessors</a> (अंग्रेज़ी में) पर है;
			किसी भी बदलाव के 30 दिन के भीतर वह पृष्ठ अपडेट होता है। हम हर उप-प्रोसेसर से लिखित अनुबंधों के तहत हमारे समतुल्य सुरक्षा की अपेक्षा करते हैं,
			जिसमें व्यक्तिगत डेटा के EU से बाहर जाने पर EU की मानक संविदात्मक धाराएँ
			शामिल हैं।
		</p>
		<p>
			व्यक्तिगत डेटा को प्रभावित करने वाले उप-प्रोसेसरों के सारभूत जोड़ या बदलाव की सूचना सक्रिय ग्राहकों को पहले से, आपत्ति के अधिकार के साथ दी जाती है।
		</p>
	</section>
}

templ privacyTransfersHI() {
	<section id="transfers">
		<h2>7. अंतरराष्ट्रीय हस्तांतरण</h2>
		<p>
			हमारे कुछ उप-प्रोसेसर यूरोपीय आर्थिक क्षेत्र से बाहर, मुख्यतः संयुक्त राज्य अमेरिका में, स्थापित हैं।
			ऐसे हर हस्तांतरण के लिए हम नीचे के कम से कम एक सुरक्षा उपाय पर निर्भर करते हैं:
		</p>
		<ul>
			<li>
				<strong>EU–US डेटा गोपनीयता फ्रेमवर्क</strong> —
				उन अमेरिकी उप-प्रोसेसरों के लिए जिन्होंने फ्रेमवर्क का प्रमाणन किया है। पर्याप्तता निर्णय 2023 के मध्य से लागू है;
				हम उसकी स्थिति में किसी भी बदलाव पर नज़र रखते हैं।
			</li>
			<li>
				<strong>मानक संविदात्मक धाराएँ</strong> —
				हमारे सीधे उप-प्रोसेसरों के लिए मॉड्यूल 2 (नियंत्रक से प्रोसेसर) और जहाँ श्रृंखलाबद्ध प्रोसेसर लागू हों वहाँ मॉड्यूल 3 (प्रोसेसर से उप-प्रोसेसर)। हम आयोग-अनुमोदित 2021 की मानक संविदात्मक धाराओं का उपयोग करते हैं।
			</li>
			<li>
				<strong>अनुपूरक उपाय</strong> — जहाँ जोखिम आकलन से पता चले कि अतिरिक्त सुरक्षा उपाय आवश्यक हैं
				(संचरण और भंडारण में एन्क्रिप्शन, एक्सेस लॉगिंग, डेटा न्यूनीकरण)।
			</li>
		</ul>
		<p>
			किसी उप-प्रोसेसर पर लागू विशिष्ट हस्तांतरण साधन आप
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> पर ईमेल करके माँग सकते हैं।
		</p>
		<p><strong>आपका देश।</strong> कुछ देशों के कानून इस नीति से अधिक माँगते हैं। वे जो जोड़ते हैं, अंग्रेज़ी में और उस देश की भाषा में, <a href="/privacy/countries">आपका देश</a> (अंग्रेज़ी में) पर है।</p>
	</section>
}

templ privacyRetentionHI() {
	<section id="retention">
		<h2>8. प्रतिधारण</h2>
		<p>
			हम व्यक्तिगत डेटा उन उद्देश्यों के अनुरूप सबसे कम अवधि तक रखते हैं जिनके लिए हम उसे प्रोसेस करते हैं, और किसी भी लागू कानूनी बाध्यता के अनुसार।
		</p>
		<ul>
			<li>
				<strong>खाता और साइन-इन मेटाडेटा</strong> —
				खाता हटाए जाने तक। tafs ऐप में
				स्वामी उसे खाता → <em>खाता हटाएँ</em> में हटाता है। वेब पर बनाया खाता
				<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> को ईमेल करके,
				GDPR अनुच्छेद 12(3) की एक महीने की अवधि में हटाया जाता है।
				दोनों तरह, खाते की कुंजियाँ तुरंत रुक जाती हैं। tafs ऐप में हटाने पर
				उसे पलटा नहीं जा सकता: उसकी tafs चैट,
				नोट और कनेक्शन तुरंत मिट जाते हैं, और
				KIFF जो रखता है वह 30 दिन के भीतर मिट जाता है। वेब पर हटाने पर,
				हम उसका डेटा 30 दिन की छूट अवधि तक रखते हैं, यदि स्वामी उसे वापस चाहे, फिर मिटा देते हैं।
			</li>
			<li>
				<strong>API key रिकॉर्ड</strong> — खाता हटाए जाने तक,
				key रद्द होने के बाद भी। एजेंट साइन-इन कनेक्शन से जुड़ी key
				उसी कनेक्शन के साथ, उसके खत्म होने के 30 दिन बाद हटाई जाती है।
			</li>
			<li>
				<strong>सत्र कुकी</strong> — समाप्ति तक (डिफ़ॉल्ट रूप से 24
				घंटे) या आपके साइन आउट करने तक।
			</li>
			<li>
				<strong>रिवर्स-प्रॉक्सी एक्सेस लॉग</strong> — 90
				दिन तक, फिर एकत्रित या हटाए जाते हैं।
			</li>
			<li>
				<strong>सेवा लॉग</strong> — KIFF की सेवाएँ
				और planque चलते समय जो दर्ज करते हैं: त्रुटियाँ और अनुरोध,
				जिनमें किसी खाते, व्यक्ति या एजेंट का नाम हो सकता है। 30
				दिन, फिर हटा दिए जाते हैं।
			</li>
			<li>
				<strong>बैकअप</strong> — KIFF का डेटाबेस रोज़
				एन्क्रिप्टेड बैकअप होता है, और हर बैकअप 7 दिन रखा जाता है, इसलिए
				हटाया रिकॉर्ड उनसे 7 दिन के भीतर चला जाता है।
				tafs और planque के स्टोर एन्क्रिप्टेड पॉइंट-इन-टाइम प्रतियाँ 35 दिन रखते हैं, केवल विफलता के बाद
				स्टोर बहाल करने के लिए उपयोग होती हैं, इसलिए हटाया रिकॉर्ड
				उनसे 35 दिन के भीतर चला जाता है।
			</li>
			<li>
				<strong>टेनेंट ऑडिट डेटा</strong> — प्रोसेसर के रूप में
				ग्राहक के टेनेंट कॉन्फ़िगरेशन के अनुसार रखा जाता है। डिफ़ॉल्ट:
				टेनेंट के जीवनकाल तक रखा जाता है; टेनेंट हटाने पर हटाया जाता है। देखें:
				<a href="/security#deletion">/security#deletion</a>।
			</li>
			<li>
				<strong>KIFF गेटवे से कॉल</strong> —
				कॉल के तर्क उसके भेजे जाने, अस्वीकार होने या विफल होने तक,
				फिर हटा दिए जाते हैं; टूल का नतीजा 24 घंटे, फिर
				हटा दिया जाता है। निर्णय रिकॉर्ड और तर्कों का हैश टेनेंट ऑडिट डेटा के रूप में रखे जाते हैं। देखें:
				<a href="/security#data-kept">/security#data-kept</a>।
			</li>
			<li>
				<strong>उपयोग</strong> — गेटवे से हर कॉल के लिए,
				उसके खत्म होने पर: किस एजेंट ने की, कौन सा टूल,
				और वह कार्रवाई गिनी गई या मुफ़्त थी (और
				क्यों)। taf या Coach की हर रन के लिए, उसके खत्म होने पर:
				taf, कब, AI ने कितने क्रेडिट उपयोग किए, और वे
				गिने गए या क्यों नहीं। खाता हटाए जाने तक; हमारे भुगतान प्रोसेसर को बिलिंग के लिए जो बताया जाता है वह
				बिलिंग रिकॉर्ड के साथ रखा जाता है।
			</li>
			<li>
				<strong>एजेंट साइन-इन कनेक्शन</strong> — कौन सा
				एजेंट, ऐप का नाम, किसने अनुमति दी, कब, और उसका
				आखिरी उपयोग: कनेक्शन के सक्रिय रहते, फिर उसके खत्म होने के 30
				दिन बाद (उस दौरान वह डैशबोर्ड में सूचीबद्ध रहता है), फिर उसके टोकन और
				API key के साथ हटा दिया जाता है। यह सब खाते के साथ हटा दिया जाता है।
			</li>
			<li>
				<strong>tafs</strong> — डिवाइस का push टोकन आपके
				ऐप से साइन आउट करने, डिवाइस हटाने, या Apple या
				Google के टोकन के चले जाने की सूचना देने तक। डिवाइस की सार्वजनिक कुंजी,
				नाम, प्लेटफ़ॉर्म और तारीखें जब तक आप उसका उपयोग करते हैं; उसे साइन आउट करने के बाद,
				वह हटाया हुआ चिह्नित होता है और खाता हटने तक रखा जाता है, ताकि KIFF उससे देर से आया उत्तर अस्वीकार कर सके और दिखा सके कि पहले वाले पर
				किस डिवाइस ने हस्ताक्षर किए थे। Passkey की सार्वजनिक
				कुंजी, id और नाम उसके डिवाइस की तरह रखे जाते हैं। कंप्यूटर अपना सत्र
				90 दिन तक, या आपके साइन आउट करने तक रखता है। tafs जो
				आपकी कंपनी के लिए रखता है वह प्रोसेसर के रूप में रखा जाता है: taf की रन और
				चैट, चैट के सारांश के साथ (और Setup की), 30 दिन,
				आपके टूल जो लौटाते हैं वह केवल रन खत्म होने तक (चैट में,
				जो उसने केवल पढ़ा वह उसके अगले संदेशों के लिए एन्क्रिप्टेड रूप में रखा जाता है,
				चैट के एक घंटे निष्क्रिय रहने तक और पढ़ने के बाद अधिकतम चार घंटे तक उपयोग होता है, फिर कुछ दिनों के भीतर
				अपने आप मिटा दिया जाता है), और उसके मेमोरी नोट
				taf के हटाए जाने तक; उसकी सौंपी फ़ाइलें उन्हें बनाने वाली रन से 30 दिन, फिर एक दिन के भीतर अपने आप मिटा दी जाती हैं, या आपके खाते का कोई व्यक्ति किसी को हटाए तो पहले; planque में कनेक्शन का टोकन या key, या Composio पर प्रबंधित कनेक्शन का साइन-इन, आपके डिस्कनेक्ट करने तक (यदि आपका कोई और कनेक्शन उस विक्रेता पर वही खाता उपयोग कर सकता हो, तो वह उसके भी डिस्कनेक्ट होने तक अनुपयोगी रखा जाता है), और उसकी मंज़ूरियों का रिकॉर्ड
				खाता समाप्त होने तक; देखें
				<a href="/legal/dpa#annex-4">DPA का अनुलग्नक 4</a>।
			</li>
			<li>
				<strong>बिलिंग रिकॉर्ड</strong> — वित्तीय वर्ष के
				अंत से 7 वर्ष (एस्टोनियाई लेखा अधिनियम
				§12)।
			</li>
			<li>
				<strong>App Store और Google Play खरीदारी</strong> —
				Apple या Google ने हमें हर खरीद के बारे में जो बताया
				वह खाता हटाए जाने तक आपके खाते में रहता है। उनकी
				बिक्री और भुगतान रिपोर्ट, जिन्हें हम बिलिंग रिकॉर्ड के रूप में 7 वर्ष रखते हैं, आपका नाम नहीं बतातीं।
			</li>
			<li>
				<strong>सपोर्ट पत्राचार</strong> — अंतिम संवाद से 3
				वर्ष, फिर हटा दिया जाता है।
			</li>
		</ul>
	</section>
}

templ privacyRightsHI() {
	<section id="rights">
		<h2>9. आपके अधिकार</h2>
		<p>
			GDPR के तहत आपके व्यक्तिगत डेटा के संबंध में आपके ये अधिकार हैं:
		</p>
		<ul>
			<li><strong>पहुँच</strong> (अनुच्छेद 15) — इसकी पुष्टि कि हम आपका डेटा प्रोसेस करते हैं या नहीं, और उसकी एक प्रति।</li>
			<li><strong>सुधार</strong> (अनुच्छेद 16) — गलत या अधूरे डेटा का सुधार।</li>
			<li><strong>मिटाना</strong> (अनुच्छेद 17) — आपके डेटा को हटाना, कानूनी-प्रतिधारण अपवादों के अधीन।</li>
			<li><strong>प्रतिबंध</strong> (अनुच्छेद 18) — विवाद सुलझने तक प्रोसेसिंग रोकना।</li>
			<li><strong>पोर्टेबिलिटी</strong> (अनुच्छेद 20) — आपके दिए डेटा का मशीन-पठनीय निर्यात।</li>
			<li><strong>आपत्ति</strong> (अनुच्छेद 21) — वैध हितों पर आधारित प्रोसेसिंग पर; जब तक हम प्रबल आधार न दिखा सकें, हम रुक जाते हैं।</li>
			<li><strong>सहमति वापस लेना</strong> (अनुच्छेद 7(3)) — सहमति पर आधारित किसी भी प्रोसेसिंग के लिए, जैसे tafs ऐप में AI (खाता में, जैसा <a href="#ai-in-tafs">ऊपर</a> है)। वापस लेने से पहले की वैध प्रोसेसिंग पर असर नहीं पड़ता।</li>
		</ul>
		<p>
			इनमें से कोई भी अधिकार उपयोग करने के लिए
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> पर ईमेल करें।
			हम अनुच्छेद 12(3) के अनुसार बिना अनुचित देरी के और ज़्यादा से ज़्यादा एक महीने के भीतर उत्तर देते हैं; जटिल अनुरोधों के लिए हम
			उसे दो और महीने तक बढ़ा सकते हैं
			और ऐसा करने पर आपको बताएँगे।
		</p>
		<h3 id="export-chats">आपकी अपनी tafs चैट</h3>
		<p>
			tafs ऐप में खाता →  मेरी चैट निर्यात करें
			हर taf के साथ, Coach सहित, आपकी अपनी चैट,
			आपकी जोड़ी फ़ाइलों के नाम, और आपके अपने
			नोट, पठनीय फ़ाइल और JSON के रूप में डाउनलोड करता है। इन्हें केवल आप
			निर्यात कर सकते हैं: एडमिन या खाते का स्वामी नहीं कर सकता,
			और KIFF का खाता निर्यात इन्हें शामिल नहीं करता।
		</p>
		<h3 id="delete-account">अपना tafs खाता हटाना</h3>
		<p>
			tafs KIFF का ऐप है। अपना tafs खाता और उसका
			डेटा हटाने के लिए:
		</p>
		<ol>
			<li>tafs ऐप खोलें और साइन इन करें।</li>
			<li>खाता पर जाएँ, फिर <em>खाता हटाएँ</em> पर टैप करें।</li>
			<li>पुष्टि करें। खाता हटाना पलटा नहीं जा सकता।</li>
		</ol>
		<p>
			<em>खाता हटाएँ</em> उसे दिखता है जो कंपनी का खाता हटा सकता है,
			आमतौर पर उसका स्वामी। यदि आपको यह नहीं दिखता, या अब आपके पास
			ऐप नहीं है, तो
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			पर उस पते से ईमेल करें जिससे आप साइन इन करते हैं, और हम आपका डेटा बिना अनुचित देरी के और ज़्यादा से ज़्यादा एक महीने के भीतर हटा देते हैं।
		</p>
		<p>
			क्या हटाया जाता है: खाते की कुंजियाँ तुरंत रुक जाती हैं। उसके
			tafs, चैट, नोट, जोड़ी फ़ाइलें और कनेक्शन
			तुरंत मिट जाते हैं, और उनकी पॉइंट-इन-टाइम प्रतियों से
			35 दिन के भीतर। KIFF खाते के लिए जो रखता है वह
			30 दिन के भीतर, और उसके बाद 7 दिन के भीतर बैकअप से मिटा दिया जाता है।
			खाते का नाम बताने वाले सेवा लॉग
			30 दिन के भीतर चले जाते हैं। टेनेंट ऑडिट डेटा
			टेनेंट के साथ हटाया जाता है। हर तरह के डेटा के लिए <a href="#retention">प्रतिधारण</a> देखें।
		</p>
		<p id="delete-data">
			खाता रखकर अपना कुछ डेटा हटाने के लिए: ऐप में
			चैट हटाएँ, और उसके संदेश और जोड़ी
			फ़ाइलें उसके साथ चली जाती हैं; taf हटाएँ, और उसकी चैट, नोट और
			कनेक्शन उसके साथ चले जाते हैं। किसी और चीज़ के लिए
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			पर ईमेल करें और बताएँ कि क्या हटाना है। हम यह बिना अनुचित देरी के और ज़्यादा से ज़्यादा एक महीने के भीतर करते हैं।
		</p>
		<p>
			आपको पर्यवेक्षी प्राधिकरण में शिकायत दर्ज करने का अधिकार है। हमारा प्रमुख पर्यवेक्षी प्राधिकरण
			<a href="https://www.aki.ee/en" target="_blank" rel="noopener">एस्टोनियाई डेटा संरक्षण निरीक्षणालय (Andmekaitse Inspektsioon)</a> है।
			आप अपने निवास के सदस्य राज्य के पर्यवेक्षी प्राधिकरण में भी शिकायत कर सकते हैं।
		</p>
		<p><strong>आपका देश।</strong> कुछ देशों के कानून इस नीति से अधिक माँगते हैं। वे जो जोड़ते हैं, अंग्रेज़ी में और उस देश की भाषा में, <a href="/privacy/countries">आपका देश</a> (अंग्रेज़ी में) पर है।</p>
	</section>
}

templ privacyCookiesHI() {
	<section id="cookies">
		<h2>10. कुकीज़</h2>
		<p>
			हम तीन कुकी लगाते हैं, तीनों बिल्कुल आवश्यक, प्रथम-पक्ष,
			केवल HTTPS पर भेजी जाती हैं और पृष्ठ की स्क्रिप्ट उन्हें पढ़ नहीं सकतीं।
			EU के ePrivacy नियमों के तहत उन्हें सहमति की ज़रूरत नहीं; हम उन्हें इसलिए सूचीबद्ध करते हैं कि आपको उनके होने का पता रहे।
			<a href="/cookies">कुकी नीति</a> (अंग्रेज़ी में) में विवरण हैं।
		</p>
		<ul>
			<li>
				<strong><code>kiff_session</code></strong> — आपको
				साइन इन रखती है। एक हस्ताक्षरित सत्र कुकी जो आपकी साइन-इन id, ईमेल और नाम, और डैशबोर्ड जो क्रेडेंशियल आपके लिए उपयोग करता है,
				वह ले जाती है। <code>.kiff.dev</code> के लिए लगाई जाती है। यह 24 घंटे चलती है,
				या आपके साइन आउट करने तक।
			</li>
			<li>
				<strong><code>kiff_flash</code></strong> — अगले पृष्ठ तक
				एक बार का संदेश ले जाती है, जैसे "आपकी key
				बनाई गई"। हस्ताक्षरित; नई key कभी उसमें नहीं होती। <code>.kiff.dev</code>
				के लिए लगाई जाती है। अगला पृष्ठ पढ़ ले तो हटा दी जाती है,
				और अधिकतम 5 मिनट।
			</li>
			<li>
				<strong><code>kiff_cb_attempts</code></strong> — गिनती है कि साइन-इन पृष्ठ
				कितनी बार दोबारा लोड हुआ, ताकि घूमता साइन-इन रोका जा सके। केवल उसी पृष्ठ को भेजी जाती है। यह 5
				मिनट चलती है, और साइन-इन शुरू होने या सफल होने पर साफ़ हो जाती है।
			</li>
		</ul>
		<p>
			हम एनालिटिक्स कुकी, विज्ञापन कुकी या
			किसी तीसरे पक्ष के ट्रैकर का उपयोग नहीं करते। यदि हम कभी कोई जोड़ें, तो कुकी लगने से पहले
			सहमति बैनर दिखाएँगे, ePrivacy और ट्रैकिंग तकनीकों पर EDPB के
			2023 के मार्गदर्शन के अनुरूप।
		</p>
		<p>
			यदि आप Clerk (हमारे प्रमाणीकरण उप-प्रोसेसर) के ज़रिए साइन इन करते हैं, तो Clerk अपने
			फ्रंटएंड डोमेन (<code>clerk.kiff.dev</code>) पर भी कुकी लगाता है। वे
			कुकी Clerk को उसके साइन-इन प्रवाह में आपको पहचानने के लिए आवश्यक हैं और हमारी तरह Clerk की गोपनीयता
			नीति से भी शासित हैं। विवरण के लिए उप-प्रोसेसर सूची देखें।
		</p>
	</section>
}

templ privacySecurityHI() {
	<section id="security">
		<h2>11. सुरक्षा</h2>
		<p>
			हमारे तकनीकी और संगठनात्मक सुरक्षा उपाय
			<a href="/security">/security</a> (अंग्रेज़ी में) पर दर्ज हैं। इनमें डेटाबेस स्तर पर टेनेंट अलगाव,
			संचरण में TLS 1.2+, प्रबंधित
			प्रदाता की डिफ़ॉल्ट सेटिंग के ज़रिए भंडारण में एन्क्रिप्शन, और न्यूनतम विशेषाधिकार
			के सिद्धांत पर आधारित एक्सेस नियंत्रण शामिल हैं।
		</p>
		<p>
			हम व्यक्तिगत डेटा उल्लंघन की सूचना प्रभावित ग्राहकों को
			अनुचित विलंब के बिना और पुष्टि के 72 घंटे के भीतर देते हैं,
			GDPR के अनुच्छेद 33 के अनुरूप। सूचना में उल्लंघन की
			प्रकृति, संबंधित डेटा विषयों और रिकॉर्ड की श्रेणियाँ और अनुमानित संख्या, संभावित
			परिणाम, और किए गए या प्रस्तावित उपाय शामिल होते हैं।
		</p>
	</section>
}

templ privacyChildrenHI() {
	<section id="children">
		<h2>12. बच्चे</h2>
		<p>
			KIFF Cloud डेवलपर इन्फ्रास्ट्रक्चर उत्पाद है जो बच्चों के लिए
			नहीं है। हम 16 वर्ष से कम आयु के बच्चों से व्यक्तिगत डेटा
			जानबूझकर एकत्र नहीं करते। यदि आपको लगता है कि किसी बच्चे ने हमें व्यक्तिगत डेटा दिया है,
			तो <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			से संपर्क करें और हम उसे हटा देंगे।
		</p>
	</section>
}

templ privacyAutomatedHI() {
	<section id="automated">
		<h2>13. स्वचालित निर्णय</h2>
		<p>
			KIFF Cloud का रनटाइम हमारे ग्राहकों के भेजे डेटा पर निश्चयात्मक नीति निर्णय लेता है। ये GDPR के अनुच्छेद 22 के अर्थ में आपके बारे में ऐसे निर्णय नहीं हैं जिनका कानूनी या उसी तरह का महत्वपूर्ण प्रभाव हो; ये
			ग्राहक की कार्रवाइयों (रिफंड, ऑर्डर,
			संदेश आदि) के बारे में निर्णय हैं, जो ग्राहक की अपनी
			नीति के तहत निष्पादित होते हैं।
		</p>
		<p>
			जो ग्राहक अपने अंतिम उपयोगकर्ताओं को प्रभावित करने वाले निर्णय लेने के लिए KIFF Cloud का उपयोग करते हैं,
			वे अनुच्छेद 22 के अनुपालन के लिए स्वयं ज़िम्मेदार हैं। हमारी गवर्नेंस रसीदें उन ग्राहकों को मानवीय निगरानी दिखाने के लिए
			ज़रूरी ऑडिट ट्रेल देने के लिए
			बनाई गई हैं, पर वह निगरानी देने का कानूनी
			दायित्व ग्राहक पर है।
		</p>
	</section>
}

templ privacyChangesHI() {
	<section id="changes">
		<h2>14. इस नीति में बदलाव</h2>
		<p>
			हम समय-समय पर इस नीति को अपडेट कर सकते हैं। सारभूत
			बदलावों की सूचना सक्रिय ग्राहकों को ईमेल से और इस पृष्ठ पर कम से कम 30 दिन
			एक प्रमुख बैनर से दी जाती है।
			गैर-सारभूत बदलाव नई
			"अंतिम अपडेट" तिथि के साथ पोस्ट किए जाते हैं।
		</p>
	</section>
}

