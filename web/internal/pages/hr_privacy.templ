package pages

import "github.com/kiff/cloud/web/internal/components"

// PrivacyHR is the privacy policy (/privacy) in Croatian, at /hr/privacy.
// It is a translation of Privacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English
// page governs. Change the English page first, then this one. Croatian has
// the legal texts only, so a link to any other page goes to English and
// says so.
templ PrivacyHR() {
	@components.LayoutSite("KIFF — politika privatnosti", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@privacyHeadHR()
			@privacyWhoWeAreHR()
			@privacyScopeHR()
			@privacyRolesHR()
			@privacyCategoriesHR()
			@privacyLawfulBasesHR()
			@privacySubprocessorsHR()
			@privacyTransfersHR()
			@privacyRetentionHR()
			@privacyRightsHR()
			@privacyCookiesHR()
			@privacySecurityHR()
			@privacyChildrenHR()
			@privacyAutomatedHR()
			@privacyChangesHR()
			@privacyContactHR()
		</article>
	}
}

templ privacyHeadHR() {
	<header class="legal-head">
		<p class="legal-badge">Politika privatnosti · v0.1</p>
		<h1>Politika privatnosti</h1>
		<p class="legal-meta">
			<strong>Posljednje ažuriranje:</strong> 21. studenoga 2026.
			<strong>Datum stupanja na snagu:</strong> 24. svibnja 2026.
		</p>
		<p class="legal-disclaimer">
			Ova politika objašnjava kako KIFF Cloud obrađuje osobne
			podatke na web-mjestu, nadzornoj ploči, API-ju i u
			aplikaciji tafs za iPhone, iPad, Android i računala.
			Pitanja:
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</header>
}

templ privacyWhoWeAreHR() {
	<section id="who-we-are">
		<h2>1. Tko smo mi</h2>
		<p>
			KIFF Cloudom upravlja <strong>Kiff Agents OÜ</strong>,
			društvo s ograničenom odgovornošću osnovano u Estoniji.
			Podaci iz registra:
		</p>
		<ul>
			<li><strong>Registarski broj:</strong> 17372313 (estonski poslovni registar e-Business Register)</li>
			<li><strong>PDV identifikacijski broj:</strong> EE102924327</li>
			<li><strong>Sjedište:</strong> Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estonija</li>
			<li><strong>Kontakt za privatnost:</strong> <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a></li>
			<li><strong>Službene pravne obavijesti:</strong> <a href="mailto:legal@kiff.dev">legal@kiff.dev</a></li>
		</ul>
		<p>
			Budući da je Kiff Agents OÜ osnovan u Europskoj uniji, na
			našu se obradu izravno primjenjuje Opća uredba EU o zaštiti
			podataka
			(<abbr title="General Data Protection Regulation">GDPR</abbr>).
			Ne trebamo predstavnika u EU-u iz članka 27.
		</p>
	</section>
}

templ privacyScopeHR() {
	<section id="scope">
		<h2>2. Opseg ove politike</h2>
		<p>
			Ova politika obuhvaća osobne podatke koje obrađujemo kada
			koristite:
		</p>
		<ul>
			<li><a href="https://kiff.dev"><code>kiff.dev</code></a> — naše marketinško web-mjesto, ovu stranicu politike i javni prikaz potvrda.</li>
			<li><a href="https://app.kiff.dev"><code>app.kiff.dev</code></a> — našu nadzornu ploču za koju je potrebna prijava.</li>
			<li><a href="https://api.kiff.dev"><code>api.kiff.dev</code></a> — naš HTTP API.</li>
			<li id="tafs"><strong>tafs</strong> — našu aplikaciju za iPhone, iPad, Android i računala (Mac, Windows i Linux) i uslugu iza nje (uključujući Setup, koji povezuje alate poduzeća, i planque, koji čuva te veze), u kojoj poduzeće povjerava zadatak AI agentu koji radi unutar KIFF Cards.</li>
		</ul>
		<p>
			Ova politika <em>ne</em> obuhvaća okvir otvorenog koda
			<code>kiff/kiff</code> koji možete sami pokretati.
			Kada okvir pokrećete na vlastitoj infrastrukturi, vi ste
			voditelj obrade svih podataka koje obrađuje, a Kiff Agents
			OÜ ne sudjeluje u toj obradi.
		</p>
	</section>
}

templ privacyRolesHR() {
	<section id="roles">
		<h2>3. Naše uloge prema GDPR-u</h2>
		<p>
			Ovisno o podacima, djelujemo u dvama svojstvima:
		</p>
		<ul>
			<li>
				<strong>Voditelj obrade</strong> za metapodatke računa
				i prijave, podatke o naplati (kada je naplata aktivna),
				marketinške poruke na koje se pretplatite i operativnu
				telemetriju naše vlastite usluge.
			</li>
			<li>
				<strong>Izvršitelj obrade</strong> za revizijske podatke,
				zapise o radnjama, potvrde odluka i drugi sadržaj koji
				prolazi kroz izvršno okruženje u ime naših klijenata te za
				ono što tafs čuva za njih (pokretanja svakog tafa, razgovore, izvješća, bilješke u memoriji i datoteke koje isporuče).
				Voditelji obrade tih podataka su klijenti (zakupci); daju
				nam upute putem postavki svog računa i konfiguracije
				domene. Taj odnos uređuje ugovor o obradi podataka
				(<abbr title="Data Processing Agreement">DPA</abbr>);
				objavljene uvjete pogledajte u
				<a href="/legal/dpa">predlošku DPA-a</a> (na engleskom).
			</li>
		</ul>
		<p>
			Ova se politika prvenstveno bavi obradom koju provodimo kao
			voditelj obrade. Kada spominjemo podatke koje obrađujemo
			kao izvršitelj obrade, DPA je specifičniji dokument.
		</p>
	</section>
}

templ privacyCategoriesHR() {
	<section id="categories">
		<h2>4. Kategorije osobnih podataka koje obrađujemo</h2>
		<p>
			Kategorije u nastavku usklađene su s tehničkim popisom na
			<a href="/security#data-we-process">/security#data-we-process</a> (na engleskom).
			Ako se razlikuju, mjerodavna je tehnička stranica, a ovaj
			odjeljak usklađujemo s njom.
		</p>
		<ul>
			<li>
				<strong>Identifikatori računa</strong> — vaš identifikator
				kod nadređene autentifikacije (koji izdaje naš pružatelj
				identiteta) i adresa e-pošte kojom se prijavljujete. Danas
				se pohranjuju u izvornom obliku; pohrana u sažetom (hash)
				obliku je planirana.
			</li>
			<li>
				<strong>Metapodaci zakupca</strong> — ID zakupca, slug,
				prikazni naziv, vremenska oznaka nastanka i jezik koji je
				aplikacija svake osobe posljednji put koristila, kako bi
				e-poruke koje joj KIFF šalje stizale na tom jeziku.
			</li>
			<li>
				<strong>Vjerodajnice za API</strong> — neprozirni zapisi
				ključeva API-ja (pohranjujemo sažetke, nikada otvoreni tekst).
			</li>
			<li>
				<strong>Podaci kolačića sesije</strong> — kolačić sesije
				potpisan HMAC-om, postavljen nakon prijave. Pogledajte
				odjeljak o kolačićima u nastavku.
			</li>
			<li>
				<strong>Metapodaci HTTP zahtjeva</strong> — IP adresa,
				korisnički agent, putanja zahtjeva, status odgovora,
				latencija. Čuvaju se u zapisnicima pristupa našeg obrnutog
				proxyja ograničeno vrijeme radi sigurnosti i sprječavanja
				zlouporabe.
			</li>
			<li>
				<strong>Sadržaj pod nadzorom zakupca</strong> — podaci
				<code>parameters</code>, <code>actor</code> i
				<code>entity</code> koje šaljete u izvršno okruženje.
				Čuvamo ih <em>kao izvršitelj obrade</em> u ime klijenta;
				za ono što se pošalje odgovoran je klijent. Konfiguracija
				prikrivanja po domeni je planirana.
			</li>
			<li>
				<strong>Komunikacija</strong> — e-poruke koje šaljete na
				naše adrese za podršku, prodaju, sigurnost ili privatnost.
			</li>
			<li>
				<strong>Aplikacija tafs</strong> — u tafs se prijavljujete
				svojim KIFF računom. Na telefonu ili tabletu aplikacija
				čuva vašu sesiju u Keychainu uređaja (na Androidu u
				njegovoj šifriranoj pohrani). Na računalu je čuva
				zapečaćenu za vaš korisnički račun: na računalu sa
				sustavom Windows vlastitom zaštitom podataka sustava
				Windows, na Linuxu u vašem spremniku ključeva, na Macu
				u njegovu Keychainu. Sesija na računalu traje najviše
				90 dana.
				Aplikacija izrađuje ključ za potpisivanje koji nikada ne
				napušta uređaj: u Secure Enclaveu iPhonea, iPada ili Maca,
				u Keystoreu uređaja s Androidom ili u TPM-u računala sa
				sustavom Windows. Na Linuxu i na Macu bez Secure Enclavea
				ključ je softverski ključ koji se čuva u vašem spremniku
				ključeva ili Keychainu, a to računalo može prikazati što
				vas čeka, ali to ne može odobriti; odobravate na telefonu{ macSecurityKey("hr") }. Računalo sa sustavom
				Windows bez TPM-a ne može se prijaviti u tafs. KIFF čuva javnu polovicu ključa, naziv
				i platformu uređaja te kada je dodan i posljednji put
				korišten, kako bi mogao provjeravati vaše odgovore na
				zadržane pozive i vaša odobrenja veza. Ako odobravate
				pristupnim ključem na računalu, primjerice uslugom Windows
				Hello ili sigurnosnim ključem, vaše lice,
				otisak prsta ili PIN ostaju u vlastitom sustavu računala;
				KIFF čuva javni ključ pristupnog ključa, njegov ID, brojač
				i naziv, nikada ništa tajno, i odbija pristupni ključ koji
				se sinkronizira s drugim uređajima. Ako uključite
				obavijesti na telefonu, tabletu ili Macu na kojem radi
				aplikacija za iPad, čuvamo push token uređaja s vašim
				KIFF ID-jem osobe i jezikom koji je aplikacija prikazivala,
				kako bi njegove obavijesti stizale na tom jeziku. Usluga
				tafs čuva i jezik računa, prema tome tko je posljednji
				razgovarao s Coachem, najviše tri mjeseca, kako bi
				izvješća tafa stizala na tom jeziku. Obavijest telefona
				prolazi kroz Apple ili Google samo s podatkom o kojem je
				tafu riječ i što želi, a u obavijesti vrata s imenom ili
				adresom e-pošte onoga tko je pisao: nikada s iznosom ili
				pojedinostima zahtjeva. Njih aplikacija dodaje na samom
				uređaju, od KIFF-a, pa obavijest na otključanom telefonu
				može prikazati iznos, trgovca ili osobu. Na zaključanom
				telefonu s Androidom prikazuje samo „Taf vas treba”, kao
				i na zaključanom iPhoneu, osim ako ste postavili da se
				pretpregledi uvijek
				prikazuju. <strong>Vaš sat:</strong> sat ne čuva lozinku ni ključ, komunicira samo s vašim uparenim telefonom i nikada ništa ne odobrava. Ono što kažete Coachu ili tafu koji ste odabrali šalje samo kao tekst, putem telefona, nakon što ste dopustili AI. Vaše riječi u taj tekst pretvara vlastita usluga za prepoznavanje govora sata, Appleova ili Googleova. Na Wear OS-u, ako se zaustavi prije nego što završite, to umjesto nje obavlja vlastiti prepoznavač vašeg telefona, na telefonu. Odbiti, zaustaviti ili poslati nešto Coachu ili tafu može samo dok ima zaključavanje zaslona ili šifru i otključan je. Ono što pošaljete tafu ide u vlastiti razgovor tog tafa, kao da ste to napisali na telefonu. Razgovor tafa, uključujući iznose, prikazuje se na satu samo dok je otvoren i svaki se put učitava putem telefona; sat ništa od toga ne čuva. <strong>Apple Watch:</strong> prikazuje vaše tafove i njihove stranice, a da ih ne čuva. Čuva samo vaš Inbox, u datoteci koju ne može čitati dok je zaključan: svaki zadržani poziv kao naziv njegova tafa i ono što traži, nikada iznos, te Coacheve odgovore na ono što ste poslali sa sata, kao tekst. Ako se odjavite na satu, čuva i podatak da ste to učinili, dok se ponovno ne prijavite na satu. Osim toga ne čuva ništa ako sat nema šifru. Inbox nestaje kada se odjavite na satu ili se odjavi vaš iPhone, ili sljedeći put kada se aplikacija otvori ili zatvori bez šifre. Ne izrađuje nikakvu snimku, a jedine obavijesti koje prikazuje su obavijesti vašeg iPhonea. <strong>Wear OS:</strong> prikazuje adresu e-pošte vašeg računa i današnji kalendar, a da ih ne čuva. Kako bi se odmah otvorio, šifrirano čuva broj stvari koje vas čekaju te naziv svakog tafa i je li zaustavljen ili pauziran: nikada iznos, pojedinosti zadržanog poziva ili razgovor tafa. To se briše kada se odjavite, kada se sat zaključa ili ga skinete sa zapešća te nakon 24 sata. Čuva vaš Inbox, u kojem je svaki redak naziv tafa i ono što kaže, nikada iznos, te jednu poruku spremljenu za kasnije, kao tekst. Odjava, na satu ili na telefonu, briše sve to. Za svoju pločicu čuva i broj stvari koje vas čekaju, prikazan samo dok je sat otključan, a briše se kada se odjavite ili sljedeći put kada se pločica prikaže dok je sat zaključan ili nema zaključavanje zaslona. Nakon odjave na satu čuva bilješku da ste se odjavili, dok se ponovno ne prijavite. Inbox nestaje i sljedeći put kada se aplikacija otvori ili zatvori dok je sat zaključan ili nema zaključavanje zaslona. Poruka spremljena za kasnije ostaje dok je ne pošaljete ili izbrišete, jer ste zatražili da se pošalje. Ako se usluga za prepoznavanje govora sata zaustavi prije nego što završite, sat šalje snimku vašem telefonu, koji je pretvara u tekst na samom telefonu, nikada na poslužitelju. Snimka se briše na oba uređaja čim se tekst vrati ili otkažete, a najkasnije nakon 2 minute. Coachu ili vašem tafu prosljeđuje se samo tekst. Rezultat tafa može ostati u obavijestima sata dok ga ne odbacite ili se ne odjavite na satu. Na računalu sa sustavom Windows,
				računalu s Linuxom ili Macu s aplikacijom za macOS 12
				obavijesti izrađuje sama aplikacija dok radi, bez push
				tokena i bez ikojeg drugog poduzeća. Na Windowsu i Linuxu
				prikazuju o kojem je tafu riječ, što želi učiniti, iznos,
				zašto i do kada; u aplikaciji za macOS 12 prikazuju KIFF-ov
				tekst za poziv, nakon što ih uključite, a zaključani zaslon
				prikazuje ono što dopušta postavka pretpregleda na Macu.
				Na Windowsu su isključene
				dok ih ne uključite, a dok je zaslon zaključan prikazuju
				samo „Taf vas treba”. Obavijest prikazana prije
				zaključavanja zaslona zadržava svoje pojedinosti na popisu
				obavijesti sustava Windows. Na Linuxu su uključene dok ih
				ne isključite, a što prikazuje zaključani zaslon ovisi
				o vašem radnom okruženju. Kada
				povezujete alat, prijavljujete se kod vlastitog pružatelja alata. Za aplikaciju u koju se planque prijavljuje sam, primjerice Stripe, ili za ključ koji navedete, planque taj token ili ključ za vaše poduzeće čuva šifrirano; za upravljanu vezu prijavu čuva Composio, usluga za povezivanje s kojom planque radi, a planque čuva samo zapis o vezi i alate koje ste odobrili (sve kao izvršitelj obrade, pogledajte u nastavku). Zapis o vezi može uključivati račun na koji je prijavljena (njegovo ime ili adresu e-pošte), kako bi vam aplikacija mogla pokazati o kojem je riječ. KIFF upravljane veze koristi samo za aplikacije navedene na <a href="/subprocessors#composio">/subprocessors</a> (na engleskom). Aplikacija nema analitičke ni
				oglašivačke alate za praćenje.
			</li>
			<li>
				<strong>Kupnje u App Storeu</strong> — kada u tafsu kupite
				Solo ili paket kredita, prodaje vam ga Apple: Apple je
				prodavatelj, naplaćuje plaćanje i čuva vaše podatke za
				plaćanje. Apple nam javlja što je kupljeno, za koji KIFF
				račun (nasumični ID koji aplikacija pridružuje kupnji),
				kada, Appleov ID transakcije i, za Solo, kada razdoblje
				završava ili se obnavlja. Time se služimo kako bismo
				vašem računu dodali kredite ili plan. Apple nam ne daje
				vaš Apple ID, ime, adresu e-pošte ni karticu.
			</li>
			<li>
				<strong>Kupnje na Google Playu</strong> — na Androidu
				iste kupnje prolaze kroz naplatu Google Playa:
				Google naplaćuje plaćanje i čuva vaše podatke za
				plaćanje. Google nam javlja što je kupljeno, za koji KIFF
				račun (isti nasumični ID), kada, token i ID narudžbe
				kupnje te, za Solo, kada razdoblje završava ili se
				obnavlja, a mi se time služimo na isti način.
				Google nam ne daje vaš Google račun, ime,
				adresu e-pošte ni karticu.
			</li>
		</ul>
	</section>
}

templ privacyLawfulBasesHR() {
	<section id="lawful-bases">
		<h2>5. Pravne osnove obrade</h2>
		<p>
			Na temelju članka 6. GDPR-a oslanjamo se na sljedeće pravne
			osnove:
		</p>
		<ul>
			<li>
				<strong>Izvršenje ugovora</strong> (članak
				6. stavak 1. točka (b)) — za izradu računa, autentifikaciju,
				rad izvršnog okruženja u vaše ime, naplatu (kada je
				aktivna) i osnovne dijelove usluge.
			</li>
			<li>
				<strong>Legitimni interesi</strong> (članak 6. stavak 1. točka (f))
				— za sigurnost, sprječavanje prijevara, otkrivanje
				zlouporaba, operativnu telemetriju i zaštitu usluge.
				Svoje interese odvagujemo s vašim pravima i na zahtjev
				ćemo vam reći kakav je bio ishod tog odvagivanja.
			</li>
			<li>
				<strong>Privola</strong> (članak 6. stavak 1. točka (a)) — za AI u aplikaciji tafs: što se šalje AI modelu koji pokreće Coacha i vaše tafove, kako je opisano <a href="#ai-in-tafs">u nastavku</a>. Ništa se ne šalje dok to ne dopustite, a privolu možete povući u Računu. Privolu bismo zatražili i prije bilo kakvih analitičkih kolačića, neobveznih marketinških poruka ili nove obrade koja bitno proširuje našu upotrebu vaših podataka. Ne provodimo analitiku, oglašavanje ni nebitno praćenje.
			</li>
			<li>
				<strong>Pravna obveza</strong> (članak 6. stavak 1. točka (c))
				— za porezne evidencije (estonski Zakon o računovodstvu,
				§12, 7 godina), odgovore na zakonite zahtjeve tijela i
				čuvanje koje zahtijevaju pravila o sprječavanju pranja
				novca, kada se primjenjuju.
			</li>
		</ul>
		<h3 id="ai-in-tafs">AI u aplikaciji tafs</h3>
		<p>Aplikacija tafs pita vas prije nego što išta ode AI-u, ovim riječima:</p>
		<ul>
			<li>tafs za Coacha i vaše tafove koristi Anthropicov AI Claude.</li>
			<li>Coach i vaši tafovi su AI agenti: ono što pišu generira AI i može biti pogrešno. Poruka koju taf pošalje izvan vašeg poduzeća navodi da ju je napisao AI agent.</li>
			<li>Što mu se šalje: ono što pišete Coachu i svojim tafovima, datoteke koje priložite, ono što vaše povezane aplikacije vrate tafu dok radi i ono što je na vašem zaslonu dok vam Coach pomaže u aplikaciji.</li>
			<li>Što se nikada ne šalje: lozinke i ključevi koje koriste vaše povezane aplikacije ni vaš otisak prsta.</li>
			<li>Anthropic to koristi za odgovor i čuva najviše 30 dana.</li>
			<li>Ništa se ne šalje dok to ne dopustite. Privolu možete povući u Računu.</li>
		</ul>
		<p>Taf koji radi dok u tom trenutku nitko nije prisutan (prema svom rasporedu ili kada nešto stigne) oslanja se na privolu osobe koja ga je izradila ili preuzela, a inače na privolu prve osobe koja upravlja tafovima računa i dopusti ga.</p>
		<p><strong>Kada povučete privolu,</strong> Coach i vaši tafovi prestaju vam odgovarati. Taf čija se pokretanja oslanjaju na vašu privolu pauzira se: njegovi se rasporedi zaustavljaju, a ono što stigne čeka. Nastavlja kada se privola ponovno da ili kada ga svojom privolom preuzme netko tko upravlja tafovima računa. Povlačenje ne mijenja ono što je ranije poslano.</p>
		<p>Anthropic je naveden na <a href="/subprocessors">/subprocessors</a> (na engleskom), zajedno s time gdje obrađuje podatke i kada ih može čuvati dulje.</p>
	</section>
}

templ privacySubprocessorsHR() {
	<section id="sub-processors">
		<h2>6. Podizvršitelji obrade</h2>
		<p>Vaše osobne podatke ne prodajemo i ne dijelimo ih za oglašavanje.</p>
		<p>
			Za pružanje usluge angažiramo mali broj dobavljača.
			Službeni, aktualni popis nalazi se na
			<a href="/subprocessors">/subprocessors</a> (na engleskom);
			ta se stranica ažurira u roku od 30 dana od svake promjene.
			Od svakog podizvršitelja obrade pisanim ugovorima
			zahtijevamo zaštitu jednakovrijednu našoj, uključujući
			standardne ugovorne klauzule EU-a kada osobni podaci
			napuštaju EU.
		</p>
		<p>
			O bitnim dodavanjima ili zamjenama podizvršitelja obrade
			koji utječu na osobne podatke aktivne klijente obavještavamo
			unaprijed, uz pravo na prigovor.
		</p>
	</section>
}

templ privacyTransfersHR() {
	<section id="transfers">
		<h2>7. Međunarodni prijenosi</h2>
		<p>
			Neki od naših podizvršitelja obrade osnovani su izvan
			Europskog gospodarskog prostora, ponajprije u Sjedinjenim
			Državama. Za svaki takav prijenos oslanjamo se na barem
			jednu od sljedećih zaštitnih mjera:
		</p>
		<ul>
			<li>
				<strong>Okvir EU-a i SAD-a za privatnost podataka</strong> —
				za podizvršitelje obrade iz SAD-a koji su certificirani
				prema tom okviru. Odluka o primjerenosti na snazi je od
				sredine 2023.; pratimo svaku promjenu njezina statusa.
			</li>
			<li>
				<strong>Standardne ugovorne klauzule</strong> —
				modul 2 (voditelj obrade – izvršitelj obrade) za naše
				izravne podizvršitelje obrade i modul 3 (izvršitelj
				obrade – podizvršitelj obrade) kada postoji lanac
				izvršitelja obrade. Koristimo klauzule koje je Komisija
				odobrila 2021.
			</li>
			<li>
				<strong>Dodatne mjere</strong> — kada procjena rizika
				pokaže da su opravdane dodatne zaštitne mjere (šifriranje
				u prijenosu i u mirovanju, bilježenje pristupa, smanjenje
				količine podataka).
			</li>
		</ul>
		<p>
			Konkretan instrument prijenosa koji se primjenjuje na
			određenog podizvršitelja obrade možete zatražiti e-poštom na
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
		<p><strong>Vaša zemlja.</strong> Zakoni nekih zemalja traže više nego što kaže ova politika. Što dodaju, na engleskom i na jeziku zemlje, nalazi se na stranici <a href="/privacy/countries">Vaša zemlja</a>.</p>
	</section>
}

templ privacyRetentionHR() {
	<section id="retention">
		<h2>8. Čuvanje</h2>
		<p>
			Osobne podatke čuvamo najkraće razdoblje koje je u skladu
			sa svrhama u koje ih obrađujemo i sa svakom primjenjivom
			pravnom obvezom.
		</p>
		<ul>
			<li>
				<strong>Metapodaci računa i prijave</strong> —
				do brisanja računa. U aplikaciji tafs vlasnik ga briše
				u Račun → <em>Izbriši
				račun</em>. Račun izrađen na webu briše se
				e-porukom na
				<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>,
				u jednomjesečnom roku iz članka 12. stavka 3. GDPR-a.
				U oba slučaja ključevi računa odmah prestaju raditi.
				Brisanje u aplikaciji tafs ne može se poništiti: razgovori,
				bilješke i veze njegovih tafova odmah se brišu, a ono što
				čuva KIFF briše se u roku od 30 dana. Pri brisanju na webu
				njegove podatke čuvamo tijekom razdoblja odgode od 30 dana,
				za slučaj da ih vlasnik želi natrag, a zatim ih brišemo.
			</li>
			<li>
				<strong>Zapisi ključeva API-ja</strong> — do brisanja
				računa, i nakon što je ključ opozvan. Ključ koji pripada
				vezi agenta putem prijave briše se zajedno s tom vezom,
				30 dana nakon što prestane.
			</li>
			<li>
				<strong>Kolačići sesije</strong> — do isteka (zadano 24
				sata) ili dok se ne odjavite.
			</li>
			<li>
				<strong>Zapisnici pristupa obrnutog proxyja</strong> — najviše 90
				dana, a zatim se objedinjuju ili brišu.
			</li>
			<li>
				<strong>Zapisnici usluga</strong> — ono što usluge KIFF-a
				i planque bilježe tijekom rada: pogreške i zahtjevi, koji
				mogu navoditi račun, osobu ili agenta. 30
				dana, a zatim se brišu.
			</li>
			<li>
				<strong>Sigurnosne kopije</strong> — KIFF-ova baza
				podataka sigurnosno se kopira svakodnevno, šifrirano, a
				svaka se kopija čuva 7 dana, pa izbrisani zapis iz njih
				nestaje u roku od 7 dana.
				Pohrane tafsa i planquea čuvaju šifrirane kopije za
				određeni trenutak 35 dana, koje se koriste samo za
				vraćanje pohrane nakon kvara, pa izbrisani zapis iz njih
				nestaje u roku od 35 dana.
			</li>
			<li>
				<strong>Revizijski podaci zakupca</strong> — čuvaju se kao
				izvršitelj obrade prema konfiguraciji zakupca klijenta.
				Zadano: čuvaju se tijekom cijelog postojanja zakupca;
				brišu se brisanjem zakupca. Pogledajte
				<a href="/security#deletion">/security#deletion</a> (na engleskom).
			</li>
			<li>
				<strong>Pozivi putem KIFF pristupnika</strong> — argumenti
				poziva dok se poziv ne pošalje, odbije ili ne uspije, a
				zatim se brišu; rezultat alata 24 sata, a zatim se briše.
				Zapis o odluci i sažetak argumenata čuvaju se kao
				revizijski podaci zakupca. Pogledajte
				<a href="/security#data-kept">/security#data-kept</a> (na engleskom).
			</li>
			<li>
				<strong>Upotreba</strong> — za svaki poziv putem
				pristupnika, kada završi: koji ga je agent uputio, alat
				i je li se brojao kao radnja ili je bio besplatan (i
				zašto). Za svako pokretanje tafa ili Coacha, kada završi:
				taf, kada, krediti koje je potrošio njegov AI i jesu li se
				brojali ili zašto nisu. Do brisanja računa; ono što se
				radi naplate prijavljuje našem pružatelju usluga plaćanja
				čuva se zajedno s evidencijama o naplati.
			</li>
			<li>
				<strong>Veze agenata putem prijave</strong> — koji
				agent, naziv aplikacije, tko ju je dopustio, kada i njezina
				posljednja upotreba: dok je veza aktivna, a zatim 30
				dana nakon što prestane (za to vrijeme ostaje navedena na
				nadzornoj ploči), a zatim se briše zajedno sa svojim
				tokenima i ključem API-ja. Sve se briše zajedno s računom.
			</li>
			<li>
				<strong>tafs</strong> — push token uređaja dok se ne
				odjavite iz aplikacije, ne uklonite uređaj ili Apple ili
				Google ne prijave da token više ne postoji. Javni ključ,
				naziv, platforma i datumi uređaja dok ga koristite; nakon
				što ga odjavite, označava se kao uklonjen i čuva do
				brisanja računa, kako bi KIFF mogao odbiti njegov zakašnjeli
				odgovor i pokazati koji je uređaj potpisao raniji. Javni
				ključ, ID i naziv pristupnog ključa čuvaju se kao podaci
				njegova uređaja. Računalo čuva svoju sesiju najviše
				90 dana ili dok se ne odjavite. Ono što tafs čuva za vaše
				poduzeće čuva se kao izvršitelj obrade: pokretanja i
				razgovori tafa, sa sažetkom razgovora (i Setupa), 30 dana,
				ono što vrate vaši alati samo do završetka pokretanja (u
				razgovoru se ono što je samo pročitao čuva šifrirano za
				njegove sljedeće poruke, koristi se dok razgovor nije sat
				vremena neaktivan i najviše četiri sata nakon čitanja, a
				zatim se automatski briše, u roku od nekoliko dana), a
				njegove bilješke u memoriji do uklanjanja
				tafa; datoteke koje isporuči 30 dana od pokretanja koje ih je izradilo, a zatim se automatski brišu u roku od jednog dana, ili ranije ako neku od njih izbriše netko s vašeg računa; token ili ključ veze u planqueu, ili prijava upravljane veze kod Composija, dok vezu ne prekinete (ako isti račun kod tog dobavljača može koristiti druga vaša veza, čuva se neiskorišten dok ne prekinete i tu), a evidencija njezinih odobrenja
				do prestanka računa; pogledajte
				<a href="/legal/dpa#annex-4">Prilog 4. DPA-u</a> (na engleskom).
			</li>
			<li>
				<strong>Evidencije o naplati</strong> — 7 godina od
				kraja poslovne godine (estonski Zakon o računovodstvu,
				§12).
			</li>
			<li>
				<strong>Kupnje u App Storeu i na Google Playu</strong> —
				ono što su nam Apple ili Google javili o svakoj kupnji
				ostaje u vašem računu do brisanja računa. Njihova izvješća
				o prodaji i isplatama, koja čuvamo kao evidencije o naplati
				7 godina, ne navode vas.
			</li>
			<li>
				<strong>Korespondencija s podrškom</strong> — 3 godine
				od posljednje interakcije, a zatim se briše.
			</li>
		</ul>
	</section>
}

templ privacyRightsHR() {
	<section id="rights">
		<h2>9. Vaša prava</h2>
		<p>
			Prema GDPR-u imate sljedeća prava u pogledu svojih osobnih
			podataka:
		</p>
		<ul>
			<li><strong>Pristup</strong> (članak 15.) — potvrda obrađujemo li vaše podatke i njihova kopija.</li>
			<li><strong>Ispravak</strong> (članak 16.) — ispravak netočnih ili nepotpunih podataka.</li>
			<li><strong>Brisanje</strong> (članak 17.) — brisanje vaših podataka, uz iznimke zakonskog čuvanja.</li>
			<li><strong>Ograničenje</strong> (članak 18.) — zaustavljanje obrade dok se spor ne riješi.</li>
			<li><strong>Prenosivost</strong> (članak 20.) — strojno čitljiv izvoz podataka koje ste pružili.</li>
			<li><strong>Prigovor</strong> (članak 21.) — na obradu na temelju legitimnih interesa; prestajemo, osim ako ne dokažemo uvjerljive razloge koji prevladavaju.</li>
			<li><strong>Povlačenje privole</strong> (članak 7. stavak 3.) — za svaku obradu koja se temelji na privoli, kao što je AI u aplikaciji tafs (u Računu, kako je navedeno <a href="#ai-in-tafs">gore</a>). Povlačenje ne utječe na prethodnu zakonitu obradu.</li>
		</ul>
		<p>
			Bilo koje od tih prava ostvarujete e-porukom na
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
			Odgovaramo u roku od jednog mjeseca prema članku 12.
			stavku 3.; za složene zahtjeve rok možemo produljiti za
			najviše dva dodatna mjeseca i o tome ćemo vas obavijestiti.
		</p>
		<h3 id="export-chats">Vaši vlastiti razgovori u tafsu</h3>
		<p>
			U aplikaciji tafs, Račun →  Izvezi moje razgovore
			preuzima vaše vlastite razgovore sa svakim tafom,
			uključujući one s Coachem, nazive datoteka koje ste
			priložili i vaše vlastite bilješke, kao čitljivu datoteku i
			kao JSON. Izvesti ih možete samo vi: administrator ili
			vlasnik računa to ne može, a KIFF-ov izvoz računa ih ne
			uključuje.
		</p>
		<h3 id="delete-account">Brisanje vašeg tafs računa</h3>
		<p>
			tafs je KIFF-ova aplikacija. Za brisanje tafs računa i
			njegovih podataka:
		</p>
		<ol>
			<li>Otvorite aplikaciju tafs i prijavite se.</li>
			<li>Idite na Račun, a zatim dodirnite <em>Izbriši račun</em>.</li>
			<li>Potvrdite. Brisanje računa ne može se poništiti.</li>
		</ol>
		<p>
			<em>Izbriši račun</em> prikazuje se onome tko smije
			izbrisati račun poduzeća, obično njegovu vlasniku. Ako ga ne
			vidite ili više nemate aplikaciju, pišite na
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			s adrese kojom se prijavljujete i vaše ćemo podatke
			izbrisati u roku od jednog mjeseca.
		</p>
		<p>
			Što se briše: ključevi računa odmah prestaju raditi.
			Njegovi tafovi, razgovori, bilješke, priložene datoteke i
			veze odmah se brišu, a iz njihovih kopija za određeni
			trenutak u roku od 35 dana. Ono što KIFF čuva za račun
			briše se u roku od 30 dana, a iz sigurnosnih kopija u roku
			od 7 dana nakon toga. Zapisnici usluga koji navode račun
			nestaju u roku od 30 dana. Revizijski podaci zakupca brišu
			se zajedno sa zakupcem. Za svaku vrstu podataka pogledajte <a href="#retention">Čuvanje</a>.
		</p>
		<p id="delete-data">
			Za brisanje dijela podataka uz zadržavanje računa: u
			aplikaciji izbrišite razgovor, i njegove poruke i
			priložene datoteke nestaju s njim; uklonite taf, i njegovi
			razgovori, bilješke i veze nestaju s njim. Za sve ostalo
			pišite na
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			i navedite što treba izbrisati. To činimo u roku od jednog mjeseca.
		</p>
		<p>
			Imate pravo podnijeti pritužbu
			nadzornom tijelu. Naše vodeće nadzorno tijelo
			je
			<a href="https://www.aki.ee/en" target="_blank" rel="noopener">Estonski inspektorat za zaštitu podataka (Andmekaitse Inspektsioon)</a>.
			Pritužbu možete podnijeti i nadzornom tijelu države
			članice u kojoj boravite.
		</p>
		<p><strong>Vaša zemlja.</strong> Zakoni nekih zemalja traže više nego što kaže ova politika. Što dodaju, na engleskom i na jeziku zemlje, nalazi se na stranici <a href="/privacy/countries">Vaša zemlja</a>.</p>
	</section>
}

templ privacyCookiesHR() {
	<section id="cookies">
		<h2>10. Kolačići</h2>
		<p>
			Postavljamo tri kolačića, sve nužne, vlastite, koji se
			šalju samo putem HTTPS-a i koje skripte na stranici ne mogu
			čitati. Prema pravilima EU-a o e-privatnosti za njih nije
			potrebna privola; navodimo ih kako biste znali da postoje.
			Pojedinosti sadrži
			<a href="/cookies">politika kolačića</a> (na engleskom).
		</p>
		<ul>
			<li>
				<strong><code>kiff_session</code></strong> — održava vas
				prijavljenima. Potpisani kolačić sesije koji nosi ID vaše
				prijave, adresu e-pošte i ime te vjerodajnicu koju
				nadzorna ploča koristi za vas. Postavljen za <code>.kiff.dev</code>.
				Traje 24 sata ili dok se ne odjavite.
			</li>
			<li>
				<strong><code>kiff_flash</code></strong> — prenosi
				jednokratnu poruku na sljedeću stranicu, primjerice „vaš
				ključ je izrađen”. Potpisan; novi ključ nikada nije u
				njemu. Postavljen za <code>.kiff.dev</code>. Briše se kada
				ga sljedeća stranica pročita, a najkasnije nakon 5 minuta.
			</li>
			<li>
				<strong><code>kiff_cb_attempts</code></strong> — broji
				koliko se puta stranica za prijavu ponovno učitala, kako bi
				se prijava koja se vrti u krug zaustavila. Šalje se samo
				toj stranici. Traje 5
				minuta i briše se kada prijava započne ili uspije.
			</li>
		</ul>
		<p>
			Ne koristimo analitičke kolačiće, oglašivačke kolačiće ni
			alate trećih strana za praćenje. Ako ih ikada dodamo,
			prije postavljanja kolačića prikazat ćemo traku za privolu,
			u skladu s pravilima o e-privatnosti i smjernicama EDPB-a
			iz 2023. o tehnologijama praćenja.
		</p>
		<p>
			Ako se prijavljujete putem Clerka (našeg podizvršitelja
			obrade za autentifikaciju), Clerk postavlja kolačiće i na
			vlastitoj frontend domeni (<code>clerk.kiff.dev</code>).
			Ti su kolačići potrebni kako bi vas Clerk prepoznao tijekom
			svog postupka prijave, a na njih se primjenjuju politika
			privatnosti Clerka i naša. Pojedinosti potražite na popisu
			podizvršitelja obrade.
		</p>
	</section>
}

templ privacySecurityHR() {
	<section id="security">
		<h2>11. Sigurnost</h2>
		<p>
			Naše tehničke i organizacijske sigurnosne mjere opisane su
			na <a href="/security">/security</a> (na engleskom). One
			uključuju izolaciju zakupaca na razini baze podataka,
			TLS 1.2+ u prijenosu, šifriranje u mirovanju putem zadanih
			postavki upravljanog pružatelja i kontrolu pristupa prema
			načelu najmanjih ovlasti.
		</p>
		<p>
			O povredi osobnih podataka pogođene klijente obavještavamo
			bez nepotrebnog odgađanja i u roku od 72 sata od potvrde,
			u skladu s člankom 33. GDPR-a. Obavijest sadrži prirodu
			povrede, kategorije i približan broj dotičnih ispitanika i
			zapisa, vjerojatne posljedice te poduzete ili predložene
			mjere.
		</p>
	</section>
}

templ privacyChildrenHR() {
	<section id="children">
		<h2>12. Djeca</h2>
		<p>
			KIFF Cloud je proizvod razvojne infrastrukture koji nije
			namijenjen djeci. Svjesno ne prikupljamo osobne podatke
			djece mlađe od 16 godina. Ako smatrate da nam je dijete
			dalo osobne podatke, obratite se na
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			i izbrisat ćemo ih.
		</p>
	</section>
}

templ privacyAutomatedHR() {
	<section id="automated">
		<h2>13. Automatizirano donošenje odluka</h2>
		<p>
			Izvršno okruženje KIFF Clouda donosi determinističke odluke
			prema pravilima o podacima koje šalju naši klijenti. To nisu
			odluke o vama koje proizvode pravne ili slično značajne
			učinke u smislu članka 22. GDPR-a; to su odluke o radnjama
			klijenta (povrati novca, narudžbe, poruke i slično)
			izvršene prema vlastitim pravilima klijenta.
		</p>
		<p>
			Klijenti koji KIFF Cloud koriste za donošenje odluka koje
			utječu na njihove vlastite krajnje korisnike sami su
			odgovorni za usklađenost s člankom 22. Naše potvrde
			o upravljanju osmišljene su tako da tim klijentima pruže
			revizijski trag koji im je potreban za dokazivanje ljudskog
			nadzora, ali pravna obveza osiguravanja tog nadzora je na
			klijentu.
		</p>
	</section>
}

templ privacyChangesHR() {
	<section id="changes">
		<h2>14. Izmjene ove politike</h2>
		<p>
			Ovu politiku možemo povremeno ažurirati. O bitnim
			izmjenama aktivne klijente obavještavamo e-poštom i
			istaknutim natpisom na ovoj stranici najmanje 30 dana.
			Nebitne izmjene objavljuju se s novim datumom
			„posljednjeg ažuriranja”.
		</p>
	</section>
}

