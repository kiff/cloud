package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// PrivacyTA is KIFF's privacy policy (/privacy) in Tamil, at /ta/privacy.
// It is a translation of Privacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Tamil has the legal
// texts only, so a link to any other page goes to English and says so.
templ PrivacyTA() {
	@components.LayoutSite("KIFF — privacy policy", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@privacyHeadTA()
			@privacyWhoWeAreTA()
			@privacyScopeTA()
			@privacyRolesTA()
			@privacyCategoriesTA()
			@privacyLawfulBasesTA()
			@privacySubprocessorsTA()
			@privacyTransfersTA()
			@privacyRetentionTA()
			@privacyRightsTA()
			@privacyCookiesTA()
			@privacySecurityTA()
			@privacyChildrenTA()
			@privacyAutomatedTA()
			@privacyChangesTA()
			@privacyContactTA()
		</article>
	}
}

templ privacyHeadTA() {
	<header class="legal-head">
		<p class="legal-badge">தனியுரிமைக் கொள்கை · v0.1</p>
		<h1>தனியுரிமைக் கொள்கை</h1>
		<p class="legal-meta">
			<strong>கடைசியாகப் புதுப்பிக்கப்பட்டது:</strong> 24 நவம்பர் 2026. <strong>நடைமுறைக்கு வரும் தேதி:</strong> 24 மே 2026.
		</p>
		<p class="legal-disclaimer">
			இணையதளம், கட்டுப்பாட்டுப் பலகை, API மற்றும் iPhone, iPad, Android மற்றும் கணினிகளுக்கான tafs செயலி முழுவதும் KIFF Cloud தனிப்பட்ட தரவை எவ்வாறு செயலாக்குகிறது என்பதை இந்தக் கொள்கை விளக்குகிறது. கேள்விகள்: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</header>
}

templ privacyWhoWeAreTA() {
	<section id="who-we-are">
		<h2>1. நாங்கள் யார்</h2>
		<p>
			KIFF Cloud ஐ எஸ்தோனியாவில் இணைக்கப்பட்ட தனியார் வரையறுக்கப்பட்ட நிறுவனமான <strong>Kiff Agents OÜ</strong> இயக்குகிறது. பதிவுத் தகவல்:
		</p>
		<ul>
			<li><strong>பதிவுக் குறியீடு:</strong> 17372313 (எஸ்தோனிய மின்-வணிகப் பதிவகம்)</li>
			<li><strong>VAT எண்:</strong> EE102924327</li>
			<li><strong>பதிவு செய்யப்பட்ட முகவரி:</strong> Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, எஸ்தோனியா</li>
			<li><strong>தனியுரிமைத் தொடர்பு:</strong> <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a></li>
			<li><strong>முறையான சட்ட அறிவிப்புகள்:</strong> <a href="mailto:legal@kiff.dev">legal@kiff.dev</a></li>
		</ul>
		<p>
			Kiff Agents OÜ ஐரோப்பிய ஒன்றியத்தில் நிறுவப்பட்டுள்ளதால், EU பொது தரவுப் பாதுகாப்பு ஒழுங்குமுறை (<abbr title="General Data Protection Regulation">GDPR</abbr>) எங்கள் செயலாக்கத்துக்கு இயல்பாகவே பொருந்தும். எங்களுக்கு கட்டுரை 27 இன் கீழ் EU பிரதிநிதி தேவையில்லை.
		</p>
	</section>
}

templ privacyScopeTA() {
	<section id="scope">
		<h2>2. இந்தக் கொள்கையின் நோக்கம்</h2>
		<p>
			நீங்கள் பின்வருவனவற்றுடன் தொடர்புகொள்ளும்போது நாங்கள் செயலாக்கும் தனிப்பட்ட தரவை இந்தக் கொள்கை உள்ளடக்குகிறது:
		</p>
		<ul>
			<li><a href="https://kiff.dev"><code>kiff.dev</code></a> — எங்கள் சந்தைப்படுத்தல் தளம், இந்தக் கொள்கைப் பக்கம், மற்றும் ரசீதுகளைக் காட்டும் பொது மேற்பரப்பு.</li>
			<li><a href="https://app.kiff.dev"><code>app.kiff.dev</code></a> — உள்நுழைவு தேவைப்படும் எங்கள் கட்டுப்பாட்டுப் பலகை.</li>
			<li><a href="https://api.kiff.dev"><code>api.kiff.dev</code></a> — எங்கள் HTTP API.</li>
			<li id="tafs"><strong>tafs</strong> — iPhone, iPad, Android மற்றும் கணினிகளுக்கான (Mac, Windows மற்றும் Linux) எங்கள் செயலி, மற்றும் அதன் பின்னணிச் சேவை (நிறுவனத்தின் கருவிகளை இணைக்கும் Setup மற்றும் அந்த இணைப்புகளை வைத்திருக்கும் planque உட்பட), இதில் நிறுவனம் KIFF Cards க்குள் வேலை செய்யும் AI முகவரிடம் ஒரு வேலையை ஒப்படைக்கிறது.</li>
		</ul>
		<p>
			இந்தக் கொள்கை நீங்களே இயக்கக்கூடிய திறந்த மூல <code>kiff/kiff</code> சட்டகத்தை <em>உள்ளடக்காது</em>. நீங்கள் சட்டகத்தை உங்கள் சொந்த உள்கட்டமைப்பில் இயக்கும்போது, அது செயலாக்கும் எந்தத் தரவுக்கும் நீங்களே கட்டுப்படுத்தி, அந்தச் செயலாக்கத்தில் Kiff Agents OÜ க்குத் தொடர்பு இல்லை.
		</p>
	</section>
}

templ privacyRolesTA() {
	<section id="roles">
		<h2>3. GDPR இன் கீழ் எங்கள் பங்குகள்</h2>
		<p>
			தரவைப் பொறுத்து நாங்கள் இரண்டு தகுதிகளில் செயல்படுகிறோம்:
		</p>
		<ul>
			<li>
				<strong>கட்டுப்படுத்தி</strong> — கணக்கு மற்றும் உள்நுழைவு மெட்டாடேட்டா, பில்லிங் தரவு (பில்லிங் செயலில் இருக்கும்போது), நீங்கள் தேர்ந்தெடுக்கும் சந்தைப்படுத்தல் தொடர்புகள், மற்றும் எங்கள் சொந்தச் சேவையின் செயல்பாட்டுத் தொலைமானி ஆகியவற்றுக்கு.
			</li>
			<li>
				<strong>செயலாக்குபவர்</strong> — எங்கள் வாடிக்கையாளர்களின் சார்பாக runtime வழியாகப் பாயும் தணிக்கைத் தரவு, செயல் பதிவுகள், முடிவு ரசீதுகள் மற்றும் பிற உள்ளடக்கத்துக்கு, மற்றும் tafs அவர்களுக்காக வைத்திருப்பதற்கு (ஒவ்வொரு taf இன் ஓட்டங்கள், உரையாடல்கள், அறிக்கைகள், நினைவுக் குறிப்புகள் மற்றும் அவை வழங்கும் கோப்புகள்). வாடிக்கையாளர்கள் (tenants) அந்தத் தரவின் கட்டுப்படுத்திகள்; அவர்கள் தங்கள் கணக்கு அமைப்புகள் மற்றும் டொமைன் கட்டமைப்பு வழியாக எங்களுக்கு அறிவுறுத்துகிறார்கள். தரவுச் செயலாக்க ஒப்பந்தம் (<abbr title="Data Processing Agreement">DPA</abbr>) அந்த உறவை நிர்வகிக்கிறது; வெளியிடப்பட்ட விதிமுறைகளுக்கு <a href="/legal/dpa">DPA வார்ப்புருவைப்</a> (ஆங்கிலத்தில்) பாருங்கள்.
			</li>
		</ul>
		<p>
			இந்தக் கொள்கை முதன்மையாக எங்கள் கட்டுப்படுத்தி-தரப்புச் செயலாக்கத்தைக் குறிப்பிடுகிறது. செயலாக்குபவர்-தரப்புத் தரவைப் பற்றி நாங்கள் குறிப்பிடும் இடத்தில், DPA மிகவும் குறிப்பிட்ட ஆவணம்.
		</p>
	</section>
}

templ privacyCategoriesTA() {
	<section id="categories">
		<h2>4. நாங்கள் செயலாக்கும் தனிப்பட்ட தரவு வகைகள்</h2>
		<p>
			கீழுள்ள வகைகள் <a href="/security#data-we-process">/security#data-we-process</a> (ஆங்கிலத்தில்) இல் உள்ள தொழில்நுட்பப் பட்டியலுடன் ஒத்துப்போகின்றன. இரண்டும் மாறுபடும் இடத்தில், தொழில்நுட்பப் பக்கமே உண்மையின் ஆதாரம், இந்தப் பிரிவை அதற்கேற்பப் புதுப்பிக்கிறோம்.
		</p>
		<ul>
			<li>
				<strong>கணக்கு அடையாளங்காட்டிகள்</strong> — உங்கள் மேல்நிலை அங்கீகாரப் பொருள் (எங்கள் அடையாள வழங்குநரால் வழங்கப்பட்டது) மற்றும் நீங்கள் உள்நுழையும் மின்னஞ்சல் முகவரி. இன்று அப்படியே சேமிக்கப்படுகிறது; சேமிப்பில் ஹாஷ் செய்வது திட்டமிடப்பட்டுள்ளது.
				மின்னஞ்சலில் அனுப்பப்படும் குறியீட்டுடன் உள்நுழைவை நீங்கள் இயக்கினால் (நீங்கள் இயக்காவிட்டால் அது அணைந்தே இருக்கும்), KIFF அந்த அமைப்பை உங்கள் உள்நுழைவு அடையாளம் மற்றும் மாற்றிய தேதியுடன் வைத்திருக்கும். நாங்கள் உங்களுக்கு மின்னஞ்சலில் அனுப்பும் குறியீடு பயன்படுத்தப்படும் வரை அல்லது பத்து நிமிடம் கடக்கும் வரை, திறவுகோலுடன் கூடிய ஹேஷ் ஆக மட்டுமே வைக்கப்படும். தவறான பயன்பாட்டைக் குறைக்க, கேட்ட முகவரி மற்றும் ஐபி முகவரியின் திறவுகோலுடன் கூடிய ஹேஷுக்கு ஒரு கோரிக்கை எண்ணிக்கையை அதிகபட்சம் ஒரு நாள் வைத்திருக்கிறோம். குறியீட்டுடன் உள்நுழைந்த பிறகு, சமீபத்திய உள்நுழைவு தேவைப்படும் மாற்றங்கள் வேறு வழியில் உள்நுழையச் சொல்ல, அதை கால் மணி நேரம் குறித்து வைக்கிறோம்.
			</li>
			<li>
				<strong>Tenant மெட்டாடேட்டா</strong> — tenant id, slug, காட்சிப் பெயர், உருவாக்கிய நேரமுத்திரை, மற்றும் ஒவ்வொருவரின் செயலி கடைசியாகப் பயன்படுத்திய மொழி, இதனால் KIFF அவர்களுக்கு அனுப்பும் மின்னஞ்சல்கள் அந்த மொழியில் வரும்.
			</li>
			<li>
				<strong>API நற்சான்றுகள்</strong> — ஒளிபுகா API விசைப் பதிவுகள் (நாங்கள் ஹாஷ்களைச் சேமிக்கிறோம், ஒருபோதும் எளிய உரையை அல்ல).
			</li>
			<li>
				<strong>அமர்வுக் குக்கி தரவு</strong> — உள்நுழைவுக்குப் பிறகு அமைக்கப்படும் HMAC-கையொப்பமிட்ட அமர்வுக் குக்கி. கீழே குக்கிப் பிரிவைப் பாருங்கள்.
			</li>
			<li>
				<strong>HTTP கோரிக்கை மெட்டாடேட்டா</strong> — IP முகவரி, user agent, கோரிக்கைப் பாதை, பதில் நிலை, தாமதம். பாதுகாப்பு மற்றும் தவறான பயன்பாடு தடுப்புக்காக வரையறுக்கப்பட்ட தக்கவைப்புக் காலத்துக்கு எங்கள் reverse proxy இன் அணுகல் பதிவுகளில் வைக்கப்படுகிறது.
			</li>
			<li>
				<strong>Tenant கட்டுப்படுத்தும் உள்ளடக்கம்</strong> — நீங்கள் runtime க்கு அனுப்பும் <code>parameters</code>, <code>actor</code> மற்றும் <code>entity</code> தரவு. இதை நாங்கள் வாடிக்கையாளரின் சார்பாக <em>செயலாக்குபவராக</em> வைத்திருக்கிறோம்; கம்பிக்குச் செல்வதற்கு வாடிக்கையாளர் பொறுப்பு. டொமைன் வாரியான மறைத்தல் கட்டமைப்பு திட்டமிடப்பட்டுள்ளது.
			</li>
			<li>
				<strong>தொடர்புகள்</strong> — நீங்கள் எங்கள் ஆதரவு, விற்பனை, பாதுகாப்பு அல்லது தனியுரிமை அஞ்சல் பெட்டிகளுக்கு அனுப்பும் மின்னஞ்சல்கள்.
			</li>
			<li>
				<strong>tafs செயலி</strong> — நீங்கள் உங்கள் KIFF கணக்கு மூலம் tafs இல் உள்நுழைகிறீர்கள். தொலைபேசி அல்லது டேப்லெட்டில் செயலி உங்கள் அமர்வை சாதனத்தின் Keychain இல் (Android இல், அதன் குறியாக்கப்பட்ட சேமிப்பகத்தில்) வைத்திருக்கிறது. கணினியில் அது உங்கள் பயனர் கணக்குக்காக முத்திரையிடப்பட்டு வைக்கப்படுகிறது: Windows கணினியில் Windows இன் சொந்தத் தரவுப் பாதுகாப்புடன், Linux இல் உங்கள் keyring இல், Mac இல் அதன் Keychain இல். கணினியின் அமர்வு 90 நாட்கள் வரை நீடிக்கும். செயலி சாதனத்தை விட்டு ஒருபோதும் வெளியேறாத கையொப்ப விசையை உருவாக்குகிறது: iPhone, iPad அல்லது Mac இன் Secure Enclave இல், Android சாதனத்தின் Keystore இல், அல்லது Windows கணினியின் TPM இல். Linux இல், மற்றும் Secure Enclave இல்லாத Mac இல், விசை உங்கள் keyring அல்லது Keychain இல் வைக்கப்பட்ட மென்பொருள் விசை, அந்தக் கணினி உங்களுக்காகக் காத்திருப்பதைக் காட்டலாம் ஆனால் அங்கீகரிக்க முடியாது; நீங்கள் உங்கள் தொலைபேசியில் அங்கீகரிக்கிறீர்கள்{ macSecurityKey("ta") }. TPM இல்லாத Windows கணினியால் tafs இல் உள்நுழைய முடியாது. KIFF விசையின் பொதுப் பாதி, சாதனத்தின் பெயர் மற்றும் தளம், அது சேர்க்கப்பட்ட மற்றும் கடைசியாகப் பயன்படுத்தப்பட்ட நேரத்தை வைத்திருக்கிறது, இதனால் நிறுத்திவைக்கப்பட்ட அழைப்புகளுக்கான உங்கள் பதில்களையும் இணைப்புகளுக்கான உங்கள் ஒப்புதல்களையும் அது சரிபார்க்க முடியும். உங்கள் கணினியில் Windows Hello அல்லது பாதுகாப்பு விசை போன்ற passkey மூலம் நீங்கள் அங்கீகரிக்கும்போது, உங்கள் முகம், கைரேகை அல்லது PIN கணினியின் சொந்த அமைப்பிலேயே இருக்கும். KIFF passkey இன் பொது விசை, அதன் id, ஒரு கவுண்டர் மற்றும் ஒரு பெயரை வைத்திருக்கிறது, ஒருபோதும் ரகசியம் எதுவும் அல்ல, மற்றும் பிற சாதனங்களுடன் ஒத்திசைக்கும் passkey ஐ மறுக்கிறது. தொலைபேசி, டேப்லெட் அல்லது iPad செயலியை இயக்கும் Mac இல், நீங்கள் அவற்றை இயக்கும்போது, சாதனத்தின் push token ஐ உங்கள் KIFF நபர் id மற்றும் செயலி காட்டிய மொழியுடன் நாங்கள் வைத்திருக்கிறோம். எச்சரிக்கை Apple அல்லது Google வழியாகச் செல்லும்போது எந்த taf என்பதும் அது என்ன கேட்கிறது என்பதும் மட்டுமே இருக்கும், மற்றும் வாசல் எச்சரிக்கையில் எழுதியவரின் பெயர் அல்லது மின்னஞ்சல் முகவரி: ஒருபோதும் தொகை அல்லது கோரிக்கையின் விவரங்கள் அல்ல. செயலி அவற்றைச் சாதனத்திலேயே, KIFF இலிருந்து சேர்க்கிறது, எனவே திறக்கப்பட்ட தொலைபேசியின் எச்சரிக்கை தொகை, வணிகர் அல்லது நபரைக் காட்டலாம். பூட்டப்பட்ட Android தொலைபேசியில் அது "ஒரு taf க்கு நீங்கள் தேவை" என்பதை மட்டுமே காட்டுகிறது, பூட்டப்பட்ட iPhone இலும் அப்படியே, நீங்கள் அதன் முன்னோட்டங்களை எப்போதும் காட்ட அமைத்திருந்தால் தவிர. Windows கணினி, Linux கணினி அல்லது macOS 12 செயலி கொண்ட Mac இல், எச்சரிக்கைகளைச் செயலி இயங்கும்போது செயலியே உருவாக்குகிறது, push token இல்லாமல் மற்றும் வேறு எந்த நிறுவனமும் இல்லாமல். Windows மற்றும் Linux இல் அவை எந்த taf, அது என்ன செய்ய விரும்புகிறது, தொகை, ஏன் மற்றும் எப்போது வரை என்பதைக் காட்டுகின்றன; macOS 12 செயலியில் நீங்கள் அவற்றை இயக்கியதும் அழைப்புக்கான KIFF இன் வார்த்தைகளைக் காட்டுகின்றன, பூட்டப்பட்ட திரை Mac இன் முன்னோட்ட அமைப்பு அனுமதிப்பதைக் காட்டுகிறது. Windows இல் நீங்கள் இயக்கும் வரை அவை அணைந்திருக்கும், திரை பூட்டப்பட்டிருக்கும்போது "ஒரு taf க்கு நீங்கள் தேவை" என்பதை மட்டுமே காட்டும். திரை பூட்டப்படுவதற்கு முன் காட்டப்பட்ட ஒன்று அதன் விவரங்களை Windows இன் அறிவிப்புப் பட்டியலில் வைத்திருக்கும். Linux இல் நீங்கள் அணைக்கும் வரை அவை இயங்கும், பூட்டப்பட்ட திரை காட்டுவது உங்கள் டெஸ்க்டாப்பைப் பொறுத்தது. tafs சேவை கணக்கின் மொழியை, கடைசியாக Coach உடன் உரையாடியவரிடமிருந்து, மூன்று மாதங்கள் வரை வைத்திருக்கிறது, இதனால் taf இன் அறிக்கைகள் அந்த மொழியில் வரும். <strong>உங்கள் கடிகாரம்:</strong> கடிகாரம் கடவுச்சொல்லையோ விசையையோ வைத்திருப்பதில்லை, இணைக்கப்பட்ட உங்கள் தொலைபேசியுடன் மட்டுமே பேசுகிறது, ஒருபோதும் அங்கீகரிப்பதில்லை. நீங்கள் AI ஐ அனுமதித்த பிறகு, நீங்கள் Coach இடம் அல்லது நீங்கள் தேர்ந்தெடுத்த taf இடம் சொல்வதை அது உரையாக மட்டுமே, தொலைபேசி வழியாக அனுப்புகிறது. கடிகாரத்தின் சொந்தப் பேச்சுச் சேவை, Apple இன் அல்லது Google இன், உங்கள் வார்த்தைகளை அந்த உரையாக மாற்றுகிறது. Wear OS இல், நீங்கள் பேசி முடிப்பதற்குள் அது நின்றுவிட்டால், உங்கள் தொலைபேசியின் சொந்த அங்கீகாரி அதைத் தொலைபேசியிலேயே செய்கிறது. அது திரைப் பூட்டு அல்லது கடவுக்குறியீடு இருந்து திறக்கப்பட்டிருக்கும்போது மட்டுமே மறுக்கலாம், நிறுத்தலாம் அல்லது Coach அல்லது taf க்கு அனுப்பலாம். நீங்கள் ஒரு taf க்கு அனுப்புவது நீங்கள் தொலைபேசியில் எழுதியது போல அந்த taf இன் சொந்த உரையாடலுக்குள் செல்கிறது. taf இன் உரையாடல், தொகைகள் உட்பட, ஒவ்வொரு முறை திறக்கும்போதும் தொலைபேசி வழியாகப் படிக்கப்படுகிறது, கடிகாரம் கீழே அதன் சொந்தப் பகுதி விவரிக்கும் சமீபத்திய செய்திகளை மட்டுமே வைத்திருக்கும். செயலிகள் மூடியிருக்கும்போது, உங்கள் தொலைபேசி புதிய பதில்களையும் செய்திகளையும் அமைப்பின் சொந்தத் தொலைபேசி-கடிகார இணைப்பின் வழியாகக் கடிகாரத்துக்கு அனுப்புகிறது (Apple Watch இல் Apple இன், Wear OS இல் Google Play சேவைகளின்), அது கடிகாரம் அவற்றைப் பெறும் வரை மட்டுமே தொலைபேசியிலும் கடிகாரத்திலும் வைத்திருக்கும்; உங்கள் தொலைபேசியை எழுப்பும் அறிவிப்பில் எந்தச் சொற்களும் இல்லை. <strong>Apple Watch:</strong> அது உங்கள் taf களையும் அவற்றின் பக்கங்களையும் வைத்திருக்காமல் காட்டுகிறது. அது உங்கள் Inbox ஐ வைத்திருக்கிறது, பூட்டப்பட்டிருக்கும்போது அதனால் படிக்க முடியாத கோப்பில்: நிறுத்திவைக்கப்பட்ட ஒவ்வொரு அழைப்பும் அதன் taf இன் பெயர் மற்றும் அது கேட்பதாக, ஒருபோதும் தொகையாக அல்ல, மற்றும் நீங்கள் கடிகாரத்திலிருந்து அனுப்பியவற்றுக்கு Coach இன் பதில்கள், உரையாக. நீங்கள் கடிகாரத்தில் வெளியேறினால், நீங்கள் மீண்டும் கடிகாரத்தில் உள்நுழையும் வரை நீங்கள் வெளியேறினீர்கள் என்பதையும் அது வைத்திருக்கிறது. அதைத் தவிர, கடிகாரத்துக்குக் கடவுக்குறியீடு இல்லையென்றால் அது எதையும் வைத்திருப்பதில்லை. நீங்கள் கடிகாரத்தில் வெளியேறும்போது அல்லது உங்கள் iPhone வெளியேறும்போது, அல்லது கடவுக்குறியீடு இல்லாமல் செயலி அடுத்த முறை திறக்கும் அல்லது மூடும்போது Inbox நீங்கும். அது எந்தப் பதிவும் செய்வதில்லை, அது காட்டும் ஒரே அறிவிப்புகள் உங்கள் iPhone இன் அறிவிப்புகளே. உரையாடல் உடனே திறக்க, அதில் நீங்கள் திறந்த அதிகபட்சம் 20 உரையாடல்களில் ஒவ்வொன்றின் கடைசி 30 செய்திகளையும், Coach இன் மற்றும் உங்கள் tafs இன், உரையாக மட்டும், ஒருபோதும் தொகை இல்லாமல், Inbox போலவே பூட்டி வைத்திருக்கும்; Inbox நீங்கும்போதும், ஓர் உரையாடல் 30 நாட்கள் திறக்கப்படாதபோதும் அவை நீக்கப்படும். <strong>Wear OS:</strong> அது உங்கள் கணக்கின் மின்னஞ்சலையும் இன்றைய நாட்காட்டியையும் வைத்திருக்காமல் காட்டுகிறது. உடனே திறக்கும்படி, அது உங்களுக்காகக் காத்திருப்பவற்றின் எண்ணிக்கையையும், ஒவ்வொரு taf இன் பெயரையும் அது நிறுத்தப்பட்டதா அல்லது இடைநிறுத்தப்பட்டதா என்பதையும் குறியாக்கப்பட்டு வைத்திருக்கிறது: ஒருபோதும் தொகை, நிறுத்திவைக்கப்பட்ட அழைப்பின் விவரங்கள் அல்லது taf இன் உரையாடல் அல்ல. நீங்கள் வெளியேறும்போது, கடிகாரம் பூட்டப்படும்போது அல்லது மணிக்கட்டிலிருந்து கழற்றப்படும்போது, 24 மணி நேரத்துக்குப் பிறகு அது அழிக்கப்படுகிறது. அது உங்கள் Inbox ஐ வைத்திருக்கிறது, அதில் ஒவ்வொரு வரியும் taf இன் பெயர் மற்றும் அது சொல்வது, ஒருபோதும் தொகை அல்ல, மற்றும் பிறகு அனுப்ப வைக்கப்பட்ட ஒரு செய்தி, உரையாக. கடிகாரத்திலோ தொலைபேசியிலோ வெளியேறுவது அனைத்தையும் அழிக்கும். அதன் டைலுக்காக, அது உங்களுக்காகக் காத்திருப்பவற்றின் எண்ணிக்கையையும் வைத்திருக்கிறது, கடிகாரம் திறக்கப்பட்டிருக்கும்போது மட்டுமே காட்டப்படும், நீங்கள் வெளியேறும்போது, அல்லது கடிகாரம் பூட்டப்பட்டிருக்கும்போது அல்லது திரைப் பூட்டு இல்லாதபோது டைல் அடுத்த முறை தோன்றும்போது அழிக்கப்படும். நீங்கள் கடிகாரத்தில் வெளியேறிய பிறகு, நீங்கள் மீண்டும் உள்நுழையும் வரை நீங்கள் வெளியேறினீர்கள் என்ற குறிப்பை அது வைத்திருக்கிறது. கடிகாரம் பூட்டப்பட்டிருக்கும்போது அல்லது திரைப் பூட்டு இல்லாதபோது செயலி அடுத்த முறை திறக்கும் அல்லது மூடும்போதும் Inbox நீங்கும். பிறகு அனுப்ப வைக்கப்பட்ட செய்தி நீங்கள் அனுப்பும் அல்லது நீக்கும் வரை இருக்கும், ஏனெனில் நீங்கள் அதை அனுப்பும்படி கேட்டீர்கள். நீங்கள் பேசி முடிப்பதற்குள் கடிகாரத்தின் பேச்சுச் சேவை நின்றுவிட்டால், கடிகாரம் பதிவை உங்கள் தொலைபேசிக்கு அனுப்புகிறது, அது அதைத் தொலைபேசியிலேயே உரையாக மாற்றுகிறது, ஒருபோதும் சேவையகத்தில் அல்ல. உரை திரும்பி வந்ததும் அல்லது நீங்கள் ரத்து செய்ததும், அதிகபட்சம் 2 நிமிடங்களுக்குப் பிறகு, பதிவு இரண்டிலும் நீக்கப்படுகிறது. உரை மட்டுமே Coach அல்லது உங்கள் taf க்குச் செல்கிறது. ஒரு taf இன் முடிவு, நீங்கள் அதை நிராகரிக்கும் அல்லது கடிகாரத்தில் வெளியேறும் வரை கடிகாரத்தின் அறிவிப்புகளில் இருக்கலாம். உரையாடல் உடனே திறக்க, அதில் நீங்கள் திறந்த அதிகபட்சம் 20 உரையாடல்களில் ஒவ்வொன்றின் கடைசி 30 செய்திகளையும், Coach இன் மற்றும் உங்கள் tafs இன், உரையாக மட்டும், ஒருபோதும் தொகை இல்லாமல், மறையாக்கி வைத்திருக்கும்; நீங்கள் கடிகாரத்திலோ தொலைபேசியிலோ வெளியேறும்போதும், ஓர் உரையாடல் 30 நாட்கள் திறக்கப்படாதபோதும் அவை நீக்கப்படும், திரைப் பூட்டு இல்லாத கடிகாரம் எதையும் வைத்திருக்காது. நீங்கள் ஒரு கருவியை இணைக்கும்போது, கருவியின் சொந்த வழங்குநரிடம் உள்நுழைகிறீர்கள். Stripe போல planque தானே உள்நுழையும் செயலிக்கு, அல்லது நீங்கள் தரும் விசைக்கு, planque அந்த token அல்லது விசையை உங்கள் நிறுவனத்துக்காக குறியாக்கி வைத்திருக்கிறது. நிர்வகிக்கப்படும் இணைப்புக்கு, planque உடன் வேலை செய்யும் இணைப்புச் சேவையான Composio உள்நுழைவை வைத்திருக்கிறது, planque இணைப்பின் பதிவையும் நீங்கள் அங்கீகரித்த கருவிகளையும் மட்டுமே வைத்திருக்கிறது (அனைத்தும் செயலாக்குபவராக, கீழே பார்க்க). நீங்கள் tafs நீட்டிப்பை இணைத்தால், ஒரு taf உங்கள் சொந்த Chrome-இல் நீங்கள் அனுமதிக்கும் தளங்களின் பக்கங்களையும் படிக்கவும் அவற்றில் செயல்படவும் முடியும் (செயலாக்குநராக; எது படிக்கப்படுகிறது, எது வைக்கப்படுகிறது, எவ்வளவு காலம் என்பதை <a href="/ta/tafs/privacy">tafs தனியுரிமைப் பக்கம்</a> கூறுகிறது). இணைப்பின் பதிவில் அது உள்நுழைந்துள்ள கணக்கு (அதன் பெயர் அல்லது மின்னஞ்சல்) இருக்கலாம், இதனால் செயலி எது என்பதை உங்களுக்குக் காட்ட முடியும். KIFF நிர்வகிக்கப்படும் இணைப்புகளை <a href="/subprocessors#composio">/subprocessors</a> (ஆங்கிலத்தில்) இல் பெயரிடப்பட்ட செயலிகளுக்கு மட்டுமே பயன்படுத்துகிறது. செயலியில் பகுப்பாய்வு அல்லது விளம்பரக் கண்காணிப்பிகள் இல்லை.
			</li>
			<li>
				<strong>App Store வாங்குதல்கள்</strong> — நீங்கள் tafs இல் Solo அல்லது கிரெடிட் தொகுப்பை வாங்கும்போது, Apple அதை உங்களுக்கு விற்கிறது: Apple பதிவு செய்யப்பட்ட விற்பனையாளர், கொடுப்பனவைப் பெற்று உங்கள் கொடுப்பனவு விவரங்களை வைத்திருக்கிறது. எது வாங்கப்பட்டது, எந்த KIFF கணக்குக்கு (செயலி வாங்குதலுடன் இணைக்கும் சீரற்ற id), எப்போது, Apple இன் பரிவர்த்தனை id, மற்றும் Solo க்கு காலம் எப்போது முடிகிறது அல்லது புதுப்பிக்கப்படுகிறது என்பதை Apple எங்களுக்குச் சொல்கிறது. உங்கள் கணக்கில் கிரெடிட்கள் அல்லது திட்டத்தைச் சேர்க்க அதைப் பயன்படுத்துகிறோம். Apple உங்கள் Apple ID, பெயர், மின்னஞ்சல் முகவரி அல்லது அட்டையை எங்களுக்குத் தருவதில்லை.
			</li>
			<li>
				<strong>Google Play வாங்குதல்கள்</strong> — Android இல், அதே வாங்குதல்கள் Google Play இன் பில்லிங் வழியாகச் செல்கின்றன: Google கொடுப்பனவைப் பெற்று உங்கள் கொடுப்பனவு விவரங்களை வைத்திருக்கிறது. எது வாங்கப்பட்டது, எந்த KIFF கணக்குக்கு (அதே சீரற்ற id), எப்போது, வாங்குதலின் token மற்றும் ஆர்டர் id, மற்றும் Solo க்கு காலம் எப்போது முடிகிறது அல்லது புதுப்பிக்கப்படுகிறது என்பதை Google எங்களுக்குச் சொல்கிறது, அதை அதேபோல் பயன்படுத்துகிறோம். Google உங்கள் Google கணக்கு, பெயர், மின்னஞ்சல் முகவரி அல்லது அட்டையை எங்களுக்குத் தருவதில்லை.
			</li>
		</ul>
	</section>
}

templ privacyLawfulBasesTA() {
	<section id="lawful-bases">
		<h2>5. செயலாக்கத்துக்கான சட்டபூர்வ அடிப்படைகள்</h2>
		<p>
			GDPR இன் கட்டுரை 6 இன் கீழ், நாங்கள் பின்வரும் சட்டபூர்வ அடிப்படைகளைச் சார்ந்திருக்கிறோம்:
		</p>
		<ul>
			<li>
				<strong>ஒப்பந்தத்தை நிறைவேற்றுதல்</strong> (கட்டுரை 6(1)(b)) — கணக்கு உருவாக்கம், அங்கீகாரம், உங்கள் சார்பாக runtime ஐ இயக்குதல், பில்லிங் (செயலில் இருக்கும்போது), மற்றும் முக்கியச் சேவை மேற்பரப்புகளுக்கு.
			</li>
			<li>
				<strong>முறையான நலன்கள்</strong> (கட்டுரை 6(1)(f)) — பாதுகாப்பு, மோசடி தடுப்பு, தவறான பயன்பாட்டைக் கண்டறிதல், செயல்பாட்டுத் தொலைமானி, மற்றும் சேவையைப் பாதுகாத்தலுக்கு. எங்கள் நலன்களை உங்கள் உரிமைகளுடன் சமநிலைப்படுத்துகிறோம், அந்தச் சமநிலைச் சோதனை என்ன விளைவைத் தந்தது என்பதைக் கேட்டால் உங்களுக்குச் சொல்வோம்.
			</li>
			<li>
				<strong>ஒப்புதல்</strong> (கட்டுரை 6(1)(a)) — tafs செயலியில் AI க்கு: Coach மற்றும் உங்கள் taf களை இயக்கும் AI மாதிரிக்கு அனுப்பப்படுவது, <a href="#ai-in-tafs">கீழே</a> விவரிக்கப்பட்டபடி. நீங்கள் அனுமதிக்கும் வரை எதுவும் அனுப்பப்படாது, கணக்கில் நீங்கள் திரும்பப் பெறலாம். பகுப்பாய்வுக் குக்கிகள், விருப்பச் சந்தைப்படுத்தல் தொடர்புகள், அல்லது உங்கள் தரவின் பயன்பாட்டைக் கணிசமாக விரிவாக்கும் புதிய செயலாக்கத்துக்கு முன் நாங்கள் கேட்பதும் ஒப்புதலே. நாங்கள் பகுப்பாய்வு, விளம்பரம் மற்றும் அத்தியாவசியமற்ற கண்காணிப்பு எதையும் இயக்குவதில்லை.
			</li>
			<li>
				<strong>சட்டக் கடமை</strong> (கட்டுரை 6(1)(c)) — வரிப் பதிவுகள் (எஸ்தோனியக் கணக்கியல் சட்டம் §12, 7 ஆண்டுகள்), சட்டப்பூர்வ அதிகாரக் கோரிக்கைகளுக்குப் பதில், மற்றும் பொருந்தும் இடத்தில் பணமோசடித் தடுப்பு விதிகள் கோரும் தக்கவைப்புக்கு.
			</li>
		</ul>
		<h3 id="ai-in-tafs">tafs செயலியில் AI</h3>
		<p>AI க்கு எதுவும் செல்வதற்கு முன் tafs செயலி இந்த வார்த்தைகளில் உங்களிடம் கேட்கிறது:</p>
		<ul>
			<li>tafs, Coach மற்றும் உங்கள் taf களுக்கு Anthropic இன் Claude AI ஐப் பயன்படுத்துகிறது.</li>
			<li>Coach மற்றும் உங்கள் taf கள் AI முகவர்கள்: அவை எழுதுவது AI ஆல் உருவாக்கப்படுகிறது, தவறாக இருக்கலாம். ஒரு taf உங்கள் நிறுவனத்துக்கு வெளியே அனுப்பும் செய்தியில் AI முகவர் எழுதியது என்று குறிப்பிடப்படும்.</li>
			<li>அதற்கு அனுப்பப்படுவது: நீங்கள் Coach மற்றும் உங்கள் taf களுக்கு எழுதுவது, நீங்கள் இணைக்கும் கோப்புகள், உங்கள் இணைக்கப்பட்ட செயலிகள் taf வேலை செய்யும்போது அதற்குத் திருப்பித் தருவது, மற்றும் செயலியில் Coach உங்களுக்கு உதவும்போது உங்கள் திரையில் இருப்பது.</li>
			<li>ஒருபோதும் அனுப்பப்படாதது: உங்கள் இணைக்கப்பட்ட செயலிகள் பயன்படுத்தும் கடவுச்சொற்கள் மற்றும் விசைகள், அல்லது உங்கள் கைரேகை.</li>
			<li>Anthropic அதைப் பதிலளிக்கப் பயன்படுத்தி 30 நாட்கள் வரை வைத்திருக்கிறது.</li>
			<li>நீங்கள் அனுமதிக்கும் வரை எதுவும் அனுப்பப்படாது. நீங்கள் கணக்கில் திரும்பப் பெறலாம்.</li>
		</ul>
		<p>அந்த நேரத்தில் யாரும் இல்லாமல் இயங்கும் taf (அதன் அட்டவணைப்படி, அல்லது ஏதாவது வரும்போது) அதை உருவாக்கியவர் அல்லது ஏற்றுக்கொண்டவரின் ஒப்புதலையோ, அல்லது அதற்கு அனுமதிக்கும் கணக்கின் taf களை நிர்வகிக்கும் முதல் நபரின் ஒப்புதலையோ சார்ந்திருக்கும்.</p>
		<p><strong>நீங்கள் திரும்பப் பெறும்போது,</strong> Coach மற்றும் உங்கள் taf கள் உங்களுக்குப் பதிலளிப்பதை நிறுத்துகின்றன. ஓட்டங்கள் உங்கள் ஒப்புதலைச் சார்ந்த taf இடைநிறுத்தப்படும்: அதன் அட்டவணைகள் நிற்கும், வருவது காத்திருக்கும். ஒப்புதல் மீண்டும் வழங்கப்படும்போது, அல்லது கணக்கின் taf களை நிர்வகிக்கும் ஒருவர் தன் சொந்த ஒப்புதலுடன் அதை ஏற்றுக்கொள்ளும்போது அது தொடரும். திரும்பப் பெறுவது முன்பு அனுப்பப்பட்டதை மாற்றாது.</p>
		<p>Anthropic <a href="/subprocessors">/subprocessors</a> (ஆங்கிலத்தில்) இல் பட்டியலிடப்பட்டுள்ளது, அது எங்கே செயலாக்குகிறது மற்றும் எப்போது தரவை நீண்ட காலம் வைத்திருக்கலாம் என்பதுடன்.</p>
	</section>
}

templ privacySubprocessorsTA() {
	<section id="sub-processors">
		<h2>6. துணைச் செயலாக்குபவர்கள்</h2>
		<p>நாங்கள் உங்கள் தனிப்பட்ட தரவை விற்பதில்லை, விளம்பரத்துக்காகப் பகிர்வதும் இல்லை.</p>
		<p>
			சேவையை வழங்க நாங்கள் சிறிய எண்ணிக்கையிலான விற்பனையாளர்களை ஈடுபடுத்துகிறோம். அதிகாரப்பூர்வமான, தற்போதைய பட்டியல் <a href="/subprocessors">/subprocessors</a> (ஆங்கிலத்தில்) இல் உள்ளது; எந்த மாற்றத்திலிருந்தும் 30 நாட்களுக்குள் அந்தப் பக்கம் புதுப்பிக்கப்படுகிறது. தனிப்பட்ட தரவு EU ஐ விட்டுச் செல்லும் இடத்தில் EU நிலையான ஒப்பந்த வாசகங்கள் உட்பட, எழுத்துப்பூர்வ ஒப்பந்தங்களின் கீழ் எங்கள் பாதுகாப்புகளுக்குச் சமமான பாதுகாப்புகளை வழங்க ஒவ்வொரு துணைச் செயலாக்குபவரையும் கோருகிறோம்.
		</p>
		<p>
			தனிப்பட்ட தரவைப் பாதிக்கும் துணைச் செயலாக்குபவர்களின் கணிசமான சேர்த்தல்கள் அல்லது மாற்றங்கள், ஆட்சேபிக்கும் உரிமையுடன், செயலில் உள்ள வாடிக்கையாளர்களுக்கு முன்கூட்டியே தெரிவிக்கப்படும்.
		</p>
	</section>
}

templ privacyTransfersTA() {
	<section id="transfers">
		<h2>7. சர்வதேசப் பரிமாற்றங்கள்</h2>
		<p>
			எங்கள் துணைச் செயலாக்குபவர்களில் சிலர் ஐரோப்பியப் பொருளாதாரப் பகுதிக்கு வெளியே, முக்கியமாக அமெரிக்காவில் நிறுவப்பட்டுள்ளனர். அத்தகைய ஒவ்வொரு பரிமாற்றத்துக்கும் பின்வரும் பாதுகாப்புகளில் குறைந்தது ஒன்றைச் சார்ந்திருக்கிறோம்:
		</p>
		<ul>
			<li>
				<strong>EU–US தரவுத் தனியுரிமைச் சட்டகம்</strong> — சட்டகத்துக்குச் சான்றளித்த அமெரிக்கத் துணைச் செயலாக்குபவர்களுக்கு. 2023 நடுவிலிருந்து நடைமுறையில் உள்ள போதுமான தன்மை முடிவு; அதன் நிலையில் ஏதேனும் மாற்றம் உள்ளதா என்று கண்காணிக்கிறோம்.
			</li>
			<li>
				<strong>நிலையான ஒப்பந்த வாசகங்கள்</strong> — எங்கள் நேரடித் துணைச் செயலாக்குபவர்களுக்கு தொகுதி 2 (கட்டுப்படுத்தியிலிருந்து செயலாக்குபவருக்கு) மற்றும் தொடர் செயலாக்குபவர்கள் பொருந்தும் இடத்தில் தொகுதி 3 (செயலாக்குபவரிலிருந்து துணைச் செயலாக்குபவருக்கு). ஆணையம் அங்கீகரித்த 2021 SCC களைப் பயன்படுத்துகிறோம்.
			</li>
			<li>
				<strong>துணை நடவடிக்கைகள்</strong> — இடர் மதிப்பீடு கூடுதல் பாதுகாப்புகள் தேவை எனக் காட்டும் இடத்தில் (போக்குவரத்திலும் சேமிப்பிலும் குறியாக்கம், அணுகல் பதிவு, தரவுக் குறைப்பு).
			</li>
		</ul>
		<p>
			ஒரு குறிப்பிட்ட துணைச் செயலாக்குபவருக்குப் பொருந்தும் குறிப்பிட்ட பரிமாற்றக் கருவியை <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> க்கு மின்னஞ்சல் அனுப்பிக் கேட்கலாம்.
		</p>
		<p><strong>உங்கள் நாடு.</strong> சில நாடுகளின் சட்டங்கள் இந்தக் கொள்கை கூறுவதை விட அதிகமாகக் கேட்கின்றன. அவை சேர்ப்பது, ஆங்கிலத்திலும் அந்த நாட்டின் மொழியிலும், <a href="/privacy/countries">உங்கள் நாடு</a> (ஆங்கிலத்தில்) இல் உள்ளது.</p>
	</section>
}

templ privacyRetentionTA() {
	<section id="retention">
		<h2>8. தக்கவைப்பு</h2>
		<p>
			தனிப்பட்ட தரவை நாங்கள் செயலாக்கும் நோக்கங்களுக்கும் பொருந்தக்கூடிய சட்டக் கடமைக்கும் இசைவான மிகக் குறுகிய காலத்துக்கு வைத்திருக்கிறோம்.
		</p>
		<ul>
			<li>
				<strong>கணக்கு மற்றும் உள்நுழைவு மெட்டாடேட்டா</strong> — கணக்கு நீக்கப்படும் வரை. tafs செயலியில், உரிமையாளர் அதை கணக்கு → <em>கணக்கை நீக்கு</em> இல் நீக்குகிறார். இணையத்தில் உருவாக்கிய கணக்கு <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> க்கு மின்னஞ்சல் அனுப்புவதன் மூலம் நீக்கப்படுகிறது, GDPR கட்டுரை 12(3) இன் ஒரு மாத கால எல்லைக்குள். எப்படியிருந்தாலும், கணக்கின் விசைகள் உடனே நின்றுவிடும். tafs செயலியில் நீக்கினால், அதை மீட்க முடியாது: அதன் tafs உரையாடல்கள், குறிப்புகள் மற்றும் இணைப்புகள் உடனே அழிக்கப்படும், KIFF வைத்திருப்பது 30 நாட்களுக்குள் அழிக்கப்படும். இணையத்தில் நீக்கினால், உரிமையாளர் அதைத் திரும்ப விரும்பினால் என்ற நிலையில் 30 நாட்கள் சலுகைக் காலத்துக்கு அதன் தரவை வைத்திருந்து, பின்னர் அழிக்கிறோம்.
			</li>
			<li>
				<strong>API விசைப் பதிவுகள்</strong> — கணக்கு நீக்கப்படும் வரை, விசை ரத்து செய்யப்பட்ட பிறகும். முகவர் உள்நுழைவு இணைப்புக்குச் சொந்தமான விசை அந்த இணைப்புடன், அது முடிந்த 30 நாட்களுக்குப் பிறகு நீக்கப்படும்.
			</li>
			<li>
				<strong>அமர்வுக் குக்கிகள்</strong> — காலாவதியாகும் வரை (இயல்பாக 24 மணி நேரம்) அல்லது நீங்கள் வெளியேறும் வரை.
			</li>
			<li>
				<strong>Reverse-proxy அணுகல் பதிவுகள்</strong> — 90 நாட்கள் வரை, பின்னர் திரட்டப்படும் அல்லது நீக்கப்படும்.
			</li>
			<li>
				<strong>சேவைப் பதிவுகள்</strong> — KIFF இன் சேவைகளும் planque உம் இயங்கும்போது பதிவு செய்வது: பிழைகள், மற்றும் கோரிக்கைகள், இவை கணக்கு, நபர் அல்லது முகவரைக் குறிப்பிடலாம். 30 நாட்கள், பின்னர் நீக்கப்படும்.
			</li>
			<li>
				<strong>காப்புப்பிரதிகள்</strong> — KIFF இன் தரவுத்தளம் தினமும் காப்புப்பிரதி எடுக்கப்படுகிறது, குறியாக்கப்பட்டு, ஒவ்வொரு காப்புப்பிரதியும் 7 நாட்கள் வைக்கப்படுகிறது, எனவே நீக்கப்பட்ட பதிவு 7 நாட்களுக்குள் அவற்றிலிருந்து மறைகிறது. tafs மற்றும் planque இன் சேமிப்பகங்கள் குறியாக்கப்பட்ட புள்ளி-நேர நகல்களை 35 நாட்கள் வைத்திருக்கின்றன, தோல்விக்குப் பிறகு சேமிப்பகத்தை மீட்டெடுக்க மட்டுமே பயன்படுத்தப்படும், எனவே நீக்கப்பட்ட பதிவு 35 நாட்களுக்குள் அவற்றிலிருந்து மறைகிறது.
			</li>
			<li>
				<strong>Tenant தணிக்கைத் தரவு</strong> — வாடிக்கையாளரின் tenant கட்டமைப்பின்படி செயலாக்குபவராக வைக்கப்படுகிறது. இயல்புநிலை: tenant இன் ஆயுள் முழுவதும் வைக்கப்படும்; tenant நீக்கப்படும்போது நீக்கப்படும். <a href="/security#deletion">/security#deletion</a> (ஆங்கிலத்தில்) பாருங்கள்.
			</li>
			<li>
				<strong>KIFF நுழைவாயில் வழியாக அழைப்புகள்</strong> — அழைப்பின் வாதங்கள் அது அனுப்பப்படும், நிராகரிக்கப்படும் அல்லது தோல்வியடையும் வரை, பின்னர் நீக்கப்படும்; கருவியின் முடிவு 24 மணி நேரம், பின்னர் நீக்கப்படும். முடிவுப் பதிவும் வாதங்களின் ஹாஷும் tenant தணிக்கைத் தரவாக வைக்கப்படுகின்றன. <a href="/security#data-kept">/security#data-kept</a> (ஆங்கிலத்தில்) பாருங்கள்.
			</li>
			<li>
				<strong>பயன்பாடு</strong> — நுழைவாயில் வழியாகச் செல்லும் ஒவ்வோர் அழைப்புக்கும், அது முடிந்ததும்: எந்த முகவர் செய்தார், கருவி, அது செயலாகக் கணக்கிடப்பட்டதா அல்லது இலவசமா (ஏன்). taf அல்லது Coach இன் ஒவ்வொரு ஓட்டத்துக்கும், அது முடிந்ததும்: taf, எப்போது, அதன் AI பயன்படுத்திய கிரெடிட்கள், மற்றும் அவை கணக்கிடப்பட்டனவா அல்லது ஏன் இல்லை. கணக்கு நீக்கப்படும் வரை; பில்லிங்கிற்காக எங்கள் கொடுப்பனவுச் செயலாக்குநருக்குத் தெரிவிக்கப்படுவது பில்லிங் பதிவுகளுடன் வைக்கப்படுகிறது.
			</li>
			<li>
				<strong>முகவர் உள்நுழைவு இணைப்புகள்</strong> — எந்த முகவர், செயலியின் பெயர், யார் அனுமதித்தார், எப்போது, மற்றும் அதன் கடைசிப் பயன்பாடு: இணைப்பு செயலில் இருக்கும்போது, பின்னர் அது முடிந்த 30 நாட்கள் (அந்தக் காலத்தில் அது கட்டுப்பாட்டுப் பலகையில் பட்டியலிடப்பட்டிருக்கும்), பின்னர் அதன் tokens மற்றும் API விசையுடன் நீக்கப்படும். அவை அனைத்தும் கணக்குடன் நீக்கப்படுகின்றன.
			</li>
			<li>
				<strong>tafs</strong> — சாதனத்தின் push token நீங்கள் செயலியிலிருந்து வெளியேறும், சாதனத்தை நீக்கும், அல்லது Apple அல்லது Google token மறைந்ததாகத் தெரிவிக்கும் வரை. சாதனத்தின் பொது விசை, பெயர், தளம் மற்றும் தேதிகள் நீங்கள் அதைப் பயன்படுத்தும் வரை; நீங்கள் அதிலிருந்து வெளியேறியதும், அது நீக்கப்பட்டதாகக் குறிக்கப்பட்டு கணக்கு நீக்கப்படும் வரை வைக்கப்படுகிறது, இதனால் KIFF அதிலிருந்து தாமதமான பதிலை மறுக்கவும் முந்தையதை எந்தச் சாதனம் கையொப்பமிட்டது என்பதைக் காட்டவும் முடியும். passkey இன் பொது விசை, id மற்றும் பெயர் அதன் சாதனத்தைப் போலவே வைக்கப்படுகின்றன. கணினி தன் அமர்வை 90 நாட்கள் வரை, அல்லது நீங்கள் வெளியேறும் வரை வைத்திருக்கிறது. tafs உங்கள் நிறுவனத்துக்காக வைத்திருப்பது செயலாக்குபவராக வைக்கப்படுகிறது: taf இன் ஓட்டங்களும் உரையாடல்களும், உரையாடலின் சுருக்கத்துடன் (மற்றும் Setup இன்), 30 நாட்கள், உங்கள் கருவிகள் திருப்பித் தருவது ஓட்டம் முடியும் வரை மட்டுமே (உரையாடலில், அது படித்தது மட்டும் அதன் அடுத்த செய்திகளுக்காகக் குறியாக்கப்பட்டு வைக்கப்படுகிறது, உரையாடல் ஒரு மணி நேரம் செயலற்றிருக்கும் வரை, படித்த பிறகு அதிகபட்சம் நான்கு மணி நேரம் வரை பயன்படுத்தப்பட்டு, பின்னர் சில நாட்களுக்குள் தானாக நீக்கப்படுகிறது), மற்றும் அதன் நினைவுக் குறிப்புகள் taf நீக்கப்படும் வரை; அது வழங்கும் கோப்புகள் அவற்றை உருவாக்கிய ஓட்டத்திலிருந்து 30 நாட்கள், பின்னர் ஒரு நாளுக்குள் தானாக நீக்கப்படும், அல்லது உங்கள் கணக்கில் யாராவது ஒன்றை நீக்கினால் முன்பே; planque இல் இணைப்பின் token அல்லது விசை, அல்லது Composio இல் நிர்வகிக்கப்படும் இணைப்பின் உள்நுழைவு, நீங்கள் அதைத் துண்டிக்கும் வரை (உங்கள் வேறொரு இணைப்பு அந்த விற்பனையாளரிடம் அதே கணக்கைப் பயன்படுத்தலாம் என்றால், அதுவும் துண்டிக்கப்படும் வரை அது பயன்படுத்தாமல் வைக்கப்படும்), மற்றும் அதன் ஒப்புதல்களின் பதிவு கணக்கு முடியும் வரை; <a href="/legal/dpa#annex-4">DPA இன் இணைப்பு 4</a> (ஆங்கிலத்தில்) பாருங்கள்.
			</li>
			<li>
				<strong>பில்லிங் பதிவுகள்</strong> — நிதியாண்டு முடிவிலிருந்து 7 ஆண்டுகள் (எஸ்தோனியக் கணக்கியல் சட்டம் §12).
			</li>
			<li>
				<strong>App Store மற்றும் Google Play வாங்குதல்கள்</strong> — ஒவ்வொரு வாங்குதல் பற்றியும் Apple அல்லது Google எங்களுக்குச் சொன்னது கணக்கு நீக்கப்படும் வரை உங்கள் கணக்கில் இருக்கும். அவர்களின் விற்பனை மற்றும் கொடுப்பனவு அறிக்கைகள், நாங்கள் பில்லிங் பதிவுகளாக 7 ஆண்டுகள் வைத்திருப்பவை, உங்களைப் பெயரிடுவதில்லை.
			</li>
			<li>
				<strong>ஆதரவுத் தொடர்புகள்</strong> — கடைசித் தொடர்பிலிருந்து 3 ஆண்டுகள், பின்னர் நீக்கப்படும்.
			</li>
		</ul>
	</section>
}

templ privacyRightsTA() {
	<section id="rights">
		<h2>9. உங்கள் உரிமைகள்</h2>
		<p>
			GDPR இன் கீழ் உங்கள் தனிப்பட்ட தரவு தொடர்பாக உங்களுக்குப் பின்வரும் உரிமைகள் உள்ளன:
		</p>
		<ul>
			<li><strong>அணுகல்</strong> (கட்டுரை 15) — நாங்கள் உங்கள் தரவைச் செயலாக்குகிறோமா என்பதற்கான உறுதிப்படுத்தல், மற்றும் அதன் நகல்.</li>
			<li><strong>திருத்தம்</strong> (கட்டுரை 16) — தவறான அல்லது முழுமையற்ற தரவைத் திருத்துதல்.</li>
			<li><strong>அழித்தல்</strong> (கட்டுரை 17) — சட்டபூர்வத் தக்கவைப்பு விதிவிலக்குகளுக்கு உட்பட்டு உங்கள் தரவை நீக்குதல்.</li>
			<li><strong>கட்டுப்படுத்துதல்</strong> (கட்டுரை 18) — தகராறு தீர்க்கப்படும் வரை செயலாக்கத்தை இடைநிறுத்துதல்.</li>
			<li><strong>கொண்டுசெல்லும் தன்மை</strong> (கட்டுரை 20) — நீங்கள் வழங்கிய தரவின் இயந்திரம் படிக்கக்கூடிய ஏற்றுமதி.</li>
			<li><strong>எதிர்ப்பு</strong> (கட்டுரை 21) — முறையான நலன்களை அடிப்படையாகக் கொண்ட செயலாக்கத்துக்கு; மேலோங்கும் காரணங்களை எங்களால் காட்ட முடியாவிட்டால் நிறுத்துகிறோம்.</li>
			<li><strong>ஒப்புதலைத் திரும்பப் பெறுதல்</strong> (கட்டுரை 7(3)) — tafs செயலியில் AI போன்ற ஒப்புதலை அடிப்படையாகக் கொண்ட எந்தச் செயலாக்கத்துக்கும் (கணக்கில், <a href="#ai-in-tafs">மேலே</a> உள்ளபடி). திரும்பப் பெறுவது முந்தைய சட்டபூர்வச் செயலாக்கத்தைப் பாதிக்காது.</li>
		</ul>
		<p>
			இந்த உரிமைகளில் எதையும் பயன்படுத்த, <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> க்கு மின்னஞ்சல் அனுப்புங்கள். கட்டுரை 12(3) இன்படி தேவையற்ற தாமதமின்றி, அதிகபட்சம் ஒரு மாதத்துக்குள் பதிலளிக்கிறோம்; சிக்கலான கோரிக்கைகளுக்கு மேலும் இரண்டு மாதங்கள் வரை நீட்டிக்கலாம், அவ்வாறு செய்தால் உங்களுக்குச் சொல்வோம்.
		</p>
		<h3 id="export-chats">உங்கள் சொந்த tafs உரையாடல்கள்</h3>
		<p>
			tafs செயலியில், கணக்கு → என் உரையாடல்களை ஏற்றுமதி செய் ஒவ்வொரு taf உடனும், Coach இன் உட்பட, நீங்கள் செய்த உங்கள் சொந்த உரையாடல்கள், நீங்கள் இணைத்த கோப்புகளின் பெயர்கள், மற்றும் உங்கள் சொந்தக் குறிப்புகளைப் படிக்கக்கூடிய கோப்பாகவும் JSON ஆகவும் பதிவிறக்குகிறது. உங்களால் மட்டுமே அவற்றை ஏற்றுமதி செய்ய முடியும்: நிர்வாகி அல்லது கணக்கின் உரிமையாளரால் முடியாது, KIFF இன் கணக்கு ஏற்றுமதியில் அவை சேர்க்கப்படுவதில்லை.
		</p>
		<h3 id="delete-account">உங்கள் tafs கணக்கை நீக்குதல்</h3>
		<p>
			tafs என்பது KIFF இன் செயலி. உங்கள் tafs கணக்கையும் அதன் தரவையும் நீக்க:
		</p>
		<ol>
			<li>tafs செயலியைத் திறந்து உள்நுழையுங்கள்.</li>
			<li>கணக்குக்குச் சென்று, பிறகு <em>கணக்கை நீக்கு</em> என்பதைத் தட்டுங்கள்.</li>
			<li>உறுதிப்படுத்துங்கள். கணக்கை நீக்குவதை மீட்க முடியாது.</li>
		</ol>
		<p>
			<em>கணக்கை நீக்கு</em> நிறுவனத்தின் கணக்கை நீக்க அனுமதிக்கப்பட்டவருக்குக் காட்டப்படுகிறது, பொதுவாக அதன் உரிமையாளருக்கு. அதை நீங்கள் காணவில்லை என்றால், அல்லது செயலி இனி இல்லை என்றால், நீங்கள் உள்நுழையும் முகவரியிலிருந்து <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> க்கு மின்னஞ்சல் அனுப்புங்கள், தேவையற்ற தாமதமின்றி, அதிகபட்சம் ஒரு மாதத்துக்குள் உங்கள் தரவை நீக்குகிறோம்.
		</p>
		<p>
			நீக்கப்படுவது: கணக்கின் விசைகள் உடனே நின்றுவிடும். அதன் tafs, உரையாடல்கள், குறிப்புகள், இணைக்கப்பட்ட கோப்புகள் மற்றும் இணைப்புகள் உடனே அழிக்கப்படும், அவற்றின் புள்ளி-நேர நகல்களிலிருந்து 35 நாட்களுக்குள். கணக்குக்காக KIFF வைத்திருப்பது 30 நாட்களுக்குள் அழிக்கப்படும், காப்புப்பிரதிகளிலிருந்து அதற்குப் பின் 7 நாட்களுக்குள். கணக்கைக் குறிப்பிடும் சேவைப் பதிவுகள் 30 நாட்களுக்குள் மறையும். Tenant தணிக்கைத் தரவு tenant உடன் நீக்கப்படும். ஒவ்வொரு தரவு வகைக்கும் <a href="#retention">தக்கவைப்பு</a> பாருங்கள்.
		</p>
		<p id="delete-data">
			உங்கள் தரவில் சிலவற்றை நீக்கிக் கணக்கை வைத்திருக்க: செயலியில், ஒரு உரையாடலை நீக்குங்கள், அதன் செய்திகளும் இணைக்கப்பட்ட கோப்புகளும் அதனுடன் போகும்; ஒரு taf ஐ நீக்குங்கள், அதன் உரையாடல்கள், குறிப்புகள் மற்றும் இணைப்புகளும் அதனுடன் போகும். வேறு எதற்கும், <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> க்கு மின்னஞ்சல் அனுப்பி எதை நீக்க வேண்டும் எனச் சொல்லுங்கள். தேவையற்ற தாமதமின்றி, அதிகபட்சம் ஒரு மாதத்துக்குள் அதைச் செய்கிறோம்.
		</p>
		<p>
			மேற்பார்வை அதிகாரியிடம் புகார் செய்ய உங்களுக்கு உரிமை உள்ளது. எங்கள் முதன்மை மேற்பார்வை அதிகாரி <a href="https://www.aki.ee/en" target="_blank" rel="noopener">எஸ்தோனியத் தரவுப் பாதுகாப்பு ஆய்வகம் (Andmekaitse Inspektsioon)</a>. நீங்கள் வசிக்கும் உறுப்பு நாட்டின் மேற்பார்வை அதிகாரியிடமும் புகார் செய்யலாம்.
		</p>
		<p><strong>உங்கள் நாடு.</strong> சில நாடுகளின் சட்டங்கள் இந்தக் கொள்கை கூறுவதை விட அதிகமாகக் கேட்கின்றன. அவை சேர்ப்பது, ஆங்கிலத்திலும் அந்த நாட்டின் மொழியிலும், <a href="/privacy/countries">உங்கள் நாடு</a> (ஆங்கிலத்தில்) இல் உள்ளது.</p>
	</section>
}

templ privacyCookiesTA() {
	<section id="cookies">
		<h2>10. குக்கிகள்</h2>
		<p>
			நாங்கள் மூன்று குக்கிகளை அமைக்கிறோம், அனைத்தும் கண்டிப்பாகத் தேவையானவை, முதல்-தரப்பு, HTTPS வழியாக மட்டுமே அனுப்பப்படுபவை, பக்கத்தில் உள்ள ஸ்கிரிப்ட்களால் படிக்க முடியாதவை. EU ePrivacy விதிகளின் கீழ் அவற்றுக்கு ஒப்புதல் தேவையில்லை; அவை இருப்பதை நீங்கள் அறிய அவற்றைப் பட்டியலிடுகிறோம். <a href="/cookies">குக்கிக் கொள்கையில்</a> (ஆங்கிலத்தில்) விவரங்கள் உள்ளன.
		</p>
		<ul>
			<li>
				<strong><code>kiff_session</code></strong> — உங்களை உள்நுழைந்த நிலையில் வைத்திருக்கிறது. உங்கள் உள்நுழைவு id, மின்னஞ்சல் மற்றும் பெயர், மற்றும் கட்டுப்பாட்டுப் பலகை உங்களுக்காகப் பயன்படுத்தும் நற்சான்றைக் கொண்ட கையொப்பமிட்ட அமர்வுக் குக்கி. <code>.kiff.dev</code> க்காக அமைக்கப்படுகிறது. இது 24 மணி நேரம், அல்லது நீங்கள் வெளியேறும் வரை நீடிக்கும்.
			</li>
			<li>
				<strong><code>kiff_flash</code></strong> — "உங்கள் விசை உருவாக்கப்பட்டது" போன்ற ஒரு-முறைச் செய்தியை அடுத்த பக்கத்துக்கு எடுத்துச் செல்கிறது. கையொப்பமிடப்பட்டது; புதிய விசை ஒருபோதும் அதில் இல்லை. <code>.kiff.dev</code> க்காக அமைக்கப்படுகிறது. அடுத்த பக்கம் அதைப் படிக்கும்போது நீக்கப்படும், அதிகபட்சம் 5 நிமிடங்கள்.
			</li>
			<li>
				<strong><code>kiff_cb_attempts</code></strong> — உள்நுழைவுப் பக்கம் எத்தனை முறை மீண்டும் ஏற்றப்பட்டது என்பதை எண்ணுகிறது, இதனால் சுழலும் உள்நுழைவு நிறுத்தப்படும். அந்தப் பக்கத்துக்கு மட்டுமே அனுப்பப்படுகிறது. இது 5 நிமிடங்கள் நீடிக்கும், உள்நுழைவு தொடங்கும்போது அல்லது வெற்றி பெறும்போது அழிக்கப்படும்.
			</li>
		</ul>
		<p>
			நாங்கள் பகுப்பாய்வுக் குக்கிகள், விளம்பரக் குக்கிகள், அல்லது எந்த மூன்றாம் தரப்புக் கண்காணிப்பிகளையும் பயன்படுத்துவதில்லை. எதிர்காலத்தில் எதையாவது சேர்த்தால், ePrivacy மற்றும் கண்காணிப்புத் தொழில்நுட்பங்கள் குறித்த EDPB இன் 2023 வழிகாட்டுதலுக்கு இணங்க, குக்கி அமைக்கப்படுவதற்கு முன் ஒப்புதல் பதாகையை வழங்குவோம்.
		</p>
		<p>
			நீங்கள் Clerk (எங்கள் அங்கீகாரத் துணைச் செயலாக்குபவர்) வழியாக உள்நுழைந்தால், Clerk தன் சொந்த frontend டொமைனிலும் (<code>clerk.kiff.dev</code>) குக்கிகளை அமைக்கிறது. அந்தக் குக்கிகள் அதன் உள்நுழைவுச் செயல்முறை முழுவதும் உங்களை அடையாளம் காண Clerk க்குத் தேவை, அவை எங்களுடையதுடன் கூடவே Clerk இன் தனியுரிமைக் கொள்கையாலும் நிர்வகிக்கப்படுகின்றன. விவரங்களுக்குத் துணைச் செயலாக்குபவர் பட்டியலைப் பாருங்கள்.
		</p>
	</section>
}

templ privacySecurityTA() {
	<section id="security">
		<h2>11. பாதுகாப்பு</h2>
		<p>
			எங்கள் தொழில்நுட்ப மற்றும் நிறுவன ரீதியான பாதுகாப்பு நடவடிக்கைகள் <a href="/security">/security</a> (ஆங்கிலத்தில்) இல் ஆவணப்படுத்தப்பட்டுள்ளன. அவற்றில் தரவுத்தள அடுக்கில் tenant தனிமைப்படுத்தல், போக்குவரத்தில் TLS 1.2+, நிர்வகிக்கப்படும் வழங்குநரின் இயல்புநிலைகள் வழியாகச் சேமிப்பில் குறியாக்கம், மற்றும் குறைந்தபட்சச் சலுகைக் கொள்கையின் அடிப்படையிலான அணுகல் கட்டுப்பாடுகள் அடங்கும்.
		</p>
		<p>
			தனிப்பட்ட தரவு மீறலை பாதிக்கப்பட்ட வாடிக்கையாளர்களுக்கு தேவையற்ற தாமதமின்றி, உறுதிப்படுத்தலிலிருந்து 72 மணி நேரத்துக்குள், GDPR கட்டுரை 33 க்கு இசைவாகத் தெரிவிக்கிறோம். அறிவிப்பில் மீறலின் தன்மை, சம்பந்தப்பட்ட தரவுப் பொருள்கள் மற்றும் பதிவுகளின் வகைகள் மற்றும் தோராயமான எண்ணிக்கைகள், சாத்தியமான விளைவுகள், மற்றும் எடுக்கப்பட்ட அல்லது முன்மொழியப்பட்ட நடவடிக்கைகள் அடங்கும்.
		</p>
	</section>
}

templ privacyChildrenTA() {
	<section id="children">
		<h2>12. குழந்தைகள்</h2>
		<p>
			KIFF Cloud என்பது குழந்தைகளை நோக்கமாகக் கொள்ளாத டெவலப்பர் உள்கட்டமைப்புத் தயாரிப்பு. 16 வயதுக்குட்பட்ட குழந்தைகளிடமிருந்து தனிப்பட்ட தரவை நாங்கள் தெரிந்தே சேகரிப்பதில்லை. ஒரு குழந்தை எங்களுக்குத் தனிப்பட்ட தரவை வழங்கியுள்ளது என்று நீங்கள் நம்பினால், <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> ஐத் தொடர்புகொள்ளுங்கள், அதை நீக்குவோம்.
		</p>
	</section>
}

templ privacyAutomatedTA() {
	<section id="automated">
		<h2>13. தானியங்கி முடிவெடுத்தல்</h2>
		<p>
			KIFF Cloud இன் runtime எங்கள் வாடிக்கையாளர்கள் அனுப்பும் தரவின் மீது தீர்மானகரமான கொள்கை முடிவுகளை எடுக்கிறது. இவை GDPR கட்டுரை 22 இன் பொருளில் உங்களைப் பற்றிய சட்டப்பூர்வ அல்லது அதுபோன்ற குறிப்பிடத்தக்க விளைவுகளை ஏற்படுத்தும் முடிவுகள் அல்ல; அவை வாடிக்கையாளரின் செயல்கள் (பணத்திரும்பல்கள், ஆர்டர்கள், செய்திகள் மற்றும் பல) பற்றிய முடிவுகள், வாடிக்கையாளரின் சொந்தக் கொள்கையின் கீழ் செயல்படுத்தப்படுகின்றன.
		</p>
		<p>
			தங்கள் சொந்த இறுதிப் பயனர்களைப் பாதிக்கும் முடிவுகளை எடுக்க KIFF Cloud ஐப் பயன்படுத்தும் வாடிக்கையாளர்கள் கட்டுரை 22 க்கு இணங்குவதற்குத் தாங்களே பொறுப்பு. எங்கள் நிர்வாக ரசீதுகள் அந்த வாடிக்கையாளர்களுக்கு மனிதக் கண்காணிப்பை நிரூபிக்கத் தேவையான தணிக்கைப் பாதையை வழங்க வடிவமைக்கப்பட்டுள்ளன, ஆனால் அந்தக் கண்காணிப்பை வழங்கும் சட்டக் கடமை வாடிக்கையாளரிடமே உள்ளது.
		</p>
	</section>
}

templ privacyChangesTA() {
	<section id="changes">
		<h2>14. இந்தக் கொள்கையில் மாற்றங்கள்</h2>
		<p>
			இந்தக் கொள்கையை நாங்கள் அவ்வப்போது புதுப்பிக்கலாம். கணிசமான மாற்றங்கள் செயலில் உள்ள வாடிக்கையாளர்களுக்கு மின்னஞ்சல் மூலமும் இந்தப் பக்கத்தில் முக்கியமான பதாகை மூலமும் குறைந்தது 30 நாட்கள் அறிவிக்கப்படுகின்றன. கணிசமற்ற மாற்றங்கள் புதிய "கடைசியாகப் புதுப்பிக்கப்பட்டது" தேதியுடன் வெளியிடப்படுகின்றன.
		</p>
	</section>
}

