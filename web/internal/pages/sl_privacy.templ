package pages

import "github.com/kiff/cloud/web/internal/components"

// PrivacySL is the privacy policy (/privacy) in Slovene, at /sl/privacy.
// It is a translation of Privacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English
// page governs. Change the English page first, then this one. Slovene has
// the legal texts only, so a link to any other page goes to English and
// says so.
templ PrivacySL() {
	@components.LayoutSite("KIFF — pravilnik o zasebnosti", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@privacyHeadSL()
			@privacyWhoWeAreSL()
			@privacyScopeSL()
			@privacyRolesSL()
			@privacyCategoriesSL()
			@privacyLawfulBasesSL()
			@privacySubprocessorsSL()
			@privacyTransfersSL()
			@privacyRetentionSL()
			@privacyRightsSL()
			@privacyCookiesSL()
			@privacySecuritySL()
			@privacyChildrenSL()
			@privacyAutomatedSL()
			@privacyChangesSL()
			@privacyContactSL()
		</article>
	}
}

templ privacyHeadSL() {
	<header class="legal-head">
		<p class="legal-badge">Pravilnik o zasebnosti · v0.1</p>
		<h1>Pravilnik o zasebnosti</h1>
		<p class="legal-meta">
			<strong>Zadnja posodobitev:</strong> 21. novembra 2026.
			<strong>Datum začetka veljavnosti:</strong> 24. maja 2026.
		</p>
		<p class="legal-disclaimer">
			Ta pravilnik pojasnjuje, kako KIFF Cloud obdeluje osebne
			podatke na spletnem mestu, v nadzorni plošči, v API-ju in
			v aplikaciji tafs za iPhone, iPad, Android in računalnike.
			Vprašanja:
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</header>
}

templ privacyWhoWeAreSL() {
	<section id="who-we-are">
		<h2>1. Kdo smo</h2>
		<p>
			KIFF Cloud upravlja <strong>Kiff Agents OÜ</strong>,
			družba z omejeno odgovornostjo, ustanovljena v Estoniji.
			Podatki iz registra:
		</p>
		<ul>
			<li><strong>Registrska številka:</strong> 17372313 (estonski poslovni register e-Business Register)</li>
			<li><strong>Identifikacijska številka za DDV:</strong> EE102924327</li>
			<li><strong>Sedež:</strong> Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estonija</li>
			<li><strong>Kontakt za zasebnost:</strong> <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a></li>
			<li><strong>Uradna pravna obvestila:</strong> <a href="mailto:legal@kiff.dev">legal@kiff.dev</a></li>
		</ul>
		<p>
			Ker ima Kiff Agents OÜ sedež v Evropski uniji, se za našo
			obdelavo neposredno uporablja splošna uredba EU o varstvu
			podatkov
			(<abbr title="General Data Protection Regulation">GDPR</abbr>).
			Predstavnika v EU iz člena 27 ne potrebujemo.
		</p>
	</section>
}

templ privacyScopeSL() {
	<section id="scope">
		<h2>2. Obseg tega pravilnika</h2>
		<p>
			Ta pravilnik zajema osebne podatke, ki jih obdelujemo,
			ko uporabljate:
		</p>
		<ul>
			<li><a href="https://kiff.dev"><code>kiff.dev</code></a> — naše trženjsko spletno mesto, to stran s pravilnikom in javni prikaz potrdil.</li>
			<li><a href="https://app.kiff.dev"><code>app.kiff.dev</code></a> — našo nadzorno ploščo, ki zahteva prijavo.</li>
			<li><a href="https://api.kiff.dev"><code>api.kiff.dev</code></a> — naš HTTP API.</li>
			<li id="tafs"><strong>tafs</strong> — našo aplikacijo za iPhone, iPad, Android in računalnike (Mac, Windows in Linux) ter storitev v njenem ozadju (vključno s Setupom, ki povezuje orodja podjetja, in planque, ki te povezave hrani), v kateri podjetje zaupa nalogo agentu AI, ki dela v okviru KIFF Cards.</li>
		</ul>
		<p>
			Ta pravilnik <em>ne</em> zajema odprtokodnega ogrodja
			<code>kiff/kiff</code>, ki ga lahko poganjate sami.
			Ko ogrodje poganjate v lastni infrastrukturi, ste
			upravljavec vseh podatkov, ki jih obdeluje, Kiff Agents OÜ
			pa pri tej obdelavi ne sodeluje.
		</p>
	</section>
}

templ privacyRolesSL() {
	<section id="roles">
		<h2>3. Naše vloge po GDPR</h2>
		<p>
			Glede na vrsto podatkov nastopamo v dveh vlogah:
		</p>
		<ul>
			<li>
				<strong>Upravljavec</strong> pri metapodatkih računa
				in prijave, podatkih za obračun (ko je obračun
				aktiven), trženjskih sporočilih, na katera se naročite,
				in operativni telemetriji naše lastne storitve.
			</li>
			<li>
				<strong>Obdelovalec</strong> pri revizijskih podatkih,
				zapisih o dejanjih, potrdilih o odločitvah in drugi
				vsebini, ki teče skozi izvajalno okolje v imenu naših
				strank, ter pri tem, kar zanje hrani tafs (zagoni vsakega tafa, klepeti, poročila, zapiski v spominu in datoteke, ki jih dostavijo).
				Upravljavci teh podatkov so stranke (najemniki); navodila
				nam dajejo prek nastavitev svojega računa in
				konfiguracije domene. To razmerje ureja pogodba
				o obdelavi podatkov
				(<abbr title="Data Processing Agreement">DPA</abbr>);
				objavljene pogoje najdete v
				<a href="/legal/dpa">predlogi DPA</a> (v angleščini).
			</li>
		</ul>
		<p>
			Ta pravilnik obravnava predvsem obdelavo, pri kateri smo
			upravljavec. Kjer omenjamo podatke, pri katerih smo
			obdelovalec, je podrobnejši dokument DPA.
		</p>
	</section>
}

templ privacyCategoriesSL() {
	<section id="categories">
		<h2>4. Vrste osebnih podatkov, ki jih obdelujemo</h2>
		<p>
			Spodnje vrste so usklajene s tehničnim popisom na
			<a href="/security#data-we-process">/security#data-we-process</a> (v angleščini).
			Če se strani razlikujeta, velja tehnična stran, ta
			razdelek pa uskladimo z njo.
		</p>
		<ul>
			<li>
				<strong>Identifikatorji računa</strong> — vaš identifikator
				pri nadrejenem preverjanju pristnosti (ki ga izda naš
				ponudnik identitete) in e-poštni naslov, s katerim se
				prijavite. Danes se shranjujeta v izvirni obliki;
				shranjevanje v zgoščeni obliki je načrtovano.
			</li>
			<li>
				<strong>Metapodatki najemnika</strong> — ID najemnika,
				slug, prikazno ime, časovni žig nastanka in jezik, ki ga
				je nazadnje uporabljala aplikacija vsake osebe, da
				e-poštna sporočila, ki ji jih pošilja KIFF, prihajajo
				v tem jeziku.
			</li>
			<li>
				<strong>Poverilnice za API</strong> — nepregledni zapisi
				ključev API (shranjujemo zgoščene vrednosti, nikoli
				navadnega besedila).
			</li>
			<li>
				<strong>Podatki piškotka seje</strong> — piškotek seje,
				podpisan s HMAC, nastavljen po prijavi. Glejte razdelek
				o piškotkih spodaj.
			</li>
			<li>
				<strong>Metapodatki zahtev HTTP</strong> — naslov IP,
				uporabniški agent, pot zahteve, stanje odgovora,
				zakasnitev. Hranijo se v dnevnikih dostopa našega
				povratnega posredniškega strežnika omejen čas zaradi
				varnosti in preprečevanja zlorab.
			</li>
			<li>
				<strong>Vsebina pod nadzorom najemnika</strong> — podatki
				<code>parameters</code>, <code>actor</code> in
				<code>entity</code>, ki jih pošiljate v izvajalno okolje.
				Hranimo jih <em>kot obdelovalec</em> v imenu stranke;
				za to, kar se pošlje, je odgovorna stranka. Konfiguracija
				prikrivanja za posamezne domene je načrtovana.
			</li>
			<li>
				<strong>Komunikacija</strong> — e-poštna sporočila, ki jih
				pošiljate v naše predale za podporo, prodajo, varnost
				ali zasebnost.
			</li>
			<li>
				<strong>Aplikacija tafs</strong> — v tafs se prijavite
				s svojim računom KIFF. Na telefonu ali tablici aplikacija
				hrani vašo sejo v Keychain naprave (v Androidu v njegovi
				šifrirani shrambi). Na računalniku jo hrani zapečateno
				za vaš uporabniški račun: na računalniku z Windows z lastno
				zaščito podatkov sistema Windows, v Linuxu v vaši zbirki
				ključev, na Macu v njegovem Keychain. Seja na računalniku
				traja največ 90 dni.
				Aplikacija ustvari podpisni ključ, ki nikoli ne zapusti
				naprave: v Secure Enclave iPhona, iPada ali Maca,
				v Keystore naprave z Androidom ali v TPM računalnika
				z Windows. V Linuxu in na Macu brez Secure Enclave je
				ključ programski ključ, shranjen v vaši zbirki ključev
				ali v Keychain, in tak računalnik lahko prikaže, kaj vas
				čaka, ne more pa tega odobriti; odobrite na telefonu{ macSecurityKey("sl") }. Računalnik z Windows
				brez TPM se v tafs ne more prijaviti. KIFF hrani javno polovico ključa, ime
				in platformo naprave ter kdaj je bila dodana in nazadnje
				uporabljena, da lahko preverja vaše odgovore na zadržane
				klice in vaše odobritve povezav. Če odobrite s ključem
				za dostop na računalniku, na primer z Windows Hello ali
				varnostnim ključem, vaš obraz,
				prstni odtis ali PIN ostane v lastnem sistemu računalnika;
				KIFF hrani javni ključ ključa za dostop, njegov ID, števec
				in ime, nikoli nič skrivnega, in zavrne ključ za dostop,
				ki se sinhronizira z drugimi napravami. Če vklopite
				opozorila na telefonu, tablici ali Macu z aplikacijo za
				iPad, hranimo potisni žeton naprave z vašim ID-jem osebe
				v KIFF in jezikom, ki ga je aplikacija prikazovala, da
				njena opozorila prihajajo v tem jeziku. Storitev tafs hrani
				tudi jezik računa, glede na to, kdo je nazadnje klepetal
				s Coachem, največ tri mesece, da poročila tafa prihajajo
				v tem jeziku. Opozorilo telefona gre prek Appla ali Googla
				samo s tem, za kateri taf gre in kaj želi, v opozorilu
				vrat pa z imenom ali e-poštnim naslovom tistega, ki je
				pisal: nikoli z zneskom ali podrobnostmi zahteve. Te doda
				aplikacija na sami napravi, od KIFF, tako da lahko
				opozorilo na odklenjenem telefonu prikaže znesek, trgovca
				ali osebo. Na zaklenjenem telefonu z Androidom prikaže
				samo »Taf vas potrebuje«, na zaklenjenem iPhonu prav tako,
				razen če ste nastavili, da se predogledi prikazujejo
				vedno. <strong>Vaša ura:</strong> ura ne hrani nobenega gesla ali ključa, komunicira samo z vašim seznanjenim telefonom in nikoli ničesar ne odobri. To, kar rečete Coachu ali tafu, ki ste ga izbrali, pošlje samo kot besedilo, prek telefona, in šele ko ste dovolili AI. Vaše besede v to besedilo pretvori lastna storitev za prepoznavanje govora ure, Applova ali Googlova. Če se v sistemu Wear OS ustavi, preden končate, to namesto nje opravi lastni prepoznavalnik vašega telefona, na telefonu. Zavrne, ustavi ali pošlje nekaj Coachu ali tafu lahko le, kadar ima zaklep zaslona ali kodo in je odklenjena. To, kar pošljete tafu, gre v lastni klepet tega tafa, kot da bi to napisali na telefonu. Klepet tafa, vključno z zneski, se na uri prikazuje samo, dokler je odprt, in se vsakič prebere prek telefona; ura od njega ne hrani ničesar. <strong>Apple Watch:</strong> prikazuje vaše tafe in njihove strani, ne da bi jih hranila. Hrani samo vaš Nabiralnik, v datoteki, ki je ne more brati, ko je zaklenjena: vsak zadržan klic kot ime njegovega tafa in to, kar prosi, nikoli znesek, ter Coachove odgovore na to, kar ste poslali z ure, kot besedilo. Če se na uri odjavite, hrani tudi to, da ste se, dokler se na uri znova ne prijavite. Razen tega ne hrani ničesar, če ura nima kode. Nabiralnik izgine, ko se odjavite na uri ali se odjavi vaš iPhone, ali ko se aplikacija naslednjič odpre ali zapre brez kode. Ne ustvari nobenega posnetka in edina obvestila, ki jih prikazuje, so obvestila vašega iPhona. <strong>Wear OS:</strong> prikazuje e-poštni naslov vašega računa in današnji koledar, ne da bi ju hranila. Da se odpre takoj, šifrirano hrani število tega, kar vas čaka, ter ime vsakega tafa in ali je ustavljen ali začasno ustavljen: nikoli zneska, podrobnosti zadržanega klica ali klepeta tafa. To se izbriše, ko se odjavite, ko se ura zaklene ali jo snamete z zapestja, in po 24 urah. Hrani vaš Nabiralnik, kjer je vsaka vrstica ime tafa in to, kar pravi, nikoli znesek, ter eno sporočilo, shranjeno za pozneje, kot besedilo. Odjava, na uri ali na telefonu, vse to izbriše. Za svojo ploščico hrani tudi število tega, kar vas čaka, prikazano le, ko je ura odklenjena, in izbrisano, ko se odjavite, ali ko se ploščica naslednjič prikaže, ko je ura zaklenjena ali nima zaklepa zaslona. Po odjavi na uri hrani zapisek, da ste se odjavili, dokler se znova ne prijavite. Nabiralnik izgine tudi, ko se aplikacija naslednjič odpre ali zapre, ko je ura zaklenjena ali nima zaklepa zaslona. Sporočilo, shranjeno za pozneje, ostane, dokler ga ne pošljete ali izbrišete, ker ste zahtevali, da se pošlje. Če se storitev za prepoznavanje govora ure ustavi, preden končate, ura pošlje posnetek vašemu telefonu, ki ga pretvori v besedilo na samem telefonu, nikoli na strežniku. Posnetek se izbriše na obeh, ko se besedilo vrne ali prekličete, in najpozneje po 2 minutah. Coachu ali vašemu tafu gre naprej samo besedilo. Rezultat tafa lahko ostane med obvestili ure, dokler ga ne zavrnete ali se na uri ne odjavite. Na računalniku z Windows,
				računalniku z Linuxom ali Macu z aplikacijo za macOS 12
				opozorila ustvari aplikacija sama, dokler teče, brez
				potisnega žetona in brez katerega koli drugega podjetja.
				V Windows in Linuxu prikazujejo, za kateri taf gre, kaj
				želi narediti, znesek, zakaj in do kdaj; v aplikaciji za
				macOS 12 prikazujejo besede KIFF za klic, ko jih vklopite,
				zaklenjen zaslon pa prikaže to, kar dovoli nastavitev
				predogledov na Macu. V Windows so izklopljena,
				dokler jih ne vklopite, in ko je zaslon zaklenjen,
				prikazujejo samo »Taf vas potrebuje«. Opozorilo, prikazano
				pred zaklepom zaslona, ohrani svoje podrobnosti na seznamu
				obvestil Windows. V Linuxu so vklopljena, dokler jih ne
				izklopite, kaj prikaže zaklenjen zaslon, pa je odvisno od
				vašega namizja. Ko
				povežete orodje, se prijavite pri lastnem ponudniku orodja. Za aplikacijo, v katero se planque prijavi sam, na primer Stripe, ali za ključ, ki ga vnesete, planque ta žeton ali ključ za vaše podjetje hrani šifrirano; pri upravljani povezavi prijavo hrani Composio, storitev za povezave, s katero sodeluje planque, planque pa hrani samo zapis povezave in orodja, ki ste jih odobrili (vse kot obdelovalec, glejte spodaj). Zapis povezave lahko vključuje račun, v katerega je prijavljena (njegovo ime ali e-poštni naslov), da vam aplikacija lahko pokaže, za katerega gre. KIFF uporablja upravljane povezave samo za aplikacije, navedene na <a href="/subprocessors#composio">/subprocessors</a> (v angleščini). Aplikacija nima analitičnih ali
				oglaševalskih sledilnikov.
			</li>
			<li>
				<strong>Nakupi v App Store</strong> — ko v tafs kupite Solo
				ali paket kreditov, vam ga proda Apple: Apple je
				prodajalec, prejme plačilo in hrani vaše plačilne
				podatke. Apple nam sporoči, kaj je bilo kupljeno, za kateri
				račun KIFF (naključni ID, ki ga aplikacija priloži nakupu),
				kdaj, Applov ID transakcije in pri Solo, kdaj se obdobje
				konča ali podaljša. To uporabimo, da vašemu računu dodamo
				kredite ali paket. Apple nam ne sporoči vašega Apple ID-ja,
				imena, e-poštnega naslova ali kartice.
			</li>
			<li>
				<strong>Nakupi v Google Play</strong> — v Androidu gredo
				isti nakupi skozi obračunavanje Google Play:
				Google prejme plačilo in hrani vaše plačilne
				podatke. Google nam sporoči, kaj je bilo kupljeno, za
				kateri račun KIFF (isti naključni ID), kdaj, žeton in ID
				naročila nakupa ter pri Solo, kdaj se obdobje konča ali
				podaljša, in to uporabimo na enak način.
				Google nam ne sporoči vašega računa Google, imena,
				e-poštnega naslova ali kartice.
			</li>
		</ul>
	</section>
}

templ privacyLawfulBasesSL() {
	<section id="lawful-bases">
		<h2>5. Pravne podlage za obdelavo</h2>
		<p>
			V skladu s členom 6 GDPR se opiramo na naslednje pravne
			podlage:
		</p>
		<ul>
			<li>
				<strong>Izvajanje pogodbe</strong> (točka (b) člena
				6(1)) — za ustvarjanje računa, preverjanje pristnosti,
				delovanje izvajalnega okolja v vašem imenu, obračun (ko
				je aktiven) in osrednje dele storitve.
			</li>
			<li>
				<strong>Zakoniti interesi</strong> (točka (f) člena 6(1))
				— za varnost, preprečevanje goljufij, odkrivanje zlorab,
				operativno telemetrijo in zaščito storitve.
				Svoje interese tehtamo z vašimi pravicami in vam bomo na
				zahtevo povedali, kakšen je bil izid tega tehtanja.
			</li>
			<li>
				<strong>Privolitev</strong> (točka (a) člena 6(1)) — za AI v aplikaciji tafs: kaj se pošlje modelu AI, ki poganja Coacha in vaše tafe, kot je opisano <a href="#ai-in-tafs">spodaj</a>. Nič se ne pošlje, dokler tega ne dovolite, privolitev pa lahko prekličete v Računu. Za privolitev bi vas prosili tudi pred kakršnimi koli analitičnimi piškotki, neobveznimi trženjskimi sporočili ali novo obdelavo, ki bistveno razširi našo uporabo vaših podatkov. Ne izvajamo nobene analitike, nobenega oglaševanja in nobenega nebistvenega sledenja.
			</li>
			<li>
				<strong>Pravna obveznost</strong> (točka (c) člena 6(1))
				— za davčne evidence (estonski zakon o računovodstvu §12, 7
				let), odgovore na zakonite zahteve organov in hrambo, ki jo
				zahtevajo predpisi o preprečevanju pranja denarja, kjer se
				uporabljajo.
			</li>
		</ul>
		<h3 id="ai-in-tafs">AI v aplikaciji tafs</h3>
		<p>Aplikacija tafs vas vpraša, preden karkoli gre k AI, s temi besedami:</p>
		<ul>
			<li>tafs za Coacha in vaše tafe uporablja AI Claude podjetja Anthropic.</li>
			<li>Coach in vaši tafi so agenti AI: kar pišejo, ustvari AI in je lahko napačno. Sporočilo, ki ga taf pošlje zunaj vašega podjetja, navaja, da ga je napisal agent AI.</li>
			<li>Kaj se ji pošlje: kar pišete Coachu in svojim tafom, datoteke, ki jih priložite, kar vaše povezane aplikacije vrnejo tafu med delom, in kar je na vašem zaslonu, ko vam Coach pomaga v aplikaciji.</li>
			<li>Česa se nikoli ne pošlje: gesel in ključev, ki jih uporabljajo vaše povezane aplikacije, ali vašega prstnega odtisa.</li>
			<li>Anthropic to uporabi za odgovor in hrani največ 30 dni.</li>
			<li>Nič se ne pošlje, dokler tega ne dovolite. Privolitev lahko prekličete v Računu.</li>
		</ul>
		<p>Taf, ki teče, ne da bi bil v tistem trenutku kdo zraven (po svojem urniku ali ko nekaj prispe), temelji na privolitvi osebe, ki ga je ustvarila ali prevzela, sicer pa na privolitvi prve osebe, ki upravlja tafe računa in ga dovoli.</p>
		<p><strong>Ko privolitev prekličete,</strong> vam Coach in vaši tafi prenehajo odgovarjati. Taf, katerega zagoni temeljijo na vaši privolitvi, se začasno ustavi: njegovi urniki se ustavijo, kar prispe, pa čaka. Nadaljuje, ko je privolitev znova dana ali ga s svojo privolitvijo prevzame nekdo, ki upravlja tafe računa. Preklic ne spremeni tega, kar je bilo poslano prej.</p>
		<p>Anthropic je naveden na <a href="/subprocessors">/subprocessors</a> (v angleščini), skupaj s tem, kje obdeluje podatke in kdaj jih lahko hrani dlje.</p>
	</section>
}

templ privacySubprocessorsSL() {
	<section id="sub-processors">
		<h2>6. Podobdelovalci</h2>
		<p>Vaših osebnih podatkov ne prodajamo in jih ne delimo za oglaševanje.</p>
		<p>
			Za zagotavljanje storitve uporabljamo majhen krog
			ponudnikov. Uradni, aktualni seznam je na
			<a href="/subprocessors">/subprocessors</a> (v angleščini);
			ta stran se posodobi v 30 dneh od vsake spremembe. Od
			vsakega podobdelovalca s pisnimi pogodbami zahtevamo
			zaščito, enakovredno naši, vključno s standardnimi
			pogodbenimi klavzulami EU, kadar osebni podatki zapustijo
			EU.
		</p>
		<p>
			O bistvenih dodatkih ali zamenjavah podobdelovalcev, ki
			vplivajo na osebne podatke, aktivne stranke obvestimo
			vnaprej, s pravico do ugovora.
		</p>
	</section>
}

templ privacyTransfersSL() {
	<section id="transfers">
		<h2>7. Mednarodni prenosi</h2>
		<p>
			Nekateri naši podobdelovalci imajo sedež zunaj Evropskega
			gospodarskega prostora, predvsem v Združenih državah. Za
			vsak tak prenos se opiramo na vsaj eno od naslednjih
			zaščitnih ukrepov:
		</p>
		<ul>
			<li>
				<strong>Okvir EU-ZDA za zasebnost podatkov</strong> — za
				podobdelovalce v ZDA, ki so pridobili potrdilo po tem
				okviru. Sklep o ustreznosti velja od sredine leta 2023;
				spremljamo vsako spremembo njegovega statusa.
			</li>
			<li>
				<strong>Standardne pogodbene klavzule</strong> —
				modul 2 (upravljavec–obdelovalec) za naše neposredne
				podobdelovalce in modul 3 (obdelovalec–podobdelovalec),
				kjer gre za verigo obdelovalcev. Uporabljamo klavzule,
				ki jih je Komisija odobrila leta 2021.
			</li>
			<li>
				<strong>Dodatni ukrepi</strong> — kjer ocena tveganja
				kaže, da so upravičeni dodatni zaščitni ukrepi
				(šifriranje med prenosom in v mirovanju, beleženje
				dostopa, najmanjši obseg podatkov).
			</li>
		</ul>
		<p>
			Konkretni instrument prenosa, ki velja za posameznega
			podobdelovalca, lahko zahtevate po e-pošti na
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
		<p><strong>Vaša država.</strong> Zakoni nekaterih držav zahtevajo več, kot pove ta pravilnik. Kaj dodajajo, v angleščini in v jeziku države, je na strani <a href="/privacy/countries">Vaša država</a>.</p>
	</section>
}

templ privacyRetentionSL() {
	<section id="retention">
		<h2>8. Hramba</h2>
		<p>
			Osebne podatke hranimo najkrajši čas, ki je skladen
			z nameni, za katere jih obdelujemo, in z morebitno
			veljavno pravno obveznostjo.
		</p>
		<ul>
			<li>
				<strong>Metapodatki računa in prijave</strong> —
				do izbrisa računa. V aplikaciji tafs ga lastnik izbriše
				v Račun → <em>Izbriši
				račun</em>. Račun, ustvarjen na spletu, se izbriše
				na podlagi e-pošte na
				<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>,
				v enomesečnem roku iz člena 12(3) GDPR.
				V obeh primerih ključi računa takoj prenehajo delovati.
				Izbrisa v aplikaciji tafs ni mogoče razveljaviti: klepeti,
				zapiski in povezave njegovih tafov se takoj izbrišejo, kar
				hrani KIFF, pa se izbriše v 30 dneh. Pri izbrisu na
				spletu njegove podatke hranimo v prehodnem obdobju 30 dni,
				če bi jih lastnik želel nazaj, nato jih izbrišemo.
			</li>
			<li>
				<strong>Zapisi ključev API</strong> — do izbrisa računa,
				tudi ko je ključ preklican. Ključ, ki pripada povezavi
				agenta prek prijave, se izbriše skupaj s to povezavo,
				30 dni po njenem koncu.
			</li>
			<li>
				<strong>Piškotki seje</strong> — do poteka (privzeto 24
				ur) ali do odjave.
			</li>
			<li>
				<strong>Dnevniki dostopa povratnega posredniškega strežnika</strong> — največ 90
				dni, nato se združijo ali izbrišejo.
			</li>
			<li>
				<strong>Dnevniki storitev</strong> — kar storitve KIFF
				in planque beležijo med delovanjem: napake in zahteve,
				ki lahko navajajo račun, osebo ali agenta. 30
				dni, nato se izbrišejo.
			</li>
			<li>
				<strong>Varnostne kopije</strong> — zbirka podatkov KIFF
				se varnostno kopira dnevno, šifrirano, vsaka kopija pa
				se hrani 7 dni, zato izbrisan zapis iz njih izgine
				v 7 dneh.
				Shrambi tafs in planque hranita šifrirane kopije na
				določeno točko v času 35 dni, ki se uporabljajo samo za
				obnovitev shrambe po okvari, zato izbrisan zapis iz njih
				izgine v 35 dneh.
			</li>
			<li>
				<strong>Revizijski podatki najemnika</strong> — hranjeni
				kot obdelovalec v skladu s konfiguracijo najemnika
				stranke. Privzeto: hranijo se ves čas obstoja najemnika;
				izbrišejo se ob izbrisu najemnika. Glejte
				<a href="/security#deletion">/security#deletion</a> (v angleščini).
			</li>
			<li>
				<strong>Klici prek prehoda KIFF</strong> — argumenti
				klica, dokler ni poslan, zavrnjen ali neuspešen,
				nato se izbrišejo; rezultat orodja 24 ur, nato se
				izbriše. Zapis o odločitvi in zgoščena vrednost
				argumentov se hranita kot revizijski podatki najemnika.
				Glejte
				<a href="/security#data-kept">/security#data-kept</a> (v angleščini).
			</li>
			<li>
				<strong>Uporaba</strong> — za vsak klic prek prehoda,
				ko se konča: kateri agent ga je opravil, orodje in ali
				se je štel kot dejanje ali je bil brezplačen (in zakaj).
				Za vsak zagon tafa ali Coacha, ko se konča: taf, kdaj,
				krediti, ki jih je porabila njegova AI, in ali so se šteli
				ali zakaj ne. Do izbrisa računa; kar se za obračun sporoči
				našemu ponudniku plačilnih storitev, se hrani skupaj
				z obračunskimi evidencami.
			</li>
			<li>
				<strong>Povezave agentov prek prijave</strong> — kateri
				agent, ime aplikacije, kdo jo je dovolil, kdaj in njena
				zadnja uporaba: dokler je povezava aktivna, nato 30
				dni po njenem koncu (ves ta čas ostane navedena
				v nadzorni plošči), nato se izbriše skupaj z žetoni
				in ključem API. Vse se izbriše skupaj z računom.
			</li>
			<li>
				<strong>tafs</strong> — potisni žeton naprave, dokler se
				ne odjavite iz aplikacije, ne odstranite naprave ali Apple
				ali Google ne sporoči, da žetona ni več. Javni ključ,
				ime, platforma in datumi naprave, dokler jo uporabljate;
				ko jo odjavite, se označi kot odstranjena in hrani do
				izbrisa računa, da lahko KIFF zavrne njen pozni odgovor
				in pokaže, katera naprava je podpisala prejšnjega. Javni
				ključ, ID in ime ključa za dostop se hranijo kot podatki
				njegove naprave. Računalnik hrani svojo sejo največ
				90 dni ali do odjave. Kar tafs hrani za
				vaše podjetje, se hrani kot obdelovalec: zagoni in
				klepeti tafa, s povzetkom klepeta (in Setupa), 30 dni,
				kar vrnejo vaša orodja, samo do konca zagona (v klepetu
				se to, kar je le prebral, hrani šifrirano za njegova
				naslednja sporočila, uporablja se, dokler klepet ni eno
				uro nedejaven, in največ štiri ure po branju, nato se
				samodejno izbriše, v nekaj dneh), in njegovi zapiski
				v spominu do odstranitve
				tafa; datoteke, ki jih dostavi, 30 dni od zagona, ki jih je ustvaril, nato se samodejno izbrišejo v enem dnevu, ali prej, če katero izbriše nekdo iz vašega računa; žeton ali ključ povezave v planque ali prijava upravljane povezave pri Composiu, dokler je ne prekinete (če lahko isti račun pri tem ponudniku uporablja druga od vaših povezav, se hrani neuporabljen, dokler ne prekinete tudi te), in zapis njenih odobritev
				do konca računa; glejte
				<a href="/legal/dpa#annex-4">Prilogo 4 k DPA</a> (v angleščini).
			</li>
			<li>
				<strong>Obračunske evidence</strong> — 7 let od
				konca poslovnega leta (estonski zakon o računovodstvu
				§12).
			</li>
			<li>
				<strong>Nakupi v App Store in Google Play</strong> —
				kar sta nam Apple ali Google sporočila o vsakem nakupu,
				ostane v vašem računu do izbrisa računa. Njuna
				poročila o prodaji in izplačilih, ki jih hranimo kot
				obračunske evidence 7 let, vas ne navajajo.
			</li>
			<li>
				<strong>Korespondenca s podporo</strong> — 3 leta
				od zadnje interakcije, nato se izbriše.
			</li>
		</ul>
	</section>
}

templ privacyRightsSL() {
	<section id="rights">
		<h2>9. Vaše pravice</h2>
		<p>
			V skladu z GDPR imate v zvezi s svojimi osebnimi podatki
			naslednje pravice:
		</p>
		<ul>
			<li><strong>Dostop</strong> (člen 15) — potrditev, ali obdelujemo vaše podatke, in njihova kopija.</li>
			<li><strong>Popravek</strong> (člen 16) — popravek netočnih ali nepopolnih podatkov.</li>
			<li><strong>Izbris</strong> (člen 17) — izbris vaših podatkov, ob upoštevanju izjem za zakonsko hrambo.</li>
			<li><strong>Omejitev</strong> (člen 18) — začasna ustavitev obdelave, dokler se spor ne reši.</li>
			<li><strong>Prenosljivost</strong> (člen 20) — strojno berljiv izvoz podatkov, ki ste jih zagotovili.</li>
			<li><strong>Ugovor</strong> (člen 21) — zoper obdelavo na podlagi zakonitih interesov; prenehamo, razen če dokažemo prevladujoče razloge.</li>
			<li><strong>Preklic privolitve</strong> (člen 7(3)) — za vsako obdelavo na podlagi privolitve, na primer AI v aplikaciji tafs (v Računu, kot je navedeno <a href="#ai-in-tafs">zgoraj</a>). Preklic ne vpliva na predhodno zakonito obdelavo.</li>
		</ul>
		<p>
			Katero koli od teh pravic uveljavljate po e-pošti na
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
			Odgovorimo v enem mesecu v skladu s členom 12(3); pri
			zapletenih zahtevah lahko rok podaljšamo za največ dva
			dodatna meseca, o čemer vas obvestimo.
		</p>
		<h3 id="export-chats">Vaši lastni klepeti v tafs</h3>
		<p>
			V aplikaciji tafs Račun →  Izvozi moje klepete
			prenese vaše lastne klepete z vsakim tafom, vključno
			s Coachem, imena datotek, ki ste jih priložili, in vaše
			lastne zapiske, kot berljivo datoteko in kot JSON. Izvozite
			jih lahko samo vi: skrbnik ali lastnik računa tega ne
			more, izvoz računa KIFF pa jih ne vključuje.
		</p>
		<h3 id="delete-account">Izbris vašega računa tafs</h3>
		<p>
			tafs je aplikacija KIFF. Za izbris računa tafs in njegovih
			podatkov:
		</p>
		<ol>
			<li>Odprite aplikacijo tafs in se prijavite.</li>
			<li>Pojdite v Račun in tapnite <em>Izbriši račun</em>.</li>
			<li>Potrdite. Izbrisa računa ni mogoče razveljaviti.</li>
		</ol>
		<p>
			<em>Izbriši račun</em> se prikaže tistemu, ki sme izbrisati
			račun podjetja, običajno njegovemu lastniku. Če te možnosti
			ne vidite ali aplikacije nimate več, pišite na
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			z naslova, s katerim se prijavljate, in vaše podatke
			izbrišemo v enem mesecu.
		</p>
		<p>
			Kaj se izbriše: ključi računa takoj prenehajo delovati.
			Njegovi tafi, klepeti, zapiski, priložene datoteke in
			povezave se takoj izbrišejo, iz kopij na določeno točko
			v času pa v 35 dneh. Kar KIFF hrani za račun, se
			izbriše v 30 dneh, iz varnostnih kopij pa v 7 dneh
			po tem. Dnevniki storitev, ki navajajo račun, izginejo
			v 30 dneh. Revizijski podatki najemnika se izbrišejo
			skupaj z najemnikom. Za vsako vrsto podatkov glejte <a href="#retention">Hramba</a>.
		</p>
		<p id="delete-data">
			Za izbris dela podatkov ob ohranitvi računa: v
			aplikaciji izbrišite klepet in njegova sporočila in
			priložene datoteke izginejo z njim; odstranite taf in
			njegovi klepeti, zapiski in povezave izginejo z njim. Za
			vse drugo pišite na
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			in navedite, kaj naj izbrišemo. To storimo v enem mesecu.
		</p>
		<p>
			Pravico imate vložiti pritožbo pri
			nadzornem organu. Naš vodilni nadzorni organ
			je
			<a href="https://www.aki.ee/en" target="_blank" rel="noopener">estonski inšpektorat za varstvo podatkov (Andmekaitse Inspektsioon)</a>.
			Pritožbo lahko vložite tudi pri nadzornem organu
			države članice, v kateri prebivate.
		</p>
		<p><strong>Vaša država.</strong> Zakoni nekaterih držav zahtevajo več, kot pove ta pravilnik. Kaj dodajajo, v angleščini in v jeziku države, je na strani <a href="/privacy/countries">Vaša država</a>.</p>
	</section>
}

templ privacyCookiesSL() {
	<section id="cookies">
		<h2>10. Piškotki</h2>
		<p>
			Nastavljamo tri piškotke, vse nujno potrebne, lastne,
			poslane samo prek HTTPS in neberljive za skripte na strani.
			Po pravilih EU o e-zasebnosti ne zahtevajo privolitve;
			navajamo jih, da veste zanje. Podrobnosti vsebuje
			<a href="/cookies">pravilnik o piškotkih</a> (v angleščini).
		</p>
		<ul>
			<li>
				<strong><code>kiff_session</code></strong> — ohranja vas
				prijavljene. Podpisan piškotek seje, ki nosi ID vaše
				prijave, e-poštni naslov in ime ter poverilnico, ki jo
				za vas uporablja nadzorna plošča. Nastavljen za <code>.kiff.dev</code>.
				Traja 24 ur ali do odjave.
			</li>
			<li>
				<strong><code>kiff_flash</code></strong> — prenese
				enkratno sporočilo na naslednjo stran, na primer »vaš ključ
				je bil ustvarjen«. Podpisan; nov ključ ni nikoli v njem.
				Nastavljen za <code>.kiff.dev</code>. Izbriše se, ko ga
				naslednja stran prebere, in najpozneje po 5 minutah.
			</li>
			<li>
				<strong><code>kiff_cb_attempts</code></strong> — šteje,
				kolikokrat se je stran za prijavo znova naložila, da se
				prijava, ki se zacikla, ustavi. Pošlje se samo tej strani.
				Traja 5
				minut in se izbriše, ko se prijava začne ali uspe.
			</li>
		</ul>
		<p>
			Ne uporabljamo analitičnih piškotkov, oglaševalskih
			piškotkov ali kakršnih koli sledilnikov tretjih oseb. Če
			bi jih kdaj dodali, bi pred nastavitvijo piškotka prikazali
			pasico za privolitev, v skladu z e-zasebnostjo in
			smernicami EDPB iz leta 2023 o tehnologijah sledenja.
		</p>
		<p>
			Če se prijavite prek Clerka (našega podobdelovalca za
			preverjanje pristnosti), Clerk nastavi piškotke tudi na
			svoji lastni sprednji domeni (<code>clerk.kiff.dev</code>). Ti
			piškotki so potrebni, da vas Clerk prepozna med svojim
			postopkom prijave, zanje pa veljata pravilnik o zasebnosti
			Clerka in naš. Podrobnosti so na seznamu podobdelovalcev.
		</p>
	</section>
}

templ privacySecuritySL() {
	<section id="security">
		<h2>11. Varnost</h2>
		<p>
			Naši tehnični in organizacijski varnostni ukrepi so
			opisani na <a href="/security">/security</a> (v angleščini).
			Vključujejo ločevanje najemnikov na ravni zbirke podatkov,
			TLS 1.2+ med prenosom, šifriranje v mirovanju s privzetimi
			nastavitvami upravljanega ponudnika in nadzor dostopa po
			načelu najmanjših pooblastil.
		</p>
		<p>
			O kršitvi varnosti osebnih podatkov prizadete stranke
			obvestimo brez nepotrebnega odlašanja in v 72 urah od
			potrditve, v skladu s členom 33 GDPR. Obvestilo vključuje
			naravo kršitve, vrste in približno število zadevnih
			posameznikov in zapisov, verjetne posledice ter sprejete
			ali predlagane ukrepe.
		</p>
	</section>
}

templ privacyChildrenSL() {
	<section id="children">
		<h2>12. Otroci</h2>
		<p>
			KIFF Cloud je izdelek razvijalske infrastrukture, ki ni
			namenjen otrokom. Zavestno ne zbiramo osebnih podatkov
			otrok, mlajših od 16 let. Če menite, da nam je otrok
			posredoval osebne podatke, se obrnite na
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			in jih bomo izbrisali.
		</p>
	</section>
}

templ privacyAutomatedSL() {
	<section id="automated">
		<h2>13. Avtomatizirano sprejemanje odločitev</h2>
		<p>
			Izvajalno okolje KIFF Cloud sprejema deterministične
			odločitve po pravilih na podlagi podatkov, ki jih pošiljajo
			naše stranke. To niso odločitve o vas, ki bi imele pravne
			ali podobno pomembne učinke v smislu člena 22 GDPR; to so
			odločitve o dejanjih stranke (vračila, naročila, sporočila
			in podobno), izvedenih po lastnih pravilih stranke.
		</p>
		<p>
			Stranke, ki KIFF Cloud uporabljajo za odločitve, ki
			vplivajo na njihove lastne končne uporabnike, so same
			odgovorne za skladnost s členom 22. Naša potrdila
			o upravljanju so zasnovana tako, da tem strankam dajo
			revizijsko sled, ki jo potrebujejo za dokazovanje
			človeškega nadzora, pravna obveznost zagotavljanja tega
			nadzora pa je na
			stranki.
		</p>
	</section>
}

templ privacyChangesSL() {
	<section id="changes">
		<h2>14. Spremembe tega pravilnika</h2>
		<p>
			Ta pravilnik lahko občasno posodobimo. O bistvenih
			spremembah aktivne stranke obvestimo po e-pošti in
			z opazno pasico na tej strani najmanj 30 dni.
			Nebistvene spremembe objavimo z novim datumom
			»zadnje posodobitve«.
		</p>
	</section>
}

templ privacyContactSL() {
	<section id="contact">
		<h2>15. Kontakt</h2>
