package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsPrivacyJA is tafs's privacy policy (/tafs/privacy) in Japanese, at
// /ja/tafs/privacy. It is a translation of TafsPrivacy: the same sections,
// anchors, links and figures, held to it by
// TestTranslationsKeepTheEnglishPage. The English page governs. Change the
// English page first, then this one. Japanese has the four legal pages only,
// so a link to another page goes to its English version, marked （英語）.
templ TafsPrivacyJA() {
	@components.LayoutSiteWithMeta("tafsプライバシーポリシー", "KIFFのアプリtafsが個人データをどのように取り扱うか。Googleアカウントを接続したときにGoogleから受け取るデータを含みます。", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · プライバシーポリシー</p>
				<h1>tafsプライバシーポリシー</h1>
				<p class="legal-meta"><strong>最終更新日：</strong>2026年11月25日</p>
				<p class="legal-disclaimer">このポリシーは、iPhone、iPad、Android、コンピューター向けのKIFFのアプリであるtafsが、個人データをどのように取り扱うかを説明します。tafsはKIFF Cloudの一部であるため、<a href="/ja/privacy">KIFFのプライバシーポリシー</a>もtafsに適用され、このページが扱っていない事項にも適用されます。お問い合わせ：<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>。</p>
			</header>
			<section id="who-we-are">
				<h2>1. 私たちについて</h2>
				<p>tafsは、エストニアで設立された非公開有限責任会社である<strong>Kiff Agents OÜ</strong>（登録コード 17372313、VAT番号 EE102924327、所在地 Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estonia）が提供します。私たちの処理には、EU一般データ保護規則（GDPR）が適用されます。</p>
			</section>
			<section id="scope">
				<h2>2. このポリシーの対象</h2>
				<p>iPhone、iPad、Android、コンピューター（Mac、Windows、Linux）向けのtafsアプリと、その背後にあるサービスです。これには、会社のツールを接続するセットアップと、それらの接続を保持するplanqueが含まれます。tafsでは、会社が仕事をAIエージェントであるtafに任せ、tafはKIFF Cardの範囲内で働きます。</p>
			</section>
			<section id="roles">
				<h2>3. 私たちの役割</h2>
				<p>私たちは、あなたのアカウントとサインインのデータ、および私たち自身のサービスの運用データの<strong>管理者</strong>です。tafsがあなたの会社のために保持するもの、すなわち各tafの実行、チャット、レポート、メモ、tafが届けるファイルについては、あなたの会社に代わって<strong>処理者</strong>として行動します。そのデータの管理者はあなたの会社であり、その関係は<a href="/legal/dpa">DPA</a>（英語）が規律します。</p>
			</section>
			<section id="data">
				<h2>4. tafsが収集するもの</h2>
				<ul>
					<li><strong>あなたのアカウント：</strong>tafsにはKIFFアカウントでサインインします。スマートフォンやタブレットでは、アプリはセッションをデバイスのキーチェーン（Androidでは暗号化されたストレージ）に保持します。コンピューターでは、セッションをあなたのユーザーアカウント用に封印して保持します。Windows PCではWindows自体のデータ保護で、Linuxではキーリングに、Macではキーチェーンに保持します。コンピューターのセッションは最長90日間有効です。</li>
					<li><strong>あなたのデバイス：</strong>アプリは、デバイスから決して出ない署名鍵を作成します。iPhone、iPad、MacではSecure Enclaveに、AndroidデバイスではKeystoreに、Windows PCではTPMに作成します。Linux、およびSecure EnclaveのないMacでは、鍵はキーリングまたはキーチェーンに保持されるソフトウェア鍵であり、そのコンピューターはあなたを待っているものを表示できますが、承認はできません。承認はスマートフォンで{ macSecurityKey("ja") }行います。TPMのないWindows PCはtafsにサインインできません。KIFFは、保留中の呼び出しへのあなたの回答と接続の承認を確認できるよう、鍵の公開部分、デバイスの名前とプラットフォーム、追加された日時と最後に使われた日時を保持します。</li>
					<li><strong>あなたのウォッチ：</strong>ウォッチはパスワードも鍵も保持せず、ペアリングしたスマートフォンとだけ通信し、承認を行うことはありません。あなたがAIを許可した後に限り、あなたが話したことを、テキストとしてのみ、スマートフォンを通じてCoachまたはあなたが選んだtafに送ります。話した言葉をそのテキストに変換するのは、ウォッチ自体の音声サービス（AppleまたはGoogleのもの）です。Wear OSでは、話し終える前にそれが停止した場合、代わりにスマートフォン自体の音声認識がスマートフォン上で変換します。ウォッチが拒否、遮断、またはCoachやtafへの送信を行えるのは、画面ロックまたはパスコードが設定されていて、ロックが解除されている間に限られます。tafに送ったものは、スマートフォンで書いた場合と同じように、そのtaf自身のチャットに入ります。tafのチャットは金額も含め、開くたびにスマートフォン経由で読み込まれ、ウォッチが保持するのは、下の各ウォッチの項目で説明する最近のメッセージだけです。アプリが閉じているときは、スマートフォンが新しい回答やメッセージを、システム自身のスマートフォンとウォッチ間の連携（Apple WatchではApple、Wear OSではGoogle Play開発者サービス）を通じてウォッチへ渡します。この連携は、ウォッチが受け取るまでの間だけスマートフォンとウォッチに保持します。スマートフォンを起こす通知には言葉は含まれません。ウォッチを見ていないときに届いた回答は、iPhoneとApple Watch、またはWear OSのウォッチに通知としても表示されます。言葉は表示されますが金額は表示されず、消去するまで残ります。ロック中のWear OSのウォッチには、回答の準備ができたことだけが表示されます。</li>
					<li><strong>Apple Watch：</strong>tafとそのページを、保持せずに表示します。受信トレイは、ロック中は読めないファイルに保存されます。受信トレイの内容は、保留中の各呼び出しについてのtafの名前とその求めている内容（金額は含みません）、およびウォッチから送ったものに対するCoachの返信をテキストにしたものです。ウォッチでサインアウトした場合は、サインアウトしたことも、ウォッチで再びサインインするまで保持します。それ以外は、ウォッチにパスコードが設定されていない限り何も保持しません。受信トレイは、ウォッチでサインアウトしたとき、iPhoneがサインアウトしたとき、またはパスコードのない状態で次にアプリが開くか閉じるときに消去されます。録音は行わず、表示する通知はiPhoneの通知だけです。スレッドをすぐに開けるよう、ウォッチで開いた最大20件のスレッド（Coachのものとあなたのtafのもの）について、それぞれ直近30件のメッセージもテキストのみで、金額は含めず、受信トレイと同じくロックして保持します。受信トレイが削除されるとき、また30日間開かれなかったスレッドは削除されます。Coachへのメッセージを後で送るために残すと、そのひとつのメッセージもテキストとして、受信箱と同じようにロックされた専用のファイルに保持し、iPhoneが戻ったときに送信します。送信後、削除したとき、あなたかiPhoneがサインアウトしたとき、またはウォッチにパスコードがなくなったときに削除されます。</li>
					<li><strong>Wear OS：</strong>アカウントのメールアドレスと今日のカレンダーを、保持せずに表示します。すぐに開けるよう、あなたを待っているものの件数と、各tafの名前および遮断中か一時停止中かを、暗号化して保持します。金額、保留中の呼び出しの詳細、tafのチャットは保持しません。これは、サインアウトしたとき、ウォッチがロックされたとき、ウォッチが手首から外れたとき、および24時間後に消去されます。受信トレイも保持します。受信トレイの各行はtafの名前とその伝えている内容で、金額は含みません。また、後で送るために保存したメッセージ一件をテキストとして保持します。ウォッチまたはスマートフォンでサインアウトすると、そのすべてが消去されます。タイル用に、あなたを待っているものの件数も保持します。これはウォッチのロックが解除されている間だけ表示され、サインアウトしたとき、またはウォッチがロック中か画面ロックが設定されていない状態で次にタイルが表示されるときに消去されます。ウォッチでサインアウトした後は、サインアウトしたという記録を、再びサインインするまで保持します。受信トレイは、ウォッチがロック中か画面ロックが設定されていない状態で次にアプリが開くか閉じるときにも消去されます。後で送るために保存したメッセージは、あなたが送信を求めたものであるため、あなたが送信するか削除するまで残ります。話し終える前にウォッチの音声サービスが停止した場合、ウォッチは録音をスマートフォンに送り、スマートフォンはそれをスマートフォン自体の上でテキストに変換します。サーバー上で変換することはありません。録音は、テキストが戻ったとき、またはあなたがキャンセルしたときに両方の端末から削除され、遅くとも2分後には削除されます。Coachまたはあなたのtafに送られるのはテキストだけです。tafの結果は、あなたが閉じるか、ウォッチでサインアウトするまで、ウォッチの通知に残ることがあります。スレッドをすぐに開けるよう、ウォッチで開いた最大20件のスレッド（Coachのものとあなたのtafのもの）について、それぞれ直近30件のメッセージもテキストのみで、金額は含めず、暗号化して保持します。ウォッチまたはスマートフォンでサインアウトしたとき、また30日間開かれなかったスレッドは削除され、画面ロックのないウォッチでは何も保持しません。後で送るために残したメッセージは、ウォッチの画面ロックがなくなった場合にも削除されます。</li>
					<li><strong>パスキー：</strong>コンピューターでパスキー（Windows Helloやセキュリティキーなど）を使って承認する場合、あなたの顔、指紋、PINはコンピューター自体のシステムにとどまります。KIFFが保持するのは、パスキーの公開鍵、そのID、カウンター、名前で、秘密情報は一切保持しません。また、他のデバイスに同期されるパスキーは拒否します。</li>
					<li><strong>通知：</strong>スマートフォン、タブレット、またはiPadアプリを実行しているMacで通知をオンにすると、デバイスのプッシュトークンを、あなたのKIFFパーソンIDおよびアプリが表示していた言語とともに保持します。通知はAppleまたはGoogleを経由し、含まれるのはどのtafか、そして何を求めているかだけで、窓口の通知では、連絡してきた人の名前またはメールアドレスも含まれます。金額やリクエストの詳細は決して含みません。それらはアプリがデバイス上でKIFFから取得して追加するため、ロックが解除されたスマートフォンの通知には、金額、加盟店、または人物が表示されることがあります。ロック中のAndroidスマートフォンでは「tafがあなたを必要としています」とだけ表示され、ロック中のiPhoneでも、プレビューを常に表示するよう設定していない限り同様です。Windows PC、Linuxコンピューター、またはmacOS 12アプリを使っているMacでは、通知はアプリの実行中にアプリ自体が作成し、プッシュトークンは使わず、他のどの会社も経由しません。WindowsとLinuxでは、どのtafか、何をしようとしているか、金額、理由、期限が表示されます。macOS 12アプリでは、通知をオンにすると呼び出しについてのKIFFの文言が表示され、ロック中の画面にはMacのプレビュー設定が許す内容が表示されます。Windowsでは、あなたがオンにするまでオフで、画面のロック中は「tafがあなたを必要としています」とだけ表示されます。画面がロックされる前に表示された通知は、Windowsの通知一覧にその詳細が残ります。Linuxでは、あなたがオフにするまでオンで、ロック中の画面に何が表示されるかはデスクトップ環境によります。 ウォッチに更新を渡すスマートフォンは、通知がオフでもプッシュトークンを登録したままにします。サイレントプッシュでスマートフォンを起こし、更新をウォッチに渡すためだけです。そのプッシュには言葉が含まれず、何も表示しません。</li>
					<li><strong>言語：</strong>tafsのサービスは、tafのレポートがその言語で届くよう、最後にCoachとチャットした人の言語をアカウントの言語として最長三か月間保持します。</li>
					<li><strong>あなたのツール：</strong>ツールを接続するときは、そのツールの提供元でサインインします。Stripeのようにplanqueが自らサインインするアプリ、またはあなたが提供する鍵の場合、planqueはそのトークンまたは鍵をあなたの会社のために暗号化して保持します。管理された接続の場合は、planqueが連携する接続サービスであるComposioがサインインを保持し、planqueは接続の記録とあなたが承認したツールだけを保持します（<a href="#google">Googleユーザーデータ</a>を参照）。接続の記録には、アプリがどのアカウントかをあなたに示せるよう、サインインしているアカウント（その名前またはメールアドレス）が含まれることがあります。KIFFが管理された接続を使うのは、<a href="/subprocessors#composio">/subprocessors</a>（英語）に記載されたアプリに限られます。</li>
					<li><strong>あなたのブラウザ（Chrome）：</strong>tafs拡張機能をスマートフォンとペアリングすると、tafは、ペアリングしたChromeプロファイルの中で、その接続に挙げられたサイトでのみ作業できます。tafは、あなたが見たり、一時停止したり、止めたりできるタブグループの中に専用のタブを開き、そのうちの一つにあなたが触れると一時停止します。拡張機能のサイドパネルから開始したtafは、そのウィンドウで今いるタブが接続先のいずれかのサイトにあれば、代わりにそのタブで作業します。そのタブはtafのグループに入り、tafのタブと同じように扱われ、tafが止まってもタブは開いたままです。そのタブに加わるのは、そのページが最初に必要なページであるときだけです。そこでは、自分のサイトに限り、クリックや入力ができます。そのタブでは、ページをその場で読み、ほかのページは自分のタブで開きます。あなたのタブを動かせるのは、クリックなどそこで行う操作だけで、それもそのサイトの中に限られます。tafはそれらのページを、パスワード、カード、コードの欄を除いたテキストとフォーム欄として読み取り、あなたの他のタブや他のサイトを読むことは決してありません。そのテキストは実行の一部として当社のAI提供元に渡され、ツールの結果と同様に実行とともに保管されます。各ステップは、サイトと欄の名前とともに記録に残り、秘密の欄に入力された内容が残ることは決してありません。tafが変更を加えるたびに、KIFFは変更前と変更後のページを、それらの欄を除いたテキストとして最長30日間だけ保管し、あなたが接続を解除するかアカウントを削除したときは、それより早く削除します。これらのページには、あなたの顧客など、他の人の情報が表示されることがあります。KIFFは処理者として、あなたに代わってそれらを処理します。拡張機能があなたのコンピュータに保管するのは自分の鍵、KIFFとのセッション、そこで始めたCoachとのチャットの一覧などで、あなたのパスワードを保管することは決してありません。サインインのページでは、tafは止まり、あなた自身のタブであなた自身でサインインするよう求めます。拡張機能のサイドパネルからCoachと話すこともできます。Coachがページを読むのは、拡張機能で許可した後だけです。これは独立した同意で、拡張機能で取り消せます。ページなしでメッセージを送ることもいつでもできます。そこからCoachにメッセージを送ると、手前のページの表示されているテキストだけが、そのメッセージと一緒に送られます。入力した内容は送られません。ただし、銀行、決済、メール、健康のサイトと、Coach用にオフにしたサイトは除きます。入力欄の値とパスワードは読み取りません。カード番号は下四桁だけに切り詰め、キーとラベル付きの秘密情報は伏せ字にします。ページの本文で英語、フランス語、スペイン語、ドイツ語によりワンタイムコードと示されたコードも伏せ字にします。送られるのはそのメッセージのためだけで、AIプロバイダーに届きます。tafsがページを保持するのは回答が終わるまでで、サイト名は「読み取り:」としてチャットとともに30日間保持します。Coachの回答はページを引用することがあり、ほかの回答と同じようにチャットとともに保持されます。そこでtafに送るメッセージも同じで、同じ同意のもと、ただしそのtaf自身のサイトにいるときだけです。それ以外では何も読まれず、そのターンではtafは読むだけで、その回答がページを引用することがあります。tafの場合、ページのテキストはその実行が終わるまでだけ実行とともに保存されます。サイドパネルには、そのChromeをペアリングしてからそこで始めたチャットが表示されます。ほかのチャットは、スマートフォンやほかのデバイスに残ります。ほかのデバイスから送ったメッセージのためにtafがそのChromeで作業すると、その実行もサイドパネルに表示されます。表示されるのはメッセージ、そのステップ、回答だけで、そのチャットのほかの部分は表示されず、そのチャットを削除するか、Chromeのペアリングを解除するか、tafを別のChromeに移すまで表示されます。そこではメッセージにファイルを添付することもできます。tafsアプリで添付したファイルと同じく、そのメッセージと一緒にAIプロバイダーに届き、メッセージとともに30日間（チャットを削除した場合はそれより早く、どのメッセージにも使われないファイルは約一時間）保持され、ファイルを開けるのは添付した本人だけです。ほかに、スマートフォンとのペアリング、Coach 向けにオフにしたサイト、この Chrome プロファイルのランダムな ID も保管します。この ID は、スマートフォンがこの Chrome を見分けられるよう、ペアリングのたびに KIFF に送られます。アンインストールですべて削除され、ペアリングの解除ではこの ID と Coach 向けにオフにしたサイト以外が削除されます。tafは、あなたのスマートフォンでの承認なしに支払うことはありません。操作を行う各ステップ（あなたが承認したものを含む）については、操作の直前に撮ったそのページのスクリーンショットを一枚、記録のために保管します。読み取るだけのページでは撮らず、銀行、ウォレット、パスワード管理、決済、健康、行政のサイトでも撮りません。撮影の前に、パスワード、カード、コードの欄は隠されます。カード番号や鍵のように見えるテキストも黒く塗りつぶされますが、別の書き方をされたものは見えてしまうことがあります。スクリーンショットは、そのステップに結び付けて暗号化された保管場所に30日間保管され、その後自動的に削除されます。接続を解除したとき、このChromeのペアリングを解除したとき、またはアカウントを削除したときは、それより早く削除されます。AIプロバイダーには決して送られません。それぞれ、tafのアクティビティのそのステップの下で確認できます。tafs は、銀行、ウォレット、パスワード管理、決済、メール、健康、行政のサイトを、リストとアドレス内の語で判断します。判断できなかったサイトは、ほかのサイトと同じに扱われます。</li>
					<li><strong>あなたのtafの仕事：</strong>各tafの実行、チャット、レポート、メモ、tafが届けるファイルで、処理者として保持します。tafが届けるファイルは、あなたのアカウントの全員が見ることができます。</li>
					<li><strong>窓口：</strong> メール、Slack、Telegramでtafに連絡できるよう窓口を開くと、tafsサービスは、あなたが登録した送信者ごとに、そのメールアドレス、SlackのメンバーID、TelegramのユーザーID（WhatsAppの窓口なら電話番号）とあなたが付けた名前を、窓口かtafを削除するまで保持します。登録していない人からのメッセージは、差出人と内容とともにノックとしてあなたを待ち、最後のノックから最大30日間保持されます。登録した送信者のメッセージはtafのチャットに入り、チャットのほかの部分と同じように保持されます。SlackとTelegramは、それぞれの規約に基づいてメッセージを届けます。</li>
					<li><strong>購入：</strong>Soloとクレジットパックは、App Storeを通じてAppleが、またはGoogle Playの課金を通じてGoogleが販売します。AppleまたはGoogleは、何が、どのKIFFアカウント（ランダムなID）のために、いつ購入されたか、および取引または注文の参照番号を私たちに伝えます。あなたのApple IDやGoogleアカウント、氏名、メールアドレス、カードを私たちに渡すことはありません。</li>
				</ul>
				<p>アプリには、分析や広告のためのトラッカーはありません。</p>
			</section>
			<section id="ai">
				<h2>5. tafsのAI</h2>
				<p>tafsは、CoachとあなたのtafにAnthropicのClaude AIを使用します。Claudeは、Anthropicまたは当社のサブプロセッサーのページに記載されたクラウド事業者のいずれかが当社のために動かしています。どの事業者か、どこで動かすかはそのページに記載しています。アプリは、何かがAIに送られる前にあなたに確認します。</p>
				<ul>
					<li>送信されるもの：あなたがCoachとtafに書いたこと、添付したファイル、tafが作業中に接続済みアプリから返されたもの、そしてCoachがアプリ内であなたを手伝っている間に画面に表示されているもの。</li>
					<li>Chromeから: 拡張機能のサイドパネルでCoachに書いたときの手前のページ（拡張機能でCoachにページの読み取りを許可した後）。そこで自分のサイトにいるtafに書いたときも同じです。</li>
					<li>決して送信されないもの：接続済みアプリが使うパスワードと鍵、およびあなたの指紋。</li>
					<li>Claudeを動かす会社はこれを回答のために使用し、30日以内に削除します。ただし、その会社の利用規則に違反するとして検知された場合や、法律で保管が求められる場合を除きます。</li>
					<li>あなたが許可するまで何も送信されません。アカウントで撤回できます。</li>
				</ul>
				<p>撤回すると、Coachとあなたのtafはあなたへの回答をやめ、あなたの同意に基づいて実行されているtafは一時停止します。tafsは、何に同意したかを示すため、あなたが与えた、または撤回した各同意の記録（日時と文言のバージョン）を、最後の変更から10年間保持します。アカウントを削除すると、それより早く削除されます。詳細は<a href="/ja/privacy#ai-in-tafs">KIFFのプライバシーポリシー</a>にあります。</p>
			</section>
			@tafsPrivacyGoogleJA()
			<section id="sharing">
				<h2>7. データを受け取る他の者</h2>
				<p>私たちはあなたの個人データを販売せず、広告のために共有することもありません。</p>
				<p>tafsのために、私たちは次の会社を利用しています。Amazon Web Services（ホスティング。tafsのストアとplanqueの接続を含みます）、Clerk（KIFFアカウントのサインイン）、Anthropic（AIモデル、Anthropic、Amazon Web Services、Google Cloud、Microsoft Azureのいずれかが運用）、Composio（管理された接続のサインイン、およびplanqueが依頼する呼び出し）、Apple（プッシュ通知）、Google（Androidでのプッシュ通知、およびGoogle Playの課金）、Resend（tafのメール窓口）。それぞれが何に、どこで関わるかを含む公式の最新リストは、<a href="/subprocessors">/subprocessors</a>（英語）にあります。</p>
				<p>その一部は欧州経済領域の外、主に米国にあります。それらの移転がどのように保護されているかは、<a href="/ja/privacy#transfers">KIFFのプライバシーポリシー</a>に記載しています。</p>
				<p><strong>あなたの国。</strong>国によっては、法律がこのポリシーの記載以上のことを求めています。その追加事項は、英語とその国の言語で<a href="/privacy/countries">あなたの国</a>に掲載しています。</p>
			</section>
			<section id="retention">
				<h2>8. 保持期間</h2>
				<ul>
					<li>あなたのツールがtafに返したもの：実行が終わるまでに限ります。チャットでは、読み取っただけのものは次のメッセージのために暗号化して保持され、チャットが一時間操作されないまで、かつ読み取りから最長四時間まで使われ、その後、数日以内に自動的に削除されます。</li>
					<li>tafの実行とチャット（チャットの要約を含む）：30日間。そのメモ：tafが削除されるまで。 Coachとの自分のチャットは、それより早く削除できます。そのメッセージとあなたが追加したファイルはすぐに削除されますが、各実行が行われたこと、その日時と費用の記録は30日間残ります。 回答を報告すると、KIFFはその回答、理由、メモを180日間、またはそのチャットかアカウントを削除するまで保管します。KIFFはそれらを報告を読むチームにもメールで送り、そのメールはKIFFのサポートメールと同じように保管されます。</li>
					<li>次の回答のためのCoachの短いメモ（チャットで接続ができなかった理由や、Cardが承認されたことなど）：その回答がそれを取り込むまで、最長7日間。その後は、そのチャットの一部として、チャットが保持される限り保持されます。再送されたメッセージが同じメモを受け取れるよう、コピーが24時間保持されます。チャットのメモはそのチャットでのみ使われます。</li>
					<li>チャットで添付したファイル：添付先のメッセージとともに30日間、またはチャットが削除された場合はそれより早く、いずれにしても38日以内に削除されます。どのメッセージにも使われていないファイルは、アップロードから約一時間後に削除されます。アカウントを削除すると、それらも削除されます。</li>
					<li>tafが届けるファイル：実行がそれを作成してから30日間で、その後一日以内に自動的に削除されます。アカウントの誰でも、「今すぐ削除」でそれより早く削除できます。ファイル自体は直ちに消え、コピーは残りません。その名前、サイズ、それを作成したtafと実行は、障害後の復元にのみ使われるtafsのストアの暗号化されたポイントインタイムコピーに、最長35日間残ることがあります。tafを削除するか、アカウントを削除すると、そのファイルも削除されます。ファイルを共有するとファイルそのものが送られ、共有したコピーは共有先のアプリに残ります。ファイルをダウンロードするために、私たちはアカウントのサインイン中のメンバー向けに、一分後に使えなくなるリンクを作成します。それ以外のリンクは作成しません。</li>
					<li>planqueの各呼び出しの記録にある、ツールが返したもの：24時間。その後、記録には、呼び出しが二度送信されないよう、呼び出しが送信されたかどうかだけが残ります。</li>
					<li>planqueにある接続のトークンまたは鍵、あるいはComposioにある管理された接続のサインイン：あなたが接続を解除するまで。あなたの他の接続がその提供元で同じアカウントを使う可能性がある場合は、その接続も解除されるまで使用されないまま保持され、その後取り消されます。その承認の記録：アカウントが終了するまで。</li>
					<li>デバイスのプッシュトークン：あなたがアプリからサインアウトするか、デバイスを削除するか、AppleまたはGoogleがトークンの消滅を報告するまで。デバイスの公開鍵、名前、プラットフォーム、日時：あなたが使っている間。デバイスをサインアウトすると削除済みとして記録され、アカウントが削除されるまで保持されます。これにより、KIFFはそのデバイスからの遅れて届いた回答を拒否し、以前の回答に署名したデバイスを示すことができます。パスキーの公開鍵、ID、名前：そのデバイスのものと同じ期間。コンピューターのセッション：最長90日間、またはあなたがサインアウトするまで。</li>
					<li>あなたのアカウント：削除されるまで。サービスログ：30日間。tafsとplanqueのストアは、障害後のストアの復元にのみ使われる暗号化されたポイントインタイムコピーを35日間保持します。</li>
				</ul>
				<p>その他のすべては<a href="/ja/privacy#retention">KIFFの保持期間のセクション</a>にあります。</p>
			</section>
			<section id="lawful-bases">
				<h2>9. 法的根拠</h2>
				<p>契約の履行：あなたのアカウントとtafを運用するため。正当な利益：セキュリティ、不正防止、濫用の検知のため。同意：tafsのAIのため（<a href="#ai">セクション5</a>）。法的義務：税務記録のため。詳細は<a href="/ja/privacy#lawful-bases">KIFFのプライバシーポリシー</a>にあります。</p>
			</section>
			<section id="rights">
				<h2>10. あなたの権利</h2>
				<p>GDPRのもとで、あなたは自分のデータへのアクセス、その訂正、消去、制限、またはポータブルなコピーを求めること、正当な利益に基づく処理に異議を述べること、および同意を撤回することができます。<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>までメールでご連絡ください。不当な遅滞なく、遅くとも一か月以内に回答します。複雑なご請求の場合はさらに二か月かかることがあり、その場合は最初の一か月以内にお知らせします。アプリでは、アカウント → チャットをエクスポートで、あなた自身のチャットとメモをダウンロードできます。</p>
				<p>tafsアカウントを削除するには、アプリを開き、アカウントに移動して<em>アカウントを削除</em>をタップし、確認してください。元に戻すことはできません。何がいつ削除されるか、およびメールで依頼する方法は、<a href="/ja/privacy#delete-account">KIFFのプライバシーポリシー</a>に記載しています。</p>
				<p><a href="https://www.aki.ee/en" target="_blank" rel="noopener">エストニアデータ保護監督機関（Andmekaitse Inspektsioon）</a>、またはお住まいの地域の監督機関に苦情を申し立てることができます。</p>
				<p><strong>あなたの国。</strong>国によっては、法律がこのポリシーの記載以上のことを求めています。その追加事項は、英語とその国の言語で<a href="/privacy/countries">あなたの国</a>に掲載しています。</p>
			</section>
			<section id="more">
				<h2>11. セキュリティ、子ども、変更</h2>
				<p>私たちのセキュリティ対策は<a href="/security">/security</a>（英語）に掲載しています。tafsは子どもを対象としておらず、16歳未満の子どもから個人データを故意に収集することはありません。このポリシーは、<a href="/ja/privacy#changes">KIFFのプライバシーポリシー</a>がそれ自体について定める方法で変更します。</p>
			</section>
			<section id="contact">
				<h2>12. お問い合わせ</h2>
				<p>プライバシーに関するご質問とご依頼：<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>。正式な法的通知：<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>。アプリ自体の利用規約は<a href="/ja/tafs/terms">/tafs/terms</a>にあります。</p>
			</section>
		</article>
	}
}

// tafsPrivacyGoogleJA is tafsPrivacyGoogle in Japanese. Its last paragraph,
// the Limited Use statement, stays in Google's own English words.
templ tafsPrivacyGoogleJA() {
	<section id="google">
		<h2>6. Googleユーザーデータ</h2>
		if len(googleManaged()) == 0 && len(googleInHouse("ja")) > 0 {
			<p>あなたが求めた場合、tafsはアプリの「アプリを接続」で、tafをあなたのGoogleアカウントに接続します。たとえば、そのtafの仕事が使うGoogle SheetsやGoogle Calendarに接続します。このセクションでは、tafsがGoogleから受け取るデータをどのように扱うかを説明します。</p>
		} else {
			<p>あなたが求めた場合、tafsはアプリの「アプリを接続」で、tafをあなたのGoogleアカウントに接続します。たとえば、あなたのGmail、またはそのtafの仕事が使うGoogle CalendarやGoogle Sheetsに接続します。このセクションでは、tafsがGoogleから受け取るデータをどのように扱うかを説明します。</p>
		}
		<ul>
			if len(googleManaged()) == 0 && len(googleInHouse("ja")) > 0 {
				<li><strong>読み書きするもの：</strong>tafの仕事に必要なもの、すなわちtafが最新に保つスプレッドシート、またはtafが管理するカレンダーの予定です。それらを変更するのはtafのCardが許す場合に限られ、Cardの上限を超えるものはすべてあなたの承認を待ちます。</li>
			} else {
				<li><strong>読み書きするもの：</strong>tafの仕事に必要なものです。Gmailでは、返信が必要なメッセージを見つけるためにメッセージとスレッドを読み、下書きを書きます。メールを送信するのはtafのCardが許す場合に限られます。Google CalendarとGoogle Sheetsでは、tafが管理するカレンダーの予定、またはtafが最新に保つスプレッドシートを読み、それらを変更するのはtafのCardが許す場合に限られます。
					if googleListed("Google Tasks") {
						Google Tasksでは、tafが管理するタスクリストを読み、タスクの追加、完了、移動、削除を行うのはtafのCardが許す場合に限られます。
					}
					Cardの上限を超えるものはすべてあなたの承認を待ちます。</li>
			}
			<li><strong>目的：</strong>そのtafのためにあなたが設定した仕事を行うため、およびtafがどのGoogleアカウントに接続されているかをあなたに示すためだけです。示すのはそのメールアドレスで、あなたが接続を解除するまで接続とともに保持されます。</li>
			if len(googleManaged()) > 0 || len(googleInHouse("ja")) > 0 {
				<li>
					<strong>各Googleアプリの接続方法：</strong>
					<ul>
						if len(googleManaged()) > 0 {
							<li><a href="/subprocessors">/subprocessors</a>（英語）に記載されたサインインパートナーを通じて: { appList(googleManaged()) }.</li>
						}
						if len(googleInHouse("ja")) > 0 {
							<li>他の会社を介さない、tafs自身のGoogleサインインを通じて: { appList(googleInHouseNames()) }.</li>
						}
					</ul>
					if googleBoth() {
						両方に記載されたアプリは、あなたのアカウントに応じて、どちらか一方の方法で接続します。どちらを許可しているかは、Google自身のサインインページに表示されます。
					}
				</li>
			}
			if googleBoth() {
				<li>
					<strong>あなたが許可するもの：</strong>あなたはGoogle自身のページでサインインし、何を許可するかを選びます。
					<ul>
						<li><strong>サインインパートナーを通じて：</strong>tafsは、tafのツールが必要とするアクセスだけを求めます。その狭いアクセスが不可能な場合は、アプリの通常のアクセスを求め、サインインの前にその旨を伝えます。通常のアクセスにtafが使わない個人データが含まれる場合、tafsは接続しません。</li>
						<li><strong>tafs自身のGoogleサインインを通じて：</strong>サインインでは、そのアプリについて下に記載されたすべてのアクセスを一度に求めます。tafが読み取りしか行わない場合でも同様です。</li>
					</ul>
				</li>
			} else if len(googleInHouse("ja")) > 0 {
				<li><strong>あなたが許可するもの：</strong>あなたはGoogle自身のページでサインインし、何を許可するかを選びます。サインインでは、そのアプリについて下に記載されたすべてのアクセスを一度に求めます。tafが読み取りしか行わない場合でも同様です。</li>
			} else {
				<li><strong>あなたが許可するもの：</strong>あなたはGoogle自身のページでサインインし、何を許可するかを選びます。tafsは、tafのツールが必要とするアクセスだけを求めます。その狭いアクセスが不可能な場合は、アプリの通常のアクセスを求め、サインインの前にその旨を伝えます。通常のアクセスにtafが使わない個人データが含まれる場合、tafsは接続しません。</li>
			}
			<li><strong>tafによる使い方：</strong>tafは、そのCardで承認されたツールだけを使います。すべての呼び出しは、何かが送信される前に、まさにそのツールとその引数についての許可証と照合され、あなたが与えたアクセスの範囲外の呼び出しは拒否されます。どの操作で毎回あなたの承認を求めるかは、Cardで設定します。</li>
			if len(googleInHouse("ja")) > 0 {
				<li>
					if googleBoth() {
						<strong>tafs自身のGoogleサインインが求めるアクセス：</strong>
					} else {
						<strong>tafsが求めるアクセス：</strong>
					}
					<ul>
						for _, a := range googleInHouse("ja") {
							<li>
								{ a.Name }
								<ul>
									for _, s := range a.Scopes {
										<li><code>{ s.ID }</code>：{ s.What }</li>
									}
								</ul>
							</li>
						}
					</ul>
					サインインがどれだけ許可していても、tafはそのCardにあるツールだけを使います。
				</li>
			}
			if googleBoth() {
				<li>
					<strong>サインインを保持する者：</strong>
					<ul>
						<li><strong>サインインパートナーを通じて：</strong>あなたのGoogleサインインは、<a href="/subprocessors">/subprocessors</a>（英語）に記載されたサインインパートナーが保持し、tafにもplanqueにも渡されることはありません。tafもtafsも、あなたのパスワードやGoogleのトークンを見ることはありません。同じアクセスを必要とするあなたの別のtafはそのサインインを再利用し、各tafはあなたがそのtafのために承認したツールだけを使います。</li>
						<li><strong>tafs自身のGoogleサインインを通じて：</strong>tafs自身の接続サービスであるplanqueが、あなたのGoogleトークンをあなたの会社のために、欧州連合（アイルランド）のAWS KMSで暗号化して保持し、tafのCardが許す呼び出しを行うためだけに使います。トークンがtafに渡されることはなく、tafもAIモデルも、あなたのパスワードやGoogleのトークンを見ることはありません。同じアクセスを必要とするあなたの別のtafはそのサインインを再利用し、各tafはあなたがそのtafのために承認したツールだけを使います。</li>
					</ul>
				</li>
			} else if len(googleInHouse("ja")) > 0 {
				<li><strong>サインインを保持する者：</strong>tafs自身の接続サービスであるplanqueが、あなたのGoogleトークンをあなたの会社のために、欧州連合（アイルランド）のAWS KMSで暗号化して保持し、tafのCardが許す呼び出しを行うためだけに使います。トークンがtafに渡されることはなく、tafもAIモデルも、あなたのパスワードやGoogleのトークンを見ることはありません。同じアクセスを必要とするあなたの別のtafはそのサインインを再利用し、各tafはあなたがそのtafのために承認したツールだけを使います。</li>
			} else {
				<li><strong>サインインを保持する者：</strong>あなたのGoogleサインインは、<a href="/subprocessors">/subprocessors</a>（英語）に記載されたサインインパートナーが保持し、tafにもplanqueにも渡されることはありません。tafもtafsも、あなたのパスワードやGoogleのトークンを見ることはありません。同じアクセスを必要とするあなたの別のtafはそのサインインを再利用し、各tafはあなたがそのtafのために承認したツールだけを使います。</li>
			}
			if googleBoth() {
				<li>
					<strong>データを受け取る他の者：</strong>tafがGoogleから読み取ったものは、あなたが許可した後に限り、そのtafを実行するAIモデルに送られ（<a href="#ai">tafsのAI</a>を参照）、AIモデルはそれをその提供者の規約に従って最長30日間保持します。
					<ul>
						<li><strong>サインインパートナーを通じて：</strong>データは、各呼び出しを行うサインインパートナーも経由します。</li>
						<li><strong>tafs自身のGoogleサインインを通じて：</strong>planqueがGoogleを自ら呼び出すため、他のどの会社も呼び出しを行わず、あなたのサインインを保持することもありません。</li>
					</ul>
					いずれも<a href="/subprocessors">/subprocessors</a>（英語）に記載されています。
				</li>
			} else if len(googleInHouse("ja")) > 0 {
				<li><strong>データを受け取る他の者：</strong>tafがGoogleから読み取ったものは、あなたが許可した後に限り、そのtafを実行するAIモデルに送られ（<a href="#ai">tafsのAI</a>を参照）、AIモデルはそれをその提供者の規約に従って最長30日間保持します。planqueがGoogleを自ら呼び出すため、他のどの会社も呼び出しを行わず、あなたのサインインを保持することもありません。AIモデルの提供者は<a href="/subprocessors">/subprocessors</a>（英語）に記載されています。</li>
			} else {
				<li><strong>データを受け取る他の者：</strong>tafがGoogleから読み取ったものは、あなたが許可した後に限り、そのtafを実行するAIモデルに送られ（<a href="#ai">tafsのAI</a>を参照）、AIモデルはそれをその提供者の規約に従って最長30日間保持します。データは、各呼び出しを行うサインインパートナーも経由します。いずれも<a href="/subprocessors">/subprocessors</a>（英語）に記載されています。</li>
			}
			<li><strong>AIの学習：</strong>GoogleユーザーデータがAIモデルの学習に使われることはありません。</li>
			<li><strong>画像：</strong>tafsは画像や動画を作成も編集もしません。そのAIが書くのはテキストです。Google APIやGoogleユーザーデータを、誰かの性的な画像（同意のない性的画像、NCII）や、人物のその他の画像を作成、編集、共有するために使うことは決してありません。</li>
			if len(googleManaged()) == 0 && len(googleInHouse("ja")) > 0 {
				<li><strong>保持期間と場所：</strong>あなたのスプレッドシートと予定は、あなたのGoogleアカウントに残ります。tafs自身のストアでは、ツールが返したものはtafの実行が終わるまでしか保持されません。各呼び出しを中継するplanqueは、繰り返された呼び出しが同じ回答を受け取り、二度送信されることがないよう、Googleが返したものを24時間保持します。その後は、呼び出しが送信されたかどうかだけを保持します。チャットでは、読み取っただけのものは暗号化して保持され、チャットが一時間操作されないまで、かつ読み取りから最長四時間まで使われ、その後、数日以内に自動的に削除されます。実行の記録とそのチャットは30日間、tafのメモはあなたがそのtafを削除するまで保持されます（<a href="#retention">保持期間</a>を参照）。</li>
			} else {
				<li><strong>保持期間と場所：</strong>あなたの下書き、予定、スプレッドシートは、あなたのGoogleアカウントに残ります。tafs自身のストアでは、ツールが返したものはtafの実行が終わるまでしか保持されません。各呼び出しを中継するplanqueは、繰り返された呼び出しが同じ回答を受け取り、二度送信されることがないよう、Googleが返したものを24時間保持します。その後は、呼び出しが送信されたかどうかだけを保持します。チャットでは、読み取っただけのものは暗号化して保持され、チャットが一時間操作されないまで、かつ読み取りから最長四時間まで使われ、その後、数日以内に自動的に削除されます。実行の記録とそのチャットは30日間、tafのメモはあなたがそのtafを削除するまで保持されます（<a href="#retention">保持期間</a>を参照）。</li>
			}
			<li>
				<strong>停止する方法：</strong>
				<ul>
					<li>アプリの「アプリを接続」またはtafのCardタブで、Googleの接続を解除します。そのGoogleツールは直ちに停止し、tafsは直ちにサインインの取り消しをGoogleに依頼します。取り消しの完了は少し遅れることがあります。</li>
					<li>tafを削除すると、その接続もともに終了します。あなたの別のtafがまだ使っているGoogleサインインは、最後のtafがなくなるまで残ります。</li>
					<li>Googleアカウントの<a href="https://myaccount.google.com/permissions">myaccount.google.com/permissions</a>で、いつでもtafsのアクセスを削除できます。あなたのtafはGoogleにアクセスできなくなり、アプリはGoogleの接続がサインアウトされたことを知らせます。</li>
					<li>アカウントを削除する：そのtaf、チャット、メモ、ファイル、接続は直ちに消去され、そのポイントインタイムコピーからも35日以内に消去されます。また、Googleのトークンは、Googleが許す範囲で取り消されます。</li>
				</ul>
			</li>
		</ul>
		<p lang="en">tafs's use and transfer to any other app of information received from Google APIs will adhere to <a href="https://developers.google.com/terms/api-services-user-data-policy">Google API Services User Data Policy</a>, including the Limited Use requirements.</p>
	</section>
}
