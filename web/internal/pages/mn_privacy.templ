package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// PrivacyMN is KIFF's privacy policy (/privacy) in Mongolian, at /mn/privacy.
// It is a translation of Privacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Mongolian has the legal
// texts only, so a link to any other page goes to English and says so.
templ PrivacyMN() {
	@components.LayoutSite("KIFF — privacy policy", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@privacyHeadMN()
			@privacyWhoWeAreMN()
			@privacyScopeMN()
			@privacyRolesMN()
			@privacyCategoriesMN()
			@privacyLawfulBasesMN()
			@privacySubprocessorsMN()
			@privacyTransfersMN()
			@privacyRetentionMN()
			@privacyRightsMN()
			@privacyCookiesMN()
			@privacySecurityMN()
			@privacyChildrenMN()
			@privacyAutomatedMN()
			@privacyChangesMN()
			@privacyContactMN()
		</article>
	}
}

templ privacyHeadMN() {
	<header class="legal-head">
		<p class="legal-badge">Нууцлалын бодлого · v0.1</p>
		<h1>Нууцлалын бодлого</h1>
		<p class="legal-meta">
			<strong>Сүүлд шинэчилсэн:</strong> 2026 оны арваннэгдүгээр сарын 24. <strong>Хүчинтэй болох огноо:</strong> 2026 оны тавдугаар сарын 24.
		</p>
		<p class="legal-disclaimer">
			Энэ бодлого нь KIFF Cloud вэбсайт, хяналтын самбар, API болон iPhone, iPad, Android, компьютерт зориулсан tafs апп даяар хувийн мэдээллийг хэрхэн боловсруулдгийг тайлбарлана. Асуулт: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</header>
}

templ privacyWhoWeAreMN() {
	<section id="who-we-are">
		<h2>1. Бид хэн бэ</h2>
		<p>
			KIFF Cloud-ыг Эстонид байгуулагдсан хувийн хязгаарлагдмал хариуцлагатай компани <strong>Kiff Agents OÜ</strong> ажиллуулдаг. Бүртгэлийн мэдээлэл:
		</p>
		<ul>
			<li><strong>Бүртгэлийн код:</strong> 17372313 (Эстонийн цахим бизнесийн бүртгэл)</li>
			<li><strong>НӨАТ-ын дугаар:</strong> EE102924327</li>
			<li><strong>Бүртгэлтэй хаяг:</strong> Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Эстони</li>
			<li><strong>Нууцлалын холбоо барих хаяг:</strong> <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a></li>
			<li><strong>Албан ёсны хуулийн мэдэгдэл:</strong> <a href="mailto:legal@kiff.dev">legal@kiff.dev</a></li>
		</ul>
		<p>
			Kiff Agents OÜ нь Европын Холбоонд байгуулагдсан тул ЕХ-ны Хувийн мэдээлэл хамгаалах ерөнхий журам (<abbr title="Хувийн мэдээлэл хамгаалах ерөнхий журам">GDPR</abbr>) манай боловсруулалтад шууд хамаарна. Бид 27-р зүйлийн ЕХ дахь төлөөлөгч шаарддаггүй.
		</p>
	</section>
}

templ privacyScopeMN() {
	<section id="scope">
		<h2>2. Энэ бодлогын хамрах хүрээ</h2>
		<p>
			Энэ бодлого нь таныг дараахтай харилцах үед бидний боловсруулдаг хувийн мэдээллийг хамарна:
		</p>
		<ul>
			<li><a href="https://kiff.dev"><code>kiff.dev</code></a> — манай маркетингийн сайт, энэ бодлогын хуудас болон баримтыг нийтэд харуулдаг гадаргуу.</li>
			<li><a href="https://app.kiff.dev"><code>app.kiff.dev</code></a> — манай нэвтрэлттэй хяналтын самбар.</li>
			<li><a href="https://api.kiff.dev"><code>api.kiff.dev</code></a> — манай HTTP API.</li>
			<li id="tafs"><strong>tafs</strong> — iPhone, iPad, Android болон компьютер (Mac, Windows, Linux)-д зориулсан манай апп болон түүний цаадах үйлчилгээ (компанийн хэрэгслүүдийг холбодог Setup, тэдгээр холболтыг хадгалдаг planque-ийг оруулан), үүнд компани ажлыг KIFF Card-уудын хүрээнд ажилладаг AI агентад даалгадаг.</li>
		</ul>
		<p>
			Энэ бодлого нь таны өөрөө ажиллуулж болох нээлттэй эхийн <code>kiff/kiff</code> фреймворкийг <em>хамарахгүй</em>. Та фреймворкийг өөрийн дэд бүтэц дээр ажиллуулахад таны боловсруулсан аливаа өгөгдлийн хянагч нь та өөрөө бөгөөд Kiff Agents OÜ тэр боловсруулалтад оролцохгүй.
		</p>
	</section>
}

templ privacyRolesMN() {
	<section id="roles">
		<h2>3. GDPR-ийн дагуу бидний үүрэг</h2>
		<p>
			Бид өгөгдлөөс хамааран хоёр чадвараар ажиллана:
		</p>
		<ul>
			<li>
				<strong>Хянагч</strong> — бүртгэл ба нэвтрэлтийн мета өгөгдөл, төлбөрийн өгөгдөл (төлбөр идэвхтэй үед), таны бүртгүүлсэн маркетингийн харилцаа холбоо, мөн манай үйлчилгээний үйл ажиллагааны телеметрийн хувьд.
			</li>
			<li>
				<strong>Боловсруулагч</strong> — аудитын өгөгдөл, үйлдлийн бүртгэл, шийдвэрийн баримт болон манай үйлчлүүлэгчдийн нэрийн өмнөөс runtime-аар дамждаг бусад агуулга, мөн tafs тэдэнд хадгалдаг зүйл (taf бүрийн ажиллалт, чат, тайлан, санах ойн тэмдэглэл болон тэдний хүргэсэн файлууд)-ийн хувьд. Үйлчлүүлэгчид (тенантууд) эдгээр өгөгдлийн хянагч; тэд бидэнд бүртгэлийн тохиргоо болон домайн тохиргоогоор заавар өгдөг. Өгөгдөл боловсруулах гэрээ (<abbr title="Өгөгдөл боловсруулах гэрээ">DPA</abbr>) тэр харилцааг зохицуулна; нийтэлсэн нөхцөлийг <a href="/legal/dpa">DPA-ийн загвар</a> (англиар)-аас үзнэ үү.
			</li>
		</ul>
		<p>
			Энэ бодлого голдуу хянагчийн талын боловсруулалтыг хамарна. Боловсруулагчийн талын өгөгдлийг дурдсан газарт DPA нь илүү тодорхой баримт бичиг юм.
		</p>
	</section>
}

templ privacyCategoriesMN() {
	<section id="categories">
		<h2>4. Бидний боловсруулдаг хувийн мэдээллийн ангилал</h2>
		<p>
			Доорх ангиллууд <a href="/security#data-we-process">/security#data-we-process</a> (англиар) дахь техникийн жагсаалттай нийцнэ. Хоёр нь зөрвөл техникийн хуудас үнэний эх сурвалж бөгөөд бид энэ хэсгийг тохируулан шинэчилнэ.
		</p>
		<ul>
			<li>
				<strong>Бүртгэлийн таниулагч</strong> — таны эх сурвалжийн нэвтрэлтийн субъект (манай таних үйлчилгээ үзүүлэгчийн олгосон) болон таны нэвтэрдэг имэйл хаяг. Одоогоор үг үсгээр нь хадгалагдаж байна; хадгалах үеийн хэшлэлт төлөвлөгдсөн.
				Хэрэв та имэйлээр илгээсэн кодоор нэвтрэхийг асаавал (асаахгүй бол унтраастай), KIFF тэр тохиргоог таны нэвтрэх ID болон өөрчилсөн огнооны хамт хадгална. Бидний таньд имэйлээр илгээсэн кодыг ашиглах хүртэл эсвэл арван минут өнгөрөх хүртэл зөвхөн түлхүүртэй хэш байдлаар хадгална. Хэтрүүлэн ашиглахаас сэргийлэхийн тулд хүссэн хаяг болон IP хаягийн түлхүүртэй хэш тус бүрээр хүсэлтийн тоог хамгийн ихдээ нэг өдөр хадгална. Кодоор нэвтэрсний дараа үүнийг дөрөвний нэг цагийн турш тэмдэглэнэ, ингэснээр сүүлийн үеийн нэвтрэлт шаардсан өөрчлөлтүүд таныг өөрөөр нэвтрэхийг хүснэ.
			</li>
			<li>
				<strong>Тенантын мета өгөгдөл</strong> — тенантын id, slug, харагдах нэр, үүсгэсэн цаг, мөн хүн бүрийн аппын сүүлд ашигласан хэл, ингэснээр KIFF-ийн тэдэнд илгээдэг имэйл тэр хэлээр ирнэ.
			</li>
			<li>
				<strong>API нэвтрэх мэдээлэл</strong> — тунгалаг API түлхүүрийн бүртгэл (бид хэш хадгалдаг, цэвэр текстийг хэзээ ч).
			</li>
			<li>
				<strong>Сессийн күүкигийн өгөгдөл</strong> — нэвтэрсний дараа тохируулсан HMAC-аар гарын үсэг зурсан сессийн күүки. Доорх күүкигийн хэсгийг үзнэ үү.
			</li>
			<li>
				<strong>HTTP хүсэлтийн мета өгөгдөл</strong> — IP хаяг, хэрэглэгчийн агент, хүсэлтийн зам, хариуны төлөв, хоцролт. Аюулгүй байдал, буруу хэрэглээнээс сэргийлэхийн тулд манай урвуу прокси-ийн хандалтын логт хязгаарлагдмал хугацаанд хадгалагдана.
			</li>
			<li>
				<strong>Тенантын хянадаг агуулга</strong> — таны runtime руу илгээдэг <code>parameters</code>, <code>actor</code>, <code>entity</code> өгөгдөл. Бид үүнийг үйлчлүүлэгчийн нэрийн өмнөөс <em>боловсруулагч байдлаар</em> хадгална; сүлжээнд юу гарахыг үйлчлүүлэгч хариуцна. Домайн тус бүрийн нууцлалын тохиргоо төлөвлөгдсөн.
			</li>
			<li>
				<strong>Харилцаа холбоо</strong> — таны манай дэмжлэг, борлуулалт, аюулгүй байдал эсвэл нууцлалын шуудангийн хайрцагт илгээдэг имэйл.
			</li>
			<li>
				<strong>tafs апп</strong> — та tafs-д KIFF бүртгэлээрээ нэвтэрнэ. Утас эсвэл таблет дээр апп таны сессийг төхөөрөмжийн Keychain-д (Android дээр шифрлэгдсэн хадгалалтад) хадгална. Компьютер дээр тэр нь таны хэрэглэгчийн бүртгэлд битүүмжлэгдэн хадгалагдана: Windows компьютер дээр Windows-ийн өөрийн өгөгдөл хамгаалалтаар, Linux дээр таны keyring-д, Mac дээр түүний Keychain-д. Компьютерийн сесс 90 хоног хүртэл үргэлжилнэ. Апп төхөөрөмжөөс хэзээ ч гардаггүй гарын үсгийн түлхүүр үүсгэнэ: iPhone, iPad эсвэл Mac-ийн Secure Enclave-д, Android төхөөрөмжийн Keystore-д, эсвэл Windows компьютерийн TPM-д. Linux дээр, мөн Secure Enclave-гүй Mac дээр түлхүүр нь таны keyring эсвэл Keychain-д хадгалагдсан программ хангамжийн түлхүүр бөгөөд тэр компьютер таныг хүлээж буй зүйлийг харуулж чадах боловч зөвшөөрч чадахгүй; та утсан дээрээ зөвшөөрнө{ macSecurityKey("mn") }. TPM-гүй Windows компьютер tafs-д нэвтэрч чадахгүй. KIFF түлхүүрийн нийтийн хагас, төхөөрөмжийн нэр болон платформ, нэмэгдсэн ба сүүлд ашиглагдсан цагийг хадгалдаг тул таны баригдсан дуудлагад өгсөн хариулт болон холболтуудад өгсөн зөвшөөрлийг шалгаж чадна. Хэрэв та компьютер дээрээ passkey-ээр зөвшөөрвөл, жишээлбэл Windows Hello эсвэл аюулгүй байдлын түлхүүр, таны нүүр, хурууны хээ эсвэл PIN компьютерийн өөрийн системд үлдэнэ; KIFF passkey-ийн нийтийн түлхүүр, түүний id, тоолуур болон нэрийг хадгалдаг, хэзээ ч нууц зүйл биш, мөн бусад төхөөрөмжтэй синк хийдэг passkey-г татгалздаг. Хэрэв та утас, таблет эсвэл iPad апп ажиллуулдаг Mac дээр мэдэгдлийг асаавал бид төхөөрөмжийн push токеныг таны KIFF хүний id болон апп харуулсан хэлтэй хамт хадгална, ингэснээр түүний мэдэгдэл тэр хэлээр ирнэ. tafs үйлчилгээ бүртгэлийн хэлийг, Coach-той хамгийн сүүлд чатласан хүнээс, гурван сар хүртэл мөн хадгалдаг, taf-ын тайлан тэр хэлээр ирэхийн тулд. Утасны мэдэгдэл Apple эсвэл Google-ээр зөвхөн аль taf, юу хүсч байгаагаар, мөн хаалганы мэдэгдэлд бичсэн хүний нэр эсвэл имэйл хаягаар дамжина: хэзээ ч дүн эсвэл хүсэлтийн дэлгэрэнгүй биш. Апп тэдгээрийг төхөөрөмж дээр өөрөө KIFF-ээс нэмдэг тул түгжээ тайлагдсан утасны мэдэгдэл дүн, худалдагч эсвэл хүнийг харуулж болно. Түгжээтэй Android утсан дээр зөвхөн "Taf таныг хэрэгтэй байна" харуулна, түгжээтэй iPhone дээр ч мөн, таныг урьдчилан харахыг үргэлж харуулахаар тохируулаагүй бол. <strong>Таны цаг:</strong> цаг нууц үг эсвэл түлхүүр хадгалдаггүй, зөвхөн хослуулсан утастайгаа харилцдаг бөгөөд хэзээ ч зөвшөөрдөггүй. Та AI-д зөвшөөрсний дараа цаг таны Coach эсвэл сонгосон taf-д хэлснийг зөвхөн текст хэлбэрээр утсаар дамжуулан илгээнэ. Цагийн өөрийн ярианы үйлчилгээ, Apple-ийнх эсвэл Google-ийнх, таны үгийг тэр текст болгон хөрвүүлнэ. Wear OS дээр та дуусгахаас өмнө зогсвол таны утасны өөрийн таних систем утсан дээр түүнийг орлож хийнэ. Тэр нь дэлгэцийн түгжээ эсвэл нууц код байгаа бөгөөд түгжээ тайлагдсан үед л татгалзах, зогсоох, Coach эсвэл taf руу илгээх боломжтой. Таны taf-д илгээсэн зүйл тэр taf-ын өөрийн чат руу орно, та утсан дээрээ бичсэн мэт. Taf-ын чатыг, дүнгийн хамт, нээх бүрд утсаар дамжуулан уншдаг бөгөөд цаг доорх өөрийн хэсэгт тайлбарласан сүүлийн мессежүүдийг л хадгална. Аппууд хаалттай үед таны утас шинэ хариулт, мессежийг системийн өөрийн утас-цагны холболтоор (Apple Watch дээр Apple-ийн, Wear OS дээр Google Play үйлчилгээний) цаг руу дамжуулдаг бөгөөд тэр холболт тэдгээрийг цаг хүлээж авах хүртэл л утас болон цаг дээр хадгална; таны утсыг сэрээх мэдэгдэлд ямар ч үг байхгүй. <strong>Apple Watch:</strong> таны taf-ууд болон тэдний хуудсыг хадгалахгүйгээр харуулна. Түгжээтэй үед уншиж чадахгүй файлд таны Ирсэн хайрцгийг хадгална: баригдсан дуудлага бүрийг тэр taf-ын нэр болон юу асуудгаар нь, хэзээ ч дүн биш, мөн цагаас илгээсэн зүйлд Coach-ийн хариуг текстээр. Хэрэв та цаг дээр гарвал цаг дээр дахин нэвтрэх хүртэл тэр нь та гарсныг мөн хадгална. Үүнээс гадна цагт нууц код байхгүй бол юу ч хадгалахгүй. Та цаг дээр гарах эсвэл iPhone-оос чинь гарах үед, эсвэл апп нууц кодгүйгээр дараагийн удаа нээгдэх эсвэл хаагдах үед Ирсэн хайрцаг устана. Тэр бичлэг хийдэггүй бөгөөд түүний харуулдаг цорын ганц мэдэгдэл бол таны iPhone-ынх. Яриа шууд нээгдэхийн тулд түүн дээр нээсэн 20 хүртэлх яриа тус бүрийн сүүлийн 30 мессежийг ч, Coach болон таны tafs-ынхыг, зөвхөн текст хэлбэрээр, хэзээ ч дүнгүйгээр, Ирсэн хайрцаг шиг түгжээтэй хадгална; Ирсэн хайрцаг устахад болон яриаг 30 хоног нээгээгүй үед эдгээр устана. <strong>Wear OS:</strong> таны бүртгэлийн имэйл болон өнөөдрийн хуанлийг хадгалахгүйгээр харуулна. Тэр нэн даруй нээгдэхийн тулд таныг хүлээж буй зүйлийн тоог, мөн taf бүрийн нэр, зогссон эсвэл түр зогссон эсэхийг шифрлэгдсэн байдлаар хадгална: хэзээ ч дүн, баригдсан дуудлагын дэлгэрэнгүй эсвэл taf-ын чат биш. Та гарах, цаг түгжигдэх эсвэл бугуйгаас салах үед, мөн 24 цагийн дараа энэ нь цэвэрлэгдэнэ. Тэр таны Ирсэн хайрцгийг хадгална, түүн дэх мөр бүр taf-ын нэр болон юу хэлснийг, хэзээ ч дүн биш, мөн дараа илгээхээр хадгалсан нэг мессежийг текстээр. Цаг дээр эсвэл утсан дээр гарах нь бүгдийг цэвэрлэнэ. Өөрийн хавтан (tile)-д зориулж тэр таныг хүлээж буй зүйлийн тоог мөн хадгална, цагийн түгжээ тайлагдсан үед л харуулж, та гарах үед, эсвэл хавтан цагийн түгжээтэй эсвэл дэлгэцийн түгжээгүй үед дараагийн удаа харагдахад цэвэрлэгдэнэ. Цаг дээр гарсны дараа та дахин нэвтрэх хүртэл гарсныг тэмдэглэж хадгална. Цаг түгжээтэй эсвэл дэлгэцийн түгжээгүй үед апп дараагийн удаа нээгдэх эсвэл хаагдах үед Ирсэн хайрцаг мөн устана. Дараа илгээхээр хадгалсан мессеж таныг илгээх эсвэл устгах хүртэл үлдэнэ, учир нь та түүнийг илгээхийг хүссэн. Хэрэв цагийн ярианы үйлчилгээ та дуусгахаас өмнө зогсвол цаг бичлэгийг утас руу чинь илгээх бөгөөд утас түүнийг сервер дээр биш, утсан дээрээ текст болгоно. Текст буцаж ирсний дараа эсвэл та цуцалсны дараа бичлэг хоёулангаас нь устах бөгөөд хамгийн ихдээ 2 минутын дараа. Зөвхөн текст Coach эсвэл таны taf руу цааш явна. Taf-ын үр дүн цаг дээр гарах эсвэл та үүнийг хаах хүртэл цагийн мэдэгдэлд үлдэж болно. Яриа шууд нээгдэхийн тулд түүн дээр нээсэн 20 хүртэлх яриа тус бүрийн сүүлийн 30 мессежийг ч, Coach болон таны tafs-ынхыг, зөвхөн текст хэлбэрээр, хэзээ ч дүнгүйгээр, шифрлэн хадгална; цаг эсвэл утсан дээр гарахад болон яриаг 30 хоног нээгээгүй үед эдгээр устах ба дэлгэцийн түгжээгүй цаг нэгийг ч хадгалахгүй. Windows компьютер, Linux компьютер эсвэл macOS 12 апптай Mac дээр мэдэгдлийг апп өөрөө ажиллаж байх үедээ үүсгэнэ, push токенгүйгээр, өөр ямар ч компаниар дамжихгүйгээр. Windows болон Linux дээр аль taf, юу хийхийг хүсч байгаа, дүн, яагаад, хэзээ хүртэл гэдгийг харуулна; macOS 12 апп дээр та асаасны дараа дуудлагын тухай KIFF-ийн үгсийг харуулах бөгөөд түгжээтэй дэлгэц Mac-ийн урьдчилан харах тохиргоо зөвшөөрснийг харуулна. Windows дээр та асаах хүртэл унтраалттай, дэлгэц түгжээтэй үед зөвхөн "Taf таныг хэрэгтэй байна" харуулна. Дэлгэц түгжигдэхээс өмнө харагдсан нэг нь Windows-ийн мэдэгдлийн жагсаалтад дэлгэрэнгүйгээ хадгална. Linux дээр та унтраах хүртэл асаалттай, түгжээтэй дэлгэц юу харуулах нь таны ширээний орчноос хамаарна. Хэрэгсэл холбохдоо та хэрэгслийн өөрийн үйлчилгээ үзүүлэгчид нэвтэрнэ. planque өөрөө нэвтэрдэг апп, жишээлбэл Stripe, эсвэл таны өгсөн түлхүүрийн хувьд planque тэр токен эсвэл түлхүүрийг таны компанид шифрлэгдсэн байдлаар хадгална; удирдагдсан холболтын хувьд planque-ийн хамтран ажилладаг холболтын үйлчилгээ Composio нэвтрэлтийг хадгалах бөгөөд planque зөвхөн холболтын бүртгэл болон таны зөвшөөрсөн хэрэгслүүдийг хадгална (бүгд боловсруулагчийн хувиар, доороос үзнэ үү). Хэрэв та tafs өргөтгөлийг хослуулбал taf таны өөрийн Chrome дээр таны зөвшөөрсөн сайтуудын хуудсыг мөн уншиж, тэнд үйлдэл хийж чадна (боловсруулагчийн хувиар; юу уншигдах, юу хадгалагдах, хэр удаан хадгалагдахыг <a href="/mn/tafs/privacy">tafs-ын нууцлалын хуудас</a> хэлнэ). Холболтын бүртгэлд нэвтэрсэн бүртгэл (түүний нэр эсвэл имэйл) багтаж болох бөгөөд ингэснээр апп аль нь болохыг танд харуулж чадна. KIFF удирдагдсан холболтыг зөвхөн <a href="/subprocessors#composio">/subprocessors</a> (англиар)-д нэрлэсэн аппуудад ашигладаг. Апп нь аналитик эсвэл сурталчилгааны хянагчгүй.
			</li>
			<li>
				<strong>App Store худалдан авалт</strong> — та tafs-д Solo эсвэл кредитийн багц худалдан авахад Apple танд зардаг: Apple нь бүртгэлтэй худалдагч, төлбөрийг авч, таны төлбөрийн мэдээллийг хадгална. Apple бидэнд юу худалдан авсан, аль KIFF бүртгэлд (апп худалдан авалтад хавсаргадаг санамсаргүй id), хэзээ, Apple-ийн гүйлгээний id, мөн Solo-ийн хувьд хугацаа хэзээ дуусах эсвэл сунгагдахыг мэдэгддэг. Бид үүнийг таны бүртгэлд кредит эсвэл төлөвлөгөө нэмэхэд ашигладаг. Apple бидэнд таны Apple ID, нэр, имэйл хаяг эсвэл картыг өгдөггүй.
			</li>
			<li>
				<strong>Google Play худалдан авалт</strong> — Android дээр ижил худалдан авалт Google Play-ийн төлбөрөөр явагдана: Google төлбөрийг авч, таны төлбөрийн мэдээллийг хадгална. Google бидэнд юу худалдан авсан, аль KIFF бүртгэлд (ижил санамсаргүй id), хэзээ, худалдан авалтын токен ба захиалгын id, мөн Solo-ийн хувьд хугацаа хэзээ дуусах эсвэл сунгагдахыг мэдэгддэг бөгөөд бид үүнийг адилхан ашигладаг. Google бидэнд таны Google бүртгэл, нэр, имэйл хаяг эсвэл картыг өгдөггүй.
			</li>
		</ul>
	</section>
}

templ privacyLawfulBasesMN() {
	<section id="lawful-bases">
		<h2>5. Боловсруулалтын хууль ёсны үндэслэл</h2>
		<p>
			GDPR-ийн 6-р зүйлийн дагуу бид дараах хууль ёсны үндэслэлд тулгуурладаг:
		</p>
		<ul>
			<li>
				<strong>Гэрээний гүйцэтгэл</strong> (6(1)(b) зүйл) — бүртгэл үүсгэх, нэвтрэлт, таны өмнөөс runtime ажиллуулах, төлбөр тооцоо (идэвхтэй үед) болон үйлчилгээний үндсэн гадаргуунд.
			</li>
			<li>
				<strong>Хууль ёсны ашиг сонирхол</strong> (6(1)(f) зүйл) — аюулгүй байдал, залилангаас сэргийлэх, буруу хэрэглээг илрүүлэх, үйл ажиллагааны телеметр болон үйлчилгээг хамгаалахад. Бид өөрсдийн ашиг сонирхлыг таны эрхтэй тэнцвэржүүлдэг бөгөөд хүсвэл тэр тэнцвэржүүлэлт юу өгснийг танд хэлнэ.
			</li>
			<li>
				<strong>Зөвшөөрөл</strong> (6(1)(a) зүйл) — tafs апп дахь AI-д: Coach болон таны taf-уудыг ажиллуулдаг AI загварт юу илгээгддэг, <a href="#ai-in-tafs">доор</a> тайлбарласны дагуу. Та зөвшөөрөх хүртэл юу ч илгээгддэггүй бөгөөд Бүртгэл хэсэгт татгалзаж болно. Зөвшөөрөл нь мөн аливаа аналитик күүки, сонголттой маркетингийн харилцаа холбоо, эсвэл таны өгөгдлийн бидний хэрэглээг мэдэгдэхүйц тэлэх шинэ боловсруулалтын өмнө бидний асуух зүйл. Бид аналитик, сурталчилгаа, зайлшгүй бус хяналт ажиллуулдаггүй.
			</li>
			<li>
				<strong>Хуулийн үүрэг</strong> (6(1)(c) зүйл) — татварын бүртгэл (Эстонийн Нягтлан бодох бүртгэлийн тухай хууль §12, 7 жил), хууль ёсны эрх бүхий байгууллагын хүсэлтэд хариу өгөх, мөн хамаарах бол мөнгө угаахтай тэмцэх дүрмээр шаардсан хадгалалт.
			</li>
		</ul>
		<h3 id="ai-in-tafs">tafs апп дахь AI</h3>
		<p>tafs апп аливаа зүйл AI-д очихоос өмнө танаас эдгээр үгээр асууна:</p>
		<ul>
			<li>tafs нь Coach болон таны taf-уудад Anthropic-ийн Claude AI-г ашигладаг.</li>
			<li>Coach болон таны taf-ууд бол AI агентууд: тэдний бичсэнийг AI үүсгэдэг бөгөөд алдаатай байж болно. Taf таны компаниас гадуур илгээсэн мессеж AI агент бичсэн гэдгийг хэлнэ.</li>
			<li>Түүнд юу илгээгддэг: та Coach болон taf-уудадаа бичсэн зүйл, хавсаргасан файлууд, таны холбосон аппууд taf-д ажиллаж байх үед буцаасан зүйл, мөн Coach танд аппад тусалж байх үед таны дэлгэц дээр байгаа зүйл.</li>
			<li>Юу хэзээ ч илгээгддэггүй: таны холбосон аппуудын ашигладаг нууц үг, түлхүүр, мөн таны хурууны хээ.</li>
			<li>Anthropic үүнийг хариулахад ашигладаг бөгөөд 30 хоног хүртэл хадгална.</li>
			<li>Та зөвшөөрөх хүртэл юу ч илгээгддэггүй. Та Бүртгэл хэсэгт татгалзаж болно.</li>
		</ul>
		<p>Тэр мөчид хэн ч байхгүй ажилладаг taf (хуваарийн дагуу, эсвэл ямар нэг зүйл ирэхэд) нь түүнийг үүсгэсэн эсвэл өөртөө авсан хүний, эс бөгөөс бүртгэлийн taf-уудыг удирддаг эхний хүний зөвшөөрөл дээр тулгуурладаг.</p>
		<p><strong>Та татгалзвал</strong> Coach болон таны taf-ууд танд хариулахаа больно. Ажиллалт нь таны зөвшөөрөл дээр тулгуурласан taf түр зогсоно: түүний хуваарь зогсож, ирсэн зүйл хүлээнэ. Зөвшөөрөл дахин өгөгдөх эсвэл бүртгэлийн taf-уудыг удирддаг хэн нэгэн өөрийнхөөрөө авах хүртэл үргэлжилнэ. Татгалзах нь өмнө нь илгээсэнд нөлөөлөхгүй.</p>
		<p>Anthropic <a href="/subprocessors">/subprocessors</a> (англиар)-д, хаана боловсруулдаг, хэзээ өгөгдлийг урт хугацаанд хадгалж болох тухай хамт жагсаалтад байна.</p>
	</section>
}

templ privacySubprocessorsMN() {
	<section id="sub-processors">
		<h2>6. Дэд боловсруулагчид</h2>
		<p>Бид таны хувийн мэдээллийг зарахгүй, сурталчилгааны зорилгоор хуваалцахгүй.</p>
		<p>
			Бид үйлчилгээг хүргэхийн тулд цөөн тооны нийлүүлэгч ажиллуулдаг. Албан ёсны, одоогийн жагсаалт <a href="/subprocessors">/subprocessors</a> (англиар)-д байна; тэр хуудас аливаа өөрчлөлтөөс хойш 30 хоногийн дотор шинэчлэгдэнэ. Бид дэд боловсруулагч бүрээс бичгээр гэрээгээр, хувийн мэдээлэл ЕХ-ээс гарах үед ЕХ-ны Стандарт гэрээний заалтыг оруулан, бидэнтэй дүйцэх хамгаалалт үзүүлэхийг шаарддаг.
		</p>
		<p>
			Хувийн мэдээлэлд нөлөөлөх дэд боловсруулагчийн мэдэгдэхүйц нэмэлт эсвэл солилтыг идэвхтэй үйлчлүүлэгчдэд урьдчилан, эсэргүүцэх эрхтэйгээр мэдэгднэ.
		</p>
	</section>
}

templ privacyTransfersMN() {
	<section id="transfers">
		<h2>7. Олон улсын шилжүүлэг</h2>
		<p>
			Бидний зарим дэд боловсруулагч Европын эдийн засгийн бүсээс гадна, голдуу АНУ-д байгуулагдсан. Ийм шилжүүлэг бүрт бид дараах хамгаалалтын ядаж нэгд тулгуурладаг:
		</p>
		<ul>
			<li>
				<strong>ЕХ–АНУ-ын Өгөгдлийн нууцлалын хүрээ</strong> — Хүрээнд гэрчилгээжсэн АНУ-ын дэд боловсруулагчдад. 2023 оны дундаас хүчинтэй нийцлийн шийдвэр; бид түүний статусын аливаа өөрчлөлтийг хянадаг.
			</li>
			<li>
				<strong>Стандарт гэрээний заалт</strong> — манай шууд дэд боловсруулагчдад 2-р модуль (хянагчаас боловсруулагч руу), гинжлэгдсэн боловсруулагч хамаарах газарт 3-р модуль (боловсруулагчаас дэд боловсруулагч руу). Бид Комиссын баталсан 2021 оны SCC-г ашигладаг.
			</li>
			<li>
				<strong>Нэмэлт арга хэмжээ</strong> — эрсдэлийн үнэлгээ нэмэлт хамгаалалт шаардлагатайг заасан газарт (дамжуулалт ба хадгалалтын үед шифрлэлт, хандалтын бүртгэл, өгөгдлийг багасгах).
			</li>
		</ul>
		<p>
			Та <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> руу имэйл бичиж тодорхой дэд боловсруулагчид хамаарах шилжүүлгийн тодорхой хэрэгслийг хүсч болно.
		</p>
		<p><strong>Таны улс.</strong> Зарим улсын хууль энэ бодлогоос илүү зүйл шаарддаг. Тэдний нэмсэн зүйлийг англиар болон тухайн улсын хэлээр <a href="/privacy/countries">Таны улс</a> (англиар) хуудаснаас үзнэ үү.</p>
	</section>
}

templ privacyRetentionMN() {
	<section id="retention">
		<h2>8. Хадгалалт</h2>
		<p>
			Бид хувийн мэдээллийг боловсруулах зорилго болон хамаарах хуулийн үүрэгтэй нийцэх хамгийн богино хугацаанд хадгална.
		</p>
		<ul>
			<li>
				<strong>Бүртгэл ба нэвтрэлтийн мета өгөгдөл</strong> — бүртгэл устгагдтал. tafs аппад эзэмшигч үүнийг Бүртгэл → <em>Бүртгэл устгах</em>-аар устгана. Вэб дээр үүсгэсэн бүртгэлийг <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> руу имэйл бичиж, GDPR-ийн 12(3) зүйлийн нэг сарын хугацаанд устгана. Аль ч тохиолдолд бүртгэлийн түлхүүрүүд тэр дор нь ажиллахаа болино. tafs аппад устгасан бол буцаах боломжгүй: tafs-ийн чат, тэмдэглэл, холболт тэр дор нь устгагдаж, KIFF-ийн хадгалдаг зүйл 30 хоногийн дотор устгагдана. Вэб дээр устгасан бол эзэмшигч буцааж авахыг хүссэн тохиолдолд 30 хоногийн хүлээлтийн хугацаанд өгөгдлийг хадгалж, дараа нь устгана.
			</li>
			<li>
				<strong>API түлхүүрийн бүртгэл</strong> — бүртгэл устгагдтал, түлхүүр хүчингүй болгосны дараа ч. Агентын нэвтрэлтийн холболтод хамаарах түлхүүр тэр холболттой хамт, дууссанаас хойш 30 хоногийн дараа устгагдана.
			</li>
			<li>
				<strong>Сессийн күүки</strong> — дуустал (өгөгдмөлөөр 24 цаг) эсвэл та гартал.
			</li>
			<li>
				<strong>Урвуу прокси-ийн хандалтын лог</strong> — 90 хоног хүртэл, дараа нь нэгтгэх эсвэл устгана.
			</li>
			<li>
				<strong>Үйлчилгээний лог</strong> — KIFF-ийн үйлчилгээ болон planque ажиллах үедээ бүртгэдэг зүйл: алдаа болон хүсэлт, бүртгэл, хүн эсвэл агентын нэр агуулж болно. 30 хоног, дараа нь устгана.
			</li>
			<li>
				<strong>Нөөц хуулбар</strong> — KIFF-ийн өгөгдлийн сангийн нөөцийг өдөр бүр шифрлэн хийж, нөөц бүрийг 7 хоног хадгалдаг тул устгасан бичлэг тэдгээрээс 7 хоногийн дотор алга болно. tafs болон planque-ийн хадгалалт шифрлэгдсэн цаг хугацааны хуулбарыг 35 хоног хадгалах бөгөөд зөвхөн доголдлын дараа хадгалалтыг сэргээхэд ашигладаг тул устгасан бичлэг тэдгээрээс 35 хоногийн дотор алга болно.
			</li>
			<li>
				<strong>Тенантын аудитын өгөгдөл</strong> — үйлчлүүлэгчийн тенантын тохиргооны дагуу боловсруулагчийн хувиар хадгалагдана. Өгөгдмөл: тенантын амьдралын туршид хадгалагдана; тенант устгагдахад устгагдана. <a href="/security#deletion">/security#deletion</a> (англиар)-г үзнэ үү.
			</li>
			<li>
				<strong>KIFF гарцаар дамжих дуудлага</strong> — дуудлагын аргументууд илгээгдэх, татгалзагдах эсвэл амжилтгүй болтол, дараа нь устгагдана; хэрэгслийн үр дүн 24 цаг, дараа нь устгагдана. Шийдвэрийн бүртгэл болон аргументуудын хэш тенантын аудитын өгөгдөл болон хадгалагдана. <a href="/security#data-kept">/security#data-kept</a> (англиар)-г үзнэ үү.
			</li>
			<li>
				<strong>Хэрэглээ</strong> — гарцаар дамжих дуудлага бүрийн хувьд, дууссаны дараа: аль агент хийсэн, хэрэгсэл, мөн үйлдэл гэж тоологдсон эсвэл үнэгүй байсан (мөн яагаад). Taf эсвэл Coach-ийн ажиллалт бүрийн хувьд, дууссаны дараа: taf, хэзээ, түүний AI-ийн ашигласан кредит, мөн тоологдсон эсвэл яагаад үгүй. Бүртгэл устгагдтал; төлбөрийн боловсруулагчид төлбөрт мэдээлсэн зүйл төлбөрийн бүртгэлтэй хамт хадгалагдана.
			</li>
			<li>
				<strong>Агентын нэвтрэлтийн холболт</strong> — аль агент, аппын нэр, хэн зөвшөөрсөн, хэзээ, сүүлд ашигласан: холболт идэвхтэй байх хугацаанд, дараа нь дууссанаас хойш 30 хоног (тэр хугацаанд хяналтын самбарт жагсаалтад байна), дараа нь токен, API түлхүүрийн хамт устгагдана. Бүгд бүртгэлтэй хамт устгагдана.
			</li>
			<li>
				<strong>tafs</strong> — төхөөрөмжийн push токен та аппаас гарах, төхөөрөмжийг устгах, эсвэл Apple эсвэл Google токен алга болсныг мэдээлэх хүртэл. Төхөөрөмжийн нийтийн түлхүүр, нэр, платформ болон огноо таны ашиглаж байх хугацаанд; та үүнээс гармагц устгагдсан гэж тэмдэглэгдэж бүртгэл устгагдтал хадгалагдах бөгөөд ингэснээр KIFF түүнээс ирсэн хоцорсон хариултаас татгалзаж, өмнөх хариултад аль төхөөрөмж гарын үсэг зурсныг харуулж чадна. Passkey-ийн нийтийн түлхүүр, id болон нэр түүний төхөөрөмжийнхтэй адил хадгалагдана. Компьютер сессээ 90 хоног хүртэл, эсвэл та гартал хадгална. tafs таны компанид хадгалдаг зүйл боловсруулагчийн хувиар хадгалагдана: taf-ын ажиллалт, чат, чатын хураангуйгийн хамт (мөн Setup-ынх) 30 хоног, таны хэрэгслүүдийн буцаасан зүйл зөвхөн ажиллалт дуустал (чатад зөвхөн уншсан зүйлийг дараагийн мессежүүдэд зориулан шифрлэж хадгалах бөгөөд чат нэг цаг идэвхгүй болтол, уншсанаас хойш хамгийн ихдээ дөрвөн цаг ашиглаад дараа нь хэдэн хоногийн дотор автоматаар устгана), санах ойн тэмдэглэл taf устгагдтал; түүний хүргэсэн файлууд тэдгээрийг үүсгэсэн ажиллалтаас хойш 30 хоног, дараа нь нэг өдрийн дотор автоматаар устгагдана, эсвэл таны бүртгэл дэх хэн нэгэн нэгийг устгавал түүнээс өмнө; planque дахь холболтын токен эсвэл түлхүүр, эсвэл Composio дахь удирдагдсан холболтын нэвтрэлт та салгах хүртэл (таны өөр холболт тэр үйлчилгээ үзүүлэгч дэх ижил бүртгэлийг ашиглаж болох бол тэр нь бас салгагдтал ашиглагдалгүй хадгалагдана), мөн түүний зөвшөөрлийн бүртгэл бүртгэл дуустал; <a href="/legal/dpa#annex-4">DPA-ийн 4-р хавсралт</a> (англиар)-ыг үзнэ үү.
			</li>
			<li>
				<strong>Төлбөрийн бүртгэл</strong> — санхүүгийн жилийн төгсгөлөөс 7 жил (Эстонийн Нягтлан бодох бүртгэлийн тухай хууль §12).
			</li>
			<li>
				<strong>App Store болон Google Play худалдан авалт</strong> — Apple эсвэл Google-ийн худалдан авалт бүрийн талаар бидэнд мэдэгдсэн зүйл бүртгэл устгагдтал таны бүртгэлд үлдэнэ. Тэдний борлуулалт, төлбөрийн тайлан, бид төлбөрийн бүртгэл болон 7 жил хадгалдаг, таныг нэрлэдэггүй.
			</li>
			<li>
				<strong>Дэмжлэгийн захидал харилцаа</strong> — сүүлчийн харилцаанаас хойш 3 жил, дараа нь устгагдана.
			</li>
		</ul>
	</section>
}

templ privacyRightsMN() {
	<section id="rights">
		<h2>9. Таны эрх</h2>
		<p>
			GDPR-ийн дагуу та хувийн мэдээллийнхээ талаар дараах эрхтэй:
		</p>
		<ul>
			<li><strong>Хандах</strong> (15-р зүйл) — бид таны өгөгдлийг боловсруулдаг эсэхийн баталгаа, мөн түүний хуулбар.</li>
			<li><strong>Залруулах</strong> (16-р зүйл) — буруу эсвэл дутуу өгөгдлийг засах.</li>
			<li><strong>Устгах</strong> (17-р зүйл) — хуулийн хадгалалтын үл хамаарах зүйлээс бусад таны өгөгдлийг устгах.</li>
			<li><strong>Хязгаарлах</strong> (18-р зүйл) — маргааныг шийдэх хүртэл боловсруулалтыг түр зогсоох.</li>
			<li><strong>Зөөвөрлөх</strong> (20-р зүйл) — таны өгсөн өгөгдлийн машинд уншигдах экспорт.</li>
			<li><strong>Эсэргүүцэх</strong> (21-р зүйл) — хууль ёсны ашиг сонирхол дээр суурилсан боловсруулалтыг; давамгайлах үндэслэл үзүүлж чадахгүй бол бид зогсооно.</li>
			<li><strong>Зөвшөөрлөө татах</strong> (7(3) зүйл) — зөвшөөрөл дээр суурилсан аливаа боловсруулалтад, жишээлбэл tafs апп дахь AI (Бүртгэл хэсэгт, <a href="#ai-in-tafs">дээр</a> дурдсанаар). Татгалзах нь өмнөх хууль ёсны боловсруулалтад нөлөөлөхгүй.</li>
		</ul>
		<p>
			Эдгээр эрхийн аль нэгийг хэрэгжүүлэхийн тулд <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> руу имэйл бичнэ үү. Бид 12(3) зүйлийн дагуу үндэслэлгүй саатуулалгүй, хамгийн оройдоо нэг сарын дотор хариулна; төвөгтэй хүсэлтэд дахин хоёр сар хүртэл сунгаж болох бөгөөд сунгавал танд мэдэгдэнэ.
		</p>
		<h3 id="export-chats">Таны өөрийн tafs чатууд</h3>
		<p>
			tafs аппад Бүртгэл → Миний чатуудыг экспортлох нь taf бүртэй, Coach-ийнхыг оруулан, таны өөрийн чат, хавсаргасан файлуудын нэр, таны өөрийн тэмдэглэлийг унших боломжтой файл болон JSON хэлбэрээр татаж авна. Зөвхөн та экспортолж чадна: админ эсвэл бүртгэлийн эзэмшигч чадахгүй, мөн KIFF-ийн бүртгэлийн экспорт тэдгээрийг оруулдаггүй.
		</p>
		<h3 id="delete-account">Таны tafs бүртгэлийг устгах</h3>
		<p>
			tafs бол KIFF-ийн апп. Таны tafs бүртгэл болон түүний өгөгдлийг устгахын тулд:
		</p>
		<ol>
			<li>tafs аппыг нээж нэвтэрнэ үү.</li>
			<li>Бүртгэл рүү орж <em>Бүртгэл устгах</em>-ыг товшино уу.</li>
			<li>Баталгаажуулна уу. Бүртгэл устгахыг буцаах боломжгүй.</li>
		</ol>
		<p>
			<em>Бүртгэл устгах</em> нь компанийн бүртгэлийг устгах эрхтэй хүнд, ихэвчлэн эзэмшигчид харагдана. Хэрэв та үүнийг харахгүй бол, эсвэл апп байхгүй бол нэвтэрдэг хаягаасаа <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> руу имэйл бичнэ үү, бид таны өгөгдлийг үндэслэлгүй саатуулалгүй, хамгийн оройдоо нэг сарын дотор устгана.
		</p>
		<p>
			Юу устгагдах: бүртгэлийн түлхүүрүүд тэр дор нь ажиллахаа болино. Түүний taf-ууд, чат, тэмдэглэл, хавсаргасан файл, холболтууд тэр дор нь устгагдаж, цаг хугацааны хуулбараас 35 хоногийн дотор устгагдана. KIFF бүртгэлд хадгалдаг зүйл 30 хоногийн дотор, нөөц хуулбараас түүний дараа 7 хоногийн дотор устгагдана. Бүртгэлийг нэрлэсэн үйлчилгээний лог 30 хоногийн дотор алга болно. Тенантын аудитын өгөгдөл тенантын хамт устгагдана. Өгөгдлийн төрөл бүрийг <a href="#retention">Хадгалалт</a> хэсгээс үзнэ үү.
		</p>
		<p id="delete-data">
			Таны зарим өгөгдлийг устгаж бүртгэлийг хадгалахын тулд: аппад чатыг устга, түүний мессеж, хавсаргасан файл түүнтэй хамт явна; taf-ыг устга, түүний чат, тэмдэглэл, холболт түүнтэй хамт явна. Өөр бүхэнд <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> руу имэйл бичиж юуг устгахыг хэлнэ үү. Бид үүнийг үндэслэлгүй саатуулалгүй, хамгийн оройдоо нэг сарын дотор хийнэ.
		</p>
		<p>
			Та хяналтын байгууллагад гомдол гаргах эрхтэй. Манай тэргүүлэх хяналтын байгууллага бол <a href="https://www.aki.ee/en" target="_blank" rel="noopener">Эстонийн Өгөгдөл хамгааллын хяналтын газар (Andmekaitse Inspektsioon)</a>. Та мөн оршин суудаг гишүүн улсынхаа хяналтын байгууллагад гомдол гаргаж болно.
		</p>
		<p><strong>Таны улс.</strong> Зарим улсын хууль энэ бодлогоос илүү зүйл шаарддаг. Тэдний нэмсэн зүйлийг англиар болон тухайн улсын хэлээр <a href="/privacy/countries">Таны улс</a> (англиар) хуудаснаас үзнэ үү.</p>
	</section>
}

templ privacyCookiesMN() {
	<section id="cookies">
		<h2>10. Күүки</h2>
		<p>
			Бид гурван күүки тохируулдаг, бүгд зайлшгүй шаардлагатай, анхдагч талын, зөвхөн HTTPS-ээр илгээгддэг бөгөөд хуудас дээрх скриптэд уншигдахгүй. ЕХ-ны ePrivacy дүрмийн дагуу тэд зөвшөөрөл шаарддаггүй; бид тэдгээрийн оршин байгааг мэдэхийн тулд жагсаадаг. Дэлгэрэнгүйг <a href="/cookies">күүкигийн бодлого</a> (англиар)-оос үзнэ үү.
		</p>
		<ul>
			<li>
				<strong><code>kiff_session</code></strong> — таныг нэвтэрсэн байлгана. Таны нэвтрэлтийн id, имэйл, нэр, мөн хяналтын самбар таны төлөө ашигладаг нэвтрэх мэдээллийг агуулсан гарын үсэг зурсан сессийн күүки. <code>.kiff.dev</code>-д тохируулсан. 24 цаг, эсвэл та гартал үргэлжилнэ.
			</li>
			<li>
				<strong><code>kiff_flash</code></strong> — дараагийн хуудас руу нэг удаагийн мессеж, жишээлбэл "таны түлхүүр үүсгэгдлээ" зөөнө. Гарын үсэг зурсан; шинэ түлхүүр хэзээ ч түүнд байдаггүй. <code>.kiff.dev</code>-д тохируулсан. Дараагийн хуудас уншихад устгагдах бөгөөд хамгийн ихдээ 5 минут.
			</li>
			<li>
				<strong><code>kiff_cb_attempts</code></strong> — нэвтрэх хуудас хэдэн удаа дахин ачаалагдсаныг тоолж, гогцоонд орсон нэвтрэлтийг зогсооно. Зөвхөн тэр хуудас руу илгээгдэнэ. 5 минут үргэлжилж, нэвтрэлт эхлэх эсвэл амжилттай болоход цэвэрлэгдэнэ.
			</li>
		</ul>
		<p>
			Бид аналитик күүки, сурталчилгааны күүки, эсвэл гуравдагч этгээдийн хянагч ашигладаггүй. Хэрэв хэзээ нэг өдөр нэмбэл ePrivacy болон EDPB-ийн 2023 оны хяналтын технологийн удирдамжийн дагуу күүки тохируулахаас өмнө зөвшөөрлийн баннер харуулна.
		</p>
		<p>
			Хэрэв та Clerk (манай нэвтрэлтийн дэд боловсруулагч)-аар нэвтэрвэл Clerk өөрийн фронтенд домайн (<code>clerk.kiff.dev</code>) дээр мөн күүки тохируулна. Тэдгээр күүки нь Clerk таныг нэвтрэх урсгалд таних зайлшгүй шаардлагатай бөгөөд манайхтай адил Clerk-ийн нууцлалын бодлогоор зохицуулагдана. Дэлгэрэнгүйг дэд боловсруулагчдын жагсаалтаас үзнэ үү.
		</p>
	</section>
}

templ privacySecurityMN() {
	<section id="security">
		<h2>11. Аюулгүй байдал</h2>
		<p>
			Манай техникийн болон зохион байгуулалтын аюулгүй байдлын арга хэмжээг <a href="/security">/security</a> (англиар)-д баримтжуулсан. Тэдгээрт өгөгдлийн сангийн түвшний тенантын тусгаарлалт, дамжуулалтын үед TLS 1.2+, удирдагдах үйлчилгээ үзүүлэгчийн өгөгдмөл хадгалах үеийн шифрлэлт, хамгийн бага эрхийн зарчимд суурилсан хандалтын хяналт орно.
		</p>
		<p>
			Бид хувийн мэдээллийн зөрчлийн талаар хохирсон үйлчлүүлэгчдэд шалтгаангүй хойшлуулалгүй, баталгаажсанаас хойш 72 цагийн дотор, GDPR-ийн 33-р зүйлтэй нийцүүлэн мэдэгднэ. Мэдэгдэлд зөрчлийн шинж чанар, хамаарах өгөгдлийн субъект, бичлэгийн ангилал ба ойролцоо тоо, магадлалтай үр дагавар, авсан эсвэл санал болгосон арга хэмжээг оруулна.
		</p>
	</section>
}

templ privacyChildrenMN() {
	<section id="children">
		<h2>12. Хүүхдүүд</h2>
		<p>
			KIFF Cloud нь хүүхдэд чиглээгүй хөгжүүлэгчийн дэд бүтцийн бүтээгдэхүүн юм. Бид 16-аас доош насны хүүхдийн хувийн мэдээллийг санаатайгаар цуглуулдаггүй. Хэрэв хүүхэд бидэнд хувийн мэдээлэл өгсөн гэж үзвэл <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> руу холбогдоно уу, бид үүнийг устгана.
		</p>
	</section>
}

templ privacyAutomatedMN() {
	<section id="automated">
		<h2>13. Автомат шийдвэр гаргалт</h2>
		<p>
			KIFF Cloud-ын runtime манай үйлчлүүлэгчдийн илгээсэн өгөгдөл дээр тодорхойлогдсон бодлогын шийдвэр гаргадаг. Эдгээр нь GDPR-ийн 22-р зүйлийн утгаар хууль зүйн эсвэл ижил төстэй мэдэгдэхүйц үр дагавар бүхий таны тухай шийдвэр биш; тэдгээр нь үйлчлүүлэгчийн өөрийн бодлогын дагуу гүйцэтгэсэн үйлчлүүлэгчийн үйлдлийн (буцаан олголт, захиалга, мессеж гэх мэт) тухай шийдвэр.
		</p>
		<p>
			KIFF Cloud-ыг өөрсдийн эцсийн хэрэглэгчдэд нөлөөлөх шийдвэр гаргахад ашигладаг үйлчлүүлэгчид 22-р зүйлийн дагаж мөрдөлтийг өөрсдөө хариуцна. Манай удирдлагын баримтууд тэдгээр үйлчлүүлэгчдэд хүний хяналтыг батлахад хэрэгтэй аудитын мөрийг өгөхөөр зохиогдсон боловч тэр хяналтыг хангах хуулийн үүрэг үйлчлүүлэгчид оногдоно.
		</p>
	</section>
}

templ privacyChangesMN() {
	<section id="changes">
		<h2>14. Энэ бодлогын өөрчлөлт</h2>
		<p>
			Бид энэ бодлогыг үе үе шинэчилж болно. Мэдэгдэхүйц өөрчлөлтийг идэвхтэй үйлчлүүлэгчдэд имэйлээр, мөн энэ хуудсан дээрх тод баннераар дор хаяж 30 хоног мэдэгднэ. Мэдэгдэхүйц бус өөрчлөлтийг шинэ "сүүлд шинэчилсэн" огнооотойгоор нийтэлнэ.
		</p>
	</section>
}

