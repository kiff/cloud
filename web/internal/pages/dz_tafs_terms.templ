// texts only, so a link to any other page goes to English and says so.
templ TafsTermsDZ() {
	@components.LayoutSiteWithMeta("tafs གི་ཆ་རྐྱེན།", "KIFF གི་ཨེཔ་ tafs གི་ཆ་རྐྱེན། སུ་གིས་བྱིན་ནི་ཨིན་ན་དང་། ཁྱོད་ཀྱི་རྩིས་ཐོ། taf གིས་ཕྱིར་ཨིན་ན་དང་ཁྱོད་ཀྱིས་དེ་ཚད་འཛིན་འབད་ཐངས། ལས་སྤྱོད་འོས་འབབ། འཛུགས་འགྱོ། འགན་འཁུར་དང་མཇུག་བསྡུ།", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · ཆ་རྐྱེན།</p>
				<h1>tafs གི་ཆ་རྐྱེན།</h1>
				<p class="legal-meta"><strong>མཇུག་གི་གསར་བསྐྱར།</strong> སྤྱི་ལོ་ 2026 ཟླ་བ་བཅུ་གཅིག་པའི་ཚེས་ 21</p>
				<p class="legal-disclaimer">ཆ་རྐྱེན་འདི་ཚུ་ iPhone, iPad, Android དང་གློག་ཀླད་ཚུ་གི་དོན་ལུ་ KIFF གི་ཨེཔ་ tafs དང་དེའི་རྒྱབ་ཀྱི་ཞབས་ཏོག་གི་དོན་ལས་ཨིན། tafs འདི་ KIFF Cloud གི་ཆ་ཤས་ཅིག་ཨིན་པས། ཤོག་ལེབ་འདི་གིས་ <a href="/dz/terms">KIFF གི་ཞབས་ཏོག་ཆ་རྐྱེན།</a> གིས་དེ་གི་སྐོར་ལས་ཞུ་མི་འདི་བསྐྱར་ཞུས་ཏེ་ དེ་ལུ་ཅི་ཡང་མི་བསྣན། ཤོག་ལེབ་འདི་གིས་མ་བསྡུ་མི་གང་ཡང་ལུ་ KIFF གི་ཆ་རྐྱེན་ཚུ་འཇུག་འོང་། དྲི་བ། <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.</p>
			</header>
			<section id="provider">
				<h2>1. tafs སུ་གིས་བྱིན་ནི་ཨིན་ན།</h2>
				<p>tafs འདི་ཨེསྟོ་ནི་ཡ་ནང་ཐོ་བཀོད་འབད་ཡོད་པའི་སྒེར་གྱི་ཚད་ཡོད་ལས་ཁུངས་ <strong>Kiff Agents OÜ</strong> (ཐོ་བཀོད་ཨང་ 17372313) གིས་བྱིན་ཡོདཔ་ཨིན། ཁོང་གི་ཁ་བྱང་ Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, ཨེསྟོ་ནི་ཡ། རྩིས་ཐོ་ཅིག་བཟོ་བའམ་ ཡང་ན་གཞན་ཅི་འབད་རུང་ tafs ལག་ལེན་འཐབ་པའི་སྒོ་ལས་ ཁྱོད་ཀྱིས་ཆ་རྐྱེན་འདི་དང་ KIFF གི་ཆ་རྐྱེན་ཚུ་ལུ་མོས་མཐུན་འབདཝ་ཨིན། ཁྱོད་ཀྱིས་ལས་ཁུངས་ཅིག་གི་ཁ་ཐོག་ལས་ངོས་ལེན་འབད་པ་ཅིན་ ཁྱོད་ལུ་དེ་བཅིང་ནིའི་དབང་ཚད་ཡོདཔ་ངེས་གཏན་བཟོཝ་ཨིན།</p>
			</section>
			<section id="account">
				<h2>2. ཁྱོད་ཀྱི་རྩིས་ཐོ།</h2>
				<p>ཁྱོད་ཀྱིས་ KIFF རྩིས་ཐོ་ཅིག་གིས་ tafs ནང་ནང་འཛུལ་འབདཝ་ཨིན། ཡང་དག་པའི་ཆ་འཕྲིན་བྱིན། ཁྱོད་ཀྱི་ནང་འཛུལ་གྱི་ཆ་འཕྲིན་ཚུ་གསང་བ་སྦེ་བསྐྱངས། ཁྱོད་ཀྱི་རྩིས་ཐོའི་འོག་ལུ་འབད་མི་འགྱོ་ལས་འགན་ཆ་མཉམ་དང་ ཁྱོད་ཀྱིས་ནང་འཛུལ་བཅུག་མི་མི་རེ་རེའི་དོན་ལུ་ ཁྱོད་འགན་འཁུར་དགོ། ཁྱོད་ཀྱི་ལོ་འདི་ཉུང་མཐའ་ལོ་ 16 ཡང་ན་ ཁྱོད་སྡོད་ས་ལུ་ཌི་ཇི་ཊལ་མོས་མཐུན་གྱི་ལོ་ཚད་ འདི་གཉིས་ཀྱི་ནང་ལས་མཐོ་ཡོད་མི་ འབད་དགོ། tafs འདི་ <a href="https://www.anthropic.com/supported-countries">Anthropic གིས་ཐོ་བཀོད་འབད་མི་</a> བཟུམ་སྦེ་ Anthropic གིས་རང་གི་ཞབས་ཏོག་བྱིན་མི་རྒྱལ་ཁབ་ཡང་ན་ས་ཁུལ་ལས་ཅིག་རེ་ལག་ལེན་འཐབ་ཚུགས། ཐོ་ཡིག་དེ་ལས་ཕྱིར་ཡོད་པའི་རྒྱལ་ཁབ་ཡང་ན་ས་ཁུལ་ཅིག་ནང་ཡོད་པའི་ལས་ཁུངས་ལུ་མེན། ཁྱོད་ཀྱིས་ཡང་ན་ ཁྱོད་ཀྱིས་ལག་ལེན་འཐབ་མི་ལས་ཁུངས་དེ་ ཡུ་རོབ་མཐུན་ཚོགས་ ཡང་ན་ མི་རིགས་མཉམ་འབྲེལ་ ཡང་ན་ ཨ་མེ་རི་ཀའི་བཀག་སྡོམ་ཚུ་གི་འོག་ལུ་ཡོད་པ་ཅིན་ མེན། (KIFF གི་ཆ་རྐྱེན། §4)།</p>
			</section>
			<section id="what-a-taf-does">
				<h2>3. taf གིས་ཅི་འབདཝ་ཨིན་ན།</h2>
				<p>tafs ནང་ཁྱོད་ཀྱིས་ལས་ཀ་ཅིག་ taf ལུ་ཕུལཝ་ཨིན། taf འདི་ཁྱོད་ཀྱིས་མཐུདཔ་མི་ལག་ཆ་ཚུ་དང་ ཁྱོད་ཀྱིས་དེ་གི་དོན་ལུ་བྱིན་མི་ KIFF Cards ཚུ་གི་ནང་ འགོ་འདྲེན་བཟོ་ཐོག་ལས་ལཱ་འབད་མི་ AI ལས་བྱེད་པ་ཅིག་ཨིན། ཁོ་གིས་ལག་ལེན་འཐབ་མི་ AI ཟུར་དཔེ་འདི་ Anthropic གིས་བྱིནམ་ཨིན། tafs གི་ AI ལས་བྱེད་པ་ Setup གིས་ ལག་ཆ་ཅིག་མཐུདཔ་དང་ taf ཅིག་གཞི་སྒྲིག་འབད་ནི་ལུ་ཁྱོད་ལུ་རོགས་རམ་བྱིནམ་ཨིན། འདི་གིས་རང་མགོའི་ཐོག་ལས་ཅི་ཡང་མི་མཐུད། ཁྱོད་ཀྱིས་ལག་ཆ་དེའི་རང་ཉིད་ཀྱི་ཞབས་ཏོག་པ་ལུ་ནང་འཛུལ་འབད། མཐུད་མཚམས་རེ་རེ་དང་ taf གིས་ལག་ལེན་འཐབ་ཚུགས་པའི་ལག་ཆ་ཚུ་ དེ་གི་ Cards ཚུ་ཁྱོད་ཀྱི་ཐབས་འཕྲུལ་གུ་ཆ་འཇོག་འབདཝ་ཨིན།</p>
				<p>taf ཅིག་གི་སྙན་ཞུ་དང་ འཕྲིན་ཡིག ཤེས་རྟོགས་དྲན་ཐོ་ཚུ་ AI ཟུར་དཔེ་ཅིག་གིས་འབྲིསཔ་ཨིནམ་ལས་ ཚུད་ཚུགས་པ། དེ་ལུ་བརྟེན་ནི་གི་ཧེ་མར་གལ་ཅན་གྱི་དོན་ཚུ་བརྟག་ཞིབ་འབད། ཁྱོད་ཀྱི་ལས་ཁུངས་ལས་ཕྱིར་ཡོད་པའི་མི་ལུ་ taf གིས་འབྲི་མི་གང་ལུ་ཡང་ དེ་ AI ལས་བྱེད་པ་ཅིག་གིས་བྲིསཔ་ཨིནམ་སླབ་འོང་།</p>
			</section>
			<section id="control">
				<h2>4. ཁྱོད་ཀྱི་ཚད་འཛིན། Card དང་ཆ་འཇོག</h2>
				<p>taf གིས་ཁྱོད་ཀྱི་ལག་ཆ་ཚུ་ལུ་ KIFF བརྒྱུད་དེ་རྐྱངམ་གཅིག་འཐོབ་པའི་གནས་སྟངས་ཨིན། KIFF གིས་ཁ་པར་རེ་རེ་ལུ་གཏོང་བའི་ཧེ་མར་ taf གི་ Cards ཚུ་དང་མཉམ་བརྟག་ཞིབ་འབདཝ་ཨིན། ཁྱོད་ཀྱིས་བྱིན་མི་ Card ཅིག་གི་ནང་ཁ་པར་ཅིག་ ཁྱོད་ཀྱི་བཀོད་ཁྱབ་ལྟར་འབད་དེ་འབདཝ་ཨིན། Card ལས་ཕྱིར་ཡོད་པའི་ཁ་པར་ཅིག་ Card གིས་སླབ་པ་བཟུམ་སྦེ་བཞག་ཡང་ན་ ངོས་ལེན་མེད་པའི་འགྱུར། བཞག་མི་ཁ་པར་ཅིག་ བཞག་མི་ཁ་པར་ལུ་ལན་འདེབས་འབད་ནི་ལུ་ཁྱོད་ཀྱི་རྩིས་ཐོ་གིས་ཆོག་ཐམ་བྱིན་མི་ཅིག་གིས་ཆ་འཇོག་འབད་ཞིནམ་ལས་རྐྱངམ་གཅིག་འབདཝ་ཨིན།</p>
				<p>ཁྱོད་ཀྱིས་ taf རེ་རེའི་ལས་ཀ་དང་ Cards ཚུ་སེལ་འཐུ་འབད། དེ་གི་བཞག་མི་ཁ་པར་ཚུ་ལུ་ལན་འདེབས་འབད། ཁྱོད་ཀྱིས་མཐུད་མི་ལག་ཆ་དང་རྩིས་ཐོ་ཚུ་ལག་ལེན་འཐབ་ནིའི་ཆོག་ཐམ་ཡོདཔ་ངེས་གཏན་བཟོ། ཁྱོད་ཀྱིས་ taf གཅིག་ཡང་ན་ཆ་མཉམ་བཀག་ཚུགས། taf ཅིག་འཕྲལ་དུ་བཞག་ཚུགས། དེ་གི་ Card ག་ཅི་འབད་རུང་ཆ་མེད་བཟོ་ཚུགས། ཡང་ན་རྩ་བསྐྲད་འབད་ཚུགས། ཁྱོད་ཀྱིས་ taf བཀག་པའམ་ Card ཆ་མེད་བཟོ་མི་དུས་ཚོད་ལས་བཟུང་ KIFF གིས་ taf དེ་ཡང་ན་ Card དེའི་འོག་ལུ་ཁ་པར་གསརཔ་ཅིག་ཡང་ཆོག་ཐམ་མི་བྱིན། ལག་ཆ་ཅིག་གི་ཞབས་ཏོག་པ་ལུ་ཧེ་མ་ལས་གཏང་ཡོད་པའི་ཞུ་བ་ཅིག་ད་རུང་མཇུག་བསྡུ་ཚུགས། ང་བཅས་ཀྱིས་ཁ་པར་གསརཔ་ཚུ་བཀག་ནི་ཨིན་རུང་ ཞབས་ཏོག་པ་གིས་འབད་ཡོད་མི་ལོག་སྟེ་འགྱོ་མི་ཚུགས། ཁ་གསལ་ <a href="/dz/terms#tafs">KIFF གི་ཆ་རྐྱེན། §3A</a> ནང་ཡོད།</p>
				<p>EU AI སྲོལ་ལུགས་འོག་ལུ་ Kiff Agents OÜ འདི་ tafs གི་བྱིན་མི་དང་ ཁྱོད་འདི་དེ་གི་ལག་ལེན་པ་ཨིན། tafs འདི་དེ་གིས་བྱིན་མི་ལས་ཀ་ཚུ་གི་དོན་ལུ་རྐྱངམ་གཅིག་ལག་ལེན་འཐབ། AI སྲོལ་ལུགས་གིས་བཀག་པའམ་ཉེན་ཁ་མཐོ་ཟེར་བཟོ་མི་ལག་ལེན་ག་ཅི་ལུ་ཡང་མེན། དཔེར་ན་ མི་ཅིག་གི་ལཱ་གཡོག་ ཡང་ན་ཀ་ཐོག་ནང་འཛུལ་གྱི་ཐད་ལས་ཐག་གཅོད།</p>
			</section>
			<section id="acceptable-use">
				<h2>5. ལག་ལེན་འཐབ་ཆོག་པ།</h2>
				<p>ཁྱོད་དང་ ཁྱོད་ཀྱི་མི་ཚུ་ ཁྱོད་ཀྱི་ tafs ཚུ་གིས་ <a href="/acceptable-use">ལག་ལེན་འཐབ་ཆོག་པའི་སྲིད་བྱུས།</a> (ཨིང་ཁའི་ནང་) བསྒྲུབ་དགོ། ལས་བྱེད་པ་ཅིག་གི་བྱ་བ་འདི་ཁྱོད་ཀྱི་བྱ་བ་ཨིན། གཞན་དག་ཁར་ ཁྱོད་ཀྱིས་ tafs ཁྲིམས་ལུགས་མི་བརྩི་བཞག་ནི་ལུ། ཁྱོད་ལུ་ལག་ལེན་འཐབ་ཆོག་ཐམ་མེད་པའི་རིམ་ལུགས་དང་རྩིས་ཐོ་ལུ་ལས་འཆར་བཟོ་ནི་ལུ། ཁྱོད་ཀྱི་མེན་པའི་ནང་འཛུལ་གྱི་ལག་ཆ་མཐུད་ནི་ལུ། སྤེམ་གཏོང་ནི་ལུ། ཡང་ན་ Card དང་ ཚད་བཀག ཡང་ན་བཞག་ཐབས་ལས་འདས་ནི་ལུ་ལག་ལེན་མི་འཐབ། ཡིད་ཆེས་འོས་པའི་འགལ་བ་ཅིག་གི་དོན་ལུ་ང་བཅས་ཀྱིས་འཕྲལ་དུ་བཀག་ཚུགས།</p>
			</section>
			<section id="fees">
				<h2>6. འཛུགས་འགྱོ།</h2>
				<p>དུས་མཐུན་འདི་གི་དུས་ཚོད་ལུ་ Solo འདི་ཟླ་བ་རེ་ལུ་ { tafsCostDZ.money(TafsSoloCents) } ཨིན་པས་ VAT བསྡོམས་དེ་ ཟླ་བ་རེ་ལུ་ཀེ་རེ་ཌིཊ་ { tafsCostDZ.number(TafsSoloCredits) } དང་འཁྱེར་ཏེ་ ཨེཔ་ནང་ App Store ཡང་ན་ Google Play བརྒྱུད་དེ་ཚོང་འབད་དེ་ཡོད། ཨེཔ་ནང་ཉོ་མི་ཀེ་རེ་ཌིཊ་ཚོགས་པ་ཚུ་ { tafsCostDZ.money(TafsPackCents[TafsSoloCredits]) } ལས་འགོ་བཙུགས་ཏེ་ཡོད། དེ་ཚུ་དུས་ཡུན་མི་རྫོགས། taf ཅིག་གི་གཡོག་རེ་རེ་གིས་ཁོ་གིས་ལག་ལེན་འཐབ་མི་ AI གི་དོན་ལུ་ཀེ་རེ་ཌིཊ་ལག་ལེན་འཐབ། Coach དང་ tafs གཞི་སྒྲིག་འབད་ནི་འདི་ Coach གི་ཚད་འཛིན་ལག་ལེན་ནང་བསྡོམས་ཡོད། འདི་ཚུ་ཡུ་རོ་ས་ཁུལ་གྱི་གོང་ཚད་ཨིན། གཞན་ས་ཁུལ་ནང་ App Store ཡང་ན་ Google Play གིས་རྒྱལ་ཁབ་དེའི་སྲོལ་ལུགས་ལུ་དགོས་མི་བཟུམ་སྦེ་ ས་གནས་ཁྲལ་དང་བཅས་ཡང་ན་མེད་པར་ ཁྱོད་ཀྱི་དངུལ་ཚད་ནང་གོང་ཚད་སྟོནམ་ཨིན། དེ་ཁྱོད་ཀྱིས་སྤྲོད་མི་གོང་ཚད་ཨིན། མིག་སྔའི་གོང་ཚད་ཚུ་ <a href="/pricing">གོང་ཚད་ཤོག་ལེབ་</a> (ཨིང་ཁའི་ནང་) ནང་ཡོད། tafs འདི་ KIFF གི་ Company འཆར་གཞི་གི་ཆ་ཤས་ཅིག་ཡང་ཨིན།</p>
				<p>ཚོད་ལྟ་ཆ་རྐྱེན་མེད། ཨེཔ་ནང་ཉོ་མི་ Solo འདི་དངུལ་སྤྲོད་ཐངས། བསྐྱར་གསོ་དང་དངུལ་ལོག་སྤྲོད་ཐངས་ཀྱི་སྐོར་ལས་ཚོང་ཁང་དེའི་ཆ་རྐྱེན་གྱི་འོག་ལུ་ ཁྱོད་ཀྱི་ Apple ཡང་ན་ Google Play ཞིབ་འཇུག་ནང་འཛིན་སྐྱོང་དང་ཆ་མེད་བཟོཝ་ཨིན། འཆར་གཞི་འདི་ཁྱོད་ཀྱིས་སྤྲོད་མི་དུས་ཡུན་རྫོགས་ཚུན་འབད་འགྱོཝ་ཨིན། ཁྱོད་ EU ནང་ཉོ་མི་ཅིག་ཨིན་པ་ཅིན་ ཉོ་ཚོང་འབད་ཞིནམ་ལས་ཉིནམ་ 14 གི་ནང་འཐོན་ཚུགས། ཁ་གསལ་ <a href="/dz/terms#fees">KIFF གི་ཆ་རྐྱེན། §8</a> ནང་ཡོད།</p>
			</section>
			<section id="liability">
				<h2>7. འགན་འཁུར།</h2>
				<p>tafs འདི་ KIFF གི་ཆ་རྐྱེན་ནང་གི་ཁུངས་སྐྱེལ་ (§10) ལས་གཞན་ "ཡོད་པ་བཟུམ་སྦེ་" དང་ "འཐོབ་པ་བཟུམ་སྦེ་" བྱིནམ་ཨིན། ཁྲིམས་ཀྱིས་གནང་མི་ཚད་ཀྱི་ནང་ ཕྱོགས་གཉིས་ཅིག་ཡང་ འགྲོ་ཁག་ཡང་ན་ལས་འབྲས་ཀྱི་གནོད་པ་གི་དོན་ལུ་འགན་མི་འཁུར། ཕྱོགས་རེ་རེའི་བསྡོམས་འགན་འདི་ <a href="/dz/terms#liability">KIFF གི་ཆ་རྐྱེན། §12</a> གིས་སླབ་པ་བཟུམ་སྦེ་ཚད་བཀག་ཡོད། ཁྲིམས་ཀྱིས་ཚད་བཀག་ནི་ལུ་མ་གནང་མི་འགན་འཁུར་འདི་ཅི་ཡང་གིས་ཚད་མི་བཀག།</p>
			</section>
			<section id="termination">
				<h2>8. མཇུག་བསྡུ།</h2>
				<p>ཁྱོད་ཀྱིས་དུས་ཚོད་ག་ཅི་ལུ་ཡང་བཀག་ཚུགས། ཨེཔ་ནང་ རྩིས་ཐོ་ → <em>རྩིས་ཐོ་བསུབ</em> ནང་ཁྱོད་ཀྱི་རྩིས་ཐོ་བསུབ། ཧེ་མར་ རྩིས་ཐོ་ → ངའི་གྲོས་ཚོགས་ཚུ་ཕྱིར་འདྲེན་འབད་ ལས་ཁྱོད་ཀྱི་གྲོས་ཚོགས་ཚུ་ཕྱིར་འདྲེན་འབད། ང་བཅས་ཀྱིས་ཁྱོད་ཀྱི་ལག་ལེན་འདི་ཉིནམ་སུམ་ཅུའི་ནང་ཁ་སྒྲིག་མ་འབད་མི་འགལ་བ་ཚབས་ཅན་ཅིག་གི་དོན་ལུ་ བརྡ་བསྐུལ་ལས་ཤུལ་ལུ་ ཡང་ན་ལག་ལེན་འཐབ་ཆོག་པའི་འགལ་བ་ཅིག་གི་དོན་ལུ་འཕྲལ་དུ་མཇུག་བསྡུ་ཚུགས། ཁྱོད་ཀྱིས་གཡོག་འདྲེན་འབད་ནི་དང་ཁྱོད་ཀྱི་གནས་ཚུལ་ལག་འཁྱེར་འགྱོ་ནིའི་དབང་ཚད་ཚུ་ <a href="/dz/terms#term">KIFF གི་ཆ་རྐྱེན། §9</a> ནང་ཡོད།</p>
			</section>
			<section id="governing-law">
				<h2>9. འགྱུར་བ་དང་ཁྲིམས་འཇུག་པ།</h2>
				<p>KIFF གི་ཆ་རྐྱེན་ཚུ་གིས་རང་གི་དོན་ལུ་སླབ་མི་བཟུམ་སྦེ་ (§16) ང་བཅས་ཀྱིས་ཆ་རྐྱེན་འདི་ཚུ་བསྒྱུར་ཨིན། དེ་ཚུ་ཨེསྟོ་ནི་ཡ་རྒྱལ་ཁབ་ཀྱི་ཁྲིམས་ཀྱིས་འཛིན་སྐྱོང་འབད་ཡོདཔ་དང་ རྩོད་གཞི་ཚུ་ Tallinn ནང་གི་ Harju རྫོང་ཁག་ཁྲིམས་ཁང་ལུ་འགྱོཝ་ཨིན། ཁྱོད་ EU ཚོགས་མི་རྒྱལ་ཁབ་གཞན་ཅིག་ནང་ཉོ་མི་ཅིག་ཨིན་པ་ཅིན་ ཁྱོད་ཀྱི་རང་རྒྱལ་ཁབ་ཀྱི་ངེས་པའི་ཉོ་མི་སྲུང་སྐྱོབ་ཀྱི་སྲོལ་ལུགས་ཚུ་ད་རུང་འཇུག་འོང་།</p>
			</section>
			<section id="contact">
				<h2>10. འབྲེལ་བ།</h2>
				<p>ཆད་ཁྲིམས་ཀྱི་དྲི་བ། <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>. ཨེཔ་གི་རོགས་རམ། <a href="mailto:support@kiff.dev">support@kiff.dev</a>. སྒེར་གསང་། <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>། དང་ tafs གིས་སྒེར་གྱི་གནས་ཚུལ་ག་དེ་སྦེ་འཕྲོད་ཐངས་འདི་ <a href="/dz/tafs/privacy">tafs གི་སྒེར་གསང་སྲིད་བྱུས།</a> ནང་ཡོད།</p>
			</section>
		</article>
	}
}
