package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// PrivacyTK is KIFF's privacy policy (/privacy) in Turkmen, at /tk/privacy.
// It is a translation of Privacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Turkmen has the legal
// texts only, so a link to any other page goes to English and says so.
templ PrivacyTK() {
	@components.LayoutSite("KIFF — privacy policy", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@privacyHeadTK()
			@privacyWhoWeAreTK()
			@privacyScopeTK()
			@privacyRolesTK()
			@privacyCategoriesTK()
			@privacyLawfulBasesTK()
			@privacySubprocessorsTK()
			@privacyTransfersTK()
			@privacyRetentionTK()
			@privacyRightsTK()
			@privacyCookiesTK()
			@privacySecurityTK()
			@privacyChildrenTK()
			@privacyAutomatedTK()
			@privacyChangesTK()
			@privacyContactTK()
		</article>
	}
}

templ privacyHeadTK() {
	<header class="legal-head">
		<p class="legal-badge">Gizlinlik syýasaty · v0.1</p>
		<h1>Gizlinlik syýasaty</h1>
		<p class="legal-meta">
			<strong>Soňky täzelenme:</strong> 2026-njy ýylyň 24-nji noýabry.
			<strong>Güýje girýän senesi:</strong> 2026-njy ýylyň 24-nji maýy.
		</p>
		<p class="legal-disclaimer">
			Bu syýasat KIFF Cloud-yň web sahypasynda, dolandyryş panelinde, API-de we iPhone, iPad, Android we kompýuterler üçin tafs programmasynda şahsy maglumatlary nähili işleýändigini düşündirýär. Soraglar:
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</header>
}

