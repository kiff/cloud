package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// PrivacyTH is KIFF's privacy policy (/privacy) in Thai, at /th/privacy.
// It is a translation of Privacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Thai has the legal
// texts only, so a link to any other page goes to English and says so.
templ PrivacyTH() {
	@components.LayoutSite("KIFF — privacy policy", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@privacyHeadTH()
			@privacyWhoWeAreTH()
			@privacyScopeTH()
			@privacyRolesTH()
			@privacyCategoriesTH()
			@privacyLawfulBasesTH()
			@privacySubprocessorsTH()
			@privacyTransfersTH()
			@privacyRetentionTH()
			@privacyRightsTH()
			@privacyCookiesTH()
			@privacySecurityTH()
			@privacyChildrenTH()
			@privacyAutomatedTH()
			@privacyChangesTH()
			@privacyContactTH()
		</article>
	}
}

templ privacyHeadTH() {
	<header class="legal-head">
		<p class="legal-badge">นโยบายความเป็นส่วนตัว · v0.1</p>
		<h1>นโยบายความเป็นส่วนตัว</h1>
		<p class="legal-meta">
			<strong>อัปเดตล่าสุด:</strong> 24 พฤศจิกายน ค.ศ. 2026 <strong>วันที่มีผลบังคับใช้:</strong> 24 พฤษภาคม ค.ศ. 2026
		</p>
		<p class="legal-disclaimer">
			นโยบายนี้อธิบายวิธีที่ KIFF Cloud ประมวลผลข้อมูลส่วนบุคคลทั่วทั้งเว็บไซต์ แดชบอร์ด API และแอป tafs สำหรับ iPhone, iPad, Android และคอมพิวเตอร์ คำถาม: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
		</p>
	</header>
}

templ privacyWhoWeAreTH() {
	<section id="who-we-are">
		<h2>1. เราคือใคร</h2>
		<p>
			KIFF Cloud ดำเนินการโดย <strong>Kiff Agents OÜ</strong> บริษัทจำกัดเอกชนที่จดทะเบียนในเอสโตเนีย ข้อมูลทะเบียน:
		</p>
		<ul>
			<li><strong>รหัสทะเบียน:</strong> 17372313 (ทะเบียนธุรกิจอิเล็กทรอนิกส์เอสโตเนีย)</li>
			<li><strong>หมายเลข VAT:</strong> EE102924327</li>
			<li><strong>ที่อยู่จดทะเบียน:</strong> Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estonia</li>
			<li><strong>ผู้ติดต่อด้านความเป็นส่วนตัว:</strong> <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a></li>
			<li><strong>หนังสือแจ้งทางกฎหมายอย่างเป็นทางการ:</strong> <a href="mailto:legal@kiff.dev">legal@kiff.dev</a></li>
		</ul>
		<p>
			เนื่องจาก Kiff Agents OÜ ตั้งอยู่ในสหภาพยุโรป ระเบียบการคุ้มครองข้อมูลส่วนบุคคลของสหภาพยุโรป (<abbr title="ระเบียบการคุ้มครองข้อมูลส่วนบุคคล">GDPR</abbr>) จึงใช้กับการประมวลผลของเราโดยตรง เราไม่ต้องมีตัวแทนในสหภาพยุโรปตามมาตรา 27
		</p>
	</section>
}

templ privacyScopeTH() {
	<section id="scope">
		<h2>2. ขอบเขตของนโยบายนี้</h2>
		<p>
			นโยบายนี้ครอบคลุมข้อมูลส่วนบุคคลที่เราประมวลผลเมื่อคุณมีปฏิสัมพันธ์กับ:
		</p>
		<ul>
			<li><a href="https://kiff.dev"><code>kiff.dev</code></a> — เว็บไซต์การตลาดของเรา หน้านโยบายนี้ และหน้าแสดงใบเสร็จสาธารณะ</li>
			<li><a href="https://app.kiff.dev"><code>app.kiff.dev</code></a> — แดชบอร์ดของเราที่ต้องยืนยันตัวตน</li>
			<li><a href="https://api.kiff.dev"><code>api.kiff.dev</code></a> — HTTP API ของเรา</li>
			<li id="tafs"><strong>tafs</strong> — แอปของเราสำหรับ iPhone, iPad, Android และคอมพิวเตอร์ (Mac, Windows และ Linux) และบริการเบื้องหลัง (รวมถึง Setup ที่เชื่อมต่อเครื่องมือของบริษัท และ planque ที่เก็บการเชื่อมต่อเหล่านั้น) ซึ่งบริษัทมอบงานให้เอเจนต์ AI ที่ทำงานภายใน KIFF Card</li>
		</ul>
		<p>
			นโยบายนี้<em>ไม่</em>ครอบคลุมเฟรมเวิร์กโอเพนซอร์ส <code>kiff/kiff</code> ที่คุณอาจรันเอง เมื่อคุณรันเฟรมเวิร์กบนโครงสร้างพื้นฐานของคุณเอง คุณเป็นผู้ควบคุมข้อมูลที่เฟรมเวิร์กประมวลผล และ Kiff Agents OÜ ไม่เกี่ยวข้องกับการประมวลผลนั้น
		</p>
	</section>
}

templ privacyRolesTH() {
	<section id="roles">
		<h2>3. บทบาทของเราภายใต้ GDPR</h2>
		<p>
			เราทำหน้าที่สองฐานะขึ้นกับข้อมูล:
		</p>
		<ul>
			<li>
				<strong>ผู้ควบคุมข้อมูล</strong> สำหรับเมตาดาตาของบัญชีและการลงชื่อเข้าใช้ ข้อมูลการเรียกเก็บเงิน (เมื่อการเรียกเก็บเงินเปิดใช้) การสื่อสารทางการตลาดที่คุณเลือกรับ และเทเลเมทรีการดำเนินงานของบริการของเราเอง
			</li>
			<li>
				<strong>ผู้ประมวลผลข้อมูล</strong> สำหรับข้อมูลตรวจสอบ บันทึกการดำเนินการ ใบเสร็จการตัดสินใจ และเนื้อหาอื่นที่ไหลผ่านรันไทม์ในนามลูกค้าของเรา และสำหรับสิ่งที่ tafs เก็บไว้ให้ลูกค้า (การทำงาน แชต รายงาน บันทึกความจำของ taf แต่ละตัว และไฟล์ที่ taf ส่งมอบ) ลูกค้า (เทนแนนต์) เป็นผู้ควบคุมข้อมูลนั้น ลูกค้าสั่งเราผ่านการตั้งค่าบัญชีและการกำหนดค่าโดเมน ข้อตกลงการประมวลผลข้อมูล (<abbr title="ข้อตกลงการประมวลผลข้อมูล">DPA</abbr>) กำกับความสัมพันธ์นั้น ดู<a href="/legal/dpa">เทมเพลต DPA</a> (ภาษาอังกฤษ) สำหรับข้อกำหนดที่เผยแพร่
			</li>
		</ul>
		<p>
			นโยบายนี้ว่าด้วยการประมวลผลในฐานะผู้ควบคุมเป็นหลัก ในที่ที่เรากล่าวถึงข้อมูลฝั่งผู้ประมวลผล DPA เป็นเอกสารที่เฉพาะเจาะจงกว่า
		</p>
	</section>
}

templ privacyCategoriesTH() {
	<section id="categories">
		<h2>4. ประเภทของข้อมูลส่วนบุคคลที่เราประมวลผล</h2>
		<p>
			ประเภทด้านล่างสอดคล้องกับรายการทางเทคนิคที่ <a href="/security#data-we-process">/security#data-we-process</a> (ภาษาอังกฤษ) หากสองแห่งไม่ตรงกัน หน้าทางเทคนิคเป็นแหล่งความจริง และเราอัปเดตส่วนนี้ให้ตรงกัน
		</p>
		<ul>
			<li>
				<strong>ตัวระบุบัญชี</strong> — ผู้ถูกยืนยันตัวตนต้นทางของคุณ (ออกโดยผู้ให้บริการระบุตัวตนของเรา) และที่อยู่อีเมลที่คุณใช้ลงชื่อเข้าใช้ ปัจจุบันเก็บตามต้นฉบับ มีแผนการแฮชเมื่อจัดเก็บ
				หากคุณเปิดการเข้าสู่ระบบด้วยรหัสที่ส่งทางอีเมล (ปิดอยู่จนกว่าคุณจะเปิด) KIFF จะเก็บการตั้งค่านั้นไว้พร้อมรหัสประจำตัวการเข้าสู่ระบบของคุณและวันที่คุณเปลี่ยน รหัสที่เราส่งทางอีเมลให้คุณจะเก็บไว้เฉพาะในรูปแฮชที่มีกุญแจ จนกว่าจะถูกใช้หรือผ่านไปสิบนาที เพื่อจำกัดการใช้ในทางที่ผิด เราเก็บจำนวนคำขอต่อแฮชที่มีกุญแจของที่อยู่ที่ขอและของที่อยู่ IP ไว้นานที่สุดหนึ่งวัน หลังจากคุณเข้าสู่ระบบด้วยรหัส เราจะบันทึกไว้หนึ่งในสี่ชั่วโมง เพื่อให้การเปลี่ยนแปลงที่ต้องการการเข้าสู่ระบบล่าสุดขอให้คุณเข้าสู่ระบบด้วยวิธีอื่น
			</li>
			<li>
				<strong>เมตาดาตาเทนแนนต์</strong> — รหัสเทนแนนต์ slug ชื่อที่แสดง เวลาที่สร้าง และภาษาที่แอปของแต่ละคนใช้ล่าสุด เพื่อให้อีเมลที่ KIFF ส่งถึงพวกเขามาในภาษานั้น
			</li>
			<li>
				<strong>ข้อมูลรับรอง API</strong> — บันทึกคีย์ API แบบทึบ (เราเก็บแฮช ไม่เคยเก็บข้อความธรรมดา)
			</li>
			<li>
				<strong>ข้อมูลคุกกี้เซสชัน</strong> — คุกกี้เซสชันที่ลงลายเซ็น HMAC ซึ่งตั้งหลังลงชื่อเข้าใช้ ดูส่วนคุกกี้ด้านล่าง
			</li>
			<li>
				<strong>เมตาดาตาคำขอ HTTP</strong> — ที่อยู่ IP user agent เส้นทางคำขอ สถานะการตอบสนอง ความหน่วง เก็บในบันทึกการเข้าถึงของ reverse proxy ของเราในช่วงเวลาเก็บรักษาจำกัดเพื่อความปลอดภัยและป้องกันการละเมิด
			</li>
			<li>
				<strong>เนื้อหาที่เทนแนนต์ควบคุม</strong> — ข้อมูล <code>parameters</code> <code>actor</code> และ <code>entity</code> ที่คุณส่งไปยังรันไทม์ เราเก็บข้อมูลเหล่านี้<em>ในฐานะผู้ประมวลผล</em>ในนามลูกค้า ลูกค้ารับผิดชอบต่อสิ่งที่ออกสู่เครือข่าย มีแผนการกำหนดค่าการปกปิดข้อมูลรายโดเมน
			</li>
			<li>
				<strong>การสื่อสาร</strong> — อีเมลที่คุณส่งไปยังกล่องจดหมายฝ่ายสนับสนุน ฝ่ายขาย ฝ่ายความปลอดภัย หรือฝ่ายความเป็นส่วนตัวของเรา
			</li>
			<li>
				<strong>แอป tafs</strong> — คุณลงชื่อเข้าใช้ tafs ด้วยบัญชี KIFF บนโทรศัพท์หรือแท็บเล็ต แอปเก็บเซสชันของคุณใน Keychain ของอุปกรณ์ (บน Android คือที่เก็บที่เข้ารหัส) บนคอมพิวเตอร์ แอปเก็บเซสชันแบบผนึกสำหรับบัญชีผู้ใช้ของคุณ: บน PC Windows ด้วยการปกป้องข้อมูลของ Windows เอง บน Linux ใน keyring ของคุณ บน Mac ใน Keychain เซสชันของคอมพิวเตอร์มีอายุไม่เกิน 90 วัน แอปสร้างกุญแจลงนามที่ไม่เคยออกจากอุปกรณ์: ใน Secure Enclave ของ iPhone, iPad หรือ Mac, Keystore ของอุปกรณ์ Android หรือ TPM ของ PC Windows บน Linux และบน Mac ที่ไม่มี Secure Enclave กุญแจเป็นกุญแจซอฟต์แวร์ที่เก็บใน keyring หรือ Keychain ของคุณ และคอมพิวเตอร์เครื่องนั้นแสดงสิ่งที่รอคุณได้แต่อนุมัติไม่ได้ คุณอนุมัติบนโทรศัพท์ของคุณ{ macSecurityKey("th") } PC Windows ที่ไม่มี TPM ลงชื่อเข้าใช้ tafs ไม่ได้ KIFF เก็บครึ่งสาธารณะของกุญแจ ชื่อและแพลตฟอร์มของอุปกรณ์ และเวลาที่เพิ่มและใช้ครั้งล่าสุด เพื่อตรวจสอบคำตอบของคุณต่อการเรียกที่ถูกพักไว้และการอนุมัติการเชื่อมต่อของคุณ หากคุณอนุมัติด้วยพาสคีย์บนคอมพิวเตอร์ เช่น Windows Hello หรือกุญแจความปลอดภัย ใบหน้า ลายนิ้วมือ หรือ PIN ของคุณอยู่กับระบบของคอมพิวเตอร์เอง KIFF เก็บกุญแจสาธารณะของพาสคีย์ รหัสของมัน ตัวนับ และชื่อ ไม่เคยเก็บสิ่งที่เป็นความลับ และปฏิเสธพาสคีย์ที่ซิงก์ไปยังอุปกรณ์อื่น หากคุณเปิดการแจ้งเตือนบนโทรศัพท์ แท็บเล็ต หรือ Mac ที่รันแอป iPad เราเก็บโทเค็นพุชของอุปกรณ์พร้อมรหัสบุคคล KIFF ของคุณ และภาษาที่แอปแสดง เพื่อให้การแจ้งเตือนมาในภาษานั้น บริการ tafs ยังเก็บภาษาของบัญชี จากผู้ที่คุยกับ Coach ล่าสุด นานถึงสามเดือน เพื่อให้รายงานของ taf มาในภาษานั้น การแจ้งเตือนของโทรศัพท์ผ่าน Apple หรือ Google พร้อมเพียงว่า taf ตัวไหนและต้องการอะไร และในการแจ้งเตือนของประตู ชื่อหรืออีเมลของผู้ที่เขียนเข้ามา: ไม่เคยมีจำนวนเงินหรือรายละเอียดของคำขอ แอปเพิ่มสิ่งเหล่านั้นบนอุปกรณ์เองจาก KIFF ดังนั้นการแจ้งเตือนของโทรศัพท์ที่ปลดล็อกอยู่อาจแสดงจำนวนเงิน ร้านค้า หรือบุคคล บนโทรศัพท์ Android ที่ล็อกอยู่ แสดงเพียง “taf ต้องการคุณ” และบน iPhone ที่ล็อกอยู่ก็เช่นกัน เว้นแต่คุณตั้งการแสดงตัวอย่างเป็นแสดงเสมอ  <strong>นาฬิกาของคุณ:</strong> นาฬิกาไม่เก็บรหัสผ่านหรือกุญแจ คุยกับโทรศัพท์ที่จับคู่ของคุณเท่านั้น และไม่เคยอนุมัติ นาฬิกาส่งสิ่งที่คุณพูดไปยัง Coach หรือ taf ที่คุณเลือก เป็นข้อความเท่านั้น ผ่านโทรศัพท์ หลังจากที่คุณอนุญาต AI แล้ว บริการเสียงพูดของนาฬิกาเอง ของ Apple หรือ Google แปลงคำพูดของคุณเป็นข้อความนั้น บน Wear OS หากหยุดก่อนที่คุณพูดจบ ตัวรู้จำเสียงของโทรศัพท์คุณเองทำแทน บนโทรศัพท์ นาฬิกาปฏิเสธ หยุด หรือส่งไปยัง Coach หรือ taf ได้เฉพาะเมื่อมีล็อกหน้าจอหรือรหัสผ่านและปลดล็อกอยู่ สิ่งที่คุณส่งให้ taf เข้าไปในแชตของ taf นั้นเอง เหมือนคุณเขียนบนโทรศัพท์ แชตของ taf รวมถึงจำนวนเงิน จะอ่านผ่านโทรศัพท์ทุกครั้งที่เปิด และนาฬิกาเก็บไว้เฉพาะข้อความล่าสุดตามที่ส่วนของนาฬิกาด้านล่างอธิบาย เมื่อแอปปิดอยู่ โทรศัพท์ของคุณจะส่งต่อคำตอบและข้อความใหม่ไปยังนาฬิกาผ่านการเชื่อมต่อโทรศัพท์กับนาฬิกาของระบบเอง (ของ Apple บน Apple Watch และของบริการ Google Play บน Wear OS) ซึ่งเก็บไว้บนโทรศัพท์และนาฬิกาเพียงจนกว่านาฬิกาจะรับไป และการแจ้งที่ปลุกโทรศัพท์ของคุณไม่มีข้อความใดๆ คำตอบที่มาถึงขณะที่คุณไม่ได้ดูนาฬิกาจะแสดงเป็นการแจ้งเตือนด้วย บน iPhone และ Apple Watch หรือบนนาฬิกา Wear OS ของคุณ พร้อมข้อความของคำตอบแต่ไม่มีจำนวนเงินเลย และจะอยู่จนกว่าคุณจะปิด นาฬิกา Wear OS ที่ล็อกอยู่จะแสดงเพียงว่ามีคำตอบพร้อมแล้ว <strong>Apple Watch:</strong> แสดง taf ของคุณและหน้าของ taf โดยไม่เก็บไว้ เก็บกล่องข้อความของคุณ ในไฟล์ที่อ่านไม่ได้ขณะล็อก: การเรียกที่ถูกพักไว้แต่ละรายการเป็นชื่อ taf และสิ่งที่ขอ ไม่เคยเป็นจำนวนเงิน และคำตอบของ Coach ต่อสิ่งที่คุณส่งจากนาฬิกา เป็นข้อความ หากคุณลงชื่อออกบนนาฬิกา นาฬิกาจะเก็บด้วยว่าคุณทำเช่นนั้น จนกว่าคุณจะลงชื่อเข้าใช้อีกครั้งบนนาฬิกา นอกจากนั้นไม่เก็บสิ่งใดเว้นแต่นาฬิกามีรหัสผ่าน กล่องข้อความหายไปเมื่อคุณลงชื่อออกบนนาฬิกาหรือ iPhone ของคุณลงชื่อออก หรือครั้งถัดไปที่แอปเปิดหรือปิดโดยไม่มีรหัสผ่าน ไม่มีการบันทึกเสียง และการแจ้งเตือนเดียวที่แสดงคือของ iPhone ของคุณ เพื่อให้แชตเปิดได้ทันที นาฬิกายังเก็บข้อความล่าสุด 30 ข้อความของแต่ละแชต สูงสุด 20 แชตที่คุณเปิดบนนาฬิกา ทั้งของ Coach และ taf ของคุณ เป็นข้อความเท่านั้นและไม่มีจำนวนเงิน และล็อกไว้เหมือนกล่องข้อความ ข้อความเหล่านี้หายไปเมื่อกล่องข้อความหายไป และเมื่อไม่ได้เปิดแชตนั้นเป็นเวลา 30 วัน <strong>Wear OS:</strong> แสดงอีเมลของบัญชีคุณและปฏิทินของวันนี้โดยไม่เก็บไว้ เพื่อให้เปิดได้ทันที นาฬิกาเก็บแบบเข้ารหัสซึ่งจำนวนสิ่งที่รอคุณ และชื่อ taf แต่ละตัวพร้อมสถานะว่าถูกหยุดหรือพักอยู่หรือไม่: ไม่เคยเป็นจำนวนเงิน รายละเอียดของการเรียกที่ถูกพักไว้ หรือแชตของ taf ข้อมูลนี้ถูกล้างเมื่อคุณลงชื่อออก เมื่อนาฬิกาล็อกหรือถูกถอดออกจากข้อมือ และหลัง 24 ชั่วโมง นาฬิกาเก็บกล่องข้อความของคุณ ซึ่งแต่ละบรรทัดเป็นชื่อ taf และสิ่งที่ taf พูด ไม่เคยเป็นจำนวนเงิน และข้อความหนึ่งข้อความที่เก็บไว้ส่งทีหลัง เป็นข้อความ การลงชื่อออก บนนาฬิกาหรือบนโทรศัพท์ ล้างทั้งหมด สำหรับไทล์ (tile) ของนาฬิกา เก็บจำนวนสิ่งที่รอคุณด้วย แสดงเฉพาะเมื่อนาฬิกาปลดล็อก และล้างเมื่อคุณลงชื่อออก หรือครั้งถัดไปที่ไทล์แสดงขณะนาฬิกาล็อกหรือไม่มีล็อกหน้าจอ หลังจากคุณลงชื่อออกบนนาฬิกา นาฬิกาเก็บบันทึกว่าคุณทำเช่นนั้น จนกว่าคุณจะลงชื่อเข้าใช้อีกครั้ง กล่องข้อความหายไปด้วยเมื่อแอปเปิดหรือปิดครั้งถัดไปขณะนาฬิกาล็อกหรือไม่มีล็อกหน้าจอ ข้อความที่เก็บไว้ส่งทีหลังคงอยู่จนกว่าคุณจะส่งหรือลบ เพราะคุณขอให้ส่ง หากบริการเสียงพูดของนาฬิกาหยุดก่อนที่คุณพูดจบ นาฬิกาส่งเสียงบันทึกไปยังโทรศัพท์ของคุณ ซึ่งแปลงเป็นข้อความบนโทรศัพท์เอง ไม่เคยบนเซิร์ฟเวอร์ เสียงบันทึกถูกลบทั้งสองฝั่งเมื่อข้อความกลับมาหรือคุณยกเลิก และไม่เกิน 2 นาที มีเพียงข้อความที่ส่งต่อไปยัง Coach หรือ taf ของคุณ ผลลัพธ์ของ taf อาจอยู่ในการแจ้งเตือนของนาฬิกาจนกว่าคุณจะปิดหรือลงชื่อออกบนนาฬิกา เพื่อให้แชตเปิดได้ทันที นาฬิกายังเก็บข้อความล่าสุด 30 ข้อความของแต่ละแชต สูงสุด 20 แชตที่คุณเปิดบนนาฬิกา ทั้งของ Coach และ taf ของคุณ เป็นข้อความเท่านั้นและไม่มีจำนวนเงิน เข้ารหัสไว้ ข้อความเหล่านี้หายไปเมื่อคุณลงชื่อออก บนนาฬิกาหรือบนโทรศัพท์ และเมื่อไม่ได้เปิดแชตนั้นเป็นเวลา 30 วัน และนาฬิกาที่ไม่มีการล็อกหน้าจอจะไม่เก็บไว้เลย บน PC Windows คอมพิวเตอร์ Linux หรือ Mac ที่มีแอป macOS 12 แอปสร้างการแจ้งเตือนเองขณะทำงาน โดยไม่มีโทเค็นพุชและไม่ผ่านบริษัทอื่น บน Windows และ Linux การแจ้งเตือนแสดง taf ตัวไหน สิ่งที่ต้องการทำ จำนวนเงิน เหตุผล และภายในเมื่อใด บนแอป macOS 12 แสดงถ้อยคำของ KIFF สำหรับการเรียก เมื่อคุณเปิดใช้ และหน้าจอล็อกแสดงสิ่งที่การตั้งค่าตัวอย่างของ Mac อนุญาต บน Windows ปิดอยู่จนกว่าคุณเปิด และแสดงเพียง “taf ต้องการคุณ” ขณะหน้าจอล็อก การแจ้งเตือนที่แสดงก่อนหน้าจอล็อกเก็บรายละเอียดไว้ในรายการแจ้งเตือนของ Windows บน Linux เปิดอยู่จนกว่าคุณปิด และสิ่งที่หน้าจอล็อกแสดงขึ้นกับเดสก์ท็อปของคุณ เมื่อคุณเชื่อมต่อเครื่องมือ คุณลงชื่อเข้าใช้ที่ผู้ให้บริการของเครื่องมือนั้นเอง สำหรับแอปที่ planque ลงชื่อเข้าใช้เอง เช่น Stripe หรือกุญแจที่คุณให้ planque เก็บโทเค็นหรือกุญแจนั้นให้บริษัทของคุณ แบบเข้ารหัส สำหรับการเชื่อมต่อที่มีการจัดการ Composio บริการเชื่อมต่อที่ planque ทำงานด้วย เก็บการลงชื่อเข้าใช้ และ planque เก็บเฉพาะบันทึกของการเชื่อมต่อและเครื่องมือที่คุณอนุมัติ (ทั้งหมดในฐานะผู้ประมวลผล ดูด้านล่าง) หากคุณจับคู่ส่วนขยาย tafs taf ยังอ่านและดำเนินการบนหน้าของเว็บไซต์ที่คุณอนุญาตได้ ใน Chrome ของคุณเอง (ในฐานะผู้ประมวลผล <a href="/th/tafs/privacy">นโยบายความเป็นส่วนตัวของ tafs</a> ระบุว่าอ่านอะไร เก็บอะไร และเก็บนานเท่าใด) บันทึกของการเชื่อมต่ออาจรวมบัญชีที่ลงชื่อเข้าใช้ (ชื่อหรืออีเมล) เพื่อให้แอปแสดงให้คุณเห็นว่าเป็นบัญชีไหน KIFF ใช้การเชื่อมต่อที่มีการจัดการเฉพาะกับแอปที่ระบุที่ <a href="/subprocessors#composio">/subprocessors</a> (ภาษาอังกฤษ) แอปไม่มีตัวติดตามด้านการวิเคราะห์หรือโฆษณา
			</li>
			<li>
				<strong>การซื้อผ่าน App Store</strong> — เมื่อคุณซื้อ Solo หรือแพ็กเครดิตใน tafs Apple เป็นผู้ขายให้คุณ: Apple เป็นผู้ขายตามบันทึก รับชำระเงิน และเก็บรายละเอียดการชำระเงินของคุณ Apple แจ้งเราว่าซื้ออะไร ให้บัญชี KIFF ใด (รหัสสุ่มที่แอปแนบกับการซื้อ) เมื่อใด รหัสธุรกรรมของ Apple และสำหรับ Solo เมื่อรอบสิ้นสุดหรือต่ออายุ เราใช้ข้อมูลนี้เพิ่มเครดิตหรือแผนให้บัญชีของคุณ Apple ไม่ให้ Apple ID ชื่อ อีเมล หรือบัตรของคุณแก่เรา
			</li>
			<li>
				<strong>การซื้อผ่าน Google Play</strong> — บน Android การซื้อเดียวกันผ่านการเรียกเก็บเงินของ Google Play: Google รับชำระเงินและเก็บรายละเอียดการชำระเงินของคุณ Google แจ้งเราว่าซื้ออะไร ให้บัญชี KIFF ใด (รหัสสุ่มเดียวกัน) เมื่อใด โทเค็นและรหัสคำสั่งซื้อของการซื้อ และสำหรับ Solo เมื่อรอบสิ้นสุดหรือต่ออายุ และเราใช้ในลักษณะเดียวกัน Google ไม่ให้บัญชี Google ชื่อ อีเมล หรือบัตรของคุณแก่เรา
			</li>
		</ul>
	</section>
}

templ privacyLawfulBasesTH() {
	<section id="lawful-bases">
		<h2>5. ฐานทางกฎหมายในการประมวลผล</h2>
		<p>
			ภายใต้มาตรา 6 ของ GDPR เราอาศัยฐานทางกฎหมายต่อไปนี้:
		</p>
		<ul>
			<li>
				<strong>การปฏิบัติตามสัญญา</strong> (มาตรา 6(1)(b)) — สำหรับการสร้างบัญชี การยืนยันตัวตน การดำเนินรันไทม์ในนามคุณ การเรียกเก็บเงิน (เมื่อเปิดใช้) และพื้นผิวบริการหลัก
			</li>
			<li>
				<strong>ประโยชน์โดยชอบด้วยกฎหมาย</strong> (มาตรา 6(1)(f)) — เพื่อความปลอดภัย การป้องกันการฉ้อโกง การตรวจจับการละเมิด เทเลเมทรีการดำเนินงาน และการปกป้องบริการ เราชั่งน้ำหนักประโยชน์ของเรากับสิทธิของคุณ และจะแจ้งคุณเมื่อขอว่าการทดสอบการชั่งน้ำหนักนั้นได้ผลอย่างไร
			</li>
			<li>
				<strong>ความยินยอม</strong> (มาตรา 6(1)(a)) — สำหรับ AI ในแอป tafs: สิ่งที่ส่งไปยังโมเดล AI ที่รัน Coach และ taf ของคุณ ตามที่อธิบาย<a href="#ai-in-tafs">ด้านล่าง</a> ไม่มีการส่งสิ่งใดจนกว่าคุณอนุญาต และคุณถอนได้ในบัญชี ความยินยอมยังเป็นสิ่งที่เราจะขอก่อนมีคุกกี้วิเคราะห์ การสื่อสารทางการตลาดที่เลือกได้ หรือการประมวลผลใหม่ที่ขยายการใช้ข้อมูลของคุณอย่างมีนัยสำคัญ เราไม่ใช้การวิเคราะห์ โฆษณา หรือการติดตามที่ไม่จำเป็น
			</li>
			<li>
				<strong>หน้าที่ตามกฎหมาย</strong> (มาตรา 6(1)(c)) — สำหรับบันทึกภาษี (กฎหมายบัญชีเอสโตเนีย §12, 7 ปี) การตอบคำขอที่ชอบด้วยกฎหมายของหน่วยงาน และการเก็บรักษาที่กฎต่อต้านการฟอกเงินกำหนดเมื่อใช้บังคับ
			</li>
		</ul>
		<h3 id="ai-in-tafs">AI ในแอป tafs</h3>
		<p>แอป tafs ถามคุณก่อนที่สิ่งใดจะไปยัง AI ด้วยถ้อยคำเหล่านี้:</p>
		<ul>
			<li>tafs ใช้ AI Claude ของ Anthropic สำหรับ Coach และ taf ของคุณ</li>
			<li>Coach และ taf ของคุณเป็นเอเจนต์ AI: สิ่งที่เขียนถูกสร้างโดย AI และอาจผิดพลาด ข้อความที่ taf ส่งออกนอกบริษัทของคุณระบุว่าเอเจนต์ AI เป็นผู้เขียน</li>
			<li>สิ่งที่ส่งไป: สิ่งที่คุณเขียนถึง Coach และ taf ของคุณ ไฟล์ที่คุณแนบ สิ่งที่แอปที่คุณเชื่อมต่อส่งคืนให้ taf ขณะทำงาน และสิ่งที่อยู่บนหน้าจอของคุณขณะ Coach ช่วยคุณในแอป</li>
			<li>สิ่งที่ไม่เคยส่ง: รหัสผ่านและกุญแจที่แอปที่คุณเชื่อมต่อใช้ หรือลายนิ้วมือของคุณ</li>
			<li>Anthropic ใช้ข้อมูลนั้นเพื่อตอบและเก็บไว้นานถึง 30 วัน</li>
			<li>ไม่มีการส่งสิ่งใดจนกว่าคุณอนุญาต คุณถอนความยินยอมได้ในบัญชี</li>
		</ul>
		<p>taf ที่ทำงานโดยไม่มีใครอยู่ ณ ขณะนั้น (ตามกำหนดเวลา หรือเมื่อมีสิ่งเข้ามา) อาศัยความยินยอมของผู้ที่สร้างหรือรับช่วง หรือมิฉะนั้นของบุคคลแรกที่จัดการ taf ของบัญชีและอนุญาต</p>
		<p><strong>เมื่อคุณถอน</strong> Coach และ taf ของคุณหยุดตอบคุณ taf ที่การทำงานอาศัยความยินยอมของคุณจะหยุดพัก: กำหนดเวลาของ taf หยุด และสิ่งที่เข้ามารออยู่ taf ทำต่อเมื่อมีการให้ความยินยอมอีกครั้ง หรือเมื่อผู้ที่จัดการ taf ของบัญชีรับช่วงด้วยความยินยอมของตนเอง การถอนไม่เปลี่ยนสิ่งที่ส่งไปก่อนหน้า</p>
		<p>Anthropic ระบุที่ <a href="/subprocessors">/subprocessors</a> (ภาษาอังกฤษ) พร้อมสถานที่ประมวลผลและเมื่อใดที่อาจเก็บข้อมูลนานกว่านั้น</p>
	</section>
}

templ privacySubprocessorsTH() {
	<section id="sub-processors">
		<h2>6. ผู้ประมวลผลช่วง</h2>
		<p>เราไม่ขายข้อมูลส่วนบุคคลของคุณ และไม่แบ่งปันเพื่อการโฆษณา</p>
		<p>
			เราว่าจ้างผู้ให้บริการกลุ่มเล็กเพื่อส่งมอบบริการ รายการทางการปัจจุบันอยู่ที่ <a href="/subprocessors">/subprocessors</a> (ภาษาอังกฤษ) หน้านั้นถูกอัปเดตภายใน 30 วันหลังการเปลี่ยนแปลงใด ๆ เราให้ผู้ประมวลผลช่วงแต่ละรายให้การคุ้มครองเทียบเท่าของเราตามข้อตกลงเป็นลายลักษณ์อักษร รวมถึงข้อสัญญามาตรฐานของสหภาพยุโรปเมื่อข้อมูลส่วนบุคคลออกจากสหภาพยุโรป
		</p>
		<p>
			การเพิ่มหรือเปลี่ยนผู้ประมวลผลช่วงที่มีนัยสำคัญและกระทบข้อมูลส่วนบุคคลจะแจ้งลูกค้าที่ใช้งานอยู่ล่วงหน้า พร้อมสิทธิคัดค้าน
		</p>
	</section>
}

templ privacyTransfersTH() {
	<section id="transfers">
		<h2>7. การโอนข้อมูลระหว่างประเทศ</h2>
		<p>
			ผู้ประมวลผลช่วงของเราบางรายตั้งอยู่นอกเขตเศรษฐกิจยุโรป ส่วนใหญ่ในสหรัฐอเมริกา สำหรับการโอนแต่ละครั้ง เราอาศัยมาตรการคุ้มครองอย่างน้อยหนึ่งอย่างต่อไปนี้:
		</p>
		<ul>
			<li>
				<strong>กรอบความเป็นส่วนตัวของข้อมูลสหภาพยุโรป–สหรัฐอเมริกา</strong> — สำหรับผู้ประมวลผลช่วงในสหรัฐอเมริกาที่ได้รับการรับรองตามกรอบ การตัดสินความเพียงพอมีผลบังคับตั้งแต่กลางปี 2023 เราติดตามการเปลี่ยนแปลงสถานะ
			</li>
			<li>
				<strong>ข้อสัญญามาตรฐาน</strong> — โมดูล 2 (ผู้ควบคุมถึงผู้ประมวลผล) สำหรับผู้ประมวลผลช่วงโดยตรงของเรา และโมดูล 3 (ผู้ประมวลผลถึงผู้ประมวลผลช่วง) เมื่อมีผู้ประมวลผลต่อเนื่อง เราใช้ SCC ปี 2021 ที่คณะกรรมาธิการอนุมัติ
			</li>
			<li>
				<strong>มาตรการเสริม</strong> — เมื่อการประเมินความเสี่ยงชี้ว่าควรมีการคุ้มครองเพิ่ม (การเข้ารหัสระหว่างส่งและเมื่อจัดเก็บ การบันทึกการเข้าถึง การลดข้อมูลให้น้อยที่สุด)
			</li>
		</ul>
		<p>
			คุณขอเครื่องมือการโอนเฉพาะที่ใช้กับผู้ประมวลผลช่วงรายใดรายหนึ่งได้โดยอีเมลถึง <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
		</p>
		<p><strong>ประเทศของคุณ</strong> กฎหมายของบางประเทศกำหนดมากกว่าที่นโยบายนี้ระบุ สิ่งที่กฎหมายเหล่านั้นเพิ่มเติม ทั้งเป็นภาษาอังกฤษและภาษาของประเทศนั้น อยู่ที่ <a href="/privacy/countries">ประเทศของคุณ</a> (ภาษาอังกฤษ)</p>
	</section>
}

templ privacyRetentionTH() {
	<section id="retention">
		<h2>8. การเก็บรักษา</h2>
		<p>
			เราเก็บข้อมูลส่วนบุคคลตามระยะเวลาสั้นที่สุดที่สอดคล้องกับวัตถุประสงค์ที่เราประมวลผลและหน้าที่ตามกฎหมายที่ใช้บังคับ
		</p>
		<ul>
			<li>
				<strong>เมตาดาตาบัญชีและการลงชื่อเข้าใช้</strong> — จนกว่าบัญชีจะถูกลบ ในแอป tafs เจ้าของลบได้ที่ บัญชี → <em>ลบบัญชี</em> บัญชีที่สร้างบนเว็บถูกลบโดยอีเมลถึง <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> ภายในกรอบหนึ่งเดือนตามมาตรา 12(3) ของ GDPR ไม่ว่ากรณีใด กุญแจของบัญชีหยุดทันที หากลบในแอป tafs ย้อนกลับไม่ได้: แชต บันทึก และการเชื่อมต่อ tafs ของบัญชีถูกลบทันที และสิ่งที่ KIFF เก็บถูกลบภายใน 30 วัน หากลบบนเว็บ เราเก็บข้อมูลไว้ในช่วงผ่อนผัน 30 วัน เผื่อเจ้าของต้องการคืน แล้วจึงลบ
			</li>
			<li>
				<strong>บันทึกคีย์ API</strong> — จนกว่าบัญชีถูกลบ รวมถึงหลังคีย์ถูกเพิกถอน คีย์ที่เป็นของการเชื่อมต่อลงชื่อเข้าใช้ของเอเจนต์ถูกลบพร้อมการเชื่อมต่อนั้น 30 วันหลังสิ้นสุด
			</li>
			<li>
				<strong>คุกกี้เซสชัน</strong> — จนกว่าหมดอายุ (ค่าเริ่มต้น 24 ชั่วโมง) หรือจนกว่าคุณลงชื่อออก
			</li>
			<li>
				<strong>บันทึกการเข้าถึง reverse-proxy</strong> — นานถึง 90 วัน แล้วรวมสถิติหรือลบ
			</li>
			<li>
				<strong>บันทึกบริการ</strong> — สิ่งที่บริการของ KIFF และ planque บันทึกขณะทำงาน: ข้อผิดพลาด และคำขอ ซึ่งอาจระบุบัญชี บุคคล หรือเอเจนต์ 30 วัน แล้วลบ
			</li>
			<li>
				<strong>การสำรองข้อมูล</strong> — ฐานข้อมูลของ KIFF สำรองทุกวัน เข้ารหัส และแต่ละชุดสำรองเก็บ 7 วัน ดังนั้นระเบียนที่ลบแล้วหายจากชุดสำรองภายใน 7 วัน ที่เก็บของ tafs และ planque เก็บสำเนา ณ จุดเวลาที่เข้ารหัสไว้ 35 วัน ใช้เพื่อกู้คืนที่เก็บหลังเกิดความล้มเหลวเท่านั้น ดังนั้นระเบียนที่ลบแล้วหายจากสำเนาเหล่านั้นภายใน 35 วัน
			</li>
			<li>
				<strong>ข้อมูลตรวจสอบของเทนแนนต์</strong> — เก็บในฐานะผู้ประมวลผลตามการกำหนดค่าเทนแนนต์ของลูกค้า ค่าเริ่มต้น: เก็บตลอดอายุของเทนแนนต์ ลบเมื่อเทนแนนต์ถูกลบ ดู <a href="/security#deletion">/security#deletion</a> (ภาษาอังกฤษ)
			</li>
			<li>
				<strong>การเรียกผ่านเกตเวย์ KIFF</strong> — อาร์กิวเมนต์ของการเรียกจนกว่าจะถูกส่ง ถูกปฏิเสธ หรือล้มเหลว แล้วลบ ผลลัพธ์ของเครื่องมือ 24 ชั่วโมง แล้วลบ บันทึกการตัดสินใจและแฮชของอาร์กิวเมนต์เก็บเป็นข้อมูลตรวจสอบของเทนแนนต์ ดู <a href="/security#data-kept">/security#data-kept</a> (ภาษาอังกฤษ)
			</li>
			<li>
				<strong>การใช้งาน</strong> — สำหรับแต่ละการเรียกผ่านเกตเวย์ เมื่อจบ: เอเจนต์ใดทำ เครื่องมือ และนับเป็นการดำเนินการหรือฟรี (และเพราะเหตุใด) สำหรับการทำงานแต่ละรอบของ taf หรือ Coach เมื่อจบ: taf เมื่อใด เครดิตที่ AI ใช้ และนับหรือไม่นับเพราะเหตุใด จนกว่าบัญชีถูกลบ สิ่งที่รายงานไปยังผู้ประมวลผลการชำระเงินของเราเพื่อเรียกเก็บเงินเก็บไว้กับบันทึกการเรียกเก็บเงิน
			</li>
			<li>
				<strong>การเชื่อมต่อลงชื่อเข้าใช้ของเอเจนต์</strong> — เอเจนต์ใด ชื่อแอป ใครอนุญาต เมื่อใด และการใช้ครั้งล่าสุด: ขณะการเชื่อมต่อยังใช้งาน แล้ว 30 วันหลังสิ้นสุด (ยังแสดงในแดชบอร์ดช่วงนั้น) แล้วลบพร้อมโทเค็นและคีย์ API ทั้งหมดถูกลบพร้อมบัญชี
			</li>
			<li>
				<strong>tafs</strong> — โทเค็นพุชของอุปกรณ์จนกว่าคุณลงชื่อออกจากแอป ลบอุปกรณ์ หรือ Apple หรือ Google แจ้งว่าโทเค็นหายไป กุญแจสาธารณะ ชื่อ แพลตฟอร์ม และวันที่ของอุปกรณ์ขณะที่คุณใช้ เมื่อคุณลงชื่อออกจากอุปกรณ์ จะถูกทำเครื่องหมายว่าลบแล้วและเก็บไว้จนกว่าบัญชีถูกลบ เพื่อให้ KIFF ปฏิเสธคำตอบที่มาช้าจากอุปกรณ์นั้นและแสดงว่าอุปกรณ์ใดลงนามคำตอบก่อนหน้า กุญแจสาธารณะ รหัส และชื่อของพาสคีย์เก็บเหมือนของอุปกรณ์ คอมพิวเตอร์เก็บเซสชันไม่เกิน 90 วัน หรือจนกว่าคุณลงชื่อออก สิ่งที่ tafs เก็บให้บริษัทของคุณเก็บในฐานะผู้ประมวลผล: การทำงานและแชตของ taf พร้อมสรุปของแชต (และของ Setup) 30 วัน สิ่งที่เครื่องมือของคุณส่งคืนเฉพาะจนกว่าการทำงานจบ (ในแชต สิ่งที่เพียงอ่านถูกเก็บแบบเข้ารหัสสำหรับข้อความถัดไป ใช้จนกว่าแชตว่างหนึ่งชั่วโมงและไม่เกินสี่ชั่วโมงหลังอ่าน แล้วลบโดยอัตโนมัติภายในไม่กี่วัน) และบันทึกความจำจนกว่าจะลบ taf ไฟล์ที่ taf ส่งมอบ 30 วันนับจากการทำงานที่สร้าง แล้วลบโดยอัตโนมัติภายในหนึ่งวัน หรือเร็วกว่านั้นหากมีผู้ในบัญชีของคุณลบ โทเค็นหรือกุญแจของการเชื่อมต่อใน planque หรือการลงชื่อเข้าใช้ของการเชื่อมต่อที่มีการจัดการที่ Composio จนกว่าคุณตัดการเชื่อมต่อ (หากการเชื่อมต่ออื่นของคุณอาจใช้บัญชีเดียวกันที่ผู้ให้บริการนั้น เก็บไว้โดยไม่ใช้จนกว่าการเชื่อมต่อนั้นถูกตัดด้วย) และบันทึกการอนุมัติจนกว่าบัญชีสิ้นสุด ดู <a href="/legal/dpa#annex-4">ภาคผนวก 4 ของ DPA</a> (ภาษาอังกฤษ)
			</li>
			<li>
				<strong>บันทึกการเรียกเก็บเงิน</strong> — 7 ปีนับจากสิ้นปีงบการเงิน (กฎหมายบัญชีเอสโตเนีย §12)
			</li>
			<li>
				<strong>การซื้อผ่าน App Store และ Google Play</strong> — สิ่งที่ Apple หรือ Google แจ้งเราเกี่ยวกับแต่ละการซื้ออยู่ในบัญชีของคุณจนกว่าบัญชีถูกลบ รายงานยอดขายและการจ่ายเงินของทั้งสองซึ่งเราเก็บเป็นบันทึกการเรียกเก็บเงิน 7 ปี ไม่ระบุชื่อคุณ
			</li>
			<li>
				<strong>การติดต่อกับฝ่ายสนับสนุน</strong> — 3 ปีนับจากการติดต่อครั้งล่าสุด แล้วลบ
			</li>
		</ul>
	</section>
}

templ privacyRightsTH() {
	<section id="rights">
		<h2>9. สิทธิของคุณ</h2>
		<p>
			ภายใต้ GDPR คุณมีสิทธิต่อไปนี้เกี่ยวกับข้อมูลส่วนบุคคลของคุณ:
		</p>
		<ul>
			<li><strong>การเข้าถึง</strong> (มาตรา 15) — การยืนยันว่าเราประมวลผลข้อมูลของคุณหรือไม่ และสำเนา</li>
			<li><strong>การแก้ไข</strong> (มาตรา 16) — การแก้ข้อมูลที่ไม่ถูกต้องหรือไม่ครบถ้วน</li>
			<li><strong>การลบ</strong> (มาตรา 17) — การลบข้อมูลของคุณ ภายใต้ข้อยกเว้นการเก็บรักษาตามกฎหมาย</li>
			<li><strong>การจำกัด</strong> (มาตรา 18) — หยุดการประมวลผลชั่วคราวระหว่างที่ข้อพิพาทได้รับการแก้ไข</li>
			<li><strong>การโอนย้ายข้อมูล</strong> (มาตรา 20) — การส่งออกข้อมูลที่คุณให้ในรูปแบบที่เครื่องอ่านได้</li>
			<li><strong>การคัดค้าน</strong> (มาตรา 21) — ต่อการประมวลผลที่อาศัยประโยชน์โดยชอบด้วยกฎหมาย เราหยุดเว้นแต่แสดงเหตุผลที่หนักกว่าได้</li>
			<li><strong>การถอนความยินยอม</strong> (มาตรา 7(3)) — สำหรับการประมวลผลใดที่อาศัยความยินยอม เช่น AI ในแอป tafs (ในบัญชี ตามที่<a href="#ai-in-tafs">ข้างต้น</a>) การถอนไม่กระทบการประมวลผลที่ชอบด้วยกฎหมายก่อนหน้า</li>
		</ul>
		<p>
			หากต้องการใช้สิทธิข้างต้น อีเมลถึง <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> เราตอบโดยไม่ชักช้าเกินสมควร และอย่างช้าภายในหนึ่งเดือนตามมาตรา 12(3) เราอาจขยายออกไปอีกถึงสองเดือนสำหรับคำขอที่ซับซ้อนและจะแจ้งคุณหากทำเช่นนั้น
		</p>
		<h3 id="export-chats">แชต tafs ของคุณเอง</h3>
		<p>
			ในแอป tafs บัญชี → ส่งออกแชตของฉัน ดาวน์โหลดแชตของคุณเองกับ taf แต่ละตัว รวมของ Coach ชื่อไฟล์ที่คุณแนบ และบันทึกของคุณเอง เป็นไฟล์ที่อ่านได้และเป็น JSON มีเพียงคุณที่ส่งออกได้: ผู้ดูแลหรือเจ้าของบัญชีทำไม่ได้ และการส่งออกบัญชีของ KIFF ไม่รวมข้อมูลเหล่านี้
		</p>
		<h3 id="delete-account">การลบบัญชี tafs ของคุณ</h3>
		<p>
			tafs คือแอปของ KIFF หากต้องการลบบัญชี tafs ของคุณและข้อมูล:
		</p>
		<ol>
			<li>เปิดแอป tafs และลงชื่อเข้าใช้</li>
			<li>ไปที่บัญชี แล้วแตะ <em>ลบบัญชี</em></li>
			<li>ยืนยัน การลบบัญชีย้อนกลับไม่ได้</li>
		</ol>
		<p>
			<em>ลบบัญชี</em> แสดงแก่ผู้ที่ลบบัญชีของบริษัทได้ ซึ่งมักเป็นเจ้าของ หากคุณไม่เห็น หรือไม่มีแอปแล้ว อีเมลถึง <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> จากที่อยู่ที่คุณใช้ลงชื่อเข้าใช้ และเราลบข้อมูลของคุณโดยไม่ชักช้าเกินสมควร และอย่างช้าภายในหนึ่งเดือน
		</p>
		<p>
			สิ่งที่ถูกลบ: กุญแจของบัญชีหยุดทันที taf แชต บันทึก ไฟล์ที่แนบ และการเชื่อมต่อถูกลบทันที และจากสำเนา ณ จุดเวลาภายใน 35 วัน สิ่งที่ KIFF เก็บให้บัญชีถูกลบภายใน 30 วัน และจากการสำรองข้อมูลภายใน 7 วันหลังจากนั้น บันทึกบริการที่ระบุบัญชีหายภายใน 30 วัน ข้อมูลตรวจสอบของเทนแนนต์ถูกลบพร้อมเทนแนนต์ ดู <a href="#retention">การเก็บรักษา</a> สำหรับข้อมูลแต่ละประเภท
		</p>
		<p id="delete-data">
			หากต้องการลบข้อมูลบางส่วนและคงบัญชี: ในแอป ลบแชต แล้วข้อความและไฟล์ที่แนบไปด้วย ลบ taf แล้วแชต บันทึก และการเชื่อมต่อของ taf ไปด้วย สำหรับสิ่งอื่น อีเมลถึง <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> และบอกว่าให้ลบอะไร เราทำโดยไม่ชักช้าเกินสมควร และอย่างช้าภายในหนึ่งเดือน
		</p>
		<p>
			คุณมีสิทธิร้องเรียนต่อหน่วยงานกำกับดูแล หน่วยงานกำกับดูแลหลักของเราคือ<a href="https://www.aki.ee/en" target="_blank" rel="noopener">สำนักงานตรวจสอบการคุ้มครองข้อมูลเอสโตเนีย (Andmekaitse Inspektsioon)</a> คุณยังร้องเรียนต่อหน่วยงานกำกับดูแลในรัฐสมาชิกที่คุณพำนักได้
		</p>
		<p><strong>ประเทศของคุณ</strong> กฎหมายของบางประเทศกำหนดมากกว่าที่นโยบายนี้ระบุ สิ่งที่กฎหมายเหล่านั้นเพิ่มเติม ทั้งเป็นภาษาอังกฤษและภาษาของประเทศนั้น อยู่ที่ <a href="/privacy/countries">ประเทศของคุณ</a> (ภาษาอังกฤษ)</p>
	</section>
}

templ privacyCookiesTH() {
	<section id="cookies">
		<h2>10. คุกกี้</h2>
		<p>
			เราตั้งคุกกี้สามตัว ทั้งหมดจำเป็นอย่างยิ่ง เป็นของบุคคลที่หนึ่ง ส่งผ่าน HTTPS เท่านั้น และสคริปต์บนหน้าอ่านไม่ได้ ภายใต้กฎ ePrivacy ของสหภาพยุโรป คุกกี้เหล่านี้ไม่ต้องขอความยินยอม เราแสดงรายการเพื่อให้คุณรู้ว่ามีอยู่ <a href="/cookies">นโยบายคุกกี้</a> (ภาษาอังกฤษ) มีรายละเอียด
		</p>
		<ul>
			<li>
				<strong><code>kiff_session</code></strong> — ทำให้คุณลงชื่อเข้าใช้อยู่ คุกกี้เซสชันที่ลงลายเซ็นซึ่งมีรหัสลงชื่อเข้าใช้ อีเมล และชื่อของคุณ และข้อมูลรับรองที่แดชบอร์ดใช้สำหรับคุณ ตั้งสำหรับ <code>.kiff.dev</code> มีอายุ 24 ชั่วโมง หรือจนกว่าคุณลงชื่อออก
			</li>
			<li>
				<strong><code>kiff_flash</code></strong> — นำข้อความครั้งเดียวไปยังหน้าถัดไป เช่น “สร้างคีย์ของคุณแล้ว” ลงลายเซ็น ไม่เคยมีคีย์ใหม่อยู่ในนั้น ตั้งสำหรับ <code>.kiff.dev</code> ถูกลบเมื่อหน้าถัดไปอ่าน และไม่เกิน 5 นาที
			</li>
			<li>
				<strong><code>kiff_cb_attempts</code></strong> — นับว่าหน้าลงชื่อเข้าใช้โหลดซ้ำกี่ครั้ง เพื่อหยุดการลงชื่อเข้าใช้ที่วนซ้ำ ส่งเฉพาะไปยังหน้านั้น มีอายุ 5 นาที และถูกล้างเมื่อการลงชื่อเข้าใช้เริ่มหรือสำเร็จ
			</li>
		</ul>
		<p>
			เราไม่ใช้คุกกี้วิเคราะห์ คุกกี้โฆษณา หรือตัวติดตามของบุคคลที่สามใด ๆ หากเราเพิ่มในภายหลัง เราจะแสดงแบนเนอร์ขอความยินยอมก่อนตั้งคุกกี้ ตาม ePrivacy และแนวทางปี 2023 ของ EDPB เรื่องเทคโนโลยีการติดตาม
		</p>
		<p>
			หากคุณลงชื่อเข้าใช้ผ่าน Clerk (ผู้ประมวลผลช่วงด้านการยืนยันตัวตนของเรา) Clerk ตั้งคุกกี้บนโดเมนฟรอนต์เอนด์ของตนเอง (<code>clerk.kiff.dev</code>) ด้วย คุกกี้เหล่านั้นจำเป็นให้ Clerk จำคุณได้ตลอดขั้นตอนลงชื่อเข้าใช้ และอยู่ภายใต้นโยบายความเป็นส่วนตัวของ Clerk เช่นเดียวกับของเรา ดูรายการผู้ประมวลผลช่วงสำหรับรายละเอียด
		</p>
	</section>
}

templ privacySecurityTH() {
	<section id="security">
		<h2>11. ความปลอดภัย</h2>
		<p>
			มาตรการรักษาความปลอดภัยทางเทคนิคและองค์กรของเราบันทึกไว้ที่ <a href="/security">/security</a> (ภาษาอังกฤษ) รวมถึงการแยกเทนแนนต์ที่ชั้นฐานข้อมูล TLS 1.2+ ระหว่างส่ง การเข้ารหัสเมื่อจัดเก็บตามค่าเริ่มต้นของผู้ให้บริการที่มีการจัดการ และการควบคุมการเข้าถึงตามหลักสิทธิ์น้อยที่สุด
		</p>
		<p>
			เราแจ้งลูกค้าที่ได้รับผลกระทบถึงการละเมิดข้อมูลส่วนบุคคลโดยไม่ชักช้าเกินควรและภายใน 72 ชั่วโมงนับจากการยืนยัน สอดคล้องกับมาตรา 33 GDPR การแจ้งรวมลักษณะของการละเมิด ประเภทและจำนวนโดยประมาณของเจ้าของข้อมูลและระเบียนที่เกี่ยวข้อง ผลที่น่าจะเกิดขึ้น และมาตรการที่ดำเนินการหรือเสนอ
		</p>
	</section>
}

templ privacyChildrenTH() {
	<section id="children">
		<h2>12. เด็ก</h2>
		<p>
			KIFF Cloud เป็นผลิตภัณฑ์โครงสร้างพื้นฐานสำหรับนักพัฒนาที่ไม่ได้มุ่งสำหรับเด็ก เราไม่เก็บข้อมูลส่วนบุคคลของเด็กอายุต่ำกว่า 16 ปีโดยรู้ตัว หากคุณเชื่อว่าเด็กให้ข้อมูลส่วนบุคคลแก่เรา ติดต่อ <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> และเราจะลบ
		</p>
	</section>
}

templ privacyAutomatedTH() {
	<section id="automated">
		<h2>13. การตัดสินใจอัตโนมัติ</h2>
		<p>
			รันไทม์ของ KIFF Cloud ทำการตัดสินใจเชิงนโยบายแบบกำหนดแน่นอนบนข้อมูลที่ลูกค้าของเราส่ง สิ่งเหล่านี้ไม่ใช่การตัดสินใจเกี่ยวกับคุณที่ก่อผลทางกฎหมายหรือผลกระทบสำคัญในทำนองเดียวกันตามความหมายของมาตรา 22 GDPR แต่เป็นการตัดสินใจเกี่ยวกับการกระทำของลูกค้า (การคืนเงิน คำสั่งซื้อ ข้อความ และอื่น ๆ) ที่ดำเนินการภายใต้นโยบายของลูกค้าเอง
		</p>
		<p>
			ลูกค้าที่ใช้ KIFF Cloud เพื่อตัดสินใจที่กระทบผู้ใช้ปลายทางของตนเองรับผิดชอบการปฏิบัติตามมาตรา 22 ด้วยตนเอง ใบเสร็จการกำกับดูแลของเราออกแบบมาเพื่อให้ลูกค้าเหล่านั้นมีร่องรอยการตรวจสอบที่ต้องใช้แสดงการกำกับดูแลโดยมนุษย์ แต่หน้าที่ตามกฎหมายในการให้การกำกับดูแลนั้นอยู่กับลูกค้า
		</p>
	</section>
}

templ privacyChangesTH() {
	<section id="changes">
		<h2>14. การเปลี่ยนแปลงนโยบายนี้</h2>
		<p>
			เราอาจอัปเดตนโยบายนี้เป็นครั้งคราว การเปลี่ยนแปลงที่มีนัยสำคัญแจ้งทางอีเมลถึงลูกค้าที่ใช้งานอยู่และด้วยแบนเนอร์เด่นชัดบนหน้านี้อย่างน้อย 30 วัน การเปลี่ยนแปลงที่ไม่มีนัยสำคัญประกาศพร้อมวันที่ “อัปเดตล่าสุด” ใหม่
		</p>
	</section>
}

