package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// DPAPT is the Data Processing Agreement template (/legal/dpa) in
// Portuguese (pt-PT), at /pt/legal/dpa. It is a translation of DPA: the
// same sections, anchors, links and figures, held to it by
// TestTranslationsKeepTheEnglishPage. The English page governs. Change
// the English page first, then this one.
templ DPAPT() {
	@components.LayoutSite("KIFF — acordo de tratamento de dados", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@dpaHeadPT()
			@dpaPartiesPT()
			@dpaDefinitionsPT()
			@dpaScopePT()
			@dpaSubjectMatterPT()
			@dpaNaturePurposePT()
			@dpaCategoriesPT()
			@dpaInstructionsPT()
			@dpaProcessorObligationsPT()
			@dpaConfidentialityPT()
			@dpaSubprocessorsPT()
			@dpaTransfersPT()
			@dpaSecurityPT()
			@dpaBreachNotificationPT()
			@dpaDataSubjectRequestsPT()
			@dpaAuditPT()
			@dpaReturnDeletionPT()
			@dpaLiabilityPT()
			@dpaTermPT()
			@dpaGoverningLawPT()
			@dpaAnnex1PT()
			@dpaAnnex2PT()
			@dpaAnnex3PT()
			@dpaAnnex4PT()
		</article>
	}
}

templ dpaHeadPT() {
	<header class="legal-head">
		<p class="legal-badge">Modelo de DPA · v0.1</p>
		<h1>Acordo de Tratamento de Dados</h1>
		<p class="legal-meta">
			<strong>Versão do modelo:</strong> v0.1.
			<strong>Última atualização:</strong> 25 de novembro de 2026.
		</p>
		<p class="legal-disclaimer">
			Este é um <em>modelo</em> publicado, não um contrato
			assinado. Os clientes podem usá-lo como ponto de partida
			para a análise pelas suas áreas de compras. Um DPA
			assinado cria obrigações reais para a Kiff Agents OÜ,
			que as autoridades de controlo da UE podem fazer
			cumprir. Contacto para compras:
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</header>
}

templ dpaPartiesPT() {
	<section id="parties">
		<h2>1. Partes</h2>
		<p>Este DPA é celebrado entre:</p>
		<ul>
			<li><strong>Kiff Agents OÜ</strong>, uma sociedade de responsabilidade limitada estónia, com o número de registo 17372313, o número de IVA EE102924327 e sede em Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estónia (o <strong>«Subcontratante»</strong>); e</li>
			<li><strong>[DENOMINAÇÃO SOCIAL DO CLIENTE]</strong>, com sede em <strong>[MORADA]</strong>, com o número de registo <strong>[NÚMERO DE REGISTO]</strong> (o <strong>«Responsável pelo Tratamento»</strong>).</li>
		</ul>
		<p>
			Cada uma, uma «parte» e, em conjunto, as «partes». Este
			DPA complementa os Termos de Serviço em
			<a href="/pt/terms">/pt/terms</a> e qualquer nota de
			encomenda comercial entre as partes; em caso de conflito
			em matéria de proteção de dados, prevalece este DPA.
		</p>
	</section>
}

templ dpaDefinitionsPT() {
	<section id="definitions">
		<h2>2. Definições</h2>
		<p>
			Os termos em maiúsculas que não estejam aqui definidos
			têm o significado que lhes é dado no RGPD (Regulamento
			(UE) 2016/679).
		</p>
		<ul>
			<li><strong>«RGPD»</strong> — o Regulamento Geral sobre a Proteção de Dados da UE.</li>
			<li><strong>«Dados Pessoais»</strong>, <strong>«Titular dos Dados»</strong>, <strong>«Tratamento»</strong>, <strong>«Responsável pelo Tratamento»</strong>, <strong>«Subcontratante»</strong>, <strong>«Subcontratante Ulterior»</strong>, <strong>«Violação de Dados Pessoais»</strong> — tal como definidos no artigo 4.º do RGPD.</li>
			<li><strong>«Dados de Auditoria»</strong> — os Dados Pessoais que o Responsável pelo Tratamento submete ao Serviço ou gera dentro dele através do runtime, incluindo eventos, decisões, ações, aprovações e recibos.</li>
			<li><strong>«Dados do tafs»</strong> — os Dados Pessoais contidos naquilo que o tafs guarda por conta do Responsável pelo Tratamento: as execuções e os chats de cada taf (incluindo o que as apps ligadas do Responsável pelo Tratamento lhe devolvem) e os chats do Setup, os seus relatórios, as suas notas de memória, os dispositivos registados para os seus alertas e as ligações do Responsável pelo Tratamento às suas apps no planque (o registo de cada ligação e das suas aprovações, e o token ou a chave que o planque guarda para ela). O Anexo 4 descreve-os.</li>
			<li><strong>«Serviço»</strong> — o produto KIFF Cloud, incluindo o tafs, tal como definido nos Termos de Serviço.</li>
			<li><strong>«Cláusulas Contratuais-Tipo»</strong> ou <strong>«CCT»</strong> — as cláusulas contratuais-tipo de 2021 da Comissão Europeia para a transferência de Dados Pessoais para países terceiros.</li>
			<li><strong>«DPF»</strong> — a decisão de adequação relativa ao Quadro de Privacidade de Dados UE-EUA.</li>
			<li><strong>«MTO»</strong> — as medidas técnicas e organizativas descritas no Anexo 2.</li>
		</ul>
	</section>
}

templ dpaScopePT() {
	<section id="scope">
		<h2>3. Âmbito e papéis</h2>
		<p>
			Este DPA aplica-se quando a Kiff Agents OÜ Trata Dados
			Pessoais por conta do Responsável pelo Tratamento no
			âmbito do Serviço. No que respeita aos Dados de
			Auditoria e aos Dados do tafs, o Responsável pelo
			Tratamento é o Responsável pelo Tratamento e a Kiff
			Agents OÜ é o Subcontratante.
		</p>
		<p>
			Os Dados Pessoais que tratamos sobre os titulares de
			contas do Responsável pelo Tratamento (metadados de
			início de sessão, contactos de faturação, correspondência
			com o suporte) são regidos pela nossa
			<a href="/pt/privacy">política de privacidade</a>; quanto a
			esses dados, somos um Responsável pelo Tratamento
			independente, e não um Subcontratante ao abrigo deste
			DPA.
		</p>
	</section>
}

templ dpaSubjectMatterPT() {
	<section id="subject-matter">
		<h2>4. Objeto e duração</h2>
		<p>
			<strong>Objeto:</strong> o Tratamento de Dados de
			Auditoria e de Dados do tafs para prestar o Serviço.
		</p>
		<p>
			<strong>Duração:</strong> desde a data de entrada em
			vigor deste DPA até ao que ocorrer mais tarde: (a) a
			cessação dos Termos de Serviço subjacentes, ou (b) a
			eliminação de todos os Dados de Auditoria nos termos do
			§16. As disposições que, pela sua natureza, subsistem
			após a cessação (auditoria, indemnização, lei aplicável)
			subsistem.
		</p>
	</section>
}

templ dpaNaturePurposePT() {
	<section id="nature-purpose">
		<h2>5. Natureza e finalidade do tratamento</h2>
		<p>
			A Kiff Agents OÜ Trata os Dados de Auditoria apenas na
			medida do necessário para prestar o Serviço: receber
			propostas e chamadas a ferramentas, avaliá-las face à
			configuração e aos Cards do Responsável pelo Tratamento,
			retê-las para aprovação humana quando a configuração o
			exija, encaminhar uma chamada autorizada para a
			app ligada ou emitir uma autorização que a
			app verifica, registar as decisões e o resultado
			que a app comunica, emitir Recibos assinados e
			(quando o Responsável pelo Tratamento o tenha
			configurado) publicar hashes de resumo que evidenciam
			adulterações num trilho público verificável. A
			app ligada executa a ação subjacente; uma decisão
			de autorização não é, por si só, prova de que a ação foi
			executada.
		</p>
		<p>
			Para o tafs, a Kiff Agents OÜ Trata também os Dados do
			tafs para executar cada taf que o Responsável pelo
			Tratamento inicia: executá-lo segundo o seu agendamento e
			em chats com as pessoas do Responsável pelo Tratamento,
			enviar as suas chamadas a ferramentas através do KIFF,
			guardar as suas execuções, os seus chats e as suas notas
			de memória para que possa apresentar relatórios e continuar o
			seu trabalho, e alertar os dispositivos registados do
			Responsável pelo Tratamento quando uma chamada é retida.
			Através do Setup e do planque, liga também as
			apps do Responsável pelo Tratamento quando as
			pessoas deste iniciam sessão no fornecedor da app
			e aprovam a ligação no seu dispositivo: numa app em que o planque inicia sessão por si próprio, como o Stripe, ou com uma chave dada pelo Responsável pelo Tratamento, o planque guarda esse token ou essa chave, encriptados, e usa-os apenas para fazer uma chamada que o KIFF decidiu; numa ligação gerida, a Composio guarda o início de sessão e faz apenas as chamadas que o planque lhe pede, e o planque guarda o registo da ligação e as ferramentas aprovadas. O KIFF usa ligações geridas apenas para as apps indicadas em <a href="/pt/subprocessors#composio">kiff.dev/subprocessors</a>. O
			Anexo 4 indica os dados, onde são guardados e durante
			quanto tempo.
		</p>
	</section>
}

templ dpaCategoriesPT() {
	<section id="categories">
		<h2>6. Categorias de Titulares dos Dados e de Dados Pessoais</h2>
		<p>
			Por omissão, a Kiff Agents OÜ Trata estas categorias de
			Dados Pessoais, tal como descreve o inventário em
			<a href="/pt/security#data-we-process">/pt/security#data-we-process</a>:
		</p>
		<ul>
			<li><strong>Dados da conta</strong>: quem são as pessoas do Responsável pelo Tratamento na sua conta (nomes, endereços de email, funções), e os seus agentes e as respetivas chaves. Os metadados de início de sessão que a Kiff Agents OÜ guarda como responsável pelo tratamento continuam sujeitos ao §3.</li>
			<li><strong>Ligações a apps</strong>: cada ligação às apps do Responsável pelo Tratamento, as ferramentas aprovadas, o registo de quem as aprovou e, quando o planque o guarda, o seu token ou a sua chave (encriptados).</li>
			<li><strong>Registos das ações dos agentes</strong>: por cada chamada, quem pediu (agente e chave), a ação, aquilo sobre que atuou, o resultado e os seus motivos, o Card em vigor, os parâmetros numéricos, as chamadas retidas e as respetivas respostas, e os recibos.</li>
			<li><strong>Chats com tafs</strong>: as execuções e os chats de cada taf, os seus relatórios e notas de memória, e o que as apps do Responsável pelo Tratamento lhe devolvem, tal como descreve o Anexo 4.</li>
		</ul>
		<p>
			Os <strong>Titulares dos Dados</strong> são as pessoas do
			Responsável pelo Tratamento que usam o Serviço e as
			pessoas cujos dados aparecem nas ações dos seus agentes
			e nos chats com tafs, como os clientes, os fornecedores
			ou o pessoal do Responsável pelo Tratamento.
		</p>
		<p>
			O que mais chega ao Serviço depende da configuração do
			Responsável pelo Tratamento e dos dados que este envia;
			a Kiff Agents OÜ não controla que campos o Responsável
			pelo Tratamento envia. O Responsável pelo Tratamento
			acrescenta quaisquer outras categorias no Anexo 1, que é
			atualizado quando a configuração se altera de forma
			substancial.
		</p>
	</section>
}

templ dpaInstructionsPT() {
	<section id="instructions">
		<h2>7. Instruções do Responsável pelo Tratamento</h2>
		<p>
			A Kiff Agents OÜ Tratará os Dados Pessoais de acordo com
			as instruções documentadas do Responsável pelo
			Tratamento. Essas instruções compreendem este DPA, os
			Termos de Serviço, a documentação técnica do Serviço e
			as medidas de segurança na revisão datada em
			<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>,
			e as configurações e instruções submetidas através do
			Serviço pelos utilizadores autorizados do Responsável
			pelo Tratamento.
		</p>
		<p>
			O whitepaper estratégico e a documentação da framework
			de código aberto, licenciada em separado, são
			referências explicativas e não fazem parte dessas
			instruções de tratamento. A publicação de um documento
			revisto não altera, por si só, as instruções aplicáveis
			a um acordo existente.
		</p>
		<p>
			As instruções fora desse âmbito exigem acordo escrito.
			Se a Kiff Agents OÜ considerar que uma instrução é
			contrária ao RGPD ou a outra legislação de proteção de
			dados aplicável, notificará o Responsável pelo
			Tratamento.
		</p>
	</section>
}

templ dpaProcessorObligationsPT() {
	<section id="processor-obligations">
		<h2>8. Obrigações do Subcontratante (artigo 28.º, n.º 3)</h2>
		<p>
			A Kiff Agents OÜ:
		</p>
		<ol>
			<li>Tratará os Dados Pessoais apenas mediante instruções documentadas do Responsável pelo Tratamento, incluindo no que respeita às transferências internacionais, salvo se for obrigada a proceder de outro modo pelo direito da UE ou de um Estado-Membro (caso em que a Kiff Agents OÜ informará o Responsável pelo Tratamento desse requisito jurídico antes do Tratamento, salvo se esse direito proibir tal informação por motivos importantes de interesse público);</li>
			<li>assegurará que as pessoas autorizadas a Tratar os Dados Pessoais estão vinculadas por obrigações de confidencialidade adequadas;</li>
			<li>aplicará as medidas técnicas e organizativas descritas no Anexo 2;</li>
			<li>respeitará as condições para a contratação de Subcontratantes Ulteriores estabelecidas no §10;</li>
			<li>tendo em conta a natureza do Tratamento, prestará assistência ao Responsável pelo Tratamento, através de medidas adequadas, para cumprir as obrigações de dar resposta aos pedidos dos Titulares dos Dados ao abrigo do capítulo III do RGPD;</li>
			<li>prestará assistência ao Responsável pelo Tratamento para assegurar o cumprimento dos artigos 32.º a 36.º do RGPD (segurança, notificação de violações, AIPD, consulta prévia), tendo em conta a natureza do Tratamento e a informação ao dispor da Kiff Agents OÜ;</li>
			<li>consoante a escolha do Responsável pelo Tratamento, eliminará ou devolverá todos os Dados Pessoais depois de terminada a prestação dos serviços, nos termos do §16, e eliminará as cópias existentes, a menos que o direito da UE ou de um Estado-Membro exija a sua conservação;</li>
			<li>disponibilizará ao Responsável pelo Tratamento todas as informações necessárias para demonstrar o cumprimento do artigo 28.º do RGPD e permitirá e contribuirá para as auditorias nos termos do §15.</li>
		</ol>
	</section>
}

templ dpaConfidentialityPT() {
	<section id="confidentiality">
		<h2>9. Confidencialidade</h2>
		<p>
			A Kiff Agents OÜ assegura que as pessoas com acesso aos
			Dados Pessoais estão vinculadas por obrigações de
			confidencialidade escritas ou sujeitas a uma obrigação
			legal de confidencialidade adequada. O acesso é
			concedido segundo o princípio do privilégio mínimo e é
			registado.
		</p>
	</section>
}

templ dpaSubprocessorsPT() {
	<section id="sub-processors">
		<h2>10. Subcontratantes Ulteriores</h2>
		<p>
			O Responsável pelo Tratamento autoriza a Kiff Agents OÜ
			a contratar os Subcontratantes Ulteriores enumerados no
			Anexo 3 e em
			<a href="/pt/subprocessors">/pt/subprocessors</a>, que é a
			lista oficial. A Kiff Agents OÜ impõe a cada
			Subcontratante Ulterior obrigações de proteção de dados
			que não são menos protetoras do que este DPA.
		</p>
		<p>
			O trilho público verificável não é um Subcontratante
			Ulterior. Recebe apenas hashes de resumo e nenhuns Dados
			Pessoais.
		</p>
		<p>
			A revisão datada para a qual a secção 7 remete regista a
			lista à data dessa revisão. Uma alteração posterior
			produz efeitos ao abrigo desta secção, e não pela
			publicação de uma revisão.
		</p>
		<p>
			Quando a Kiff Agents OÜ pretender contratar um novo
			Subcontratante Ulterior ou substituir um existente para
			o Tratamento dos Dados Pessoais do Responsável pelo
			Tratamento, a Kiff Agents OÜ notifica o Responsável pelo
			Tratamento com pelo menos trinta dias de antecedência. O
			Responsável pelo Tratamento pode opor-se à alteração,
			por motivos razoáveis de proteção de dados, no prazo de
			quinze dias após a notificação; se uma oposição razoável
			não puder ser resolvida, qualquer das partes pode pôr
			termo à parte afetada do Serviço mediante notificação
			escrita.
		</p>
	</section>
}

templ dpaTransfersPT() {
	<section id="transfers">
		<h2>11. Transferências internacionais</h2>
		<p>
			Quando o Tratamento de Dados Pessoais implicar uma
			transferência para um país fora do Espaço Económico
			Europeu sem uma decisão de adequação nos termos do
			artigo 45.º do RGPD, as partes acordam que:
		</p>
		<ul>
			<li>nas transferências para Subcontratantes Ulteriores certificados ao abrigo do Quadro de Privacidade de Dados UE-EUA, o DPF é o mecanismo de transferência enquanto se mantiver em vigor;</li>
			<li>nos restantes casos, as partes incorporam por remissão as Cláusulas Contratuais-Tipo de 2021 da Comissão Europeia, aplicando-se o Módulo 2 (de responsável pelo tratamento para subcontratante) às transferências do Responsável pelo Tratamento para a Kiff Agents OÜ e o Módulo 3 (de subcontratante para subcontratante ulterior) às transferências da Kiff Agents OÜ para um Subcontratante Ulterior;</li>
			<li>a cláusula de adesão (Cláusula 7) não é usada; as partes nas CCT são o Responsável pelo Tratamento e a Kiff Agents OÜ;</li>
			<li>os Anexos I.A e I.B das CCT são preenchidos por remissão para o Anexo 1 deste DPA; o Anexo II das CCT, por remissão para o Anexo 2 deste DPA; o Anexo III, por remissão para o Anexo 3 deste DPA;</li>
			<li>aplica-se a opção 2 da Cláusula 9, alínea a) (autorização geral por escrito), com o prazo de notificação de trinta dias do §10 acima.</li>
		</ul>
		<p>
			Quando, na sequência de uma avaliação de impacto da
			transferência, forem adequadas medidas suplementares, a
			Kiff Agents OÜ aplica-as (encriptação em trânsito e em
			repouso, registo de acessos, minimização de dados, tal
			como documentado no Anexo 2).
		</p>
	</section>
}

templ dpaSecurityPT() {
	<section id="security">
		<h2>12. Medidas de segurança</h2>
		<p>
			A Kiff Agents OÜ aplica medidas técnicas e organizativas
			adequadas para assegurar um nível de segurança adequado
			ao risco, nos termos do artigo 32.º do RGPD. As medidas
			do Anexo 2 e da revisão datada em
			<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>
			são a base acordada.
			<a href="/pt/security">/pt/security</a> descreve as medidas
			atuais. A Kiff Agents OÜ pode atualizar as medidas,
			desde que o nível global de segurança não desça abaixo
			dessa base, e notifica previamente o Responsável pelo
			Tratamento de uma alteração substancial dessas medidas.
		</p>
	</section>
}

templ dpaBreachNotificationPT() {
	<section id="breach-notification">
		<h2>13. Notificação de Violações de Dados Pessoais</h2>
		<p>
			A Kiff Agents OÜ notifica o Responsável pelo Tratamento
			de uma Violação de Dados Pessoais que afete os Dados
			Pessoais do Responsável pelo Tratamento sem demora
			injustificada e, em qualquer caso, no prazo de setenta e
			duas (72) horas após ter tomado conhecimento dela. A
			notificação inclui, na medida do que for conhecido nesse
			momento, e é atualizada à medida que houver mais
			informação disponível:
		</p>
		<ul>
			<li>a natureza da Violação, incluindo as categorias e os números aproximados de Titulares dos Dados e de registos em causa;</li>
			<li>as consequências prováveis da Violação;</li>
			<li>as medidas tomadas ou propostas para dar resposta à Violação e para atenuar os seus eventuais efeitos negativos;</li>
			<li>o nome e os contactos de um ponto de contacto único na Kiff Agents OÜ para mais informações.</li>
		</ul>
		<p>
			O prazo do próprio Responsável pelo Tratamento perante a
			sua autoridade de controlo, nos termos do artigo 33.º do
			RGPD, conta a partir do momento em que o próprio
			Responsável pelo Tratamento toma conhecimento da
			Violação; esta notificação apoia essa obrigação.
		</p>
	</section>
}

templ dpaDataSubjectRequestsPT() {
	<section id="data-subject-requests">
		<h2>14. Pedidos dos Titulares dos Dados</h2>
		<p>
			A Kiff Agents OÜ presta assistência ao Responsável pelo
			Tratamento, através de medidas técnicas e organizativas
			adequadas e tendo em conta a natureza do Tratamento, no
			cumprimento das obrigações do Responsável pelo
			Tratamento de dar resposta aos pedidos dos Titulares dos
			Dados que exerçam os seus direitos ao abrigo dos artigos
			15.º a 22.º do RGPD.
		</p>
		<p>
			A Kiff Agents OÜ acusa a receção dos pedidos de
			assistência do Responsável pelo Tratamento no prazo de
			cinco (5) dias úteis. Os pedidos diretos recebidos dos
			Titulares dos Dados são reencaminhados para o
			Responsável pelo Tratamento sem demora injustificada; a
			Kiff Agents OÜ não responde a esses pedidos em seu
			próprio nome, exceto para confirmar a receção e
			encaminhar o Titular dos Dados para o Responsável pelo
			Tratamento.
		</p>
	</section>
}

templ dpaAuditPT() {
	<section id="audit">
		<h2>15. Direitos de auditoria</h2>
		<p>
			A Kiff Agents OÜ disponibiliza ao Responsável pelo
			Tratamento todas as informações razoavelmente
			necessárias para demonstrar o cumprimento do artigo 28.º
			do RGPD. Mediante pré-aviso escrito razoável (pelo menos
			trinta dias, exceto no caso de uma auditoria desencadeada
			por uma violação grave confirmada), o Responsável pelo
			Tratamento pode auditar a Kiff Agents OÜ uma vez em cada
			período de doze meses.
		</p>
		<p>
			A Kiff Agents OÜ ainda não tem um relatório SOC 2 nem
			ISO 27001. A pedido, partilha a sua visão geral de
			segurança em
			<a href="/pt/security">/pt/security</a> e responde aos
			questionários de segurança do Responsável pelo
			Tratamento.
		</p>
		<p>
			As auditorias são realizadas durante o horário normal de
			expediente, não interferem de forma não razoável com o
			Serviço e respeitam a confidencialidade dos outros
			clientes da Kiff Agents OÜ. O Responsável pelo
			Tratamento suporta os seus próprios custos de auditoria;
			quando uma auditoria revelar um incumprimento grave por
			parte da Kiff Agents OÜ, a Kiff Agents OÜ reembolsa os
			custos de auditoria razoáveis do Responsável pelo
			Tratamento.
		</p>
	</section>
}

templ dpaReturnDeletionPT() {
	<section id="return-deletion">
		<h2>16. Devolução ou eliminação dos Dados Pessoais</h2>
		<p>
			Consoante a escolha do Responsável pelo Tratamento e no
			prazo de trinta dias após a cessação do Serviço para o
			Responsável pelo Tratamento, a Kiff Agents OÜ devolve os
			Dados de Auditoria num formato estruturado, de uso
			corrente e de leitura automática, ou elimina-os. A mesma
			escolha aplica-se aos Dados do tafs. Na falta de uma
			escolha dentro desse prazo, a Kiff Agents OÜ elimina
			ambos. Os Dados do tafs são eliminados removendo cada
			taf, tal como descreve o Anexo 4: depois de os dados do
			Responsável pelo Tratamento serem devolvidos, ou de
			imediato quando este tiver escolhido a eliminação, a Kiff
			Agents OÜ remove qualquer taf que o Responsável pelo
			Tratamento não tenha removido, e desliga e elimina as
			ligações do Responsável pelo Tratamento e os respetivos
			registos no planque.
		</p>
		<p>
			Os hashes já publicados no trilho público verificável
			permanecem, porque o trilho é imutável. Como o trilho
			público usa «salting» criptográfico por tenant (conforme
			<a href="/pt/security#public-trail">/pt/security#public-trail</a>),
			a destruição do «salt» do tenant torna
			permanentemente impossível associar esses hashes
			publicados aos registos que os produziram.
		</p>
		<p>
			É feita diariamente uma cópia de segurança, encriptada,
			da base de dados do KIFF, e cada cópia é guardada sete
			dias, pelo que um registo eliminado desaparece delas no
			prazo de sete dias após a sua eliminação. Os
			armazenamentos do tafs e do planque guardam durante 35
			dias cópias encriptadas de recuperação para um ponto no
			tempo, pelo que um registo eliminado desaparece delas no
			prazo de 35 dias após a sua eliminação; servem apenas para
			restaurar um armazenamento após uma falha. Os registos dos
			serviços, que podem indicar a conta, são eliminados no
			prazo de 30 dias. A Kiff
			Agents OÜ pode conservar Dados Pessoais quando a sua
			conservação for exigida pelo direito da UE ou de um
			Estado-Membro (por exemplo, a Lei da Contabilidade da
			Estónia, §12).
		</p>
	</section>
}

templ dpaLiabilityPT() {
	<section id="liability">
		<h2>17. Responsabilidade</h2>
		<p>
			A responsabilidade de cada parte ao abrigo deste DPA
			está sujeita às limitações e exclusões estabelecidas nos
			Termos de Serviço, exceto quando a legislação aplicável
			proíba essa limitação. Cada parte é responsável pelos
			danos causados pela sua própria violação do RGPD, nos
			termos do artigo 82.º do RGPD.
		</p>
	</section>
}

templ dpaTermPT() {
	<section id="term">
		<h2>18. Duração e cessação</h2>
		<p>
			Este DPA produz efeitos com a assinatura por ambas as
			partes e mantém-se durante o período descrito no §4. A
			cessação dos Termos de Serviço faz cessar
			automaticamente este DPA, sem prejuízo das obrigações
			que subsistem.
		</p>
	</section>
}

templ dpaGoverningLawPT() {
	<section id="governing-law">
		<h2>19. Lei aplicável</h2>
		<p>
			Este DPA é regido pelas leis da República da Estónia,
			sem prejuízo das disposições imperativas do RGPD ou das
			regras de proteção do consumidor, quando aplicáveis. Os
			litígios decorrentes deste DPA estão sujeitos às regras
			de foro e de escolha de lei do §18 dos Termos de
			Serviço.
		</p>
	</section>
}

templ dpaAnnex1PT() {
	<section id="annex-1">
		<h2>Anexo 1 — Descrição do Tratamento</h2>
		<p>Preenchido em cada exemplar assinado.</p>
		<dl class="legal-annex">
			<div>
				<dt>A. Lista das partes</dt>
				<dd>O Responsável pelo Tratamento e o Subcontratante, tal como identificados no §1.</dd>
			</div>
			<div>
				<dt>B. Descrição da transferência</dt>
				<dd>
					<strong>Categorias de Titulares dos Dados:</strong> as enumeradas no §6, mais [quaisquer outras categorias que o Responsável pelo Tratamento declare].
					<br/>
					<strong>Categorias de Dados Pessoais:</strong> as enumeradas no §6 (dados da conta, ligações a apps, registos das ações dos agentes, chats com tafs), mais [quaisquer outras categorias que o Responsável pelo Tratamento declare].
					<br/>
					<strong>Dados sensíveis:</strong> [declaração do Responsável pelo Tratamento; por omissão: nenhuns].
					<br/>
					<strong>Frequência da transferência:</strong> contínua (cada pedido ao Serviço).
					<br/>
					<strong>Natureza do Tratamento:</strong> a descrita no §5.
					<br/>
					<strong>Finalidades do Tratamento:</strong> as descritas no §5.
					<br/>
					<strong>Período de conservação:</strong> de acordo com <a href="/pt/privacy#retention">/pt/privacy#retention</a> e com o §16.
				</dd>
			</div>
			<div>
				<dt>C. Autoridade de controlo competente</dt>
				<dd>A Inspeção de Proteção de Dados da Estónia (Andmekaitse Inspektsioon).</dd>
			</div>
		</dl>
	</section>
}

templ dpaAnnex2PT() {
	<section id="annex-2">
		<h2>Anexo 2 — Medidas técnicas e organizativas</h2>
		<p>
			Um resumo adequado a um DPA nos termos do artigo 28.º.
			Este Anexo e a revisão datada em
			<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>
			são a base acordada ao abrigo da secção 12.
			<a href="/pt/security">/pt/security</a> mostra as medidas
			atuais e é atualizada no prazo de 30 dias após uma
			alteração substancial.
		</p>
		<div class="legal-table" tabindex="0">
			<table>
				<thead>
					<tr>
						<th>Dimensão do artigo 32.º</th>
						<th>Medidas</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Pseudonimização e encriptação</td>
						<td>TLS 1.2+ em trânsito. Encriptação em repouso com as predefinições do fornecedor da base de dados gerida. Chaves de assinatura por tenant guardadas num serviço gerido de chaves. Hashing dos emails em repouso planeado.</td>
					</tr>
					<tr>
						<td>Confidencialidade</td>
						<td>Isolamento de tenants na camada da base de dados (esquema Postgres por tenant, com o <code>search_path</code> fixado). Acesso segundo o princípio do privilégio mínimo, início de sessão único para o pessoal, acordos de confidencialidade para todo o pessoal.</td>
					</tr>
					<tr>
						<td>Integridade</td>
						<td>Cadeia de auditoria apenas de acréscimo ao nível da framework. Hashes de resumo que evidenciam adulterações, publicados num trilho público verificável.</td>
					</tr>
					<tr>
						<td>Disponibilidade e resiliência</td>
						<td>Computação e base de dados geridas em <code>eu-west-1</code> (Irlanda). Verificações de estado. Notas para operadores em <a href="/pt/security#incident">/pt/security#incident</a>.</td>
					</tr>
					<tr>
						<td>Restabelecimento do acesso</td>
						<td>Procedimento operacional de resposta a incidentes documentado, apenas interno.</td>
					</tr>
					<tr>
						<td>Teste da eficácia</td>
						<td>Testes unitários e de integração, executados antes de cada lançamento; revisão de segurança periódica.</td>
					</tr>
				</tbody>
			</table>
		</div>
	</section>
}

templ dpaAnnex3PT() {
	<section id="annex-3">
		<h2>Anexo 3 — Subcontratantes Ulteriores</h2>
		<p>
			A lista oficial está em
			<a href="/pt/subprocessors">/pt/subprocessors</a>;
			essa lista faz fé quanto aos Subcontratantes Ulteriores
			atuais, só se altera segundo o procedimento da secção
			10 e é atualizada no prazo de 30 dias após qualquer
			alteração. À data desta versão do modelo:
		</p>
		<div class="legal-table" tabindex="0">
			<table>
				<thead>
					<tr>
						<th>Subcontratante Ulterior</th>
						<th>Serviço prestado</th>
						<th>Região</th>
						<th>Mecanismo de transferência</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Amazon Web Services EMEA SARL / Amazon Web Services Inc.</td>
						<td>Computação, Postgres gerido, gestão de chaves, rede, armazenamento de segredos; para o tafs, também as suas execuções, chats e notas de memória, e as ligações do planque</td>
						<td>Irlanda (eu-west-1): o KIFF Cloud, o serviço tafs, as execuções, os chats e as chamadas a modelos do tafs, e o planque, com tudo o que guardam. A Irlanda serve também as demonstrações públicas do KIFF e os vídeos do site. A única coisa nos Estados Unidos (us-east-1) são os certificados que o CloudFront exige nessa região, que não contêm dados de clientes</td>
						<td>Quadro de Privacidade de Dados UE-EUA / CCT como alternativa</td>
					</tr>
					<tr>
						<td>Clerk, Inc.</td>
						<td>Autenticação dos utilizadores e gestão de sessões: o endereço de email e o nome das pessoas que iniciam sessão, as suas sessões, o endereço IP, o dispositivo e o navegador, e a identidade da Apple, da Google ou do GitHub quando alguém inicia sessão com uma delas</td>
						<td>Estados Unidos</td>
						<td>Quadro de Privacidade de Dados UE-EUA / CCT como alternativa</td>
					</tr>
					<tr>
						<td>Anthropic, PBC</td>
						<td>Apenas para o tafs: o modelo de IA por trás do Coach e de cada taf (Claude API), que só recebe dados depois de a pessoa o autorizar na app tafs. A Anthropic elimina o que recebe e devolve no prazo de 30 dias, salvo se tiver de o guardar durante mais tempo para cumprir a lei, para fazer cumprir a sua política de utilização ou conforme os seus termos comerciais prevejam de outro modo. Não está em uso agora.</td>
						<td>Estados Unidos, chamada a partir da Irlanda (eu-west-1); a inferência pode correr nos Estados Unidos, na Europa, na Ásia ou na Austrália</td>
						<td>CCT</td>
					</tr>
					<tr>
						<td>Amazon Web Services EMEA SARL (Amazon Bedrock)</td>
						<td>Apenas tafs, e só enquanto for o fornecedor em uso, um de cada vez: executa o Claude, o modelo por trás do Coach e de cada taf, através do Amazon Bedrock, com dados só depois de a pessoa o permitir na app tafs. Não é usado para treinar modelos; no modo de retenção predefinido do Bedrock, alguns modelos guardam-no até 30 dias por confiança e segurança. Em uso agora.</td>
						<td>Apenas regiões da UE (perfis de inferência inter-regionais da UE do Bedrock), chamado a partir da Irlanda (eu-west-1)</td>
						<td>Dentro da UE; Quadro de Privacidade de Dados UE-EUA / CCT como alternativa</td>
					</tr>
					<tr>
						<td>Google Cloud EMEA Limited (Vertex AI)</td>
						<td>Apenas tafs, e só enquanto for o fornecedor em uso, um de cada vez: executa o Claude através do Vertex AI, com dados só depois de a pessoa o permitir na app tafs. Para alguns modelos da Anthropic, guardado até 30 dias para monitorizar abusos e partilhado com a Anthropic para esse fim</td>
						<td>Apenas UE (endpoints regionais europe-west)</td>
						<td>Dentro da UE; Quadro de Privacidade de Dados UE-EUA / CCT como alternativa</td>
					</tr>
					<tr>
						<td>Microsoft Ireland Operations Limited (Azure AI Foundry)</td>
						<td>Apenas tafs, e só enquanto for o fornecedor em uso, um de cada vez: aloja o endpoint do Claude no Azure, com dados só depois de a pessoa o permitir na app tafs; a Anthropic trata o que é enviado segundo os seus próprios termos, como na linha da Anthropic</td>
						<td>Apenas zona de dados da UE (uma implementação alojada no Azure)</td>
						<td>Dentro da UE; Quadro de Privacidade de Dados UE-EUA / CCT como alternativa</td>
					</tr>
					<tr>
						<td>Apple Inc.</td>
						<td>Apenas para o tafs: entrega alertas de chamadas retidas aos dispositivos registados (Apple Push Notification service). Um alerta não contém detalhes do pedido</td>
						<td>Estados Unidos</td>
						<td>CCT</td>
					</tr>
					<tr>
						<td>Resend, Inc.</td>
						<td>Email para as pessoas do Responsável pelo Tratamento: avisos de chamadas retidas e de alertas de Cards, avisos de utilização e da conta, e respostas do suporte; para o tafs, a porta de email de um taf, o correio que lhe é enviado e as respostas dele</td>
						<td>Estados Unidos</td>
						<td>CCT</td>
					</tr>
					<tr>
						<td>Sampark Inc. (Composio)</td>
						<td>Apenas para o tafs, através do planque: guarda os inícios de sessão das ligações geridas e o bot do Slack por trás de uma porta do Slack, e faz cada chamada que o planque pede, com os seus dados de entrada e a resposta do serviço. Nem um taf nem o planque recebem esses inícios de sessão</td>
						<td>Estados Unidos</td>
						<td>CCT (Módulo 3)</td>
					</tr>
					<tr>
						<td>Stripe Payments Europe, Ltd. / Stripe, Inc.</td>
						<td>Faturação, quando está ativa: o contacto de faturação da conta e as contagens de utilização comunicadas para faturação</td>
						<td>UE e Estados Unidos</td>
						<td>Quadro de Privacidade de Dados UE-EUA / CCT como alternativa</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p>
			O trilho público verificável não é um Subcontratante
			Ulterior: recebe apenas hashes de resumo e nenhuns Dados
			Pessoais.
		</p>
	</section>
}

templ dpaAnnex4PT() {
	<section id="annex-4">
		<h2>Anexo 4 — tafs</h2>
		<p>
			O que o tafs guarda por conta do Responsável pelo
			Tratamento, onde e durante quanto tempo. O Responsável
			pelo Tratamento remove um taf na app tafs; removê-lo
			elimina tudo o que abaixo é guardado «até o taf ser
			removido».
		</p>
		<div class="legal-table" tabindex="0">
			<table>
				<thead>
					<tr>
						<th>Dados</th>
						<th>Onde</th>
						<th>O que podem conter</th>
						<th>Durante quanto tempo</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Execuções e chats, incluindo os do Setup</td>
						<td>Armazenamento próprio do tafs (AWS, uma região da UE)</td>
						<td>As mensagens das pessoas do Responsável pelo Tratamento para o taf, as respostas e os relatórios dele, um resumo das mensagens anteriores de um chat longo, as chamadas a ferramentas que fez e quanto custou cada execução</td>
						<td>30 dias, ou até o taf ser removido, se isso acontecer antes</td>
					</tr>
					<tr>
						<td>O que as apps devolvem</td>
						<td>Armazenamento próprio do tafs (AWS, uma região da UE)</td>
						<td>Resultados das apps do Responsável pelo Tratamento, que podem incluir dados sobre os seus clientes, fornecedores ou pessoal</td>
						<td>Até terminar a execução que os leu. Num chat, os resultados das chamadas que apenas leem são guardados para as mensagens seguintes desse chat, encriptados com uma chave da conta do Responsável pelo Tratamento, e usados até o chat estar uma hora inativo e nunca mais de quatro horas após a leitura. São depois eliminados automaticamente, o que pode demorar até alguns dias, durante os quais não são usados. Não são mostrados em nenhuma vista, relatório ou exportação</td>
					</tr>
					<tr>
						<td>Aquilo sobre que cada chamada atuou</td>
						<td>Armazenamento próprio do tafs (AWS, uma região da UE)</td>
						<td>Por cada chamada que um taf faz através do KIFF, a referência do KIFF para a chamada e o identificador daquilo sobre que atuou (por exemplo, o ID de um pagamento, nunca os dados do cliente), para o mostrar no Registo do taf. Nada mais dos dados de entrada da chamada</td>
						<td>30 dias, ou até o taf ser removido, se isso acontecer antes</td>
					</tr>
					<tr>
						<td>Notas de memória</td>
						<td>Armazenamento próprio do tafs (AWS, uma região da UE)</td>
						<td>O que o taf aprendeu sobre a forma como o Responsável pelo Tratamento quer que o trabalho seja feito</td>
						<td>Até a nota ser esquecida ou o taf ser removido</td>
					</tr>
					<tr>
						<td>Pedidos ao modelo</td>
						<td>A Anthropic, ou o fornecedor de nuvem em uso (ver os subcontratantes)</td>
						<td>O que uma pessoa escreve ao Coach e aos tafs, os ficheiros anexados, o que as apps ligadas devolvem a um taf durante uma execução e o que está no ecrã enquanto o Coach ajuda na app; e o que o modelo devolve. Nunca as palavras-passe e chaves das apps ligadas, nem uma impressão digital</td>
						<td>Apagado no prazo de 30 dias pela empresa que executa o modelo, salvo se for assinalado como contrário às suas regras de utilização ou se a lei exigir que seja guardado</td>
					</tr>
					<tr>
						<td>A chave KIFF do taf</td>
						<td>Serviço próprio do tafs (AWS), guardada como segredo</td>
						<td>A credencial que o taf usa para chegar ao KIFF. Nunca é escrita numa execução nem num chat</td>
						<td>Até o taf ser removido</td>
					</tr>
					<tr>
						<td>A configuração do taf</td>
						<td>Serviço próprio do tafs (AWS)</td>
						<td>O seu nome, trabalho, agendamento e orçamento, e a conta KIFF e o agente a que pertence</td>
						<td>Até o taf ser removido</td>
					</tr>
					<tr>
						<td>Dispositivos para alertas</td>
						<td>Serviço próprio do tafs (AWS, eu-west-1)</td>
						<td>O token push de cada dispositivo registado e a pessoa que o registou</td>
						<td>Até essa pessoa terminar a sessão, o dispositivo ser removido ou a Apple comunicar que o token deixou de existir</td>
					</tr>
					<tr>
						<td>O token ou a chave de uma ligação no planque</td>
						<td>planque (AWS, eu-west-1), encriptado com AWS KMS</td>
						<td>Numa app em que o planque inicia sessão por si próprio, como o Stripe, o token do início de sessão do Responsável pelo Tratamento no seu fornecedor, e a conta do fornecedor a que está associado; numa ligação por chave, a chave dada pelo Responsável pelo Tratamento. Nunca é dado a um taf</td>
						<td>Até a ligação ser desligada, o que revoga um token no fornecedor e elimina o token ou a chave; um início de sessão que outra ligação da conta ainda usa é mantido até a última terminar. Um início de sessão feito apenas para ver o catálogo de uma app não pode ser usado para chamadas; se nenhuma ferramenta for aprovada no prazo de um dia, é revogado na hora seguinte</td>
					</tr>
					<tr>
						<td>O início de sessão de uma ligação gerida</td>
						<td>Composio (Sampark Inc., Estados Unidos)</td>
						<td>O token ou a chave do início de sessão do Responsável pelo Tratamento no fornecedor de uma ligação gerida. Guardado pela Composio e nunca dado a um taf nem ao planque, que guarda apenas o registo da ligação e as ferramentas aprovadas. A Composio guarda-o mesmo quando o início de sessão usa a app própria do KIFF no fornecedor</td>
						<td>Até a ligação ser desligada: o planque manda então eliminá-lo na Composio, que pede ao fornecedor que o revogue. Um início de sessão que outra ligação da conta ainda usa é mantido até a última terminar. Se nenhuma ferramenta for aprovada no prazo de um dia após o início de sessão, é eliminado da mesma forma</td>
					</tr>
					<tr>
						<td>As chamadas de uma ligação gerida</td>
						<td>Composio (Sampark Inc., Estados Unidos)</td>
						<td>A entrada de cada chamada e a resposta do serviço, numa chamada que o planque pede à Composio</td>
						<td>Até um ano, nos registos da Composio; eliminados no prazo de 30 dias depois de o KIFF deixar de usar a Composio</td>
					</tr>
					<tr>
						<td>O registo de uma ligação</td>
						<td>planque (AWS, eu-west-1)</td>
						<td>As ferramentas aprovadas, o estado da ligação e os seus eventos: quem aprovou cada passo, a partir de que dispositivo, e a respetiva assinatura</td>
						<td>Até a conta terminar; mantido depois de a ligação ser desligada, como registo das aprovações</td>
					</tr>
					<tr>
						<td>A chave de conector da conta</td>
						<td>planque (AWS, eu-west-1), encriptada com AWS KMS</td>
						<td>A chave KIFF que o planque usa para adicionar as ferramentas de uma ligação à conta KIFF do Responsável pelo Tratamento. Só pode adicionar as ferramentas de uma ligação</td>
						<td>Até ser substituída, ou até a conta terminar</td>
					</tr>
					<tr>
						<td>Registos de serviço do planque</td>
						<td>planque (AWS, eu-west-1)</td>
						<td>O que cada pedido fez e porque é que uma chamada foi recusada, o que pode indicar a conta, uma ligação ou um taf; nunca o token de um início de sessão</td>
						<td>30 dias</td>
					</tr>
					<tr>
						<td>Registos de serviço</td>
						<td>Serviço próprio do tafs (AWS, eu-west-1)</td>
						<td>Os erros que um pedido encontrou, que podem indicar um taf ou uma sessão; nunca o corpo das mensagens, chaves ou tokens</td>
						<td>30 dias</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p>
			Os Cards de um taf, as chamadas retidas, as respostas e
			os recibos são Dados de Auditoria, guardados pelo KIFF ao
			abrigo do resto deste DPA.
		</p>

		<hr/>

		<p class="legal-footnote">
			<strong>Versão do documento:</strong> modelo v0.1.<br/>
			<strong>Última atualização:</strong> 25 de novembro de 2026.
		</p>
	</section>
}
