package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsPrivacyHE is tafs's privacy policy (/tafs/privacy) in Hebrew, at /he/tafs/privacy.
// It is a translation of TafsPrivacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Hebrew has the legal
// texts only, so a link to any other page goes to English and says so.
templ TafsPrivacyHE() {
	@components.LayoutSiteWithMeta("מדיניות הפרטיות של tafs", "כיצד tafs, האפליקציה של KIFF, מטפלת במידע אישי, כולל המידע שהיא מקבלת מ-Google כשאתם מחברים את חשבון Google שלכם.", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · מדיניות פרטיות</p>
				<h1>מדיניות הפרטיות של tafs</h1>
				<p class="legal-meta"><strong>עודכן לאחרונה:</strong> 25 בנובמבר 2026.</p>
				<p class="legal-disclaimer">מדיניות זו מסבירה כיצד tafs, האפליקציה של KIFF ל-iPhone, ל-iPad, ל-Android ולמחשבים, מטפלת במידע אישי. tafs היא חלק מ-KIFF Cloud, ולכן <a href="/he/privacy">מדיניות הפרטיות של KIFF</a> חלה גם עליה, ועל כל מה שהדף הזה אינו מכסה. שאלות: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.</p>
			</header>
			<section id="who-we-are">
				<h2>1. מי אנחנו</h2>
				<p>tafs מסופקת בידי <strong>Kiff Agents OÜ</strong>, חברה פרטית בערבון מוגבל שהתאגדה באסטוניה (מספר רישום 17372313, מספר מע"מ EE102924327), ב-Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estonia. תקנת הגנת המידע הכללית של האיחוד האירופי (GDPR) חלה על העיבוד שלנו.</p>
			</section>
			<section id="scope">
				<h2>2. מה המדיניות מכסה</h2>
				<p>אפליקציית tafs ל-iPhone, ל-iPad, ל-Android ולמחשבים (Mac, Windows ו-Linux), והשירות שמאחוריה, כולל Setup, שמחבר את הכלים של חברה, ו-planque, ששומר את החיבורים האלה. ב-tafs חברה מוסרת משימה לסוכן בינה מלאכותית, taf, שעובד בתוך כרטיסי KIFF.</p>
			</section>
			<section id="roles">
				<h2>3. התפקידים שלנו</h2>
				<p>אנו ה<strong>בקר</strong> של נתוני החשבון וההתחברות שלכם, ושל נתוני התפעול של השירות שלנו. אנו פועלים כ<strong>מעבד</strong>, מטעם החברה שלכם, של מה ש-tafs שומרת עבורה: ההרצות, השיחות, הדוחות, הערות הזיכרון והקבצים שמוסרים כל ה-tafs. החברה שלכם היא הבקר של המידע הזה, וה-<a href="/legal/dpa">DPA</a> (באנגלית) מסדיר את היחסים האלה.</p>
			</section>
			<section id="data">
				<h2>4. מה tafs אוספת</h2>
				<ul>
					<li><strong>החשבון שלכם:</strong> אתם נכנסים ל-tafs עם חשבון ה-KIFF שלכם. בטלפון או בטאבלט האפליקציה שומרת את ההפעלה שלכם ב-Keychain של המכשיר (ב-Android, באחסון המוצפן שלו). במחשב היא שומרת אותה אטומה לחשבון המשתמש שלכם: ב-Windows בהגנת המידע של Windows עצמה, ב-Linux ב-keyring שלכם, ב-Mac ב-Keychain שלו. הפעלה במחשב נמשכת עד 90 ימים.</li>
					<li><strong>המכשיר שלכם:</strong> האפליקציה יוצרת מפתח חתימה שלעולם אינו עוזב את המכשיר: ב-Secure Enclave של iPhone, iPad או Mac, ב-Keystore של מכשיר Android, או ב-TPM של מחשב Windows. ב-Linux, וב-Mac ללא Secure Enclave, המפתח הוא מפתח תוכנה השמור ב-keyring או ב-Keychain שלכם, והמחשב הזה יכול להראות מה מחכה לכם אך לא לאשר אותו; אתם מאשרים בטלפון{ macSecurityKey("he") }. מחשב Windows ללא TPM אינו יכול להיכנס ל-tafs. KIFF שומרת את החצי הציבורי של המפתח, את שם המכשיר והפלטפורמה שלו, ומתי נוסף ונעשה בו שימוש לאחרונה, כדי שתוכל לבדוק את תשובותיכם לקריאות מעוכבות ואת אישורי החיבורים שלכם.</li>
					<li><strong>השעון שלכם:</strong> שעון אינו מחזיק סיסמה או מפתח, מדבר רק עם הטלפון המשויך שלכם, ולעולם אינו מאשר. הוא שולח את מה שאתם אומרים ל-Coach, או ל-taf שבחרתם, רק כטקסט, דרך הטלפון, לאחר שהתרתם את הבינה המלאכותית. שירות הדיבור של השעון עצמו, של Apple או של Google, הופך את דבריכם לטקסט הזה. ב-Wear OS, אם הוא נעצר לפני שסיימתם, מזהה הדיבור של הטלפון שלכם עושה זאת במקומו, בטלפון. הוא יכול לדחות, לעצור (halt) או לשלוח ל-Coach או ל-taf רק כשיש לו נעילת מסך או קוד גישה והוא פתוח. מה שאתם שולחים ל-taf נכנס לשיחה של אותו taf, כאילו כתבתם אותו בטלפון. השיחה של taf, כולל סכומים, נקראת דרך הטלפון בכל פעם שהיא נפתחת, והשעון שומר רק את ההודעות האחרונות שהסעיף שלו למטה מתאר. כשהאפליקציות סגורות, הטלפון מעביר תשובות והודעות חדשות לשעון דרך הקישור של המערכת עצמה בין הטלפון לשעון (של Apple ב-Apple Watch, של שירותי Google Play ב-Wear OS), שמחזיק אותן בטלפון ובשעון רק עד שהשעון מקבל אותן; ההתראה שמעירה את הטלפון לא נושאת מילים. תשובה שמגיעה כשאתם לא מסתכלים בשעון מוצגת גם כהתראה, ב-iPhone וב-Apple Watch או בשעון Wear OS, עם המילים שלה אבל אף פעם לא עם סכום, ונשארת עד שתסגרו אותה; שעון Wear OS נעול מראה רק שתשובה מוכנה.</li>
					<li><strong>Apple Watch:</strong> הוא מציג את ה-tafs שלכם ואת הדפים שלהם בלי לשמור אותם. הוא שומר את תיבת הדואר הנכנס שלכם, בקובץ שהוא לא יכול לקרוא כשהוא נעול: כל קריאה מעוכבת כשם ה-taf שלה ומה היא מבקשת, לעולם לא סכום, ואת תשובות Coach למה ששלחתם מהשעון, כטקסט. אם אתם מתנתקים בשעון, הוא שומר גם שעשיתם זאת, עד שתיכנסו שוב בשעון. מעבר לכך הוא לא שומר דבר אלא אם יש לשעון קוד גישה. תיבת הדואר הנכנס נמחקת כשאתם מתנתקים בשעון או שה-iPhone שלכם מתנתק, או בפעם הבאה שהאפליקציה נפתחת או נסגרת ללא קוד גישה. הוא לא מקליט, וההתראות היחידות שהוא מציג הן של ה-iPhone שלכם. כדי ששיחה תיפתח מיד, הוא שומר גם את 30 ההודעות האחרונות מכל אחת מעד 20 שיחות שפתחתם בו, של Coach ושל ה-tafs שלכם, כטקסט בלבד ולעולם לא סכום, נעולות כמו תיבת הדואר הנכנס; הן נמחקות כשתיבת הדואר הנכנס נמחקת, וכששיחה לא נפתחה 30 יום. אם אתה שומר הודעה ל-Coach לאחר כך, הוא שומר גם את ההודעה האחת הזו, כטקסט, בקובץ משלה, נעול כמו של תיבת הדואר, ושולח אותה כשה-iPhone שלך חוזר. היא נמחקת אחרי שליחה, כשאתה מוחק אותה, כשאתה או ה-iPhone שלך מתנתקים, או אם לשעון כבר אין קוד.</li>
					<li><strong>Wear OS:</strong> הוא מציג את הדוא"ל של החשבון ואת יומן היום בלי לשמור אותם. כדי שייפתח מיד, הוא שומר, מוצפן, את מספר הפריטים שמחכים לכם, ואת שם כל taf והאם הוא נעצר או מושהה: לעולם לא סכום, פרטי קריאה מעוכבת או שיחה של taf. זה נמחק כשאתם מתנתקים, כשהשעון ננעל או יורד מפרק היד, ולאחר 24 שעות. הוא שומר את תיבת הדואר הנכנס שלכם, שבה כל שורה היא שם של taf ומה שהוא אומר, לעולם לא סכום, והודעה אחת ששמורה למועד מאוחר, כטקסט. התנתקות, בשעון או בטלפון, מוחקת את כולם. עבור האריח שלו הוא שומר גם את מספר הפריטים שמחכים לכם, שמוצג רק כשהשעון פתוח, ונמחק כשאתם מתנתקים, או בפעם הבאה שהאריח מוצג כשהשעון נעול או ללא נעילת מסך. אחרי שאתם מתנתקים בשעון הוא שומר הערה שעשיתם זאת, עד שתיכנסו שוב. תיבת הדואר הנכנס נמחקת גם בפעם הבאה שהאפליקציה נפתחת או נסגרת כשהשעון נעול או ללא נעילת מסך. הודעה ששמורה למועד מאוחר נשארת עד שתשלחו או תמחקו אותה, כי ביקשתם לשלוח אותה. אם שירות הדיבור של השעון נעצר לפני שסיימתם, השעון שולח את ההקלטה לטלפון שלכם, שהופך אותה לטקסט בטלפון עצמו, לעולם לא בשרת. ההקלטה נמחקת משניהם, כשהטקסט חוזר או שאתם מבטלים, ולאחר 2 דקות לכל היותר. רק הטקסט ממשיך ל-Coach או ל-taf שלכם. תוצאה של taf יכולה להישאר בהתראות השעון עד שתסגרו אותה או תתנתקו בשעון. כדי ששיחה תיפתח מיד, הוא שומר גם את 30 ההודעות האחרונות מכל אחת מעד 20 שיחות שפתחתם בו, של Coach ושל ה-tafs שלכם, כטקסט בלבד ולעולם לא סכום, מוצפנות; הן נמחקות כשאתם מתנתקים, בשעון או בטלפון, וכששיחה לא נפתחה 30 יום, ושעון בלי נעילת מסך לא שומר אף אחת. הודעה שנשמרה לאחר כך נמחקת גם אם לשעון כבר אין נעילת מסך.</li>
					<li><strong>Passkeys:</strong> כשאתם מאשרים עם passkey במחשב, כמו Windows Hello או מפתח אבטחה, הפנים, טביעת האצבע או ה-PIN שלכם נשארים במערכת של המחשב עצמו. KIFF שומרת את המפתח הציבורי של ה-passkey, את המזהה שלו, מונה ושם, לעולם לא דבר סודי, ודוחה passkey שמסתנכרן למכשירים אחרים.</li>
					<li><strong>התראות:</strong> בטלפון, בטאבלט או ב-Mac שמריץ את אפליקציית ה-iPad, כשאתם מפעילים אותן, אנו שומרים את אסימון ה-push של המכשיר עם מזהה האדם שלכם ב-KIFF ואת השפה שהאפליקציה הציגה. התראה עוברת דרך Apple או Google עם איזה taf ומה הוא רוצה בלבד, ובהתראת דלת גם שם או כתובת דוא"ל של מי שכתב: לעולם לא סכום או פרטי בקשה. האפליקציה מוסיפה אותם במכשיר עצמו, מ-KIFF, ולכן התראה בטלפון לא נעול יכולה להציג סכום, בית עסק או אדם. בטלפון Android נעול היא מציגה רק “taf זקוק לך”, וכך גם ב-iPhone נעול, אלא אם הגדרתם לתצוגות המקדימות שלו להופיע תמיד. במחשב Windows, במחשב Linux או ב-Mac עם אפליקציית macOS 12, ההתראות נוצרות בידי האפליקציה עצמה בזמן שהיא פועלת, ללא אסימון push ובלי שום חברה אחרת. ב-Windows וב-Linux הן מציגות איזה taf, מה הוא רוצה לעשות, הסכום, למה ועד מתי; באפליקציית macOS 12 הן מציגות את הניסוח של KIFF לקריאה, לאחר שתפעילו אותן, ומסך נעול מציג מה שהגדרת התצוגה המקדימה של ה-Mac מתירה. ב-Windows הן כבויות עד שתפעילו אותן, ומציגות רק “taf זקוק לך” כשהמסך נעול. התראה שהוצגה לפני נעילת המסך שומרת את פרטיה ברשימת ההתראות של Windows. ב-Linux הן פועלות עד שתכבו אותן, ומה שמסך נעול מציג תלוי בשולחן העבודה שלכם. טלפון שמעביר עדכונים לשעון שומר את אסימון ה-push שלו רשום גם כשההתראות כבויות, רק כדי שהודעת push שקטה תוכל להעיר אותו ולהעביר עדכונים לשעון; ההודעה הזו אינה מכילה מילים ואינה מציגה דבר.</li>
					<li><strong>שפה:</strong> שירות tafs שומר את שפת החשבון, ממי שדיבר לאחרונה עם Coach, עד שלושה חודשים, כדי שדוחות של taf יגיעו בה.</li>
					<li><strong>הכלים שלכם:</strong> כשאתם מחברים כלי, אתם נכנסים אצל הספק של הכלי עצמו. עבור אפליקציה ש-planque נכנסת אליה בעצמה, כמו Stripe, או מפתח שאתם נותנים, planque שומרת את האסימון או המפתח עבור החברה שלכם, מוצפן. עבור חיבור מנוהל, Composio, שירות החיבור ש-planque עובדת איתו, מחזיק את ההתחברות, ו-planque שומרת רק את רשומת החיבור ואת הכלים שאישרתם (ראו <a href="#google">מידע משתמש של Google</a>). רשומת חיבור יכולה לכלול את החשבון שאליו נכנסו (שמו או הדוא"ל שלו), כדי שהאפליקציה תוכל להראות לכם איזה הוא. KIFF משתמשת בחיבורים מנוהלים רק עבור האפליקציות הנקובות ב-<a href="/subprocessors#composio">/subprocessors</a> (באנגלית).</li>
					<li><strong>הדפדפן שלך (Chrome):</strong> כשאתה מצמיד את תוסף tafs לטלפון שלך, taf יכול לעבוד בפרופיל Chrome שהצמדת, רק באתרים שהחיבור שלו מפרט. הוא פותח לשוניות משלו בקבוצת לשוניות שאתה יכול לראות, להשהות או לעצור, והוא נעצר כשאתה נוגע באחת מהן. taf שאתה מפעיל מהחלונית הצדדית של התוסף עובד במקום זאת בלשונית שאתה נמצא בה באותו חלון, אם היא באחד מהאתרים של החיבור שלו: הלשונית מצטרפת לקבוצה שלו ומטופלת כאחת משלו, והיא נשארת פתוחה כשה-taf נעצר. הוא מצטרף ללשונית הזו רק כשהדף הזה הוא הראשון שהוא צריך. שם הוא יכול ללחוץ ולהקליד, רק באתרים שלו. בלשונית הזו הוא קורא את הדף במקומו, וכל דף אחר הוא פותח בלשונית משלו; רק צעד שהוא עושה שם, כמו לחיצה, יכול להעביר את הלשונית שלך, ורק בתוך האתרים שלו. הוא קורא את הדפים האלה כטקסט ושדות טופס, כשהשדות של סיסמה, כרטיס וקוד מוסרים, לעולם לא את הלשוניות האחרות שלך או אתרים אחרים. הטקסט הזה עובר לספק הבינה המלאכותית שלנו כחלק מההרצה, ונשמר עם ההרצה כמו התוצאה של כל כלי. כל צעד נרשם ביומן עם האתר ושם השדה, לעולם לא מה שהוקלד בשדה סודי. על כל שינוי שtaf עושה, KIFF שומר את הדף לפני ואחרי, כטקסט כשהשדות האלה מוסרים, לכל היותר 30 ימים, ומוחק אותו מוקדם יותר כשאתה מנתק או מוחק את החשבון. הדפים האלה יכולים להציג פרטים של אנשים אחרים, כמו הלקוחות שלך; KIFF מעבד אותם בשבילך, כמעבד. התוסף שומר במחשב שלך רק את המפתח שלו, אף פעם לא את הסיסמאות שלך: בדף כניסה, ה-taf עוצר ומבקש ממך להיכנס בעצמך, בכרטיסייה שלך. אפשר לדבר עם Coach גם מהחלונית הצדדית של התוסף. Coach קורא את הדף רק אחרי שאפשרתם לו זאת בתוסף, בהסכמה נפרדת שאפשר לבטל שם, ותמיד אפשר לשלוח הודעה בלי הדף. כשאתה שולח לו משם הודעה, הדף שבחזית נשלח עם ההודעה, רק הטקסט הגלוי שלו, אף פעם לא מה שהקלדת, חוץ מאתר של בנק, תשלומים, דואר או בריאות או אתר שכיבית עבור Coach. ערכי שדות וסיסמאות אינם נקראים; מספרי כרטיסים מקוצרים לארבע הספרות האחרונות שלהם; מפתחות וסודות מסומנים מוסתרים. גם קודים חד־פעמיים שמכונים כך באנגלית, בצרפתית, בספרדית או בגרמנית בטקסט הדף מוסתרים. הוא נשלח לספק הבינה המלאכותית שלנו רק עבור אותה הודעה; tafs שומרת את הדף רק עד שהתשובה מוכנה, ושומרת את שם האתר עם הצ'אט שלך, מוצג כ„קורא:”, למשך 30 יום. התשובה של Coach עשויה לצטט את הדף ונשמרת עם הצ'אט שלך כמו כל תשובה. כך גם בהודעה שאתה שולח שם ל-taf, באותה הסכמה, אבל רק באחד מהאתרים של אותו taf: במקום אחר לא נקרא דבר, באותו תור ה-taf רק קורא, והתשובה שלו עשויה לצטט מהדף. אצל taf, הטקסט של הדף נשמר עם ההרצה שלו רק עד שההרצה מסתיימת. החלונית הצדדית מציגה את הצ'אטים שהתחילו ב-Chrome הזה מאז שהצמדת אותו; שאר הצ'אטים שלך נשארים בטלפון ובמכשירים האחרים שלך. כש-taf עובד ב-Chrome הזה בשביל הודעה ששלחת ממכשיר אחר, החלונית מציגה גם את ההרצה הזו: ההודעה, השלבים שלה והתשובה שלה, אף פעם לא את שאר הצ'אט, עד שתמחק את הצ'אט הזה, תבטל את ההצמדה של ה-Chrome או תעביר את ה-taf ל-Chrome אחר. אפשר גם לצרף שם קבצים להודעה: כמו קבצים שמצורפים באפליקציות של tafs, הם נשלחים לספק הבינה המלאכותית שלנו עם אותה הודעה ונשמרים איתה 30 יום, או פחות אם הצ'אט מוסר (קובץ שאף הודעה לא משתמשת בו, כשעה), ורק מי שצירף קובץ יכול לפתוח אותו. ניתוק ההצמדה או הסרת ההתקנה מוחקים את מה שהתוסף שומר. taf אף פעם לא משלם בלי האישור שלך בטלפון. לכל צעד שפועל (לחיצה, הקלדה, שליחה), כולל צעד שאישרת, הוא שומר גם צילום מסך אחד של הדף, שצולם רגע לפני הפעולה, לתיעוד; אף פעם לא לדף שהוא רק קורא, אף פעם לא באתר של בנק, ארנק, מנהל סיסמאות, תשלומים, בריאות או ממשלה, ושדות הסיסמה, הכרטיס והקוד מוסתרים לפני הצילום. גם טקסט שנראה כמו מספר כרטיס או מפתח מושחר, אבל משהו שנכתב בדרך אחרת עדיין עשוי להופיע. צילומי המסך נשמרים באחסון מוצפן, קשורים לצעד הזה, במשך 30 ימים, ואז נמחקים אוטומטית, או מוקדם יותר כשאתה מנתק את החיבור, מבטל את הצימוד של ה-Chrome הזה או מוחק את החשבון שלך, והם אף פעם לא עוברים לספק הבינה המלאכותית שלנו. אתה רואה כל אחד מהם מתחת לצעד שלו בפעילות של ה-taf.</li>
					<li><strong>העבודה של ה-tafs שלכם:</strong> ההרצות, השיחות, הדוחות, הערות הזיכרון והקבצים שמוסרים כל ה-tafs, מוחזקים כמעבד. כל מי שבחשבון שלכם יכול לראות את הקבצים שה-tafs שלכם מוסרים.</li>
					<li><strong>דלתות:</strong> כשאתם פותחים דלת כדי שאנשים יוכלו לכתוב ל-taf באימייל, ב-Slack או ב-Telegram, שירות tafs שומר כל שולח שאתם מצמדים, לפי כתובת האימייל שלו, מזהה החבר שלו ב-Slack או מזהה המשתמש שלו ב-Telegram (מספר טלפון לדלת WhatsApp), עם השם שאתם נותנים לו, עד שתסירו את הדלת או את ה-taf. הודעה ממישהו שלא הצמדתם ממתינה לכם כדפיקה, עם מי כתב אותה ומה היא אומרת, עד 30 ימים אחרי האחרונה. הודעה של שולח מוצמד נכנסת לשיחה של ה-taf ונשמרת כמו שאר השיחה. Slack ו-Telegram מעבירים את ההודעות לפי התנאים שלהם.</li>
					<li><strong>רכישות:</strong> Solo וחבילות קרדיטים נמכרות בידי Apple דרך App Store, או בידי Google דרך החיוב של Google Play. הן מודיעות לנו מה נקנה, עבור איזה חשבון KIFF (מזהה אקראי), מתי, ואת מזהי העסקה או ההזמנה שלהן. הן אינן מוסרות לנו את ה-Apple ID או חשבון Google, השם, כתובת הדוא"ל או הכרטיס שלכם.</li>
				</ul>
				<p>באפליקציה אין כלי אנליטיקה או מעקב פרסומי.</p>
			</section>
			<section id="ai">
				<h2>5. הבינה המלאכותית ב-tafs</h2>
				<p>tafs משתמשת בבינה המלאכותית Claude של Anthropic עבור Coach וה-tafs שלכם. Anthropic, או אחד מספקי הענן שבדף מעבדי המשנה שלנו, מפעילים אותה עבורנו. הדף הזה מציין מי ואיפה. האפליקציה שואלת אתכם לפני שדבר נשלח אליה.</p>
				<ul>
					<li>מה שנשלח אליה: מה שאתם כותבים ל-Coach ול-tafs שלכם, הקבצים שאתם מצרפים, מה שהאפליקציות המחוברות שלכם מחזירות ל-taf בזמן שהוא עובד, ומה שמופיע במסך שלכם בזמן ש-Coach עוזר לכם באפליקציה.</li>
					<li>מ-Chrome: הדף שבחזית, כשאתה כותב ל-Coach בחלונית הצדדית של התוסף, אחרי שאפשרתם ל-Coach לקרוא שם דפים. וגם כשאתה כותב שם ל-taf, באחד מהאתרים שלו.</li>
					<li>מה שלעולם לא נשלח: הסיסמאות והמפתחות שהאפליקציות המחוברות שלכם משתמשות בהם, או טביעת האצבע שלכם.</li>
					<li>החברה שמפעילה אותה משתמשת בו כדי לענות ומוחקת אותו תוך 30 יום, אלא אם סומן כמפר את כללי השימוש שלה או שהחוק מחייב לשמור אותו.</li>
					<li>דבר אינו נשלח עד שתתירו זאת. אפשר לבטל את ההסכמה ב-Account.</li>
				</ul>
				<p>כשאתם מבטלים את ההסכמה, Coach וה-tafs שלכם מפסיקים לענות לכם, ו-taf שההרצות שלו נשענות על הסכמתכם מושהה. tafs שומרת רישום של כל הסכמה שאתם נותנים או מבטלים, עם המועד והגרסה של נוסחה, במשך 10 שנים מהשינוי האחרון בה, כדי להראות למה הסכמתם; מחיקת החשבון מוחקת אותו מוקדם יותר. ל<a href="/he/privacy#ai-in-tafs">מדיניות הפרטיות של KIFF</a> יש את הפרטים.</p>
			</section>
			@tafsPrivacyGoogleHE()
			<section id="sharing">
				<h2>7. מי עוד מקבל מידע</h2>
				<p>איננו מוכרים את המידע האישי שלכם, ואיננו משתפים אותו לצורכי פרסום.</p>
				<p>עבור tafs אנו משתמשים בחברות האלה: Amazon Web Services (אחסון, כולל המאגר של tafs והחיבורים של planque), Clerk (התחברות לחשבונות KIFF), Anthropic (מודל הבינה המלאכותית, מופעל על ידי Anthropic, Amazon Web Services, Google Cloud או Microsoft Azure), Composio (ההתחברויות של חיבורים מנוהלים, והקריאות ש-planque מבקשת ממנה לבצע), Apple (התראות push), Google (התראות push ב-Android, והחיוב של Google Play), ו-Resend (דלת הדוא"ל של taf). הרשימה הרשמית והעדכנית, עם מה שכל אחת נוגעת בו ואיפה, נמצאת ב-<a href="/subprocessors">/subprocessors</a> (באנגלית).</p>
				<p>חלקן נמצאות מחוץ לאזור הכלכלי האירופי, בעיקר בארצות הברית. <a href="/he/privacy#transfers">מדיניות הפרטיות של KIFF</a> אומרת כיצד ההעברות האלה מוגנות.</p>
				<p><strong>המדינה שלכם.</strong> חוקים של מדינות מסוימות דורשים יותר ממה שהמדיניות הזו אומרת. מה שהם מוסיפים, באנגלית ובשפת המדינה, נמצא ב<a href="/privacy/countries">המדינה שלכם</a> (באנגלית).</p>
			</section>
			<section id="retention">
				<h2>8. כמה זמן אנו שומרים</h2>
				<ul>
					<li>מה שהכלים שלכם מחזירים ל-taf: רק עד שההרצה מסתיימת. בשיחה, מה שרק נקרא נשמר מוצפן להודעותיה הבאות, בשימוש עד שהשיחה הייתה לא פעילה שעה ולכל היותר ארבע שעות אחרי הקריאה, ואז נמחק אוטומטית, בתוך כמה ימים.</li>
					<li>הרצות ושיחות של taf, עם סיכום השיחה: 30 ימים. הערות הזיכרון שלו: עד שה-taf מוסר. אפשר למחוק מוקדם יותר שיחה שלכם עם Coach: ההודעות שלה והקבצים שהוספתם נמחקים מיד, ואילו הרישום שכל אחת מההרצות שלה התקיימה, מתי ובכמה עלתה נשאר במשך אותם 30 ימים. אם תדווח על תשובה, KIFF שומרת את התשובה, את הסיבה ואת ההערה שלך 180 ימים, גם אם תמחק את הצ'אט; מחיקת החשבון מוחקת אותם מוקדם יותר. KIFF גם שולחת אותם בדוא"ל לצוות שקורא דיווחים, ושם הדוא"ל נשמר כמו דואר התמיכה של KIFF.</li>
					<li>הערות קצרות של Coach לתשובה הבאה שלו, כמו מדוע לא ניתן היה ליצור חיבור בשיחה, או שכרטיס אושר: עד שהתשובה הזו לוקחת אותן, לכל היותר 7 ימים; אחר כך, כחלק מאותה שיחה, כל עוד השיחה נשמרת. עותק נשמר 24 שעות כדי שהודעה שנשלחה שוב תקבל את אותה הערה. הערה של שיחה משמשת רק באותה שיחה.</li>
					<li>קבצים שאתם מצרפים בשיחה: עם ההודעה שאליה הם מצורפים, 30 ימים, או מוקדם יותר אם השיחה מוסרת, ובכל מקרה בתוך 38 ימים. קובץ שאף הודעה אינה משתמשת בו מוסר כשעה אחרי שהעליתם אותו. מחיקת החשבון מוחקת אותם.</li>
					<li>קבצים שה-tafs שלכם מוסרים: 30 ימים מהרגע שההרצה יצרה אותם, ואז נמחקים אוטומטית בתוך יום. כל מי שבחשבון שלכם יכול למחוק אחד מוקדם יותר עם Delete now: הקובץ עצמו נעלם מיד, בלי שנשמר עותק; שמו, גודלו וה-taf וההרצה שיצרו אותו עשויים להישאר בעותקים המוצפנים בנקודות זמן של המאגר של tafs עד 35 ימים, ומשמשים רק לשחזורו לאחר כשל. הסרת taf או מחיקת החשבון מוחקות את הקבצים שלו. שיתוף קובץ שולח את הקובץ עצמו, והעותק ששיתפתם נשאר אצל האפליקציה שאליה שיתפתם. כדי להוריד קובץ, אנו יוצרים קישור לחבר מחובר בחשבון שלכם שמפסיק לפעול אחרי דקה; איננו יוצרים אליו קישור אחר.</li>
					<li>מה שכלי החזיר, ברשומה של planque על כל קריאה: 24 שעות. אחר כך הרשומה שומרת רק אם הקריאה נשלחה, כדי שלעולם לא תישלח פעמיים.</li>
					<li>אסימון או מפתח של חיבור ב-planque, או ההתחברות של חיבור מנוהל ב-Composio: עד שתנתקו אותו. אם חיבור אחר שלכם עשוי להשתמש באותו חשבון אצל אותו ספק, הוא נשמר, ללא שימוש, עד שגם אותו תנתקו, ואז נשלל. רשומת האישורים שלו: עד שהחשבון מסתיים.</li>
					<li>אסימון push של מכשיר: עד שתתנתקו מהאפליקציה, תסירו את המכשיר, או ש-Apple או Google מדווחות שהאסימון נעלם. המפתח הציבורי של מכשיר, שמו, הפלטפורמה והתאריכים שלו: כל עוד אתם משתמשים בו; אחרי שאתם מנתקים אותו, הוא מסומן כמוסר ונשמר עד שהחשבון נמחק, כדי ש-KIFF תוכל לדחות תשובה מאוחרת ממנו ולהראות איזה מכשיר חתם על תשובה קודמת. המפתח הציבורי, המזהה והשם של passkey: כשל המכשיר שלו. הפעלה במחשב: עד 90 ימים, או עד שתתנתקו.</li>
					<li>החשבון שלכם: עד שהוא נמחק. יומני שירות: 30 ימים. המאגרים של tafs ו-planque שומרים עותקים מוצפנים בנקודות זמן ל-35 ימים, המשמשים רק לשחזור מאגר לאחר כשל.</li>
				</ul>
				<p>כל השאר נמצא ב<a href="/he/privacy#retention">סעיף השמירה של KIFF</a>.</p>
			</section>
			<section id="lawful-bases">
				<h2>9. בסיסים חוקיים</h2>
				<p>ביצוע חוזה, להפעלת החשבון וה-tafs שלכם. אינטרסים לגיטימיים, לאבטחה, מניעת הונאה וגילוי ניצול לרעה. הסכמה, לבינה המלאכותית ב-tafs (<a href="#ai">סעיף 5</a>). חובה חוקית, לרישומי מס. ל<a href="/he/privacy#lawful-bases">מדיניות הפרטיות של KIFF</a> יש את הפרטים.</p>
			</section>
			<section id="rights">
				<h2>10. הזכויות שלכם</h2>
				<p>לפי GDPR אתם יכולים לבקש גישה למידע שלכם, תיקונו, מחיקתו, הגבלתו או עותק נייד, להתנגד לעיבוד המבוסס על אינטרסים לגיטימיים, ולבטל הסכמה. שלחו דוא"ל אל <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>; אנו משיבים ללא דיחוי מיותר ולכל המאוחר בתוך חודש; בבקשה מורכבת ייתכן שנזדקק לחודשיים נוספים, ונודיע לכם על כך בתוך החודש הראשון. באפליקציה, Account ← Export my chats מוריד את השיחות וההערות שלכם.</p>
				<p>כדי למחוק את חשבון ה-tafs שלכם, פתחו את האפליקציה, עברו אל Account והקישו על <em>Delete account</em>, ואז אשרו. אי אפשר לבטל זאת. <a href="/he/privacy#delete-account">מדיניות הפרטיות של KIFF</a> אומרת מה נמחק ומתי, וכיצד לבקש בדוא"ל.</p>
				<p>אתם יכולים להגיש תלונה ל<a href="https://www.aki.ee/en" target="_blank" rel="noopener">רשות הגנת המידע האסטונית (Andmekaitse Inspektsioon)</a>, או לרשות המפקחת במקום מגוריכם.</p>
				<p><strong>המדינה שלכם.</strong> חוקים של מדינות מסוימות דורשים יותר ממה שהמדיניות הזו אומרת. מה שהם מוסיפים, באנגלית ובשפת המדינה, נמצא ב<a href="/privacy/countries">המדינה שלכם</a> (באנגלית).</p>
			</section>
			<section id="more">
				<h2>11. אבטחה, ילדים ושינויים</h2>
				<p>אמצעי האבטחה שלנו נמצאים ב-<a href="/security">/security</a> (באנגלית). tafs אינה מיועדת לילדים, ואיננו אוספים ביודעין מידע אישי מילדים מתחת לגיל 16. אנו משנים מדיניות זו באופן ש<a href="/he/privacy#changes">מדיניות הפרטיות של KIFF</a> קובעת עבור עצמה.</p>
			</section>
			<section id="contact">
				<h2>12. צרו קשר</h2>
				<p>שאלות ובקשות בנושא פרטיות: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>. הודעות משפטיות רשמיות: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>. התנאים של האפליקציה עצמה נמצאים ב-<a href="/he/tafs/terms">/tafs/terms</a>.</p>
			</section>
		</article>
	}
}

// tafsPrivacyGoogle is what tafs does with the data it receives from Google,
// for Google's review of tafs's sign-in, with the Limited Use statement in
// Google's own words.
templ tafsPrivacyGoogleHE() {
	<section id="google">
		<h2>6. מידע משתמש של Google</h2>
		if len(googleManaged()) == 0 && len(googleInHouse("he")) > 0 {
			<p>כשאתם מבקשים זאת, tafs מחברת taf לחשבון Google שלכם, למשל ל-Google Sheets או ל-Google Calendar שהמשימה שלו משתמשת בהם, ב-Connect apps של האפליקציה. סעיף זה אומר מה tafs עושה עם המידע שהיא מקבלת מ-Google.</p>
		} else {
			<p>כשאתם מבקשים זאת, tafs מחברת taf לחשבון Google שלכם, למשל ל-Gmail שלכם, או ל-Google Calendar או ל-Google Sheets שהמשימה שלו משתמשת בהם, ב-Connect apps של האפליקציה. סעיף זה אומר מה tafs עושה עם המידע שהיא מקבלת מ-Google.</p>
		}
		<ul>
			if len(googleManaged()) == 0 && len(googleInHouse("he")) > 0 {
				<li><strong>מה היא קוראת וכותבת:</strong> מה שהמשימה של ה-taf צריכה: הגיליונות האלקטרוניים שהוא מעדכן, או האירועים ביומנים שהוא מטפל בהם. היא משנה אותם רק במקום שהכרטיס של ה-taf מתיר, וכל דבר מעבר למגבלות הכרטיס ממתין לאישורכם.</li>
			} else {
				<li><strong>מה היא קוראת וכותבת:</strong> מה שהמשימה של ה-taf צריכה. ב-Gmail שלכם היא קוראת את ההודעות והשרשורים שלכם כדי למצוא את אלה שצריכים מענה, וכותבת טיוטות; היא שולחת דואר רק במקום שהכרטיס של ה-taf מתיר. ב-Google Calendar וב-Google Sheets היא קוראת את האירועים ביומנים שהיא מטפלת בהם, או את הגיליונות שהיא מעדכנת, ומשנה אותם רק במקום שהכרטיס של ה-taf מתיר.
					if googleListed("Google Tasks") {
						ב-Google Tasks היא קוראת את רשימות המשימות שהיא מטפלת בהן, ומוסיפה, משלימה, מעבירה או מוחקת משימות רק במקום שהכרטיס של ה-taf מתיר.
					}
					כל דבר מעבר למגבלות הכרטיס ממתין לאישורכם.</li>
			}
			<li><strong>למה:</strong> רק כדי לבצע את המשימה שהגדרתם ל-taf הזה, ולהראות לכם לאיזה חשבון Google הוא מחובר: כתובת הדוא"ל שלו, שנשמרת עם החיבור עד שתנתקו אותו.</li>
			if len(googleManaged()) > 0 || len(googleInHouse("he")) > 0 {
				<li>
					<strong>כיצד כל אפליקציית Google מתחברת:</strong>
					<ul>
						if len(googleManaged()) > 0 {
							<li>דרך שותף ההתחברות שלנו, הרשום ב-<a href="/subprocessors">/subprocessors</a> (באנגלית): { appList(googleManaged()) }.</li>
						}
						if len(googleInHouse("he")) > 0 {
							<li>דרך ההתחברות העצמית של tafs ל-Google, בלי חברה אחרת באמצע: { appList(googleInHouseNames()) }.</li>
						}
					</ul>
					if googleBoth() {
						אפליקציה שנקובה תחת שתי הדרכים מתחברת בדרך אחת או באחרת, בהתאם לחשבון שלכם. דף ההתחברות של Google עצמה מראה איזו מהן אתם מתירים.
					}
				</li>
			}
			if googleBoth() {
				<li>
					<strong>מה אתם מתירים:</strong> אתם נכנסים בדף של Google עצמה ובוחרים מה להתיר.
					<ul>
						<li><strong>דרך שותף ההתחברות שלנו:</strong> tafs מבקשת רק את הגישה שהכלים של ה-taf צריכים. אם הגישה הצרה הזו אינה אפשרית, היא מבקשת את הגישה הרגילה של האפליקציה, ואומרת זאת לפני שאתם נכנסים. אם הגישה הרגילה הייתה כוללת מידע אישי שה-taf אינו משתמש בו, tafs אינה מתחברת.</li>
						<li><strong>דרך ההתחברות העצמית של tafs ל-Google:</strong> ההתחברות מבקשת את כל הגישה המפורטת להלן עבור אותה אפליקציה בבת אחת, גם כש-taf רק קורא.</li>
					</ul>
				</li>
			} else if len(googleInHouse("he")) > 0 {
				<li><strong>מה אתם מתירים:</strong> אתם נכנסים בדף של Google עצמה ובוחרים מה להתיר. ההתחברות מבקשת את כל הגישה המפורטת להלן עבור אותה אפליקציה בבת אחת, גם כש-taf רק קורא.</li>
			} else {
				<li><strong>מה אתם מתירים:</strong> אתם נכנסים בדף של Google עצמה ובוחרים מה להתיר. tafs מבקשת רק את הגישה שהכלים של ה-taf צריכים. אם הגישה הצרה הזו אינה אפשרית, היא מבקשת את הגישה הרגילה של האפליקציה, ואומרת זאת לפני שאתם נכנסים. אם הגישה הרגילה הייתה כוללת מידע אישי שה-taf אינו משתמש בו, tafs אינה מתחברת.</li>
			}
			<li><strong>כיצד taf משתמש בה:</strong> taf משתמש רק בכלים שאושרו בכרטיס שלו. כל קריאה נבדקת מול היתר לאותו כלי ולאותם ארגומנטים לפני שמשהו נשלח, וקריאה מחוץ לגישה שנתתם נדחית. אילו פעולות מבקשות את אישורכם בכל פעם נקבע בכרטיס.</li>
			if len(googleInHouse("he")) > 0 {
				<li>
					if googleBoth() {
						<strong>הגישה שההתחברות העצמית של tafs ל-Google מבקשת:</strong>
					} else {
						<strong>הגישה ש-tafs מבקשת:</strong>
					}
					<ul>
						for _, a := range googleInHouse("he") {
							<li>
								{ a.Name }
								<ul>
									for _, s := range a.Scopes {
										<li><code>{ s.ID }</code>: { s.What }</li>
									}
								</ul>
							</li>
						}
					</ul>
					ככל שההתחברות מתירה, ה-taf משתמש רק בכלים שבכרטיס שלו.
				</li>
			}
			if googleBoth() {
				<li>
					<strong>מי שומר את ההתחברות שלכם:</strong>
					<ul>
						<li><strong>דרך שותף ההתחברות שלנו:</strong> ההתחברות שלכם ל-Google נשמרת בידי שותף ההתחברות שלנו, הרשום ב-<a href="/subprocessors">/subprocessors</a> (באנגלית), ולעולם אינה ניתנת ל-taf או ל-planque. לא ה-taf ולא tafs רואים את הסיסמה שלכם או את האסימונים שלכם של Google. taf אחר שלכם שזקוק לאותה גישה משתמש שוב באותה התחברות, וכל taf משתמש רק בכלים שאישרתם עבורו.</li>
						<li><strong>דרך ההתחברות העצמית של tafs ל-Google:</strong> planque, שירות החיבור של tafs עצמה, שומרת את האסימון שלכם של Google עבור החברה שלכם, מוצפן ב-AWS KMS באיחוד האירופי (אירלנד), ומשתמשת בו רק כדי לבצע קריאה שהכרטיס של ה-taf מתיר. הוא לעולם אינו ניתן ל-taf, ולא ה-taf ולא מודל הבינה המלאכותית רואים את הסיסמה שלכם או את האסימונים שלכם של Google. taf אחר שלכם שזקוק לאותה גישה משתמש שוב באותה התחברות, וכל taf משתמש רק בכלים שאישרתם עבורו.</li>
					</ul>
				</li>
			} else if len(googleInHouse("he")) > 0 {
				<li><strong>מי שומר את ההתחברות שלכם:</strong> planque, שירות החיבור של tafs עצמה, שומרת את האסימון שלכם של Google עבור החברה שלכם, מוצפן ב-AWS KMS באיחוד האירופי (אירלנד), ומשתמשת בו רק כדי לבצע קריאה שהכרטיס של ה-taf מתיר. הוא לעולם אינו ניתן ל-taf, ולא ה-taf ולא מודל הבינה המלאכותית רואים את הסיסמה שלכם או את האסימונים שלכם של Google. taf אחר שלכם שזקוק לאותה גישה משתמש שוב באותה התחברות, וכל taf משתמש רק בכלים שאישרתם עבורו.</li>
			} else {
				<li><strong>מי שומר את ההתחברות שלכם:</strong> ההתחברות שלכם ל-Google נשמרת בידי שותף ההתחברות שלנו, הרשום ב-<a href="/subprocessors">/subprocessors</a> (באנגלית), ולעולם אינה ניתנת ל-taf או ל-planque. לא ה-taf ולא tafs רואים את הסיסמה שלכם או את האסימונים שלכם של Google. taf אחר שלכם שזקוק לאותה גישה משתמש שוב באותה התחברות, וכל taf משתמש רק בכלים שאישרתם עבורו.</li>
			}
			if googleBoth() {
				<li>
					<strong>מי עוד מקבל אותו:</strong> מה ש-taf קורא מ-Google עובר למודל הבינה המלאכותית שמפעיל את ה-taf, רק לאחר שתתירו זאת (ראו <a href="#ai">הבינה המלאכותית ב-tafs</a>), והוא שומר אותו עד 30 ימים לפי תנאי הספק שלו.
					<ul>
						<li><strong>דרך שותף ההתחברות שלנו:</strong> הוא עובר גם דרך שותף ההתחברות שלנו, שמבצע כל קריאה.</li>
						<li><strong>דרך ההתחברות העצמית של tafs ל-Google:</strong> planque קוראת ל-Google בעצמה, ולכן אף חברה אחרת אינה מבצעת את הקריאה או שומרת את ההתחברות שלכם.</li>
					</ul>
					שניהם רשומים ב-<a href="/subprocessors">/subprocessors</a> (באנגלית).
				</li>
			} else if len(googleInHouse("he")) > 0 {
				<li><strong>מי עוד מקבל אותו:</strong> מה ש-taf קורא מ-Google עובר למודל הבינה המלאכותית שמפעיל את ה-taf, רק לאחר שתתירו זאת (ראו <a href="#ai">הבינה המלאכותית ב-tafs</a>), והוא שומר אותו עד 30 ימים לפי תנאי הספק שלו. planque קוראת ל-Google בעצמה, ולכן אף חברה אחרת אינה מבצעת את הקריאה או שומרת את ההתחברות שלכם. הספק של מודל הבינה המלאכותית רשום ב-<a href="/subprocessors">/subprocessors</a> (באנגלית).</li>
			} else {
				<li><strong>מי עוד מקבל אותו:</strong> מה ש-taf קורא מ-Google עובר למודל הבינה המלאכותית שמפעיל את ה-taf, רק לאחר שתתירו זאת (ראו <a href="#ai">הבינה המלאכותית ב-tafs</a>), והוא שומר אותו עד 30 ימים לפי תנאי הספק שלו. הוא עובר גם דרך שותף ההתחברות שלנו, שמבצע כל קריאה. שניהם רשומים ב-<a href="/subprocessors">/subprocessors</a> (באנגלית).</li>
			}
			<li><strong>אימון בינה מלאכותית:</strong> מידע משתמש של Google אינו משמש לאימון מודלים של בינה מלאכותית.</li>
			<li><strong>תמונות:</strong> tafs אינה יוצרת או עורכת תמונות או וידאו: הבינה המלאכותית שלה כותבת טקסט. היא לעולם אינה משתמשת בממשקי API של Google או במידע משתמש של Google כדי ליצור, לערוך או לשתף תמונות אינטימיות של מישהו (תמונות אינטימיות ללא הסכמה, NCII), או כל תמונה אחרת של אדם.</li>
			if len(googleManaged()) == 0 && len(googleInHouse("he")) > 0 {
				<li><strong>כמה זמן, והיכן:</strong> הגיליונות האלקטרוניים והאירועים שלכם נשארים בחשבון Google שלכם. במאגר של tafs עצמה, מה שכלי מחזיר נשמר רק עד שההרצה של ה-taf מסתיימת. planque, שמעבירה כל קריאה הלאה, שומרת את מה ש-Google מחזירה 24 שעות, כך שקריאה חוזרת מקבלת את אותה תשובה ולעולם אינה נשלחת פעמיים; אחר כך היא שומרת רק אם הקריאה נשלחה. בשיחה, מה שרק נקרא נשמר מוצפן, בשימוש עד שהשיחה הייתה לא פעילה שעה ולכל היותר ארבע שעות אחרי הקריאה, ואז נמחק אוטומטית, בתוך כמה ימים. רשומת הרצה והשיחה שלה נשמרות 30 ימים, והערות של taf עד שתסירו את ה-taf (ראו <a href="#retention">כמה זמן אנו שומרים</a>).</li>
			} else {
				<li><strong>כמה זמן, והיכן:</strong> הטיוטות, האירועים והגיליונות האלקטרוניים שלכם נשארים בחשבון Google שלכם. במאגר של tafs עצמה, מה שכלי מחזיר נשמר רק עד שההרצה של ה-taf מסתיימת. planque, שמעבירה כל קריאה הלאה, שומרת את מה ש-Google מחזירה 24 שעות, כך שקריאה חוזרת מקבלת את אותה תשובה ולעולם אינה נשלחת פעמיים; אחר כך היא שומרת רק אם הקריאה נשלחה. בשיחה, מה שרק נקרא נשמר מוצפן, בשימוש עד שהשיחה הייתה לא פעילה שעה ולכל היותר ארבע שעות אחרי הקריאה, ואז נמחק אוטומטית, בתוך כמה ימים. רשומת הרצה והשיחה שלה נשמרות 30 ימים, והערות של taf עד שתסירו את ה-taf (ראו <a href="#retention">כמה זמן אנו שומרים</a>).</li>
			}
			<li>
				<strong>עצירה:</strong>
				<ul>
					<li>נתקו את Google באפליקציה, ב-Connect apps או בלשונית הכרטיס של ה-taf. כלי ה-Google שלו נעצרים מיד, ו-tafs מבקשת מ-Google לשלול את ההתחברות מיד; זה עשוי להסתיים קצת מאוחר יותר.</li>
					<li>הסירו taf, והחיבורים שלו מסתיימים איתו. התחברות ל-Google ש-taf אחר שלכם עדיין משתמש בה נשארת עד שהאחרון מהם נעלם.</li>
					<li>הסירו את הגישה של tafs בכל עת בחשבון Google שלכם, בכתובת <a href="https://myaccount.google.com/permissions">myaccount.google.com/permissions</a>. ה-tafs שלכם מפסיקים להגיע ל-Google, והאפליקציה אומרת לכם שחיבור Google מנותק.</li>
					<li>מחקו את החשבון שלכם: ה-tafs, השיחות, ההערות, הקבצים והחיבורים שלו נמחקים מיד, ומהעותקים שלהם בנקודות זמן בתוך 35 ימים, והאסימונים שלו של Google נשללים במקום ש-Google מאפשרת.</li>
				</ul>
			</li>
		</ul>
		<p lang="en">tafs's use and transfer to any other app of information received from Google APIs will adhere to <a href="https://developers.google.com/terms/api-services-user-data-policy">Google API Services User Data Policy</a>, including the Limited Use requirements.</p>
