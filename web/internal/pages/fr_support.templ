package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// SupportFR is the support page (/support) in French, at /fr/support.
// It is a translation of Support: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English
// page governs. Change the English page first, then this one.
templ SupportFR() {
	@components.LayoutSite("KIFF — assistance", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@supportHeadFR()
			@supportWriteFR()
			@supportStatusFR()
			@supportTafsFR()
			@supportDataFR()
			@supportSecurityFR()
			if computerAppReleased() {
				@supportComputerFR()
			}
		</article>
	}
}

templ supportHeadFR() {
	<header class="legal-head">
		<p class="legal-badge">Assistance</p>
		<h1>Assistance</h1>
		<p class="legal-meta">
			<strong>Dernière mise à jour :</strong> 13 novembre 2026.
		</p>
		<p class="legal-disclaimer">
			Pour KIFF et pour tafs, l'app de KIFF pour iPhone, iPad et
			Android. Les deux sont exploités par Kiff Agents OÜ, Tallinn,
			Estonie.
		</p>
	</header>
}

templ supportWriteFR() {
	<section id="write">
		<h2>1. Écrivez-nous</h2>
		<p>
			Écrivez à <a href="mailto:hello@kiff.dev">hello@kiff.dev</a>
			depuis l'adresse e-mail de votre compte et dites-nous ce qui
			s'est passé. Une personne vous répond, dans les délais de
			réponse fixés par
			l'<a href="/legal/sla#support">accord de niveau de service</a> { components.InEnglish("fr") }
			(§5).
		</p>
	</section>
}

templ supportStatusFR() {
	<section id="status">
		<h2>2. Un service est-il en panne ?</h2>
		<p>
			<a href="https://status.kiff.dev">status.kiff.dev</a> fonctionne
			indépendamment de KIFF : il répond donc même quand KIFF ne
			répond pas.
		</p>
	</section>
}

templ supportTafsFR() {
	<section id="tafs">
		<h2>3. Supprimer votre compte</h2>
		<p>
			Dans tafs : Compte → <em>Supprimer le compte</em>. KIFF
			désactive immédiatement vos clés et efface ses données après
			un délai de grâce de 30 jours, comme l'indique la
			<a href="/fr/privacy">politique de confidentialité</a>. L'aide
			sur l'app se trouve dans la
			<a href="/docs/tafs">documentation de tafs</a> { components.InEnglish("fr") }.
			if WatchLive {
				<a href="/fr/tafs/watch">tafs sur votre montre</a> : ce qu'il fait et comment l'obtenir.
			}
		</p>
	</section>
}

templ supportDataFR() {
	<section id="data">
		<h2>4. Vos données</h2>
		<p>
			Pour consulter, exporter ou supprimer vos données, ou un
			compte créé sur le web, écrivez à
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</section>
}

templ supportSecurityFR() {
	<section id="security">
		<h2>5. Sécurité et questions juridiques</h2>
		<p>
			Problèmes de sécurité : <a href="mailto:security@kiff.dev">security@kiff.dev</a>.
			Notifications juridiques : <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</section>
}

templ supportComputerFR() {
	<section id="computer">
		<h2>6. Ajouter un ordinateur avec votre téléphone</h2>
		<ol>
			<li>Sur l’ordinateur, ouvrez tafs et choisissez <em>Ajouter cet ordinateur avec votre téléphone</em>. Il affiche un code à scanner.</li>
			<li>Sur le téléphone que vous utilisez déjà avec tafs, ouvrez <em>Compte</em> → <em>Appareils</em> → <em>Ajouter un appareil</em>, puis scannez ce code.</li>
			<li>Votre téléphone vous demande si votre ordinateur affiche un code. Vérifiez que c’est le même, et n’approuvez que cet ordinateur, en l’ayant devant vous.</li>
		</ol>
		<p>Si le code a expiré ou a déjà servi, choisissez <em>Afficher un nouveau code</em> sur l’ordinateur et scannez à nouveau. Sur Linux, et sur un Mac sans Secure Enclave, tafs affiche ce qui vous attend mais n’approuve pas ; vous approuvez sur votre téléphone{ macSecurityKey("fr") }.</p>
	</section>
}
