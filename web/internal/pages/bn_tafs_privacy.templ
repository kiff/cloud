package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsPrivacyBN is tafs's privacy policy (/tafs/privacy) in Bengali, at /bn/tafs/privacy.
// It is a translation of TafsPrivacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Bengali has the legal
// texts only, so a link to any other page goes to English and says so.
templ TafsPrivacyBN() {
	@components.LayoutSiteWithMeta("tafs গোপনীয়তা নীতি", "tafs, KIFF-এর অ্যাপ, কীভাবে ব্যক্তিগত তথ্য সামলায়, আপনি Google অ্যাকাউন্ট সংযুক্ত করলে Google থেকে যে তথ্য পায় তা সহ।", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · গোপনীয়তা নীতি</p>
				<h1>tafs গোপনীয়তা নীতি</h1>
				<p class="legal-meta"><strong>সর্বশেষ হালনাগাদ:</strong> 24 নভেম্বর 2026।</p>
				<p class="legal-disclaimer">এই নীতি ব্যাখ্যা করে tafs, iPhone, iPad, Android ও কম্পিউটারের জন্য KIFF-এর অ্যাপ, কীভাবে ব্যক্তিগত তথ্য সামলায়। tafs KIFF Cloud-এর অংশ, তাই <a href="/bn/privacy">KIFF-এর গোপনীয়তা নীতি</a>ও এতে প্রযোজ্য, এবং এই পৃষ্ঠা যা কভার করে না তাতেও। প্রশ্ন: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>।</p>
			</header>
			<section id="who-we-are">
				<h2>1. আমরা কে</h2>
				<p>tafs দেয় <strong>Kiff Agents OÜ</strong>, এস্তোনিয়ায় নিবন্ধিত একটি প্রাইভেট লিমিটেড কোম্পানি (রেজিস্ট্রি কোড 17372313, ভ্যাট নম্বর EE102924327), Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estonia-তে। আমাদের প্রক্রিয়াকরণে ইইউ সাধারণ তথ্য সুরক্ষা প্রবিধান (GDPR) প্রযোজ্য।</p>
			</section>
			<section id="scope">
				<h2>2. এই নীতি কী কভার করে</h2>
				<p>iPhone, iPad, Android ও কম্পিউটারের (Mac, Windows ও Linux) জন্য tafs অ্যাপ এবং এর পেছনের সেবা, Setup সহ, যা কোম্পানির টুল সংযুক্ত করে, এবং planque সহ, যা সেই সংযোগ রাখে। tafs-এ একটি কোম্পানি একটি কাজ একটি AI এজেন্টকে দেয়, একটি taf, যা KIFF Card-এর ভেতরে কাজ করে।</p>
			</section>
			<section id="roles">
				<h2>3. আমাদের ভূমিকা</h2>
				<p>আপনার অ্যাকাউন্ট ও সাইন-ইন তথ্যের এবং আমাদের নিজস্ব সেবার পরিচালন তথ্যের আমরা <strong>নিয়ন্ত্রক</strong>। tafs আপনার কোম্পানির জন্য যা রাখে তার জন্য আমরা আপনার কোম্পানির পক্ষে <strong>প্রক্রিয়াকারী</strong> হিসেবে কাজ করি: প্রতিটি taf-এর রান, চ্যাট, রিপোর্ট, মেমরি নোট ও তারা যে ফাইল দেয়। সেই তথ্যের নিয়ন্ত্রক আপনার কোম্পানি, এবং <a href="/legal/dpa">DPA</a> (ইংরেজিতে) সেই সম্পর্ক নিয়ন্ত্রণ করে।</p>
			</section>
			<section id="data">
				<h2>4. tafs কী সংগ্রহ করে</h2>
				<ul>
					<li><strong>আপনার অ্যাকাউন্ট:</strong> আপনি আপনার KIFF অ্যাকাউন্ট দিয়ে tafs-এ সাইন ইন করেন। ফোন বা ট্যাবলেটে অ্যাপ আপনার সেশন ডিভাইসের Keychain-এ রাখে (Android-এ, এর এনক্রিপ্টেড স্টোরেজে)। কম্পিউটারে তা আপনার ব্যবহারকারী অ্যাকাউন্টের জন্য সিল করে রাখে: Windows PC-তে Windows-এর নিজস্ব তথ্য সুরক্ষা দিয়ে, Linux-এ আপনার keyring-এ, Mac-এ এর Keychain-এ। কম্পিউটারের সেশন সর্বোচ্চ 90 দিন চলে।</li>
					<li><strong>আপনার ডিভাইস:</strong> অ্যাপ একটি স্বাক্ষর কী তৈরি করে যা ডিভাইস কখনো ছাড়ে না: iPhone, iPad বা Mac-এর Secure Enclave-এ, Android ডিভাইসের Keystore-এ, বা Windows PC-র TPM-এ। Linux-এ, এবং Secure Enclave ছাড়া Mac-এ, কীটি একটি সফটওয়্যার কী যা আপনার keyring বা Keychain-এ থাকে, এবং সেই কম্পিউটার আপনার জন্য কী অপেক্ষা করছে তা দেখাতে পারে কিন্তু অনুমোদন করতে পারে না; আপনি আপনার ফোনে অনুমোদন করেন{ macSecurityKey("bn") }। TPM ছাড়া Windows PC tafs-এ সাইন ইন করতে পারে না। KIFF কীটির পাবলিক অর্ধেক, ডিভাইসের নাম ও প্ল্যাটফর্ম, এবং কখন যোগ হয়েছিল ও শেষবার ব্যবহৃত হয়েছিল তা রাখে, যাতে আটকানো কলে আপনার উত্তর ও সংযোগের অনুমোদন যাচাই করতে পারে।</li>
					<li><strong>আপনার ঘড়ি:</strong> একটি ঘড়িতে কোনো পাসওয়ার্ড বা কী থাকে না, শুধু আপনার জোড়া ফোনের সঙ্গে কথা বলে, এবং কখনো অনুমোদন করে না। আপনি AI-কে অনুমতি দেওয়ার পর আপনি যা বলেন তা এটি ফোনের মাধ্যমে শুধু টেক্সট হিসেবে Coach-কে, বা আপনার বাছাই করা taf-কে পাঠায়। ঘড়ির নিজস্ব বক্তৃতা সেবা, Apple-এর বা Google-এর, আপনার কথা সেই টেক্সটে রূপ দেয়। Wear OS-এ, আপনার শেষ করার আগে তা থেমে গেলে, আপনার ফোনের নিজস্ব শনাক্তকারী সেটি ফোনেই করে। এটি শুধু তখনই প্রত্যাখ্যান করতে, থামাতে (halt) বা Coach বা taf-কে পাঠাতে পারে যখন এতে স্ক্রিন লক বা পাসকোড আছে এবং আনলক করা। আপনি taf-কে যা পাঠান তা সেই taf-এর নিজস্ব চ্যাটে যায়, যেন আপনি ফোনে লিখেছেন। একটি taf-এর চ্যাট, অঙ্কসহ, ঘড়িতে শুধু খোলা থাকাকালে দেখায়, প্রতিবার ফোনের মাধ্যমে পড়া; ঘড়ি তার কিছুই রাখে না।</li>
					<li><strong>Apple Watch:</strong> এটি আপনার taf ও তাদের পৃষ্ঠা না রেখে দেখায়। এটি শুধু আপনার Inbox রাখে, একটি ফাইলে যা লক থাকাকালে এটি পড়তে পারে না: প্রতিটি আটকানো কল তার taf-এর নাম ও সে কী চায় হিসেবে, কখনো অঙ্ক নয়, এবং ঘড়ি থেকে আপনার পাঠানো বার্তার Coach-এর উত্তর, টেক্সট হিসেবে। আপনি ঘড়িতে সাইন আউট করলে, আপনি ঘড়িতে আবার সাইন ইন না করা পর্যন্ত এটি তাও রাখে যে আপনি করেছেন। এ ছাড়া, ঘড়িতে পাসকোড না থাকলে এটি কিছুই রাখে না। আপনি ঘড়িতে সাইন আউট করলে বা আপনার iPhone সাইন আউট করলে, বা অ্যাপ পাসকোড ছাড়া পরের বার খুললে বা বন্ধ হলে, Inbox চলে যায়। এটি কোনো রেকর্ডিং করে না, এবং যে বিজ্ঞপ্তি দেখায় তা শুধু আপনার iPhone-এর। আপনি Coach-এর জন্য কোনো বার্তা পরে পাঠাতে রেখে দিলে, এটি সেই একটি বার্তাও লেখা হিসেবে নিজস্ব একটি ফাইলে রাখে, যা ইনবক্সের মতোই লক থাকে, এবং আপনার iPhone ফিরে এলে সেটি পাঠায়। পাঠানো হয়ে গেলে, আপনি মুছে ফেললে, আপনি বা আপনার iPhone সাইন আউট করলে, অথবা ঘড়িতে আর পাসকোড না থাকলে এটি মুছে ফেলা হয়।</li>
					<li><strong>Wear OS:</strong> এটি আপনার অ্যাকাউন্টের ইমেইল ও আজকের ক্যালেন্ডার না রেখে দেখায়। যাতে এটি সঙ্গে সঙ্গে খোলে, এটি এনক্রিপ্ট করে রাখে আপনার জন্য কী অপেক্ষা করছে তার সংখ্যা, এবং প্রতিটি taf-এর নাম ও তা থামানো বা বিরতিতে কি না: কখনো অঙ্ক, আটকানো কলের বিবরণ বা taf-এর চ্যাট নয়। আপনি সাইন আউট করলে, ঘড়ি লক হলে বা কব্জি থেকে খুললে, এবং 24 ঘণ্টা পর তা মুছে যায়। এটি আপনার Inbox রাখে, যেখানে প্রতিটি লাইন একটি taf-এর নাম ও সে কী বলে, কখনো অঙ্ক নয়, এবং পরের জন্য রাখা একটি বার্তা, টেক্সট হিসেবে। ঘড়িতে বা ফোনে সাইন আউট করলে সব মুছে যায়। এর টাইলের জন্য এটি আপনার জন্য কী অপেক্ষা করছে তার সংখ্যাও রাখে, শুধু ঘড়ি আনলক থাকাকালে দেখানো হয়, এবং আপনি সাইন আউট করলে, বা ঘড়ি লক থাকা বা স্ক্রিন লক না থাকা অবস্থায় টাইল পরের বার দেখালে, মুছে যায়। আপনি ঘড়িতে সাইন আউট করলে, আপনি আবার সাইন ইন না করা পর্যন্ত এটি তার একটি নোট রাখে। ঘড়ি লক থাকা বা স্ক্রিন লক না থাকা অবস্থায় অ্যাপ পরের বার খুললে বা বন্ধ হলেও Inbox চলে যায়। পরের জন্য রাখা বার্তা আপনি পাঠানো বা মোছা পর্যন্ত থাকে, কারণ আপনি তা পাঠাতে বলেছিলেন। আপনার শেষ করার আগে ঘড়ির বক্তৃতা সেবা থেমে গেলে, ঘড়ি রেকর্ডিং আপনার ফোনে পাঠায়, যা ফোনেই, কখনো সার্ভারে নয়, তা টেক্সটে রূপ দেয়। টেক্সট ফিরে এলে বা আপনি বাতিল করলে, এবং সর্বোচ্চ 2 মিনিট পর, রেকর্ডিং দুই জায়গা থেকেই মুছে যায়। শুধু টেক্সট Coach বা আপনার taf-এ যায়। একটি taf-এর ফল ঘড়ির বিজ্ঞপ্তিতে থাকতে পারে যতক্ষণ না আপনি তা বাতিল করেন বা ঘড়িতে সাইন আউট করেন। পরে পাঠাতে রাখা বার্তাটিও মুছে যায় যদি ঘড়িতে আর স্ক্রিন লক না থাকে।</li>
					<li><strong>পাসকী:</strong> আপনি কম্পিউটারে পাসকী দিয়ে অনুমোদন করলে, যেমন Windows Hello বা সিকিউরিটি কী, আপনার মুখ, আঙুলের ছাপ বা PIN কম্পিউটারের নিজস্ব সিস্টেমেই থাকে। KIFF পাসকীর পাবলিক কী, এর আইডি, একটি কাউন্টার ও একটি নাম রাখে, কখনো গোপন কিছু নয়, এবং অন্য ডিভাইসে সিঙ্ক হওয়া পাসকী প্রত্যাখ্যান করে।</li>
					<li><strong>সতর্কতা:</strong> ফোন, ট্যাবলেট বা iPad অ্যাপ চালানো Mac-এ, আপনি চালু করলে, আমরা ডিভাইসের পুশ টোকেন আপনার KIFF ব্যক্তি আইডি এবং অ্যাপ যে ভাষা দেখিয়েছিল তার সঙ্গে রাখি। সতর্কতা Apple বা Google দিয়ে যায় শুধু কোন taf ও সে কী চায় নিয়ে, এবং দরজার সতর্কতায় যিনি লিখেছেন তাঁর নাম বা ইমেইল ঠিকানা: কখনো অঙ্ক বা অনুরোধের বিবরণ নয়। অ্যাপ সেগুলো ডিভাইসেই, KIFF থেকে, যোগ করে, তাই আনলক করা ফোনের সতর্কতা অঙ্ক, ব্যবসায়ী বা ব্যক্তি দেখাতে পারে। লক করা Android ফোনে এটি শুধু „একটি taf আপনাকে চায়“ দেখায়, এবং লক করা iPhone-এও, যদি না আপনি এর প্রিভিউ সবসময় দেখানোর সেট করে থাকেন। Windows PC, Linux কম্পিউটার বা macOS 12 অ্যাপ চালানো Mac-এ সতর্কতা অ্যাপ নিজেই চলার সময় তৈরি করে, পুশ টোকেন ছাড়া এবং অন্য কোনো কোম্পানির মাধ্যমে নয়। Windows ও Linux-এ সেগুলো দেখায় কোন taf, সে কী করতে চায়, অঙ্ক, কেন ও কখনের মধ্যে; macOS 12 অ্যাপে, আপনি চালু করলে, সেগুলো কলের জন্য KIFF-এর ভাষা দেখায়, এবং লক স্ক্রিন Mac-এর প্রিভিউ সেটিং যা অনুমতি দেয় তা দেখায়। Windows-এ আপনি চালু না করা পর্যন্ত সেগুলো বন্ধ, এবং স্ক্রিন লক থাকাকালে শুধু „একটি taf আপনাকে চায়“ দেখায়। স্ক্রিন লক হওয়ার আগে দেখানো একটি Windows-এর বিজ্ঞপ্তি তালিকায় তার বিবরণ রাখে। Linux-এ আপনি বন্ধ না করা পর্যন্ত সেগুলো চালু, এবং লক স্ক্রিন কী দেখায় তা আপনার ডেস্কটপের উপর নির্ভর করে।</li>
					<li><strong>ভাষা:</strong> tafs সেবা অ্যাকাউন্টের ভাষা, যিনি সর্বশেষ Coach-এর সঙ্গে চ্যাট করেছেন তাঁর কাছ থেকে, তিন মাস পর্যন্ত রাখে, যাতে taf-এর রিপোর্ট সেই ভাষায় আসে।</li>
					<li><strong>আপনার টুল:</strong> আপনি টুল সংযুক্ত করলে টুলের নিজস্ব প্রদানকারীর কাছে সাইন ইন করেন। planque নিজে সাইন ইন করে এমন অ্যাপের জন্য, যেমন Stripe, বা আপনার দেওয়া কীর জন্য, planque সেই টোকেন বা কী আপনার কোম্পানির জন্য এনক্রিপ্ট করে রাখে। পরিচালিত সংযোগের জন্য, Composio, planque যে সংযোগ সেবার সঙ্গে কাজ করে, সাইন-ইন ধরে রাখে, এবং planque শুধু সংযোগের রেকর্ড ও আপনার অনুমোদিত টুল রাখে (<a href="#google">Google ব্যবহারকারী তথ্য</a> দেখুন)। সংযোগের রেকর্ডে যে অ্যাকাউন্টে সাইন ইন করা তা (এর নাম বা ইমেইল) থাকতে পারে, যাতে অ্যাপ আপনাকে দেখাতে পারে সেটি কোনটি। KIFF পরিচালিত সংযোগ শুধু <a href="/subprocessors#composio">/subprocessors</a> (ইংরেজিতে)-এ নামকরা অ্যাপের জন্য ব্যবহার করে।</li>
					<li><strong>আপনার ব্রাউজার (Chrome):</strong> আপনি যখন tafs এক্সটেনশন আপনার ফোনের সঙ্গে জোড়া লাগান, তখন taf আপনার জোড়া লাগানো Chrome প্রোফাইলে, শুধু তার সংযোগে তালিকাভুক্ত সাইটগুলোতে কাজ করতে পারে। এটি নিজের ট্যাবগুলো এমন একটি ট্যাব গ্রুপে খোলে যা আপনি দেখতে, বিরতি দিতে বা থামাতে পারেন, এবং সেগুলোর একটিতে আপনি ছুঁলে এটি বিরতি দেয়। এক্সটেনশনের পাশের প্যানেল থেকে আপনি যে taf শুরু করেন, সেটি বরং সেই উইন্ডোতে আপনি যে ট্যাবে আছেন সেখানে কাজ করে, যদি সেটি তার সংযোগের কোনো সাইটে থাকে: ট্যাবটি তার গ্রুপে যোগ দেয় এবং তার নিজের ট্যাব হিসেবে গণ্য হয়, আর taf থামলে খোলা থাকে। এটি সেই পাতাগুলো টেক্সট ও ফর্মের ঘর হিসেবে পড়ে, পাসওয়ার্ড, কার্ড ও কোডের ঘর বাদ দিয়ে, কখনও আপনার অন্য ট্যাব বা অন্য সাইট নয়। সেই টেক্সট রানের অংশ হিসেবে আমাদের এআই সেবাদাতার কাছে যায়, এবং যেকোনো টুলের ফলাফলের মতো রানের সঙ্গে রাখা হয়। প্রতিটি ধাপ সাইট ও ঘরের নামসহ রেকর্ডে যায়, গোপন ঘরে যা টাইপ করা হয়েছে তা কখনও নয়। taf-এর করা প্রতিটি পরিবর্তনের জন্য KIFF আগের ও পরের পাতা সেই ঘরগুলো বাদ দেওয়া টেক্সট হিসেবে সর্বোচ্চ 30 দিন রাখে, এবং আপনি সংযোগ বিচ্ছিন্ন করলে বা অ্যাকাউন্ট মুছলে আরও আগে মুছে দেয়। এই পাতাগুলোতে অন্যদের তথ্য, যেমন আপনার গ্রাহকদের, দেখা যেতে পারে; KIFF সেগুলো আপনার জন্য প্রক্রিয়াকারী হিসেবে প্রক্রিয়া করে। এক্সটেনশনটি আপনার কম্পিউটারে শুধু নিজের চাবিটি রাখে, কখনও আপনার পাসওয়ার্ড নয়: সাইন-ইন পাতায় taf থেমে যায় এবং আপনাকে নিজের ট্যাবে নিজেই সাইন ইন করতে বলে। আপনি এক্সটেনশনের পাশের প্যানেল থেকেও Coach-এর সঙ্গে কথা বলতে পারেন। আপনি এক্সটেনশনে অনুমতি দেওয়ার পরেই Coach পাতাটি পড়ে, এর নিজস্ব সম্মতিতে যা আপনি সেখানে প্রত্যাহার করতে পারেন, এবং আপনি সবসময় পাতা ছাড়া মেসেজ পাঠাতে পারেন। সেখানে এটিকে বার্তা পাঠালে সামনের পাতাটি সেই বার্তার সঙ্গে যায়, কেবল তার দৃশ্যমান লেখা হিসেবে, আপনার টাইপ করা কিছুই নয়, তবে ব্যাংক, পেমেন্ট, মেইল বা স্বাস্থ্য সাইট বা Coach-এর জন্য আপনার বন্ধ করা সাইটে নয়। ঘরের মান ও পাসওয়ার্ড পড়া হয় না; কার্ড নম্বর তার শেষ চারটি অঙ্কে ছোট করা হয়; কী এবং নাম দেওয়া গোপন তথ্য ঢেকে রাখা হয়। পাতার লেখায় ইংরেজি, ফরাসি, স্প্যানিশ বা জার্মানে এককালীন কোড হিসেবে নাম দেওয়া কোডও ঢেকে রাখা হয়। এটি কেবল সেই বার্তার জন্য আমাদের AI প্রদানকারীর কাছে যায়; উত্তর শেষ না হওয়া পর্যন্তই tafs পাতাটি রাখে, আর সাইটের নাম “পড়ছে:” হিসেবে আপনার চ্যাটের সঙ্গে 30 দিন রাখে। Coach-এর উত্তরে পাতা থেকে উদ্ধৃতি থাকতে পারে এবং যেকোনো উত্তরের মতো তা আপনার চ্যাটের সঙ্গে রাখা হয়। পাশের প্যানেলে কেবল সেই Chrome জোড়া দেওয়ার পর থেকে সেখানে শুরু করা চ্যাটগুলো দেখায়; আপনার অন্য চ্যাটগুলো আপনার ফোন ও অন্য ডিভাইসে থাকে। সেখানে বার্তায় ফাইলও সংযুক্ত করতে পারেন: tafs অ্যাপে সংযুক্ত ফাইলের মতোই সেগুলো সেই বার্তার সঙ্গে আমাদের AI প্রদানকারীর কাছে যায় এবং তার সঙ্গে 30 দিন রাখা হয়, চ্যাট সরানো হলে তার আগেই (কোনো বার্তা ব্যবহার না করা ফাইল প্রায় এক ঘণ্টা), আর ফাইলটি কেবল যিনি সংযুক্ত করেছেন তিনিই খুলতে পারেন। জোড়া খুলে ফেললে বা আনইনস্টল করলে এক্সটেনশন যা রাখে তা মুছে যায়। আপনার ফোনে আপনার অনুমোদন ছাড়া taf কখনও অর্থ প্রদান করে না। যে ধাপ কাজ করে (একটি ক্লিক, টাইপ করা, জমা দেওয়া), আপনার অনুমোদন করা ধাপসহ, তার প্রতিটির জন্য এটি রেকর্ডের জন্য কাজের ঠিক আগে নেওয়া পৃষ্ঠার একটি স্ক্রিনশটও রাখে; শুধু পড়া পৃষ্ঠার জন্য কখনও নয়, ব্যাংক, ওয়ালেট, পাসওয়ার্ড ম্যানেজার, পেমেন্ট, স্বাস্থ্য বা সরকারি সাইটে কখনও নয়, আর নেওয়ার আগে পাসওয়ার্ড, কার্ড ও কোডের ঘর লুকানো হয়। কার্ড নম্বর বা কীয়ের মতো দেখতে লেখাও কালো করে দেওয়া হয়, তবে অন্যভাবে লেখা কিছু তবুও দেখা যেতে পারে। স্ক্রিনশট ওই ধাপের সঙ্গে যুক্ত করে এনক্রিপ্টেড সংরক্ষণে 30 দিন রাখা হয়, তারপর স্বয়ংক্রিয়ভাবে মুছে ফেলা হয়, আর আপনি সংযোগ বিচ্ছিন্ন করলে, এই Chrome-এর জোড়া সরালে বা অ্যাকাউন্ট মুছলে আরও আগে; সেগুলো আমাদের এআই প্রদানকারীর কাছে কখনও যায় না। প্রতিটি আপনি taf-এর কার্যকলাপে তার ধাপের নিচে দেখেন।</li>
					<li><strong>আপনার taf-দের কাজ:</strong> প্রতিটি taf-এর রান, চ্যাট, রিপোর্ট, মেমরি নোট ও তারা যে ফাইল দেয়, প্রক্রিয়াকারী হিসেবে রাখা। আপনার অ্যাকাউন্টের প্রত্যেকে আপনার taf-দের দেওয়া ফাইল দেখতে পারেন।</li>
					<li><strong>দরজা:</strong> লোকেরা যাতে ইমেইল, Slack বা Telegram দিয়ে কোনো taf-কে লিখতে পারে সেজন্য আপনি দরজা খুললে, tafs পরিষেবা আপনার জোড়া লাগানো প্রতিটি প্রেরককে তার ইমেইল ঠিকানা, Slack সদস্য আইডি বা Telegram ব্যবহারকারী আইডি দিয়ে (WhatsApp দরজার জন্য ফোন নম্বর), আপনার দেওয়া নামসহ রাখে, যতক্ষণ না আপনি দরজা বা taf সরান। যাকে জোড়া লাগাননি তার বার্তা কড়া নাড়া হিসেবে, কে লিখেছে ও কী লিখেছে সহ, সর্বশেষটির পর সর্বোচ্চ 30 দিন আপনার অপেক্ষায় থাকে। জোড়া লাগানো প্রেরকের বার্তা taf-এর চ্যাটে যায় এবং চ্যাটের বাকি অংশের মতোই রাখা হয়। Slack ও Telegram নিজেদের শর্তে বার্তা বহন করে।</li>
					<li><strong>ক্রয়:</strong> Solo ও ক্রেডিটের প্যাক Apple বিক্রি করে App Store দিয়ে, বা Google, Google Play-এর বিলিং দিয়ে। তারা আমাদের জানায় কী কেনা হয়েছে, কোন KIFF অ্যাকাউন্টের জন্য (একটি এলোমেলো আইডি), কখন, এবং তাদের লেনদেন বা অর্ডার রেফারেন্স। তারা আমাদের আপনার Apple ID বা Google অ্যাকাউন্ট, নাম, ইমেইল ঠিকানা বা কার্ড দেয় না।</li>
				</ul>
				<p>অ্যাপে কোনো অ্যানালিটিক্স বা বিজ্ঞাপন ট্র্যাকার নেই।</p>
			</section>
			<section id="ai">
				<h2>5. tafs-এর AI</h2>
				<p>tafs Coach ও আপনার taf-দের জন্য Anthropic-এর Claude AI ব্যবহার করে। কিছু তাতে যাওয়ার আগে অ্যাপ আপনাকে জিজ্ঞেস করে।</p>
				<ul>
					<li>তাতে যা পাঠানো হয়: আপনি Coach ও আপনার taf-দের যা লেখেন, আপনার সংযুক্ত ফাইল, taf কাজ করার সময় আপনার সংযুক্ত অ্যাপ তাকে যা ফেরত দেয়, এবং অ্যাপে Coach আপনাকে সাহায্য করার সময় আপনার স্ক্রিনে যা থাকে।</li>
					<li>Chrome থেকে: এক্সটেনশনের পাশের প্যানেলে Coach-কে লিখলে সামনের পাতাটি, আপনি সেখানে Coach-কে পাতা পড়তে দেওয়ার পরে।</li>
					<li>যা কখনো পাঠানো হয় না: আপনার সংযুক্ত অ্যাপের ব্যবহৃত পাসওয়ার্ড ও কী, বা আপনার আঙুলের ছাপ।</li>
					<li>Anthropic উত্তর দিতে তা ব্যবহার করে এবং 30 দিন পর্যন্ত রাখে।</li>
					<li>আপনি অনুমতি না দেওয়া পর্যন্ত কিছু পাঠানো হয় না। আপনি Account-এ প্রত্যাহার করতে পারেন।</li>
				</ul>
				<p>আপনি প্রত্যাহার করলে Coach ও আপনার taf-রা আপনাকে উত্তর দেওয়া বন্ধ করে, এবং যে taf-এর রান আপনার সম্মতির উপর নির্ভর করে সেটি বিরতিতে যায়। আপনি কী সম্মতি দিয়েছেন তা দেখাতে tafs আপনার দেওয়া বা প্রত্যাহার করা প্রতিটি সম্মতির রেকর্ড, কখন এবং তার শব্দের কোন সংস্করণে, শেষ পরিবর্তনের পর থেকে 10 বছর রাখে; আপনার অ্যাকাউন্ট মুছলে তা আগেই মুছে যায়। বিস্তারিত <a href="/bn/privacy#ai-in-tafs">KIFF-এর গোপনীয়তা নীতি</a>-তে।</p>
			</section>
			@tafsPrivacyGoogleBN()
			<section id="sharing">
				<h2>7. আর কারা তথ্য পায়</h2>
				<p>আমরা আপনার ব্যক্তিগত তথ্য বিক্রি করি না, এবং বিজ্ঞাপনের জন্য ভাগ করি না।</p>
				<p>tafs-এর জন্য আমরা এই কোম্পানিগুলো ব্যবহার করি: Amazon Web Services (হোস্টিং, tafs-এর স্টোর ও planque-এর সংযোগ সহ), Clerk (KIFF অ্যাকাউন্টের সাইন-ইন), Anthropic (AI মডেল), Composio (পরিচালিত সংযোগের সাইন-ইন, এবং planque যে কল করতে বলে সেগুলো), Apple (পুশ সতর্কতা), Google (Android-এ পুশ সতর্কতা, এবং Google Play-এর বিলিং), এবং Resend (taf-এর ইমেইল দরজা)। কে কী ছোঁয় ও কোথায় তার সহ সরকারি, বর্তমান তালিকা <a href="/subprocessors">/subprocessors</a> (ইংরেজিতে)-এ।</p>
				<p>এদের কিছু ইউরোপীয় অর্থনৈতিক অঞ্চলের বাইরে, বেশিরভাগ যুক্তরাষ্ট্রে। সেই স্থানান্তর কীভাবে সুরক্ষিত তা <a href="/bn/privacy#transfers">KIFF-এর গোপনীয়তা নীতি</a> বলে।</p>
				<p><strong>আপনার দেশ।</strong> কিছু দেশের আইন এই নীতির চেয়ে বেশি চায়। তারা কী যোগ করে, ইংরেজিতে এবং দেশের ভাষায়, তা <a href="/privacy/countries">আপনার দেশ</a> (ইংরেজিতে)-এ।</p>
			</section>
			<section id="retention">
				<h2>8. আমরা কতদিন রাখি</h2>
				<ul>
					<li>আপনার টুল taf-কে যা ফেরত দেয়: শুধু রান শেষ হওয়া পর্যন্ত। চ্যাটে, যা শুধু পড়া হয়েছে তা পরের বার্তার জন্য এনক্রিপ্ট করে রাখা হয়, চ্যাট এক ঘণ্টা নিষ্ক্রিয় থাকা পর্যন্ত এবং পড়ার পর সর্বোচ্চ চার ঘণ্টা পর্যন্ত ব্যবহৃত, তারপর কয়েক দিনের মধ্যে স্বয়ংক্রিয়ভাবে মোছা হয়।</li>
					<li>taf-এর রান ও চ্যাট, চ্যাটের সারসংক্ষেপসহ: 30 দিন। এর মেমরি নোট: taf সরানো পর্যন্ত।</li>
					<li>Coach-এর পরের উত্তরের জন্য ছোট নোট, যেমন চ্যাটে কেন একটি সংযোগ করা যায়নি, বা একটি Card অনুমোদিত হয়েছে: সেই উত্তর তা নেওয়া পর্যন্ত, সর্বোচ্চ 7 দিন; তারপর সেই চ্যাটের অংশ হিসেবে, চ্যাট যতদিন রাখা হয় ততদিন। একটি কপি 24 ঘণ্টা রাখা হয় যাতে আবার পাঠানো বার্তা একই নোট পায়। একটি চ্যাটের নোট শুধু সেই চ্যাটে ব্যবহৃত।</li>
					<li>চ্যাটে আপনার সংযুক্ত ফাইল: যে বার্তার সঙ্গে সংযুক্ত তার সঙ্গে, 30 দিন, বা চ্যাট সরানো হলে আগে, এবং যেকোনো ক্ষেত্রে 38 দিনের মধ্যে। যে ফাইল কোনো বার্তা ব্যবহার করে না তা আপলোডের প্রায় এক ঘণ্টা পর সরানো হয়। আপনার অ্যাকাউন্ট মুছলে সেগুলো মুছে যায়।</li>
					<li>আপনার taf-দের দেওয়া ফাইল: রান যখন তৈরি করেছে তার 30 দিন, তারপর এক দিনের মধ্যে স্বয়ংক্রিয়ভাবে মোছা। আপনার অ্যাকাউন্টের যে কেউ Delete now দিয়ে আগে মুছতে পারেন: ফাইল নিজে সঙ্গে সঙ্গে চলে যায়, কোনো কপি রাখা হয় না; এর নাম, আকার এবং যে taf ও রান তৈরি করেছে তা tafs-এর স্টোরের এনক্রিপ্টেড পয়েন্ট-ইন-টাইম কপিতে 35 দিন পর্যন্ত থাকতে পারে, শুধু ব্যর্থতার পর তা পুনরুদ্ধারে ব্যবহৃত। taf সরালে বা আপনার অ্যাকাউন্ট মুছলে তার ফাইল মুছে যায়। ফাইল শেয়ার করলে ফাইল নিজেই যায়, এবং আপনার শেয়ার করা কপি আপনি যে অ্যাপে শেয়ার করেছেন তার কাছে থাকে। ফাইল ডাউনলোড করতে আমরা আপনার অ্যাকাউন্টের একজন সাইন-ইন করা সদস্যের জন্য একটি লিংক তৈরি করি যা এক মিনিট পর কাজ বন্ধ করে; আমরা এর আর কোনো লিংক তৈরি করি না।</li>
					<li>planque-এর প্রতিটি কলের রেকর্ডে টুল যা ফেরত দিয়েছে: 24 ঘণ্টা। এর পর রেকর্ড শুধু রাখে কলটি পাঠানো হয়েছিল কি না, যাতে তা কখনো দুইবার পাঠানো না হয়।</li>
					<li>planque-এ একটি সংযোগের টোকেন বা কী, বা Composio-তে একটি পরিচালিত সংযোগের সাইন-ইন: আপনি সংযোগ বিচ্ছিন্ন করা পর্যন্ত। আপনার অন্য কোনো সংযোগ সেই বিক্রেতার সেই একই অ্যাকাউন্ট ব্যবহার করলে, সেটি অব্যবহৃত অবস্থায় রাখা হয় যতক্ষণ না সেটিও বিচ্ছিন্ন হয়, তারপর প্রত্যাহার করা হয়। এর অনুমোদনের রেকর্ড: অ্যাকাউন্ট শেষ হওয়া পর্যন্ত।</li>
					<li>ডিভাইসের পুশ টোকেন: আপনি অ্যাপ থেকে সাইন আউট করা, ডিভাইস সরানো, বা Apple বা Google টোকেন চলে গেছে জানানো পর্যন্ত। ডিভাইসের পাবলিক কী, নাম, প্ল্যাটফর্ম ও তারিখ: আপনি ব্যবহার করা পর্যন্ত; সাইন আউট করালে তা সরানো বলে চিহ্নিত হয় ও অ্যাকাউন্ট মোছা পর্যন্ত রাখা হয়, যাতে KIFF তার দেরিতে আসা উত্তর প্রত্যাখ্যান করতে পারে ও দেখাতে পারে আগের কোনটি কোন ডিভাইস সই করেছিল। পাসকীর পাবলিক কী, আইডি ও নাম: তার ডিভাইসের মতো। কম্পিউটারের সেশন: সর্বোচ্চ 90 দিন, বা আপনি সাইন আউট করা পর্যন্ত।</li>
					<li>আপনার অ্যাকাউন্ট: মোছা পর্যন্ত। সেবার লগ: 30 দিন। tafs ও planque-এর স্টোর 35 দিনের জন্য এনক্রিপ্টেড পয়েন্ট-ইন-টাইম কপি রাখে, শুধু ব্যর্থতার পর স্টোর পুনরুদ্ধারে ব্যবহৃত।</li>
				</ul>
				<p>বাকি সবকিছু <a href="/bn/privacy#retention">KIFF-এর সংরক্ষণ অংশে</a>।</p>
			</section>
			<section id="lawful-bases">
				<h2>9. আইনি ভিত্তি</h2>
				<p>চুক্তি পালন, আপনার অ্যাকাউন্ট ও আপনার taf-দের চালাতে। বৈধ স্বার্থ, নিরাপত্তা, প্রতারণা প্রতিরোধ ও অপব্যবহার শনাক্তকরণের জন্য। সম্মতি, tafs-এর AI-র জন্য (<a href="#ai">অংশ 5</a>)। আইনি বাধ্যবাধকতা, কর রেকর্ডের জন্য। বিস্তারিত <a href="/bn/privacy#lawful-bases">KIFF-এর গোপনীয়তা নীতি</a>-তে।</p>
			</section>
			<section id="rights">
				<h2>10. আপনার অধিকার</h2>
				<p>GDPR-এর অধীনে আপনি আপনার তথ্যে প্রবেশাধিকার, সংশোধন, মুছে ফেলা, সীমাবদ্ধতা বা বহনযোগ্য কপি চাইতে, বৈধ স্বার্থভিত্তিক প্রক্রিয়াকরণে আপত্তি জানাতে এবং সম্মতি প্রত্যাহার করতে পারেন। <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>-এ ইমেইল করুন; আমরা অযথা দেরি না করে এবং সর্বোচ্চ এক মাসের মধ্যে সাড়া দিই; জটিল অনুরোধে আরও দুই মাস লাগতে পারে, এবং সেটা আমরা প্রথম মাসের মধ্যেই আপনাকে জানাই। অ্যাপে Account → Export my chats আপনার নিজের চ্যাট ও নোট ডাউনলোড করে।</p>
				<p>আপনার tafs অ্যাকাউন্ট মুছতে অ্যাপ খুলুন, Account-এ যান এবং <em>Delete account</em> ট্যাপ করুন, তারপর নিশ্চিত করুন। এটি ফেরানো যায় না। কী মোছা হয় ও কখন, এবং ইমেইলে কীভাবে চাইতে হয় তা <a href="/bn/privacy#delete-account">KIFF-এর গোপনীয়তা নীতি</a> বলে।</p>
				<p>আপনি <a href="https://www.aki.ee/en" target="_blank" rel="noopener">এস্তোনিয়ান ডেটা সুরক্ষা পরিদর্শনালয় (Andmekaitse Inspektsioon)</a>-এ, বা আপনার বাসস্থানের তত্ত্বাবধায়ক কর্তৃপক্ষের কাছে অভিযোগ করতে পারেন।</p>
				<p><strong>আপনার দেশ।</strong> কিছু দেশের আইন এই নীতির চেয়ে বেশি চায়। তারা কী যোগ করে, ইংরেজিতে এবং দেশের ভাষায়, তা <a href="/privacy/countries">আপনার দেশ</a> (ইংরেজিতে)-এ।</p>
			</section>
			<section id="more">
				<h2>11. নিরাপত্তা, শিশু ও পরিবর্তন</h2>
				<p>আমাদের নিরাপত্তা ব্যবস্থা <a href="/security">/security</a> (ইংরেজিতে)-এ। tafs শিশুদের উদ্দেশে নয়, এবং আমরা জেনেশুনে 16 বছরের কম বয়সী শিশুদের ব্যক্তিগত তথ্য সংগ্রহ করি না। আমরা এই নীতি সেভাবে বদলাই যেভাবে <a href="/bn/privacy#changes">KIFF-এর গোপনীয়তা নীতি</a> নিজের জন্য বলে।</p>
			</section>
			<section id="contact">
				<h2>12. যোগাযোগ</h2>
				<p>গোপনীয়তা প্রশ্ন ও অনুরোধ: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>। আনুষ্ঠানিক আইনি নোটিশ: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>। অ্যাপের নিজস্ব শর্ত <a href="/bn/tafs/terms">/tafs/terms</a>-এ।</p>
			</section>
		</article>
	}
}

// tafsPrivacyGoogle is what tafs does with the data it receives from Google,
// for Google's review of tafs's sign-in, with the Limited Use statement in
// Google's own words.
templ tafsPrivacyGoogleBN() {
	<section id="google">
		<h2>6. Google ব্যবহারকারী তথ্য</h2>
		if len(googleManaged()) == 0 && len(googleInHouse("bn")) > 0 {
			<p>আপনি বললে tafs একটি taf-কে আপনার Google অ্যাকাউন্টের সঙ্গে সংযুক্ত করে, যেমন তার কাজ যে Google Sheets বা Google Calendar ব্যবহার করে তার সঙ্গে, অ্যাপের Connect apps-এ। এই অংশ বলে tafs Google থেকে পাওয়া তথ্য নিয়ে কী করে।</p>
		} else {
