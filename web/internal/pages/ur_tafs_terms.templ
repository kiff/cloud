package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsTermsUR is tafs's terms (/tafs/terms) in Urdu, at /ur/tafs/terms.
// It is a translation of TafsTerms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Urdu has the legal
// texts only, so a link to any other page goes to English and says so. It is
// written right to left (components.IsRightToLeft).
templ TafsTermsUR() {
	@components.LayoutSiteWithMeta("tafs کی شرائط", "KIFF کی ایپ tafs کی شرائط: اسے کون فراہم کرتا ہے، آپ کا اکاؤنٹ، taf کیا کرتا ہے اور آپ اسے کیسے کنٹرول کرتے ہیں، قابلِ قبول استعمال، فیس، ذمہ داری اور اختتام۔", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · شرائط</p>
				<h1>tafs کی شرائط</h1>
				<p class="legal-meta"><strong>آخری تازہ کاری:</strong> 22 نومبر 2026۔</p>
				<p class="legal-disclaimer">یہ شرائط KIFF کی ایپ tafs (iPhone، iPad، Android اور کمپیوٹرز کے لیے) اور اس کے پیچھے کی سروس کے لیے ہیں۔ tafs، KIFF Cloud کا حصہ ہے؛ یہ صفحہ وہی دہراتا ہے جو <a href="/ur/terms">KIFF کی سروس کی شرائط</a> اس کے بارے میں کہتی ہیں، اور ان میں کچھ اضافہ نہیں کرتا۔ جو بات اس صفحے میں نہیں ہے، اس پر KIFF کی شرائط لاگو ہوتی ہیں۔ سوالات: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>۔</p>
			</header>
			<section id="provider">
				<h2>1. tafs کون فراہم کرتا ہے</h2>
				<p>tafs کو <strong>Kiff Agents OÜ</strong> فراہم کرتی ہے، جو ایسٹونیا کی ایک نجی محدود ذمہ داری کمپنی ہے (رجسٹریشن کوڈ 17372313)، پتہ: Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416، ایسٹونیا۔ اکاؤنٹ بنا کر یا کسی اور طرح tafs استعمال کر کے آپ ان شرائط اور KIFF کی شرائط سے اتفاق کرتے ہیں۔ اگر آپ کسی کمپنی کی طرف سے قبول کرتے ہیں تو آپ تصدیق کرتے ہیں کہ آپ کو اسے پابند کرنے کا اختیار ہے۔</p>
			</section>
			<section id="account">
				<h2>2. آپ کا اکاؤنٹ</h2>
				<p>آپ tafs میں اپنے KIFF اکاؤنٹ سے سائن اِن کرتے ہیں۔ درست معلومات دیں، اپنی لاگ اِن تفصیلات خفیہ رکھیں؛ آپ اپنے اکاؤنٹ کی ساری سرگرمی اور ہر اس شخص کے ذمہ دار ہیں جسے آپ اکاؤنٹ میں آنے دیتے ہیں۔ آپ کی عمر کم از کم 16 سال ہونی چاہیے، یا آپ کی رہائش کی جگہ پر ڈیجیٹل رضامندی کی عمر، جو بھی زیادہ ہو۔ tafs صرف ایسے ملک یا خطے سے استعمال کیا جا سکتا ہے جہاں Anthropic اپنی سروس دیتی ہے، جیسا <a href="https://www.anthropic.com/supported-countries">Anthropic انہیں فہرست کرتی ہے</a>؛ ایسی کمپنی کے لیے نہیں جس کا صدر دفتر اس فہرست سے باہر کسی ملک یا خطے میں ہو، یا جس کی اکثریتی ملکیت یا کنٹرول اس فہرست سے باہر صدر دفتر والی کسی کمپنی کے پاس ہو؛ اور اس صورت میں نہیں جب آپ، یا وہ کمپنی جس کے لیے آپ اسے استعمال کرتے ہیں، یورپی یونین، اقوامِ متحدہ یا ریاستہائے متحدہ کی پابندیوں کے تحت ہوں (KIFF کی شرائط، §4)۔</p>
			</section>
			<section id="what-a-taf-does">
				<h2>3. taf کیا کرتا ہے</h2>
				<p>tafs میں آپ کسی taf کو کام سونپتے ہیں: ایک AI ایجنٹ جو آپ کے جوڑے ہوئے ٹولز کے ساتھ، آپ کے اس کے لیے جاری کیے گئے KIFF Card کے دائرے میں، مقررہ وقت پر کام کرتا ہے۔ وہ جو AI ماڈل استعمال کرتا ہے اسے Anthropic فراہم کرتی ہے۔ Setup، tafs کا ایک AI ایجنٹ، ٹول جوڑنے اور taf بنانے میں آپ کی مدد کرتا ہے، لیکن خود کچھ نہیں جوڑتا: آپ ٹول کے اپنے فراہم کنندہ پر سائن اِن کرتے ہیں، اور ہر کنکشن، taf جو ٹولز استعمال کر سکتا ہے، اور اس کے Card کو اپنے آلے پر منظور کرتے ہیں۔</p>
				<p>taf کی رپورٹیں، پیغامات اور میموری نوٹس ایک AI ماڈل لکھتا ہے اور وہ غلط ہو سکتے ہیں۔ بھروسہ کرنے سے پہلے اہم باتیں جانچ لیں۔ taf آپ کی کمپنی سے باہر کسی کو جو کچھ بھی لکھتا ہے، اس میں بتایا جاتا ہے کہ اسے ایک AI ایجنٹ نے لکھا ہے۔</p>
			</section>
			<section id="control">
				<h2>4. آپ کا کنٹرول: Card اور منظوریاں</h2>
				<p>taf آپ کے ٹولز تک صرف KIFF کے ذریعے پہنچتا ہے، جو ہر کال کو بھیجنے سے پہلے taf کے Card سے جانچتا ہے۔ آپ کے جاری کردہ Card کے دائرے میں کی گئی کال آپ کی ہدایت پر کی جاتی ہے۔ Card کے باہر کی کال روکی جاتی ہے یا مسترد کی جاتی ہے، جیسا Card کہتا ہے۔ روکی گئی کال تبھی کی جاتی ہے جب آپ کا اکاؤنٹ جسے روکی گئی کالز کا جواب دینے کی اجازت دیتا ہے وہ اسے منظور کر دے۔</p>
				<p>آپ ہر taf کا کام اور Card منتخب کرتے ہیں، اس کی روکی گئی کالز کا جواب دیتے ہیں، اور یقینی بناتے ہیں کہ آپ کو اپنے جوڑے ہوئے ٹولز اور اکاؤنٹس استعمال کرنے کا حق ہے۔ آپ ایک taf یا سب کو روک سکتے ہیں، کسی taf کو تھما سکتے ہیں، اس کا کوئی بھی Card منسوخ کر سکتے ہیں، یا اسے ہٹا سکتے ہیں۔ جس لمحے آپ taf کو روکتے ہیں یا Card منسوخ کرتے ہیں، اسی لمحے سے KIFF اس taf یا اس Card کے تحت کوئی نئی کال نہیں ہونے دیتا۔ ٹول کے فراہم کنندہ کو پہلے ہی بھیجی جا چکی درخواست پھر بھی مکمل ہو سکتی ہے: ہم نئی کالز روکتے ہیں، لیکن فراہم کنندہ جو کر چکا اسے واپس نہیں کر سکتے۔ تفصیل <a href="/ur/terms#tafs">KIFF کی شرائط، §3A</a> میں ہے۔ جب کوئی taf کسی چیک آؤٹ پر اس سائٹ پر محفوظ کردہ طریقے سے ادائیگی کرتا ہے، تو وہ یہ صرف Card کے اندر اور آپ کے فون پر اس ادائیگی کو منظور کرنے کے بعد ہی کرتا ہے؛ سائٹ اور اس کا ادائیگی فراہم کنندہ اسے پراسیس کرتے ہیں، KIFF اور planque آپ کا پیسہ کبھی اپنے پاس نہیں رکھتے، آپ کے کارڈ کی تفصیل کبھی محفوظ نہیں کرتے، اور taf کبھی کارڈ نمبر نہیں لکھتا۔</p>
				<p>EU AI Act کے تحت Kiff Agents OÜ، tafs کی فراہم کنندہ ہے اور آپ اس کے تعینات کنندہ (deployer) ہیں۔ tafs کو صرف ان کاموں کے لیے استعمال کریں جو وہ پیش کرتا ہے، اور کسی ایسے استعمال کے لیے نہیں جسے AI Act ممنوع قرار دیتا ہے یا زیادہ خطرے والا شمار کرتا ہے، جیسے کسی شخص کے روزگار، قرض یا ضروری خدمات تک رسائی کے بارے میں فیصلے۔</p>
			</section>
			<section id="acceptable-use">
				<h2>5. قابلِ قبول استعمال</h2>
				<p>آپ، آپ کے لوگوں اور آپ کے taf کو <a href="/acceptable-use">قابلِ قبول استعمال کی پالیسی</a> (انگریزی میں) پر عمل کرنا ہو گا۔ ایجنٹ کا عمل آپ کا عمل ہے۔ دیگر باتوں کے علاوہ، آپ tafs کو قانون توڑنے، کسی ایسے سسٹم یا اکاؤنٹ پر کارروائی کرنے جسے استعمال کرنے کا آپ کو اختیار نہیں، ایسی سائن اِن کے ساتھ ٹول جوڑنے جو آپ کی نہیں، سپیم بھیجنے، یا کسی Card، حد یا روک کو بائی پاس کرنے کے لیے استعمال نہیں کر سکتے۔ معتبر خلاف ورزی پر ہم فوری طور پر معطل کر سکتے ہیں۔</p>
			</section>
			<section id="fees">
				<h2>6. فیس</h2>
				<p>اس تازہ کاری کے وقت Solo { tafsCostUR.money(TafsSoloCents) } ماہانہ ہے، VAT سمیت، ہر ماہ { tafsCostUR.number(TafsSoloCredits) } کریڈٹس کے ساتھ، جو ایپ میں App Store یا Google Play کے ذریعے بکتا ہے۔ ایپ میں خریدے گئے کریڈٹ پیک { tafsCostUR.money(TafsPackCents[TafsSoloCredits]) } سے شروع ہوتے ہیں؛ ان کی میعاد ختم نہیں ہوتی۔ taf کا ہر رن اپنے استعمال کردہ AI کے لیے کریڈٹس خرچ کرتا ہے۔ Coach اور taf بنانا، Coach کے منصفانہ استعمال کے اندر، شامل ہیں۔ یہ یورو زون کی قیمتیں ہیں۔ دوسری جگہوں پر App Store یا Google Play آپ کی کرنسی میں قیمت دکھاتا ہے، اس ملک کے قواعد کے مطابق مقامی ٹیکس کے ساتھ یا بغیر، اور وہی قیمت آپ ادا کرتے ہیں۔ موجودہ قیمتیں <a href="/pricing">قیمتوں کے صفحے</a> (انگریزی میں) پر ہیں؛ tafs KIFF کے Company پلان کا بھی حصہ ہے۔</p>
				<p>کوئی ٹرائل نہیں ہے۔ ایپ میں خریدا گیا Solo آپ کی Apple یا Google Play سبسکرپشنز میں، اس اسٹور کی ادائیگی، تجدید اور رقم واپسی کی شرائط کے تحت، منظم اور منسوخ کیا جاتا ہے۔ پلان آپ کی ادا کردہ مدت کے اختتام تک چلتا ہے۔ اگر آپ EU میں صارف ہیں تو آپ خریداری کے 14 دن کے اندر دستبردار ہو سکتے ہیں۔ تفصیل <a href="/ur/terms#fees">KIFF کی شرائط، §8</a> میں ہے۔</p>
			</section>
			<section id="liability">
				<h2>7. ذمہ داری</h2>
				<p>KIFF کی شرائط (§10) کی ضمانتوں کے سوا، tafs "جیسا ہے" اور "جیسا دستیاب ہے" کی بنیاد پر دیا جاتا ہے۔ قانون جتنی اجازت دے اس حد تک، کوئی بھی فریق بالواسطہ یا نتیجتاً ہونے والے نقصان کا ذمہ دار نہیں، اور ہر فریق کی کل ذمہ داری اسی طرح محدود ہے جیسا <a href="/ur/terms#liability">KIFF کی شرائط، §12</a> کہتی ہیں۔ جس ذمہ داری کو قانون محدود کرنے کی اجازت نہیں دیتا، اسے کچھ بھی محدود نہیں کرتا۔</p>
			</section>
			<section id="termination">
				<h2>8. اختتام</h2>
				<p>آپ کسی بھی وقت رک سکتے ہیں: ایپ میں اپنا اکاؤنٹ، اکاؤنٹ ← <em>اکاؤنٹ حذف کریں</em> میں حذف کر دیں۔ پہلے اپنی چیٹس اکاؤنٹ ← میری چیٹس ایکسپورٹ کریں سے ایکسپورٹ کریں۔ ہم نوٹس کے تیس دن کے اندر ٹھیک نہ کی گئی مادی خلاف ورزی پر، یا قابلِ قبول استعمال کی خلاف ورزی پر فوری طور پر، آپ کا استعمال ختم کر سکتے ہیں۔ چھوڑنے اور اپنا ڈیٹا ساتھ لے جانے کے آپ کے حقوق <a href="/ur/terms#term">KIFF کی شرائط، §9</a> میں ہیں۔</p>
			</section>
			<section id="governing-law">
				<h2>9. تبدیلیاں اور قابلِ اطلاق قانون</h2>
				<p>ہم ان شرائط کو اسی طرح بدلتے ہیں جیسا KIFF کی شرائط اپنے لیے کہتی ہیں (§16)۔ یہ جمہوریہ ایسٹونیا کے قوانین کے تحت ہیں، اور تنازعات تالن کی Harju County Court میں جاتے ہیں۔ اگر آپ کسی دوسرے EU رکن ملک میں صارف ہیں تو آپ کے ملک کے لازمی صارف تحفظ کے قواعد پھر بھی لاگو ہوتے ہیں۔</p>
			</section>
			<section id="contact">
				<h2>10. رابطہ</h2>
				<p>معاہدے سے متعلق سوالات: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>۔ ایپ میں مدد: <a href="mailto:support@kiff.dev">support@kiff.dev</a>۔ رازداری: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>، اور tafs ذاتی ڈیٹا کو کیسے سنبھالتا ہے، یہ <a href="/ur/tafs/privacy">tafs رازداری کی پالیسی</a> میں ہے۔</p>
			</section>
		</article>
	}
}
