package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsPrivacySL is tafs's privacy policy (/tafs/privacy) in Slovene, at
// /sl/tafs/privacy. It is a translation of TafsPrivacy: the same sections,
// anchors, links and figures, held to it by TestTranslationsKeepTheEnglishPage.
// The English page governs. Change the English page first, then this one.
// Slovene has the legal texts only, so a link to any other page goes to
// English and says so.
templ TafsPrivacySL() {
	@components.LayoutSiteWithMeta("pravilnik o zasebnosti tafs", "Kako tafs, aplikacija KIFF, ravna z osebnimi podatki, vključno s podatki, ki jih prejme od Googla, ko povežete svoj račun Google.", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · pravilnik o zasebnosti</p>
				<h1>Pravilnik o zasebnosti tafs</h1>
				<p class="legal-meta"><strong>Zadnja posodobitev:</strong> 21. novembra 2026.</p>
				<p class="legal-disclaimer">Ta pravilnik pojasnjuje, kako tafs, aplikacija KIFF za iPhone, iPad, Android in računalnike, ravna z osebnimi podatki. tafs je del KIFF Cloud, zato zanj velja tudi <a href="/sl/privacy">pravilnik o zasebnosti KIFF</a>, in to za vse, česar ta stran ne ureja. Vprašanja: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.</p>
			</header>
			<section id="who-we-are">
				<h2>1. Kdo smo</h2>
				<p>tafs zagotavlja <strong>Kiff Agents OÜ</strong>, družba z omejeno odgovornostjo, ustanovljena v Estoniji (registrska številka 17372313, identifikacijska številka za DDV EE102924327), na naslovu Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estonija. Za našo obdelavo velja splošna uredba EU o varstvu podatkov (GDPR).</p>
			</section>
			<section id="scope">
				<h2>2. Na kaj se ta pravilnik nanaša</h2>
				<p>Na aplikacijo tafs za iPhone, iPad, Android in računalnike (Mac, Windows in Linux) ter storitev v njenem ozadju, vključno s Setupom, ki povezuje orodja podjetja, in planque, ki te povezave hrani. V tafs podjetje zaupa nalogo agentu AI, tafu, ki dela v okviru KIFF Cards.</p>
			</section>
			<section id="roles">
				<h2>3. Naše vloge</h2>
				<p>Smo <strong>upravljavec</strong> podatkov o vašem računu in prijavi ter operativnih podatkov naše lastne storitve. Kot <strong>obdelovalec</strong> v imenu vašega podjetja obdelujemo to, kar tafs hrani zanj: zagone, klepete, poročila in zapiske v spominu vsakega tafa ter datoteke, ki jih dostavijo. Upravljavec teh podatkov je vaše podjetje, to razmerje pa ureja <a href="/legal/dpa">DPA</a> (v angleščini).</p>
			</section>
			<section id="data">
				<h2>4. Kaj tafs zbira</h2>
				<ul>
					<li><strong>Vaš račun:</strong> v tafs se prijavite s svojim računom KIFF. Na telefonu ali tablici aplikacija hrani vašo sejo v Keychain naprave (v Androidu v njegovi šifrirani shrambi). Na računalniku jo hrani zapečateno za vaš uporabniški račun: na računalniku z Windows z lastno zaščito podatkov sistema Windows, v Linuxu v vaši zbirki ključev, na Macu v njegovem Keychain. Seja na računalniku traja največ 90 dni.</li>
					<li><strong>Vaša naprava:</strong> aplikacija ustvari podpisni ključ, ki nikoli ne zapusti naprave: v Secure Enclave iPhona, iPada ali Maca, v Keystore naprave z Androidom ali v TPM računalnika z Windows. V Linuxu in na Macu brez Secure Enclave je ključ programski ključ, shranjen v vaši zbirki ključev ali v Keychain, in tak računalnik lahko prikaže, kaj vas čaka, ne more pa tega odobriti; odobrite na telefonu{ macSecurityKey("sl") }. Računalnik z Windows brez TPM se v tafs ne more prijaviti. KIFF hrani javno polovico ključa, ime in platformo naprave ter kdaj je bila dodana in nazadnje uporabljena, da lahko preverja vaše odgovore na zadržane klice in vaše odobritve povezav.</li>
					<li><strong>Vaša ura:</strong> ura ne hrani nobenega gesla ali ključa, komunicira samo z vašim seznanjenim telefonom in nikoli ničesar ne odobri. To, kar rečete Coachu ali tafu, ki ste ga izbrali, pošlje samo kot besedilo, prek telefona, in šele ko ste dovolili AI. Vaše besede v to besedilo pretvori lastna storitev za prepoznavanje govora ure, Applova ali Googlova. Če se v sistemu Wear OS ustavi, preden končate, to namesto nje opravi lastni prepoznavalnik vašega telefona, na telefonu. Zavrne, ustavi ali pošlje nekaj Coachu ali tafu lahko le, kadar ima zaklep zaslona ali kodo in je odklenjena. To, kar pošljete tafu, gre v lastni klepet tega tafa, kot da bi to napisali na telefonu. Klepet tafa, vključno z zneski, se na uri prikazuje samo, dokler je odprt, in se vsakič prebere prek telefona; ura od njega ne hrani ničesar.</li>
					<li><strong>Apple Watch:</strong> prikazuje vaše tafe in njihove strani, ne da bi jih hranila. Hrani samo vaš Nabiralnik, v datoteki, ki je ne more brati, ko je zaklenjena: vsak zadržan klic kot ime njegovega tafa in to, kar prosi, nikoli znesek, ter Coachove odgovore na to, kar ste poslali z ure, kot besedilo. Če se na uri odjavite, hrani tudi to, da ste se, dokler se na uri znova ne prijavite. Razen tega ne hrani ničesar, če ura nima kode. Nabiralnik izgine, ko se odjavite na uri ali se odjavi vaš iPhone, ali ko se aplikacija naslednjič odpre ali zapre brez kode. Ne ustvari nobenega posnetka in edina obvestila, ki jih prikazuje, so obvestila vašega iPhona.</li>
					<li><strong>Wear OS:</strong> prikazuje e-poštni naslov vašega računa in današnji koledar, ne da bi ju hranila. Da se odpre takoj, šifrirano hrani število tega, kar vas čaka, ter ime vsakega tafa in ali je ustavljen ali začasno ustavljen: nikoli zneska, podrobnosti zadržanega klica ali klepeta tafa. To se izbriše, ko se odjavite, ko se ura zaklene ali jo snamete z zapestja, in po 24 urah. Hrani vaš Nabiralnik, kjer je vsaka vrstica ime tafa in to, kar pravi, nikoli znesek, ter eno sporočilo, shranjeno za pozneje, kot besedilo. Odjava, na uri ali na telefonu, vse to izbriše. Za svojo ploščico hrani tudi število tega, kar vas čaka, prikazano le, ko je ura odklenjena, in izbrisano, ko se odjavite, ali ko se ploščica naslednjič prikaže, ko je ura zaklenjena ali nima zaklepa zaslona. Po odjavi na uri hrani zapisek, da ste se odjavili, dokler se znova ne prijavite. Nabiralnik izgine tudi, ko se aplikacija naslednjič odpre ali zapre, ko je ura zaklenjena ali nima zaklepa zaslona. Sporočilo, shranjeno za pozneje, ostane, dokler ga ne pošljete ali izbrišete, ker ste zahtevali, da se pošlje. Če se storitev za prepoznavanje govora ure ustavi, preden končate, ura pošlje posnetek vašemu telefonu, ki ga pretvori v besedilo na samem telefonu, nikoli na strežniku. Posnetek se izbriše na obeh, ko se besedilo vrne ali prekličete, in najpozneje po 2 minutah. Coachu ali vašemu tafu gre naprej samo besedilo. Rezultat tafa lahko ostane med obvestili ure, dokler ga ne zavrnete ali se na uri ne odjavite.</li>
					<li><strong>Ključi za dostop:</strong> ko odobrite s ključem za dostop na računalniku, na primer z Windows Hello ali varnostnim ključem, vaš obraz, prstni odtis ali PIN ostane v lastnem sistemu računalnika. KIFF hrani javni ključ ključa za dostop, njegov ID, števec in ime, nikoli nič skrivnega, in zavrne ključ za dostop, ki se sinhronizira z drugimi napravami.</li>
					<li><strong>Opozorila:</strong> na telefonu, tablici ali Macu z aplikacijo za iPad, ko jih vklopite, hranimo potisni žeton naprave z vašim ID-jem osebe v KIFF in jezikom, ki ga je aplikacija prikazovala. Opozorilo gre prek Appla ali Googla samo s tem, za kateri taf gre in kaj želi, v opozorilu vrat pa z imenom ali e-poštnim naslovom tistega, ki je pisal: nikoli z zneskom ali podrobnostmi zahteve. Te doda aplikacija na sami napravi, od KIFF, tako da lahko opozorilo na odklenjenem telefonu prikaže znesek, trgovca ali osebo. Na zaklenjenem telefonu z Androidom prikaže samo »Taf vas potrebuje«, na zaklenjenem iPhonu prav tako, razen če ste nastavili, da se predogledi prikazujejo vedno. Na računalniku z Windows, računalniku z Linuxom ali Macu z aplikacijo za macOS 12 opozorila ustvari aplikacija sama, dokler teče, brez potisnega žetona in brez katerega koli drugega podjetja. V Windows in Linuxu prikazujejo, za kateri taf gre, kaj želi narediti, znesek, zakaj in do kdaj; v aplikaciji za macOS 12 prikazujejo besede KIFF za klic, ko jih vklopite, zaklenjen zaslon pa prikaže to, kar dovoli nastavitev predogledov na Macu. V Windows so izklopljena, dokler jih ne vklopite, in ko je zaslon zaklenjen, prikazujejo samo »Taf vas potrebuje«. Opozorilo, prikazano pred zaklepom zaslona, ohrani svoje podrobnosti na seznamu obvestil Windows. V Linuxu so vklopljena, dokler jih ne izklopite, kaj prikaže zaklenjen zaslon, pa je odvisno od vašega namizja.</li>
					<li><strong>Jezik:</strong> storitev tafs hrani jezik računa, glede na to, kdo je nazadnje klepetal s Coachem, največ tri mesece, da poročila tafa prihajajo v tem jeziku.</li>
					<li><strong>Vaša orodja:</strong> ko povežete orodje, se prijavite pri lastnem ponudniku orodja. Za aplikacijo, v katero se planque prijavi sam, na primer Stripe, ali za ključ, ki ga vnesete, planque ta žeton ali ključ za vaše podjetje hrani šifrirano. Pri upravljani povezavi prijavo hrani Composio, storitev za povezave, s katero sodeluje planque, planque pa hrani samo zapis povezave in orodja, ki ste jih odobrili (glejte <a href="#google">Uporabniški podatki Google</a>). Zapis povezave lahko vključuje račun, v katerega je prijavljena (njegovo ime ali e-poštni naslov), da vam aplikacija lahko pokaže, za katerega gre. KIFF uporablja upravljane povezave samo za aplikacije, navedene na <a href="/subprocessors#composio">/subprocessors</a> (v angleščini).</li>
					<li><strong>Vaš brskalnik (Chrome):</strong> Ko seznanite razširitev tafs s svojim telefonom, lahko taf dela v seznanjenem profilu Chrome, samo na spletnih mestih, ki jih navaja njegova povezava. Odpira lastne zavihke v skupini zavihkov, ki jo vidite in jo lahko začasno ustavite ali ustavite, in se začasno ustavi, ko se dotaknete enega od njih. Te strani bere kot besedilo in polja obrazcev, brez polj za geslo, kartico in kodo, nikoli vaših drugih zavihkov ali drugih spletnih mest, in ne posname zaslonskih slik. To besedilo gre kot del zagona našemu ponudniku AI in se hrani z zagonom kot rezultat vsakega orodja. Vsak korak se zapiše v dnevnik s spletnim mestom in imenom polja, nikoli s tem, kar je bilo vpisano v skrito polje. Za vsako spremembo, ki jo naredi taf, KIFF hrani stran pred in po, kot besedilo brez teh polj, največ 30 dni, in jo izbriše prej, če povezavo prekinete ali izbrišete svoj račun. Te strani lahko prikazujejo podatke drugih oseb, na primer vaših strank; KIFF jih obdeluje za vas kot obdelovalec. Razširitev hrani lasten ključ v vašem računalniku in, če tako izberete, prijavne podatke, zapečatene tako, da jih odpre samo vaša odobritev v telefonu, za eno izpolnitev prav na tem spletnem mestu. KIFF jih nikoli ne hrani. S Coachem lahko govorite tudi iz stranske plošče razširitve; Coach vidi stran samo, ko kliknete »Share this page« in v Chromu spletnemu mestu dovolite tafs, in potem samo to stran, prebrano na enak način, kot del vašega klepeta. Prekinitev seznanitve ali odstranitev izbriše, kar razširitev hrani. Taf nikoli ne plača in ne izpolni zapečatene prijave brez vaše odobritve v telefonu.</li>
					<li><strong>Delo vaših tafov:</strong> zagoni, klepeti, poročila in zapiski v spominu vsakega tafa ter datoteke, ki jih dostavijo, ki jih hranimo kot obdelovalec. Datoteke, ki jih dostavijo vaši tafi, lahko vidijo vsi v vašem računu.</li>
					<li><strong>Nakupi:</strong> Solo in pakete kreditov prodaja Apple prek App Store ali Google prek obračunavanja Google Play. Sporočita nam, kaj je bilo kupljeno, za kateri račun KIFF (naključni ID), kdaj, ter sklice svoje transakcije ali naročila. Ne sporočita nam vašega Apple ID-ja ali računa Google, imena, e-poštnega naslova ali kartice.</li>
				</ul>
				<p>Aplikacija nima analitičnih ali oglaševalskih sledilnikov.</p>
			</section>
			<section id="ai">
				<h2>5. AI v tafs</h2>
				<p>tafs za Coacha in vaše tafe uporablja AI Claude podjetja Anthropic. Aplikacija vas vpraša, preden karkoli gre k njej.</p>
				<ul>
					<li>Kaj se ji pošlje: kar pišete Coachu in svojim tafom, datoteke, ki jih priložite, kar vaše povezane aplikacije vrnejo tafu med delom, in kar je na vašem zaslonu, ko vam Coach pomaga v aplikaciji.</li>
					<li>Česa se nikoli ne pošlje: gesel in ključev, ki jih uporabljajo vaše povezane aplikacije, ali vašega prstnega odtisa.</li>
					<li>Anthropic to uporabi za odgovor in hrani največ 30 dni.</li>
					<li>Nič se ne pošlje, dokler tega ne dovolite. Privolitev lahko prekličete v Računu.</li>
				</ul>
				<p>Ko privolitev prekličete, vam Coach in vaši tafi prenehajo odgovarjati, taf, katerega zagoni temeljijo na vaši privolitvi, pa se začasno ustavi. Podrobnosti so v <a href="/sl/privacy#ai-in-tafs">pravilniku o zasebnosti KIFF</a>.</p>
			</section>
			@tafsPrivacyGoogleSL()
			<section id="sharing">
				<h2>7. Kdo še prejme podatke</h2>
				<p>Vaših osebnih podatkov ne prodajamo in jih ne delimo za oglaševanje.</p>
				<p>Za tafs uporabljamo ta podjetja: Amazon Web Services (gostovanje, vključno s shrambo tafs in povezavami planque), Clerk (prijava za račune KIFF), Anthropic (model AI), Composio (prijave upravljanih povezav in klici, za katere ga prosi planque), Apple (potisna opozorila), Google (potisna opozorila v Androidu in obračunavanje Google Play) in Resend (e-poštna vrata tafa). Uradni, aktualni seznam, s tem, česa se posamezno podjetje dotika in kje, je na <a href="/subprocessors">/subprocessors</a> (v angleščini).</p>
				<p>Nekatera od njih so zunaj Evropskega gospodarskega prostora, večinoma v Združenih državah. <a href="/sl/privacy#transfers">Pravilnik o zasebnosti KIFF</a> pove, kako so ti prenosi zavarovani.</p>
				<p><strong>Vaša država.</strong> Zakoni nekaterih držav zahtevajo več, kot pove ta pravilnik. Kaj dodajajo, v angleščini in v jeziku države, je na strani <a href="/privacy/countries">Vaša država</a>.</p>
			</section>
			<section id="retention">
				<h2>8. Kako dolgo jih hranimo</h2>
				<ul>
					<li>Kar vaša orodja vrnejo tafu: samo do konca zagona. V klepetu se to, kar je le prebral, hrani šifrirano za njegova naslednja sporočila, uporablja se, dokler klepet ni eno uro nedejaven, in največ štiri ure po branju, nato se samodejno izbriše, v nekaj dneh.</li>
					<li>Zagoni in klepeti tafa, s povzetkom klepeta: 30 dni. Njegovi zapiski v spominu: dokler taf ni odstranjen.</li>
					<li>Coachovi kratki zapiski za naslednji odgovor, na primer zakaj povezave v klepetu ni bilo mogoče vzpostaviti ali da je bil Card odobren: dokler jih ta odgovor ne prevzame, največ 7 dni; po tem kot del tega klepeta, dokler se klepet hrani. Kopija se hrani 24 ur, da ponovno poslano sporočilo dobi isti zapisek. Zapisek klepeta se uporablja samo v tem klepetu.</li>
					<li>Datoteke, ki jih priložite v klepetu: s sporočilom, ki so mu priložene, 30 dni, ali prej, če je klepet odstranjen, in v vsakem primeru v 38 dneh. Datoteka, ki je ne uporablja nobeno sporočilo, se odstrani približno eno uro po nalaganju. Izbris računa jih izbriše.</li>
					<li>Datoteke, ki jih dostavijo vaši tafi: 30 dni od trenutka, ko jih je zagon ustvaril, nato se samodejno izbrišejo v enem dnevu. Kdor koli v vašem računu lahko eno izbriše prej z Izbriši zdaj: sama datoteka izgine takoj, brez shranjene kopije; njeno ime, velikost ter taf in zagon, ki sta jo ustvarila, lahko ostanejo v šifriranih kopijah shrambe tafs na določeno točko v času največ 35 dni, uporabljajo pa se samo za obnovitev po okvari. Odstranitev tafa ali izbris računa izbriše njegove datoteke. Deljenje datoteke pošlje samo datoteko, kopija, ki jo delite, pa ostane v aplikaciji, s katero ste jo delili. Za prenos datoteke ustvarimo povezavo za prijavljenega člana vašega računa, ki preneha delovati po eni minuti; nobene druge povezave do nje ne ustvarimo.</li>
					<li>Kar je orodje vrnilo, v zapisu planque o vsakem klicu: 24 ur. Po tem zapis hrani samo, ali je bil klic poslan, da se nikoli ne pošlje dvakrat.</li>
					<li>Žeton ali ključ povezave v planque ali prijava upravljane povezave pri Composiu: dokler je ne prekinete. Če lahko isti račun pri tem ponudniku uporablja druga od vaših povezav, se hrani, neuporabljen, dokler ne prekinete tudi te, nato se prekliče. Zapis njenih odobritev: do konca računa.</li>
					<li>Potisni žeton naprave: dokler se ne odjavite iz aplikacije, ne odstranite naprave ali Apple ali Google ne sporoči, da žetona ni več. Javni ključ, ime, platforma in datumi naprave: dokler jo uporabljate; ko jo odjavite, se označi kot odstranjena in hrani do izbrisa računa, da lahko KIFF zavrne njen pozni odgovor in pokaže, katera naprava je podpisala prejšnjega. Javni ključ, ID in ime ključa za dostop: kot podatki njegove naprave. Seja računalnika: največ 90 dni ali do odjave.</li>
					<li>Vaš račun: dokler ni izbrisan. Dnevniki storitev: 30 dni. Shrambi tafs in planque hranita šifrirane kopije na določeno točko v času 35 dni, ki se uporabljajo samo za obnovitev shrambe po okvari.</li>
				</ul>
				<p>Vse drugo je v <a href="/sl/privacy#retention">razdelku o hrambi v pravilniku KIFF</a>.</p>
			</section>
			<section id="lawful-bases">
				<h2>9. Pravne podlage</h2>
				<p>Izvajanje pogodbe, za upravljanje vašega računa in vaših tafov. Zakoniti interesi, za varnost, preprečevanje goljufij in odkrivanje zlorab. Privolitev, za AI v tafs (<a href="#ai">razdelek 5</a>). Pravna obveznost, za davčne evidence. Podrobnosti so v <a href="/sl/privacy#lawful-bases">pravilniku o zasebnosti KIFF</a>.</p>
			</section>
			<section id="rights">
				<h2>10. Vaše pravice</h2>
				<p>V skladu z GDPR lahko zahtevate dostop do svojih podatkov, njihov popravek, izbris, omejitev ali prenosljivo kopijo, ugovarjate obdelavi na podlagi zakonitih interesov in prekličete privolitev. Pišite na <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>; odgovorimo v enem mesecu. V aplikaciji Račun → Izvozi moje klepete prenese vaše lastne klepete in zapiske.</p>
				<p>Za izbris računa tafs odprite aplikacijo, pojdite v Račun in tapnite <em>Izbriši račun</em>, nato potrdite. Tega ni mogoče razveljaviti. <a href="/sl/privacy#delete-account">Pravilnik o zasebnosti KIFF</a> pove, kaj se izbriše in kdaj ter kako to zahtevate po e-pošti.</p>
				<p>Pritožbo lahko vložite pri <a href="https://www.aki.ee/en" target="_blank" rel="noopener">estonskem inšpektoratu za varstvo podatkov (Andmekaitse Inspektsioon)</a> ali pri nadzornem organu v kraju, kjer živite.</p>
				<p><strong>Vaša država.</strong> Zakoni nekaterih držav zahtevajo več, kot pove ta pravilnik. Kaj dodajajo, v angleščini in v jeziku države, je na strani <a href="/privacy/countries">Vaša država</a>.</p>
			</section>
			<section id="more">
				<h2>11. Varnost, otroci in spremembe</h2>
				<p>Naši varnostni ukrepi so na <a href="/security">/security</a> (v angleščini). tafs ni namenjen otrokom in zavestno ne zbiramo osebnih podatkov otrok, mlajših od 16 let. Ta pravilnik spreminjamo tako, kot <a href="/sl/privacy#changes">pravilnik o zasebnosti KIFF</a> določa za svojega.</p>
			</section>
			<section id="contact">
				<h2>12. Kontakt</h2>
				<p>Vprašanja in zahteve glede zasebnosti: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>. Uradna pravna obvestila: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>. Lastni pogoji aplikacije so na <a href="/sl/tafs/terms">/tafs/terms</a>.</p>
			</section>
		</article>
	}
}

// tafsPrivacyGoogleSL is tafsPrivacyGoogle in Slovene. Google's Limited Use
// statement stays in Google's own words, in English.
templ tafsPrivacyGoogleSL() {
	<section id="google">
		<h2>6. Uporabniški podatki Google</h2>
		if len(googleManaged()) == 0 && len(googleInHouse("sl")) > 0 {
			<p>Ko to zahtevate, tafs poveže taf z vašim računom Google, na primer z Google Sheets ali Google Calendar, ki ju uporablja njegova naloga, v razdelku aplikacije Poveži aplikacije. Ta razdelek pove, kaj tafs počne s podatki, ki jih prejme od Googla.</p>
		} else {
			<p>Ko to zahtevate, tafs poveže taf z vašim računom Google, na primer z vašim Gmailom ali z Google Calendar ali Google Sheets, ki ju uporablja njegova naloga, v razdelku aplikacije Poveži aplikacije. Ta razdelek pove, kaj tafs počne s podatki, ki jih prejme od Googla.</p>
		}
		<ul>
			if len(googleManaged()) == 0 && len(googleInHouse("sl")) > 0 {
				<li><strong>Kaj bere in piše:</strong> kar potrebuje naloga tafa: preglednice, ki jih posodablja, ali dogodke v koledarjih, za katere skrbi. Spreminja jih samo tam, kjer to dovoli Card tafa, vse, kar presega omejitve Card, pa čaka na vašo odobritev.</li>
			} else {
				<li><strong>Kaj bere in piše:</strong> kar potrebuje naloga tafa. V vašem Gmailu bere vaša sporočila in niti, da najde tista, na katera je treba odgovoriti, in piše osnutke; pošto pošlje samo tam, kjer to dovoli Card tafa. V Google Calendar in Google Sheets bere dogodke v koledarjih, za katere skrbi, ali preglednice, ki jih posodablja, in jih spreminja samo tam, kjer to dovoli Card tafa.
					if googleListed("Google Tasks") {
						V Google Tasks bere sezname opravil, za katere skrbi, ter dodaja, dokonča, premika ali briše opravila samo tam, kjer to dovoli Card tafa.
					}
					Vse, kar presega omejitve Card, čaka na vašo odobritev.</li>
			}
			<li><strong>Zakaj:</strong> samo za opravljanje naloge, ki ste jo nastavili za ta taf, in da vam pokaže, s katerim računom Google je povezan: njegov e-poštni naslov, ki se hrani s povezavo, dokler je ne prekinete.</li>
			if len(googleManaged()) > 0 || len(googleInHouse("sl")) > 0 {
				<li>
					<strong>Kako se poveže posamezna aplikacija Google:</strong>
					<ul>
						if len(googleManaged()) > 0 {
							<li>Prek našega partnerja za prijavo, navedenega na <a href="/subprocessors">/subprocessors</a> (v angleščini): { appList(googleManaged()) }.</li>
						}
						if len(googleInHouse("sl")) > 0 {
							<li>Prek lastne prijave Google aplikacije tafs, brez drugega podjetja vmes: { appList(googleInHouseNames()) }.</li>
						}
					</ul>
					if googleBoth() {
						Aplikacija, navedena v obeh, se poveže na en ali drug način, odvisno od vašega računa. Googlova lastna stran za prijavo pokaže, kateri dovolite.
					}
				</li>
			}
			if googleBoth() {
				<li>
					<strong>Kaj dovolite:</strong> prijavite se na Googlovi lastni strani in izberete, kaj boste dovolili.
					<ul>
						<li><strong>Prek našega partnerja za prijavo:</strong> tafs zahteva samo dostop, ki ga potrebujejo orodja tafa. Če ožji dostop ni mogoč, zahteva običajni dostop aplikacije in to pove, preden se prijavite. Če bi običajni dostop vključeval osebne podatke, ki jih taf ne uporablja, se tafs ne poveže.</li>
						<li><strong>Prek lastne prijave Google aplikacije tafs:</strong> prijava naenkrat zahteva ves spodaj naveden dostop za to aplikacijo, tudi kadar taf samo bere.</li>
					</ul>
				</li>
			} else if len(googleInHouse("sl")) > 0 {
				<li><strong>Kaj dovolite:</strong> prijavite se na Googlovi lastni strani in izberete, kaj boste dovolili. Prijava naenkrat zahteva ves spodaj naveden dostop za to aplikacijo, tudi kadar taf samo bere.</li>
			} else {
				<li><strong>Kaj dovolite:</strong> prijavite se na Googlovi lastni strani in izberete, kaj boste dovolili. tafs zahteva samo dostop, ki ga potrebujejo orodja tafa. Če ožji dostop ni mogoč, zahteva običajni dostop aplikacije in to pove, preden se prijavite. Če bi običajni dostop vključeval osebne podatke, ki jih taf ne uporablja, se tafs ne poveže.</li>
			}
			<li><strong>Kako jih taf uporablja:</strong> taf uporablja samo orodja, odobrena v njegovem Card. Vsak klic se preveri glede na dovoljenje za točno to orodje in te argumente, preden se karkoli pošlje, klic zunaj dostopa, ki ste ga dali, pa se zavrne. Katera dejanja vsakič zahtevajo vašo odobritev, je določeno v Card.</li>
			if len(googleInHouse("sl")) > 0 {
				<li>
					if googleBoth() {
						<strong>Dostop, ki ga zahteva lastna prijava Google aplikacije tafs:</strong>
					} else {
						<strong>Dostop, ki ga zahteva tafs:</strong>
					}
					<ul>
						for _, a := range googleInHouse("sl") {
							<li>
								{ a.Name }
								<ul>
									for _, s := range a.Scopes {
										<li><code>{ s.ID }</code>: { s.What }</li>
									}
								</ul>
							</li>
						}
					</ul>
					Ne glede na to, koliko prijava dovoli, taf uporablja samo orodja v svojem Card.
				</li>
			}
			if googleBoth() {
				<li>
					<strong>Kdo hrani vašo prijavo:</strong>
					<ul>
						<li><strong>Prek našega partnerja za prijavo:</strong> vašo prijavo Google hrani naš partner za prijavo, naveden na <a href="/subprocessors">/subprocessors</a> (v angleščini), in je nikoli ne da tafu ali planque. Ne taf ne tafs ne vidita vašega gesla ali vaših žetonov Google. Drug vaš taf, ki potrebuje enak dostop, prijavo uporabi znova, vsak taf pa uporablja samo orodja, ki ste mu jih odobrili.</li>
						<li><strong>Prek lastne prijave Google aplikacije tafs:</strong> planque, lastna storitev za povezave tafs, hrani vaš žeton Google za vaše podjetje, šifriran z AWS KMS v Evropski uniji (Irska), in ga uporablja samo za klic, ki ga dovoli Card tafa. Nikoli ga ne da tafu, ne taf ne model AI pa ne vidita vašega gesla ali vaših žetonov Google. Drug vaš taf, ki potrebuje enak dostop, prijavo uporabi znova, vsak taf pa uporablja samo orodja, ki ste mu jih odobrili.</li>
					</ul>
				</li>
			} else if len(googleInHouse("sl")) > 0 {
				<li><strong>Kdo hrani vašo prijavo:</strong> planque, lastna storitev za povezave tafs, hrani vaš žeton Google za vaše podjetje, šifriran z AWS KMS v Evropski uniji (Irska), in ga uporablja samo za klic, ki ga dovoli Card tafa. Nikoli ga ne da tafu, ne taf ne model AI pa ne vidita vašega gesla ali vaših žetonov Google. Drug vaš taf, ki potrebuje enak dostop, prijavo uporabi znova, vsak taf pa uporablja samo orodja, ki ste mu jih odobrili.</li>
			} else {
				<li><strong>Kdo hrani vašo prijavo:</strong> vašo prijavo Google hrani naš partner za prijavo, naveden na <a href="/subprocessors">/subprocessors</a> (v angleščini), in je nikoli ne da tafu ali planque. Ne taf ne tafs ne vidita vašega gesla ali vaših žetonov Google. Drug vaš taf, ki potrebuje enak dostop, prijavo uporabi znova, vsak taf pa uporablja samo orodja, ki ste mu jih odobrili.</li>
			}
			if googleBoth() {
				<li>
					<strong>Kdo jih še prejme:</strong> kar taf prebere od Googla, gre k modelu AI, ki poganja taf, šele ko to dovolite (glejte <a href="#ai">AI v tafs</a>), ta pa to hrani največ 30 dni v skladu s pogoji svojega ponudnika.
					<ul>
						<li><strong>Prek našega partnerja za prijavo:</strong> gre tudi skozi našega partnerja za prijavo, ki izvede vsak klic.</li>
						<li><strong>Prek lastne prijave Google aplikacije tafs:</strong> planque kliče Google sam, zato klica ne izvede in vaše prijave ne hrani nobeno drugo podjetje.</li>
					</ul>
					Oba sta navedena na <a href="/subprocessors">/subprocessors</a> (v angleščini).
				</li>
			} else if len(googleInHouse("sl")) > 0 {
				<li><strong>Kdo jih še prejme:</strong> kar taf prebere od Googla, gre k modelu AI, ki poganja taf, šele ko to dovolite (glejte <a href="#ai">AI v tafs</a>), ta pa to hrani največ 30 dni v skladu s pogoji svojega ponudnika. planque kliče Google sam, zato klica ne izvede in vaše prijave ne hrani nobeno drugo podjetje. Ponudnik modela AI je naveden na <a href="/subprocessors">/subprocessors</a> (v angleščini).</li>
			} else {
				<li><strong>Kdo jih še prejme:</strong> kar taf prebere od Googla, gre k modelu AI, ki poganja taf, šele ko to dovolite (glejte <a href="#ai">AI v tafs</a>), ta pa to hrani največ 30 dni v skladu s pogoji svojega ponudnika. Gre tudi skozi našega partnerja za prijavo, ki izvede vsak klic. Oba sta navedena na <a href="/subprocessors">/subprocessors</a> (v angleščini).</li>
			}
			<li><strong>Učenje AI:</strong> uporabniški podatki Google se ne uporabljajo za učenje modelov AI.</li>
			<li><strong>Slike:</strong> tafs ne ustvarja in ne ureja slik ali videoposnetkov: njegova AI piše besedilo. Nikoli ne uporablja API-jev Google ali uporabniških podatkov Google za ustvarjanje, urejanje ali deljenje intimnih podob kogar koli (intimne podobe brez privolitve, NCII) ali katere koli druge podobe osebe.</li>
			if len(googleManaged()) == 0 && len(googleInHouse("sl")) > 0 {
				<li><strong>Kako dolgo in kje:</strong> vaše preglednice in dogodki ostanejo v vašem računu Google. V lastni shrambi tafs se to, kar vrne orodje, hrani samo do konca zagona tafa. planque, ki vsak klic posreduje naprej, hrani to, kar vrne Google, 24 ur, da ponovljen klic dobi enak odgovor in se nikoli ne pošlje dvakrat; po tem hrani samo, ali je bil klic poslan. V klepetu se to, kar je bilo le prebrano, hrani šifrirano, uporablja se, dokler klepet ni eno uro nedejaven, in največ štiri ure po branju, nato se samodejno izbriše, v nekaj dneh. Zapis zagona in njegov klepet se hranita 30 dni, zapiski tafa pa, dokler taf ne odstranite (glejte <a href="#retention">Kako dolgo jih hranimo</a>).</li>
			} else {
				<li><strong>Kako dolgo in kje:</strong> vaši osnutki, dogodki in preglednice ostanejo v vašem računu Google. V lastni shrambi tafs se to, kar vrne orodje, hrani samo do konca zagona tafa. planque, ki vsak klic posreduje naprej, hrani to, kar vrne Google, 24 ur, da ponovljen klic dobi enak odgovor in se nikoli ne pošlje dvakrat; po tem hrani samo, ali je bil klic poslan. V klepetu se to, kar je bilo le prebrano, hrani šifrirano, uporablja se, dokler klepet ni eno uro nedejaven, in največ štiri ure po branju, nato se samodejno izbriše, v nekaj dneh. Zapis zagona in njegov klepet se hranita 30 dni, zapiski tafa pa, dokler taf ne odstranite (glejte <a href="#retention">Kako dolgo jih hranimo</a>).</li>
			}
			<li>
				<strong>Kako to ustavite:</strong>
				<ul>
					<li>Prekinite povezavo z Googlom v aplikaciji, v Poveži aplikacije ali na zavihku Card tafa. Njegova orodja Google se takoj ustavijo, tafs pa Google takoj zaprosi za preklic prijave; to se lahko dokonča nekoliko pozneje.</li>
					<li>Odstranite taf in njegove povezave se končajo z njim. Prijava Google, ki jo še uporablja drug vaš taf, ostane, dokler ne izgine zadnji.</li>
					<li>Dostop tafs lahko kadar koli odstranite v svojem računu Google, na <a href="https://myaccount.google.com/permissions">myaccount.google.com/permissions</a>. Vaši tafi ne dosežejo več Googla, aplikacija pa vam pove, da je povezava Google odjavljena.</li>
					<li>Izbrišite svoj račun: njegovi tafi, klepeti, zapiski, datoteke in povezave se takoj izbrišejo, iz kopij na določeno točko v času pa v 35 dneh, njegovi žetoni Google pa se prekličejo, kjer Google to dovoli.</li>
				</ul>
			</li>
		</ul>
		<p lang="en">tafs's use and transfer to any other app of information received from Google APIs will adhere to <a href="https://developers.google.com/terms/api-services-user-data-policy">Google API Services User Data Policy</a>, including the Limited Use requirements.</p>
	</section>
}
