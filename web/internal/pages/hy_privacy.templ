package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// PrivacyHY is KIFF's privacy policy (/privacy) in Armenian, at /hy/privacy.
// It is a translation of Privacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Armenian has the legal
// texts only, so a link to any other page goes to English and says so.
templ PrivacyHY() {
	@components.LayoutSite("KIFF — privacy policy", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@privacyHeadHY()
			@privacyWhoWeAreHY()
			@privacyScopeHY()
			@privacyRolesHY()
			@privacyCategoriesHY()
			@privacyLawfulBasesHY()
			@privacySubprocessorsHY()
			@privacyTransfersHY()
			@privacyRetentionHY()
			@privacyRightsHY()
			@privacyCookiesHY()
			@privacySecurityHY()
			@privacyChildrenHY()
			@privacyAutomatedHY()
			@privacyChangesHY()
			@privacyContactHY()
		</article>
	}
}

templ privacyHeadHY() {
	<header class="legal-head">
		<p class="legal-badge">Գաղտնիության քաղաքականություն · v0.1</p>
		<h1>Գաղտնիության քաղաքականություն</h1>
		<p class="legal-meta">
			<strong>Վերջին թարմացում՝</strong> 2026 թվականի նոյեմբերի 24։ <strong>Ուժի մեջ մտնելու ամսաթիվ՝</strong> 2026 թվականի մայիսի 24։
		</p>
		<p class="legal-disclaimer">
			Այս քաղաքականությունը բացատրում է, թե ինչպես է KIFF Cloud-ը մշակում անձնական տվյալները կայքում, վահանակում, API-ում և tafs հավելվածում iPhone-ի, iPad-ի, Android-ի և համակարգիչների համար։ Հարցեր՝ <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>։
		</p>
	</header>
}

templ privacyWhoWeAreHY() {
	<section id="who-we-are">
		<h2>1. Ով ենք մենք</h2>
		<p>
			KIFF Cloud-ը շահագործվում է <strong>Kiff Agents OÜ</strong>-ի կողմից՝ Էստոնիայում հիմնադրված սահմանափակ պատասխանատվությամբ մասնավոր ընկերության։ Գրանցման տվյալներ՝
		</p>
		<ul>
			<li><strong>Գրանցման կոդ՝</strong> 17372313 (Էստոնիայի e-Business Register)</li>
			<li><strong>ԱԱՀ համար՝</strong> EE102924327</li>
			<li><strong>Գրանցված հասցե՝</strong> Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Էստոնիա</li>
			<li><strong>Կապ գաղտնիության հարցերով՝</strong> <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a></li>
			<li><strong>Պաշտոնական իրավական ծանուցումներ՝</strong> <a href="mailto:legal@kiff.dev">legal@kiff.dev</a></li>
		</ul>
		<p>
			Քանի որ Kiff Agents OÜ-ն հիմնադրված է Եվրոպական միությունում, Եվրոպական միության տվյալների պաշտպանության ընդհանուր կանոնակարգը (<abbr title="General Data Protection Regulation">GDPR</abbr>) ուղղակիորեն կիրառվում է մեր մշակման նկատմամբ։ Մեզ չի պահանջվում ԵՄ ներկայացուցիչ 27-րդ հոդվածի համաձայն։
		</p>
	</section>
}

templ privacyScopeHY() {
	<section id="scope">
		<h2>2. Այս քաղաքականության շրջանակը</h2>
		<p>
			Այս քաղաքականությունը ներառում է անձնական տվյալները, որոնք մշակում ենք, երբ դուք փոխգործակցում եք՝
		</p>
		<ul>
			<li><a href="https://kiff.dev"><code>kiff.dev</code></a> — մեր մարքեթինգային կայքը, այս քաղաքականության էջը և անդորրագրերի հանրային ցուցադրման մակերեսը։</li>
			<li><a href="https://app.kiff.dev"><code>app.kiff.dev</code></a> — մեր նույնականացված վահանակը։</li>
			<li><a href="https://api.kiff.dev"><code>api.kiff.dev</code></a> — մեր HTTP API-ն։</li>
			<li id="tafs"><strong>tafs</strong> — մեր հավելվածը iPhone-ի, iPad-ի, Android-ի և համակարգիչների (Mac, Windows և Linux) համար և դրա հետևում գտնվող ծառայությունը (ներառյալ Setup-ը, որը կապում է ընկերության գործիքները, և planque-ը, որը պահում է այդ կապերը), որտեղ ընկերությունը աշխատանք է վստահում AI գործակալի, որն աշխատում է KIFF Card-երի շրջանակներում։</li>
		</ul>
		<p>
			Այս քաղաքականությունը <em>չի</em> ներառում <code>kiff/kiff</code> բաց կոդով շրջանակը, որը կարող եք ինքներդ գործարկել։ Երբ շրջանակը գործարկում եք սեփական ենթակառուցվածքում, դուք եք այն մշակվող ցանկացած տվյալի վերահսկիչը, և Kiff Agents OÜ-ն այդ մշակման մեջ չի մասնակցում։
		</p>
	</section>
}

templ privacyRolesHY() {
	<section id="roles">
		<h2>3. Մեր դերերը GDPR-ի համաձայն</h2>
		<p>
			Մենք գործում ենք երկու դերում՝ կախված տվյալներից՝
		</p>
		<ul>
			<li>
				<strong>Վերահսկիչ</strong> հաշվի և մուտքի մետատվյալների, վճարման տվյալների (երբ վճարումը ակտիվ է), ձեր համաձայնությամբ ստացվող մարքեթինգային հաղորդագրությունների և մեր ծառայության գործառնական հեռաչափության համար։
			</li>
			<li>
				<strong>Մշակող</strong> աուդիտի տվյալների, գործողությունների գրառումների, որոշումների հաստատագրերի և runtime-ով մեր հաճախորդների անունից անցնող այլ բովանդակության համար, ինչպես նաև այն տվյալների համար, որոնք tafs-ը պահում է նրանց համար (յուրաքանչյուր taf-ի գործարկումները, զրույցները, հաշվետվությունները, հիշողության նշումները և ֆայլերը, որոնք այն հանձնում է)։ Հաճախորդները (թենանտները) այդ տվյալների վերահսկիչներն են. նրանք մեզ ցուցումներ են տալիս հաշվի կարգավորումների և դոմենի կազմաձևման միջոցով։ Տվյալների մշակման համաձայնագիրը (<abbr title="Data Processing Agreement">DPA</abbr>) կարգավորում է այդ հարաբերությունը. հրապարակված պայմանների համար տե՛ս <a href="/legal/dpa">DPA-ի ձևանմուշը</a> (անգլերեն)։
			</li>
		</ul>
		<p>
			Այս քաղաքականությունը հիմնականում վերաբերում է մեր մշակմանը որպես վերահսկիչ։ Երբ նշում ենք մշակողի կողմից մշակվող տվյալներ, DPA-ն ավելի կոնկրետ փաստաթուղթ է։
		</p>
	</section>
}

templ privacyCategoriesHY() {
	<section id="categories">
		<h2>4. Անձնական տվյալների կատեգորիաները, որոնք մշակում ենք</h2>
		<p>
			Ստորև նշված կատեգորիաները համապատասխանում են <a href="/security#data-we-process">/security#data-we-process</a> (անգլերեն) հասցեի տեխնիկական ցանկին։ Որտեղ երկուսը տարբերվում են, տեխնիկական էջը ճշմարտության աղբյուրն է, և մենք թարմացնում ենք այս բաժինը, որպեսզի համընկնի։
		</p>
		<ul>
			<li>
				<strong>Հաշվի նույնականացուցիչներ</strong> — ձեր նույնականացման սուբյեկտը (տրված մեր ինքնության մատակարարի կողմից) և էլ. փոստի հասցեն, որով մուտք եք գործում։ Պահվում է անփոփոխ. պահման ժամանակ հեշավորումը նախատեսված է։
				Եթե միացնեք էլ. փոստով ուղարկվող կոդով մուտքը (այն անջատված է, քանի դեռ չեք միացրել), KIFF-ը պահում է այդ կարգավորումը ձեր մուտքի նույնացուցիչի և փոփոխության ամսաթվի հետ։ Էլ. փոստով ձեզ ուղարկված կոդը պահվում է միայն բանալիով հեշի տեսքով՝ մինչև այն օգտագործվի կամ անցնի տասը րոպե։ Չարաշահումը սահմանափակելու համար մենք մինչև մեկ օր պահում ենք հարցումների քանակը՝ ըստ հարցրած հասցեի և IP հասցեի բանալիով հեշի։ Կոդով մուտք գործելուց հետո դա նշում ենք մեկ քառորդ ժամ, որպեսզի թարմ մուտք պահանջող փոփոխությունները ձեզ խնդրեն մուտք գործել այլ կերպ։
			</li>
			<li>
				<strong>Թենանտի մետատվյալներ</strong> — թենանտի id, slug, ցուցադրվող անուն, ստեղծման ժամանակ և լեզուն, որն յուրաքանչյուր մարդու հավելվածը վերջին անգամ օգտագործել է, որպեսզի KIFF-ի ուղարկած նամակները այդ լեզվով հասնեն։
			</li>
			<li>
				<strong>API հավատարմագրեր</strong> — API բանալիների անթափանց գրառումներ (պահում ենք հեշեր, երբեք բաց տեքստ)։
			</li>
			<li>
				<strong>Նիստի cookie-ի տվյալներ</strong> — HMAC-ով ստորագրված նիստի cookie, որը դրվում է մուտքից հետո։ Տե՛ս cookie-ների բաժինը ստորև։
			</li>
			<li>
				<strong>HTTP հարցման մետատվյալներ</strong> — IP հասցե, user agent, հարցման ուղի, պատասխանի կարգավիճակ, ուշացում։ Պահվում են մեր հակադարձ պրոքսիի մուտքի մատյաններում սահմանափակ ժամկետով անվտանգության և չարաշահումների կանխարգելման համար։
			</li>
			<li>
				<strong>Թենանտի կողմից վերահսկվող բովանդակություն</strong> — <code>parameters</code>, <code>actor</code> և <code>entity</code> տվյալները, որոնք ուղարկում եք runtime-ին։ Սա պահում ենք <em>որպես մշակող</em> հաճախորդի անունից. հաճախորդը պատասխանատու է այն բանի համար, ինչ հայտնվում է ցանցում։ Դոմենի մակարդակով ռեդակցիան նախատեսված է։
			</li>
			<li>
				<strong>Հաղորդակցություն</strong> — նամակներ, որոնք ուղարկում եք մեր աջակցության, վաճառքի, անվտանգության կամ գաղտնիության փոստարկղերին։
			</li>
			<li>
				<strong>tafs հավելվածը</strong> — tafs-ում մուտք եք գործում ձեր KIFF հաշվով։ Հեռախոսի կամ պլանշետի վրա հավելվածը ձեր նիստը պահում է սարքի Keychain-ում (Android-ում՝ դրա գաղտնագրված պահոցում)։ Համակարգչի վրա պահում է կնքված ձեր օգտատիրոջ հաշվի համար. Windows PC-ում՝ Windows-ի սեփական տվյալների պաշտպանությամբ, Linux-ում՝ ձեր keyring-ում, Mac-ում՝ դրա Keychain-ում։ Համակարգչի նիստը տևում է մինչև 90 օր։ Հավելվածը ստեղծում է ստորագրման բանալի, որը երբեք չի լքում սարքը. iPhone-ի, iPad-ի կամ Mac-ի Secure Enclave-ում, Android սարքի Keystore-ում կամ Windows PC-ի TPM-ում։ Linux-ում և Mac-ում առանց Secure Enclave-ի բանալին ծրագրային բանալի է, որը պահվում է ձեր keyring-ում կամ Keychain-ում, և այդ համակարգիչը կարող է ցույց տալ, թե ինչ է ձեզ սպասում, բայց չի կարող հաստատել. հաստատում եք հեռախոսով{ macSecurityKey("hy") }։ Առանց TPM-ի Windows PC-ն չի կարող մուտք գործել tafs։ KIFF-ը պահում է բանալու հանրային կեսը, սարքի անունն ու հարթակը, և երբ է ավելացվել ու վերջին անգամ օգտագործվել, որպեսզի կարողանա ստուգել ձեր պատասխանները կասեցված զանգերին և ձեր կապերի հաստատումները։ Եթե համակարգչի վրա հաստատում եք passkey-ով, օրինակ Windows Hello կամ անվտանգության բանալի, ձեր դեմքը, մատնահետքը կամ PIN-ը մնում է համակարգչի սեփական համակարգում. KIFF-ը պահում է passkey-ի հանրային բանալին, դրա id-ն, հաշվիչն ու անունը, երբեք որևէ գաղտնիք, և մերժում է passkey, որը համաժամացվում է այլ սարքերի հետ։ Եթե հեռախոսում, պլանշետում կամ iPad հավելվածը գործարկող Mac-ում միացնում եք ծանուցումները, պահում ենք սարքի push token-ը ձեր KIFF անձի id-ի հետ և այն լեզուն, որը հավելվածը ցույց է տվել, որպեսզի դրա ծանուցումները այդ լեզվով գան։ tafs ծառայությունը նաև պահում է հաշվի լեզուն՝ նրա, ով վերջին անգամ զրուցել է Coach-ի հետ, մինչև երեք ամիս, որպեսզի taf-ի հաշվետվությունները նրանով գան։ Հեռախոսի ծանուցումն անցնում է Apple-ի կամ Google-ի միջով միայն այն տվյալով, թե որ taf-ն ու ինչ է ուզում, իսկ դռան ծանուցման մեջ՝ գրողի անունով կամ էլ. փոստի հասցեով. երբեք գումարով կամ հարցման մանրամասներով։ Հավելվածը դրանք ավելացնում է հենց սարքի վրա, KIFF-ից, ուստի ապակողպված հեռախոսի ծանուցումը կարող է ցույց տալ գումար, վաճառող կամ անձ։ Կողպված Android հեռախոսի վրա ցույց է տալիս միայն «Taf-ին ձեզ պետք է», իսկ կողպված iPhone-ի վրա՝ նույնպես, եթե նախադիտումները միշտ ցուցադրվելու չեք սահմանել։ <strong>Ձեր ժամացույցը՝</strong> ժամացույցը գաղտնաբառ կամ բանալի չի պահում, խոսում է միայն ձեր զուգակցված հեռախոսի հետ և երբեք չի հաստատում։ Այն, ինչ ասում եք, ուղարկում է Coach-ին կամ ձեր ընտրած taf-ին միայն որպես տեքստ, հեռախոսի միջոցով, երբ AI-ին թույլատրել եք։ Ժամացույցի սեփական խոսքի ծառայությունը՝ Apple-ինը կամ Google-ինը, ձեր խոսքերը վերածում է այդ տեքստի։ Wear OS-ում, եթե այն կանգ է առնում նախքան ավարտելը, դա անում է ձեր հեռախոսի սեփական ճանաչիչը՝ հեռախոսի վրա։ Կարող է մերժել, կանգնեցնել կամ ուղարկել Coach-ին կամ taf-ին միայն երբ ունի էկրանի կողպում կամ կոդ և ապակողպված է։ Այն, ինչ taf-ին եք ուղարկում, գնում է այդ taf-ի սեփական զրույց, կարծես հեռախոսի վրա գրած լինեիք։ Taf-ի զրույցը, ներառյալ գումարները, ամեն անգամ բացվելիս կարդացվում է հեռախոսի միջոցով, իսկ ժամացույցը պահում է միայն վերջին հաղորդագրությունները, որոնք նկարագրված են ներքևում՝ իր բաժնում։ Երբ հավելվածները փակ են, ձեր հեռախոսը նոր պատասխաններն ու հաղորդագրությունները ժամացույցին է փոխանցում համակարգի սեփական հեռախոս-ժամացույց կապով (Apple Watch-ում՝ Apple-ի, Wear OS-ում՝ Google Play ծառայությունների), որը դրանք պահում է հեռախոսում և ժամացույցում միայն մինչև ժամացույցը դրանք ընդունի. ձեր հեռախոսն արթնացնող ծանուցումը բառեր չի պարունակում։ Պատասխանը, որ գալիս է, երբ ժամացույցին չեք նայում, ցուցադրվում է նաև որպես ծանուցում՝ ձեր iPhone-ում և Apple Watch-ում կամ ձեր Wear OS ժամացույցում, իր բառերով, բայց երբեք գումարով, և մնում է, մինչև այն փակեք. կողպված Wear OS ժամացույցը ցույց է տալիս միայն, որ պատասխանը պատրաստ է։ <strong>Apple Watch՝</strong> ցույց է տալիս ձեր taf-երն ու դրանց էջերը՝ առանց պահելու։ Պահում է ձեր Մուտքերը, ֆայլում, որը չի կարող կարդալ, երբ կողպված է. յուրաքանչյուր կասեցված զանգ՝ որպես իր taf-ի անուն և ինչ է խնդրում, երբեք գումար, և Coach-ի պատասխանները այն բանին, ինչ ուղարկել եք ժամացույցից, որպես տեքստ։ Եթե ժամացույցի վրա դուրս եք գալիս, պահում է նաև այն, որ դուրս եկել եք, մինչև ժամացույցի վրա նորից մուտք գործեք։ Դրանից բացի ոչինչ չի պահում, եթե ժամացույցը կոդ չունի։ Մուտքերը հեռանում են, երբ ժամացույցի վրա դուրս եք գալիս կամ ձեր iPhone-ը դուրս է գալիս, կամ հաջորդ անգամ, երբ հավելվածը բացվում կամ փակվում է առանց կոդի։ Ձայնագրություն չի անում, և միակ ծանուցումները, որ ցույց է տալիս, ձեր iPhone-ինն են։ Որպեսզի զրույցն անմիջապես բացվի, այն պահում է նաև դրանում բացված մինչև 20 զրույցներից յուրաքանչյուրի վերջին 30 հաղորդագրությունները՝ Coach-ի և ձեր tafs-ի, միայն տեքստով և երբեք գումար, Մուտքերի պես կողպված, և դրանք ջնջվում են Մուտքերի հետ, ինչպես նաև երբ զրույցը 30 օր չի բացվել։ <strong>Wear OS՝</strong> ցույց է տալիս ձեր հաշվի էլ. փոստն ու այսօրվա օրացույցը՝ առանց պահելու։ Որպեսզի անմիջապես բացվի, պահում է, գաղտնագրված, ձեզ սպասողի քանակը և յուրաքանչյուր taf-ի անունը և արդյոք այն կանգնեցված է, թե դադարեցված. երբեք գումար, կասեցված զանգի մանրամասներ կամ taf-ի զրույց։ Սա մաքրվում է, երբ դուրս եք գալիս, երբ ժամացույցը կողպվում է կամ հանվում է դաստակից, և 24 ժամ հետո։ Պահում է ձեր Մուտքերը, որտեղ յուրաքանչյուր տող taf-ի անուն է և այն, ինչ ասում է, երբեք գումար, և մեկ հաղորդագրություն՝ հետագայի համար, որպես տեքստ։ Դուրս գալը, ժամացույցի կամ հեռախոսի վրա, մաքրում է ամենը։ Իր սալիկի համար պահում է նաև ձեզ սպասողի քանակը, ցույց տրված միայն երբ ժամացույցը ապակողպված է, և մաքրվում է, երբ դուրս եք գալիս, կամ հաջորդ անգամ, երբ սալիկը երևում է, երբ ժամացույցը կողպված է կամ չունի էկրանի կողպում։ Ժամացույցի վրա դուրս գալուց հետո պահում է նշում, որ դուրս եկել եք, մինչև նորից մուտք գործեք։ Մուտքերը հեռանում են նաև հաջորդ անգամ, երբ հավելվածը բացվում կամ փակվում է, երբ ժամացույցը կողպված է կամ չունի էկրանի կողպում։ Հետագայի համար պահված հաղորդագրությունը մնում է, մինչև ուղարկեք կամ ջնջեք, քանի որ ինքներդ եք խնդրել ուղարկել։ Եթե ժամացույցի խոսքի ծառայությունը կանգ է առնում նախքան ավարտելը, ժամացույցը ձայնագրությունն ուղարկում է ձեր հեռախոսին, որը այն վերածում է տեքստի հենց հեռախոսի վրա, երբեք սերվերում։ Ձայնագրությունը ջնջվում է երկու կողմում, երբ տեքստը վերադառնում է կամ չեղարկում եք, և առավելագույնը 2 րոպե հետո։ Միայն տեքստն է շարունակում ճանապարհը Coach-ին կամ ձեր taf-ին։ Taf-ի արդյունքը կարող է մնալ ժամացույցի ծանուցումներում, մինչև չմերժեք կամ ժամացույցի վրա դուրս չգաք։ Որպեսզի զրույցն անմիջապես բացվի, այն պահում է նաև դրանում բացված մինչև 20 զրույցներից յուրաքանչյուրի վերջին 30 հաղորդագրությունները՝ Coach-ի և ձեր tafs-ի, միայն տեքստով և երբեք գումար, գաղտնագրված, և դրանք ջնջվում են, երբ դուրս եք գալիս ժամացույցում կամ հեռախոսում, և երբ զրույցը 30 օր չի բացվել, իսկ առանց էկրանի կողպման ժամացույցը դրանցից ոչ մեկը չի պահում։ Windows PC-ում, Linux համակարգչում կամ macOS 12 հավելվածով Mac-ում ծանուցումները ստեղծում է հենց հավելվածը՝ աշխատելիս, առանց push token-ի և առանց որևէ այլ ընկերության։ Windows-ում և Linux-ում ցույց են տալիս, թե որ taf-ը, ինչ է ուզում անել, գումարը, ինչու և մինչև երբ. macOS 12 հավելվածում ցույց են տալիս KIFF-ի խոսքերը զանգի համար, երբ դրանք միացնում եք, և կողպված էկրանը ցույց է տալիս այն, ինչ թույլ է տալիս Mac-ի նախադիտման կարգավորումը։ Windows-ում անջատված են, մինչև միացնեք, և ցույց են տալիս միայն «Taf-ին ձեզ պետք է», երբ էկրանը կողպված է։ Էկրանի կողպումից առաջ ցուցադրված ծանուցումն իր մանրամասները պահում է Windows-ի ծանուցումների ցանկում։ Linux-ում միացված են, մինչև անջատեք, և այն, ինչ ցույց է տալիս կողպված էկրանը, կախված է ձեր աշխատասեղանից։ Երբ գործիք եք կապում, մուտք եք գործում գործիքի սեփական մատակարարի մոտ։ Հավելվածի համար, որի մեջ planque-ը ինքն է մուտք գործում, օրինակ Stripe, կամ բանալու համար, որը տալիս եք, planque-ը այդ token-ը կամ բանալին պահում է ձեր ընկերության համար՝ գաղտնագրված. կառավարվող կապի համար՝ Composio-ն՝ կապի ծառայությունը, որի հետ աշխատում է planque-ը, պահում է մուտքը, և planque-ը պահում է միայն կապի գրառումը և ձեր հաստատած գործիքները (ամեն ինչ որպես մշակող, տե՛ս ստորև)։ Եթե զուգակցեք tafs ընդլայնումը, taf-ը կարող է նաև կարդալ և գործել այն կայքերի էջերում, որոնց թույլ եք տալիս, ձեր սեփական Chrome-ում (որպես մշակող. <a href="/hy/tafs/privacy">tafs-ի գաղտնիության էջը</a> ասում է՝ ինչ է կարդացվում, ինչ է պահվում և որքան ժամանակ)։ Կապի գրառումը կարող է ներառել հաշիվը, որում մուտք է գործվել (դրա անունը կամ էլ. փոստը), որպեսզի հավելվածը ձեզ ցույց տա, թե որն է։ KIFF-ը կառավարվող կապեր օգտագործում է միայն <a href="/subprocessors#composio">/subprocessors</a> (անգլերեն) հասցեում նշված հավելվածների համար։ Հավելվածը չունի վերլուծական կամ գովազդային հետագծիչներ։
			</li>
			<li>
				<strong>App Store-ի գնումներ</strong> — երբ tafs-ում գնում եք Solo կամ կրեդիտների փաթեթ, այն ձեզ վաճառում է Apple-ը. Apple-ը գրանցված վաճառողն է, ստանում է վճարումը և պահում է ձեր վճարման տվյալները։ Apple-ը մեզ հայտնում է, թե ինչ է գնվել, որ KIFF հաշվի համար (պատահական id, որը հավելվածը կցում է գնմանը), երբ, Apple-ի գործարքի id-ն և Solo-ի համար՝ երբ է ավարտվում կամ թարմացվում ժամանակահատվածը։ Սա օգտագործում ենք կրեդիտները կամ պլանը ձեր հաշվին ավելացնելու համար։ Apple-ը մեզ չի տալիս ձեր Apple ID-ն, անունը, էլ. փոստի հասցեն կամ քարտը։
			</li>
			<li>
				<strong>Google Play-ի գնումներ</strong> — Android-ում նույն գնումները անցնում են Google Play-ի վճարման միջոցով. Google-ը ստանում է վճարումը և պահում է ձեր վճարման տվյալները։ Google-ը մեզ հայտնում է, թե ինչ է գնվել, որ KIFF հաշվի համար (նույն պատահական id-ն), երբ, գնման token-ը և պատվերի id-ն և Solo-ի համար՝ երբ է ավարտվում կամ թարմացվում ժամանակահատվածը, և մենք դա օգտագործում ենք նույն կերպ։ Google-ը մեզ չի տալիս ձեր Google հաշիվը, անունը, էլ. փոստի հասցեն կամ քարտը։
			</li>
		</ul>
	</section>
}

templ privacyLawfulBasesHY() {
	<section id="lawful-bases">
		<h2>5. Մշակման իրավական հիմքերը</h2>
		<p>
			GDPR-ի 6-րդ հոդվածի համաձայն հիմնվում ենք հետևյալ իրավական հիմքերի վրա՝
		</p>
		<ul>
			<li>
				<strong>Պայմանագրի կատարում</strong> (հոդված 6(1)(b)) — հաշիվ ստեղծելու, նույնականացման, runtime-ը ձեր անունից աշխատեցնելու, վճարման (երբ ակտիվ է) և ծառայության հիմնական մակերեսների համար։
			</li>
			<li>
				<strong>Օրինական շահեր</strong> (հոդված 6(1)(f)) — անվտանգության, խարդախության կանխարգելման, չարաշահումների հայտնաբերման, գործառնական հեռաչափության և ծառայության պաշտպանության համար։ Մեր շահերը կշռում ենք ձեր իրավունքների դիմաց և հարցման դեպքում կասենք, թե ինչ արդյունք տվեց այդ հավասարակշռության թեստը։
			</li>
			<li>
				<strong>Համաձայնություն</strong> (հոդված 6(1)(a)) — tafs հավելվածի AI-ի համար՝ ինչ է ուղարկվում AI մոդելին, որն աշխատեցնում է Coach-ն ու ձեր taf-երը, ինչպես նկարագրված է <a href="#ai-in-tafs">ստորև</a>։ Ոչինչ չի ուղարկվում, մինչև չթույլատրեք, և կարող եք հետ վերցնել Հաշվում։ Համաձայնությունն այն է, ինչ կխնդրեինք ցանկացած վերլուծական cookie-ից, ըստ ընտրության մարքեթինգային հաղորդագրությունից կամ նոր մշակումից առաջ, որը էապես ընդլայնում է ձեր տվյալների օգտագործումը։ Մենք չենք անցկացնում վերլուծություն, գովազդ կամ ոչ էական հետևում։
			</li>
			<li>
				<strong>Իրավական պարտավորություն</strong> (հոդված 6(1)(c)) — հարկային գրառումների (Էստոնիայի Հաշվապահական հաշվառման օրենք §12, 7 տարի), օրինական իշխանությունների հարցումներին պատասխանների և փողերի լվացման դեմ կանոնների պահանջած պահպանման համար, որտեղ կիրառելի է։
			</li>
		</ul>
		<h3 id="ai-in-tafs">AI-ն tafs հավելվածում</h3>
		<p>tafs հավելվածը ձեզ հարցնում է, նախքան որևէ բան AI-ին ուղարկելը, այս խոսքերով՝</p>
		<ul>
			<li>tafs-ը օգտագործում է Anthropic-ի Claude AI-ն Coach-ի և ձեր taf-երի համար։</li>
			<li>Coach-ը և ձեր taf-երը AI գործակալներ են. այն, ինչ գրում են, ստեղծվում է AI-ի կողմից և կարող է սխալ լինել։ Հաղորդագրությունը, որը taf-ը ուղարկում է ձեր ընկերությունից դուրս, ասում է, որ գրվել է AI գործակալի կողմից։</li>
			<li>Ինչ է ուղարկվում՝ այն, ինչ գրում եք Coach-ին և ձեր taf-երին, ֆայլերը, որոնք կցում եք, այն, ինչ ձեր միացված հավելվածները վերադարձնում են taf-ին, երբ աշխատում է, և այն, ինչ ձեր էկրանին է, մինչ Coach-ը օգնում է ձեզ հավելվածում։</li>
			<li>Ինչ երբեք չի ուղարկվում՝ գաղտնաբառերն ու բանալիները, որոնք օգտագործում են ձեր միացված հավելվածները, կամ ձեր մատնահետքը։</li>
			<li>Anthropic-ը այն օգտագործում է պատասխանելու համար և պահում է մինչև 30 օր։</li>
			<li>Ոչինչ չի ուղարկվում, մինչև չթույլատրեք։ Կարող եք հետ վերցնել Հաշվում։</li>
		</ul>
		<p>Taf, որն աշխատում է այդ պահին առանց որևէ մեկի ներկայության (իր ժամանակացույցով կամ երբ ինչ-որ բան է մտնում), հիմնվում է այն անձի համաձայնության վրա, ով այն ստեղծել կամ ստանձնել է, կամ հակառակ դեպքում՝ հաշվի taf-երը կառավարող առաջին անձի, ով թույլատրում է։</p>
		<p><strong>Երբ հետ եք վերցնում,</strong> Coach-ը և ձեր taf-երը դադարում են ձեզ պատասխանել։ Taf-ը, որի գործարկումները հիմնված են ձեր համաձայնության վրա, դադարեցվում է. նրա ժամանակացույցերը կանգ են առնում, և ինչ մտնում է, սպասում է։ Շարունակվում է, երբ համաձայնությունը նորից տրվում է, կամ երբ հաշվի taf-երը կառավարող ինչ-որ մեկը այն ստանձնում է իր համաձայնությամբ։ Հետ վերցնելը չի փոխում այն, ինչ նախկինում ուղարկվել է։</p>
		<p>Anthropic-ը նշված է <a href="/subprocessors">/subprocessors</a> (անգլերեն) հասցեում՝ այն վայրի հետ, որտեղ մշակում է, և երբ կարող է տվյալները ավելի երկար պահել։</p>
	</section>
}

templ privacySubprocessorsHY() {
	<section id="sub-processors">
		<h2>6. Ենթամշակողներ</h2>
		<p>Մենք չենք վաճառում ձեր անձնական տվյալները և չենք կիսվում դրանցով գովազդի համար։</p>
		<p>
			Ծառայությունը մատուցելու համար ներգրավում ենք մատակարարների փոքր խմբի։ Պաշտոնական, ընթացիկ ցանկը գտնվում է <a href="/subprocessors">/subprocessors</a> (անգլերեն) հասցեում. այդ էջը թարմացվում է ցանկացած փոփոխությունից 30 օրվա ընթացքում։ Յուրաքանչյուր ենթամշակողից պահանջում ենք մեր պաշտպանությանը համարժեք պաշտպանություն գրավոր համաձայնագրերով, ներառյալ ԵՄ ստանդարտ պայմանագրային դրույթները, երբ անձնական տվյալները լքում են ԵՄ-ը։
		</p>
		<p>
			Անձնական տվյալների վրա ազդող ենթամշակողների էական ավելացումների կամ փոխարինումների մասին ակտիվ հաճախորդներին նախապես ծանուցվում է՝ առարկելու իրավունքով։
		</p>
	</section>
}

templ privacyTransfersHY() {
	<section id="transfers">
		<h2>7. Միջազգային փոխանցումներ</h2>
		<p>
			Մեր ենթամշակողներից ոմանք հիմնադրված են Եվրոպական տնտեսական տարածքից դուրս, հիմնականում Միացյալ Նահանգներում։ Յուրաքանչյուր այդպիսի փոխանցման համար հիմնվում ենք առնվազն հետևյալ երաշխիքներից մեկի վրա՝
		</p>
		<ul>
			<li>
				<strong>ԵՄ–ԱՄՆ տվյալների գաղտնիության շրջանակ</strong> — ԱՄՆ ենթամշակողների համար, որոնք սերտիֆիկացվել են շրջանակին։ Համարժեքության որոշումը ուժի մեջ է 2023 թվականի կեսից. հետևում ենք դրա կարգավիճակի ցանկացած փոփոխության։
			</li>
			<li>
				<strong>Ստանդարտ պայմանագրային դրույթներ</strong> — մոդուլ 2 (վերահսկիչ–մշակող) մեր անմիջական ենթամշակողների համար և մոդուլ 3 (մշակող–ենթամշակող), որտեղ կիրառվում են շղթայական մշակողներ։ Օգտագործում ենք Հանձնաժողովի հաստատած 2021 թվականի SCC-երը։
			</li>
			<li>
				<strong>Լրացուցիչ միջոցներ</strong> — երբ ռիսկի գնահատումը ցույց է տալիս, որ լրացուցիչ երաշխիքներ են արդարացված (գաղտնագրում փոխանցման և պահման ժամանակ, մուտքի գրանցում, տվյալների մինիմիզացիա)։
			</li>
		</ul>
		<p>
			Կոնկրետ ենթամշակողի նկատմամբ կիրառվող փոխանցման գործիքը կարող եք խնդրել՝ նամակ ուղարկելով <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> հասցեին։
		</p>
		<p><strong>Ձեր երկիրը։</strong> Որոշ երկրների օրենքները պահանջում են ավելին, քան ասում է այս քաղաքականությունը։ Այն, ինչ ավելացնում են, անգլերենով և երկրի լեզվով, գտնվում է <a href="/privacy/countries">Ձեր երկիրը</a> (անգլերեն) էջում։</p>
	</section>
}

templ privacyRetentionHY() {
	<section id="retention">
		<h2>8. Պահպանում</h2>
		<p>
			Անձնական տվյալները պահում ենք ամենակարճ ժամկետով, որը համապատասխանում է դրանց մշակման նպատակներին և ցանկացած կիրառելի իրավական պարտավորության։
		</p>
		<ul>
			<li>
				<strong>Հաշվի և մուտքի մետատվյալներ</strong> — մինչև հաշվի ջնջումը։ tafs հավելվածում սեփականատերը ջնջում է այն Հաշիվ → <em>Ջնջել հաշիվը</em>։ Վեբում ստեղծված հաշիվը ջնջվում է նամակ ուղարկելով <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> հասցեին՝ GDPR-ի 12(3) հոդվածի մեկամսյա ժամկետում։ Երկու դեպքում էլ հաշվի բանալիները անմիջապես դադարում են գործել։ tafs հավելվածում ջնջվելիս այն չի կարող վերականգնվել. նրա taf-երի զրույցները, նշումներն ու կապերը ջնջվում են անմիջապես, իսկ այն, ինչ KIFF-ը պահում է, ջնջվում է 30 օրվա ընթացքում։ Վեբում ջնջվելիս նրա տվյալները պահում ենք 30 օրվա արտոնյալ ժամանակահատվածով՝ եթե սեփականատերը ցանկանա դրանք հետ ստանալ, հետո ջնջում ենք։
			</li>
			<li>
				<strong>API բանալիների գրառումներ</strong> — մինչև հաշվի ջնջումը, ներառյալ բանալու չեղարկումից հետո։ Բանալին, որը պատկանում է գործակալի մուտքի կապին, ջնջվում է այդ կապի հետ միասին՝ դրա ավարտից 30 օր հետո։
			</li>
			<li>
				<strong>Նիստի cookie-ներ</strong> — մինչև ժամկետի ավարտը (լռելյայն 24 ժամ) կամ մինչև դուրս գալը։
			</li>
			<li>
				<strong>Հակադարձ պրոքսիի մուտքի մատյաններ</strong> — մինչև 90 օր, հետո ագրեգացվում կամ ջնջվում են։
			</li>
			<li>
				<strong>Ծառայության մատյաններ</strong> — այն, ինչ KIFF-ի ծառայությունները և planque-ը գրանցում են աշխատելիս. սխալներ և հարցումներ, որոնք կարող են անվանել հաշիվ, անձ կամ գործակալ։ 30 օր, հետո ջնջվում են։
			</li>
			<li>
				<strong>Պահուստային պատճեններ</strong> — KIFF-ի տվյալների բազան պահուստավորվում է ամեն օր, գաղտնագրված, և յուրաքանչյուր պատճեն պահվում է 7 օր, ուստի ջնջված գրառումը դրանցից անհետանում է 7 օրվա ընթացքում։ tafs-ի և planque-ի պահոցները պահում են գաղտնագրված ժամանակային պատճեններ 35 օր, որոնք օգտագործվում են միայն պահոցը խափանումից հետո վերականգնելու համար, ուստի ջնջված գրառումը դրանցից անհետանում է 35 օրվա ընթացքում։
			</li>
			<li>
				<strong>Թենանտի աուդիտի տվյալներ</strong> — պահվում են որպես մշակող՝ ըստ հաճախորդի թենանտի կազմաձևման։ Լռելյայն՝ պահվում են թենանտի կյանքի ընթացքում. ջնջվում են թենանտի ջնջման հետ։ Տե՛ս <a href="/security#deletion">/security#deletion</a> (անգլերեն)։
			</li>
			<li>
				<strong>Զանգեր KIFF gateway-ով</strong> — զանգի արգումենտները մինչև այն ուղարկվի, մերժվի կամ ձախողվի, հետո ջնջվում են. գործիքի արդյունքը 24 ժամ, հետո ջնջվում է։ Որոշման գրառումը և արգումենտների հեշը պահվում են որպես թենանտի աուդիտի տվյալներ։ Տե՛ս <a href="/security#data-kept">/security#data-kept</a> (անգլերեն)։
			</li>
			<li>
				<strong>Օգտագործում</strong> — gateway-ով յուրաքանչյուր զանգի համար, երբ ավարտվում է. որ գործակալն է արել, գործիքը և արդյոք հաշվվել է որպես գործողություն, թե անվճար էր (և ինչու)։ taf-ի կամ Coach-ի յուրաքանչյուր գործարկման համար, երբ ավարտվում է. taf-ը, երբ, կրեդիտները, որոնք օգտագործել է նրա AI-ն, և արդյոք հաշվվել են, թե ինչու ոչ։ Մինչև հաշվի ջնջումը. այն, ինչ վճարման համար հայտնվում է մեր վճարային պրոցեսորին, պահվում է վճարման գրառումների հետ։
			</li>
			<li>
				<strong>Գործակալի մուտքի կապեր</strong> — որ գործակալը, հավելվածի անունը, ով է թույլատրել, երբ և վերջին օգտագործումը. քանի դեռ կապը ակտիվ է, հետո 30 օր դրա ավարտից (այդ ընթացքում մնում է վահանակում նշված), հետո ջնջվում է իր token-ներով և API բանալիով։ Ամեն ինչ ջնջվում է հաշվի հետ։
			</li>
			<li>
				<strong>tafs</strong> — սարքի push token-ը մինչև հավելվածից դուրս գալը, սարքը հեռացնելը կամ մինչև Apple-ը կամ Google-ը հայտնի, որ token-ն այլևս չկա։ Սարքի հանրային բանալին, անունը, հարթակը և ամսաթվերը՝ քանի դեռ օգտագործում եք այն. դուրս գալուց հետո նշվում է որպես հեռացված և պահվում է մինչև հաշվի ջնջումը, որպեսզի KIFF-ը կարողանա մերժել դրանից ուշացած պատասխանը և ցույց տալ, թե որ սարքն է ստորագրել ավելի վաղ մեկը։ Passkey-ի հանրային բանալին, id-ն և անունը՝ ինչպես իր սարքինը։ Համակարգչի նիստը՝ մինչև 90 օր կամ մինչև դուրս գալը։ Այն, ինչ tafs-ը պահում է ձեր ընկերության համար, պահվում է որպես մշակող. taf-ի գործարկումները և զրույցները, զրույցի (և Setup-ի) ամփոփագրով, 30 օր, այն, ինչ ձեր գործիքները վերադարձնում են, միայն մինչև գործարկման ավարտը (զրույցում այն, ինչ միայն կարդացվել է, պահվում է գաղտնագրված հաջորդ հաղորդագրությունների համար, օգտագործվում է մինչև զրույցը մեկ ժամ անգործ մնալը և կարդալուց ոչ ավելի, քան չորս ժամ հետո, հետո ավտոմատ ջնջվում է, մի քանի օրվա ընթացքում), և նրա հիշողության նշումները՝ մինչև taf-ի հեռացումը. ֆայլերը, որոնք հանձնում է, 30 օր այն գործարկումից, որը ստեղծել է դրանք, հետո ավտոմատ ջնջվում են մեկ օրվա ընթացքում, կամ ավելի շուտ, եթե ձեր հաշվի որևէ մեկը ջնջի մեկը. կապի token-ը կամ բանալին planque-ում, կամ կառավարվող կապի մուտքը Composio-ում՝ մինչև չանջատեք (եթե ձեր մեկ այլ կապ կարող է օգտագործել նույն հաշիվը այդ մատակարարի մոտ, պահվում է չօգտագործված, մինչև այն էլ անջատվի), և նրա հաստատումների գրառումը՝ մինչև հաշվի ավարտը. տե՛ս <a href="/legal/dpa#annex-4">DPA-ի Հավելված 4</a> (անգլերեն)։
			</li>
			<li>
				<strong>Վճարման գրառումներ</strong> — 7 տարի ֆինանսական տարվա ավարտից (Էստոնիայի Հաշվապահական հաշվառման օրենք §12)։
			</li>
			<li>
				<strong>App Store-ի և Google Play-ի գնումներ</strong> — այն, ինչ Apple-ը կամ Google-ը մեզ ասել է յուրաքանչյուր գնման մասին, մնում է ձեր հաշվում մինչև հաշվի ջնջումը։ Նրանց վաճառքների և վճարումների հաշվետվությունները, որոնք պահում ենք որպես վճարման գրառումներ 7 տարի, ձեզ չեն անվանում։
			</li>
			<li>
				<strong>Աջակցության նամակագրություն</strong> — 3 տարի վերջին փոխգործակցությունից, հետո ջնջվում է։
			</li>
		</ul>
	</section>
}

templ privacyRightsHY() {
	<section id="rights">
		<h2>9. Ձեր իրավունքները</h2>
		<p>
			GDPR-ի համաձայն ձեր անձնական տվյալների վերաբերյալ ունեք հետևյալ իրավունքները՝
		</p>
		<ul>
			<li><strong>Մուտք</strong> (հոդված 15) — հաստատում, թե մշակում ենք արդյոք ձեր տվյալները, և դրանց պատճենը։</li>
			<li><strong>Ուղղում</strong> (հոդված 16) — անճշգրիտ կամ թերի տվյալների ուղղում։</li>
			<li><strong>Ջնջում</strong> (հոդված 17) — ձեր տվյալների ջնջում՝ օրինական պահպանման բացառություններով։</li>
			<li><strong>Սահմանափակում</strong> (հոդված 18) — մշակման դադարեցում, մինչև վեճը լուծվի։</li>
			<li><strong>Տեղափոխելիություն</strong> (հոդված 20) — ձեր տրամադրած տվյալների մեքենայով ընթեռնելի արտահանում։</li>
			<li><strong>Առարկություն</strong> (հոդված 21) — օրինական շահերի վրա հիմնված մշակմանը. դադարեցնում ենք, եթե չկարողանանք ցույց տալ գերակա հիմքեր։</li>
			<li><strong>Համաձայնության հետ վերցնում</strong> (հոդված 7(3)) — համաձայնության վրա հիմնված ցանկացած մշակման համար, օրինակ tafs հավելվածի AI-ի համար (Հաշվում, ինչպես <a href="#ai-in-tafs">վերևում</a>)։ Հետ վերցնելը չի ազդում նախկին օրինական մշակման վրա։</li>
		</ul>
		<p>
			Այս իրավունքներից որևէ մեկն իրականացնելու համար նամակ ուղարկեք <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> հասցեին։ Պատասխանում ենք առանց անհարկի ուշացման և ամենաուշը մեկ ամսվա ընթացքում՝ 12(3) հոդվածի համաձայն. բարդ հարցումների դեպքում կարող ենք երկարացնել մինչև ևս երկու ամիս և կասենք, եթե այդպես անենք։
		</p>
		<h3 id="export-chats">Ձեր սեփական tafs զրույցները</h3>
		<p>
			tafs հավելվածում Հաշիվ → Արտահանել իմ զրույցները ներբեռնում է ձեր սեփական զրույցները յուրաքանչյուր taf-ի հետ, այդ թվում Coach-ինը, ձեր կցած ֆայլերի անունները և ձեր սեփական նշումները՝ որպես ընթեռնելի ֆայլ և որպես JSON։ Դրանք կարող եք արտահանել միայն դուք. ադմինիստրատորը կամ հաշվի սեփականատերը չեն կարող, և KIFF-ի հաշվի արտահանումը դրանք չի ներառում։
		</p>
		<h3 id="delete-account">Ձեր tafs հաշվի ջնջումը</h3>
		<p>
			tafs-ը KIFF-ի հավելվածն է։ Ձեր tafs հաշիվը և դրա տվյալները ջնջելու համար՝
		</p>
		<ol>
			<li>Բացեք tafs հավելվածը և մուտք գործեք։</li>
			<li>Գնացեք Հաշիվ, հետո հպեք <em>Ջնջել հաշիվը</em>։</li>
			<li>Հաստատեք։ Հաշվի ջնջումը հնարավոր չէ չեղարկել։</li>
		</ol>
		<p>
			<em>Ջնջել հաշիվը</em> երևում է նրան, ով կարող է ջնջել ընկերության հաշիվը, սովորաբար դրա սեփականատիրոջը։ Եթե չեք տեսնում, կամ այլևս չունեք հավելվածը, նամակ ուղարկեք <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> հասցեին այն հասցեից, որով մուտք եք գործում, և մենք ձեր տվյալները կջնջենք առանց անհարկի ուշացման և ամենաուշը մեկ ամսվա ընթացքում։
		</p>
		<p>
			Ինչ է ջնջվում՝ հաշվի բանալիները անմիջապես դադարում են գործել։ Նրա taf-երը, զրույցները, նշումները, կցված ֆայլերը և կապերը ջնջվում են անմիջապես, իսկ դրանց ժամանակային պատճեններից՝ 35 օրվա ընթացքում։ Այն, ինչ KIFF-ը պահում է հաշվի համար, ջնջվում է 30 օրվա ընթացքում, իսկ պահուստային պատճեններից՝ դրանից հետո 7 օրվա ընթացքում։ Ծառայության մատյանները, որոնք անվանում են հաշիվը, վերանում են 30 օրվա ընթացքում։ Թենանտի աուդիտի տվյալները ջնջվում են թենանտի հետ։ Տվյալների յուրաքանչյուր տեսակի համար տե՛ս <a href="#retention">Պահպանում</a>։
		</p>
		<p id="delete-data">
			Ձեր որոշ տվյալներ ջնջելու և հաշիվը պահելու համար՝ հավելվածում ջնջեք զրույցը, և նրա հաղորդագրությունները և կցված ֆայլերը գնում են դրա հետ. հեռացրեք taf-ը, և նրա զրույցները, նշումները և կապերը գնում են դրա հետ։ Մնացած ամեն ինչի համար նամակ ուղարկեք <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> հասցեին և ասեք, թե ինչ ջնջել։ Դա անում ենք առանց անհարկի ուշացման և ամենաուշը մեկ ամսվա ընթացքում։
		</p>
		<p>
			Դուք իրավունք ունեք բողոք ներկայացնել վերահսկող մարմնին։ Մեր առաջատար վերահսկող մարմինը <a href="https://www.aki.ee/en" target="_blank" rel="noopener">Էստոնիայի տվյալների պաշտպանության տեսչությունն է (Andmekaitse Inspektsioon)</a>։ Կարող եք բողոքել նաև ձեր բնակության անդամ պետության վերահսկող մարմնին։
		</p>
		<p><strong>Ձեր երկիրը։</strong> Որոշ երկրների օրենքները պահանջում են ավելին, քան ասում է այս քաղաքականությունը։ Այն, ինչ ավելացնում են, անգլերենով և երկրի լեզվով, գտնվում է <a href="/privacy/countries">Ձեր երկիրը</a> (անգլերեն) էջում։</p>
	</section>
}

templ privacyCookiesHY() {
	<section id="cookies">
		<h2>10. Cookie-ներ</h2>
		<p>
			Մենք դնում ենք երեք cookie, բոլորը խստորեն անհրաժեշտ, առաջին կողմի, ուղարկվում են միայն HTTPS-ով և էջի սկրիպտների համար անընթեռնելի։ ԵՄ ePrivacy կանոնների համաձայն դրանք համաձայնություն չեն պահանջում. թվարկում ենք դրանք, որպեսզի իմանաք, որ գոյություն ունեն։ <a href="/cookies">Cookie-ների քաղաքականությունը</a> (անգլերեն) ունի մանրամասները։
		</p>
		<ul>
			<li>
				<strong><code>kiff_session</code></strong> — ձեզ պահում է մուտք գործած։ Ստորագրված նիստի cookie, որը կրում է ձեր մուտքի id-ն, էլ. փոստը և անունը, և հավատարմագիրը, որն օգտագործում է վահանակը ձեզ համար։ Դրվում է <code>.kiff.dev</code>-ի համար։ Տևում է 24 ժամ կամ մինչև դուրս գալը։
			</li>
			<li>
				<strong><code>kiff_flash</code></strong> — կրում է մեկանգամյա հաղորդագրություն հաջորդ էջին, օրինակ «ձեր բանալին ստեղծվեց»։ Ստորագրված է. նոր բանալին երբեք դրա մեջ չէ։ Դրվում է <code>.kiff.dev</code>-ի համար։ Ջնջվում է, երբ հաջորդ էջը կարդում է այն, և առավելագույնը 5 րոպեից։
			</li>
			<li>
				<strong><code>kiff_cb_attempts</code></strong> — հաշվում է, թե քանի անգամ է մուտքի էջը վերաբեռնվել, որպեսզի օղակվող մուտքը կանգնեցվի։ Ուղարկվում է միայն այդ էջին։ Տևում է 5 րոպե և մաքրվում է, երբ մուտքը սկսվում կամ հաջողվում է։
			</li>
		</ul>
		<p>
			Մենք չենք օգտագործում վերլուծական cookie-ներ, գովազդային cookie-ներ կամ երրորդ կողմի որևէ հետագծիչ։ Եթե երբևէ ավելացնենք, cookie-ն դնելուց առաջ կցուցադրենք համաձայնության պաստառ՝ ePrivacy-ին և EDPB-ի 2023 թվականի հետագծման տեխնոլոգիաների ուղեցույցին համապատասխան։
		</p>
		<p>
			Եթե մուտք եք գործում Clerk-ով (մեր նույնականացման ենթամշակողով), Clerk-ը cookie-ներ է դնում նաև իր frontend դոմենում (<code>clerk.kiff.dev</code>)։ Այդ cookie-ները անհրաժեշտ են, որպեսզի Clerk-ը ձեզ ճանաչի իր մուտքի ընթացքում, և դրանք կարգավորվում են Clerk-ի գաղտնիության քաղաքականությամբ, ինչպես նաև մերով։ Մանրամասների համար տե՛ս ենթամշակողների ցանկը։
		</p>
	</section>
}

templ privacySecurityHY() {
	<section id="security">
		<h2>11. Անվտանգություն</h2>
		<p>
			Մեր տեխնիկական և կազմակերպչական անվտանգության միջոցառումները փաստաթղթավորված են <a href="/security">/security</a> (անգլերեն) հասցեում։ Դրանք ներառում են թենանտների մեկուսացումը տվյալների բազայի մակարդակում, TLS 1.2+ փոխանցման ժամանակ, գաղտնագրում պահման ժամանակ կառավարվող մատակարարի լռելյայն կարգավորումներով և մուտքի վերահսկում՝ նվազագույն արտոնության սկզբունքի հիման վրա։
		</p>
		<p>
			Տուժած հաճախորդներին անձնական տվյալների խախտման մասին ծանուցում ենք անհիմն ուշացումից խուսափելով և հաստատումից 72 ժամվա ընթացքում՝ GDPR-ի 33-րդ հոդվածին համապատասխան։ Ծանուցումը ներառում է խախտման բնույթը, տուժած սուբյեկտների և գրառումների կատեգորիաներն ու մոտավոր թիվը, հավանական հետևանքները և ձեռնարկված կամ առաջարկվող միջոցները։
		</p>
	</section>
}

templ privacyChildrenHY() {
	<section id="children">
		<h2>12. Երեխաներ</h2>
		<p>
			KIFF Cloud-ը մշակողների ենթակառուցվածքի արտադրանք է, որը նախատեսված չէ երեխաների համար։ Գիտակցաբար անձնական տվյալներ չենք հավաքում 16 տարեկանից ցածր երեխաներից։ Եթե կարծում եք, որ երեխան մեզ անձնական տվյալներ է տվել, կապվեք <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> հասցեով, և մենք կջնջենք դրանք։
		</p>
	</section>
}

templ privacyAutomatedHY() {
	<section id="automated">
		<h2>13. Ավտոմատացված որոշումների կայացում</h2>
		<p>
			KIFF Cloud-ի runtime-ը կայացնում է դետերմինիստական քաղաքականության որոշումներ մեր հաճախորդների ուղարկած տվյալների վրա։ Սրանք ձեր մասին որոշումներ չեն, որոնք GDPR-ի 22-րդ հոդվածի իմաստով իրավական կամ նման էական հետևանքներ են առաջացնում. դրանք որոշումներ են հաճախորդի գործողությունների (վերադարձներ, պատվերներ, հաղորդագրություններ և այլն) վերաբերյալ, որոնք կատարվում են հաճախորդի սեփական քաղաքականությամբ։
		</p>
		<p>
			Հաճախորդները, որոնք օգտագործում են KIFF Cloud-ը՝ իրենց վերջնական օգտատերերի վրա ազդող որոշումներ կայացնելու համար, իրենք են պատասխանատու 22-րդ հոդվածի պահպանման համար։ Մեր կառավարման հաստատագրերը նախագծված են այդ հաճախորդներին տալու աուդիտի հետք, որն անհրաժեշտ է մարդկային վերահսկողությունը ցույց տալու համար, բայց այդ վերահսկողությունն ապահովելու իրավական պարտականությունը հաճախորդինն է։
		</p>
	</section>
}

templ privacyChangesHY() {
	<section id="changes">
		<h2>14. Այս քաղաքականության փոփոխություններ</h2>
		<p>
			Այս քաղաքականությունը կարող ենք թարմացնել ժամանակ առ ժամանակ։ Էական փոփոխությունների մասին ակտիվ հաճախորդներին ծանուցվում է էլ. փոստով և այս էջի ակնառու պաստառով առնվազն 30 օր։ Ոչ էական փոփոխությունները հրապարակվում են նոր «վերջին թարմացում» ամսաթվով։
		</p>
	</section>
}

