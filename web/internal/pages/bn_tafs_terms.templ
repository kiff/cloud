package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsTermsBN is tafs's terms (/tafs/terms) in Bengali, at /bn/tafs/terms.
// It is a translation of TafsTerms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Bengali has the legal
// texts only, so a link to any other page goes to English and says so.
templ TafsTermsBN() {
	@components.LayoutSiteWithMeta("tafs শর্ত", "tafs-এর শর্ত, KIFF-এর অ্যাপ: কে দেয়, আপনার অ্যাকাউন্ট, taf কী করে ও আপনি কীভাবে নিয়ন্ত্রণ করেন, গ্রহণযোগ্য ব্যবহার, ফি, দায় ও সমাপ্তি।", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · শর্ত</p>
				<h1>tafs শর্ত</h1>
				<p class="legal-meta"><strong>সর্বশেষ হালনাগাদ:</strong> 21 নভেম্বর 2026।</p>
				<p class="legal-disclaimer">এই শর্ত tafs-এর জন্য, iPhone, iPad, Android ও কম্পিউটারের জন্য KIFF-এর অ্যাপ, এবং এর পেছনের সেবা। tafs KIFF Cloud-এর অংশ, এবং এই পৃষ্ঠা এ সম্পর্কে <a href="/bn/terms">KIFF-এর সেবার শর্ত</a> যা বলে তা পুনরায় বলে, তাতে কিছু যোগ না করে। এই পৃষ্ঠা যা কভার করে না তার জন্য KIFF-এর শর্ত প্রযোজ্য। প্রশ্ন: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>।</p>
			</header>
			<section id="provider">
				<h2>1. কে tafs দেয়</h2>
				<p>tafs দেয় <strong>Kiff Agents OÜ</strong>, এস্তোনিয়ার একটি প্রাইভেট লিমিটেড কোম্পানি (রেজিস্ট্রি কোড 17372313), Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estonia-তে। অ্যাকাউন্ট খুলে বা অন্যভাবে tafs ব্যবহার করে আপনি এই শর্ত ও KIFF-এর শর্তে সম্মত হন। কোম্পানির পক্ষে গ্রহণ করলে আপনি নিশ্চিত করেন যে তাকে বাঁধার অধিকার আপনার আছে।</p>
			</section>
			<section id="account">
				<h2>2. আপনার অ্যাকাউন্ট</h2>
				<p>আপনি KIFF অ্যাকাউন্ট দিয়ে tafs-এ সাইন ইন করেন। সঠিক তথ্য দিন, আপনার পরিচয়পত্র গোপন রাখুন, এবং আপনার অ্যাকাউন্টের সব কাজ ও যে প্রত্যেককে আপনি এতে ঢুকতে দেন তার জন্য আপনি দায়ী। আপনার বয়স অন্তত 16 বছর, বা আপনি যেখানে থাকেন সেখানকার ডিজিটাল সম্মতির বয়স, যেটি বেশি সেটি, হতে হবে। আপনি tafs শুধু সেই দেশ বা অঞ্চল থেকে ব্যবহার করতে পারেন যেখানে Anthropic নিজের সেবা দেয়, <a href="https://www.anthropic.com/supported-countries">Anthropic যেভাবে তালিকা করেছে</a>; এমন কোম্পানির জন্য নয় যার সদর দপ্তর, বা যার সংখ্যাগরিষ্ঠ মালিক বা নিয়ন্ত্রণকারী কোম্পানির সদর দপ্তর, সেই তালিকার বাইরের কোনো দেশ বা অঞ্চলে; এবং আপনি, বা যে কোম্পানির জন্য ব্যবহার করেন, ইউরোপীয় ইউনিয়ন, জাতিসংঘ বা যুক্তরাষ্ট্রের নিষেধাজ্ঞার অধীন হলে নয় (KIFF-এর শর্ত, §4)।</p>
			</section>
			<section id="what-a-taf-does">
				<h2>3. taf কী করে</h2>
				<p>tafs-এ আপনি একটি কাজ একটি taf-কে দেন: একটি AI এজেন্ট যা সময়সূচি ধরে, আপনার সংযুক্ত টুল দিয়ে, তার জন্য আপনার ইস্যু করা KIFF Card-এর ভেতরে কাজ করে। যে AI মডেল সে ব্যবহার করে তা Anthropic দেয়। Setup, tafs-এর একটি AI এজেন্ট, টুল সংযুক্ত করতে ও taf সাজাতে সাহায্য করে, কিন্তু নিজে কিছু সংযুক্ত করে না: আপনি টুলের নিজস্ব প্রদানকারীর কাছে সাইন ইন করেন, এবং প্রতিটি সংযোগ, taf যে টুল ব্যবহার করতে পারে এবং তার Card আপনার ডিভাইসে অনুমোদন করেন।</p>
				<p>taf-এর রিপোর্ট, বার্তা ও মেমরি নোট একটি AI মডেল লেখে এবং ভুল হতে পারে। ভরসা করার আগে যা গুরুত্বপূর্ণ তা যাচাই করুন। taf আপনার কোম্পানির বাইরের কাউকে যা লেখে তাতে বলা থাকে যে একটি AI এজেন্ট তা লিখেছে।</p>
			</section>
			<section id="control">
				<h2>4. আপনার নিয়ন্ত্রণ: Card ও অনুমোদন</h2>
				<p>taf আপনার টুলে শুধু KIFF দিয়ে পৌঁছায়, যা প্রতিটি কল পাঠানোর আগে taf-এর Card-এর সঙ্গে মিলিয়ে দেখে। আপনার ইস্যু করা Card-এর মধ্যে একটি কল আপনার নির্দেশে করা হয়। Card-এর বাইরের কল Card যেমন বলে তেমন আটকে রাখা বা প্রত্যাখ্যান করা হয়। আটকে রাখা কল শুধু তখনই করা হয় যখন আপনার অ্যাকাউন্ট যাকে আটকানো কলের উত্তর দিতে দেয় সে তা অনুমোদন করে।</p>
				<p>আপনি প্রতিটি taf-এর কাজ ও Card ঠিক করেন, তার আটকানো কলের উত্তর দেন, এবং আপনি যে টুল ও অ্যাকাউন্ট সংযুক্ত করেন তা ব্যবহারের অধিকার আপনার আছে কি না নিশ্চিত করেন। আপনি একটি taf বা সবগুলো থামাতে (halt), একটি taf বিরতিতে রাখতে, তার যেকোনো Card প্রত্যাহার করতে বা তা সরাতে পারেন। আপনি taf থামানো বা Card প্রত্যাহারের মুহূর্ত থেকে KIFF সেই taf বা সেই Card-এর অধীনে কোনো নতুন কল অনুমোদন করে না। টুলের প্রদানকারীর কাছে ইতিমধ্যে পাঠানো অনুরোধ তবুও সম্পন্ন হতে পারে: আমরা নতুন কল থামাই, প্রদানকারী যা করে ফেলেছে তা ফেরাতে পারি না। বিস্তারিত <a href="/bn/terms#tafs">KIFF-এর শর্ত, §3A</a>-তে।</p>
				<p>ইইউ AI আইনের অধীনে Kiff Agents OÜ tafs-এর সরবরাহকারী এবং আপনি এর স্থাপনকারী। tafs শুধু সে যে কাজ দেয় তার জন্য ব্যবহার করুন, এবং AI আইন নিষিদ্ধ করে বা উচ্চ-ঝুঁকি শ্রেণিতে ফেলে এমন কোনো ব্যবহারে নয়, যেমন কারও কর্মসংস্থান, ঋণ বা অপরিহার্য সেবায় প্রবেশাধিকার বিষয়ক সিদ্ধান্ত।</p>
			</section>
			<section id="acceptable-use">
				<h2>5. গ্রহণযোগ্য ব্যবহার</h2>
				<p>আপনি, আপনার লোকজন ও আপনার taf-দের <a href="/acceptable-use">গ্রহণযোগ্য ব্যবহার নীতি</a> (ইংরেজিতে) মানতে হবে। একটি এজেন্টের কাজ আপনার কাজ। অন্য বিষয়ের মধ্যে, আপনি tafs দিয়ে আইন ভাঙতে, ব্যবহারের অনুমতি নেই এমন সিস্টেম বা অ্যাকাউন্টে কাজ করতে, আপনার দেওয়ার অধিকার নেই এমন সাইন-ইন দিয়ে টুল সংযুক্ত করতে, স্প্যাম পাঠাতে, বা Card, সীমা বা আটকানো এড়াতে পারবেন না। বিশ্বাসযোগ্য লঙ্ঘনে আমরা সঙ্গে সঙ্গে স্থগিত করতে পারি।</p>
			</section>
			<section id="fees">
				<h2>6. ফি</h2>
				<p>এই হালনাগাদের সময়, Solo মাসে { tafsCostBN.money(TafsSoloCents) }, ভ্যাট সহ, মাসে { tafsCostBN.number(TafsSoloCredits) } ক্রেডিট সহ, অ্যাপে App Store বা Google Play দিয়ে বিক্রি। ক্রেডিটের প্যাক, অ্যাপে কেনা, শুরু { tafsCostBN.money(TafsPackCents[TafsSoloCredits]) } থেকে; এগুলোর মেয়াদ শেষ হয় না। taf-এর প্রতিটি রান যে AI ব্যবহার করেছে তার জন্য ক্রেডিট ব্যবহার করে। Coach এবং taf সাজানো Coach-এর ন্যায্য ব্যবহারের মধ্যে অন্তর্ভুক্ত। এগুলো ইউরো অঞ্চলের দাম। অন্য কোথাও App Store বা Google Play আপনার মুদ্রায় দাম দেখায়, সেই দেশের নিয়ম যেমন চায় তেমন স্থানীয় কর সহ বা ছাড়া, এবং সেটিই আপনি দেন। বর্তমান দাম <a href="/pricing">দামের পৃষ্ঠায়</a> (ইংরেজিতে); tafs KIFF-এর Company প্ল্যানেরও অংশ।</p>
				<p>কোনো ট্রায়াল নেই। অ্যাপে কেনা Solo আপনার Apple বা Google Play সাবস্ক্রিপশনে পরিচালিত ও বাতিল হয়, অর্থপ্রদান, নবায়ন ও ফেরতের জন্য সেই স্টোরের শর্তে। একটি প্ল্যান আপনার দেওয়া সময়কালের শেষ পর্যন্ত চলে। আপনি ইইউ-তে ভোক্তা হলে কেনার 14 দিনের মধ্যে প্রত্যাহার করতে পারেন। বিস্তারিত <a href="/bn/terms#fees">KIFF-এর শর্ত, §8</a>-তে।</p>
			</section>
			<section id="liability">
				<h2>7. দায়</h2>
				<p>KIFF-এর শর্তের (§10) ওয়ারেন্টি বাদে tafs „যেমন আছে“ এবং „যেমন পাওয়া যায়“ ভিত্তিতে দেওয়া হয়। আইন যতটুকু অনুমতি দেয়, কোনো পক্ষই পরোক্ষ বা ফলস্বরূপ ক্ষতির জন্য দায়ী নয়, এবং প্রতিটি পক্ষের মোট দায় <a href="/bn/terms#liability">KIFF-এর শর্ত, §12</a> যেমন বলে তেমন সীমিত। আইন যে দায় সীমিত করতে দেয় না তা কিছুই সীমিত করে না।</p>
			</section>
			<section id="termination">
				<h2>8. সমাপ্তি</h2>
				<p>আপনি যেকোনো সময় থামাতে পারেন: অ্যাপে আপনার অ্যাকাউন্ট মুছুন, Account → <em>Delete account</em>-এ। আগে আপনার চ্যাট রপ্তানি করুন, Account → Export my chats থেকে। নোটিশের ত্রিশ দিনের মধ্যে শোধরানো হয়নি এমন মৌলিক লঙ্ঘনে, বা গ্রহণযোগ্য ব্যবহার লঙ্ঘনে সঙ্গে সঙ্গে, আমরা আপনার ব্যবহার শেষ করতে পারি। চলে যাওয়া ও আপনার তথ্য সঙ্গে নেওয়ার আপনার অধিকার <a href="/bn/terms#term">KIFF-এর শর্ত, §9</a>-তে।</p>
			</section>
			<section id="governing-law">
				<h2>9. পরিবর্তন ও প্রযোজ্য আইন</h2>
				<p>আমরা এই শর্ত সেভাবে বদলাই যেভাবে KIFF-এর শর্ত নিজেদের জন্য বলে (§16)। এগুলো এস্তোনিয়া প্রজাতন্ত্রের আইন দ্বারা নিয়ন্ত্রিত, এবং বিরোধ তালিনের Harju County Court-এ যায়। আপনি অন্য ইইউ সদস্য রাষ্ট্রের ভোক্তা হলে আপনার নিজ দেশের বাধ্যতামূলক ভোক্তা-সুরক্ষা নিয়ম তবুও প্রযোজ্য।</p>
			</section>
			<section id="contact">
				<h2>10. যোগাযোগ</h2>
				<p>চুক্তিগত প্রশ্ন: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>। অ্যাপে সাহায্য: <a href="mailto:support@kiff.dev">support@kiff.dev</a>। গোপনীয়তা: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>, এবং tafs কীভাবে ব্যক্তিগত তথ্য সামলায় তা <a href="/bn/tafs/privacy">tafs গোপনীয়তা নীতি</a>-তে।</p>
			</section>
		</article>
	}
}
