package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// TermsUR is KIFF's Terms of Service (/terms) in Urdu, at /ur/terms.
// It is a translation of Terms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Urdu has the legal
// texts only, so a link to any other page goes to English and says so. It is
// written right to left (components.IsRightToLeft).
// (Sections 8 to 20 are in ur_terms_more.templ.)
templ TermsUR() {
	@components.LayoutSite("KIFF — terms of service", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@termsHeadUR()
			@termsDefinitionsUR()
			@termsAgreementUR()
			@termsServiceUR()
			@termsTafsUR()
			@termsAccountUR()
			@termsAcceptableUseUR()
			@termsCustomerDataUR()
			@termsConfidentialityUR()
			@termsFeesUR()
			@termsTermUR()
			@termsWarrantiesUR()
			@termsDisclaimerUR()
			@termsLiabilityUR()
			@termsIndemnityUR()
			@termsSLAUR()
			@termsServiceModsUR()
			@termsTermsModsUR()
			@termsForceMajeureUR()
			@termsGoverningLawUR()
			@termsGeneralUR()
			@termsContactUR()
		</article>
	}
}

templ termsHeadUR() {
	<header class="legal-head">
		<p class="legal-badge">سروس کی شرائط · v0.1</p>
		<h1>سروس کی شرائط</h1>
		<p class="legal-meta">
			<strong>آخری تازہ کاری:</strong> 22 نومبر 2026۔
			<strong>نفاذ کی تاریخ:</strong> 24 مئی 2026۔
		</p>
		<p class="legal-disclaimer">
			<strong>کیا بدلا:</strong> جب کسی دوسرے کاروبار نے آپ کا تعارف کرایا تب آپ کا معاہدہ کس کے ساتھ ہے (§2)، اور مائیکرو ادارے (§8)۔ پہلے: سروس کون استعمال کر سکتا ہے، خطے، ملکیت اور پابندیوں کے مطابق (§4)؛ Android پر tafs ایپ، اور
			Google Play سے خریدا گیا Solo (§1، §8)۔ اس سے پہلے: ادائیگی والے
			پلان (§3A، §8)،
			<a href="/legal/sla">سروس لیول معاہدہ</a> (§14)، اور
			ممنوع استعمالات کی فہرست، جو اب
			<a href="/acceptable-use">قابلِ قبول استعمال کی پالیسی</a> (§5) میں ہے۔
		</p>
		<p class="legal-disclaimer">
			یہ شرائط tafs سمیت KIFF Cloud کے استعمال کو منظم کرتی ہیں۔ معاہدے سے متعلق
			سوالات:
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>۔
		</p>
	</header>
}

templ termsDefinitionsUR() {
	<section id="definitions">
		<h2>1. تعریفات</h2>
		<ul>
			<li><strong>"Kiff Agents OÜ"</strong>، <strong>"ہم"</strong>، <strong>"ہمیں"</strong>، <strong>"ہمارا"</strong> — سروس فراہم کرنے والی ایسٹونیا کی نجی محدود ذمہ داری کمپنی۔ رجسٹریشن کوڈ 17372313۔</li>
			<li><strong>"صارف"</strong>، <strong>"آپ"</strong>، <strong>"آپ کا"</strong> — ان شرائط پر متفق ہونے والا قدرتی یا قانونی شخص۔</li>
			<li><strong>"استعمال کنندہ"</strong> — کوئی بھی فرد جسے صارف اپنے اکاؤنٹ کے ذریعے سروس تک رسائی کے لیے مجاز کرتا ہے۔</li>
			<li><strong>"سروس"</strong> — KIFF Cloud مصنوعہ، جس میں <code>api.kiff.dev</code>، <code>app.kiff.dev</code>، <code>kiff.dev</code>، tafs، اور وہاں ہمارے شائع کردہ دستاویزات، ڈیش بورڈز اور APIs شامل ہیں۔</li>
			<li><strong>"tafs"</strong> — iPhone، iPad، Android اور کمپیوٹرز (Mac، Windows اور Linux) کے لیے tafs ایپ اور اس کے پیچھے کی سروس، جس میں Setup اور planque (§3A) شامل ہیں، جس میں صارف KIFF Card کے اندر کام کرنے والے AI ایجنٹ کو کام سونپتا ہے۔ <strong>"taf"</strong> ایسا ایک ایجنٹ ہے۔</li>
			<li><strong>"ٹیننٹ"</strong> — سروس کے اندر ایک صارف کا منطقی طور پر الگ کام کی جگہ۔</li>
			<li><strong>"آڈٹ ڈیٹا"</strong> — وہ واقعات، فیصلے، اعمال، منظوریاں اور رسیدیں جنہیں سروس رن ٹائم کے ذریعے صارف کی طرف سے محفوظ کرتی ہے۔</li>
			<li><strong>"tafs ڈیٹا"</strong> — جو tafs صارف کی طرف سے رکھتا ہے: ہر taf کے رن اور چیٹس (جس میں صارف کے جڑے ٹولز اسے جو لوٹاتے ہیں وہ بھی)، اس کی رپورٹیں، اس کے میموری نوٹس، اور اس کے الرٹس کے لیے رجسٹرڈ فونز۔</li>
			<li><strong>"رسید"</strong> — سروس کی طرف سے ہر منظم عمل کے لیے جاری دستخط شدہ، ورژن والا فیصلے کا ریکارڈ۔</li>
			<li><strong>"دستاویزات"</strong> — ان شرائط سے جڑے تاریخ والے ورژن میں تکنیکی سروس دستاویزات اور سیکیورٹی اقدامات (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>)۔ اس میں حکمتِ عملی کا وائٹ پیپر، مارکیٹنگ مواد اور الگ سے لائسنس یافتہ اوپن سورس فریم ورک کے دستاویزات شامل نہیں۔</li>
			<li><strong>"DPA"</strong> — <a href="/legal/dpa">/legal/dpa</a> پر ڈیٹا پراسیسنگ معاہدہ، جو ہمارے پراسیسر کی طرف کے تعلق کو منظم کرتا ہے۔</li>
		</ul>
	</section>
}

templ termsAgreementUR() {
	<section id="agreement">
		<h2>2. معاہدہ</h2>
		<p>
			یہ شرائط سروس کے آپ کے استعمال کو منظم کرتی ہیں۔ اکاؤنٹ بنا کر،
			API key بنا کر یا کسی اور طرح سروس استعمال کر کے
			آپ ان شرائط سے اتفاق کرتے ہیں۔ اگر آپ کسی کمپنی یا دوسرے قانونی
			ادارے کی طرف سے قبول کرتے ہیں، تو آپ اعلان کرتے ہیں کہ آپ کو اس ادارے کو پابند کرنے کا اختیار ہے، اور "آپ"
			اور "آپ کا" اس ادارے کے لیے ہیں۔
		</p>
		<p>
			اگر کسی ڈویلپر، شراکت دار یا دوسرے کاروبار نے آپ کا KIFF سے تعارف کرایا یا آپ کے استعمال کیے ایجنٹ کو بنایا، تو سروس کے لیے آپ کا معاہدہ براہِ راست ہمارے ساتھ، ان شرائط کے تحت ہے، اور آپ انہیں خود قبول کرتے ہیں۔ وہ کاروبار ہمارا ایجنٹ نہیں ہے: وہ ان شرائط کو قبول نہیں کر سکتا، آپ کی طرف سے رضامندی یا ادائیگی کی منظوری نہیں دے سکتا، اور وہ ہماری طرف سے سروس نہیں بیچتا۔
		</p>
		<p>
			ہم مخصوص خصوصیات (بیٹا خصوصیات، تیسرے فریق کے
			انضمام) کے لیے اضافی شرائط شائع کر سکتے ہیں۔ جہاں وہ ان شرائط سے ٹکرائیں،
			اس مخصوص خصوصیت کے لیے اضافی شرائط مؤثر ہوتی ہیں۔
		</p>
	</section>
}

templ termsServiceUR() {
	<section id="service">
		<h2>3. سروس</h2>
		<p>
			KIFF Cloud سونپے گئے اعمال کو منظم کرنے کی ہوسٹڈ سروس ہے۔ وہ درخواستوں کو صارف کی
			ترتیب دی گئی اجازتوں اور Card سے جانچتی ہے، انسانی
			منظوری مانگ سکتی ہے، اور گورننس فیصلے ریکارڈ کرتی ہے۔ ترتیب دیے گئے انضمام کے مطابق، KIFF مجاز
			درخواست آگے بھیجتا ہے یا ایسا اختیار دیتا ہے جسے محفوظ
			سسٹم تصدیق کرتا ہے۔ جڑا ہوا سسٹم
			بنیادی عمل کرتا ہے۔
		</p>
		<p>
			لاگو تکنیکی رویہ، شواہد، انضمام کی
			ضروریات اور عمل کی حدیں ان شرائط سے جڑے
			تاریخ والے دستاویزات میں متعین ہیں۔ حکمتِ عملی کا
			<a href="/whitepaper">وائٹ پیپر</a> (انگریزی میں) KIFF کے
			اصول اور ماڈل بیان کرتا ہے؛ وہ ان شرائط کے تحت تکنیکی دستاویزات کے طور پر شامل نہیں۔
		</p>
		<p>
			KIFF Cloud کی گورننس سروس ایجنٹ فریم ورک، ورک فلو انجن، ماڈل گیٹ وے یا منظم ایجنٹ پلیٹ فارم <em>نہیں</em> ہے۔ وہ اسی کے ساتھ جڑتی ہے جو آپ پہلے سے استعمال کرتے ہیں۔
			واضح فہرست کے لیے ہوم پیج پر <a href="/#not">"KIFF کیا نہیں ہے"</a> (انگریزی میں)
			دیکھیں۔ tafs سروس کا وہ واحد حصہ ہے جو آپ کے لیے ایجنٹس
			چلاتا ہے، آپ کے جاری کیے Card کے اندر؛ §3A اس کا بیان کرتا ہے۔
		</p>
		<p>
			اوپن سورس <a href="https://github.com/kiff/kiff" target="_blank" rel="noopener">kiff/kiff</a>
			فریم ورک اپنے MIT لائسنس سے منظم ہے اور ان شرائط سے باہر ہے۔
			جب آپ فریم ورک اپنے انفراسٹرکچر پر چلاتے ہیں، تو Kiff Agents OÜ کے ساتھ کوئی معاہدہ
			نہیں بنتا۔
		</p>
	</section>
}

templ termsTafsUR() {
	<section id="tafs">
		<h2>3A. tafs</h2>
		<p>
			tafs میں آپ taf کو کام (جیسے رقم واپسیاں، بل کی ادائیگی یا
			کارڈ تنازعات) سونپتے ہیں: ایک AI ایجنٹ جو آپ کے جوڑے ٹولز کے ساتھ، آپ کے اس کے لیے جاری کیے
			KIFF Card کے اندر، مقررہ وقت پر کام کرتا ہے۔ ہر taf ہمارے ایجنٹ رن ٹائم پر چلتا ہے، اور
			وہ جو AI ماڈل استعمال کرتا ہے اسے Anthropic فراہم کرتی ہے۔ آپ اس کی روکی گئی کالز کا جواب tafs ایپ میں دیتے ہیں۔
		</p>
		<p>
			<strong>اپنے ٹولز جوڑنا۔</strong> Setup، tafs کا ایک AI ایجنٹ جو taf کی طرح چلتا ہے، آپ کو ٹول جوڑنے اور
			کسی کام کے لیے taf بنانے میں مدد دیتا ہے۔ وہ خود
			کچھ نہیں جوڑتا۔ آپ ٹول کے اپنے فراہم کنندہ پر (جیسے
			Stripe) سائن اِن کرتے ہیں، اور آپ اپنے آلے پر ہر
			کنکشن، taf جو ٹولز استعمال کر سکتا ہے، اور اس کے Card کو منظور کرتے ہیں۔ اس سائن اِن کا
			ٹوکن ہماری کنکشن سروس planque رکھتی ہے۔ وہ خفیہ کردہ ہے، صرف KIFF کے طے کی گئی کال کرنے کے لیے استعمال ہوتا ہے، اور کبھی کسی taf کو نہیں دیا جاتا۔ کسی ٹول کو ڈسکنیکٹ کرنا
			فراہم کنندہ پر ٹوکن منسوخ کرتا ہے اور اسے حذف کر دیتا ہے۔
		</p>
		<p>
			<strong>آپ کے Card آپ کی ہدایات ہیں۔</strong> taf
			آپ کے ٹولز تک صرف KIFF کے ذریعے پہنچتا ہے، جو ہر
			کال کو بھیجنے سے پہلے taf کے Card سے جانچتا ہے۔ آپ کے جاری کیے
			Card کے اندر کی کال آپ کی ہدایت پر کی جاتی ہے۔
			Card کے باہر کی کال روکی یا مسترد کی جاتی ہے، جیسا Card کہتا ہے۔
			روکی گئی کال تبھی کی جاتی ہے جب آپ کا اکاؤنٹ جسے روکی گئی کالز کا جواب دینے کی اجازت دیتا ہے وہ اسے منظور کرے۔ tafs ایپ میں
			جواب کے ساتھ ان کے آلے کا دستخط ہوتا ہے جسے KIFF تصدیق کرتا ہے، اور
			رسید وہ ثبوت رکھتی ہے۔ آپ کا اکاؤنٹ KIFF میں بھی جواب دے سکتا ہے
			(ڈیش بورڈ، اس کا کمانڈ لائن ٹول، یا وہاں آپ کا مجاز کیا ہوا منظور کنندہ)؛
			تب رسید ریکارڈ کرتی ہے کہ کس نے اور کیسے جواب دیا۔
		</p>
		<p>
			<strong>ادائیگیاں۔</strong> جب taf آپ کے لیے کسی
			چیک آؤٹ پر، اس سائٹ پر محفوظ کارڈ یا دوسرے ادائیگی کے طریقے سے ادائیگی کرتا ہے، تو وہ یہ صرف Card کے اندر اور آپ کے
			اس ادائیگی کو اپنے فون پر منظور کرنے کے بعد کرتا ہے۔ آپ کی منظوری
			اس ایک ادائیگی کو آپ کی طرف سے مجاز کرتی ہے۔ سائٹ اور
			اس کا ادائیگی فراہم کنندہ اسے پراسیس کرتے ہیں۔ KIFF اور planque آپ کا پیسہ کبھی
			اپنے پاس نہیں رکھتے، آپ کے کارڈ کی تفصیل کبھی محفوظ نہیں کرتے، اور taf
			کبھی کارڈ نمبر نہیں لکھتا۔
		</p>
		<p>
			<strong>آپ کے پاس کیا رہتا ہے۔</strong> آپ ہر
			taf کا کام اور Card چنتے ہیں، اس کی روکی گئی کالز کا جواب دیتے ہیں، اور یقینی بناتے ہیں کہ
			آپ کو اپنے جوڑے ٹولز اور اکاؤنٹس استعمال کرنے کا حق ہے۔ taf کی
			رپورٹیں، پیغامات اور میموری نوٹس ایک AI
			ماڈل لکھتا ہے اور وہ غلط ہو سکتے ہیں؛ بھروسہ کرنے سے
			پہلے اہم باتیں جانچ لیں۔
		</p>
		<p>
			<strong>taf کو روکنا۔</strong> آپ ایک taf یا
			سب کو روک سکتے ہیں، کسی taf کو تھما سکتے ہیں، اس کا کوئی بھی Card منسوخ کر سکتے ہیں، یا
			اسے ہٹا سکتے ہیں۔ جس لمحے آپ taf کو روکتے ہیں یا
			Card منسوخ کرتے ہیں، اسی لمحے سے KIFF اس کے تحت کوئی نئی کال نہیں ہونے دیتا۔ tafs ایپ
			taf کو رکا ہوا تبھی دکھاتی ہے جب KIFF اور planque دونوں نے روک کی
			تصدیق کر دی ہو؛ تب سے planque اس کی کوئی
			کال نہیں بھیجتا، KIFF کی ٹھیک پہلے اجازت دی ہوئی کال بھی نہیں۔ ٹول کے فراہم کنندہ کو
			پہلے ہی بھیجی جا چکی درخواست پھر بھی مکمل ہو سکتی ہے: ہم
			نئی کالز روکتے ہیں، مگر فراہم کنندہ نے جو کر دیا اسے واپس نہیں کر سکتے۔
			جو ٹول KIFF کے اجازت نامے خود جانچتا ہے، planque کے بغیر،
			وہ KIFF کے ٹھیک پہلے جاری کیے اجازت نامے کو زیادہ سے زیادہ 90 سیکنڈ تک اب بھی قبول کر سکتا ہے۔ رکے taf کو دوبارہ چالو کرنے کے لیے آپ کے آلے پر
			آپ کی منظوری چاہیے، اور روک سے پہلے روکا یا قطار میں لگا کچھ بھی
			اس کے بعد نہیں چلتا۔
		</p>
		<p>
			<strong>taf کو ہٹانا</strong> اس کا مقررہ وقت روکتا ہے اور اس کے
			رن، چیٹس، میموری اور اس کی استعمال کی key حذف کرتا ہے۔ اس سے پہلے بھی، آپ کے ٹولز taf کو جو لوٹاتے ہیں
			وہ صرف اس کے رن ختم ہونے تک رکھا جاتا ہے (چیٹ نے جو صرف پڑھا،
			خفیہ کردہ، اس کے اگلے پیغامات کے لیے: زیادہ سے زیادہ چار
			گھنٹے استعمال ہوتا ہے، پھر حذف کر دیا جاتا ہے)، اور اس کے رن اور چیٹس 30 دن۔ KIFF جو اس نے کیا اس کی رسیدیں رکھتا ہے۔
		</p>
		<p>
			<strong>EU AI Act۔</strong> tafs کے لیے Kiff Agents OÜ
			AI سسٹم کی فراہم کنندہ ہے اور آپ اس کے تعینات کنندہ ہیں۔
			ہم یقینی بناتے ہیں کہ taf آپ کی کمپنی سے باہر کسی کو جو بھی لکھتا ہے اس میں بتایا جاتا ہے کہ AI ایجنٹ نے لکھا۔
			آپ tafs کو صرف ان کاموں کے لیے استعمال کرتے ہیں جو وہ پیش کرتا ہے، اور کسی ایسے استعمال کے لیے نہیں جسے AI Act
			ممنوع قرار دیتا ہے یا زیادہ خطرے والا شمار کرتا ہے، جیسے
			کسی شخص کے روزگار، قرض یا ضروری خدمات تک رسائی کے بارے میں فیصلے۔ آپ اپنے Card کی مانگی انسانی منظوریاں برقرار رکھتے ہیں،
			اور یقینی بناتے ہیں کہ جو لوگ آپ کے لیے tafs استعمال کرتے ہیں وہ
			سمجھتے ہیں کہ وہ کیا کرتا ہے اور اس کی حدیں کیا ہیں۔
		</p>
		<p>
			<strong>لاگت۔</strong> tafs آپ کے KIFF پلان کا حصہ ہے
			(§8): taf کا ہر رن اپنے استعمال کیے AI کے لیے کریڈٹس خرچ کرتا ہے۔
			Coach اور tafs بنانا Coach کے
			منصفانہ استعمال کے اندر شامل ہیں۔
		</p>
	</section>
}

templ termsAccountUR() {
	<section id="account">
		<h2>4. اکاؤنٹس اور رسائی</h2>
		<p>
			سروس استعمال کرنے کے لیے آپ کو اکاؤنٹ بنانا ہو گا۔ آپ درست رجسٹریشن معلومات
			دینے، اپنی لاگ اِن تفصیلات خفیہ رکھنے، اور اپنے اکاؤنٹ کی
			ساری سرگرمی کے ذمہ دار ہونے سے اتفاق کرتے ہیں۔
		</p>
		<p>
			آپ کی عمر کم از کم 16 سال ہونی چاہیے، یا آپ کے دائرہ اختیار میں ڈیجیٹل
			رضامندی کی عمر، جو بھی زیادہ ہو۔ سروس
			بچوں کے لیے نہیں ہے۔
		</p>
		<p>
			سروس صرف ان ممالک اور خطوں میں دی جاتی ہے جہاں Anthropic، جو اس کا AI ماڈل فراہم کرتی ہے، اپنی سروس دیتی ہے، جیسا <a href="https://www.anthropic.com/supported-countries">Anthropic انہیں فہرست کرتی ہے</a>۔ آپ اسے کہیں اور سے استعمال نہیں کر سکتے۔ کوئی کمپنی اسے استعمال نہیں کر سکتی اگر اس کا صدر دفتر اس فہرست سے باہر کسی ملک یا خطے میں ہو، یا اس کی اکثریتی ملکیت یا کنٹرول اس فہرست سے باہر صدر دفتر والی کسی کمپنی کے پاس ہو، چاہے اس کے صارفین کہیں بھی ہوں۔ نہ ہی آپ اسے استعمال کر سکتے ہیں اگر آپ، یا وہ کمپنی جس کے لیے آپ اسے استعمال کرتے ہیں، یورپی یونین، اقوامِ متحدہ یا ریاستہائے متحدہ کی پابندیوں کے تحت ہوں۔ ہم اس اصول کو توڑنے والے اکاؤنٹس کو مسترد کرتے ہیں اور جو توڑے اسے معطل کر سکتے ہیں۔
		</p>
		<p>
			آپ اپنے اکاؤنٹ پر مجاز ہر استعمال کنندہ کے
			اعمال کے ذمہ دار ہیں۔ ان شرائط کی معتبر
			خلاف ورزی کا پتہ چلنے پر ہم معقول نوٹس پر اکاؤنٹ معطل یا رسائی منسوخ کر سکتے ہیں۔ قابلِ قبول استعمال کی خلاف ورزیوں کے لیے
			(دیکھیں §5) معطلی فوری ہو سکتی ہے۔
		</p>
	</section>
}

templ termsAcceptableUseUR() {
	<section id="acceptable-use">
		<h2>5. قابلِ قبول استعمال</h2>
		<p>
			آپ، آپ کے استعمال کنندگان اور آپ کے ایجنٹس کو
			<a href="/acceptable-use">قابلِ قبول استعمال کی پالیسی</a> (انگریزی میں) پر عمل کرنا ہو گا۔ وہ
			ان شرائط کا حصہ ہے اور بتاتی ہے کہ سروس کو کس کام کے لیے
			استعمال نہیں کیا جا سکتا۔
		</p>
		<p>
			ہم معتبر AUP خلاف ورزی پر فوری طور پر معطل کر سکتے ہیں۔
			ہم صارف کے مواد کی نگرانی کے پابند نہیں مگر
			معتبر رپورٹوں پر کارروائی کر سکتے ہیں۔
		</p>
	</section>
}

templ termsCustomerDataUR() {
	<section id="customer-data">
		<h2>6. صارف کا ڈیٹا اور مواد</h2>
		<p>
			آپ کا آڈٹ ڈیٹا آپ کا ہے۔ آپ Kiff Agents OÜ کو
			محدود، غیر خصوصی، رائلٹی فری، عالمی لائسنس دیتے ہیں:
			آپ کے آڈٹ ڈیٹا کو صرف اتنا ہوسٹ کرنے، کاپی کرنے، منتقل کرنے، دکھانے اور بصورتِ دیگر پراسیس کرنے کے لیے جتنا آپ کے لیے سروس کو چلانے، برقرار رکھنے
			اور بہتر بنانے کے لیے ضروری ہو۔
		</p>
		<p>
			ہم آپ کے آڈٹ ڈیٹا اور آپ کے tafs ڈیٹا کے لیے GDPR کے آرٹیکل 28 کے تحت
			<strong>پراسیسر</strong> کے طور پر کام کرتے ہیں؛
			<a href="/legal/dpa">DPA</a> اس تعلق کو تفصیل سے منظم کرتا ہے۔ ہم آپ کے اکاؤنٹ کے
			میٹا ڈیٹا کے لیے <strong>کنٹرولر</strong> کے طور پر کام کرتے ہیں؛
			<a href="/ur/privacy">رازداری کی پالیسی</a> اس
			تعلق کو منظم کرتی ہے۔
		</p>
		<p>
			آپ اعلان کرتے ہیں کہ آپ کے پاس وہ ڈیٹا پیش کرنے کے سارے ضروری حقوق ہیں جو آپ پیش کرتے ہیں،
			اور پیشکش لاگو قوانین (ڈیٹا تحفظ کے قوانین اور،
			جہاں لاگو ہو، EU AI Act سمیت) کے مطابق ہے۔
		</p>
	</section>
}

templ termsConfidentialityUR() {
	<section id="confidentiality">
		<h2>7. رازداری</h2>
		<p>
			ہر فریق دوسرے سے غیر عوامی معلومات پا سکتا ہے
			("خفیہ معلومات")۔ وصول کنندہ فریق خفیہ معلومات کا استعمال صرف اتنا کرے گا جتنا
			ان شرائط کے تحت اپنے فرائض نبھانے اور حقوق استعمال کرنے کے لیے ضروری ہو، اور اس کی حفاظت کم از کم اسی
			درجے کی احتیاط سے کرے گا جس سے وہ اپنی خفیہ
			معلومات کی کرتا ہے۔
		</p>
		<p>
			خفیہ معلومات میں وہ معلومات شامل نہیں جو
			(a) بغیر خلاف ورزی کے عوامی طور پر دستیاب ہے یا ہو جاتی ہے،
			(b) افشا سے پہلے وصول کنندہ فریق کو معلوم تھی،
			(c) خفیہ معلومات کے استعمال کے بغیر آزادانہ طور پر تیار کی گئی، یا (d) قانون کے ذریعے
			افشا کرنی ضروری ہے
			(جہاں اجازت ہو وہاں دوسرے فریق کو نوٹس کے ساتھ)۔
		</p>
	</section>
}
