package pages

// The second half of TermsHI (/hi/terms): §8 to §20. See hi_terms.templ.

templ termsFeesHI() {
	<section id="fees">
		<h2>8. शुल्क और भुगतान</h2>
		<p>
			<strong>योजनाएँ।</strong> हर खाते की एक योजना है।
			मौजूदा कीमतें <a href="/pricing">कीमतों के पृष्ठ</a> (अंग्रेज़ी में) पर हैं; इस अपडेट के
			समय:
		</p>
		<ul>
			<li><strong>Solo:</strong> एक व्यक्ति के लिए, tafs के लिए, tafs ऐप में App Store या Google Play से €12.50 प्रति माह पर बिकता है, VAT सहित, प्रति माह 500 क्रेडिट शामिल।</li>
			<li><strong>Company:</strong> हर सीट के लिए €10.50 प्रति माह, हर सीट के लिए प्रति माह 500 क्रेडिट, साझा, और KIFF Cloud से आपके अपने एजेंटों की कॉल के लिए हर सीट पर प्रति माह 500 कार्रवाइयाँ, साझा।</li>
			<li><strong>एक अनुबंध:</strong> उसके ऑर्डर फ़ॉर्म में दिए शुल्क और शर्तें।</li>
		</ul>
		<p>
			सीटें किसी खाते के एडमिन और एडिटर हैं। मंज़ूरीकर्ता और
			दर्शक हर योजना में मुफ़्त हैं। Company में, जो शामिल है उससे
			अधिक पर, एक क्रेडिट €0.01 और एक कार्रवाई €0.02 की है।
			शामिल से अधिक क्रेडिट खाते की तय मासिक
			खर्च सीमा तक बिल होते हैं (शुरू में €50):
			सीमा पर KIFF अगली अवधि शुरू होने तक, या बिलिंग सँभालने वाले के उसे बढ़ाने तक, खाते के
			tafs की कोई नई रन शुरू नहीं करता।
		</p>
		<p>
			<strong>क्रेडिट पैक।</strong> Solo में, महीने के शामिल क्रेडिट से
			अधिक क्रेडिट tafs ऐप में खरीदे क्रेडिट
			पैक से आते हैं। पैक एक बार खरीदा जाता है, उसकी अवधि
			समाप्त नहीं होती, और वह सदस्यता नहीं है; उसके क्रेडिट महीने के शामिल क्रेडिट के
			बाद, सबसे पुराना पैक पहले, उपयोग होते हैं। जिस पैक का भुगतान पूरा रिफंड हो
			वह उसके बचे क्रेडिट सहित वापस ले लिया जाता है। जब महीने के क्रेडिट और
			पैक खत्म हो जाते हैं, तो KIFF अगली अवधि शुरू होने या पैक जुड़ने तक खाते के
			tafs की कोई नई रन शुरू नहीं करता।
			KIFF जो बोनस क्रेडिट किसी खाते में जोड़ता है
			उनकी भी अवधि समाप्त नहीं होती, पैक की तरह।
		</p>
		<p>
			<strong>क्या गिना जाता है।</strong> <em>क्रेडिट</em> taf की रन के उपयोग किए
			AI का भुगतान करता है, पूरे क्रेडिट में, हर रन पर एक बार ऊपर की ओर पूर्णांकित और रन खत्म होने पर एक बार गिना जाता है। जिस रन की कॉल KIFF ने अस्वीकार की उसने भी अपना AI उपयोग किया। कभी नहीं गिने जाते:
			Coach और tafs बनाना, Coach के उचित उपयोग के भीतर; नए संस्करण का
			ट्रायल, जो कुछ नहीं भेजता; और हमारी ओर से
			विफल रन। <em>कार्रवाई</em> आपके अपने एजेंट की KIFF Cloud से वह कॉल है जिससे कुछ हुआ:
			KIFF ने अनुमति दी, वह भेजी गई, और टूल ने
			सफलता बताई। कार्रवाई के रूप में कभी नहीं गिना जाता: अस्वीकार की गई, रोककर फिर अस्वीकार की गई, रोक से रुकी,
			अमान्य, टूल पर विफल, या जिसका नतीजा अज्ञात है ऐसी कॉल,
			और केवल पढ़ने वाली कॉल।
		</p>
		<p>
			<strong>कोई ट्रायल नहीं।</strong> खाता पहले दिन से भुगतान करता है। योजना शुरू होने से पहले, KIFF उसके tafs की कोई रन शुरू नहीं करता,
			Coach के सेटअप के अलावा; कुछ हटाया नहीं जाता।
		</p>
		<p>
			<strong>भुगतान और चालान।</strong> योजना का बिल एक ही जगह बनता है। kiff.dev पर खरीदी योजना वहीं और उससे जुड़े बिलिंग पोर्टल में खरीदी, बदली और
			रद्द की जाती है, और उसके भुगतान Stripe प्रोसेस करता है। tafs ऐप में खरीदा Solo iPhone और iPad पर App Store से, या
			Android पर Google Play से बिकता है, और आपकी Apple
			सदस्यताओं या Google Play सदस्यताओं में, उस
			स्टोर की भुगतान, नवीनीकरण और रिफंड की शर्तों के तहत प्रबंधित होता है। क्रेडिट
			पैक ऐप में खरीदे जाते हैं। Company
			kiff.dev पर खरीदी जाती है। शुल्क हर माह अग्रिम बिल होते हैं;
			शामिल से अधिक उपयोग अगले चालान में बिल होता है। लोगों की संख्या का बदलाव अगले
			चालान से लागू होता है। यदि भुगतान विफल हो और ठीक न किया जाए, तो
			योजना समाप्त हो जाती है और KIFF योजना चुने जाने तक खाते की कॉल
			अस्वीकार करता है।
		</p>
		<p>
			<strong>रद्द करना।</strong> आप कभी भी बिलिंग पोर्टल में,
			या ऐप में खरीदे Solo के लिए अपनी Apple सदस्यताओं या Google Play सदस्यताओं में रद्द कर सकते हैं। योजना आपके भुगतान की
			अवधि के अंत तक चलती है, और नवीनीकृत नहीं होती। जहाँ कानून माँगे उसके सिवा, पहले दिया शुल्क वापस नहीं होता। यदि आप
			EU में उपभोक्ता हैं, तो आप खरीद के 14 दिन के भीतर
			बिना कारण बताए वापस ले सकते हैं, और हम आपके दिए शुल्क में से योजना के पहले चले दिनों का हिस्सा घटाकर लौटाते हैं।
			Solo खरीदारी का रिफंड App Store या Google Play से, उनकी शर्तों के तहत होता है।
		</p>
		<p>
			<strong>सूक्ष्म उद्यम।</strong> यदि आपके व्यवसाय में 10 से कम लोग हैं और वार्षिक कारोबार या बैलेंस शीट कुल अधिकतम €2 मिलियन है, तो हम इन शर्तों में कार्ड से किए भुगतानों के हर नियम के लिए, Company सहित, उसे उपभोक्ता मानते हैं।
		</p>
		<p>
			<strong>VAT।</strong> Company की कीमतें VAT के बिना हैं; Solo
			और क्रेडिट पैक App Store या Google
			Play द्वारा VAT सहित बेचे जाते हैं। Kiff Agents OÜ
			(VAT संख्या EE102924327) जहाँ लागू हो एस्टोनियाई VAT जोड़ती है।
			एस्टोनिया से बाहर के वैध VAT पहचान संख्या वाले ग्राहक को EU व्यवसाय-से-व्यवसाय बिक्री
			EU रिवर्स-चार्ज तंत्र के तहत चालान की जाती है।
		</p>
		<p>
			<strong>बदलाव।</strong> हम सक्रिय खातों को कीमत बढ़ने की कम से कम
			तीस दिन की लिखित सूचना देते हैं (§16)। कीमत की
			कमी अगले चालान से लागू होती है।
		</p>
	</section>
}

templ termsTermHI() {
	<section id="term">
		<h2>9. अवधि और समाप्ति</h2>
		<p>
			ये शर्तें तब लागू होती हैं जब आप पहली बार सेवा का उपयोग करते हैं
			और समाप्ति तक जारी रहती हैं।
		</p>
		<p>
			आप कभी भी अपना खाता हटाकर समाप्त कर सकते हैं।
			हम (a) लिखित सूचना के तीस दिन के भीतर ठीक न किए गए सारभूत उल्लंघन पर, या (b) स्वीकार्य उपयोग के उल्लंघन या
			दिवालियापन की घटनाओं पर तुरंत समाप्त कर सकते हैं।
		</p>
		<p id="leaving">
			<strong>छोड़ना, और अपना डेटा साथ ले जाना।</strong>
			आप अपना डेटा कभी भी संरचित, मशीन-पठनीय
			प्रारूप में निर्यात कर सकते हैं: KIFF में, सेटिंग → डेटा आपके खाते, हर संस्करण के साथ आपके Card,
			आपके Record के निर्णय (सबसे ताज़ा 10,000; अधिक के लिए हमसे माँगें), KIFF द्वारा अनुमत हर एक की हस्ताक्षरित रसीद, और
			आपकी API key के विवरण (key खुद कभी नहीं) वाली JSON फ़ाइल देता है। tafs ऐप में हर व्यक्ति अपनी
			चैट, फ़ाइलें और नोट खाता →  मेरी चैट निर्यात करें
			से निर्यात करता है; गोपनीयता नीति के अनुसार चैट हर हाल में तीस दिन रखी जाती हैं। खाता हटाने से सेवा
			तुरंत समाप्त हो जाती है, इसलिए पहले निर्यात करें।
		</p>
		<p>
			आप इसके बजाय सूचना देकर दूसरे प्रदाता या अपने सिस्टम पर जाने के लिए
			<a href="mailto:support@kiff.dev">support@kiff.dev</a> को लिखकर जा सकते हैं।
			हम दो महीने से अधिक की सूचना कभी नहीं माँगते: आपकी सूचना
			आपकी चुनी तारीख पर प्रभावी होती है, जो भेजने के बाद अधिकतम दो
			महीने बाद हो। उस तारीख से तीस दिन की संक्रमण
			अवधि चलती है, जिसमें सेवा चलती रहती है, आप अपना डेटा निर्यात करते और अपना काम ले जाते हैं, और हम
			ऐसा करने के उचित अनुरोधों में मदद करते हैं। आप संक्रमण
			अवधि को एक बार, जितनी ज़रूरत हो उतनी, बढ़ा सकते हैं। यदि हम
			उसे तीस दिन में तकनीकी रूप से पूरा न कर सकें, तो आपकी सूचना के चौदह कार्य
			दिवस के भीतर कारणों और सात महीने से अधिक न होने वाली नई अवधि के साथ बताते हैं।
			संक्रमण अवधि के बाद, आपका डेटा निर्यात के लिए कम से कम
			तीस दिन और उपलब्ध रहता है। योजना का शुल्क संक्रमण अवधि समाप्त होने तक सामान्य रूप से
			जारी रहता है। App Store या Google Play में खरीदा Solo
			स्टोर में रद्द किया जाता है; संक्रमण और निर्यात अवधियाँ उसी
			तरह लागू होती हैं।
		</p>
		<p>
			हम छोड़ने, बदलने या आपका डेटा निर्यात करने का कोई शुल्क नहीं लेते। यह खंड EU डेटा अधिनियम (विनियमन (EU) 2023/2854) के अध्याय VI के
			स्विचिंग अधिकार हर
			ग्राहक को देता है।
		</p>
		<p>
			समाप्ति पर, और किसी भी संक्रमण और निर्यात अवधि के बाद, हम आपका ऑडिट डेटा, आपका tafs डेटा और
			खाते का मेटाडेटा
			<a href="/hi/privacy#retention">गोपनीयता नीति</a> के प्रतिधारण नियमों के अनुसार हटाते हैं।
		</p>
		<p>
			जो खंड अपनी प्रकृति से समाप्ति के बाद भी लागू रहने चाहिए
			वे लागू रहते हैं — जिनमें गोपनीयता, बौद्धिक
			संपदा, क्षतिपूर्ति, दायित्व की सीमा,
			अस्वीकरण, लागू कानून और अर्जित शुल्क शामिल हैं।
		</p>
	</section>
}

templ termsWarrantiesHI() {
	<section id="warranties">
		<h2>10. वारंटी</h2>
		<p>
			हर पक्ष घोषित करता है कि उसे इन शर्तों में प्रवेश करने और उन्हें निभाने का अधिकार और
			प्राधिकार है।
		</p>
		<p>
			हम वारंटी देते हैं कि हम सेवा पेशेवर ढंग से और दस्तावेज़ीकरण के
			सारभूत अनुरूप उपलब्ध कराएँगे। इस वारंटी के उल्लंघन पर आपका एकमात्र
			उपाय, हमारे विकल्प पर, पुनः निष्पादन या
			उल्लंघन की अवधि के लिए प्रभावित सेवा से संबंधित शुल्क का आनुपातिक
			रिफंड है।
		</p>
		<p>
			आप वारंटी देते हैं कि सेवा का आपका उपयोग लागू कानून और इन शर्तों के
			अनुरूप है।
		</p>
	</section>
}

templ termsDisclaimerHI() {
	<section id="disclaimer">
		<h2>11. अस्वीकरण</h2>
		<p>
			§10 की स्पष्ट वारंटियों को छोड़कर, सेवा
			<strong>"जैसी है" और "जैसी उपलब्ध है"</strong> दी जाती है। कानून की अनुमति की
			अधिकतम सीमा तक, हम अन्य सभी वारंटियों का, चाहे स्पष्ट, निहित या वैधानिक हों,
			जिनमें व्यापारिक योग्यता, किसी विशेष उद्देश्य के लिए उपयुक्तता, गैर-उल्लंघन और व्यवहार या व्यापार की प्रथा से
			उत्पन्न कोई भी वारंटी शामिल है, अस्वीकार करते हैं।
		</p>
		<p>
			हम वारंटी नहीं देते कि सेवा निर्बाध, त्रुटि-रहित या हानिकारक घटकों से मुक्त होगी, या कि कोई
			डेटा खोएगा या बिगड़ेगा नहीं। अपने डेटा का बैकअप
			रखने की ज़िम्मेदारी आपकी है।
		</p>
	</section>
}

templ termsLiabilityHI() {
	<section id="liability">
		<h2>12. दायित्व की सीमा</h2>
		<p>
			कानून की अनुमति की अधिकतम सीमा तक, कोई भी पक्ष
			दूसरे के प्रति इन शर्तों या सेवा से उत्पन्न या उनसे संबंधित किसी अप्रत्यक्ष, आकस्मिक,
			परिणामी, विशेष, अनुकरणीय या दंडात्मक नुकसान के लिए,
			जिनमें खोया लाभ, खोया राजस्व, खोया डेटा या
			व्यवसाय में बाधा शामिल हैं, उत्तरदायी नहीं होगा, भले ही ऐसे नुकसान की
			संभावना की सूचना दी गई हो।
		</p>
		<p>
			हर पक्ष का इन शर्तों से उत्पन्न या उनसे संबंधित कुल
			दायित्व (a) दायित्व को जन्म देने वाली घटना से पहले के बारह महीनों में ग्राहक द्वारा
			Kiff Agents OÜ को चुकाए या देय शुल्क, या (b) एक लाख
			यूरो (€100,000) में से जो अधिक हो, उससे अधिक नहीं होगा।
		</p>
		<p>
			इन शर्तों में कुछ भी उस दायित्व को सीमित या बाहर नहीं करता जिसे लागू कानून के तहत
			सीमित या बाहर नहीं किया जा सकता,
			जिसमें मृत्यु, लापरवाही से हुई व्यक्तिगत चोट,
			धोखाधड़ी या जानबूझकर किए आचरण का दायित्व, और दोषपूर्ण उत्पादों के दायित्व पर निर्देश
			(EU) 2024/2853 को लागू करने वाले कानूनों के तहत दोषपूर्ण उत्पाद का दायित्व शामिल है।
		</p>
	</section>
}

templ termsIndemnityHI() {
	<section id="indemnification">
		<h2>13. क्षतिपूर्ति</h2>
		<p>
			हम आपका बचाव उन तीसरे पक्ष के दावों के विरुद्ध करेंगे कि सेवा, जैसा हम उपलब्ध कराते हैं और आप इन शर्तों के अनुसार उपयोग करते हैं, उस तीसरे पक्ष के
			बौद्धिक संपदा अधिकारों का उल्लंघन करती है, और ऐसे दावों के लिए आपके विरुद्ध अंततः दिया गया हर्जाना (या सहमत
			समझौता राशि) हम चुकाएँगे।
		</p>
		<p>
			आप हमारा बचाव उन तीसरे पक्ष के दावों के विरुद्ध करेंगे जो (a) आपके ग्राहक डेटा या सामग्री; (b) इन शर्तों (AUP सहित)
			का उल्लंघन करके आपके सेवा के उपयोग;
			या (c) आपकी घोर लापरवाही या जानबूझकर किए आचरण से उत्पन्न हों, और
			ऐसे दावों के लिए हमारे विरुद्ध अंततः दिया गया हर्जाना (या सहमत
			समझौता राशि) आप चुकाएँगे।
		</p>
		<p>
			क्षतिपूर्ति दावे की त्वरित सूचना, बचाव और समझौते पर
			क्षतिपूर्ति देने वाले के एकमात्र नियंत्रण, और क्षतिपूर्ति पाने वाले के
			उचित सहयोग की शर्त पर है। क्षतिपूर्ति देने वाला ऐसा दावा बिना सहमति के नहीं निपटा सकता जो
			क्षतिपूर्ति पाने वाले पर दायित्व डालता हो।
		</p>
	</section>
}

templ termsSLAHI() {
	<section id="sla">
		<h2>14. सेवा-स्तर की प्रतिबद्धता</h2>
		<p>
			सशुल्क योजना पर, <a href="/legal/sla">सेवा-स्तर
			अनुबंध</a> (अंग्रेज़ी में) उस उपलब्धता को तय करता है जिसकी हम प्रतिबद्धता देते हैं, धीमा
			या विफल अनुरोध कैसे गिना जाता है, हमारे सपोर्ट जवाब के समय,
			और कमी रहने पर सेवा क्रेडिट। वह इन शर्तों का हिस्सा है।
		</p>
		<p>
			परिचालन पद्धतियाँ, घटना प्रतिक्रिया और उल्लंघन
			सूचना की प्रतिबद्धताएँ इन शर्तों से जुड़े दिनांकित
			संस्करण में दर्ज हैं
			(<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>);
			<a href="/security">/security</a> (अंग्रेज़ी में) मौजूदा
			पद्धतियाँ दिखाता है।
		</p>
	</section>
}

templ termsServiceModsHI() {
	<section id="service-mods">
		<h2>15. सेवा में बदलाव</h2>
		<p>
			हम किसी भी समय सुविधाएँ जोड़, बदल या हटा सकते हैं।
			कार्यक्षमता में सारभूत कमी या ऐसी API सतह का बंद किया जाना जो दर्ज किए व्यवहार को तोड़े,
			सक्रिय ग्राहकों को प्रकाशित बंदी कार्यक्रम के साथ कम से कम तीस दिन पहले
			सूचित किया जाता है। सुरक्षा-प्रेरित बदलाव बिना सूचना के किए जा सकते हैं जहाँ
			सूचना खुद जोखिम पैदा करे।
		</p>
	</section>
}

templ termsTermsModsHI() {
	<section id="terms-mods">
		<h2>16. इन शर्तों में बदलाव</h2>
		<p>
			हम समय-समय पर इन शर्तों में संशोधन कर सकते हैं। सारभूत
			बदलावों की सूचना ईमेल और इस पृष्ठ पर एक प्रमुख बैनर से कम से कम तीस दिन पहले दी जाती है। गैर-सारभूत
			बदलाव (स्पष्टीकरण, संदर्भ) नई
			"अंतिम अपडेट" तिथि के साथ पोस्ट किए जाते हैं। अपडेट की प्रभावी तिथि के बाद सेवा का
			आपका लगातार उपयोग स्वीकृति माना जाएगा।
		</p>
	</section>
}

templ termsForceMajeureHI() {
	<section id="force-majeure">
		<h2>17. अप्रत्याशित घटना</h2>
		<p>
			कोई भी पक्ष अपने उचित नियंत्रण से बाहर की परिस्थितियों के कारण, जिनमें दैवीय घटनाएँ, युद्ध,
			आतंकवाद, नागरिक अशांति, श्रम विवाद, आग,
			प्राकृतिक आपदा, महामारी से जुड़ी सरकारी कार्रवाई,
			इंटरनेट या बिजली की रुकावट, या दूरसंचार
			प्रदाताओं या तीसरे पक्ष के होस्टिंग बुनियादी ढाँचे की कार्रवाइयाँ शामिल हैं, निष्पादन में
			किसी भी विफलता या देरी के लिए उस हद तक उत्तरदायी नहीं है।
		</p>
	</section>
}

templ termsGoverningLawHI() {
	<section id="governing-law">
		<h2>18. लागू कानून और स्थान</h2>
		<p>
			ये शर्तें एस्टोनिया गणराज्य के कानूनों से, उसके विधि-संघर्ष नियमों पर
			ध्यान दिए बिना, शासित हैं।
			विवादों का विशेष मंच तालिन की Harju County Court है।
		</p>
		<p>
			जहाँ आप किसी अन्य EU सदस्य राज्य में रहने वाले उपभोक्ता हैं, आपके गृह क्षेत्राधिकार के अनिवार्य उपभोक्ता-संरक्षण
			नियम उस हद तक लागू रहते हैं जहाँ वे आपको ऐसे अधिकार देते हैं जिन्हें आप अनुबंध से त्याग नहीं सकते; यह खंड
			आपको उन नियमों के संरक्षण से वंचित नहीं करता।
		</p>
	</section>
}

templ termsGeneralHI() {
	<section id="general">
		<h2>19. सामान्य</h2>
		<p>
			<strong>पूर्ण अनुबंध।</strong> ये शर्तें, गोपनीयता नीति, DPA, किसी भी ऑर्डर फ़ॉर्म और
			स्पष्ट रूप से शामिल किसी भी अनुपूरक शर्त के साथ,
			अपने विषय पर हमारे बीच पूर्ण अनुबंध हैं और
			किसी भी पूर्व या समकालीन समझ का स्थान लेती हैं।
		</p>
		<p>
			<strong>पृथक्करणीयता।</strong> यदि कोई प्रावधान
			अप्रवर्तनीय पाया जाए, तो शेष लागू रहते हैं।
		</p>
		<p>
			<strong>समनुदेशन।</strong> आप हमारी लिखित सहमति के बिना इन शर्तों को
			समनुदेशित नहीं कर सकते। हम विलय, अधिग्रहण या
			अपनी सारी या लगभग सारी संपत्ति की बिक्री के संबंध में, आपको सूचना देकर, बिना सहमति के
			समनुदेशित कर सकते हैं।
		</p>
		<p>
			<strong>कोई त्याग नहीं।</strong> किसी प्रावधान को लागू न करना
			उसे बाद में लागू करने के अधिकार का त्याग नहीं है।
		</p>
		<p>
			<strong>सूचनाएँ।</strong> Kiff Agents OÜ को सूचनाएँ
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a> पर
			या डाक से Tööstuse tn 75-71, Põhja-Tallinna
			linnaosa, Tallinn 10416, एस्टोनिया को जाती हैं। आपको सूचनाएँ आपके खाते से जुड़े
			ईमेल पर या, यदि आपने दिया हो, तो आपके नामित कानूनी-सूचना पते पर जाती हैं।
		</p>
		<p>
			<strong>स्वतंत्र ठेकेदार।</strong> इन शर्तों में कुछ भी
			साझेदारी, एजेंसी, संयुक्त उद्यम
			या रोज़गार संबंध नहीं बनाता।
		</p>
		<p>
			<strong>तीसरे पक्ष के लाभार्थी।</strong> कोई नहीं,
			सिवाय उस हद तक जहाँ क्षतिपूर्ति पाने वाले सहयोगी
			स्पष्ट रूप से पहचाने गए हों।
		</p>
	</section>
}

