package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// PrivacyDV is KIFF's privacy policy (/privacy) in Dhivehi, at /dv/privacy.
// It is a translation of Privacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Dhivehi has the legal
// texts only, so a link to any other page goes to English and says so.
templ PrivacyDV() {
	@components.LayoutSite("KIFF — privacy policy", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@privacyHeadDV()
			@privacyWhoWeAreDV()
			@privacyScopeDV()
			@privacyRolesDV()
			@privacyCategoriesDV()
			@privacyLawfulBasesDV()
			@privacySubprocessorsDV()
			@privacyTransfersDV()
			@privacyRetentionDV()
			@privacyRightsDV()
			@privacyCookiesDV()
			@privacySecurityDV()
			@privacyChildrenDV()
			@privacyAutomatedDV()
			@privacyChangesDV()
			@privacyContactDV()
		</article>
	}
}

templ privacyHeadDV() {
	<header class="legal-head">
		<p class="legal-badge">ޕްރައިވަސީ ސިޔާސަތު · v0.1</p>
		<h1>ޕްރައިވަސީ ސިޔާސަތު</h1>
		<p class="legal-meta">
			<strong>ފަހުން އަޚާރު ކުރެވުނީ:</strong> 24 ނޮވެމްބަރު 2026. <strong>ހިނގަން ފެށޭ ތާރީޚް:</strong> 24 މެއި 2026.
		</p>
		<p class="legal-disclaimer">
			މި ސިޔާސަތުން ބަޔާންކުރަނީ KIFF Cloud އިން ވެބްސައިޓާއި ޑޭޝްބޯޑާއި API އާއި iPhone، iPad، Android އާއި ކޮމްޕިޔުޓަރުތަކަށް tafs އެޕް ހުރިހާ ތަނެއްގައި ޕަރސަނަލް ޑޭޓާ ހަންދާނާ ގޮތެވެ. ސުވާލު: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</header>
}

templ privacyWhoWeAreDV() {
	<section id="who-we-are">
		<h2>1. އަޅުގަނޑުމެން ކާކުބާ</h2>
		<p>
			KIFF Cloud ހިންގަނީ އެސްޓޯނިޔާގައި ރަޖިސްޓަރީ ކޮށްފައިވާ ޕްރައިވެޓް ލިމިޓެޑް ކުންފުންޏެއް <strong>Kiff Agents OÜ</strong> އިންނެވެ. ރަޖިސްޓްރީ މައުލޫމާތު:
		</p>
		<ul>
			<li><strong>ރަޖިސްޓްރީ ކޯޑު:</strong> 17372313 (އެސްޓޯނިޔާގެ އީ-ބިޒްނަސް ރަޖިސްޓަރު)</li>
			<li><strong>VAT ނަންބަރު:</strong> EE102924327</li>
			<li><strong>ރަޖިސްޓަރީ ކުރެވިފައިވާ އެޑްރެސް:</strong> Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, އެސްޓޯނިޔާ</li>
			<li><strong>ޕްރައިވަސީގެ ގުޅުން:</strong> <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a></li>
			<li><strong>ރަސްމީ ޤާނޫނީ ނޯޓިސްތައް:</strong> <a href="mailto:legal@kiff.dev">legal@kiff.dev</a></li>
		</ul>
		<p>
			Kiff Agents OÜ ޔޫރަޕިއަން ޔޫނިއަންގައި ޤާއިމުކޮށްފައިވާތީ، EU ގެ ޖެނެރަލް ޑޭޓާ ޕްރޮޓެކްޝަން ރެގިއުލޭޝަން (<abbr title="General Data Protection Regulation">GDPR</abbr>) އަޅުގަނޑުމެންގެ ޕްރޮސެސިންގއަށް ޠަބީޢީ ގޮތުން ހިނގައެވެ. އަޅުގަނޑުމެންނަށް 27 ވަނަ މާއްދާގެ ދަށުން EU ގެ ބަދަލުވެރިއެއް ނުބޭނުންވެއެވެ.
		</p>
	</section>
}

templ privacyScopeDV() {
	<section id="scope">
		<h2>2. މި ސިޔާސަތުގެ ސަރަހައްދު</h2>
		<p>
			ތިބާ ތިރީގައިވާ ކަންތައްތަކާ ގުޅޭއިރު އަޅުގަނޑުމެން ޕްރޮސެސް ކުރާ ޕަރސަނަލް ޑޭޓާ މި ސިޔާސަތުން ހިމެނެއެވެ:
		</p>
		<ul>
			<li><a href="https://kiff.dev"><code>kiff.dev</code></a> — އަޅުގަނޑުމެންގެ މާކެޓިންގ ސައިޓް، މި ސިޔާސަތުގެ ސަފްހާ، އަދި ރަސީދުތައް ދައްކާ ޢާންމު ސަރފޭސް.</li>
			<li><a href="https://app.kiff.dev"><code>app.kiff.dev</code></a> — ލޮގިން ބޭނުންވާ އަޅުގަނޑުމެންގެ ޑޭޝްބޯޑް.</li>
			<li><a href="https://api.kiff.dev"><code>api.kiff.dev</code></a> — އަޅުގަނޑުމެންގެ HTTP API.</li>
			<li id="tafs"><strong>tafs</strong> — iPhone، iPad، Android އާއި ކޮމްޕިޔުޓަރުތަކަށް (Mac، Windows އާއި Linux) އަޅުގަނޑުމެންގެ އެޕް، އަދި އޭގެ ފަހަތުގައިވާ ޚިދުމަތް (ކުންފުންޏެއްގެ ޓޫލްތައް ގުޅުއްވާ Setup އާއި އެ ގުޅުންތައް ބަހައްޓާ planque ހިމެނިގެން)، އެތަނުގައި ކުންފުންޏެއް KIFF Card ތަކުގެ ތެރޭގައި ޢަމަލުކުރާ AI އޭޖެންޓެއްގެ އަތަށް ކަމެއް ހަވާލުކުރެއެވެ.</li>
		</ul>
		<p>
			މި ސިޔާސަތުން ތިބާއަށް އަމިއްލައަށް ހިންގޭ އޯޕަން-ސޯސް <code>kiff/kiff</code> ފްރޭމްވޯކް <em>ނުހިމެނެއެވެ</em>. ތިބާ ފްރޭމްވޯކް ތިބާގެ އަމިއްލަ އިންފްރާސްޓްރަކްޗަރުގައި ހިންގާއިރު، އެ ޕްރޮސެސް ކުރާ ކޮންމެ ޑޭޓާއެއްގެ ކޮންޓްރޯލަރަކީ ތިބާއެވެ، އަދި އެ ޕްރޮސެސިންގއާ Kiff Agents OÜ ގުޅިފައެއް ނުވެއެވެ.
		</p>
	</section>
}

templ privacyRolesDV() {
	<section id="roles">
		<h2>3. GDPR ގެ ދަށުން އަޅުގަނޑުމެންގެ ދައުރު</h2>
		<p>
			ޑޭޓާއަށް ބަރޯސާވެ އަޅުގަނޑުމެން ދެ ސިފައެއްގައި ޢަމަލުކުރަމެވެ:
		</p>
		<ul>
			<li>
				<strong>ކޮންޓްރޯލަރ</strong> އެކައުންޓާއި ލޮގިން މެޓާޑޭޓާއަށް، ބިލިންގ ޑޭޓާއަށް (ބިލިންގ ހަރަކާތްތެރިވުމުން)، ތިބާ ހޮވާ މާކެޓިންގ ގުޅުންތަކަށް، އަދި އަޅުގަނޑުމެންގެ އަމިއްލަ ޚިދުމަތުގެ އޮޕަރޭޝަނަލް ޓެލެމެޓްރީއަށް.
			</li>
			<li>
				<strong>ޕްރޮސެސަރ</strong> އަޅުގަނޑުމެންގެ ކަސްޓަމަރުންގެ ނަމުގައި ރަންޓައިމް މެދުވެރިކޮށް ދާ އޮޑިޓް ޑޭޓާއަށް، ޢަމަލުގެ ރެކޯޑްތަކާއި ނިންމުމުގެ ރަސީދުތަކާއި އެހެނިހެން ކޮންޓެންޓްތަކަށް، އަދި tafs އިން އެމީހުންނަށްޓަކައި ބަހައްޓާ ކަންތައްތަކަށް (ކޮންމެ taf އެއްގެ ރަނާތަކާއި ބަހުސްތަކާއި ރިޕޯޓްތަކާއި މެމޯރީ ނޯޓުތަކާއި އެ ހަވާލުކުރާ ފައިލްތައް). ކަސްޓަމަރުން (tenant ތައް) އެ ޑޭޓާގެ ކޮންޓްރޯލަރުންނެވެ؛ އެމީހުން އަޅުގަނޑުމެންނަށް އިރުޝާދު ދެނީ އެމީހުންގެ އެކައުންޓް ސެޓިންގސް އާއި ޑޮމެއިން ކޮންފިގްގައެވެ. ޑޭޓާ ޕްރޮސެސިންގ އެއްބަސްވުން (<abbr title="Data Processing Agreement">DPA</abbr>) އިން އެ ގުޅުން ކޮންޓްރޯލް ކުރެއެވެ؛ ޝާއިޢުކުރެވިފައިވާ ޝަރުތުތަކަށް <a href="/legal/dpa">DPA ޓެމްޕްލޭޓް</a> (އިނގިރޭސިން) ބަލާށެވެ.
			</li>
		</ul>
		<p>
			މި ސިޔާސަތުން އެންމެ ބޮޑަށް ބަލާނީ އަޅުގަނޑުމެންގެ ކޮންޓްރޯލަރ ފަރާތުގެ ޕްރޮސެސިންގއެވެ. އަޅުގަނޑުމެން ޕްރޮސެސަރ ފަރާތުގެ ޑޭޓާ ދެއްކޭ ތަނެއްގައި، DPA އަކީ ބޮޑަށް ވަކިން ބަޔާންކޮށްފައިވާ ޑޮކިއުމެންޓެވެ.
		</p>
	</section>
}

templ privacyCategoriesDV() {
	<section id="categories">
		<h2>4. އަޅުގަނޑުމެން ޕްރޮސެސް ކުރާ ޕަރސަނަލް ޑޭޓާގެ ބާވަތްތައް</h2>
		<p>
			ތިރީގައިވާ ބާވަތްތައް <a href="/security#data-we-process">/security#data-we-process</a> (އިނގިރޭސިން) ގައިވާ ޓެކްނިކަލް އިންވެންޓްރީއާ ގުޅޭ ގޮތުގައި ހުއްޓެވެ. ދެކަމުގައި ތަފާތު ތަނެއްގައި، ޓެކްނިކަލް ސަފްހާއަކީ ޙަޤީޤަތުގެ މަސްދަރެވެ، އަދި އަޅުގަނޑުމެން މި ބައި އެ ގޮތަށް އަޚާރު ކުރަމެވެ.
		</p>
		<ul>
			<li>
				<strong>އެކައުންޓް މަޢުލޫމާތު</strong> — ތިބާގެ އަޕްސްޓްރީމް އޮތެންޓިކޭޝަން ސަބްޖެކްޓް (އަޅުގަނޑުމެންގެ އައިޑެންޓިޓީ ފޯރުކޮށްދޭ ފަރާތުން ދޫކުރެވިފައިވާ) އަދި ތިބާ ވަންނަ އީމެއިލް އެޑްރެސް. މިހާރު ބަހައްޓަނީ ހުރިހާ ގޮތަކުން ދެކޭ ގޮތަށް؛ ބަހައްޓާއިރު ހެޝް ކުރުން ރޭވިފައިވެއެވެ.
				ތިޔަބައިމީހާ އީމެއިލްގައި ފޮނުވާ ކޯޑަކުން ސައިން-އިން ވުން އޮންކޮށްފިނަމަ (ތިޔަބައިމީހާ އޮން ނުކުރައްވައިފިނަމަ އެއީ އޮފްކޮށްފައިވާ ކަމެއް)، KIFF އިން އެ ސެޓިންގ ތިޔަބައިމީހާގެ ސައިން-އިން އައިޑީއާއި ބަދަލުކުރެއްވި ތާރީޚާއެކު ބަހައްޓައެވެ. އަޅުގަނޑުމެން ތިޔަބައިމީހާއަށް އީމެއިލްކުރާ ކޯޑެއް ބަހައްޓާނީ ބޭނުންކުރެވެންދެން ނުވަތަ ދިހަ މިނެޓް ހޭދަވެއްޖައުމަށް ހަމައެކަނި ކީ ހުރި ހޭޝެއްގެ ގޮތުގައެވެ. ގޯސް ބޭނުންކުރުން ހައްދުކުރުމަށް، އެދުނު އެޑްރެހާއި IP އެޑްރެހުގެ ކީ ހުރި ހޭޝަކަށް ރިކުއެސްޓްގެ އަދަދެއް އެންމެ ގިނައިން އެއް ދުވަސް ހަމައަށް އަޅުގަނޑުމެން ބަހައްޓަމެވެ. ކޯޑަކުން ސައިން-އިން ވުމަށްފަހު، ގާތް ސައިން-އިންއެއް ބޭނުންވާ ބަދަލުތަކުން ތިޔަބައިމީހާ އެހެން ގޮތަކަށް ސައިން-އިން ވުމަށް އެދުމަށްޓަކައި، އެކަން ފަނަރަ މިނެޓް ނޯޓްކޮށްލަމެވެ.
			</li>
			<li>
				<strong>Tenant މެޓާޑޭޓާ</strong> — tenant id، slug، ދައްކާ ނަން، ހެދި ވަގުތު، އަދި ކޮންމެ މީހެއްގެ އެޕް ފަހުން ބޭނުންކުރި ބަސް، ފަހެ KIFF އިން އެމީހުންނަށް ފޮނުވާ އީމެއިލްތައް އެ ބަހުން އަންނާނެއެވެ.
			</li>
			<li>
				<strong>API ކްރެޑެންޝަލްތައް</strong> — ފެންނަން ނެތް API ކީ ރެކޯޑްތައް (އަޅުގަނޑުމެން ބަހައްޓަނީ ހެޝްތަކެވެ، ދުވަހަކުވެސް ޕްލޭން ޓެކްސްޓެއް ނޫނެވެ).
			</li>
			<li>
				<strong>ސެޝަން ކުކީ ޑޭޓާ</strong> — ލޮގިންވުމަށް ފަހު ސެޓްކުރާ HMAC-ސޮއިކުރެވިފައިވާ ސެޝަން ކުކީއެއް. ތިރީގައިވާ ކުކީގެ ބައި ބަލާށެވެ.
			</li>
			<li>
				<strong>HTTP ރިކުއެސްޓް މެޓާޑޭޓާ</strong> — IP އެޑްރެސް، user agent، ރިކުއެސްޓް ޕާތް، ރިސްޕޮންސް ސްޓޭޓަސް، ލަސްވުން. ރައްކާތެރިކަމާއި އެކަށީގެންނުވާ ބޭނުންކުރުން ހުއްޓުވުމަށްޓަކައި ޙައްދުކުރެވިފައިވާ ބަހައްޓާ މުއްދަތަކަށް އަޅުގަނޑުމެންގެ reverse proxy ގެ އެކްސެސް ލޮގްތަކުގައި ބަހައްޓައެވެ.
			</li>
			<li>
				<strong>Tenant ކޮންޓްރޯލް ކުރާ ކޮންޓެންޓް</strong> — ތިބާ ރަންޓައިމަށް ފޮނުވާ <code>parameters</code>، <code>actor</code> އަދި <code>entity</code> ޑޭޓާ. އަޅުގަނޑުމެން މި ބަހައްޓަނީ ކަސްޓަމަރުގެ ނަމުގައި <em>ޕްރޮސެސަރެއްގެ ގޮތުގައި</em>؛ ވަޔަރަށް ދާ ކަންތައްތަކަށް ކަސްޓަމަރު ޒިންމާވެއެވެ. ޑޮމެއިނަކަށް ރެޑެކްޝަން ކޮންފިގް ރޭވިފައިވެއެވެ.
			</li>
			<li>
				<strong>ގުޅުންތައް</strong> — ތިބާ އަޅުގަނޑުމެންގެ ސަޕޯޓް، ސޭލްސް، ރައްކާތެރިކަން ނުވަތަ ޕްރައިވަސީ މެއިލްބޮކްސްތަކަށް ފޮނުވާ އީމެއިލްތައް.
			</li>
			<li>
				<strong>tafs އެޕް</strong> — ތިބާ tafs އަށް ވަންނަނީ ތިބާގެ KIFF އެކައުންޓުންނެވެ. ފޯނެއް ނުވަތަ ޓެބްލެޓެއްގައި އެޕް ތިބާގެ ސެޝަން ޑިވައިސްގެ Keychain ގައި (Android ގައި، އޭގެ އެންކްރިޕްޓް ކޮށްފައިވާ ސްޓޯރޭޖްގައި) ބަހައްޓައެވެ. ކޮމްޕިޔުޓަރެއްގައި އެ ބަހައްޓަނީ ތިބާގެ ޔޫޒަރ އެކައުންޓަށްޓަކައި ސީލްކޮށްގެންނެވެ: Windows ކޮމްޕިޔުޓަރެއްގައި Windows ގެ އަމިއްލަ ޑޭޓާ ރައްކާތެރިކަމުން، Linux ގައި ތިބާގެ keyring ގައި، Mac އެއްގައި އޭގެ Keychain ގައެވެ. ކޮމްޕިޔުޓަރެއްގެ ސެޝަން 90 ދުވަހާ ހަމައަށް ދެމިއޮވެއެވެ. އެޕް ޑިވައިސްއިން ދުވަހަކުވެސް ނުނިކުންނަ ސޮއިކުރާ ކީ އެއް ހަދައެވެ: iPhone، iPad ނުވަތަ Mac އެއްގެ Secure Enclave ގައި، Android ޑިވައިސްގެ Keystore ގައި، ނުވަތަ Windows ކޮމްޕިޔުޓަރެއްގެ TPM ގައެވެ. Linux ގައި، އަދި Secure Enclave ނެތް Mac އެއްގައި، ކީ އަކީ ތިބާގެ keyring ނުވަތަ Keychain ގައި ބަހައްޓާ ސޮފްޓްވެއަރ ކީ އެއް ކަމަށް ވާއިރު، އެ ކޮމްޕިޔުޓަރުން ތިބާއަށް ތިބި ކަންތައްތައް ދައްކާލެވޭނެ އެކަމަކު ރުހުން ދެވޭކަށް ނުވެއެވެ؛ ތިބާ ރުހުން ދެނީ ތިބާގެ ފޯނުގައެވެ{ macSecurityKey("dv") }. TPM ނެތް Windows ކޮމްޕިޔުޓަރަކުން tafs އަށް ވަދެވޭކަށް ނެތެވެ. KIFF ކީގެ ޕަބްލިކް ބައި، ޑިވައިސްގެ ނަމާއި ޕްލެޓްފޯމް، އަދި އެ އިތުރުކުރި އަދި ފަހުން ބޭނުންކުރި ވަގުތު ބަހައްޓައެވެ، އެއީ ހިފެހެއްޓިފައިވާ ކޯލްތަކަށް ތިބާގެ ޖަވާބުތަކާއި ގުޅުންތަކަށް ތިބާގެ ރުހުންތައް ޗެކް ކުރެވޭނެ ގޮތަށެވެ. ތިބާ ތިބާގެ ކޮމްޕިޔުޓަރުގައި Windows Hello ނުވަތަ ރައްކާތެރިކަމުގެ ކީއެއް ފަދަ passkey އަކުން ރުހުން ދެއްވާއިރު، ތިބާގެ މޫނާއި އަދި އިނގިލީގެ ދަލީލާއި PIN ކޮމްޕިޔުޓަރުގެ އަމިއްލަ ސިސްޓަމާއެކު ދެމިއޮވެއެވެ. KIFF passkey ގެ ޕަބްލިކް ކީ، އޭގެ id، ކައުންޓަރެއް އަދި ނަމެއް ބަހައްޓައެވެ، ދުވަހަކުވެސް ސިއްރު އެއްޗެއް ނޫނެވެ، އަދި އެހެން ޑިވައިސްތަކާ ސިންކް ވާ passkey އެއް ބާތިލް ކުރެއެވެ. ފޯނެއް، ޓެބްލެޓެއް ނުވަތަ iPad އެޕް ހިންގާ Mac އެއްގައި، ތިބާ އެ ހުޅުވާލުމުން، އަޅުގަނޑުމެން ޑިވައިސްގެ push token ތިބާގެ KIFF ޕާސަން id އާއި އެޕް ދެއްކި ބަހާއެކު ބަހައްޓަމެވެ. އެލާޓެއް Apple ނުވަތަ Google މެދުވެރިކޮށް ދަނީ ކޮން taf އެއްތޯއާއި އެ ބޭނުންވާ ކަމާއެކު ހަމައެކަނި، އަދި ދޮރުގެ އެލާޓެއްގައި ލިޔި މީހާގެ ނަމާއި ނުވަތަ އީމެއިލް އެޑްރެސް: ދުވަހަކުވެސް ޢަދަދެއް ނުވަތަ އެދުމުގެ ތަފްސީލެއް ނޫނެވެ. އެޕް އެ ކަންތައްތައް އިތުރުކުރަނީ ޑިވައިސްގައިމެވެ، KIFF އިންނެވެ، ފަހެ ޢަނބާރު ނުކުރެވިފައިވާ ފޯނެއްގެ އެލާޓެއްގައި ޢަދަދެއް، ވިޔަފާރިވެރިއެއް ނުވަތަ މީހެއް ދައްކައިދެވިދާނެއެވެ. ލޮކު ކުރެވިފައިވާ Android ފޯނެއްގައި އެ ދައްކަނީ "taf އަކަށް ތިބާ ބޭނުންވޭ" ހަމައެކަނި ކަމުގައި ވާއިރު، ލޮކު ކުރެވިފައިވާ iPhone އެއްގައިވެސް އެގޮތަށެވެ، ތިބާ އޭގެ ޕްރިވިއުތައް ހަމައިން ދައްކަން ސެޓްކޮށްފައި ނުވާނަމައެވެ. Windows ކޮމްޕިޔުޓަރެއްގައި، Linux ކޮމްޕިޔުޓަރެއްގައި ނުވަތަ macOS 12 އެޕް ހުރި Mac އެއްގައި، އެލާޓްތައް އުފައްދަނީ އެޕް ހިނގަމުންދާއިރު އެޕް އަމިއްލައަށް ކަމުގައި ވާއިރު، push token ނެތި އަދި އެހެން ކުންފުންޏެއް މެދުވެރި ނުކޮށެވެ. Windows އާއި Linux ގައި އެ ދައްކަނީ ކޮން taf އެއްތޯއާއި، އެ ކުރަން ބޭނުންވާ ކަމާއި، ޢަދަދާއި، ކީއްވެގެންނާއި، ކޮންހާ ވަގުތެއް ހަމައަށްތޯއެވެ؛ macOS 12 އެޕްގައި ތިބާ އެ ހުޅުވާލުމަށް ފަހު ކޯލުގެ ގޮތުން KIFF ގެ ބަސްތައް ދައްކައެވެ، އަދި ލޮކު ކުރެވިފައިވާ ސްކްރީންއެއް Mac ގެ ޕްރިވިއު ސެޓިންގ ހުއްދަ ދޭ ކަންތައްތައް ދައްކައެވެ. Windows ގައި އެ ތިބާ ހުޅުވާލަންދެން ބަންދުކޮށްގެންވެއެވެ، އަދި ސްކްރީން ލޮކުކޮށްފައި ހުރިއިރު ދައްކަނީ "taf އަކަށް ތިބާ ބޭނުންވޭ" ހަމައެކަނި ކަމުގައެވެ. ސްކްރީން ލޮކުވުމުގެ ކުރިން ދައްކާފައިވާ އެއްޗެއް އޭގެ ތަފްސީލް Windows ގެ ނޮޓިފިކޭޝަން ލިސްޓްގައި ބަހައްޓައެވެ. Linux ގައި އެ ތިބާ ބަންދުކުރަންދެން ހުޅުވިފައި އޮވެއެވެ، އަދި ލޮކު ކުރެވިފައިވާ ސްކްރީނެއް ދައްކާ ކަންތައްތައް ތިބާގެ ޑެސްކްޓޮޕް އަށް ބަރޯސާވެއެވެ. tafs ގެ ޚިދުމަތުން އެކައުންޓުގެ ބަސް، ފަހުން Coach އާއެކު ވާހަކަދެއްކި މީހާގެ ގާތުން، ތިން މަސްދުވަހާ ހަމައަށް ބަހައްޓައެވެ، ފަހެ taf އެއްގެ ރިޕޯޓްތައް އެ ބަހުން އަންނާނެއެވެ. <strong>ތިބާގެ ގަޑި:</strong> ގަޑިއަކުން ޕާސްވޯޑަކާ ނުވަތަ ކީއެއް ނުބަހައްޓައެވެ، ތިބާގެ ޕެއާރު ކޮށްފައިވާ ފޯނާ ހަމައެކަނި ވާހަކަދައްކައެވެ، އަދި ދުވަހަކުވެސް ރުހުން ނުދެއެވެ. ތިބާ AI އަށް ހުއްދަ ދިނުމަށް ފަހު، ތިބާ Coach އަށް، ނުވަތަ ތިބާ ހޮވި taf އަށް ބުނާ ވާހަކަ ފޮނުވަނީ ފޯނުމެދުވެރިކޮށް ހަމައެކަނި ޓެކްސްޓެއްގެ ގޮތުގައެވެ. ގަޑީގެ އަމިއްލަ ވާހަކަދެއްކުމުގެ ޚިދުމަތް، Apple ގެ ނުވަތަ Google ގެ، ތިބާގެ ބަސްތައް އެ ޓެކްސްޓަކަށް ބަދަލުކުރެއެވެ. Wear OS ގައި، ތިބާ ވާހަކަ ނިމުމުގެ ކުރިން އެ ހުއްޓިއްޖެނަމަ، ތިބާގެ ފޯނުގެ އަމިއްލަ ރެކޮގްނައިޒަރއިން ފޯނުގައި އެ ކުރެއެވެ. އެކަމަށް ބާރުއަޅުވަން ނުވަތަ ހުއްޓުވަން ނުވަތަ Coach ނުވަތަ taf އެއްގެ ނަމުގައި ފޮނުވަން ޖެހޭނީ ސްކްރީން ލޮކް ނުވަތަ ޕާސްކޯޑު ހުރި ބަލަ އަދި ޢަނބާރު ކުރެވިފައިވާ ހާލަތުގައި ހަމައެކަނި ކަމުގައެވެ. ތިބާ taf އަކަށް ފޮނުވާ ކަމެއް ދަނީ ތިބާ ފޯނުގައި ލިޔުނު ފަދައިން އެ taf ގެ އަމިއްލަ ބަހުސަށެވެ. taf އެއްގެ ބަހުސް، ޢަދަދުތަކާއެކު، ހުޅުވާ ކޮންމެ ފަހަރަކު ފޯނުން ކިޔައެވެ. ގަޑީގައި ބަހައްޓަނީ ތިރީގައިވާ އޭގެ ބައިގައި ބަޔާންކޮށްފައިވާ އެންމެ ފަހުގެ މެސެޖުތައް އެކަނިއެވެ. <strong>Apple Watch:</strong> އެ ތިބާގެ taf ތަކާއި އޭގެ ސަފްހާތައް ނުބަހައްޓައި ދައްކައެވެ. އެ ބަހައްޓަނީ ތިބާގެ Inbox، އެ ލޮކުކޮށްފައި ހުރިއިރު ކިޔަން ނުކުޅެދޭ ފައިލެއްގައެވެ: ހިފެހެއްޓިފައިވާ ކޮންމެ ކޯލެއް އޭގެ taf ގެ ނަމާއި އެ އެދޭ ކަމެއްގެ ގޮތުގައި، ދުވަހަކުވެސް ޢަދަދެއް ނޫނެވެ، އަދި ތިބާ ގަޑިން ފޮނުއްވި ކަންތައްތަކަށް Coach ގެ ޖަވާބުތައް، ޓެކްސްޓެއްގެ ގޮތުގައެވެ. ތިބާ ގަޑިއިން ނިކުތްނަމަ، ތިބާ ގަޑިއަށް އަލުން ވަންނަންދެން ތިބާ އެ ކުރި ކަން އެ ބަހައްޓައެވެ. އެ ނޫން ގޮތުން، ގަޑިއަށް ޕާސްކޯޑެއް ނެތްނަމަ އެއްވެސް ކަމެއް ނުބަހައްޓައެވެ. ތިބާ ގަޑިއިން ނިކުތް ވަގުތު ނުވަތަ ތިބާގެ iPhone ނިކުތް ވަގުތު، ނުވަތަ ޕާސްކޯޑެއް ނެތި އެޕް ދެން ހުޅުވާ ނުވަތަ ބަންދުކުރާ ވަގުތު Inbox ފޮހެވެއެވެ. އެ އެއްވެސް ރެކޯޑިންގއެއް ނުކުރެއެވެ، އަދި އެ ދައްކާ އެކަނި ނޮޓިފިކޭޝަންތަކަކީ ތިބާގެ iPhone ގެ ނޮޓިފިކޭޝަންތަކެވެ. ޗެޓެއް އަވަހަށް ހުޅުވޭތޯ، ގަޑީގައި ތިބާ ހުޅުވި 20 ޗެޓާ ހަމައަށް ކޮންމެ ޗެޓެއްގެ އެންމެ ފަހުގެ 30 މެސެޖު، Coach ގެ އާއި ތިބާގެ tafs ގެ، ލިޔުމެއްގެ ގޮތުގައި އެކަނި، އަދި ދުވަހަކުވެސް ޢަދަދެއް ނޫން ގޮތަށް، Inbox ފަދައިން ލޮކްކޮށް ބަހައްޓައެވެ. Inbox ފޮހެވޭއިރު އަދި ޗެޓެއް 30 ދުވަހު ނުހުޅުވާނަމަ އެ ފޮހެވެއެވެ. <strong>Wear OS:</strong> އެ ތިބާގެ އެކައުންޓުގެ އީމެއިލާއި މިއަދުގެ ކެލެންޑަރ ނުބަހައްޓައި ދައްކައެވެ. އެ ސީދާ ހުޅުވުމަށްޓަކައި، ތިބާއަށް ތިބި ކަންތައްތަކުގެ ޢަދަދާއި، ކޮންމެ taf އެއްގެ ނަމާއި އެ ހުއްޓިފައި ނުވަތަ ވަގުތީގޮތުން ހުއްޓިފައިވޭތޯ، އެންކްރިޕްޓް ކޮށް ބަހައްޓައެވެ: ދުވަހަކުވެސް ޢަދަދެއް، ހިފެހެއްޓިފައިވާ ކޯލެއްގެ ތަފްސީލް ނުވަތަ taf އެއްގެ ބަހުސެއް ނޫނެވެ. ތިބާ ނިކުންނަ ވަގުތު، ގަޑި ލޮކު ވާ ނުވަތަ އަތުގެ ކުރިއަށް ނެގޭ ވަގުތު، އަދި 24 ގަޑިއިރުގެ ފަހުން އެ ފޮހެވެއެވެ. އެ ތިބާގެ Inbox ބަހައްޓައެވެ، އެތަނުގައި ކޮންމެ ފޮތިގަނޑަކީ taf އެއްގެ ނަމާއި އެ ބުނާ ކަންތައްތަކެވެ، ދުވަހަކުވެސް ޢަދަދެއް ނޫނެވެ، އަދި ފަހުން ފޮނުވުމަށް ބަހައްޓާފައިވާ މެސެޖެއް، ޓެކްސްޓެއްގެ ގޮތުގައެވެ. ގަޑިން ނުވަތަ ފޯނުން ނިކުތުމުން އެ ހުރިހާ ކަމެއް ފޮހެވެއެވެ. އޭގެ ޓައިލަށްޓަކައި، އެ ތިބާއަށް ތިބި ކަންތައްތަކުގެ ޢަދަދު ބަހައްޓައެވެ، ގަޑި ޢަނބާރު ކުރެވިފައި ހުރިއިރު ހަމައެކަނި ދައްކާ، ތިބާ ނިކުންނަ ވަގުތު، ނުވަތަ ގަޑި ލޮކު ވެފައި ނުވަތަ ސްކްރީން ލޮކެއް ނެތް ވަގުތު ޓައިލް ދެން ދައްކާ ވަގުތު ފޮހެވެއެވެ. ތިބާ ގަޑިން ނިކުތުމަށް ފަހު، ތިބާ އަލުން ވަންނަންދެން ތިބާ އެ ކުރި ކަމުގެ ނޯޓެއް އެ ބަހައްޓައެވެ. ގަޑި ލޮކުވެފައި ނުވަތަ ސްކްރީން ލޮކެއް ނެތް ވަގުތު އެޕް ދެން ހުޅުވާ ނުވަތަ ބަންދުކުރާ ވަގުތުވެސް Inbox ފޮހެވެއެވެ. ފަހުން ފޮނުވުމަށް ބަހައްޓާފައިވާ މެސެޖެއް ތިބާ އެ ފޮނުއްވާ ނުވަތަ ފޮހެލާންދެން ދެމިއޮވެއެވެ، ސަބަބަކީ ތިބާ އެ ފޮނުވުމަށް އެދުނު ސަބަބުންނެވެ. ތިބާ ވާހަކަ ނިމުމުގެ ކުރިން ގަޑީގެ ވާހަކަދެއްކުމުގެ ޚިދުމަތް ހުއްޓިއްޖެނަމަ، ގަޑިއިން ރެކޯޑިންގ ތިބާގެ ފޯނަށް ފޮނުވައެވެ، އެ ފޯނުގައި ޓެކްސްޓަކަށް ބަދަލުކުރެއެވެ، ދުވަހަކުވެސް ސާވަރެއްގައި ނޫނެވެ. ޓެކްސްޓް އެނބުރި އައުމުން ނުވަތަ ތިބާ ކެންސަލް ކުރުމުން، އަދި އެންމެ ގިނައިން 2 މިނިޓުގެ ފަހުން، ރެކޯޑިންގ ދެތަނުން ފޮހެވެއެވެ. ޓެކްސްޓް ހަމައެކަނި Coach އަށް ނުވަތަ ތިބާގެ taf އަށް ކުރިއަށް ދެއެވެ. taf އެއްގެ ނަތީޖާއެއް ތިބާ ދޫކޮށްލާ ނުވަތަ ގަޑިން ނިކުންނަންދެން ގަޑީގެ ނޮޓިފިކޭޝަންތަކުގައި ދެމިއޮވެދާނެއެވެ. ޗެޓެއް އަވަހަށް ހުޅުވޭތޯ، ގަޑީގައި ތިބާ ހުޅުވި 20 ޗެޓާ ހަމައަށް ކޮންމެ ޗެޓެއްގެ އެންމެ ފަހުގެ 30 މެސެޖު، Coach ގެ އާއި ތިބާގެ tafs ގެ، ލިޔުމެއްގެ ގޮތުގައި އެކަނި، އަދި ދުވަހަކުވެސް ޢަދަދެއް ނޫން ގޮތަށް، Inbox ފަދައިން އެންކްރިޕްޓްކޮށް ބަހައްޓައެވެ. ގަޑީގައި ނުވަތަ ފޯނުގައި ސައިން އައުޓް ކުރާއިރު އަދި ޗެޓެއް 30 ދުވަހު ނުހުޅުވާނަމަ އެ ފޮހެވެއެވެ. ސްކްރީން ލޮކެއް ނެތް ގަޑީގައި އެއްވެސް ޗެޓެއް ނުބަހައްޓައެވެ. ތިބާ ޓޫލެއް ގުޅުއްވާއިރު، ތިބާ ވަންނަނީ ޓޫލުގެ އަމިއްލަ ފޯރުކޮށްދޭ ފަރާތުގައެވެ. Stripe ފަދަ planque އަމިއްލައަށް ވަންނަ އެޕެއްގެ ގޮތުން، ނުވަތަ ތިބާ ދޭ ކީއެއްގެ ގޮތުން، planque އެ token ނުވަތަ ކީ ތިބާގެ ކުންފުންޏަށްޓަކައި އެންކްރިޕްޓް ކޮށް ބަހައްޓައެވެ. މެނޭޖް ކުރެވޭ ގުޅުމެއްގެ ގޮތުން، planque އާއެކު މަސައްކަތްކުރާ ގުޅުމުގެ ޚިދުމަތް Composio ލޮގިން ބަހައްޓައެވެ، އަދި planque ބަހައްޓަނީ ގުޅުމުގެ ރެކޯޑާއި ތިބާ ރުހުން ދެއްވި ޓޫލްތައް ހަމައެކަނި (ހުރިހާ ކަމެއް ޕްރޮސެސަރެއްގެ ގޮތުގައި، ތިރީގައި ބަލާށެވެ). ތިޔަބައިމީހާ tafs އެކްސްޓެންޝަން ޕެއާ ކޮށްފިނަމަ، ޓާފަކަށް ތިޔަބައިމީހާގެ އަމިއްލަ Chrome ގައި ތިޔަބައިމީހާ ހުއްދަ ދޭ ސައިޓުތަކުގެ ޕޭޖުތައް ވެސް ކިޔައި އެތަންތަނުގައި ކަންކުރެވިދާނެއެވެ (ޕްރޮސެސަރެއްގެ ގޮތުގައި؛ ކޮބައިތޯ ކިޔާނީ، ކޮބައިތޯ ބެހެއްޓޭނީ، އަދި ކިހިހާ ދުވަހަކަށްތޯ <a href="/dv/tafs/privacy">tafs ގެ ޕްރައިވަސީ ޕޭޖު</a> ގައި ބުނެއެވެ). ގުޅުމެއްގެ ރެކޯޑްގައި އެ ވަދެފައިވާ އެކައުންޓް (އޭގެ ނަމާ ނުވަތަ އީމެއިލް) ހިމެނިދާނެއެވެ، ފަހެ އެޕަށް ތިބާއަށް ކޮންދެއްތޯ ދައްކާލެވޭނެއެވެ. KIFF މެނޭޖް ކުރެވޭ ގުޅުންތައް ބޭނުންކުރަނީ <a href="/subprocessors#composio">/subprocessors</a> (އިނގިރޭސިން) ގައި ނަންދީފައިވާ އެޕްތަކަށް ހަމައެކަނި ކަމުގައެވެ. އެޕްގައި އެނަލިޓިކްސް ނުވަތަ އިޝްތިހާރު ޓްރެކަރުތައް ނެތެވެ.
			</li>
			<li>
				<strong>App Store ގަނެވުންތައް</strong> — ތިބާ tafs ގައި Solo ނުވަތަ ކްރެޑިޓް ޕެކެޖެއް ގަންނަ ހިނދު، Apple އިން އެ ތިބާއަށް ވިއްކައެވެ: Apple އަކީ ރެކޯޑު ކުރެވިފައިވާ ވިއްކާ ފަރާތް ކަމަށް ވާއިރު، ފައިސާ ނަގައި ތިބާގެ ފައިސާ ދެއްކުމުގެ ތަފްސީލް ބަހައްޓައެވެ. Apple އިން އަޅުގަނޑުމެންނަށް ކިޔައިދެނީ ގަނެވުނު ކަމާއި، ކޮން KIFF އެކައުންޓަކަށްތޯ (އެޕް ގަނެވުމަށް ގުޅުވާ ރެންޑަމް id އެއް)، ކޮންވަގުތެއްތޯ، Apple ގެ ޓްރާންސެކްޝަން id، އަދި Solo އަށް މުއްދަތު ނިމޭ ނުވަތަ އަލުން އައު ވާ ވަގުތެވެ. އަޅުގަނޑުމެން އެ ބޭނުންކުރަނީ ތިބާގެ އެކައުންޓަށް ކްރެޑިޓް ނުވަތަ ޕްލޭން އިތުރުކުރުމަށެވެ. Apple އިން އަޅުގަނޑުމެންނަށް ތިބާގެ Apple ID، ނަން، އީމެއިލް އެޑްރެސް ނުވަތަ ކާޑު ނުދެއެވެ.
			</li>
			<li>
				<strong>Google Play ގަނެވުންތައް</strong> — Android ގައި، އެއް ފަދަ ގަނެވުންތައް Google Play ގެ ބިލިންގ މެދުވެރިކޮށް ދެއެވެ: Google އިން ފައިސާ ނަގައި ތިބާގެ ފައިސާ ދެއްކުމުގެ ތަފްސީލް ބަހައްޓައެވެ. Google އިން އަޅުގަނޑުމެންނަށް ކިޔައިދެނީ ގަނެވުނު ކަމާއި، ކޮން KIFF އެކައުންޓަކަށްތޯ (އެ ރެންޑަމް id ވެސް)، ކޮންވަގުތެއްތޯ، ގަނެވުމުގެ token އާއި އޯޑަރ id، އަދި Solo އަށް މުއްދަތު ނިމޭ ނުވަތަ އަލުން އައު ވާ ވަގުތެވެ، އަދި އަޅުގަނޑުމެން އެ ހަމަ އެ ގޮތަށް ބޭނުންކުރަމެވެ. Google އިން އަޅުގަނޑުމެންނަށް ތިބާގެ Google އެކައުންޓް، ނަން، އީމެއިލް އެޑްރެސް ނުވަތަ ކާޑު ނުދެއެވެ.
			</li>
		</ul>
	</section>
}

templ privacyLawfulBasesDV() {
	<section id="lawful-bases">
		<h2>5. ޕްރޮސެސިންގއަށް ޤާނޫނީ ބިންގަލިތައް</h2>
		<p>
			GDPR ގެ 6 ވަނަ މާއްދާގެ ދަށުން، އަޅުގަނޑުމެން ތިރީގައިވާ ޤާނޫނީ ބިންގަލިތަކަށް ބަރޯސާވެއެވެ:
		</p>
		<ul>
			<li>
				<strong>ކޮންޓްރެކްޓެއް ފުރިހަމަކުރުން</strong> (6(1)(b) މާއްދާ) — އެކައުންޓް ހެދުމަށް، އޮތެންޓިކޭޝަނަށް، ތިބާގެ ނަމުގައި ރަންޓައިމް ހިންގުމަށް، ބިލިންގއަށް (ހަރަކާތްތެރިވެފައި ހުރިއިރު)، އަދި ޚިދުމަތުގެ މައި ސަރފޭސްތަކަށް.
			</li>
			<li>
				<strong>ޤާނޫނީ މަސްލަހަތުތައް</strong> (6(1)(f) މާއްދާ) — ރައްކާތެރިކަމަށާއި، މަކަރުވެރިކަން ހުއްޓުވުމަށާއި، އެކަށީގެންނުވާ ބޭނުންކުރުން ދެނެގަތުމަށާއި، އޮޕަރޭޝަނަލް ޓެލެމެޓްރީއަށާއި، ޚިދުމަތް ރައްކާތެރި ކުރުމަށް. އަޅުގަނޑުމެންގެ މަސްލަހަތުތައް ތިބާގެ ހައްގުތަކާ ދިމާކުރަމެވެ، އަދި އެ ހިސާބު ޓެސްޓުން ލިބުނު ކަންތައްތައް ތިބާ އެދުމުން ތިބާއަށް އަންގަމެވެ.
			</li>
			<li>
				<strong>ރުހުން</strong> (6(1)(a) މާއްދާ) — tafs އެޕްގެ AI އަށް: Coach އާއި ތިބާގެ taf ތައް ހިންގާ AI މޮޑެލަށް ފޮނުވޭ ކަންތައްތައް، <a href="#ai-in-tafs">ތިރީގައި</a> ބަޔާންކޮށްފައިވާ ގޮތަށް. ތިބާ ހުއްދަ ދެއްވަންދެން އެއްވެސް ކަމެއް ނުފޮނުވޭ، އަދި ތިބާއަށް އެކައުންޓްގައި އަނބުރާ ނަގާލެވޭނެއެވެ. ރުހުމަކީ އެނަލިޓިކް ކުކީތަކާއި، އިޚްތިޔާރީ މާކެޓިންގ ގުޅުންތަކާއި، ނުވަތަ ތިބާގެ ޑޭޓާ ބޭނުންކުރުން ބޮޑަށް ފުޅާކުރާ އައު ޕްރޮސެސިންގއެއްގެ ކުރިން އަޅުގަނޑުމެން އެދޭ އެއްޗެވެ. އަޅުގަނޑުމެން އެއްވެސް އެނަލިޓިކްސް، އިޝްތިހާރު، އަދި ބޭނުމެއް ނެތް ޓްރެކިންގ ނުހިންގަމެވެ.
			</li>
			<li>
				<strong>ޤާނޫނީ ވާޖިބު</strong> (6(1)(c) މާއްދާ) — ޓެކްސް ރެކޯޑްތަކަށް (އެސްޓޯނިޔާގެ އެކައުންޓިންގ އެކްޓް §12، 7 އަހަރު)، ޤާނޫނީ ބާރުވެރިންގެ އެދުންތަކަށް ޖަވާބުދިނުމަށް، އަދި ބޭނުންކުރެވޭ ތަނެއްގައި ފައިސާ ދޮވެލުން ހުއްޓުވުމުގެ ޤާނޫނުތަކުން ބޭނުންވާ ބެހެއްޓުމަށް.
			</li>
		</ul>
		<h3 id="ai-in-tafs">tafs އެޕްގެ AI</h3>
		<p>AI އަށް ކަމެއް ދިއުމުގެ ކުރިން tafs އެޕުން މި ބަސްތަކުން ތިބާގެ ގާތުން އަހައެވެ:</p>
		<ul>
			<li>tafs އިން Coach އާއި ތިބާގެ taf ތަކަށްޓަކައި Anthropic ގެ Claude AI ބޭނުންކުރެއެވެ.</li>
			<li>Coach އާއި ތިބާގެ taf ތަކަކީ AI އޭޖެންޓުންނެވެ: އެމީހުން ލިޔާ ކަންތައްތައް އުފެދެނީ AI އިންނެވެ އަދި ރަނގަޅު ނުވެދާނެއެވެ. ތިބާގެ ކުންފުންޏުން ބޭރަށް taf އަކުން ފޮނުވާ މެސެޖެއްގައި، އެ ލިޔީ AI އޭޖެންޓެއް ކަމަށް ބުނެވޭނެއެވެ.</li>
			<li>އެއަށް ފޮނުވޭ ކަންތައްތައް: ތިބާ Coach އާއި ތިބާގެ taf ތަކަށް ލިޔާ ކަންތައްތައް، ތިބާ އެޓޭޗް ކުރާ ފައިލްތައް، ތިބާގެ ގުޅިފައިވާ އެޕްތަކުން taf އެއް މަސައްކަތް ކުރަމުންދާއިރު އެއަށް އެނބުރި ދޭ ކަންތައްތައް، އަދި Coach އެޕްގައި ތިބާއަށް އެހީތެރިވާ ވަގުތު ތިބާގެ ސްކްރީނުގައި ހުރި ކަންތައްތައް.</li>
			<li>ދުވަހަކުވެސް ނުފޮނުވޭ ކަންތައްތައް: ތިބާގެ ގުޅިފައިވާ އެޕްތަކުން ބޭނުންކުރާ ޕާސްވޯޑުތަކާއި ކީތައް، ނުވަތަ ތިބާގެ އިނގިލީގެ ދަލީލު.</li>
			<li>Anthropic އިން އެ ބޭނުންކުރަނީ ޖަވާބުދިނުމަށާއި 30 ދުވަހާ ހަމައަށް އެ ބަހައްޓަންވެސް ކަމުގައެވެ.</li>
			<li>ތިބާ ހުއްދަ ނުދެއްވަންދެން އެއްވެސް ކަމެއް ނުފޮނުވޭ. ތިބާއަށް އެކައުންޓްގައި އަނބުރާ ނެގޭނެއެވެ.</li>
		</ul>
		<p>ވަގުތުގައި ކޮންމެ މީހެއްވެސް ނެތިއްޖެ ބަޔަކު ހިންގާ taf އެއް (އެ ޝެޑިއުލްއަށް ބަލާގެން، ނުވަތަ ކަމެއް އަންނަ ވަގުތު) ބަރޯސާވަނީ އެ ހެދި ނުވަތަ ބަލައިގަތް މީހާގެ ރުހުމަށެވެ، ނޫނީ އެކައުންޓުގެ taf ތައް މެނޭޖް ކުރާ ފުރަތަމަ މީހަކު ހުއްދަ ދިނުމުގެ ރުހުމަށެވެ.</p>
		<p><strong>ތިބާ އަނބުރާ ނަގާއިރު،</strong> Coach އާއި ތިބާގެ taf ތައް ތިބާއަށް ޖަވާބުދިނުން ހުއްޓައެވެ. ރަނާތައް ތިބާގެ ރުހުމަށް ބަރޯސާވާ taf އެއް ވަގުތީގޮތުން ހުއްޓެއެވެ: އޭގެ ޝެޑިއުލްތައް ހުއްޓި، އަންނަ ކަންތައްތައް ތިބެއެވެ. ރުހުން އަލުން ދޭއިރު، ނުވަތަ އެކައުންޓުގެ taf ތައް މެނޭޖްކުރާ މީހަކު އޭގެ އަމިއްލަ ރުހުމާއެކު އެ ބަލައިގަންނަ ވަގުތު އެ ކުރިއަށް ދެއެވެ. އަނބުރާ ނެގުމުން ކުރިން ފޮނުވާފައިވާ ކަންތައް ބަދަލު ނުވެއެވެ.</p>
		<p>Anthropic <a href="/subprocessors">/subprocessors</a> (އިނގިރޭސިން) ގައި ލިސްޓްކޮށްފައިވެއެވެ، އެ ޕްރޮސެސް ކުރާ ތަނާއި ޑޭޓާ ދިގުމުއްދަތަކަށް ބަހައްޓާނެ ވަގުތުތަކާއެކު.</p>
	</section>
}

templ privacySubprocessorsDV() {
	<section id="sub-processors">
		<h2>6. ސަބް-ޕްރޮސެސަރުން</h2>
		<p>އަޅުގަނޑުމެން ތިބާގެ ޕަރސަނަލް ޑޭޓާ ނުވިއްކަމެވެ، އަދި އިޝްތިހާރުތަކަށްޓަކައި ނުބަހާލަމެވެ.</p>
		<p>
			ޚިދުމަތް ފޯރުކޮށްދިނުމަށް އަޅުގަނޑުމެން ކުޑަ ޢަދަދެއްގެ ވިއްކާ ފަރާތްތައް ހިމެނުވަމެވެ. ރަސްމީ، މިހާރުގެ ލިސްޓް <a href="/subprocessors">/subprocessors</a> (އިނގިރޭސިން) ގައި ހުއްޓެވެ؛ އެ ސަފްހާ ކޮންމެ ބަދަލަކުން 30 ދުވަހުގެ ތެރޭގައި އަޚާރު ކުރެވެއެވެ. އަޅުގަނޑުމެން ކޮންމެ ސަބް-ޕްރޮސެސަރަކުވެސް ލިޔުމުން އެއްބަސްވުމުގެ ދަށުން، ޕަރސަނަލް ޑޭޓާ EU އިން ބޭރަށް ދާއިރު EU ސްޓޭންޑަރޑް ކޮންޓްރެކްޓް ކްލޮޒްތައް ހިމެނިގެން، އަޅުގަނޑުމެންގެ ރައްކާތެރިކަމާ އެއްފަދަ ރައްކާތެރިކަން ފޯރުކޮށްދިނުމަށް އެދެމެވެ.
		</p>
		<p>
			ޕަރސަނަލް ޑޭޓާއަށް އަސަރުކުރާ ސަބް-ޕްރޮސެސަރުންގެ ބޮޑެތި އިތުރުކުރުންތައް ނުވަތަ ބަދަލުކުރުންތައް، ދެކޮޅު ހެދުމުގެ ހައްގާއެކު، ހަރަކާތްތެރި ކަސްޓަމަރުންނަށް ކުރިން އަންގަވެއެވެ.
		</p>
	</section>
}

templ privacyTransfersDV() {
	<section id="transfers">
		<h2>7. ބައިނަލްއަޤުވާމީ ޓްރާންސްފަރުތައް</h2>
		<p>
			އަޅުގަނޑުމެންގެ ސަބް-ޕްރޮސެސަރުންގެ ތެރެއިން ބައެއް ޔޫރަޕިއަން އިކޮނޮމިކް އެރިއާގެ ބޭރުގައި، ގިނައިން އެމެރިކާގައި ޤާއިމުކޮށްފައިވެއެވެ. އެފަދަ ކޮންމެ ޓްރާންސްފަރަކަށްޓަކައި އަޅުގަނޑުމެން ތިރީގައިވާ ރައްކާތެރިކަންތަކުގެ ތެރެއިން މަދުވެގެން އެއްކަމެއްގައި ބަރޯސާވެއެވެ:
		</p>
		<ul>
			<li>
				<strong>EU–US ޑޭޓާ ޕްރައިވަސީ ފްރޭމްވޯކް</strong> — ފްރޭމްވޯކަށް ސެޓިފައި ކުރި އެމެރިކާގެ ސަބް-ޕްރޮސެސަރުންނަށް. 2023 ގެ މެދުން ފެށިގެން ހިނގާ އެކަށީގެންވުމުގެ ނިންމުން؛ އަޅުގަނޑުމެން އޭގެ ހާލަތުގެ ބަދަލެއް ހުރިތޯ ބަލަމެވެ.
			</li>
			<li>
				<strong>ސްޓޭންޑަރޑް ކޮންޓްރެކްޓް ކްލޮޒްތައް</strong> — އަޅުގަނޑުމެންގެ ސީދާ ސަބް-ޕްރޮސެސަރުންނަށް މޮޑިއުލް 2 (ކޮންޓްރޯލަރުން ޕްރޮސެސަރަށް) އަދި ޗެއިންކޮށްފައިވާ ޕްރޮސެސަރުން ހިނގާ ތަނެއްގައި މޮޑިއުލް 3 (ޕްރޮސެސަރުން ސަބް-ޕްރޮސެސަރަށް). އަޅުގަނޑުމެން ކޮމިޝަނުން ރުހުން ދިން 2021 SCC ތައް ބޭނުންކުރަމެވެ.
			</li>
			<li>
				<strong>އިތުރު ފިޔަވަޅުތައް</strong> — ރިސްކް އެސެސްމަންޓުން އިތުރު ރައްކާތެރިކަން ބޭނުންވާކަން ދައްކާ ތަނެއްގައި (ޓްރާންސިޓާއި ސްޓޯރޭޖްގައި އެންކްރިޕްޝަން، އެކްސެސް ލޮގިންގ، ޑޭޓާ މިނިމައިޒް ކުރުން).
			</li>
		</ul>
		<p>
			ތިބާއަށް <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> އަށް އީމެއިލް ކުރެވިގެން ސަބް-ޕްރޮސެސަރެއްގެ ގޮތުން ޚާއްޞަ ޓްރާންސްފަރ އިންސްޓްރޫމަންޓް އެދެވޭނެއެވެ.
		</p>
		<p><strong>ތިބާގެ ޤައުމު.</strong> ބައެއް ޤައުމުތަކުގެ ޤާނޫނުތަކުން މި ސިޔާސަތުން ބުނާ އެއްޗަކަށްވުރެ އިތުރު ކަންތައްތައް އެދެއެވެ. އެ އިތުރުކުރާ ކަންތައްތައް، އިނގިރޭސިބަހުން އަދި އެ ޤައުމުގެ ބަހުން، <a href="/privacy/countries">ތިބާގެ ޤައުމު</a> (އިނގިރޭސިން) ގައި ހުއްޓެވެ.</p>
	</section>
}

templ privacyRetentionDV() {
	<section id="retention">
		<h2>8. ބެހެއްޓުން</h2>
		<p>
			އަޅުގަނޑުމެން ޕަރސަނަލް ޑޭޓާ ބަހައްޓަނީ އެ ޕްރޮސެސް ކުރާ މަޤްޞަދުތަކާއި ބޭނުންކުރެވޭ ޤާނޫނީ ވާޖިބުތަކާ ގުޅޭ އެންމެ ކުރު މުއްދަތަކަށެވެ.
		</p>
		<ul>
			<li>
				<strong>އެކައުންޓާއި ލޮގިން މެޓާޑޭޓާ</strong> — އެކައުންޓް ފޮހެލާންދެން. tafs އެޕްގައި، ވެރިއަކު އެ ފޮހެލަނީ އެކައުންޓް → <em>އެކައުންޓް ފޮހެލާ</em> ގައެވެ. ވެބްގައި ހެދި އެކައުންޓެއް ފޮހެލެވެނީ <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> އަށް އީމެއިލް ކުރުމުން، GDPR 12(3) މާއްދާގެ މަހެއްގެ ވަގުތުގެ ތެރޭގައެވެ. ކޮންމެ ގޮތަކުންވެސް، އެކައުންޓުގެ ކީތައް ވަގުތުން ހުއްޓެއެވެ. tafs އެޕްގައި ފޮހެލުމުން، އެ ފަހަތަށް ނުވެއެވެ: އޭގެ tafs ބަހުސްތަކާއި ނޯޓުތަކާއި ގުޅުންތައް ވަގުތުން ފޮހެވެއެވެ، އަދި KIFF އިން ބަހައްޓާ ކަންތައްތައް 30 ދުވަހުގެ ތެރޭގައި ފޮހެވެއެވެ. ވެބްގައި ފޮހެލުމުން، ވެރިއަކަށް އެ އަލުން ބޭނުންވެއްޖެނަމަ ކަމަށް އަޅުގަނޑުމެން އޭގެ ޑޭޓާ 30 ދުވަހުގެ ކަރުނާ މުއްދަތަކަށް ބަހައްޓައި، ދެން ފޮހެލަމެވެ.
			</li>
			<li>
				<strong>API ކީ ރެކޯޑްތައް</strong> — އެކައުންޓް ފޮހެލާންދެން، ކީއެއް ބާތިލް ކުރުމަށް ފަހުވެސް ހިމެނިގެން. އޭޖެންޓް ލޮގިން ގުޅުމަކަށް ނިސްބަތްވާ ކީއެއް އެ ގުޅުމާއެކު، އެ ނިމުމަށް 30 ދުވަހަށް ފަހު ފޮހެވެއެވެ.
			</li>
			<li>
				<strong>ސެޝަން ކުކީތައް</strong> — ވަގުތު ހަމަވާންދެން (ޑިފޯލްޓަކަށް 24 ގަޑިއިރު) ނުވަތަ ތިބާ ނިކުންނަންދެން.
			</li>
			<li>
				<strong>Reverse-proxy އެކްސެސް ލޮގްތައް</strong> — 90 ދުވަހާ ހަމައަށް، ދެން ޖުމްލަ ނުވަތަ ފޮހެލެވެއެވެ.
			</li>
			<li>
				<strong>ޚިދުމަތުގެ ލޮގްތައް</strong> — KIFF ގެ ޚިދުމަތްތަކާއި planque ހިނގަމުންދާއިރު ރެކޯޑު ކުރާ ކަންތައްތައް: އެރަރުތަކާއި ރިކުއެސްޓްތައް، އެ އެކައުންޓެއް، މީހެއް ނުވަތަ އޭޖެންޓެއް ނަމުން ދެއްކިދާނެއެވެ. 30 ދުވަސް، ދެން ފޮހެލެވެއެވެ.
			</li>
			<li>
				<strong>ބެކަޕްތައް</strong> — KIFF ގެ ޑޭޓާބޭސް ދުވަހުން ދުވަހަށް ބެކަޕް ކުރެވެއެވެ، އެންކްރިޕްޓް ކޮށް، އަދި ކޮންމެ ބެކަޕެއް 7 ދުވަސް ބަހައްޓައެވެ، ފަހެ ފޮހެލި ރެކޯޑެއް 7 ދުވަހުގެ ތެރޭގައި އެ ތަކުން ނެތިގެންދެއެވެ. tafs އާއި planque ގެ ސްޓޯރުތަކުން އެންކްރިޕްޓް ކުރެވިފައިވާ ޕޮއިންޓް-އިން-ޓައިމް ކޮޕީތައް 35 ދުވަސް ބަހައްޓައެވެ، އެއީ ފެއިލްވުމަކަށް ފަހު ސްޓޯރއެއް ރިސްޓޯރ ކުރުމަށް ހަމައެކަނި ބޭނުންކުރެވޭ ކޮޕީތަކެވެ، ފަހެ ފޮހެލި ރެކޯޑެއް 35 ދުވަހުގެ ތެރޭގައި އެ ތަކުން ނެތިގެންދެއެވެ.
			</li>
			<li>
				<strong>Tenant އޮޑިޓް ޑޭޓާ</strong> — ކަސްޓަމަރުގެ tenant ކޮންފިގަށް ބަލާގެން ޕްރޮސެސަރެއްގެ ގޮތުގައި ބަހައްޓައެވެ. ޑިފޯލްޓް: tenant ގެ އުމުރަށް ބަހައްޓައެވެ؛ tenant ފޮހެލުމުން ފޮހެވެއެވެ. <a href="/security#deletion">/security#deletion</a> (އިނގިރޭސިން) ބަލާށެވެ.
			</li>
			<li>
				<strong>KIFF ގޭޓްވޭ މެދުވެރިކޮށް ކޯލްތައް</strong> — ކޯލެއްގެ އާގިއުމަންޓްތައް އެ ފޮނުވުމާ، ބާތިލް ކުރުމާ ނުވަތަ ފެއިލްވުމާ ހަމައަށް، ދެން ފޮހެލެވެއެވެ؛ ޓޫލްގެ ނަތީޖާ 24 ގަޑިއިރު، ދެން ފޮހެލެވެއެވެ. ނިންމުމުގެ ރެކޯޑާއި އާގިއުމަންޓްތަކުގެ ހެޝް tenant އޮޑިޓް ޑޭޓާގެ ގޮތުގައި ބަހައްޓައެވެ. <a href="/security#data-kept">/security#data-kept</a> (އިނގިރޭސިން) ބަލާށެވެ.
			</li>
			<li>
				<strong>ބޭނުންކުރުން</strong> — ގޭޓްވޭ މެދުވެރިކޮށް ކޮންމެ ކޯލަކަށްޓަކައި، އެ ނިމުމުން: ކޮން އޭޖެންޓެއްތޯ އެ ކުރީ، ޓޫލް، އަދި އެއީ ޢަމަލެއްގެ ގޮތުގައި ގުނެވުނުތޯ ނުވަތަ ހުވާލެވުނުތޯ (އަދި ކީއްވެގެންތޯ). taf އެއް ނުވަތަ Coach ގެ ކޮންމެ ރަނާއަކަށްޓަކައި، އެ ނިމުމުން: taf، ކޮންވަގުތެއްތޯ، އޭގެ AI ބޭނުންކުރި ކްރެޑިޓް، އަދި އެ ގުނެވުނުތޯ ނުވަތަ ކީއްވެގެން ނުގުނުނީތޯ. އެކައުންޓް ފޮހެލާންދެން؛ ބިލިންގއަށްޓަކައި އަޅުގަނޑުމެންގެ ފައިސާ ދެއްކުން ޕްރޮސެސް ކުރާ ފަރާތަށް ރިޕޯޓް ކުރާ ކަންތައްތައް ބިލިންގ ރެކޯޑްތަކާއެކު ބަހައްޓައެވެ.
			</li>
			<li>
				<strong>އޭޖެންޓް ލޮގިން ގުޅުންތައް</strong> — ކޮން އޭޖެންޓެއްތޯ، އެޕްގެ ނަން، ކާކު ހުއްދަ ދިނީ، ކޮންވަގުތެއްތޯ، އަދި އޭގެ ފަހުގެ ބޭނުންކުރުން: ގުޅުން ދިރިހުރިއިރު، ދެން އެ ނިމުމަށް 30 ދުވަސް (އެ ވަގުތުގައި އެ ޑޭޝްބޯޑުގައި ލިސްޓްކުރެވިފައި ހުރެއެވެ)، ދެން އޭގެ token ތަކާއި އޭގެ API ކީއާއެކު ފޮހެވެއެވެ. އެ ހުރިހާ ކަމެއް އެކައުންޓާއެކު ފޮހެވެއެވެ.
			</li>
			<li>
				<strong>tafs</strong> — ޑިވައިސްގެ push token ތިބާ އެޕުން ނިކުންނަ، ޑިވައިސް ދުރުކުރާ، ނުވަތަ Apple ނުވަތަ Google ގެ token ނެތިއްޖެކަމަށް ރިޕޯޓް ކުރާންދެން. ޑިވައިސްގެ ޕަބްލިކް ކީ، ނަން، ޕްލެޓްފޯމް އަދި ތާރީޚްތައް ތިބާ އެ ބޭނުންކުރާއިރު؛ ތިބާ އޭގެ ތެރެއިން ނިކުތުމުން، އެ ދުރުކުރެވިފައިވާ ކަމަށް ނިޝާންކޮށް އެކައުންޓް ފޮހެލާންދެން ބަހައްޓައެވެ، ފަހެ KIFF އިން އޭގެ ފަހުން އައި ޖަވާބު ބާތިލް ކޮށް ކުރިން އެއް ސޮއިކުރި ޑިވައިސް ދައްކާލެވޭނެއެވެ. passkey އެއްގެ ޕަބްލިކް ކީ، id އާއި ނަން އޭގެ ޑިވައިސްގެ ފަދައިން ބަހައްޓައެވެ. ކޮމްޕިޔުޓަރަކު އޭގެ ސެޝަން 90 ދުވަހާ ހަމައަށް، ނުވަތަ ތިބާ ނިކުންނަންދެން ބަހައްޓައެވެ. tafs އިން ތިބާގެ ކުންފުންޏަށްޓަކައި ބަހައްޓާ ކަންތައްތައް ޕްރޮސެސަރެއްގެ ގޮތުގައި ބަހައްޓައެވެ: taf އެއްގެ ރަނާތަކާއި ބަހުސްތައް، ބަހުސެއްގެ ޚުލާސާއާއެކު (އަދި Setup ގެ)، 30 ދުވަސް، ތިބާގެ ޓޫލްތަކުން އެނބުރި ދޭ ކަންތައްތައް ރަނާއެއް ނިމެންދެން ހަމައެކަނި (ބަހުސެއްގައި، އެ ކިޔާލި ކަންތައްތައް ހަމައެކަނި އޭގެ ދެން އޮތް މެސެޖުތަކަށްޓަކައި އެންކްރިޕްޓް ކޮށް ބަހައްޓައެވެ، ބަހުސް އެއް ގަޑިއިރު ހަރަކާތެއް ނެތި ހުރެ އަދި ކިޔުމަށް ފަހު އެންމެ ގިނައިން ހަތަރު ގަޑިއިރާ ހަމައަށް ބޭނުންކޮށް، ދެން ދުވަސް ކޮޅެއްގެ ތެރޭގައި އޮޓޯމެޓިކުން ފޮހެލެވެއެވެ)، އަދި އޭގެ މެމޯރީ ނޯޓުތައް taf ދުރުކޮށްލަންދެން؛ އެ ހަވާލުކުރާ ފައިލްތައް އެ ހެދި ރަނާއިން 30 ދުވަސް، ދެން އެއް ދުވަހުގެ ތެރޭގައި އޮޓޯމެޓިކުން ފޮހެލެވެއެވެ، ނުވަތަ ތިބާގެ އެކައުންޓުގައިވާ ކާކު ހުއްޓާ އެއް ފޮހެލިނަމަ ކުރިން؛ planque ގައި ގުޅުމެއްގެ token ނުވަތަ ކީ، ނުވަތަ Composio ގައި މެނޭޖް ކުރެވޭ ގުޅުމެއްގެ ލޮގިން، ތިބާ އެ ކަނޑައަޅާންދެން (ތިބާގެ އެހެން ގުޅުމަކުން އެ ވިއްކާ ފަރާތުގައި އެއް އެކައުންޓް ބޭނުންކުރެވިދާނެ ނަމަ، އެ ބޭނުންނުކޮށް ބަހައްޓައެވެ، އެއްވެސް އަނެއް ގުޅުމެއްވެސް ކަނޑައެޅުމަށް ދެން)، އަދި އޭގެ ރުހުންތަކުގެ ރެކޯޑު އެކައުންޓް ނިމެންދެން؛ <a href="/legal/dpa#annex-4">DPA ގެ 4 ވަނަ އެނެކްސް</a> (އިނގިރޭސިން) ބަލާށެވެ.
			</li>
			<li>
				<strong>ބިލިންގ ރެކޯޑްތައް</strong> — މާލީ އަހަރު ނިމުނު ދުވަހުން 7 އަހަރު (އެސްޓޯނިޔާގެ އެކައުންޓިންގ އެކްޓް §12).
			</li>
			<li>
				<strong>App Store އާއި Google Play ގަނެވުންތައް</strong> — ކޮންމެ ގަނެވުމެއް ބެހޭ ގޮތުން Apple ނުވަތަ Google އިން އަޅުގަނޑުމެންނަށް ކިޔައިދިން ކަންތައްތައް އެކައުންޓް ފޮހެލާންދެން ތިބާގެ އެކައުންޓުގައި ދެމިއޮވެއެވެ. އެމީހުންގެ ސޭލްސް އާއި ޕޭއައުޓް ރިޕޯޓްތައް، އަޅުގަނޑުމެން ބިލިންގ ރެކޯޑްތަކެއްގެ ގޮތުގައި 7 އަހަރު ބަހައްޓާ، ތިބާގެ ނަން ނުދައްކައެވެ.
			</li>
			<li>
				<strong>ސަޕޯޓް ގުޅުން</strong> — ފަހުގެ އިންޓަރެކްޝަނުން 3 އަހަރު، ދެން ފޮހެލެވެއެވެ.
			</li>
		</ul>
	</section>
}

templ privacyRightsDV() {
	<section id="rights">
		<h2>9. ތިބާގެ ހައްގުތައް</h2>
		<p>
			GDPR ގެ ދަށުން ތިބާގެ ޕަރސަނަލް ޑޭޓާއާ ބެހޭ ގޮތުން ތިބާއަށް ތިރީގައިވާ ހައްގުތައް ލިބިގެންވެއެވެ:
		</p>
		<ul>
			<li><strong>ވާސިލްވުން</strong> (15 މާއްދާ) — އަޅުގަނޑުމެން ތިބާގެ ޑޭޓާ ޕްރޮސެސް ކުރޭތޯ ކަށަވަރުކުރުމާއި، އޭގެ ކޮޕީއެއް.</li>
			<li><strong>ރަނގަޅުކުރުން</strong> (16 މާއްދާ) — ރަނގަޅު ނޫން ނުވަތަ ނުފުރިހަމަ ޑޭޓާ ރަނގަޅު ކުރުން.</li>
			<li><strong>ފޮހެލުން</strong> (17 މާއްދާ) — ޤާނޫނީ ބެހެއްޓުމުގެ އިސްތިސްނާތަކަށް ބަރޯސާވެ ތިބާގެ ޑޭޓާ ފޮހެލުން.</li>
			<li><strong>ޙައްދުކުރުން</strong> (18 މާއްދާ) — ޚިލާފުވުމެއް ހައްލުވަމުންދާއިރު ޕްރޮސެސިންގ ވަގުތީގޮތުން ހުއްޓުވުން.</li>
			<li><strong>ގެންގުޅެވޭނެ ކަން</strong> (20 މާއްދާ) — ތިބާ ދިން ޑޭޓާގެ މެޝިނަށް ކިޔަން ފެންނަ އެކްސްޕޯޓެއް.</li>
			<li><strong>ދެކޮޅުހެދުން</strong> (21 މާއްދާ) — ޤާނޫނީ މަސްލަހަތުތަކަށް ބިނާވެފައިވާ ޕްރޮސެސިންގއާ؛ އަޅުގަނޑުމެން ބާރުވެރި ސަބަބުތައް ދެއްކުމަށް ނުކުޅެދޭނަމަ ހުއްޓައެވެ.</li>
			<li><strong>ރުހުން އަނބުރާ ނެގުން</strong> (7(3) މާއްދާ) — ރުހުމަށް ބިނާވެފައިވާ ކޮންމެ ޕްރޮސެސިންގއަކަށް، tafs އެޕްގެ AI ފަދަ (އެކައުންޓްގައި، <a href="#ai-in-tafs">މަތީގައި</a> ފަދައިން). އަނބުރާ ނެގުން ކުރިން ޤާނޫނީ ޕްރޮސެސިންގއަށް އަސަރެއް ނުކުރެއެވެ.</li>
		</ul>
		<p>
			މި ހައްގުތަކުގެ ތެރެއިން އެއްވެސް ހައްގެއް ބޭނުންކުރުމަށް، <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> އަށް އީމެއިލް ކުރައްވާށެވެ. އަޅުގަނޑުމެން 12(3) މާއްދާއަށް ބަލާ، ނުހުއްދަ ލަސްވުމެއް ނެތި، އެންމެ ލަސްވެގެން މަހެއްގެ ތެރޭގައި ޖަވާބުދެމެވެ؛ ސަމާސާ ޑިމާންޑްތަކަށް އިތުރު ދެ މަހާ ހަމައަށް އިތުރުކުރެވިދާނެއެވެ އަދި އެގޮތަށް ކުރެވިއްޖެނަމަ ތިބާއަށް އަންގަމެވެ.
		</p>
		<h3 id="export-chats">ތިބާގެ އަމިއްލަ tafs ބަހުސްތައް</h3>
		<p>
			tafs އެޕްގައި، އެކައުންޓް → ބަހުސްތައް އެކްސްޕޯޓް ކުރޭ އިން ކޮންމެ taf އެއްކޮޅު ތިބާ ކުރި ތިބާގެ އަމިއްލަ ބަހުސްތައް، Coach ގެ ބަހުސްތައް ހިމެނިގެން، ތިބާ އެޓޭޗް ކުރި ފައިލްތަކުގެ ނަންތަކާއި، ތިބާގެ އަމިއްލަ ނޯޓުތައް، ކިޔަން ފެންނަ ފައިލެއްގެ ގޮތުގައި އަދި JSON ގެ ގޮތުގައި ޑައުންލޯޑް ކުރެއެވެ. އެ އެކްސްޕޯޓް ކުރެވޭނީ ތިބާއަށް ހަމައެކަނި: އެޑްމިނަކަށް ނުވަތަ އެކައުންޓުގެ ވެރިޔަކަށް ނުކުރެވޭނެއެވެ، އަދި KIFF ގެ އެކައުންޓް އެކްސްޕޯޓުގައި އެތައް ނުހިމެނެއެވެ.
		</p>
		<h3 id="delete-account">ތިބާގެ tafs އެކައުންޓް ފޮހެލުން</h3>
		<p>
			tafs އަކީ KIFF ގެ އެޕެވެ. ތިބާގެ tafs އެކައުންޓާއި އޭގެ ޑޭޓާ ފޮހެލުމަށް:
		</p>
		<ol>
			<li>tafs އެޕް ހުޅުވައި ވަންނަވާށެވެ.</li>
			<li>އެކައުންޓަށް ގޮސް، ދެން <em>އެކައުންޓް ފޮހެލާ</em> ޓެޕް ކުރައްވާށެވެ.</li>
			<li>ކަށަވަރުކުރައްވާށެވެ. އެކައުންޓެއް ފޮހެލުން އަނބުރާ ނުނެގެއެވެ.</li>
		</ol>
		<p>
			<em>އެކައުންޓް ފޮހެލާ</em> ދައްކަނީ ކުންފުންޏުގެ އެކައުންޓް ފޮހެލެވޭ މީހަކަށް، ގިނައިން އޭގެ ވެރިޔާއަށެވެ. ތިބާއަށް އެ ނުފެނިއްޖެނަމަ، ނުވަތަ އެޕް އެ ތިބާގެ ކައިރީ ނެތްނަމަ، ތިބާ ވަންނަ އެޑްރެސްއިން <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> އަށް އީމެއިލް ކުރައްވާށެވެ، އަދި އަޅުގަނޑުމެން ތިބާގެ ޑޭޓާ ނުހުއްދަ ލަސްވުމެއް ނެތި، އެންމެ ލަސްވެގެން މަހެއްގެ ތެރޭގައި ފޮހެލަމެވެ.
		</p>
		<p>
			ފޮހެލެވޭ ކަންތައްތައް: އެކައުންޓުގެ ކީތައް ވަގުތުން ހުއްޓެއެވެ. އޭގެ tafs ތަކާއި ބަހުސްތަކާއި ނޯޓުތަކާއި އެޓޭޗްކުރެވިފައިވާ ފައިލްތަކާއި ގުޅުންތައް ވަގުތުން ފޮހެވެއެވެ، އަދި އެ ތަކުގެ ޕޮއިންޓް-އިން-ޓައިމް ކޮޕީތަކުން 35 ދުވަހުގެ ތެރޭގައި. އެކައުންޓަށްޓަކައި KIFF އިން ބަހައްޓާ ކަންތައްތައް 30 ދުވަހުގެ ތެރޭގައި ފޮހެވެއެވެ، އަދި ބެކަޕްތަކުން އެއަށްފަހު 7 ދުވަހުގެ ތެރޭގައި. އެކައުންޓް ނަން ދައްކާ ޚިދުމަތުގެ ލޮގްތައް 30 ދުވަހުގެ ތެރޭގައި ނެތިގެންދެއެވެ. Tenant އޮޑިޓް ޑޭޓާ tenant އާއެކު ފޮހެވެއެވެ. ކޮންމެ ބާވަތެއްގެ ޑޭޓާއަށްޓަކައި <a href="#retention">ބެހެއްޓުން</a> ބަލާށެވެ.
		</p>
		<p id="delete-data">
			ތިބާގެ ޑޭޓާއިން ބައެއް ފޮހެލައި އެކައުންޓް ބަހައްޓާލުމަށް: އެޕްގައި، ބަހުސެއް ފޮހެލާށެވެ، އަދި އޭގެ މެސެޖުތަކާއި އެޓޭޗްކުރެވިފައިވާ ފައިލްތައް އެއާއެކު ދެއެވެ؛ taf އެއް ދުރުކޮށްލާށެވެ، އަދި އޭގެ ބަހުސްތަކާއި ނޯޓުތަކާއި ގުޅުންތައް އެއާއެކު ދެއެވެ. އެހެން ކޮންމެ ކަމަކަށް، <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> އަށް އީމެއިލް ކުރައްވައި ފޮހެލަން ޖެހޭ ކަންތައްތައް ބުނައްވާށެވެ. އަޅުގަނޑުމެން އެ ނުހުއްދަ ލަސްވުމެއް ނެތި، އެންމެ ލަސްވެގެން މަހެއްގެ ތެރޭގައި ކުރަމެވެ.
		</p>
		<p>
			ބެލެހެއްޓުމުގެ އިދާރާއެއްގައި ޝަކުވާ ކުރުމުގެ ހައްގު ތިބާއަށް ލިބިގެންވެއެވެ. އަޅުގަނޑުމެންގެ ލީޑް ބެލެހެއްޓުމުގެ އިދާރާއަކީ <a href="https://www.aki.ee/en" target="_blank" rel="noopener">އެސްޓޯނިއާގެ ޑޭޓާ ޕްރޮޓެކްޝަން އިންސްޕެކްޓަރޭޓް (Andmekaitse Inspektsioon)</a> އެވެ. ތިބާއަށް ތިބާ ދިރިއުޅޭ މެންބަރ ޤައުމުގެ ބެލެހެއްޓުމުގެ އިދާރާއަށްވެސް ޝަކުވާ ކުރެވޭނެއެވެ.
		</p>
		<p><strong>ތިބާގެ ޤައުމު.</strong> ބައެއް ޤައުމުތަކުގެ ޤާނޫނުތަކުން މި ސިޔާސަތުން ބުނާ އެއްޗަކަށްވުރެ އިތުރު ކަންތައްތައް އެދެއެވެ. އެ އިތުރުކުރާ ކަންތައްތައް، އިނގިރޭސިބަހުން އަދި އެ ޤައުމުގެ ބަހުން، <a href="/privacy/countries">ތިބާގެ ޤައުމު</a> (އިނގިރޭސިން) ގައި ހުއްޓެވެ.</p>
	</section>
}

templ privacyCookiesDV() {
	<section id="cookies">
		<h2>10. ކުކީތައް</h2>
		<p>
			އަޅުގަނޑުމެން ތިން ކުކީ ސެޓްކުރަމެވެ، ހުރިހާ އެއްޗެއް ގޮތަކުން ބޭނުންވާ، ފުރަތަމަ ފަރާތުގެ، HTTPS މެދުވެރިކޮށް ހަމައެކަނި ފޮނުވޭ އަދި ސަފްހާގައިވާ ސްކްރިޕްޓްތަކަށް ކިޔަން ނުކުޅެދޭ. EU ePrivacy ގެ ޤަވާޢިދުތަކުގެ ދަށުން އެއަށް ރުހުން ނުބޭނުންވެއެވެ؛ އެ ހުރިކަން ތިބާއަށް އެނގޭނެ ގޮތަށް އަޅުގަނޑުމެން އެ ލިސްޓް ކުރަމެވެ. <a href="/cookies">ކުކީ ސިޔާސަތުގައި</a> (އިނގިރޭސިން) ތަފްސީލް ހުއްޓެވެ.
		</p>
		<ul>
			<li>
				<strong><code>kiff_session</code></strong> — ތިބާ ލޮގިންވެ ހުރިކަމުގައި ބަހައްޓައެވެ. ތިބާގެ ލޮގިން id، އީމެއިލް އާއި ނަން، އަދި ޑޭޝްބޯޑުން ތިބާއަށްޓަކައި ބޭނުންކުރާ ކްރެޑެންޝަލް ހުރި ސޮއިކުރެވިފައިވާ ސެޝަން ކުކީއެއް. <code>.kiff.dev</code> އަށް ސެޓްކުރެވެއެވެ. އެ 24 ގަޑިއިރު، ނުވަތަ ތިބާ ނިކުންނަންދެން ދެމިއޮވެއެވެ.
			</li>
			<li>
				<strong><code>kiff_flash</code></strong> — "ތިބާގެ ކީ ހެދުނު" ފަދަ އެއް ފަހަރުގެ މެސެޖެއް ދެން އޮތް ސަފްހާއަށް ގެންދެއެވެ. ސޮއިކުރެވިފައިވެއެވެ؛ އައު ކީއެއް ދުވަހަކުވެސް އެތަނުގައި ނެތެވެ. <code>.kiff.dev</code> އަށް ސެޓްކުރެވެއެވެ. ދެން އޮތް ސަފްހާއިން އެ ކިޔާއިރު ފޮހެވެއެވެ، އަދި އެންމެ ގިނައިން 5 މިނިޓު.
			</li>
			<li>
				<strong><code>kiff_cb_attempts</code></strong> — ލޮގިން ސަފްހާ ކިތަންމެ ފަހަރު އަލުން ލޯޑް ވި ކަން ގުނެއެވެ، ފަހެ ވަށައި ދާ ލޮގިނެއް ހުއްޓެއެވެ. ފޮނުވެނީ އެ ސަފްހާއަށް ހަމައެކަނި. އެ 5 މިނިޓު ދެމިއޮވެއެވެ، އަދި ލޮގިނެއް ފެށޭއިރު ނުވަތަ ކާމިޔާބު ވާއިރު ފޮހެވެއެވެ.
			</li>
		</ul>
		<p>
			އަޅުގަނޑުމެން އެނަލިޓިކް ކުކީތައް، އިޝްތިހާރު ކުކީތައް، ނުވަތަ އެއްވެސް ތިންވަނަ ފަރާތުގެ ޓްރެކަރުތަކެއް ބޭނުން ނުކުރަމެވެ. އަޅުގަނޑުމެން އެއްވެސް އިތުރުކުރިއަސް، ePrivacy އާއި ޓްރެކިންގ ޓެކްނޮލޮޖީ ތަކާ ބެހޭ 2023 ގެ EDPB ގައިޑެންސްއާ އެއްގޮތަށް، ކުކީ ސެޓްކުރުމުގެ ކުރިން ރުހުމުގެ ބެނާރެއް ހުށަހަޅަމެވެ.
		</p>
		<p>
			ތިބާ Clerk (އަޅުގަނޑުމެންގެ އޮތެންޓިކޭޝަން ސަބް-ޕްރޮސެސަރ) މެދުވެރިކޮށް ލޮގިން ވެއްޖެނަމަ، Clerk އިން އޭގެ އަމިއްލަ ފްރަންޓެންޑް ޑޮމެއިންގައި (<code>clerk.kiff.dev</code>) ވެސް ކުކީތައް ސެޓްކުރެއެވެ. އެ ކުކީތައް Clerk އަށް ތިބާގެ ލޮގިން ޕްރޮސެސްގައި ތިބާ ދެނެގަތުމަށް ބޭނުންވާ އަދި Clerk ގެ ޕްރައިވަސީ ސިޔާސަތާއި އަޅުގަނޑުމެންގެ ސިޔާސަތު ދެކަމުގެ ދަށުން ކޮންޓްރޯލް ކުރެވެއެވެ. ތަފްސީލަށް ސަބް-ޕްރޮސެސަރުންގެ ލިސްޓް ބަލާށެވެ.
		</p>
	</section>
}

templ privacySecurityDV() {
	<section id="security">
		<h2>11. ރައްކާތެރިކަން</h2>
		<p>
			އަޅުގަނޑުމެންގެ ޓެކްނިކަލް އަދި އޯގަނައިޒޭޝަނަލް ރައްކާތެރިކަމުގެ ފިޔަވަޅުތައް <a href="/security">/security</a> (އިނގިރޭސިން) ގައި ޑޮކިއުމެންޓް ކޮށްފައިވެއެވެ. އެތަކުގައި ޑޭޓާބޭސް ލޭޔަރގައި tenant ތައް ވަކިކުރުން، ޓްރާންސިޓްގައި TLS 1.2+، މެނޭޖް ކުރެވޭ ފޯރުކޮށްދޭ ފަރާތުގެ ޑިފޯލްޓް ތަކުން ސްޓޯރޭޖްގައި އެންކްރިޕްޝަން، އަދި ކުޑަ ހުއްދައިގެ އުސޫލަށް ބިނާވެފައިވާ އެކްސެސް ކޮންޓްރޯލްތައް ހިމެނެއެވެ.
		</p>
		<p>
			ޕަރސަނަލް ޑޭޓާ ބިދިނުމެއް ޖެހުނު ކަސްޓަމަރުންނަށް އަޅުގަނޑުމެން ޤާނޫނުގެ ދަށުން ބޭނުންނުވާ ލަސްވުމެއް ނެތި އަދި ކަށަވަރުވުމަށް ފަހު 72 ގަޑިއިރުގެ ތެރޭގައި، GDPR 33 ވަނަ މާއްދާއާ އެއްގޮތަށް އަންގަމެވެ. ނޯޓިސްގައި ބިދިނުމުގެ ސިފަ، ބެހޭ ޑޭޓާ ސަބްޖެކްޓުންނާއި ރެކޯޑުތަކުގެ ބާވަތްތަކާއި ގާތްގަނޑު ޢަދަދު، ދެވިދާނެ ނަތީޖާތައް، އަދި ނެގި ނުވަތަ ހުށަހެޅި ފިޔަވަޅުތައް ހިމެނެއެވެ.
		</p>
	</section>
}

templ privacyChildrenDV() {
	<section id="children">
		<h2>12. ކުޑަކުދިން</h2>
		<p>
			KIFF Cloud އަކީ ކުޑަކުދިންނަށް ބަހައްޓާފައިވާ ޑިވެލޮޕަރ އިންފްރާސްޓްރަކްޗަރ ޕްރޮޑަކްޓެއް ނޫނެވެ. އަޅުގަނޑުމެން 16 އަހަރުން ދަށުގެ ކުޑަކުދިންގެ ޕަރސަނަލް ޑޭޓާ ނޭނގި ނުޖަމާކުރަމެވެ. ކުޑަކުއްޖަކު އަޅުގަނޑުމެންނަށް ޕަރސަނަލް ޑޭޓާ ދީފައިވާކަމަށް ތިބާ ގަބޫލުކުރާނަމަ، <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> އަށް ގުޅުއްވާށެވެ، އަދި އަޅުގަނޑުމެން އެ ފޮހެލަމެވެ.
		</p>
	</section>
}

templ privacyAutomatedDV() {
	<section id="automated">
		<h2>13. އޮޓޮމެޓިކް ނިންމުން</h2>
		<p>
			KIFF Cloud ގެ ރަންޓައިމް އަޅުގަނޑުމެންގެ ކަސްޓަމަރުން ފޮނުވާ ޑޭޓާ މައްޗަށް ޑިޓަމިނިސްޓިކް ޕޮލިސީ ނިންމުންތައް ނިންމައެވެ. މިއީ GDPR 22 ވަނަ މާއްދާގެ މާނައިގައި ތިބާގެ މައްޗަށް ޤާނޫނީ ނުވަތަ އެއާ އެއްފަދަ ބޮޑު އަސަރު ކުރާ ނިންމުންތަކެއް ނޫނެވެ؛ އެއީ ކަސްޓަމަރުގެ ޢަމަލުތަކާ (ރިފަންޑްތަކާއި، އޯޑަރުތަކާއި، މެސެޖުތަކާއި، އަދި އެހެނިހެން) ބެހޭ ނިންމުންތަކެވެ، ކަސްޓަމަރުގެ އަމިއްލަ ޕޮލިސީގެ ދަށުން ހިނގާ.
		</p>
		<p>
			އެމީހުންގެ އަމިއްލަ އެންޑް ޔޫޒަރުންނަށް އަސަރުކުރާ ނިންމުންތައް ނިންމުމަށް KIFF Cloud ބޭނުންކުރާ ކަސްޓަމަރުން 22 ވަނަ މާއްދާއާ އެއްގޮތްވުމުގެ ޒިންމާ އެމީހުންގެ އަމިއްލައަށެވެ. އަޅުގަނޑުމެންގެ ކޮންޓްރޯލް ރަސީދުތައް އެ ކަސްޓަމަރުންނަށް އިންސާނީ ބެލެހެއްޓުން ދެއްކުމަށް ބޭނުންވާ އޮޑިޓް ޕާތް ދިނުމަށް ޑިޒައިން ކުރެވިފައިވެއެވެ، އެކަމަކު އެ ބެލެހެއްޓުން ފޯރުކޮށްދިނުމުގެ ޤާނޫނީ ވާޖިބު ކަސްޓަމަރަށް ބަރޯސާވެއެވެ.
		</p>
	</section>
}

templ privacyChangesDV() {
	<section id="changes">
		<h2>14. މި ސިޔާސަތުގެ ބަދަލުތައް</h2>
		<p>
			އަޅުގަނޑުމެންނަށް މި ސިޔާސަތު ފަހުރުފަހުރު އަޚާރު ކުރެވިދާނެއެވެ. ބޮޑެތި ބަދަލުތައް ހަރަކާތްތެރި ކަސްޓަމަރުންނަށް އީމެއިލުން އަދި މި ސަފްހާގައި ފެންނަ ބެނާރަކުން މަދުވެގެން 30 ދުވަހު އަންގަވެއެވެ. ބޮޑު ނޫން ބަދަލުތައް އައު "ފަހުން އަޚާރު ކުރެވުނު" ތާރީޚެއް އާއެކު ޝާއިޢުކުރެވެއެވެ.
		</p>
	</section>
}

templ privacyContactDV() {
	<section id="contact">
		<h2>15. އަޅުގަނޑުމެންނާ ގުޅުއްވާ</h2>
		<p>
			ޕްރައިވަސީގެ ސުވާލުތަކާއި ހައްގުތަކުގެ އެދުންތައް: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
		<p>
			Kiff Agents OÜ އަށް ރަސްމީ ޤާނޫނީ ނޯޓިސްތައް: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>، ނުވަތަ ޕޯސްޓުން Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, އެސްޓޯނިޔާއަށް.
