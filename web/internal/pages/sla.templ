package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// SLA renders the service-level agreement at /legal/sla, the one the
// Terms (§14) promise before any paid plan: the availability we commit
// to, how a slow or failed request counts, support response times, and
// the credits when we fall short. It applies to paid plans only.
//
// Keep it measurable and true to how the Service runs: no latency
// percentile we don't measure, and no exclusion for an outage of our own
// hosting. Keep public text free of private repository links and
// internal review notes.
templ SLA() {
	@components.LayoutSite("KIFF — service-level agreement", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@slaHead()
			@slaScope()
			@slaAvailability()
			@slaCredits()
			@slaExclusions()
			@slaSupport()
			@slaIncidents()
			@slaGeneral()
		</article>
	}
}

templ slaHead() {
	<header class="legal-head">
		<p class="legal-badge">Service-level agreement · v1</p>
		<h1>Service-Level Agreement</h1>
		<p class="legal-meta">
			<strong>Last updated:</strong> 22 October 2026.
		</p>
		<p class="legal-disclaimer">
			This agreement is part of the <a href="/terms">Terms of
			Service</a> (§14) between Kiff Agents OÜ and a Customer on a
			paid plan. Words defined in the Terms mean the same here.
			Questions: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</header>
}

templ slaScope() {
	<section id="scope">
		<h2>1. What it covers</h2>
		<p>
			It applies to accounts on Solo, Team or Company while their
			plan is paid. The trial, and any feature we call a preview,
			are offered as is, without it.
		</p>
		<p>
			The <strong>covered services</strong> are the ones that
			decide and send your agents' calls:
		</p>
		<ul>
			<li>KIFF's API, which decides each call against its Cards and records it;</li>
			<li>KIFF's gateway, through which your agents call your tools;</li>
			<li>planque, which keeps your tools' sign-ins and sends the calls KIFF allows;</li>
			<li>the tafs service the tafs app and your tafs run on.</li>
		</ul>
		<p>
			The websites, the dashboard, documentation and the tafs
			app's store listing aren't covered services.
		</p>
	</section>
}

templ slaAvailability() {
	<section id="availability">
		<h2>2. Availability</h2>
		<p>
			We commit to <strong>99.5% monthly availability</strong>
			for each covered service.
		</p>
		<p>
			A <strong>minute of downtime</strong> is a minute in which
			a covered service answers more than 5% of valid requests
			with a server error, or doesn't answer them. A request
			that gets no answer within 30 seconds counts as not
			answered. A refusal is an answer: a call KIFF refuses or
			holds under your Cards, or stops for a halt you set, is the
			service working.
		</p>
		<p>
			<strong>Monthly availability</strong> is the share of the
			calendar month's minutes (UTC) that weren't downtime. It is
			measured from our monitoring and from the request records
			you send us with a claim; where they differ, we look at
			both in good faith.
		</p>
	</section>
}

templ slaCredits() {
	<section id="credits">
		<h2>3. Service credits</h2>
		<p>
			If a covered service's monthly availability falls short,
			your account gets a credit on that month's plan fee (not on
			usage past what's included):
		</p>
		<div class="legal-table" tabindex="0">
			<table>
				<thead>
					<tr><th>Monthly availability</th><th>Credit</th></tr>
				</thead>
				<tbody>
					<tr><td>below 99.5%</td><td>10%</td></tr>
					<tr><td>below 99.0%</td><td>25%</td></tr>
					<tr><td>below 95.0%</td><td>50%</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			To claim, write to <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>
			within 30 days after the month ends, with your account and
			the times you saw downtime. We answer within 10 business
			days. A credit is applied to your next invoice; it isn't
			paid in cash, and a month's credits are at most 50% of that
			month's plan fee, whichever services fell short.
		</p>
		<p>
			Credits are your sole remedy for the availability this
			agreement commits to. They don't limit a remedy the law
			gives you that can't be limited.
		</p>
	</section>
}

templ slaExclusions() {
	<section id="exclusions">
		<h2>4. What isn't downtime</h2>
		<ul>
			<li>Maintenance we announce by email and on <a href="https://status.kiff.dev">status.kiff.dev</a> at least 48 hours before, up to 4 hours a month.</li>
			<li>An outage of your tool's own provider (for example Stripe), or of the AI model a taf uses, when the covered services are answering.</li>
			<li>Your own network, servers, devices or agents, or requests that break the Terms' acceptable use or the documented limits.</li>
			<li>A suspension under the Terms.</li>
			<li>Events outside our reasonable control under §17 of the Terms (force majeure). An outage at our hosting provider isn't one: it counts as downtime.</li>
		</ul>
	</section>
}

templ slaSupport() {
	<section id="support">
		<h2>5. Support</h2>
		<p>
			Write to <a href="mailto:hello@kiff.dev">hello@kiff.dev</a>
			from the email on your account. We send a first reply by a
			person within:
		</p>
		<ul>
			<li><strong>Solo:</strong> 2 business days;</li>
			<li><strong>Team</strong> (priority support): 1 business day;</li>
			<li><strong>Company:</strong> what its order form says.</li>
		</ul>
		<p>
			Business days are Monday to Friday, except Estonian public
			holidays. Security reports go to
			<a href="mailto:security@kiff.dev">security@kiff.dev</a>, as
			<a href="/security">/security</a> describes.
		</p>
	</section>
}

templ slaIncidents() {
	<section id="incidents">
		<h2>6. Incidents</h2>
		<p>
			Each covered service's state, incidents with their updates,
			announced maintenance and past incidents are on
			<a href="https://status.kiff.dev">status.kiff.dev</a>, which runs
			apart from the Service so it answers when the Service doesn't.
		</p>
		<p>
			If an incident causes more than 30 minutes of downtime, we
			email the owners of the accounts it affected while it lasts,
			and send them a summary of what happened and what we changed
			within 5 business days after it ends. A personal-data breach
			is notified as the <a href="/legal/dpa">DPA</a> says.
		</p>
	</section>
}

templ slaGeneral() {
	<section id="general">
		<h2>7. Changes</h2>
		<p>
			We may improve this agreement at any time. We give active
			paid accounts at least thirty days' written notice of a
			change that lowers a commitment, as §16 of the Terms says.
		</p>
	</section>
}
