package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// TermsET is the Terms of Service (/terms) in Estonian, at /et/terms. It is
// a translation of Terms: the same sections, anchors, links and figures,
// held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Estonian has the
// legal texts only, so a link to any other page goes to English and says
// so.
templ TermsET() {
	@components.LayoutSite("KIFF — kasutustingimused", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@termsHeadET()
			@termsDefinitionsET()
			@termsAgreementET()
			@termsServiceET()
			@termsTafsET()
			@termsAccountET()
			@termsAcceptableUseET()
			@termsCustomerDataET()
			@termsConfidentialityET()
			@termsFeesET()
			@termsTermET()
			@termsWarrantiesET()
			@termsDisclaimerET()
			@termsLiabilityET()
			@termsIndemnityET()
			@termsSLAET()
			@termsServiceModsET()
			@termsTermsModsET()
			@termsForceMajeureET()
			@termsGoverningLawET()
			@termsGeneralET()
			@termsContactET()
		</article>
	}
}

templ termsHeadET() {
	<header class="legal-head">
		<p class="legal-badge">Kasutustingimused · v0.1</p>
		<h1>Kasutustingimused</h1>
		<p class="legal-meta">
			<strong>Viimati uuendatud:</strong> 22. november 2026.
			<strong>Jõustumise kuupäev:</strong> 24. mai 2026.
		</p>
		<p class="legal-disclaimer">
			<strong>Mis muutus:</strong> kellega on teie leping, kui teid tutvustas mõni teine ettevõte (punkt 2), ja mikroettevõtjad (punkt 8). Varem: kes tohib Teenust kasutada, piirkonna, omandi ja sanktsioonide järgi (punkt 4); rakendus tafs Androidis ja
			Google Play kaudu ostetud Solo (punktid 1 ja 8). Veel varem: tasulised
			paketid (punktid 3A ja 8),
			<a href="/legal/sla">teenustaseme leping</a> (inglise keeles) punktis 14 ning
			keelatud kasutuste loetelu (punkt 5), mis on nüüd
			<a href="/acceptable-use">lubatud kasutuse põhimõtetes</a> (inglise keeles).
		</p>
		<p class="legal-disclaimer">
			Need tingimused reguleerivad KIFF Cloudi kasutamist, sealhulgas tafsi. Lepingulised
			küsimused:
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</header>
}

templ termsDefinitionsET() {
	<section id="definitions">
		<h2>1. Mõisted</h2>
		<ul>
			<li><strong>„Kiff Agents OÜ“</strong>, <strong>„meie“</strong>, <strong>„meid“</strong>, <strong>„meie oma“</strong> — Teenust pakkuv Eesti osaühing. Registrikood 17372313.</li>
			<li><strong>„Klient“</strong>, <strong>„teie“</strong>, <strong>„teie oma“</strong> — füüsiline või juriidiline isik, kes nõustub nende tingimustega.</li>
			<li><strong>„Kasutaja“</strong> — iga isik, keda Klient volitab Teenust Kliendi konto kaudu kasutama.</li>
			<li><strong>„Teenus“</strong> — toode KIFF Cloud, sealhulgas <code>api.kiff.dev</code>, <code>app.kiff.dev</code>, <code>kiff.dev</code>, tafs ning dokumentatsioon, töölauad ja API-d, mida me seal avaldame.</li>
			<li><strong>„tafs“</strong> — rakendus tafs iPhone'ile, iPadile, Androidile ja arvutitele (Mac, Windows ja Linux) ning selle taga olev teenus, sealhulgas Setup ja planque (punkt 3A), milles Klient annab töö AI-agendile, kes töötab KIFF Cardide piires. <strong>„Taf“</strong> on üks selline agent.</li>
			<li><strong>„Rentnik“</strong> — Teenuse sees loogiliselt eraldatud tööruum, mis kuulub ühele Kliendile.</li>
			<li><strong>„Auditiandmed“</strong> — sündmused, otsused, toimingud, kinnitused ja kviitungid, mida Teenus Kliendi nimel käituskeskkonna kaudu säilitab.</li>
			<li><strong>„tafsi andmed“</strong> — see, mida tafs Kliendi nimel hoiab: iga tafi käivitused ja vestlused (sealhulgas see, mida Kliendi ühendatud tööriistad sellele tagastavad), selle aruanded, selle mälumärkmed ning telefonid, mis on registreeritud selle teavituste jaoks.</li>
			<li><strong>„Kviitung“</strong> — allkirjastatud, versioonitud otsuse kirje, mille Teenus väljastab iga reguleeritud toimingu kohta.</li>
			<li><strong>„Dokumentatsioon“</strong> — Teenuse tehniline dokumentatsioon ja turvameetmed nendest tingimustest viidatud dateeritud versioonis (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>). See ei hõlma strateegilist valget raamatut, turundusmaterjale ega eraldi litsentsitud avatud lähtekoodiga raamistiku dokumentatsiooni.</li>
			<li><strong>„DPA“</strong> — andmetöötlusleping aadressil <a href="/legal/dpa">/legal/dpa</a> (inglise keeles), mis reguleerib meie suhet volitatud töötlejana.</li>
		</ul>
	</section>
}

templ termsAgreementET() {
	<section id="agreement">
		<h2>2. Leping</h2>
		<p>
			Need tingimused reguleerivad teie Teenuse kasutamist. Kui
			loote konto, genereerite API-võtme või kasutate Teenust muul
			viisil, nõustute nende tingimustega. Kui nõustute ettevõtte
			või muu juriidilise isiku nimel, kinnitate, et teil on õigus
			seda isikut siduda, ning „teie“ ja „teie oma“ tähendavad
			seda isikut.
		</p>
		<p>
			Kui teid tutvustas KIFFile arendaja, partner või muu ettevõte või kui see ehitas agendi, mida kasutate, on teie leping Teenuse kohta otse meiega, nende tingimuste alusel, ja te nõustute nendega ise. See ettevõte ei ole meie esindaja: see ei saa teie eest nende tingimustega nõustuda, nõusolekut anda ega makset kinnitada ning see ei müü Teenust meie nimel.
		</p>
		<p>
			Võime avaldada konkreetsete funktsioonide jaoks
			lisatingimusi (beetafunktsioonid, kolmandate osapoolte
			integratsioonid). Kui need on vastuolus nende tingimustega,
			kehtivad selle funktsiooni puhul lisatingimused.
		</p>
	</section>
}

templ termsServiceET() {
	<section id="service">
		<h2>3. Teenus</h2>
		<p>
			KIFF Cloud on majutatud teenus delegeeritud toimingute
			reguleerimiseks. See hindab päringuid Kliendi seadistatud
			õiguste ja Cardide alusel, võib nõuda inimese kinnitust ning
			salvestab reguleerimisotsused. Olenevalt seadistatud
			integratsioonist edastab KIFF lubatud päringu või annab loa,
			mida kaitstud süsteem kontrollib. Aluseks oleva toimingu
			teeb ühendatud süsteem.
		</p>
		<p>
			Kohaldatav tehniline käitumine, tõendid, integratsiooninõuded
			ja täitmise piirangud on määratud nendest tingimustest
			viidatud dateeritud Dokumentatsioonis. Strateegiline
			<a href="/whitepaper">valge raamat</a> (inglise keeles) selgitab KIFFi
			põhimõtteid ja mudelit; see ei ole nende tingimuste alusel
			osa tehnilisest Dokumentatsioonist.
		</p>
		<p>
			KIFF Cloudi reguleerimisteenus <em>ei ole</em> agendiraamistik,
			töövoomootor, mudelivärav ega hallatud agendiplatvorm. See
			sobib kokku kõigega, mida te juba kasutate. Täpne loetelu on
			avalehe jaotises <a href="/#not">„Mis KIFF ei ole“</a> (inglise keeles).
			tafs on Teenuse ainus osa, mis käitab agente teie eest, teie
			väljastatud Cardide piires; seda kirjeldab punkt 3A.
		</p>
		<p>
			Avatud lähtekoodiga raamistikku <a href="https://github.com/kiff/kiff" target="_blank" rel="noopener">kiff/kiff</a>
			reguleerib selle enda MIT-litsents ja see jääb nendest
			tingimustest välja. Kui käitate raamistikku oma taristul, ei
			teki lepingut Kiff Agents OÜ-ga.
		</p>
	</section>
}

templ termsTafsET() {
	<section id="tafs">
		<h2>3A. tafs</h2>
		<p>
			tafsis annate töö (näiteks tagasimaksed, arvete tasumine või
			kaardivaidlused) tafile: AI-agendile, mis töötab ajakava
			järgi teie ühendatud tööriistadega, nende KIFF Cardide
			piires, mille te talle väljastate. Iga taf töötab meie agendi
			käituskeskkonnas ja selle kasutatava AI-mudeli pakub
			Anthropic. Selle kinni peetud päringutele vastate rakenduses
			tafs.
		</p>
		<p>
			<strong>Tööriistade ühendamine.</strong> Setup, tafsi AI-agent,
			mis töötab nagu taf, aitab teil tööriista ühendada ja tafi
			töö jaoks seadistada. See ei ühenda ise midagi. Logite sisse
			tööriista enda pakkuja juures (näiteks Stripe) ning kinnitate
			oma seadmes iga ühenduse, tööriistad, mida taf tohib
			kasutada, ja selle Cardid. Sellest sisselogimisest saadud
			märki hoiab planque, meie ühendusteenus. See on krüpteeritud,
			seda kasutatakse ainult KIFFi otsustatud päringu tegemiseks
			ja seda ei anta kunagi tafile. Tööriista ühenduse
			katkestamine tühistab märgi pakkuja juures ja kustutab selle.
		</p>
		<p>
			<strong>Teie Cardid on teie juhised.</strong> Taf jõuab teie
			tööriistadeni ainult KIFFi kaudu, mis kontrollib iga päringut
			tafi Cardide alusel enne selle saatmist. Teie väljastatud
			Cardi piires tehtud päring tehakse teie juhisel. Cardist
			väljapoole jääv päring peetakse kinni või sellest keeldutakse,
			nagu Card ütleb. Kinni peetud päring tehakse alles siis, kui
			selle kinnitab keegi, kellel teie konto lubab kinni peetud
			päringutele vastata. Rakenduses tafs kannab vastus nende
			seadme allkirja, mida KIFF kontrollib, ja kviitung säilitab
			selle tõendi. Teie konto saab vastata ka KIFFis endas
			(töölaual, selle käsureatööriistas või seal volitatud
			kinnitaja kaudu); kviitung salvestab siis, kes vastas ja
			kuidas.
		</p>
		<p>
			<strong>Maksed.</strong> Kui taf maksab teie eest kassas kaardiga või muu maksevahendiga, mille olete sellel saidil salvestanud, teeb ta seda ainult Cardi sees ja pärast seda, kui olete selle makse oma telefonis heaks kiitnud. Teie heakskiit volitab teie nimel just seda ühte makset. Sait ja selle makseteenuse pakkuja töötlevad seda. KIFF ja planque ei hoia kunagi teie raha, ei salvesta kunagi teie kaardiandmeid ja taf ei sisesta kunagi kaardinumbrit.
		</p>
		<p>
			<strong>Mis jääb teile.</strong> Teie valite iga tafi töö ja
			Cardid, vastate selle kinni peetud päringutele ning tagate,
			et teil on õigus kasutada ühendatud tööriistu ja kontosid.
			Tafi aruanded, sõnumid ja mälumärkmed kirjutab AI-mudel ja
			need võivad olla valed; kontrollige olulist enne, kui sellele
			tuginete.
		</p>
		<p>
			<strong>Tafi peatamine.</strong> Võite peatada ühe tafi või
			kõik, panna tafi pausile, tühistada mis tahes selle Cardi või
			tafi eemaldada. Hetkest, mil tafi peatate või Cardi
			tühistate, ei luba KIFF selle alusel ühtegi uut päringut.
			Rakendus tafs näitab tafi peatatuna alles siis, kui nii KIFF
			kui ka planque on peatamise kinnitanud; sellest hetkest ei
			saada planque ühtegi selle päringut, sealhulgas ka seda,
			mille KIFF lubas vahetult enne. Tööriista pakkujale juba
			saadetud päring võib siiski lõpule jõuda: me peatame uued
			päringud, kuid ei saa tagasi võtta seda, mida pakkuja on
			teinud. Tööriist, mis kontrollib KIFFi lube ise, ilma
			planque'ita, võib vahetult enne väljastatud KIFFi loa siiski
			vastu võtta, kõige rohkem 90 sekundi jooksul. Peatatud tafi
			jätkamine nõuab teie kinnitust teie seadmes ning midagi, mis
			oli enne peatamist kinni peetud või järjekorras, ei käivitu
			pärast seda.
		</p>
		<p>
			<strong>Tafi eemaldamine</strong> peatab selle
			ajakava ning kustutab selle käivitused, vestlused, mälu ja
			võtme, mida see kasutas. Juba enne seda hoitakse seda, mida
			teie tööriistad tafile tagastavad, ainult selle käivituse
			lõpuni (seda, mida vestlus ainult luges, krüpteeritult
			järgmiste sõnumite jaoks: kasutatakse kõige rohkem neli tundi,
			seejärel kustutatakse) ning selle käivitusi ja vestlusi 30 päeva. KIFF hoiab kviitungeid selle kohta, mida see tegi.
		</p>
		<p>
			<strong>ELi tehisintellekti määrus.</strong> tafsi puhul on
			Kiff Agents OÜ AI-süsteemi pakkuja ja teie selle juurutaja.
			Tagame, et kõik, mida taf kirjutab kellelegi väljaspool teie
			ettevõtet, ütleb, et selle kirjutas AI-agent. Kasutate tafsi
			ainult tööde jaoks, mida see pakub, ja mitte ühelgi viisil,
			mille tehisintellekti määrus keelab või liigitab suure riskiga
			kasutuseks, näiteks otsusteks inimese töösuhte, krediidi või
			oluliste teenuste kättesaadavuse kohta. Säilitate
			inimkinnitused, mida teie Cardid nõuavad, ja tagate, et
			inimesed, kes tafsi teie eest kasutavad, mõistavad, mida see
			teeb ja millised on selle piirid.
		</p>
		<p>
			<strong>Kulud.</strong> tafs on osa teie KIFFi paketist
			(punkt 8): iga tafi käivitus kasutab krediite selle AI eest,
			mida see kasutas. Coach ja tafide seadistamine sisalduvad
			Coachi mõistliku kasutuse piires.
		</p>
	</section>
}

templ termsAccountET() {
	<section id="account">
		<h2>4. Kontod ja juurdepääs</h2>
		<p>
			Teenuse kasutamiseks peate looma konto. Nõustute andma õiget
			registreerimisteavet, hoidma oma sisselogimisandmed salajas
			ja vastutama kogu oma konto all toimuva tegevuse eest.
		</p>
		<p>
			Peate olema vähemalt 16-aastane või vähemalt oma
			jurisdiktsiooni digitaalse nõusoleku vanuses, olenevalt
			sellest, kumb on kõrgem. Teenus ei ole suunatud lastele.
		</p>
		<p>
			Teenust pakutakse ainult riikides ja piirkondades, kus Anthropic, kes pakub selle AI-mudelit, pakub oma teenust, nagu <a href="https://www.anthropic.com/supported-countries">Anthropic need loetleb</a>. Mujalt ei tohi te seda kasutada. Ettevõte ei tohi seda kasutada, kui selle peakontor on väljaspool seda loendit olevas riigis või piirkonnas või kui see on sellise ettevõtte enamusomanduses või kontrolli all, mille peakontor on väljaspool seda loendit olevas riigis või piirkonnas, olenemata sellest, kus on selle kasutajad. Samuti ei tohi te seda kasutada, kui teie või ettevõtte suhtes, mille jaoks te seda kasutate, kehtivad Euroopa Liidu, Ühinenud Rahvaste Organisatsiooni või Ameerika Ühendriikide sanktsioonid. Keeldume kontodest, mis seda reeglit rikuvad, ja võime peatada konto, mis seda rikub.
		</p>
		<p>
			Vastutate iga Kasutaja tegevuse eest, keda oma kontol
			volitate. Võime konto peatada või juurdepääsu tühistada
			mõistliku etteteatamisega, kui avastame nende tingimuste
			usaldusväärse rikkumise. Lubatud kasutuse rikkumiste korral
			(vt punkt 5) võib peatamine olla kohene.
		</p>
	</section>
}

templ termsAcceptableUseET() {
	<section id="acceptable-use">
		<h2>5. Lubatud kasutus</h2>
		<p>
			Teie, teie kasutajad ja teie agendid peavad järgima
			<a href="/acceptable-use">lubatud kasutuse põhimõtteid</a> (inglise keeles). Need
			on osa nendest tingimustest ja loetlevad, milleks Teenust
			kasutada ei tohi.
		</p>
		<p>
			Lubatud kasutuse põhimõtete usaldusväärse rikkumise korral
			võime kasutuse kohe peatada. Meil ei ole kohustust Kliendi
			sisu jälgida, kuid võime usaldusväärsete teadete põhjal
			tegutseda.
		</p>
	</section>
}

templ termsCustomerDataET() {
	<section id="customer-data">
		<h2>6. Kliendi andmed ja sisu</h2>
		<p>
			Teile kuuluvad teie Auditiandmed. Annate Kiff Agents OÜ-le
			piiratud, mitteainuõigusliku, tasuta, ülemaailmse litsentsi
			teie Auditiandmete majutamiseks, kopeerimiseks, edastamiseks,
			kuvamiseks ja muul viisil töötlemiseks ainult niivõrd,
			kuivõrd see on vajalik Teenuse käitamiseks, hooldamiseks ja
			täiustamiseks teie jaoks.
		</p>
		<p>
			Tegutseme teie Auditiandmete ja teie tafsi andmete
			<strong>volitatud töötlejana</strong> GDPR-i artikli 28
			alusel; seda suhet reguleerib üksikasjalikult
			<a href="/legal/dpa">DPA</a> (inglise keeles). Teie konto metaandmete puhul
			tegutseme <strong>vastutava töötlejana</strong>; seda suhet
			reguleerib
			<a href="/et/privacy">privaatsuspoliitika</a>.
		</p>
		<p>
			Kinnitate, et teil on kõik õigused esitatavate andmete
			esitamiseks ja et esitamine vastab kohaldatavatele
			õigusaktidele (sealhulgas andmekaitseõigusele ja, kui see on
			kohaldatav, ELi tehisintellekti määrusele).
		</p>
	</section>
}

templ termsConfidentialityET() {
	<section id="confidentiality">
		<h2>7. Konfidentsiaalsus</h2>
		<p>
			Kumbki pool võib saada teiselt avalikustamata teavet
			(„Konfidentsiaalne teave“). Vastuvõttev pool kasutab
			Konfidentsiaalset teavet ainult niivõrd, kuivõrd see on
			vajalik oma kohustuste täitmiseks ja oma õiguste
			kasutamiseks nende tingimuste alusel, ning kaitseb seda
			vähemalt sama hoolega, mida ta kasutab oma konfidentsiaalse
			teabe puhul.
		</p>
		<p>
			Konfidentsiaalne teave ei hõlma teavet, mis (a) on või
			muutub avalikult kättesaadavaks ilma rikkumiseta, (b) oli
			vastuvõtvale poolele teada enne avalikustamist, (c) on välja
			töötatud iseseisvalt ilma Konfidentsiaalset teavet
			kasutamata või (d) tuleb seaduse alusel avalikustada
			(teisele poolele teatades, kui see on lubatud).
		</p>
	</section>
}

templ termsFeesET() {
	<section id="fees">
		<h2>8. Tasud ja maksmine</h2>
		<p>
			<strong>Paketid.</strong> Igal kontol on üks pakett. Kehtivad
			hinnad on <a href="/pricing">hinnalehel</a> (inglise keeles); selle
			uuenduse ajal:
		</p>
		<ul>
			<li><strong>Solo:</strong> üks inimene, tafsi jaoks, müüakse rakenduses tafs App Store'i või Google Play kaudu hinnaga 12,50 € kuus, käibemaks sisaldub, ja sellesse kuulub 500 krediiti kuus.</li>
			<li><strong>Company:</strong> 10,50 € kuus iga istekoha eest, 500 krediiti kuus iga istekoha kohta, ühiselt kasutatavana, ning teie enda agentide päringute jaoks KIFF Cloudi kaudu 500 toimingut kuus iga istekoha kohta, ühiselt kasutatavana.</li>
			<li><strong>Leping:</strong> tasud ja tingimused selle tellimusvormis.</li>
		</ul>
		<p>
			Istekohad on konto administraatorid ja toimetajad. Kinnitajad
			ja vaatajad on kõigis pakettides tasuta. Company paketis
			maksab paketti kuuluvast üle jääv krediit 0,01 € ja toiming
			0,02 €. Paketti kuuluvatest üle jäävad krediidid arveldatakse
			kuni konto määratud igakuise kululimiidini (alguses 50 €):
			limiidi täitumisel ei käivita KIFF konto tafide uusi
			käivitusi enne järgmise perioodi algust või seni, kuni
			arveldust haldav isik limiiti tõstab.
		</p>
		<p>
			<strong>Krediidipaketid.</strong> Solo puhul tulevad kuu
			sisalduvatest krediitidest üle jäävad krediidid
			krediidipakettidest, mis ostetakse rakenduses tafs.
			Krediidipakett ostetakse üks kord, see ei aegu ega ole
			tellimus; selle krediite kasutatakse pärast kuu sisalduvaid
			krediite, vanim krediidipakett esimesena. Krediidipakett,
			mille makse tagastatakse täielikult, võetakse tagasi koos
			selle järelejäänud krediitidega. Kui kuu krediidid ja
			krediidipaketid on kasutatud, ei käivita KIFF konto tafide
			uusi käivitusi enne järgmise perioodi algust või
			krediidipaketi lisamist. Boonuskrediidid, mille KIFF kontole
			lisab, samuti ei aegu, nagu krediidipaketid.
		</p>
		<p>
			<strong>Mida arvestatakse.</strong> <em>Krediit</em> maksab
			selle AI eest, mida tafi käivitus kasutas, täiskrediitides,
			ümardatuna üles üks kord käivituse kohta ja arvestatuna üks
			kord, kui käivitus lõpeb. Käivitus, mille päringust KIFF
			keeldus, kasutas siiski oma AI-d. Kunagi ei arvestata:
			Coachi ja tafide seadistamist Coachi mõistliku kasutuse
			piires; uue versiooni proovi, mis ei saada midagi; ja
			käivitust, mis ebaõnnestus meie poolel. <em>Toiming</em> on
			teie enda agendi päring KIFF Cloudi kaudu, millega midagi
			tehti: KIFF lubas selle, see saadeti ja tööriist teatas
			õnnestumisest. Kunagi ei arvestata toiminguna: päringut,
			millest keelduti, mis peeti kinni ja millest seejärel
			keelduti, mis peatati peatamisega, mis oli kehtetu, mis
			ebaõnnestus tööriista juures või mille tulemus on teadmata,
			ega päringut, mis ainult loeb.
		</p>
		<p>
			<strong>Prooviperioodi ei ole.</strong> Konto maksab oma
			esimesest päevast. Enne paketi algust ei käivita KIFF ühtegi
			selle tafide käivitust, välja arvatud Coachi seadistamine;
			midagi ei kustutata.
		</p>
		<p>
			<strong>Makse ja arved.</strong> Paketti arveldatakse ühes
			kohas. kiff.dev-is ostetud paketti ostetakse, muudetakse ja
			tühistatakse seal ning arveldusportaalis, millele see viitab,
			ning selle makseid töötleb Stripe. Rakenduses tafs ostetud
			Solot müüakse App Store'i kaudu iPhone'is ja iPadis või
			Google Play kaudu Androidis ning seda hallatakse teie Apple'i
			tellimustes või Google Play tellimustes, selle poe makse-,
			uuendamis- ja tagasimaksetingimuste alusel. Krediidipaketid
			ostetakse rakenduses. Company ostetakse kiff.dev-is. Tasud
			arveldatakse igakuiselt ette;
			paketti kuuluvast üle jääv kasutus arveldatakse järgmise
			arvega. Inimeste arvu muutus kehtib järgmisest arvest. Kui
			makse ebaõnnestub ja seda ei tasuta, pakett lõpeb ja KIFF
			keeldub konto päringutest, kuni pakett on valitud.
		</p>
		<p>
			<strong>Tühistamine.</strong> Võite igal ajal tühistada
			arveldusportaalis või, rakenduses ostetud Solo puhul, oma
			Apple'i tellimustes või Google Play tellimustes. Pakett kehtib makstud
			perioodi lõpuni ja seda ei uuendata. Välja arvatud seadusega
			nõutud juhtudel, juba makstud tasusid ei tagastata. Kui olete
			ELi tarbija, võite ostust taganeda 14 päeva jooksul põhjust
			esitamata ning me tagastame makstud summa, millest on maha
			arvatud osa nende päevade eest, mil pakett juba kehtis.
			Solo ostude eest tehakse tagasimaksed App Store'i või Google Play kaudu, nende tingimuste alusel.
		</p>
		<p>
			<strong>Mikroettevõtjad.</strong> Kui teie ettevõttes on vähem kui 10 inimest ja selle aastakäive või bilansimaht on kuni 2 miljonit eurot, käsitleme seda tarbijana kõigi nende tingimuste reeglite puhul, mis puudutavad kaardiga tehtud makseid, sealhulgas Company puhul.
		</p>
		<p>
			<strong>Käibemaks.</strong> Company hinnad ei sisalda
			käibemaksu; Solot ja krediidipakette müüvad App Store või
			Google Play käibemaksuga. Kiff Agents OÜ
			(käibemaksukohustuslase number EE102924327) lisab Eesti
			käibemaksu, kui see on kohaldatav. ELi-sisesed ettevõttelt
			ettevõttele müügid Kliendile väljaspool Eestit, kellel on
			kehtiv käibemaksukohustuslase number, arveldatakse ELi
			pöördmaksustamise korra alusel.
		</p>
		<p>
			<strong>Muudatused.</strong> Teatame aktiivsetele kontodele
			hinnatõusust kirjalikult vähemalt kolmkümmend päeva ette
			(punkt 16). Hinnalangus kehtib järgmisest arvest.
		</p>
	</section>
}

templ termsTermET() {
	<section id="term">
		<h2>9. Kehtivus ja lõpetamine</h2>
		<p>
			Need tingimused jõustuvad, kui kasutate Teenust esimest
			korda, ja kehtivad kuni lõpetamiseni.
		</p>
		<p>
			Võite igal ajal lõpetada, kustutades oma konto. Meie võime
			lõpetada (a) olulise rikkumise korral, mida ei ole kõrvaldatud
			kolmekümne päeva jooksul pärast kirjalikku teatamist, või (b)
			kohe lubatud kasutuse rikkumise või maksejõuetusega seotud
			sündmuste korral.
		</p>
		<p id="leaving">
			<strong>Lahkumine ja oma andmete kaasavõtmine.</strong>
			Võite oma andmed igal ajal eksportida struktureeritud,
			masinloetavas vormingus: KIFFis annab Settings → Data
			JSON-faili teie konto, teie Cardide koos iga versiooniga,
			teie Logi otsustega (viimased 10 000; rohkema saamiseks
			küsige meilt), iga KIFFi lubatud otsuse allkirjastatud
			kviitungiga ning teie API-võtmete andmetega (mitte kunagi
			võtmete endiga). Rakenduses tafs ekspordib iga inimene oma
			vestlused, failid ja märkmed vaatest Konto → Ekspordi minu
			vestlused; vestlusi hoitakse igal juhul kolmkümmend päeva,
			nagu ütleb privaatsuspoliitika. Konto kustutamine lõpetab
			Teenuse kohe, seega eksportige enne.
		</p>
		<p>
			Võite selle asemel lahkuda etteteatamisega, et minna üle
			teisele pakkujale või oma süsteemidele, kirjutades aadressil
			<a href="mailto:support@kiff.dev">support@kiff.dev</a>.
			Me ei nõua kunagi rohkem kui kahe kuu pikkust etteteatamist:
			teie teade jõustub teie valitud kuupäeval, mitte hiljem kui
			kaks kuud pärast selle saatmist. Sellest kuupäevast järgneb
			kolmekümnepäevane üleminekuperiood, mille jooksul Teenus
			töötab edasi, te ekspordite oma andmed ja viite oma töö üle
			ning me aitame mõistlike taotlustega, mis seda puudutavad.
			Võite üleminekuperioodi üks kord pikendada, nii kauaks, kui
			vajate. Kui me ei saa seda tehniliselt kolmekümne päeva
			jooksul lõpule viia, teatame teile neljateistkümne tööpäeva
			jooksul pärast teie teadet, koos põhjuste ja uue, kuni
			seitsmekuulise perioodiga. Pärast üleminekuperioodi jäävad
			teie andmed eksportimiseks kättesaadavaks veel vähemalt
			kolmkümmend päeva. Paketi tasud jätkuvad tavapäraselt kuni
			üleminekuperioodi lõpuni. App Store'is või Google Plays
			ostetud Solo tühistatakse poes; ülemineku- ja
			ekspordiperioodid kehtivad samamoodi.
		</p>
		<p>
			Me ei võta tasu lahkumise, üleminemise ega teie andmete
			eksportimise eest. See punkt annab kõigile klientidele ELi
			andmemääruse (määrus (EL) 2023/2854) VI peatüki kohased
			üleminekuõigused.
		</p>
		<p>
			Lõpetamisel ning pärast võimalikku ülemineku- ja
			ekspordiperioodi kustutame teie Auditiandmed, teie tafsi
			andmed ja konto metaandmed kooskõlas
			<a href="/et/privacy#retention">privaatsuspoliitika</a> säilitamisreeglitega.
		</p>
		<p>
			Punktid, mis oma olemuselt peaksid lõpetamise järel kehtima
			jääma, jäävad kehtima — sealhulgas konfidentsiaalsus,
			intellektuaalomand, kahju hüvitamine, vastutuse piiramine,
			lahtiütlemised, kohaldatav õigus ja kõik tekkinud tasud.
		</p>
	</section>
}

templ termsWarrantiesET() {
	<section id="warranties">
		<h2>10. Garantiid</h2>
		<p>
			Kumbki pool kinnitab, et tal on õigus ja volitus nende
			tingimustega nõustuda ja neid täita.
		</p>
		<p>
			Garanteerime, et osutame Teenust professionaalselt ja
			Dokumentatsiooniga sisuliselt kooskõlas. Teie ainus
			õiguskaitsevahend selle garantii rikkumise korral on meie
			valikul teenuse uuesti osutamine või mõjutatud Teenusega
			seotud tasude proportsionaalne tagastamine rikkumise perioodi
			eest.
		</p>
		<p>
			Garanteerite, et teie Teenuse kasutamine vastab kohaldatavale
			õigusele ja nendele tingimustele.
		</p>
	</section>
}

templ termsDisclaimerET() {
	<section id="disclaimer">
		<h2>11. Lahtiütlemine</h2>
		<p>
			Välja arvatud punktis 10 sõnaselgelt toodud garantiid,
			pakutakse Teenust <strong>„nagu on“ ja „nagu saadaval“</strong>.
			Seadusega lubatud maksimaalses ulatuses ütleme lahti kõigist
			muudest garantiidest, olgu sõnaselgetest, kaudsetest või
			seadusjärgsetest, sealhulgas turustatavuse, konkreetseks
			otstarbeks sobivuse ja õiguste mitterikkumise garantiidest
			ning mis tahes garantiist, mis tuleneb tehingutavast või
			kaubandustavast.
		</p>
		<p>
			Me ei garanteeri, et Teenus on katkestusteta, vigadeta või
			kahjulike komponentideta või et andmeid ei kaotata ega
			rikuta. Teie vastutate oma andmete varundamise eest.
		</p>
	</section>
}

templ termsLiabilityET() {
	<section id="liability">
		<h2>12. Vastutuse piiramine</h2>
		<p>
			Seadusega lubatud maksimaalses ulatuses ei vastuta kumbki
			pool teise ees mis tahes kaudse, juhusliku, järgneva,
			erilise, eeskujuliku või karistusliku kahju eest, sealhulgas
			saamata jäänud kasumi, saamata jäänud tulu, kaotatud andmete
			või äritegevuse katkemise eest, mis tuleneb nendest
			tingimustest või Teenusest või on nendega seotud, isegi kui
			teda on sellise kahju võimalikkusest teavitatud.
		</p>
		<p>
			Kummagi poole kogu vastutus, mis tuleneb nendest tingimustest
			või on nendega seotud, ei ületa suuremat järgmistest:
			(a) tasud, mille Klient maksis või peab maksma Kiff
			Agents OÜ-le vastutuse aluseks olevale sündmusele
			eelnenud kaheteistkümne kuu jooksul, või (b) ükssada
			tuhat eurot (100 000 €).
		</p>
		<p>
			Miski nendes tingimustes ei piira ega välista vastutust, mida
			kohaldatava õiguse alusel ei saa piirata ega välistada,
			sealhulgas vastutust surma, hooletusest põhjustatud
			kehavigastuse, pettuse või tahtliku üleastumise eest ning
			vastutust puudusega toote eest õigusaktide alusel, millega
			rakendatakse direktiivi (EL) 2024/2853 puudusega toodete eest
			vastutuse kohta.
		</p>
	</section>
}

templ termsIndemnityET() {
	<section id="indemnification">
		<h2>13. Kahju hüvitamine</h2>
		<p>
			Kaitseme teid kolmandate isikute nõuete eest, mille kohaselt
			meie pakutud ja teie poolt nende tingimuste kohaselt
			kasutatud Teenus rikub selle kolmanda isiku
			intellektuaalomandi õigusi, ning maksame teie vastu sellistes
			nõuetes lõplikult välja mõistetud kahjuhüvitise (või
			kokkulepitud kompromissisumma).
		</p>
		<p>
			Teie kaitsete meid kolmandate isikute nõuete eest, mis
			tulenevad (a) teie Kliendi andmetest või sisust; (b) teie
			Teenuse kasutamisest nende tingimuste (sealhulgas lubatud
			kasutuse põhimõtete) rikkumisega; või (c) teie raskest
			hooletusest või tahtlikust üleastumisest, ning maksate meie
			vastu sellistes nõuetes lõplikult välja mõistetud
			kahjuhüvitise (või kokkulepitud kompromissisumma).
		</p>
		<p>
			Kahju hüvitamise eeldused on nõudest viivitamatu teatamine,
			hüvitaja ainukontroll kaitse ja kompromissi üle ning
			hüvitatava mõistlik koostöö. Hüvitaja ei tohi ilma
			nõusolekuta sõlmida kompromissi, mis paneb hüvitatavale
			kohustusi.
		</p>
	</section>
}

templ termsSLAET() {
	<section id="sla">
		<h2>14. Teenustaseme kohustus</h2>
		<p>
			Tasulise paketi puhul määrab <a href="/legal/sla">teenustaseme
			leping</a> (inglise keeles) kättesaadavuse, mida lubame, kuidas aeglast või
			ebaõnnestunud päringut arvestatakse, meie toe
			reageerimisajad ning teenuskrediidid, kui me lubadusest maha
			jääme. See on osa nendest tingimustest.
		</p>
		<p>
			Tööpraktikad, intsidentidele reageerimine ja rikkumistest
			teatamise kohustused on dokumenteeritud nendest tingimustest
			viidatud dateeritud versioonis
			(<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>);
			leht <a href="/security">/security</a> (inglise keeles) näitab kehtivaid
			praktikaid.
		</p>
	</section>
}

templ termsServiceModsET() {
	<section id="service-mods">
		<h2>15. Teenuse muudatused</h2>
		<p>
			Võime igal ajal funktsioone lisada, muuta või eemaldada.
			Funktsionaalsuse olulisest vähendamisest või API-pinna
			kasutuselt kõrvaldamisest, mis rikub dokumenteeritud
			käitumist, teatatakse aktiivsetele klientidele vähemalt
			kolmkümmend päeva ette koos avaldatud kõrvaldamise
			ajakavaga. Turvalisusest tingitud muudatusi võib teha ilma
			etteteatamiseta, kui etteteatamine ise tekitaks riski.
		</p>
	</section>
}

templ termsTermsModsET() {
	<section id="terms-mods">
		<h2>16. Nende tingimuste muudatused</h2>
		<p>
			Võime neid tingimusi aeg-ajalt muuta. Olulistest muudatustest
			teatatakse e-posti teel ja selgelt nähtava teatega sellel
			lehel vähemalt kolmkümmend päeva ette. Ebaolulised muudatused
			(täpsustused, viited) avaldatakse uue „viimati uuendatud“
			kuupäevaga. Teenuse jätkuv kasutamine pärast uuenduse
			jõustumiskuupäeva tähendab nõustumist.
		</p>
	</section>
}

templ termsForceMajeureET() {
	<section id="force-majeure">
		<h2>17. Vääramatu jõud</h2>
		<p>
			Kumbki pool ei vastuta kohustuste täitmata jätmise või
			viivituse eest ulatuses, milles selle põhjustasid tema
			mõistliku kontrolli alt väljas olevad asjaolud, sealhulgas
			loodusõnnetused, sõda, terrorism, rahutused, töötülid,
			tulekahju, looduskatastroof, pandeemiaga seotud valitsuse
			meetmed, interneti- või elektrikatkestused või
			telekommunikatsioonipakkujate või kolmandate osapoolte
			majutustaristu tegevus.
		</p>
	</section>
}

templ termsGoverningLawET() {
	<section id="governing-law">
		<h2>18. Kohaldatav õigus ja kohtualluvus</h2>
		<p>
			Nendele tingimustele kohaldatakse Eesti Vabariigi õigust,
			arvestamata selle kollisiooninorme. Vaidluste ainupädev kohus
			on Harju Maakohus Tallinnas.
		</p>
		<p>
			Kui olete tarbija, kelle elukoht on mõnes teises ELi
			liikmesriigis, kehtivad endiselt teie koduriigi kohustuslikud
			tarbijakaitse-eeskirjad ulatuses, milles need annavad teile
			õigusi, millest te ei saa lepinguga loobuda; see säte ei võta
			teilt nende eeskirjade kaitset.
		</p>
	</section>
}

templ termsGeneralET() {
	<section id="general">
		<h2>19. Üldsätted</h2>
		<p>
			<strong>Kogu leping.</strong> Need tingimused koos
			privaatsuspoliitika, DPA, võimalike tellimusvormide ja
			sõnaselgelt lisatud lisatingimustega moodustavad meievahelise
			kogu lepingu nende reguleerimisesemes ja asendavad kõik
			varasemad või samaaegsed kokkulepped.
		</p>
		<p>
			<strong>Sätete eraldatavus.</strong> Kui mõni säte tunnistatakse
			jõustamatuks, jäävad ülejäänud kehtima.
		</p>
		<p>
			<strong>Loovutamine.</strong> Te ei tohi neid tingimusi ilma
			meie kirjaliku nõusolekuta loovutada. Meie võime loovutada
			ilma nõusolekuta seoses ühinemise, omandamise või kogu või
			sisuliselt kogu meie vara müügiga, teile teatades.
		</p>
		<p>
			<strong>Loobumise puudumine.</strong> Sätte jõustamata jätmine
			ei tähenda loobumist õigusest seda hiljem jõustada.
		</p>
		<p>
			<strong>Teated.</strong> Teated Kiff Agents OÜ-le saadetakse
			aadressil
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>
			või posti teel aadressil Tööstuse tn 75-71, Põhja-Tallinna
			linnaosa, Tallinn 10416, Eesti. Teated teile saadetakse teie
			kontoga seotud e-posti aadressile või, kui olete selle
			esitanud, teie määratud õiguslike teadete aadressile.
		</p>
		<p>
			<strong>Sõltumatud lepingupooled.</strong> Miski nendes
			tingimustes ei loo seltsingut, esindust, ühisettevõtet ega
			töösuhet.
		</p>
		<p>
			<strong>Kolmandatest isikutest soodustatud isikud.</strong>
			Neid ei ole, välja arvatud ulatuses, milles hüvitatavad
			sidusettevõtjad on sõnaselgelt nimetatud.
		</p>
	</section>
}

