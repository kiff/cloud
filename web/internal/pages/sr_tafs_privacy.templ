package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsPrivacySR is tafs's privacy policy (/tafs/privacy) in Serbian, at /sr/tafs/privacy.
// It is a translation of TafsPrivacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Serbian has the legal
// texts only, so a link to any other page goes to English and says so.
templ TafsPrivacySR() {
	@components.LayoutSiteWithMeta("tafs politika privatnosti", "Kako tafs, KIFF-ova aplikacija, postupa sa podacima o ličnosti, uključujući podatke koje dobija od Google-a kada povežete svoj Google nalog.", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · politika privatnosti</p>
				<h1>Politika privatnosti tafs</h1>
				<p class="legal-meta"><strong>Poslednje ažuriranje:</strong> 28. novembar 2026.</p>
				<p class="legal-disclaimer">Ova politika objašnjava kako tafs, KIFF-ova aplikacija za iPhone, iPad, Android i računare, postupa sa podacima o ličnosti. tafs je deo KIFF Cloud-a, pa se i <a href="/sr/privacy">KIFF-ova Politika privatnosti</a> primenjuje na njega, i na sve što ova stranica ne pokriva. Pitanja: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.</p>
			</header>
			<section id="who-we-are">
				<h2>1. Ko smo mi</h2>
				<p>tafs pruža <strong>Kiff Agents OÜ</strong>, privatno društvo sa ograničenom odgovornošću osnovano u Estoniji (matični broj 17372313, PDV broj EE102924327), na adresi Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estonija. Opšta uredba EU o zaštiti podataka (GDPR) primenjuje se na našu obradu.</p>
			</section>
			<section id="scope">
				<h2>2. Šta ova politika obuhvata</h2>
				<p>Aplikaciju tafs za iPhone, iPad, Android i računare (Mac, Windows i Linux) i uslugu iza nje, uključujući Setup, koji povezuje alate kompanije, i planque, koji čuva te veze. U tafs kompanija poverava posao AI agentu, taf-u, koji radi unutar KIFF Card-ova.</p>
			</section>
			<section id="roles">
				<h2>3. Naše uloge</h2>
				<p>Mi smo <strong>rukovalac</strong> podataka vašeg naloga i prijave i operativnih podataka naše usluge. Delujemo kao <strong>obrađivač</strong>, u ime vaše kompanije, onoga što tafs čuva za nju: izvršavanja, razgovora, izveštaja, beleški iz memorije svakog taf-a i datoteka koje isporučuju. Vaša kompanija je rukovalac tim podacima, a <a href="/legal/dpa">DPA</a> (na engleskom) uređuje taj odnos.</p>
			</section>
			<section id="data">
				<h2>4. Šta tafs prikuplja</h2>
				<ul>
					<li><strong>Vaš nalog:</strong> u tafs se prijavljujete svojim KIFF nalogom. Na telefonu ili tabletu aplikacija čuva vašu sesiju u Keychain-u uređaja (na Androidu u njegovom šifrovanom skladištu). Na računaru je čuva zapečaćenu za vaš korisnički nalog: na Windows računaru uz Windows-ovu zaštitu podataka, na Linuxu u vašem keyring-u, na Mac-u u njegovom Keychain-u. Sesija na računaru traje do 90 dana.</li>
					<li><strong>Vaš uređaj:</strong> aplikacija pravi ključ za potpisivanje koji nikada ne napušta uređaj: u Secure Enclave-u iPhone-a, iPad-a ili Mac-a, u Keystore-u Android uređaja ili u TPM-u Windows računara. Na Linuxu i na Mac-u bez Secure Enclave-a ključ je softverski ključ koji se čuva u vašem keyring-u ili Keychain-u, a taj računar može da prikaže šta vas čeka, ali ne i da to odobri; odobravate na telefonu{ macSecurityKey("sr") }. Windows računar bez TPM-a ne može da se prijavi u tafs. KIFF čuva javni deo ključa, ime i platformu uređaja i kada je dodat i poslednji put korišćen, kako bi mogao da proveri vaše odgovore na zadržane pozive i vaša odobrenja veza.</li>
					<li><strong>Vaš sat:</strong> sat ne čuva lozinku ni ključ, razgovara samo sa vašim uparenim telefonom i nikada ne odobrava. Ono što kažete šalje Coach-u, ili taf-u koji ste izabrali, samo kao tekst, preko telefona, pošto ste dozvolili AI. Sopstvena usluga govora na satu, Apple-ova ili Google-ova, pretvara vaše reči u taj tekst. Na Wear OS-u, ako se zaustavi pre nego što završite, to umesto nje radi sopstveni prepoznavač na telefonu. Sat može da odbije, zaustavi ili pošalje Coach-u ili taf-u samo dok ima zaključavanje ekrana ili šifru i dok je otključan. Ono što pošaljete taf-u ide u sopstveni razgovor tog taf-a, kao da ste to napisali na telefonu. Razgovor taf-a, uključujući iznose, čita se preko telefona svaki put kad se otvori, a sat čuva samo nedavne poruke koje opisuje njegov odeljak ispod. Kada su aplikacije zatvorene, telefon prosleđuje nove odgovore i poruke satu preko sopstvene veze sistema između telefona i sata (Appleove na Apple Watch-u, veze usluga Google Play na Wear OS-u), koja ih na telefonu i satu čuva samo dok ih sat ne preuzme; obaveštenje koje budi vaš telefon ne nosi reči. Odgovor koji stigne dok ne gledate sat prikazuje se i kao obaveštenje, na vašem iPhone-u i Apple Watch-u ili na vašem satu sa Wear OS-om, sa svojim rečima, ali nikada sa iznosom, i ostaje dok ga ne odbacite; zaključan sat sa Wear OS-om pokazuje samo da je odgovor spreman.</li>
					<li><strong>Apple Watch:</strong> prikazuje vaše tafs i njihove stranice bez čuvanja. Čuva vaše Sanduče, u datoteci koju ne može da pročita dok je zaključan: svaki zadržani poziv kao ime njegovog taf-a i ono što traži, nikada iznos, i Coach-ove odgovore na ono što ste poslali sa sata, kao tekst. Ako se odjavite na satu, čuva i to da ste se odjavili, dok se ponovo ne prijavite na satu. Osim toga, ne čuva ništa ako sat nema šifru. Sanduče nestaje kada se odjavite na satu ili se vaš iPhone odjavi, ili sledeći put kada se aplikacija otvori ili zatvori bez šifre. Ne pravi snimak, a jedina obaveštenja koja prikazuje su ona sa vašeg iPhone-a. Da bi se razgovor odmah otvorio, čuva i poslednjih 30 poruka svakog od najviše 20 razgovora koje ste na njemu otvorili, Coach-ovih i vaših tafs-a, samo kao tekst i nikada iznos, zaključane kao Sanduče; brišu se zajedno sa Sandučetom i kada razgovor nije otvoren 30 dana. Ako poruku za Coach-a sačuvate za kasnije, čuva i tu jednu poruku, kao tekst, u sopstvenoj datoteci, zaključanoj kao ona Primljenih, i šalje je kad se vaš iPhone vrati. Briše se kad bude poslata, kad je obrišete, kad se vi ili vaš iPhone odjavite ili ako sat više nema šifru.</li>
					<li><strong>Wear OS:</strong> prikazuje e-poštu vašeg naloga i današnji kalendar bez čuvanja. Da bi se odmah otvorio, čuva, šifrovano, broj stvari koje vas čekaju i ime svakog taf-a i da li je zaustavljen ili pauziran: nikada iznos, pojedinosti zadržanog poziva ni razgovor taf-a. To se briše kada se odjavite, kada se sat zaključa ili skine sa zgloba i posle 24 sata. Čuva vaše Sanduče, u kome je svaka linija ime taf-a i ono što kaže, nikada iznos, i jednu poruku sačuvanu za kasnije, kao tekst. Odjava, na satu ili na telefonu, briše sve to. Za svoju pločicu čuva i broj stvari koje vas čekaju, prikazan samo dok je sat otključan, a briše se kada se odjavite ili sledeći put kada se pločica prikaže dok je sat zaključan ili nema zaključavanje ekrana. Pošto se odjavite na satu, čuva belešku da jeste, dok se ponovo ne prijavite. Sanduče nestaje i sledeći put kada se aplikacija otvori ili zatvori dok je sat zaključan ili nema zaključavanje ekrana. Poruka sačuvana za kasnije ostaje dok je ne pošaljete ili obrišete, jer ste tražili da se pošalje. Ako se usluga govora na satu zaustavi pre nego što završite, sat šalje snimak vašem telefonu, koji ga sam pretvara u tekst na telefonu, nikada na serveru. Snimak se briše na oba uređaja kada se tekst vrati ili otkažete, a najkasnije posle 2 minuta. Samo tekst ide dalje Coach-u ili vašem taf-u. Rezultat taf-a može ostati u obaveštenjima na satu dok ga ne odbacite ili se ne odjavite na satu. Da bi se razgovor odmah otvorio, čuva i poslednjih 30 poruka svakog od najviše 20 razgovora koje ste na njemu otvorili, Coach-ovih i vaših tafs-a, samo kao tekst i nikada iznos, šifrovane; brišu se kada se odjavite, na satu ili na telefonu, i kada razgovor nije otvoren 30 dana, a sat bez zaključavanja ekrana ne čuva nijedan. Poruka sačuvana za kasnije briše se i ako sat više nema zaključavanje ekrana.</li>
					<li><strong>Passkey-evi:</strong> kada odobravate passkey-em na računaru, kao što je Windows Hello ili bezbednosni ključ, vaše lice, otisak prsta ili PIN ostaju u sistemu samog računara. KIFF čuva javni ključ passkey-a, njegov id, brojač i ime, nikada ništa tajno, i odbija passkey koji se sinhronizuje na druge uređaje.</li>
					<li><strong>Obaveštenja:</strong> na telefonu, tabletu ili Mac-u koji pokreće iPad aplikaciju, kada ih uključite, čuvamo push token uređaja sa vašim KIFF id-jem osobe i jezik koji je aplikacija prikazivala. Obaveštenje prolazi kroz Apple ili Google samo sa podatkom o tome koji taf i šta traži, a u obaveštenju vrata ime ili adresa e-pošte osobe koja je pisala: nikada iznos ni pojedinosti zahteva. Aplikacija ih dodaje na samom uređaju, iz KIFF-a, pa obaveštenje na otključanom telefonu može da prikaže iznos, trgovca ili osobu. Na zaključanom Android telefonu prikazuje samo „Taf vas treba“, isto i na zaključanom iPhone-u, osim ako ste podesili da se pregledi uvek prikazuju. Na Windows računaru, Linux računaru ili Mac-u sa aplikacijom za macOS 12, obaveštenja pravi sama aplikacija dok radi, bez push tokena i preko nijedne druge kompanije. Na Windows-u i Linuxu prikazuju koji taf, šta želi da uradi, iznos, zašto i do kada; u aplikaciji za macOS 12 prikazuju KIFF-ove reči za poziv, pošto ih uključite, a zaključan ekran prikazuje ono što dozvoljava podešavanje pregleda na Mac-u. Na Windows-u su isključena dok ih ne uključite i prikazuju samo „Taf vas treba“ dok je ekran zaključan. Obaveštenje prikazano pre zaključavanja ekrana zadržava svoje pojedinosti u Windows-ovoj listi obaveštenja. Na Linuxu su uključena dok ih ne isključite, a ono što zaključan ekran prikazuje zavisi od vašeg desktopa. Telefon koji prenosi ažuriranja na sat zadržava svoj push token registrovanim i kada su obaveštenja isključena, samo da bi ga tiho push obaveštenje moglo probuditi da prenese ažuriranja na sat; to obaveštenje ne sadrži reči i ništa ne prikazuje.</li>
					<li><strong>Jezik:</strong> usluga tafs čuva jezik naloga, od osobe koja je poslednja razgovarala sa Coach-om, do tri meseca, kako bi izveštaji taf-a stizali na njemu.</li>
					<li><strong>Vaši alati:</strong> kada povežete alat, prijavljujete se kod sopstvenog provajdera tog alata. Za aplikaciju u koju planque sam ulazi, kao što je Stripe, ili za ključ koji date, planque čuva taj token ili ključ za vašu kompaniju, šifrovan. Za upravljanu vezu, Composio, usluga povezivanja sa kojom planque radi, drži prijavu, a planque čuva samo zapis veze i alate koje ste odobrili (pogledajte <a href="#google">Google korisnički podaci</a>). Zapis veze može da sadrži nalog u koji je prijavljen (njegovo ime ili e-poštu; za banku naziv organizacije, njenu zemlju i poslednje znakove njenog identifikatora), pročitan kod dobavljača kada se prijavite, kako bi vam aplikacija mogla pokazati koji je, kako bi se ponovo započeta prijava završila samo sa istim nalogom i, za banku, kako bi faktura sadržala samo polja koja traži njena zemlja. KIFF koristi upravljane veze samo za aplikacije navedene na <a href="/subprocessors#composio">/subprocessors</a> (na engleskom).</li>
					<li><strong>Vaš pregledač (Chrome):</strong> kada proširenje tafs uparite sa telefonom, taf može da radi u Chrome profilu koji ste uparili, samo na sajtovima koje navodi njegova veza. Otvara sopstvene kartice u grupi kartica koju možete da vidite, pauzirate ili zaustavite, i pauzira se kada dodirnete neku od njih. Taf koji pokrenete iz bočnog panela proširenja umesto toga radi u kartici na kojoj ste u tom prozoru, ako je na nekom od sajtova njegove veze: kartica se pridružuje njegovoj grupi i smatra se njegovom, a kada se taf zaustavi, ostaje otvorena. Tu karticu preuzima samo kada je ta stranica prva koja mu treba. Tamo može da klikće i kuca, samo na svojim sajtovima. U toj kartici čita stranicu tamo gde jeste, a svaku drugu stranicu otvara u sopstvenoj kartici; vašu karticu može da pomeri samo korak koji tamo napravi, poput klika, i to samo unutar njegovih sajtova. Te stranice čita kao tekst i polja obrazaca, uz uklonjena polja za lozinku, karticu i kod, nikada vaše druge kartice ili druge sajtove. Taj tekst ide našem pružaocu veštačke inteligencije kao deo izvršavanja i čuva se uz izvršavanje kao rezultat bilo kog alata. Svaki korak ide u Evidenciju sa sajtom i imenom polja, nikada ono što je ukucano u tajno polje. Za svaku promenu koju taf napravi, KIFF čuva stranicu pre i posle, kao tekst bez tih polja, najviše 30 dana, i briše je ranije kada prekinete vezu ili obrišete nalog. Te stranice mogu da prikažu podatke drugih ljudi, na primer vaših kupaca; KIFF ih obrađuje za vas, kao obrađivač. Proširenje na vašem računaru čuva sopstveni ključ, svoju sesiju sa KIFF-om i spisak ćaskanja sa Coach-em započetih u njemu, nikada vaše lozinke: na stranici za prijavu taf se zaustavi i zamoli vas da se sami prijavite, u svojoj kartici. Sa Coach-om možete da razgovarate i iz bočnog panela proširenja. Coach čita stranicu tek kada mu to dozvolite u proširenju, posebnom saglasnošću koju tamo možete povući, a poruku bez stranice uvek možete da pošaljete. Kad mu odatle pošaljete poruku, stranica napred ide sa tom porukom samo kao njen vidljivi tekst, nikad ono što ste upisali, osim na sajtu banke, plaćanja, pošte ili zdravlja ili sajtu koji ste isključili za Coach. Vrednosti polja i lozinke se ne čitaju; brojevi kartica se skraćuju na poslednje četiri cifre; ključevi i označene tajne se maskiraju. Maskiraju se i jednokratni kodovi koje tekst stranice tako naziva na engleskom, francuskom, španskom ili nemačkom. Ide našem dobavljaču veštačke inteligencije samo za tu poruku; tafs čuva stranicu samo dok odgovor ne bude gotov, a naziv sajta čuva sa vašim ćaskanjem, prikazan kao „Čita:“, 30 dana. Odgovor Coach-a može da citira stranicu i čuva se sa vašim ćaskanjem kao svaki odgovor. Isto važi za poruku koju tamo pošaljete tafu, uz istu saglasnost, ali samo na nekom od sopstvenih sajtova tog tafa: drugde se ništa ne čita, u tom potezu taf samo čita, a njegov odgovor može da citira stranicu. Kod tafa se tekst stranice čuva uz njegovo izvršavanje samo dok se to izvršavanje ne završi. Bočni panel prikazuje ćaskanja započeta u tom Chrome-u otkad ste ga uparili; ostala vaša ćaskanja ostaju na telefonu i drugim uređajima. Kada taf radi u tom Chrome-u zbog poruke koju ste poslali sa drugog uređaja, panel prikazuje i to izvršavanje: poruku, njegove korake i odgovor, nikada ostatak tog ćaskanja, dok ne izbrišete to ćaskanje, ne poništite uparivanje Chrome-a ili ne premestite taf u drugi Chrome. Tamo poruci možete priložiti i datoteke: kao datoteke priložene u aplikacijama tafs, idu našem dobavljaču veštačke inteligencije uz tu poruku i čuvaju se sa njom 30 dana ili kraće ako se ćaskanje ukloni (datoteka koju nijedna poruka ne koristi, oko sat vremena), a datoteku može da otvori samo osoba koja ju je priložila. Čuva i svoje uparivanje sa vašim telefonom, sajtove koje ste isključili za Coach-a i nasumični identifikator ovog Chrome profila, koji ide KIFF-u pri svakom uparivanju kako bi vaš telefon prepoznao ovaj Chrome. Deinstalacija briše sve; razdvajanje briše sve osim tog identifikatora i sajtova isključenih za Coach-a. Taf nikada ne plaća bez vašeg odobrenja na telefonu. Za svaki korak koji deluje (klik, kucanje, slanje), uključujući onaj koji ste odobrili, čuva i jedan snimak ekrana stranice, napravljen neposredno pre radnje, za evidenciju; nikada za stranicu koju samo čita, nikada na sajtu banke, novčanika, menadžera lozinki, plaćanja, zdravlja ili državnih organa, a polja za lozinku, karticu i kod skrivena su pre snimanja. Tekst koji liči na broj kartice ili ključ takođe se zacrni, ali nešto napisano na drugi način i dalje može biti vidljivo. Snimci ekrana čuvaju se u šifrovanom skladištu, vezani za taj korak, 30 dana, zatim se automatski brišu, ili ranije kada prekinete vezu, prekinete uparivanje ovog Chrome-a ili obrišete svoj nalog, i nikada ne idu našem pružaocu veštačke inteligencije. Svaki vidite pod njegovim korakom u Aktivnosti tafa. tafs prepoznaje sajtove banaka, novčanika, menadžera lozinki, plaćanja, pošte, zdravstva i državnih organa po spisku i po rečima u njihovoj adresi, pa se sajt koji ne prepozna tretira kao svaki drugi.</li>
					if HostedBrowserForCustomers {
						<li><strong>{ hostedBrowserWords("sr").Label }</strong> { hostedBrowserWords("sr").Text }</li>
					}
					<li><strong>{ bankDataWords("sr").Label }</strong> { bankDataWords("sr").Text }</li>
					<li><strong>Rad vaših tafs-a:</strong> izvršavanja, razgovori, izveštaji, beleške iz memorije svakog taf-a i datoteke koje isporučuju, čuvaju se kao obrađivač. Svi na vašem nalogu mogu da vide datoteke koje vaši tafs isporučuju.</li>
					<li><strong>Vrata:</strong> kada otvorite vrata da bi vam ljudi mogli da pišu tafu e-poštom, preko Slacka ili Telegrama, usluga tafs čuva svakog pošiljaoca kog uparite, prema njegovoj adresi e-pošte, ID-ju člana na Slacku ili ID-ju korisnika na Telegramu (broju telefona za vrata na WhatsAppu), sa imenom koje mu date, dok ne uklonite vrata ili taf. Poruka nekoga koga niste uparili čeka vas kao kucanje, sa tim ko ju je napisao i šta kaže, do 30 dana posle poslednjeg. Poruka uparenog pošiljaoca ide u razgovor tafa i čuva se kao ostatak razgovora. Slack i Telegram prenose poruke prema sopstvenim uslovima. { doorMailWords("sr") }</li>
					<li><strong>Kupovine:</strong> Solo i pakete kredita prodaje Apple preko App Store-a ili Google preko naplate Google Play-a. Javljaju nam šta je kupljeno, za koji KIFF nalog (nasumični id), kada i njihove reference transakcije ili porudžbine. Ne daju nam vaš Apple ID ili Google nalog, ime, adresu e-pošte ni karticu.</li>
				</ul>
				<p>Aplikacija nema analitičke ni reklamne trackere.</p>
			</section>
			<section id="ai">
				<h2>5. AI u tafs</h2>
				<p>tafs koristi Anthropic-ov Claude AI za Coach i vaše tafs. Za nas ga pokreće Anthropic ili jedan od dobavljača usluga u oblaku sa naše stranice podobrađivača. Ta stranica navodi koji i gde. Aplikacija vas pita pre nego što bilo šta ode njemu.</p>
				<ul>
					<li>Šta se šalje: ono što pišete Coach-u i svojim tafs, datoteke koje priložite, ono što vaše povezane aplikacije vrate taf-u dok radi i ono što je na vašem ekranu dok vam Coach pomaže u aplikaciji.</li>
					<li>Iz Chrome-a: stranica napred, kad pišete Coach-u u bočnom panelu proširenja, kada Coach-u tamo dozvolite čitanje stranica. I kada tamo pišete tafu, na nekom od njegovih sopstvenih sajtova.</li>
					<li>Šta se nikada ne šalje: lozinke i ključevi koje koriste vaše povezane aplikacije ili vaš otisak prsta.</li>
					<li>Kompanija koja ga pokreće koristi ga za odgovor i briše ga u roku od 30 dana, osim ako nije označen kao kršenje njenih pravila korišćenja ili zakon zahteva da se čuva.</li>
					<li>Ništa se ne šalje dok ne dozvolite. Možete da povučete pristanak u Nalogu.</li>
				</ul>
				<p>Kada povučete pristanak, Coach i vaši tafs prestaju da vam odgovaraju, a taf čija se izvršavanja oslanjaju na vaš pristanak pauzira. tafs čuva zapis o svakom pristanku koji date ili povučete, sa vremenom i verzijom njegovog teksta, 10 godina od poslednje promene, da bi pokazao na šta ste pristali; brisanjem naloga briše se ranije. <a href="/sr/privacy#ai-in-tafs">KIFF-ova Politika privatnosti</a> ima pojedinosti.</p>
			</section>
			@tafsPrivacyGoogleSR()
			<section id="sharing">
				<h2>7. Ko još prima podatke</h2>
				<p>Ne prodajemo vaše podatke o ličnosti i ne delimo ih radi reklamiranja.</p>
				<p>Za tafs koristimo ove kompanije: Amazon Web Services (hosting, uključujući skladište tafs-a i veze planque-a), Clerk (prijava za KIFF naloge), Anthropic (AI model, koji pokreće Anthropic, Amazon Web Services, Google Cloud ili Microsoft Azure), Composio (prijave upravljanih veza i pozive koje planque traži od njega), Apple (push obaveštenja), Google (push obaveštenja na Androidu i naplata Google Play-a) i Amazon SES (e-poštna vrata taf-a; prijavljeni odgovori, koji idu timu KIFF-a). Zvanična, aktuelna lista, sa onim čega se svaka dotiče i gde, nalazi se na <a href="/subprocessors">/subprocessors</a> (na engleskom).</p>
				<p>Neke od njih su izvan Evropskog ekonomskog prostora, uglavnom u Sjedinjenim Državama. <a href="/sr/privacy#transfers">KIFF-ova Politika privatnosti</a> kaže kako su ti transferi zaštićeni.</p>
				<p><strong>Vaša zemlja.</strong> Zakoni nekih zemalja traže više nego što ova politika kaže. Ono što dodaju, na engleskom i na jeziku te zemlje, nalazi se na <a href="/privacy/countries">Vaša zemlja</a> (na engleskom).</p>
			</section>
			<section id="retention">
				<h2>8. Koliko dugo ga čuvamo</h2>
				<ul>
					<li>Ono što vaši alati vrate taf-u: samo do kraja izvršavanja. U razgovoru, ono što je samo pročitano čuva se šifrovano za njegove sledeće poruke, koristi se dok razgovor nije mirovao sat vremena i najviše četiri sata posle čitanja, a zatim se automatski briše, u roku od nekoliko dana.</li>
					<li>Izvršavanja i razgovori taf-a, sa sažetkom razgovora: 30 dana. Njegove beleške iz memorije: dok se taf ne ukloni. Svoj razgovor sa Coach-em možete izbrisati i ranije: njegove poruke i datoteke koje ste dodali brišu se odmah, dok zapis da se svako njegovo izvršavanje dogodilo, kada i koliko je koštalo ostaje tih 30 dana. Ako prijavite odgovor, KIFF taj odgovor, vaš razlog i belešku čuva 180 dana ili dok ne obrišete to ćaskanje ili svoj nalog. KIFF ih šalje i e-poštom timu koji čita prijave, gde se ta poruka čuva kao KIFF-ova pošta podrške.</li>
					<li>Coach-ove kratke beleške za sledeći odgovor, kao što je zašto veza nije mogla da se uspostavi u razgovoru ili da je Card odobren: dok ih taj odgovor ne preuzme, najviše 7 dana; posle toga, kao deo tog razgovora, dokle god se razgovor čuva. Kopija se čuva 24 sata da bi ponovo poslata poruka dobila istu belešku. Beleška razgovora koristi se samo u tom razgovoru.</li>
					<li>Datoteke koje priložite u razgovoru: sa porukom uz koju su priložene, 30 dana, ili ranije ako se razgovor ukloni, a u svakom slučaju u roku od 38 dana. Datoteka koju nijedna poruka ne koristi uklanja se oko sat vremena posle otpremanja. Brisanje naloga ih briše.</li>
					<li>Datoteke koje vaši tafs isporučuju: 30 dana od trenutka kada ih je izvršavanje napravilo, zatim se automatski brišu u roku od jednog dana. Svako na vašem nalogu može da obriše jednu ranije pomoću Obriši odmah: sama datoteka nestaje odmah, bez sačuvane kopije; njeno ime, veličina i taf i izvršavanje koji su je napravili mogu ostati u šifrovanim kopijama skladišta tafs-a u određenom trenutku do 35 dana, koje se koriste samo za obnovu posle kvara. Uklanjanje taf-a ili brisanje naloga briše njegove datoteke. Deljenje datoteke šalje samu datoteku, a kopija koju delite ostaje kod aplikacije sa kojom ste je podelili. Da biste preuzeli datoteku, pravimo vezu za prijavljenog člana vašeg naloga koja prestaje da radi posle jednog minuta; ne pravimo nijednu drugu vezu do nje.</li>
					<li>Ono što je alat vratio, u planque-ovom zapisu svakog poziva: 24 sata. Posle toga zapis čuva samo da li je poziv poslat, pa se nikada ne šalje dvaput.</li>
					<li>Token ili ključ veze u planque-u, ili prijava upravljane veze u Composio-u: dok je ne prekinete. Ako druga vaša veza sme da koristi isti nalog kod tog dobavljača, čuva se, neiskorišćen, dok se i ona ne prekine, a zatim se opoziva. { revokeNoteWords("sr") } Zapis njenih odobrenja: do kraja naloga.</li>
					<li>Push token uređaja: do odjave iz aplikacije, uklanjanja uređaja ili dok Apple ili Google ne prijavi da token više ne postoji. Javni ključ uređaja, ime, platforma i datumi: dok ga koristite; pošto ga odjavite, označava se kao uklonjen i čuva do brisanja naloga, kako bi KIFF mogao da odbije zakasneli odgovor sa njega i da pokaže koji je uređaj potpisao raniji. Javni ključ passkey-a, id i ime: kao oni njegovog uređaja. Sesija računara: do 90 dana ili dok se ne odjavite.</li>
					<li>Vaš nalog: dok se ne obriše. Zapisi usluge: 30 dana. Skladišta tafs-a i planque-a čuvaju šifrovane kopije u određenom trenutku 35 dana, koje se koriste samo za obnovu skladišta posle kvara.</li>
				</ul>
				<p>Sve ostalo je u <a href="/sr/privacy#retention">KIFF-ovom odeljku o čuvanju podataka</a>.</p>
			</section>
			<section id="lawful-bases">
				<h2>9. Pravni osnovi</h2>
				<p>Izvršenje ugovora, za vođenje vašeg naloga i vaših tafs-a. Legitimni interesi, za bezbednost, sprečavanje prevara i otkrivanje zloupotrebe. Pristanak, za AI u tafs (<a href="#ai">odeljak 5</a>). Zakonska obaveza, za poreske evidencije. <a href="/sr/privacy#lawful-bases">KIFF-ova Politika privatnosti</a> ima pojedinosti.</p>
			</section>
			<section id="rights">
				<h2>10. Vaša prava</h2>
				<p>Prema GDPR-u možete tražiti pristup svojim podacima, njihovu ispravku, brisanje, ograničenje ili prenosivu kopiju, uložiti prigovor na obradu zasnovanu na legitimnim interesima i povući pristanak. Pišite na <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>; odgovaramo bez nepotrebnog odlaganja, a najkasnije u roku od mesec dana; za složen zahtev možda će nam trebati još dva meseca i o tome vas obaveštavamo u prvom mesecu. U aplikaciji, Nalog → Izvezi moje razgovore preuzima vaše sopstvene razgovore i beleške.</p>
				<p>Da biste obrisali svoj tafs nalog, otvorite aplikaciju, idite na Nalog i dodirnite <em>Obriši nalog</em>, a zatim potvrdite. Ne može se poništiti. <a href="/sr/privacy#delete-account">KIFF-ova Politika privatnosti</a> kaže šta se briše i kada, i kako da tražite e-poštom.</p>
				<p>Možete podneti pritužbu <a href="https://www.aki.ee/en" target="_blank" rel="noopener">Estonskom inspektoratu za zaštitu podataka (Andmekaitse Inspektsioon)</a> ili nadzornom organu tamo gde živite.</p>
				<p><strong>Vaša zemlja.</strong> Zakoni nekih zemalja traže više nego što ova politika kaže. Ono što dodaju, na engleskom i na jeziku te zemlje, nalazi se na <a href="/privacy/countries">Vaša zemlja</a> (na engleskom).</p>
			</section>
			<section id="more">
				<h2>11. Bezbednost, deca i izmene</h2>
				<p>Naše mere bezbednosti su na <a href="/security">/security</a> (na engleskom). tafs nije namenjen deci i svesno ne prikupljamo podatke o ličnosti dece mlađe od 16 godina. Ovu politiku menjamo na način na koji <a href="/sr/privacy#changes">KIFF-ova Politika privatnosti</a> kaže za sopstvenu.</p>
			</section>
			<section id="contact">
				<h2>12. Kontakt</h2>
				<p>Pitanja i zahtevi o privatnosti: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>. Zvanična pravna obaveštenja: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>. Sopstveni uslovi aplikacije su na <a href="/sr/tafs/terms">/tafs/terms</a>.</p>
			</section>
		</article>
	}
}

// tafsPrivacyGoogle is what tafs does with the data it receives from Google,
// for Google's review of tafs's sign-in, with the Limited Use statement in
// Google's own words.
templ tafsPrivacyGoogleSR() {
	<section id="google">
		<h2>6. Google korisnički podaci</h2>
		if len(googleManaged()) == 0 && len(googleInHouse("sr")) > 0 {
			<p>Kada to tražite, tafs povezuje taf sa vašim Google nalogom, na primer sa Google Sheets ili Google Calendar koje koristi njegov posao, u Povežite aplikacije u aplikaciji. Ovaj odeljak kaže šta tafs radi sa podacima koje prima od Google-a.</p>
		} else {
			<p>Kada to tražite, tafs povezuje taf sa vašim Google nalogom, na primer sa vašim Gmail-om ili sa Google Calendar ili Google Sheets koje koristi njegov posao, u Povežite aplikacije u aplikaciji. Ovaj odeljak kaže šta tafs radi sa podacima koje prima od Google-a.</p>
		}
		<ul>
			if len(googleManaged()) == 0 && len(googleInHouse("sr")) > 0 {
				<li><strong>Šta čita i piše:</strong> ono što je potrebno poslu taf-a: tabele koje ažurira ili događaje u kalendarima o kojima se stara. Menja ih samo gde Card taf-a to dozvoljava, a sve preko ograničenja Card-a čeka vaše odobrenje.</li>
			} else {
				<li><strong>Šta čita i piše:</strong> ono što je potrebno poslu taf-a. U vašem Gmail-u čita vaše poruke i niti da pronađe one na koje treba odgovoriti i piše nacrte; šalje poštu samo gde Card taf-a to dozvoljava. U Google Calendar i Google Sheets čita događaje u kalendarima o kojima se stara ili tabele koje ažurira i menja ih samo gde Card taf-a to dozvoljava.
					if googleListed("Google Tasks") {
						U Google Tasks čita liste zadataka o kojima se stara i dodaje, dovršava, premešta ili briše zadatke samo gde Card taf-a to dozvoljava.
					}
					Sve preko ograničenja Card-a čeka vaše odobrenje.</li>
			}
			<li><strong>Zašto:</strong> samo da uradi posao koji ste podesili za taj taf i da vam pokaže sa kojim Google nalogom je povezan: njegovu adresu e-pošte, koja se čuva uz vezu dok je ne prekinete.</li>
			if len(googleManaged()) > 0 || len(googleInHouse("sr")) > 0 {
				<li>
					<strong>Kako se svaka Google aplikacija povezuje:</strong>
					<ul>
						if len(googleManaged()) > 0 {
							<li>Preko našeg partnera za prijavu, navedenog na <a href="/subprocessors">/subprocessors</a> (na engleskom): { appList(googleManaged()) }.</li>
						}
						if len(googleInHouse("sr")) > 0 {
							<li>Preko sopstvene Google prijave tafs-a, bez druge kompanije između: { appList(googleInHouseNames()) }.</li>
						}
						for _, a := range googlePending("sr") {
							<li>
								{ a.Name }{ googlePendingSep("sr") }{ googlePendingWords("sr").Line }
								{ googlePendingWords("sr").AsksFor }
								<ul>
									for _, s := range a.Scopes {
										<li><code>{ s.ID }</code>: { s.What }</li>
									}
								</ul>
							</li>
						}
					</ul>
					if googleBoth() {
						Aplikacija navedena u oba slučaja povezuje se na jedan ili drugi način, zavisno od vašeg naloga. Google-ova sopstvena stranica za prijavu pokazuje koji dozvoljavate.
					}
				</li>
			}
			if googleBoth() {
				<li>
					<strong>Šta dozvoljavate:</strong> prijavljujete se na Google-ovoj sopstvenoj stranici i birate šta ćete dozvoliti.
					<ul>
						<li><strong>Preko našeg partnera za prijavu:</strong> tafs traži samo pristup koji su potrebni alatima taf-a. Ako taj uži pristup nije moguć, traži uobičajeni pristup aplikacije i kaže to pre nego što se prijavite. Ako bi uobičajeni pristup obuhvatao podatke o ličnosti koje taf ne koristi, tafs se ne povezuje.</li>
						<li><strong>Preko sopstvene Google prijave tafs-a:</strong> prijava traži sav pristup naveden ispod za tu aplikaciju odjednom, čak i kada taf samo čita.</li>
					</ul>
				</li>
			} else if len(googleInHouse("sr")) > 0 {
				<li><strong>Šta dozvoljavate:</strong> prijavljujete se na Google-ovoj sopstvenoj stranici i birate šta ćete dozvoliti. Prijava traži sav pristup naveden ispod za tu aplikaciju odjednom, čak i kada taf samo čita.</li>
			} else {
				<li><strong>Šta dozvoljavate:</strong> prijavljujete se na Google-ovoj sopstvenoj stranici i birate šta ćete dozvoliti. tafs traži samo pristup koji su potrebni alatima taf-a. Ako taj uži pristup nije moguć, traži uobičajeni pristup aplikacije i kaže to pre nego što se prijavite. Ako bi uobičajeni pristup obuhvatao podatke o ličnosti koje taf ne koristi, tafs se ne povezuje.</li>
			}
			<li><strong>Kako ga taf koristi:</strong> taf koristi samo alate odobrene na njegovom Card-u. Svaki poziv se pre slanja proverava prema dozvoli za tačno taj alat i te argumente, a poziv izvan pristupa koji ste dali se odbija. Koje radnje svaki put traže vaše odobrenje podešava se na Card-u.</li>
			if len(googleInHouse("sr")) > 0 {
				<li>
					if googleBoth() {
						<strong>Pristup koji traži sopstvena Google prijava tafs-a:</strong>
					} else {
						<strong>Pristup koji traži tafs:</strong>
					}
					<ul>
						for _, a := range googleInHouse("sr") {
							<li>
								{ a.Name }
								<ul>
									for _, s := range a.Scopes {
										<li><code>{ s.ID }</code>: { s.What }</li>
									}
								</ul>
							</li>
						}
					</ul>
					Koliko god prijava dozvoljavala, taf koristi samo alate sa svog Card-a.
				</li>
			}
			if googleBoth() {
				<li>
					<strong>Ko čuva vašu prijavu:</strong>
					<ul>
						<li><strong>Preko našeg partnera za prijavu:</strong> vašu Google prijavu čuva naš partner za prijavu, naveden na <a href="/subprocessors">/subprocessors</a> (na engleskom), i nikada se ne daje taf-u ni planque-u. Ni taf ni tafs ne vide vašu lozinku ni vaše Google tokene. Drugi vaš taf kome je potreban isti pristup ponovo koristi prijavu, a svaki taf koristi samo alate koje ste mu odobrili.</li>
						<li><strong>Preko sopstvene Google prijave tafs-a:</strong> planque, sopstvena usluga povezivanja tafs-a, čuva vaš Google token za vašu kompaniju, šifrovan pomoću AWS KMS u Evropskoj uniji (Irska), i koristi ga samo da uputi poziv koji Card taf-a dozvoljava. Nikada se ne daje taf-u, a ni taf ni AI model ne vide vašu lozinku ni vaše Google tokene. Drugi vaš taf kome je potreban isti pristup ponovo koristi prijavu, a svaki taf koristi samo alate koje ste mu odobrili.</li>
					</ul>
				</li>
			} else if len(googleInHouse("sr")) > 0 {
				<li><strong>Ko čuva vašu prijavu:</strong> planque, sopstvena usluga povezivanja tafs-a, čuva vaš Google token za vašu kompaniju, šifrovan pomoću AWS KMS u Evropskoj uniji (Irska), i koristi ga samo da uputi poziv koji Card taf-a dozvoljava. Nikada se ne daje taf-u, a ni taf ni AI model ne vide vašu lozinku ni vaše Google tokene. Drugi vaš taf kome je potreban isti pristup ponovo koristi prijavu, a svaki taf koristi samo alate koje ste mu odobrili.</li>
			} else {
				<li><strong>Ko čuva vašu prijavu:</strong> vašu Google prijavu čuva naš partner za prijavu, naveden na <a href="/subprocessors">/subprocessors</a> (na engleskom), i nikada se ne daje taf-u ni planque-u. Ni taf ni tafs ne vide vašu lozinku ni vaše Google tokene. Drugi vaš taf kome je potreban isti pristup ponovo koristi prijavu, a svaki taf koristi samo alate koje ste mu odobrili.</li>
			}
			if googleBoth() {
				<li>
					<strong>Ko još to prima:</strong> ono što taf pročita od Google-a ide AI modelu koji pokreće taf, tek kada dozvolite (pogledajte <a href="#ai">AI u tafs</a>), a on to čuva do 30 dana po uslovima svog provajdera.
					<ul>
						<li><strong>Preko našeg partnera za prijavu:</strong> prolazi i kroz našeg partnera za prijavu, koji upućuje svaki poziv.</li>
						<li><strong>Preko sopstvene Google prijave tafs-a:</strong> planque sam poziva Google, pa nijedna druga kompanija ne upućuje poziv niti drži vašu prijavu.</li>
					</ul>
					Oba su navedena na <a href="/subprocessors">/subprocessors</a> (na engleskom).
				</li>
			} else if len(googleInHouse("sr")) > 0 {
				<li><strong>Ko još to prima:</strong> ono što taf pročita od Google-a ide AI modelu koji pokreće taf, tek kada dozvolite (pogledajte <a href="#ai">AI u tafs</a>), a on to čuva do 30 dana po uslovima svog provajdera. planque sam poziva Google, pa nijedna druga kompanija ne upućuje poziv niti drži vašu prijavu. Provajder AI modela naveden je na <a href="/subprocessors">/subprocessors</a> (na engleskom).</li>
			} else {
				<li><strong>Ko još to prima:</strong> ono što taf pročita od Google-a ide AI modelu koji pokreće taf, tek kada dozvolite (pogledajte <a href="#ai">AI u tafs</a>), a on to čuva do 30 dana po uslovima svog provajdera. Prolazi i kroz našeg partnera za prijavu, koji upućuje svaki poziv. Oba su navedena na <a href="/subprocessors">/subprocessors</a> (na engleskom).</li>
			}
			<li><strong>AI obuka:</strong> Google korisnički podaci se ne koriste za obuku AI modela.</li>
			<li><strong>Slike:</strong> tafs ne pravi niti uređuje slike ili video: njegov AI piše tekst. Nikada ne koristi Google API-je ni Google korisničke podatke da napravi, uredi ili podeli intimne slike bilo koga bez njegovog pristanka (NCII) ili bilo koju drugu sliku osobe.</li>
			if len(googleManaged()) == 0 && len(googleInHouse("sr")) > 0 {
				<li><strong>Koliko dugo i gde:</strong> vaše tabele i događaji ostaju u vašem Google nalogu. U sopstvenom skladištu tafs-a, ono što alat vrati čuva se samo do kraja izvršavanja taf-a. planque, koji prosleđuje svaki poziv, čuva ono što Google vrati 24 sata, pa ponovljeni poziv dobija isti odgovor i nikada se ne šalje dvaput; posle toga čuva samo da li je poziv poslat. U razgovoru, ono što je samo pročitano čuva se šifrovano, koristi se dok razgovor nije mirovao sat vremena i najviše četiri sata posle čitanja, a zatim se automatski briše, u roku od nekoliko dana. Zapis izvršavanja i njegov razgovor čuvaju se 30 dana, a beleške taf-a dok ne uklonite taf (pogledajte <a href="#retention">Koliko dugo ga čuvamo</a>).</li>
			} else {
				<li><strong>Koliko dugo i gde:</strong> vaši nacrti, događaji i tabele ostaju u vašem Google nalogu. U sopstvenom skladištu tafs-a, ono što alat vrati čuva se samo do kraja izvršavanja taf-a. planque, koji prosleđuje svaki poziv, čuva ono što Google vrati 24 sata, pa ponovljeni poziv dobija isti odgovor i nikada se ne šalje dvaput; posle toga čuva samo da li je poziv poslat. U razgovoru, ono što je samo pročitano čuva se šifrovano, koristi se dok razgovor nije mirovao sat vremena i najviše četiri sata posle čitanja, a zatim se automatski briše, u roku od nekoliko dana. Zapis izvršavanja i njegov razgovor čuvaju se 30 dana, a beleške taf-a dok ne uklonite taf (pogledajte <a href="#retention">Koliko dugo ga čuvamo</a>).</li>
			}
			<li>
				<strong>Zaustavljanje:</strong>
				<ul>
					<li>Prekinite vezu sa Google-om u aplikaciji, u Povežite aplikacije ili na kartici Card taf-a. Njegovi Google alati staju odmah, a tafs traži od Google-a da odmah opozove prijavu; to se može završiti malo kasnije.</li>
					<li>Uklonite taf i njegove veze se završavaju sa njim. Google prijava koju još koristi neki drugi vaš taf ostaje dok ne ode poslednji.</li>
					<li>Uklonite tafs-ov pristup u bilo kom trenutku u svom Google nalogu, na <a href="https://myaccount.google.com/permissions">myaccount.google.com/permissions</a>. Vaši tafs prestaju da dopiru do Google-a, a aplikacija vam kaže da je Google veza odjavljena.</li>
					<li>Obrišite svoj nalog: njegovi tafs, razgovori, beleške, datoteke i veze brišu se odmah, a iz kopija u određenom trenutku u roku od 35 dana, a njegovi Google tokeni se opozivaju gde Google dozvoljava.</li>
				</ul>
			</li>
		</ul>
		<p lang="en">tafs's use and transfer to any other app of information received from Google APIs will adhere to <a href="https://developers.google.com/terms/api-services-user-data-policy">Google API Services User Data Policy</a>, including the Limited Use requirements.</p>
	</section>
}
