			if len(googleManaged()) == 0 && len(googleInHouse("ta")) > 0 {
				<li><strong>எவ்வளவு காலம், எங்கே:</strong> உங்கள் விரிதாள்களும் நிகழ்வுகளும் உங்கள் Google கணக்கில் இருக்கும். tafs இன் சொந்தச் சேமிப்பகத்தில், கருவி திருப்பித் தருவது taf இன் ஓட்டம் முடியும் வரை மட்டுமே வைக்கப்படுகிறது. ஒவ்வொரு அழைப்பையும் அனுப்பும் planque, Google திருப்பித் தருவதை 24 மணி நேரம் வைத்திருக்கிறது, எனவே மீண்டும் செய்யப்பட்ட அழைப்புக்கு அதே பதில் கிடைக்கிறது, அது ஒருபோதும் இருமுறை அனுப்பப்படுவதில்லை; அதன் பிறகு அது அழைப்பு அனுப்பப்பட்டதா என்பதை மட்டுமே வைத்திருக்கிறது. உரையாடலில், படித்தது மட்டும் குறியாக்கப்பட்டு வைக்கப்படுகிறது, உரையாடல் ஒரு மணி நேரம் செயலற்றிருக்கும் வரை, படித்த பிறகு அதிகபட்சம் நான்கு மணி நேரம் வரை பயன்படுத்தப்பட்டு, பின்னர் சில நாட்களுக்குள் தானாக நீக்கப்படுகிறது. ஓட்டத்தின் பதிவும் அதன் உரையாடலும் 30 நாட்கள் வைக்கப்படுகின்றன, taf இன் குறிப்புகள் நீங்கள் taf ஐ நீக்கும் வரை (பார்க்க <a href="#retention">எவ்வளவு காலம் வைத்திருக்கிறோம்</a>).</li>
			} else {
				<li><strong>எவ்வளவு காலம், எங்கே:</strong> உங்கள் வரைவுகள், நிகழ்வுகள் மற்றும் விரிதாள்கள் உங்கள் Google கணக்கில் இருக்கும். tafs இன் சொந்தச் சேமிப்பகத்தில், கருவி திருப்பித் தருவது taf இன் ஓட்டம் முடியும் வரை மட்டுமே வைக்கப்படுகிறது. ஒவ்வொரு அழைப்பையும் அனுப்பும் planque, Google திருப்பித் தருவதை 24 மணி நேரம் வைத்திருக்கிறது, எனவே மீண்டும் செய்யப்பட்ட அழைப்புக்கு அதே பதில் கிடைக்கிறது, அது ஒருபோதும் இருமுறை அனுப்பப்படுவதில்லை; அதன் பிறகு அது அழைப்பு அனுப்பப்பட்டதா என்பதை மட்டுமே வைத்திருக்கிறது. உரையாடலில், படித்தது மட்டும் குறியாக்கப்பட்டு வைக்கப்படுகிறது, உரையாடல் ஒரு மணி நேரம் செயலற்றிருக்கும் வரை, படித்த பிறகு அதிகபட்சம் நான்கு மணி நேரம் வரை பயன்படுத்தப்பட்டு, பின்னர் சில நாட்களுக்குள் தானாக நீக்கப்படுகிறது. ஓட்டத்தின் பதிவும் அதன் உரையாடலும் 30 நாட்கள் வைக்கப்படுகின்றன, taf இன் குறிப்புகள் நீங்கள் taf ஐ நீக்கும் வரை (பார்க்க <a href="#retention">எவ்வளவு காலம் வைத்திருக்கிறோம்</a>).</li>
