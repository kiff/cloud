package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// PrivacyVI is KIFF's privacy policy (/privacy) in Vietnamese, at /vi/privacy.
// It is a translation of Privacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Vietnamese has the legal
// texts only, so a link to any other page goes to English and says so.
templ PrivacyVI() {
	@components.LayoutSite("KIFF — privacy policy", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@privacyHeadVI()
			@privacyWhoWeAreVI()
			@privacyScopeVI()
			@privacyRolesVI()
			@privacyCategoriesVI()
			@privacyLawfulBasesVI()
			@privacySubprocessorsVI()
			@privacyTransfersVI()
			@privacyRetentionVI()
			@privacyRightsVI()
			@privacyCookiesVI()
			@privacySecurityVI()
			@privacyChildrenVI()
			@privacyAutomatedVI()
			@privacyChangesVI()
			@privacyContactVI()
		</article>
	}
}

templ privacyHeadVI() {
	<header class="legal-head">
		<p class="legal-badge">Chính sách quyền riêng tư · v0.1</p>
		<h1>Chính sách quyền riêng tư</h1>
		<p class="legal-meta">
			<strong>Cập nhật lần cuối:</strong> 21 tháng mười một năm 2026. <strong>Ngày có hiệu lực:</strong> 24 tháng Năm năm 2026.
		</p>
		<p class="legal-disclaimer">
			Chính sách này giải thích cách KIFF Cloud xử lý dữ liệu cá nhân trên trang web, bảng điều khiển, API và ứng dụng tafs trên iPhone, iPad, Android và máy tính. Câu hỏi: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</header>
}

templ privacyWhoWeAreVI() {
	<section id="who-we-are">
		<h2>1. Chúng tôi là ai</h2>
		<p>
			KIFF Cloud do <strong>Kiff Agents OÜ</strong> vận hành, một công ty trách nhiệm hữu hạn tư nhân thành lập tại Estonia. Thông tin đăng ký:
		</p>
		<ul>
			<li><strong>Mã đăng ký:</strong> 17372313 (Sổ đăng ký kinh doanh điện tử Estonia)</li>
			<li><strong>Mã số VAT:</strong> EE102924327</li>
			<li><strong>Địa chỉ đăng ký:</strong> Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estonia</li>
			<li><strong>Liên hệ về quyền riêng tư:</strong> <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a></li>
			<li><strong>Thông báo pháp lý chính thức:</strong> <a href="mailto:legal@kiff.dev">legal@kiff.dev</a></li>
		</ul>
		<p>
			Vì Kiff Agents OÜ được thành lập tại Liên minh châu Âu, Quy định chung về bảo vệ dữ liệu của EU (<abbr title="Quy định chung về bảo vệ dữ liệu">GDPR</abbr>) áp dụng trực tiếp cho việc xử lý của chúng tôi. Chúng tôi không cần Đại diện tại EU theo Điều 27.
		</p>
	</section>
}

templ privacyScopeVI() {
	<section id="scope">
		<h2>2. Phạm vi của chính sách này</h2>
		<p>
			Chính sách này bao gồm dữ liệu cá nhân chúng tôi xử lý khi bạn tương tác với:
		</p>
		<ul>
			<li><a href="https://kiff.dev"><code>kiff.dev</code></a> — trang tiếp thị của chúng tôi, trang chính sách này và giao diện hiển thị biên nhận công khai.</li>
			<li><a href="https://app.kiff.dev"><code>app.kiff.dev</code></a> — bảng điều khiển có xác thực của chúng tôi.</li>
			<li><a href="https://api.kiff.dev"><code>api.kiff.dev</code></a> — API HTTP của chúng tôi.</li>
			<li id="tafs"><strong>tafs</strong> — ứng dụng của chúng tôi trên iPhone, iPad, Android và máy tính (Mac, Windows và Linux), cùng dịch vụ đằng sau nó (gồm Setup, nơi kết nối các công cụ của một công ty, và planque, nơi giữ các kết nối đó), trong đó một công ty giao việc cho một tác nhân AI làm việc bên trong các KIFF Card.</li>
		</ul>
		<p>
			Chính sách này <em>không</em> bao gồm khung mã nguồn mở <code>kiff/kiff</code> mà bạn có thể tự chạy. Khi bạn chạy khung đó trên hạ tầng của chính bạn, bạn là bên kiểm soát mọi dữ liệu nó xử lý, và Kiff Agents OÜ không tham gia vào việc xử lý đó.
		</p>
	</section>
}

templ privacyRolesVI() {
	<section id="roles">
		<h2>3. Vai trò của chúng tôi theo GDPR</h2>
		<p>
			Chúng tôi hành động với hai tư cách tùy theo dữ liệu:
		</p>
		<ul>
			<li>
				<strong>Bên kiểm soát dữ liệu</strong> đối với siêu dữ liệu tài khoản và đăng nhập, dữ liệu thanh toán (khi thanh toán đang hoạt động), thông tin tiếp thị bạn chọn nhận và dữ liệu đo lường vận hành của dịch vụ của chính chúng tôi.
			</li>
			<li>
				<strong>Bên xử lý dữ liệu</strong> đối với dữ liệu kiểm toán, hồ sơ hành động, biên nhận quyết định và nội dung khác chảy qua môi trường chạy thay mặt khách hàng của chúng tôi, và đối với những gì tafs lưu giữ cho họ (các lần chạy, cuộc trò chuyện, báo cáo, ghi chú bộ nhớ của mỗi taf và các tệp chúng giao). Khách hàng (các tenant) là bên kiểm soát dữ liệu đó; họ chỉ dẫn chúng tôi qua cài đặt tài khoản và cấu hình tên miền. Thỏa thuận xử lý dữ liệu (<abbr title="Thỏa thuận xử lý dữ liệu">DPA</abbr>) điều chỉnh mối quan hệ đó; xem <a href="/legal/dpa">mẫu DPA</a> (bằng tiếng Anh) để biết các điều khoản đã công bố.
			</li>
		</ul>
		<p>
			Chính sách này chủ yếu nói về việc xử lý của chúng tôi với tư cách bên kiểm soát. Ở những chỗ chúng tôi nhắc đến dữ liệu phía bên xử lý, DPA là tài liệu cụ thể hơn.
		</p>
	</section>
}

templ privacyCategoriesVI() {
	<section id="categories">
		<h2>4. Các loại dữ liệu cá nhân chúng tôi xử lý</h2>
		<p>
			Các loại dưới đây phù hợp với bản kiểm kê kỹ thuật tại <a href="/security#data-we-process">/security#data-we-process</a> (bằng tiếng Anh). Khi hai nơi khác nhau, trang kỹ thuật là nguồn chuẩn và chúng tôi cập nhật mục này cho khớp.
		</p>
		<ul>
			<li>
				<strong>Mã định danh tài khoản</strong> — chủ thể xác thực thượng nguồn của bạn (do nhà cung cấp danh tính của chúng tôi cấp) và địa chỉ email bạn dùng để đăng nhập. Hiện được lưu nguyên văn; băm khi lưu đang được lên kế hoạch.
			</li>
			<li>
				<strong>Siêu dữ liệu tenant</strong> — mã tenant, slug, tên hiển thị, dấu thời gian tạo, và ngôn ngữ ứng dụng của mỗi người dùng gần nhất, để các email KIFF gửi họ đến bằng ngôn ngữ đó.
			</li>
			<li>
				<strong>Thông tin xác thực API</strong> — các bản ghi khóa API mờ (chúng tôi lưu giá trị băm, không bao giờ lưu văn bản gốc).
			</li>
			<li>
				<strong>Dữ liệu cookie phiên</strong> — một cookie phiên ký HMAC được đặt sau khi đăng nhập. Xem mục cookie bên dưới.
			</li>
			<li>
				<strong>Siêu dữ liệu yêu cầu HTTP</strong> — địa chỉ IP, user agent, đường dẫn yêu cầu, trạng thái phản hồi, độ trễ. Được giữ trong nhật ký truy cập của reverse proxy của chúng tôi trong một khoảng thời gian lưu giữ giới hạn để bảo mật và phòng chống lạm dụng.
			</li>
			<li>
				<strong>Nội dung do tenant kiểm soát</strong> — dữ liệu <code>parameters</code>, <code>actor</code> và <code>entity</code> bạn gửi đến môi trường chạy. Chúng tôi giữ chúng <em>với tư cách bên xử lý</em> thay mặt khách hàng; khách hàng chịu trách nhiệm cho những gì lên đường truyền. Cấu hình che giấu theo từng tên miền đang được lên kế hoạch.
			</li>
			<li>
				<strong>Thông tin liên lạc</strong> — các email bạn gửi đến hộp thư hỗ trợ, bán hàng, bảo mật hoặc quyền riêng tư của chúng tôi.
			</li>
			<li>
				<strong>Ứng dụng tafs</strong> — bạn đăng nhập vào tafs bằng tài khoản KIFF. Trên điện thoại hoặc máy tính bảng, ứng dụng giữ phiên của bạn trong Keychain của thiết bị (trên Android là bộ lưu trữ được mã hóa của nó). Trên máy tính, nó giữ phiên được niêm phong cho tài khoản người dùng của bạn: trên PC Windows bằng cơ chế bảo vệ dữ liệu riêng của Windows, trên Linux trong keyring của bạn, trên Mac trong Keychain. Phiên của một máy tính kéo dài tối đa 90 ngày. ứng dụng tạo một khóa ký không bao giờ rời thiết bị: trong Secure Enclave của iPhone, iPad hoặc Mac, Keystore của thiết bị Android, hoặc TPM của PC Windows. Trên Linux, và trên Mac không có Secure Enclave, khóa là khóa phần mềm giữ trong keyring hoặc Keychain của bạn, và máy tính đó có thể hiển thị những gì đang chờ bạn nhưng không thể phê duyệt; bạn phê duyệt trên điện thoại của bạn{ macSecurityKey("vi") }. PC Windows không có TPM không thể đăng nhập vào tafs. KIFF giữ nửa công khai của khóa, tên và nền tảng của thiết bị, cùng thời điểm nó được thêm và dùng lần cuối, để có thể kiểm tra câu trả lời của bạn cho các lệnh gọi bị giữ và các phê duyệt kết nối của bạn. Nếu bạn phê duyệt bằng khóa truy cập trên máy tính, như Windows Hello hoặc khóa bảo mật, khuôn mặt, vân tay hoặc mã PIN của bạn ở lại trong hệ thống riêng của máy tính; KIFF giữ khóa công khai của khóa truy cập, mã định danh, một bộ đếm và một cái tên, không bao giờ là bất cứ thứ gì bí mật, và từ chối khóa truy cập đồng bộ sang thiết bị khác. Nếu bạn bật thông báo trên điện thoại, máy tính bảng hoặc Mac chạy ứng dụng iPad, chúng tôi giữ mã thông báo đẩy của thiết bị cùng mã người KIFF của bạn, và ngôn ngữ ứng dụng đã hiển thị, để thông báo của nó đến bằng ngôn ngữ đó. Dịch vụ tafs cũng giữ ngôn ngữ của tài khoản, từ người trò chuyện với Coach gần nhất, tối đa ba tháng, để báo cáo của một taf đến bằng ngôn ngữ đó. Thông báo của một điện thoại đi qua Apple hoặc Google chỉ với taf nào và điều nó muốn, và trong thông báo của một cánh cửa, tên hoặc địa chỉ email của người đã viết: không bao giờ là số tiền hay chi tiết của một yêu cầu. Ứng dụng thêm những thứ đó ngay trên thiết bị, từ KIFF, nên thông báo của một điện thoại đã mở khóa có thể hiển thị số tiền, một người bán hoặc một người. Trên điện thoại Android bị khóa, nó chỉ hiển thị “Một taf cần bạn”, và trên iPhone bị khóa cũng vậy, trừ khi bạn đã đặt phần xem trước của nó luôn hiển thị.  <strong>Đồng hồ của bạn:</strong> một chiếc đồng hồ không giữ mật khẩu hay khóa, chỉ nói chuyện với điện thoại đã ghép đôi của bạn, và không bao giờ phê duyệt. Nó gửi những gì bạn nói cho Coach, hoặc cho taf bạn chọn, chỉ dưới dạng văn bản, qua điện thoại, sau khi bạn cho phép AI. Dịch vụ nhận dạng giọng nói riêng của đồng hồ, của Apple hoặc Google, chuyển lời bạn thành văn bản đó. Trên Wear OS, nếu nó dừng trước khi bạn nói xong, trình nhận dạng của chính điện thoại bạn làm việc đó thay, ngay trên điện thoại. Đồng hồ chỉ có thể từ chối, dừng hoặc gửi cho Coach hay một taf khi nó có khóa màn hình hoặc mật mã và đang được mở khóa. Những gì bạn gửi cho một taf đi vào cuộc trò chuyện riêng của taf đó, như thể bạn viết trên điện thoại. Cuộc trò chuyện của một taf, gồm cả số tiền, chỉ hiện trên đồng hồ khi nó đang mở, đọc qua điện thoại mỗi lần; đồng hồ không giữ gì trong đó. <strong>Apple Watch:</strong> nó hiển thị các taf của bạn và các trang của chúng mà không lưu giữ. Nó chỉ giữ Hộp thư đến của bạn, trong một tệp nó không đọc được khi bị khóa: mỗi lệnh gọi bị giữ dưới dạng tên taf của nó và điều nó yêu cầu, không bao giờ là số tiền, và các trả lời của Coach cho những gì bạn gửi từ đồng hồ, dưới dạng văn bản. Nếu bạn đăng xuất trên đồng hồ, nó cũng giữ việc bạn đã làm vậy, cho đến khi bạn đăng nhập lại trên đồng hồ. Ngoài ra, nó không giữ gì trừ khi đồng hồ có mật mã. Hộp thư đến biến mất khi bạn đăng xuất trên đồng hồ hoặc iPhone của bạn đăng xuất, hoặc lần tới ứng dụng mở hay đóng mà không có mật mã. Nó không ghi âm, và các thông báo duy nhất nó hiển thị là của iPhone của bạn. <strong>Wear OS:</strong> nó hiển thị email tài khoản của bạn và lịch hôm nay mà không lưu giữ. Để mở ngay lập tức, nó giữ, được mã hóa, số lượng những gì đang chờ bạn, và tên của mỗi taf cùng việc nó đã bị dừng hay tạm dừng: không bao giờ là số tiền, chi tiết của một lệnh gọi bị giữ hay cuộc trò chuyện của một taf. Dữ liệu đó bị xóa khi bạn đăng xuất, khi đồng hồ khóa hoặc rời khỏi cổ tay bạn, và sau 24 giờ. Nó giữ Hộp thư đến của bạn, trong đó mỗi dòng là tên một taf và điều nó nói, không bao giờ là số tiền, và một tin nhắn giữ lại để gửi sau, dưới dạng văn bản. Đăng xuất, trên đồng hồ hoặc trên điện thoại, xóa tất cả. Cho ô (tile) của nó, nó cũng giữ số lượng những gì đang chờ bạn, chỉ hiện khi đồng hồ được mở khóa, và bị xóa khi bạn đăng xuất, hoặc lần tới ô hiện khi đồng hồ đang khóa hay không có khóa màn hình. Sau khi bạn đăng xuất trên đồng hồ, nó giữ một ghi chú rằng bạn đã làm vậy, cho đến khi bạn đăng nhập lại. Hộp thư đến cũng biến mất lần tới ứng dụng mở hay đóng khi đồng hồ đang khóa hoặc không có khóa màn hình. Một tin nhắn giữ lại để gửi sau ở nguyên cho đến khi bạn gửi hoặc xóa, vì bạn đã yêu cầu gửi nó. Nếu dịch vụ nhận dạng giọng nói của đồng hồ dừng trước khi bạn nói xong, đồng hồ gửi bản ghi cho điện thoại của bạn, nơi chuyển nó thành văn bản ngay trên điện thoại, không bao giờ trên máy chủ. Bản ghi bị xóa trên cả hai, khi văn bản đã về hoặc bạn hủy, và nhiều nhất sau 2 phút. Chỉ văn bản đi tiếp đến Coach hoặc taf của bạn. Kết quả của một taf có thể ở lại trong thông báo của đồng hồ cho đến khi bạn bỏ qua nó hoặc đăng xuất trên đồng hồ. Trên PC Windows, máy tính Linux hoặc Mac có ứng dụng macOS 12, thông báo do chính ứng dụng tạo khi nó chạy, không có mã thông báo đẩy và không qua công ty nào khác. Trên Windows và Linux chúng hiển thị taf nào, nó muốn làm gì, số tiền, vì sao và đến khi nào; trên ứng dụng macOS 12 chúng hiển thị lời của KIFF cho lệnh gọi, sau khi bạn bật chúng, và màn hình khóa hiển thị những gì cài đặt xem trước của Mac cho phép. Trên Windows chúng tắt cho đến khi bạn bật, và chỉ hiển thị “Một taf cần bạn” khi màn hình bị khóa. Một thông báo hiện trước khi màn hình khóa giữ chi tiết của nó trong danh sách thông báo của Windows. Trên Linux chúng bật cho đến khi bạn tắt, và màn hình khóa hiển thị gì phụ thuộc vào máy tính để bàn của bạn. khi bạn kết nối một công cụ, bạn đăng nhập tại nhà cung cấp của chính công cụ đó. Với một ứng dụng planque tự đăng nhập, như Stripe, hoặc một khóa bạn đưa, planque giữ mã thông báo hoặc khóa đó cho công ty bạn, được mã hóa. Với một kết nối được quản lý, Composio, dịch vụ kết nối mà planque làm việc cùng, giữ thông tin đăng nhập, và planque chỉ giữ bản ghi của kết nối và các công cụ bạn đã phê duyệt (tất cả với tư cách bên xử lý, xem bên dưới). Bản ghi của một kết nối có thể gồm tài khoản mà nó đăng nhập (tên hoặc email của nó), để ứng dụng cho bạn thấy đó là tài khoản nào. KIFF chỉ dùng các kết nối được quản lý cho những ứng dụng nêu tại <a href="/subprocessors#composio">/subprocessors</a> (bằng tiếng Anh). Ứng dụng không có trình theo dõi phân tích hay quảng cáo.
			</li>
			<li>
				<strong>Giao dịch mua trên App Store</strong> — khi bạn mua Solo hoặc một gói tín dụng trong tafs, Apple bán nó cho bạn: Apple là người bán được ghi nhận, thu tiền và giữ thông tin thanh toán của bạn. Apple cho chúng tôi biết đã mua gì, cho tài khoản KIFF nào (một mã ngẫu nhiên mà ứng dụng gắn vào giao dịch), khi nào, mã giao dịch của Apple, và với Solo thì khi nào kỳ hạn kết thúc hoặc gia hạn. Chúng tôi dùng nó để thêm tín dụng hoặc gói vào tài khoản của bạn. Apple không cung cấp cho chúng tôi Apple ID, tên, địa chỉ email hay thẻ của bạn.
			</li>
			<li>
				<strong>Giao dịch mua trên Google Play</strong> — trên Android, các giao dịch mua tương tự đi qua thanh toán của Google Play: Google thu tiền và giữ thông tin thanh toán của bạn. Google cho chúng tôi biết đã mua gì, cho tài khoản KIFF nào (cùng mã ngẫu nhiên đó), khi nào, mã thông báo và mã đơn hàng của giao dịch, và với Solo thì khi nào kỳ hạn kết thúc hoặc gia hạn, và chúng tôi dùng nó theo cách tương tự. Google không cung cấp cho chúng tôi tài khoản Google, tên, địa chỉ email hay thẻ của bạn.
			</li>
		</ul>
	</section>
}

templ privacyLawfulBasesVI() {
	<section id="lawful-bases">
		<h2>5. Cơ sở pháp lý cho việc xử lý</h2>
		<p>
			Theo Điều 6 của GDPR, chúng tôi dựa vào các cơ sở pháp lý sau:
		</p>
		<ul>
			<li>
				<strong>Thực hiện hợp đồng</strong> (Điều 6(1)(b)) — để tạo tài khoản, xác thực, vận hành môi trường chạy thay mặt bạn, thanh toán (khi hoạt động) và các giao diện dịch vụ cốt lõi.
			</li>
			<li>
				<strong>Lợi ích hợp pháp</strong> (Điều 6(1)(f)) — cho an ninh, phòng chống gian lận, phát hiện lạm dụng, đo lường vận hành và bảo vệ dịch vụ. Chúng tôi cân nhắc lợi ích của mình với quyền của bạn và sẽ cho bạn biết khi có yêu cầu bài kiểm tra cân bằng đó cho ra kết quả gì.
			</li>
			<li>
				<strong>Sự đồng ý</strong> (Điều 6(1)(a)) — cho AI trong ứng dụng tafs: những gì được gửi đến mô hình AI chạy Coach và các taf của bạn, như mô tả <a href="#ai-in-tafs">bên dưới</a>. Không có gì được gửi cho đến khi bạn cho phép, và bạn có thể rút lại trong Tài khoản. Sự đồng ý cũng là điều chúng tôi sẽ xin trước bất kỳ cookie phân tích nào, thông tin tiếp thị tùy chọn hoặc việc xử lý mới mở rộng đáng kể cách chúng tôi dùng dữ liệu của bạn. Chúng tôi không chạy phân tích, quảng cáo hay theo dõi không thiết yếu nào.
			</li>
			<li>
				<strong>Nghĩa vụ pháp lý</strong> (Điều 6(1)(c)) — cho hồ sơ thuế (Luật Kế toán Estonia §12, 7 năm), phản hồi các yêu cầu hợp pháp của cơ quan có thẩm quyền, và việc lưu giữ theo quy định phòng chống rửa tiền khi áp dụng.
			</li>
		</ul>
		<h3 id="ai-in-tafs">AI trong ứng dụng tafs</h3>
		<p>Ứng dụng tafs hỏi bạn trước khi bất cứ thứ gì được gửi đến AI, bằng những lời này:</p>
		<ul>
			<li>tafs dùng AI Claude của Anthropic cho Coach và các taf của bạn.</li>
			<li>Coach và các taf của bạn là các tác nhân AI: những gì chúng viết do AI tạo ra và có thể sai. Một tin nhắn một taf gửi ra ngoài công ty bạn nói rằng nó do một tác nhân AI viết.</li>
			<li>Những gì được gửi đến đó: những gì bạn viết cho Coach và các taf của bạn, các tệp bạn đính kèm, những gì các ứng dụng bạn đã kết nối trả về cho một taf khi nó làm việc, và những gì có trên màn hình của bạn khi Coach giúp bạn trong ứng dụng.</li>
			<li>Những gì không bao giờ được gửi: mật khẩu và khóa mà các ứng dụng bạn đã kết nối dùng, hoặc vân tay của bạn.</li>
			<li>Anthropic dùng nó để trả lời và giữ tối đa 30 ngày.</li>
			<li>Không có gì được gửi cho đến khi bạn cho phép. Bạn có thể rút lại trong Tài khoản.</li>
		</ul>
		<p>Một taf chạy khi lúc đó không có ai ở đó (theo lịch của nó, hoặc khi có gì đến) dựa trên sự đồng ý của người đã tạo ra nó hoặc tiếp quản nó, hoặc nếu không thì của người đầu tiên quản lý các taf của tài khoản cho phép.</p>
		<p><strong>Khi bạn rút lại,</strong> Coach và các taf của bạn ngừng trả lời bạn. Một taf có các lần chạy dựa trên sự đồng ý của bạn sẽ tạm dừng: lịch của nó dừng, và những gì đến sẽ chờ. Nó tiếp tục khi sự đồng ý được cho lại, hoặc khi một người quản lý các taf của tài khoản tiếp quản nó bằng sự đồng ý của chính họ. Việc rút lại không thay đổi những gì đã được gửi trước đó.</p>
		<p>Anthropic được nêu tại <a href="/subprocessors">/subprocessors</a> (bằng tiếng Anh), cùng nơi nó xử lý và khi nào nó có thể giữ dữ liệu lâu hơn.</p>
	</section>
}

templ privacySubprocessorsVI() {
	<section id="sub-processors">
		<h2>6. Bên xử lý phụ</h2>
		<p>Chúng tôi không bán dữ liệu cá nhân của bạn, và không chia sẻ để quảng cáo.</p>
		<p>
			Chúng tôi thuê một số ít nhà cung cấp để cung cấp dịch vụ. Danh sách chính thức, hiện hành nằm tại <a href="/subprocessors">/subprocessors</a> (bằng tiếng Anh); trang đó được cập nhật trong vòng 30 ngày sau mọi thay đổi. Chúng tôi yêu cầu mỗi bên xử lý phụ cung cấp các biện pháp bảo vệ tương đương của chúng tôi theo thỏa thuận bằng văn bản, gồm cả Điều khoản hợp đồng tiêu chuẩn của EU khi dữ liệu cá nhân rời khỏi EU.
		</p>
		<p>
			Việc bổ sung hoặc thay thế đáng kể các bên xử lý phụ ảnh hưởng đến dữ liệu cá nhân được thông báo trước cho khách hàng đang hoạt động, kèm quyền phản đối.
		</p>
	</section>
}

templ privacyTransfersVI() {
	<section id="transfers">
		<h2>7. Chuyển giao quốc tế</h2>
		<p>
			Một số bên xử lý phụ của chúng tôi được thành lập ngoài Khu vực Kinh tế Châu Âu, chủ yếu tại Hoa Kỳ. Với mỗi chuyển giao như vậy, chúng tôi dựa vào ít nhất một trong các biện pháp bảo vệ sau:
		</p>
		<ul>
			<li>
				<strong>Khung quyền riêng tư dữ liệu EU–Hoa Kỳ</strong> — cho các bên xử lý phụ của Hoa Kỳ đã chứng nhận theo Khung. Quyết định về mức độ đầy đủ có hiệu lực từ giữa năm 2023; chúng tôi theo dõi mọi thay đổi về tình trạng của nó.
			</li>
			<li>
				<strong>Điều khoản hợp đồng tiêu chuẩn</strong> — mô-đun 2 (từ bên kiểm soát đến bên xử lý) cho các bên xử lý phụ trực tiếp của chúng tôi và mô-đun 3 (từ bên xử lý đến bên xử lý phụ) khi áp dụng các bên xử lý nối tiếp. Chúng tôi dùng SCC năm 2021 do Ủy ban phê duyệt.
			</li>
			<li>
				<strong>Biện pháp bổ sung</strong> — khi đánh giá rủi ro cho thấy cần thêm biện pháp bảo vệ (mã hóa khi truyền và khi lưu, ghi nhật ký truy cập, tối thiểu hóa dữ liệu).
			</li>
		</ul>
		<p>
			Bạn có thể yêu cầu công cụ chuyển giao cụ thể áp dụng cho một bên xử lý phụ nhất định bằng cách gửi email đến <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
		<p><strong>Quốc gia của bạn.</strong> Luật của một số quốc gia đòi hỏi nhiều hơn những gì chính sách này nêu. Những gì họ bổ sung, bằng tiếng Anh và bằng ngôn ngữ của quốc gia đó, nằm ở <a href="/privacy/countries">Quốc gia của bạn</a> (bằng tiếng Anh).</p>
	</section>
}

templ privacyRetentionVI() {
	<section id="retention">
		<h2>8. Lưu giữ</h2>
		<p>
			Chúng tôi lưu giữ dữ liệu cá nhân trong thời gian ngắn nhất phù hợp với mục đích xử lý và mọi nghĩa vụ pháp lý hiện hành.
		</p>
		<ul>
			<li>
				<strong>Siêu dữ liệu tài khoản và đăng nhập</strong> — cho đến khi tài khoản bị xóa. Trong ứng dụng tafs, chủ sở hữu xóa nó tại Tài khoản → <em>Xóa tài khoản</em>. Tài khoản tạo trên web được xóa bằng cách gửi email đến <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>, trong thời hạn một tháng theo Điều 12(3) GDPR. Dù thế nào, các khóa của tài khoản dừng ngay. Nếu xóa trong ứng dụng tafs, không thể hoàn tác: các cuộc trò chuyện, ghi chú và kết nối tafs của nó bị xóa ngay, và những gì KIFF giữ bị xóa trong 30 ngày. Nếu xóa trên web, chúng tôi giữ dữ liệu của nó trong thời gian ân hạn 30 ngày, phòng khi chủ sở hữu muốn lấy lại, rồi xóa.
			</li>
			<li>
				<strong>Bản ghi khóa API</strong> — cho đến khi tài khoản bị xóa, kể cả sau khi một khóa bị thu hồi. Một khóa thuộc về kết nối đăng nhập của tác nhân bị xóa cùng kết nối đó, 30 ngày sau khi nó kết thúc.
			</li>
			<li>
				<strong>Cookie phiên</strong> — cho đến khi hết hạn (mặc định 24 giờ) hoặc cho đến khi bạn đăng xuất.
			</li>
			<li>
				<strong>Nhật ký truy cập reverse-proxy</strong> — tối đa 90 ngày, rồi được tổng hợp hoặc xóa.
			</li>
			<li>
				<strong>Nhật ký dịch vụ</strong> — những gì các dịch vụ của KIFF và planque ghi lại khi chạy: lỗi, và yêu cầu, có thể nêu tên một tài khoản, một người hoặc một tác nhân. 30 ngày, rồi xóa.
			</li>
			<li>
				<strong>Sao lưu</strong> — cơ sở dữ liệu của KIFF được sao lưu hằng ngày, mã hóa, và mỗi bản sao lưu được giữ 7 ngày, nên một bản ghi đã xóa biến mất khỏi chúng trong 7 ngày. Các kho của tafs và planque giữ các bản sao theo thời điểm đã mã hóa trong 35 ngày, chỉ dùng để khôi phục một kho sau sự cố, nên một bản ghi đã xóa biến mất khỏi chúng trong 35 ngày.
			</li>
			<li>
				<strong>Dữ liệu kiểm toán của tenant</strong> — được giữ với tư cách bên xử lý theo cấu hình tenant của khách hàng. Mặc định: giữ trong suốt vòng đời của tenant; xóa khi tenant bị xóa. Xem <a href="/security#deletion">/security#deletion</a> (bằng tiếng Anh).
			</li>
			<li>
				<strong>Các lệnh gọi qua cổng KIFF</strong> — các đối số của một lệnh gọi cho đến khi nó được gửi, bị từ chối hoặc thất bại, rồi xóa; kết quả của công cụ trong 24 giờ, rồi xóa. Bản ghi quyết định và giá trị băm của các đối số được giữ như dữ liệu kiểm toán của tenant. Xem <a href="/security#data-kept">/security#data-kept</a> (bằng tiếng Anh).
			</li>
			<li>
				<strong>Mức sử dụng</strong> — với mỗi lệnh gọi qua cổng, khi nó kết thúc: tác nhân nào thực hiện, công cụ, và nó được tính là một hành động hay miễn phí (và vì sao). Với mỗi lần chạy của một taf hoặc của Coach, khi nó kết thúc: taf, khi nào, các tín dụng AI của nó đã dùng, và chúng có được tính hay vì sao không. Cho đến khi tài khoản bị xóa; những gì báo cáo cho bên xử lý thanh toán của chúng tôi để lập hóa đơn được giữ cùng hồ sơ thanh toán.
			</li>
			<li>
				<strong>Kết nối đăng nhập của tác nhân</strong> — tác nhân nào, tên ứng dụng, ai cho phép, khi nào, và lần dùng cuối: khi kết nối còn hoạt động, rồi 30 ngày sau khi nó kết thúc (nó vẫn được liệt kê trong bảng điều khiển trong thời gian đó), rồi bị xóa cùng các mã thông báo và khóa API của nó. Tất cả được xóa cùng tài khoản.
			</li>
			<li>
				<strong>tafs</strong> — mã thông báo đẩy của một thiết bị cho đến khi bạn đăng xuất khỏi ứng dụng, gỡ thiết bị, hoặc Apple hay Google báo mã thông báo đã mất. Khóa công khai, tên, nền tảng và ngày của một thiết bị khi bạn còn dùng nó; khi bạn đăng xuất nó, nó được đánh dấu đã gỡ và giữ cho đến khi tài khoản bị xóa, để KIFF có thể từ chối một câu trả lời muộn từ nó và cho biết thiết bị nào đã ký một câu trả lời trước. Khóa công khai, mã định danh và tên của một khóa truy cập được giữ như của thiết bị của nó. Một máy tính giữ phiên của nó tối đa 90 ngày, hoặc cho đến khi bạn đăng xuất. Những gì tafs giữ cho công ty bạn được giữ với tư cách bên xử lý: các lần chạy và cuộc trò chuyện của một taf, cùng bản tóm tắt của cuộc trò chuyện (và của Setup), trong 30 ngày, những gì công cụ của bạn trả về chỉ cho đến khi một lần chạy kết thúc (trong một cuộc trò chuyện, những gì nó chỉ đọc được giữ mã hóa cho các tin nhắn tiếp theo, dùng cho đến khi cuộc trò chuyện nhàn rỗi một giờ và tối đa bốn giờ sau khi đọc, rồi tự động xóa, trong vài ngày), và các ghi chú bộ nhớ của nó cho đến khi taf bị gỡ bỏ; các tệp nó giao 30 ngày kể từ lần chạy đã tạo ra chúng, rồi tự động xóa trong vòng một ngày, hoặc sớm hơn nếu ai đó trong tài khoản của bạn xóa một tệp; mã thông báo hoặc khóa của một kết nối trong planque, hoặc thông tin đăng nhập của một kết nối được quản lý tại Composio, cho đến khi bạn ngắt nó (nếu một kết nối khác của bạn có thể dùng cùng tài khoản đó ở nhà cung cấp, nó được giữ không dùng cho đến khi kết nối kia cũng bị ngắt), và bản ghi các phê duyệt của nó cho đến khi tài khoản kết thúc; xem <a href="/legal/dpa#annex-4">Phụ lục 4 của DPA</a> (bằng tiếng Anh).
			</li>
			<li>
				<strong>Hồ sơ thanh toán</strong> — 7 năm kể từ cuối năm tài chính (Luật Kế toán Estonia §12).
			</li>
			<li>
				<strong>Giao dịch mua trên App Store và Google Play</strong> — những gì Apple hay Google cho chúng tôi biết về mỗi giao dịch mua ở lại trong tài khoản của bạn cho đến khi tài khoản bị xóa. Các báo cáo bán hàng và chi trả của họ, mà chúng tôi giữ như hồ sơ thanh toán trong 7 năm, không nêu tên bạn.
			</li>
			<li>
				<strong>Thư từ hỗ trợ</strong> — 3 năm kể từ lần tương tác cuối, rồi xóa.
			</li>
		</ul>
	</section>
}

templ privacyRightsVI() {
	<section id="rights">
		<h2>9. Quyền của bạn</h2>
		<p>
			Theo GDPR, bạn có các quyền sau đối với dữ liệu cá nhân của bạn:
		</p>
		<ul>
			<li><strong>Truy cập</strong> (Điều 15) — xác nhận chúng tôi có xử lý dữ liệu của bạn hay không, và một bản sao.</li>
			<li><strong>Chỉnh sửa</strong> (Điều 16) — sửa dữ liệu không chính xác hoặc không đầy đủ.</li>
			<li><strong>Xóa</strong> (Điều 17) — xóa dữ liệu của bạn, trừ các ngoại lệ về lưu giữ theo luật.</li>
			<li><strong>Hạn chế</strong> (Điều 18) — tạm dừng xử lý trong khi một tranh chấp được giải quyết.</li>
			<li><strong>Khả năng di chuyển</strong> (Điều 20) — bản xuất dữ liệu bạn cung cấp ở dạng máy đọc được.</li>
			<li><strong>Phản đối</strong> (Điều 21) — đối với việc xử lý dựa trên lợi ích hợp pháp; chúng tôi dừng trừ khi có thể chứng minh các lý do áp đảo.</li>
			<li><strong>Rút lại sự đồng ý</strong> (Điều 7(3)) — với mọi việc xử lý dựa trên sự đồng ý, như AI trong ứng dụng tafs (trong Tài khoản, như <a href="#ai-in-tafs">ở trên</a>). Việc rút lại không ảnh hưởng đến việc xử lý hợp pháp trước đó.</li>
		</ul>
		<p>
			Để thực hiện bất kỳ quyền nào trong số này, hãy gửi email đến <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>. Chúng tôi trả lời trong một tháng theo Điều 12(3); chúng tôi có thể gia hạn thêm tối đa hai tháng cho các yêu cầu phức tạp và sẽ báo cho bạn nếu làm vậy.
		</p>
		<h3 id="export-chats">Các cuộc trò chuyện tafs của chính bạn</h3>
		<p>
			Trong ứng dụng tafs, Tài khoản → Xuất cuộc trò chuyện của tôi tải xuống các cuộc trò chuyện của chính bạn với từng taf, gồm cả của Coach, tên các tệp bạn đã đính kèm, và ghi chú của chính bạn, dưới dạng tệp đọc được và JSON. Chỉ bạn mới xuất được: quản trị viên hay chủ sở hữu tài khoản không thể, và bản xuất tài khoản của KIFF không gồm chúng.
		</p>
		<h3 id="delete-account">Xóa tài khoản tafs của bạn</h3>
		<p>
			tafs là ứng dụng của KIFF. Để xóa tài khoản tafs của bạn và dữ liệu của nó:
		</p>
		<ol>
			<li>Mở ứng dụng tafs và đăng nhập.</li>
			<li>Vào Tài khoản, rồi chạm <em>Xóa tài khoản</em>.</li>
			<li>Xác nhận. Xóa một tài khoản không thể hoàn tác.</li>
		</ol>
		<p>
			<em>Xóa tài khoản</em> hiện cho bất kỳ ai được phép xóa tài khoản của công ty, thường là chủ sở hữu. Nếu bạn không thấy nó, hoặc không còn ứng dụng, hãy gửi email đến <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> từ địa chỉ bạn dùng để đăng nhập, và chúng tôi xóa dữ liệu của bạn trong một tháng.
		</p>
		<p>
			Những gì bị xóa: các khóa của tài khoản dừng ngay. Các taf, cuộc trò chuyện, ghi chú, tệp đính kèm và kết nối của nó bị xóa ngay, và khỏi các bản sao theo thời điểm của chúng trong vòng 35 ngày. Những gì KIFF giữ cho tài khoản bị xóa trong 30 ngày, và khỏi các bản sao lưu trong 7 ngày sau đó. Nhật ký dịch vụ nêu tên tài khoản biến mất trong 30 ngày. Dữ liệu kiểm toán của tenant bị xóa cùng tenant. Xem <a href="#retention">Lưu giữ</a> cho từng loại dữ liệu.
		</p>
		<p id="delete-data">
			Để xóa một phần dữ liệu của bạn và giữ tài khoản: trong ứng dụng, xóa một cuộc trò chuyện, và tin nhắn cùng tệp đính kèm của nó đi theo; gỡ một taf, và các cuộc trò chuyện, ghi chú và kết nối của nó đi theo. Với bất cứ điều gì khác, hãy gửi email đến <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> và nói cần xóa gì. Chúng tôi làm trong một tháng.
		</p>
		<p>
			Bạn có quyền khiếu nại với một cơ quan giám sát. Cơ quan giám sát chính của chúng tôi là <a href="https://www.aki.ee/en" target="_blank" rel="noopener">Cơ quan Thanh tra Bảo vệ Dữ liệu Estonia (Andmekaitse Inspektsioon)</a>. Bạn cũng có thể khiếu nại với cơ quan giám sát ở quốc gia thành viên nơi bạn cư trú.
		</p>
		<p><strong>Quốc gia của bạn.</strong> Luật của một số quốc gia đòi hỏi nhiều hơn những gì chính sách này nêu. Những gì họ bổ sung, bằng tiếng Anh và bằng ngôn ngữ của quốc gia đó, nằm ở <a href="/privacy/countries">Quốc gia của bạn</a> (bằng tiếng Anh).</p>
	</section>
}

templ privacyCookiesVI() {
	<section id="cookies">
		<h2>10. Cookie</h2>
		<p>
			Chúng tôi đặt ba cookie, tất cả đều hoàn toàn cần thiết, của bên thứ nhất, chỉ gửi qua HTTPS và các tập lệnh trên trang không đọc được. Theo quy định ePrivacy của EU, chúng không cần sự đồng ý; chúng tôi liệt kê để bạn biết chúng tồn tại. <a href="/cookies">Chính sách cookie</a> (bằng tiếng Anh) có chi tiết.
		</p>
		<ul>
			<li>
				<strong><code>kiff_session</code></strong> — giữ bạn đăng nhập. Một cookie phiên có chữ ký mang mã đăng nhập, email và tên của bạn, và thông tin xác thực bảng điều khiển dùng cho bạn. Được đặt cho <code>.kiff.dev</code>. Kéo dài 24 giờ, hoặc cho đến khi bạn đăng xuất.
			</li>
			<li>
				<strong><code>kiff_flash</code></strong> — mang một thông báo dùng một lần đến trang kế tiếp, như “khóa của bạn đã được tạo”. Có chữ ký; khóa mới không bao giờ nằm trong đó. Được đặt cho <code>.kiff.dev</code>. Bị xóa khi trang kế tiếp đọc nó, và tối đa 5 phút.
			</li>
			<li>
				<strong><code>kiff_cb_attempts</code></strong> — đếm số lần trang đăng nhập đã tải lại, để một lần đăng nhập bị lặp sẽ bị dừng. Chỉ gửi đến trang đó. Kéo dài 5 phút, và bị xóa khi một lần đăng nhập bắt đầu hoặc thành công.
			</li>
		</ul>
		<p>
			Chúng tôi không dùng cookie phân tích, cookie quảng cáo hay bất kỳ trình theo dõi bên thứ ba nào. Nếu sau này chúng tôi thêm, chúng tôi sẽ hiển thị một biểu ngữ đồng ý trước khi cookie được đặt, theo ePrivacy và hướng dẫn năm 2023 của EDPB về công nghệ theo dõi.
		</p>
		<p>
			Nếu bạn đăng nhập qua Clerk (bên xử lý phụ xác thực của chúng tôi), Clerk cũng đặt cookie trên tên miền giao diện riêng của nó (<code>clerk.kiff.dev</code>). Các cookie đó cần thiết để Clerk nhận ra bạn trong luồng đăng nhập của nó và chịu sự điều chỉnh của chính sách quyền riêng tư của Clerk cũng như của chúng tôi. Xem danh sách bên xử lý phụ để biết chi tiết.
		</p>
	</section>
}

templ privacySecurityVI() {
	<section id="security">
		<h2>11. Bảo mật</h2>
		<p>
			Các biện pháp bảo mật kỹ thuật và tổ chức của chúng tôi được ghi tại <a href="/security">/security</a> (bằng tiếng Anh). Chúng gồm cách ly tenant ở lớp cơ sở dữ liệu, TLS 1.2+ khi truyền, mã hóa khi lưu theo mặc định của nhà cung cấp được quản lý, và kiểm soát truy cập dựa trên nguyên tắc đặc quyền tối thiểu.
		</p>
		<p>
			Chúng tôi thông báo cho khách hàng bị ảnh hưởng về một vụ vi phạm dữ liệu cá nhân không chậm trễ quá mức và trong vòng 72 giờ kể từ khi xác nhận, phù hợp với Điều 33 GDPR. Thông báo gồm bản chất của vụ vi phạm, các loại và số lượng ước tính của chủ thể dữ liệu và bản ghi liên quan, hậu quả có thể xảy ra, và các biện pháp đã hoặc dự kiến thực hiện.
		</p>
	</section>
}

templ privacyChildrenVI() {
	<section id="children">
		<h2>12. Trẻ em</h2>
		<p>
			KIFF Cloud là một sản phẩm hạ tầng cho nhà phát triển không hướng đến trẻ em. Chúng tôi không cố ý thu thập dữ liệu cá nhân từ trẻ em dưới 16 tuổi. Nếu bạn tin một đứa trẻ đã cung cấp dữ liệu cá nhân cho chúng tôi, hãy liên hệ <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> và chúng tôi sẽ xóa nó.
		</p>
	</section>
}

templ privacyAutomatedVI() {
	<section id="automated">
		<h2>13. Ra quyết định tự động</h2>
		<p>
			Môi trường chạy của KIFF Cloud đưa ra các quyết định chính sách mang tính xác định trên dữ liệu khách hàng của chúng tôi gửi. Đó không phải là các quyết định về bạn tạo ra hiệu lực pháp lý hay tác động đáng kể tương tự theo nghĩa của Điều 22 GDPR; đó là các quyết định về hành động của khách hàng (hoàn tiền, đơn hàng, tin nhắn, v.v.) được thực hiện theo chính sách của chính khách hàng.
		</p>
		<p>
			Khách hàng dùng KIFF Cloud để đưa ra quyết định ảnh hưởng đến người dùng cuối của chính họ tự chịu trách nhiệm tuân thủ Điều 22. Biên nhận quản trị của chúng tôi được thiết kế để cung cấp cho các khách hàng đó dấu vết kiểm toán họ cần để chứng minh sự giám sát của con người, nhưng nghĩa vụ pháp lý cung cấp sự giám sát đó thuộc về khách hàng.
		</p>
	</section>
}

templ privacyChangesVI() {
	<section id="changes">
		<h2>14. Thay đổi đối với chính sách này</h2>
		<p>
			Chúng tôi có thể cập nhật chính sách này theo thời gian. Các thay đổi đáng kể được thông báo qua email cho khách hàng đang hoạt động và bằng một biểu ngữ nổi bật trên trang này trong ít nhất 30 ngày. Các thay đổi không đáng kể được đăng với ngày “cập nhật lần cuối” mới.
		</p>
	</section>
}

