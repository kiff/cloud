package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsPrivacySQ is tafs's privacy policy (/tafs/privacy) in Albanian, at /sq/tafs/privacy.
// It is a translation of TafsPrivacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Albanian has the legal
// texts only, so a link to any other page goes to English and says so.
templ TafsPrivacySQ() {
	@components.LayoutSiteWithMeta("politika e privatësisë e tafs", "Si i trajton tafs, aplikacioni i KIFF, të dhënat personale, përfshirë të dhënat që merr nga Google kur lidhni llogarinë tuaj Google.", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · politika e privatësisë</p>
				<h1>Politika e privatësisë e tafs</h1>
				<p class="legal-meta"><strong>Përditësuar së fundi:</strong> 24 nëntor 2026.</p>
				<p class="legal-disclaimer">Kjo politikë shpjegon si i trajton tafs, aplikacioni i KIFF për iPhone, iPad, Android dhe kompjuterë, të dhënat personale. tafs është pjesë e KIFF Cloud, kështu që edhe <a href="/sq/privacy">Politika e privatësisë e KIFF</a> zbatohet për të, dhe për çdo gjë që kjo faqe nuk mbulon. Pyetje: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.</p>
			</header>
			<section id="who-we-are">
				<h2>1. Kush jemi</h2>
				<p>tafs ofrohet nga <strong>Kiff Agents OÜ</strong>, një shoqëri private me përgjegjësi të kufizuar e themeluar në Estoni (kodi i regjistrit 17372313, numri i TVSH EE102924327), në Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estoni. Rregullorja e Përgjithshme e BE-së për Mbrojtjen e të Dhënave (GDPR) zbatohet për përpunimin tonë.</p>
			</section>
			<section id="scope">
				<h2>2. Çfarë mbulon kjo politikë</h2>
				<p>Aplikacioni tafs për iPhone, iPad, Android dhe kompjuterë (Mac, Windows dhe Linux), dhe shërbimi pas tij, përfshirë Setup, që lidh mjetet e një kompanie, dhe planque, që i ruan ato lidhje. Në tafs, një kompani ia beson një punë një agjenti AI, një taf-i, që punon brenda KIFF Card-eve.</p>
			</section>
			<section id="roles">
				<h2>3. Rolet tona</h2>
				<p>Jemi <strong>kontrolluesi</strong> i llogarisë dhe të dhënave tuaja të hyrjes, dhe i të dhënave operative të shërbimit tonë. Veprojmë si <strong>përpunues</strong>, në emër të kompanisë suaj, për atë që tafs ruan për të: ekzekutimet, bisedat, raportet, shënimet e kujtesës të çdo taf-i dhe skedarët që dorëzojnë. Kompania juaj është kontrolluesi i atyre të dhënave, dhe <a href="/legal/dpa">DPA</a> (në anglisht) e rregullon atë marrëdhënie.</p>
			</section>
			<section id="data">
				<h2>4. Çfarë mbledh tafs</h2>
				<ul>
					<li><strong>Llogaria juaj:</strong> hyni në tafs me llogarinë tuaj KIFF. Në një telefon ose tablet aplikacioni e mban sesionin tuaj në Keychain të pajisjes (në Android, në hapësirën e saj të enkriptuar). Në një kompjuter e mban të vulosur për llogarinë tuaj të përdoruesit: në një PC Windows me mbrojtjen e vet të të dhënave të Windows, në Linux në keyring-un tuaj, në Mac në Keychain-in e tij. Sesioni i një kompjuteri zgjat deri në 90 ditë.</li>
					<li><strong>Pajisja juaj:</strong> aplikacioni krijon një çelës nënshkrimi që nuk e lë kurrë pajisjen: në Secure Enclave të një iPhone, iPad ose Mac, në Keystore të një pajisjeje Android ose në TPM të një PC Windows. Në Linux, dhe në një Mac pa Secure Enclave, çelësi është një çelës softuerik i mbajtur në keyring-un ose Keychain-in tuaj, dhe ai kompjuter mund të tregojë çfarë ju pret por jo ta miratojë; miratoni në telefonin tuaj{ macSecurityKey("sq") }. Një PC Windows pa TPM nuk mund të hyjë në tafs. KIFF ruan gjysmën publike të çelësit, emrin dhe platformën e pajisjes dhe kur u shtua e kur u përdor së fundi, që të mund të kontrollojë përgjigjet tuaja ndaj thirrjeve të mbajtura dhe miratimet tuaja të lidhjeve.</li>
					<li><strong>Ora juaj:</strong> një orë nuk mban fjalëkalim ose çelës, flet vetëm me telefonin tuaj të çiftuar dhe nuk miraton kurrë. Dërgon atë që thoni te Coach, ose te taf-i që zgjodhët, vetëm si tekst, përmes telefonit, pasi të keni lejuar AI-n. Shërbimi i vet i të folurit i orës, i Apple ose i Google, i kthen fjalët tuaja në atë tekst. Në Wear OS, nëse ndalon para se të mbaroni, e bën në vend të tij njohësi i vetë telefonit tuaj, në telefon. Mund të refuzojë, të ndalojë ose të dërgojë te Coach ose një taf vetëm kur ka kyçje ekrani ose kod dhe është i zhbllokuar. Ajo që i dërgoni një taf-i shkon në bisedën e vet të atij taf-i, sikur ta kishit shkruar në telefon. Biseda e një taf-i, përfshirë shumat, lexohet përmes telefonit sa herë që hapet, dhe ora mban vetëm mesazhet e fundit që përshkruan seksioni i saj më poshtë.</li>
					<li><strong>Apple Watch:</strong> tregon taf-et tuaja dhe faqet e tyre pa i mbajtur. Mban Kutinë tuaj, në një skedar që nuk mund ta lexojë kur është i kyçur: çdo thirrje e mbajtur si emri i taf-it të saj dhe çfarë kërkon, kurrë një shumë, dhe përgjigjet e Coach ndaj asaj që dërguat nga ora, si tekst. Nëse dilni në orë, mban edhe faktin që dolët, derisa të hyni përsëri në orë. Veç kësaj, nuk mban asgjë nëse ora nuk ka kod. Kutia hiqet kur dilni në orë ose iPhone-i juaj del, ose herën tjetër që aplikacioni hapet ose mbyllet pa kod. Nuk bën asnjë regjistrim, dhe të vetmet njoftime që tregon janë ato të iPhone-it tuaj. Që një bisedë të hapet menjëherë, mban edhe 30 mesazhet e fundit të secilës prej deri në 20 bisedave që keni hapur në të, të Coach-it dhe të tafs-ave tuaj, vetëm si tekst dhe kurrë një shumë, të kyçura si Kutia; fshihen kur fshihet Kutia dhe kur një bisedë nuk është hapur për 30 ditë. Nëse e ruani një mesazh për Coach për më vonë, ajo ruan edhe atë një mesazh, si tekst, në një skedar më vete, të kyçur si ai i Kutisë hyrëse, dhe e dërgon kur iPhone-i juaj të jetë sërish i disponueshëm. Fshihet pasi dërgohet, kur e fshini, kur ju ose iPhone-i juaj dilni, ose nëse ora nuk ka më kod kalimi.</li>
					<li><strong>Wear OS:</strong> tregon emailin e llogarisë suaj dhe kalendarin e sotëm pa i mbajtur. Që të hapet menjëherë, mban, të enkriptuar, numrin e asaj që ju pret dhe emrin e çdo taf-i dhe nëse është i ndaluar apo i pezulluar: kurrë një shumë, detajet e një thirrjeje të mbajtur ose bisedën e një taf-i. Kjo pastrohet kur dilni, kur ora kyçet ose i hiqet nga kyçi i dorës dhe pas 24 orësh. Mban Kutinë tuaj, ku çdo rresht është emri i një taf-i dhe ajo që thotë, kurrë një shumë, dhe një mesazh të ruajtur për më vonë, si tekst. Dalja, në orë ose në telefon, pastron gjithçka. Për pllakën e saj, mban edhe numrin e asaj që ju pret, të shfaqur vetëm kur ora është e zhbllokuar dhe pastruar kur dilni ose herën tjetër që pllaka shfaqet kur ora është e kyçur ose pa kyçje ekrani. Pasi dilni në orë, mban një shënim që dolët, derisa të hyni përsëri. Kutia hiqet edhe herën tjetër që aplikacioni hapet ose mbyllet kur ora është e kyçur ose pa kyçje ekrani. Një mesazh i ruajtur për më vonë qëndron derisa ta dërgoni ose ta fshini, pasi keni kërkuar të dërgohet. Nëse shërbimi i të folurit të orës ndalon para se të mbaroni, ora e dërgon regjistrimin te telefoni juaj, që e kthen në tekst në vetë telefonin, kurrë në një server. Regjistrimi fshihet në të dyja, sapo teksti kthehet ose anuloni, dhe pas 2 minutash më së shumti. Vetëm teksti shkon më tej te Coach ose taf-i juaj. Rezultati i një taf-i mund të qëndrojë në njoftimet e orës derisa ta hiqni ose të dilni në orë. Që një bisedë të hapet menjëherë, mban edhe 30 mesazhet e fundit të secilës prej deri në 20 bisedave që keni hapur në të, të Coach-it dhe të tafs-ave tuaj, vetëm si tekst dhe kurrë një shumë, të enkriptuara si Kutia; fshihen kur dilni, në orë ose në telefon, dhe kur një bisedë nuk është hapur për 30 ditë, dhe një orë pa kyçje ekrani nuk mban asnjë. Një mesazh i ruajtur për më vonë fshihet edhe nëse ora nuk ka më kyçje ekrani.</li>
					<li><strong>Passkey-t:</strong> kur miratoni me një passkey në kompjuterin tuaj, si Windows Hello ose një çelës sigurie, fytyra, gjurma e gishtit ose PIN-i juaj mbetet te sistemi i vetë kompjuterit. KIFF ruan çelësin publik të passkey-t, id-në e tij, një numërues dhe një emër, kurrë asgjë të fshehtë, dhe refuzon një passkey që sinkronizohet në pajisje të tjera.</li>
					<li><strong>Njoftimet:</strong> në një telefon, një tablet ose një Mac që ekzekuton aplikacionin iPad, kur i aktivizoni, ruajmë push token-in e pajisjes me id-në tuaj të personit në KIFF dhe gjuhën që aplikacioni tregoi. Njoftimi kalon përmes Apple ose Google vetëm me cili taf dhe çfarë dëshiron, dhe në njoftimin e një dere emrin ose adresën e emailit të atij që shkroi: kurrë një shumë ose detajet e një kërkese. Aplikacioni i shton ato në vetë pajisjen, nga KIFF, kështu që njoftimi i një telefoni të zhbllokuar mund të tregojë një shumë, një tregtar ose një person. Në një telefon Android të kyçur tregon vetëm „Një taf ka nevojë për ju“, dhe në një iPhone të kyçur po ashtu, përveç nëse keni vendosur që pamjet paraprake të shfaqen gjithmonë. Në një PC Windows, një kompjuter Linux ose një Mac me aplikacionin macOS 12, njoftimet i bën vetë aplikacioni ndërsa punon, pa push token dhe përmes asnjë kompanie tjetër. Në Windows dhe Linux tregojnë cili taf, çfarë dëshiron të bëjë, shumën, pse dhe deri kur; në aplikacionin macOS 12 tregojnë fjalët e KIFF për thirrjen, pasi t'i aktivizoni, dhe një ekran i kyçur tregon atë që lejon cilësimi i pamjes paraprake të Mac-ut. Në Windows janë të çaktivizuara derisa t'i aktivizoni, dhe tregojnë vetëm „Një taf ka nevojë për ju“ kur ekrani është i kyçur. Një njoftim i shfaqur para kyçjes së ekranit i mban detajet në listën e njoftimeve të Windows. Në Linux janë të aktivizuara derisa t'i çaktivizoni, dhe ajo që tregon një ekran i kyçur varet nga desktopi juaj.</li>
					<li><strong>Gjuha:</strong> shërbimi tafs ruan gjuhën e llogarisë, nga kush ka biseduar së fundi me Coach, deri në tre muaj, që raportet e një taf-i të vijnë në të.</li>
					<li><strong>Mjetet tuaja:</strong> kur lidhni një mjet, hyni te ofruesi i vetë mjetit. Për një aplikacion ku planque hyn vetë, si Stripe, ose një çelës që jepni, planque e mban atë token ose çelës për kompaninë tuaj, të enkriptuar. Për një lidhje të menaxhuar, Composio, shërbimi i lidhjes me të cilin punon planque, mban hyrjen, dhe planque mban vetëm regjistrimin e lidhjes dhe mjetet që miratuat (shihni <a href="#google">Të dhënat e përdoruesit nga Google</a>). Regjistrimi i një lidhjeje mund të përfshijë llogarinë në të cilën është hyrë (emrin ose emailin e saj), që aplikacioni t'ju tregojë cila është. KIFF përdor lidhje të menaxhuara vetëm për aplikacionet e emërtuara te <a href="/subprocessors#composio">/subprocessors</a> (në anglisht).</li>
					<li><strong>Shfletuesi juaj (Chrome):</strong> kur çiftoni shtesën tafs me telefonin tuaj, një taf mund të punojë në profilin e Chrome që keni çiftuar, vetëm në sajtet që i rendit lidhja e tij. Hap skedat e veta në një grup skedash që mund ta shihni, ta ndalni përkohësisht ose ta ndaloni, dhe ndalet përkohësisht kur prekni një prej tyre. I lexon ato faqe si tekst dhe fusha formularësh, me fushat e fjalëkalimit, kartës dhe kodit të hequra, kurrë skedat tuaja të tjera ose sajte të tjera. Ai tekst shkon te ofruesi ynë i AI si pjesë e ekzekutimit dhe ruhet me ekzekutimin si rezultat i çdo mjeti. Çdo hap shkon në Regjistër me sajtin dhe emrin e fushës, kurrë ajo që është shkruar në një fushë të fshehtë. Për çdo ndryshim që bën një taf, KIFF ruan faqen para dhe pas, si tekst me ato fusha të hequra, për jo më shumë se 30 ditë, dhe e fshin më herët kur shkëputeni ose e fshini llogarinë. Këto faqe mund të tregojnë të dhëna të njerëzve të tjerë, si klientët tuaj; KIFF i përpunon për ju, si përpunues. Shtesa ruan në kompjuterin tuaj vetëm çelësin e vet, kurrë fjalëkalimet tuaja: në një faqe hyrjeje, taf ndalet dhe ju kërkon të hyni vetë, në skedën tuaj. Mund të flisni me Coach edhe nga paneli anësor i shtesës. Coach e lexon faqen vetëm pasi ta lejoni në shtesë, me një pëlqim më vete që mund ta tërhiqni atje, dhe gjithmonë mund të dërgoni një mesazh pa faqen. Kur i dërgoni një mesazh prej andej, faqja përpara shkon me atë mesazh vetëm si teksti i saj i dukshëm, kurrë ajo që keni shkruar, përveç në një sajt banke, pagesash, poste ose shëndeti ose një sajt që e keni çaktivizuar për Coach. Vlerat e fushave dhe fjalëkalimet nuk lexohen; numrat e kartave shkurtohen te katër shifrat e fundit; çelësat dhe sekretet e etiketuara maskohen. Maskohen edhe kodet njëpërdorimshe që teksti i faqes i quan të tilla në anglisht, frëngjisht, spanjisht ose gjermanisht. Ajo shkon te ofruesi ynë i IA-së vetëm për atë mesazh; tafs e mban faqen vetëm derisa përgjigjja të jetë gati, dhe e mban emrin e sajtit me bisedën tuaj, të shfaqur si “Po lexon:”, për 30 ditë. Përgjigjja e Coach mund ta citojë faqen dhe ruhet me bisedën tuaj si çdo përgjigje. Paneli anësor shfaq vetëm bisedat e nisura në atë Chrome që kur e çiftuat; bisedat e tjera mbeten në telefonin dhe në pajisjet tuaja të tjera. Aty mund t'i bashkëngjitni edhe skedarë një mesazhi: ashtu si skedarët e bashkëngjitur në aplikacionet tafs, ata shkojnë te ofruesi ynë i IA-së me atë mesazh dhe ruhen me të 30 ditë, ose më pak nëse biseda hiqet (një skedar që nuk e përdor asnjë mesazh, rreth një orë), dhe vetëm personi që e bashkëngjiti një skedar mund ta hapë. Shkëputja ose çinstalimi fshin atë që ruan shtesa. Një taf nuk paguan kurrë pa miratimin tuaj në telefon. Për çdo hap që vepron (një klikim, shkrim, dërgim), përfshirë një që keni miratuar, ruan edhe një pamje ekrani të faqes, marrë pak para veprimit, për regjistrin; asnjëherë për një faqe që vetëm e lexon, asnjëherë në një sajt banke, portofoli, menaxheri fjalëkalimesh, pagesash, shëndeti ose qeverie, dhe me fushat e fjalëkalimit, kartës dhe kodit të fshehura para se të merret. Teksti që duket si numër karte ose çelës errësohet gjithashtu, por diçka e shkruar ndryshe mund të shfaqet prapë. Pamjet e ekranit ruhen në ruajtje të enkriptuar, të lidhura me atë hap, për 30 ditë, pastaj fshihen automatikisht, ose më herët kur ndërprisni lidhjen, shkëputni këtë Chrome ose fshini llogarinë, dhe nuk shkojnë kurrë te ofruesi ynë i IA-së. I shihni secilën nën hapin e vet në Aktivitetin e tafit.</li>
					<li><strong>Puna e taf-eve tuaja:</strong> ekzekutimet, bisedat, raportet, shënimet e kujtesës të çdo taf-i dhe skedarët që dorëzojnë, të mbajtur si përpunues. Të gjithë në llogarinë tuaj mund t'i shohin skedarët që dorëzojnë taf-et tuaja.</li>
					<li><strong>Portat:</strong> kur hapni një portë që njerëzit t'i shkruajnë një taf-i me email, Slack ose Telegram, shërbimi tafs ruan çdo dërgues që çiftoni, sipas adresës së tij të emailit, ID-së së anëtarit në Slack ose ID-së së përdoruesit në Telegram (një numër telefoni për një portë WhatsApp), me emrin që i jepni, derisa të hiqni portën ose taf-in. Një mesazh nga dikush që nuk e keni çiftuar ju pret si trokitje, me atë që e shkroi dhe çfarë thotë, deri në 30 ditë pas së fundit. Mesazhi i një dërguesi të çiftuar hyn në bisedën e taf-it dhe ruhet si pjesa tjetër e bisedës. Slack dhe Telegram i bartin mesazhet sipas kushteve të tyre.</li>
					<li><strong>Blerjet:</strong> Solo dhe paketat e krediteve shiten nga Apple përmes App Store, ose nga Google përmes faturimit të Google Play. Na tregojnë çfarë u bë, për cilën llogari KIFF (një id e rastësishme), kur, dhe referencat e transaksionit ose të porosisë. Nuk na japin Apple ID-në ose llogarinë, emrin, adresën e emailit ose kartën tuaj Google.</li>
				</ul>
				<p>Aplikacioni nuk ka gjurmues analitike ose reklamash.</p>
			</section>
			<section id="ai">
				<h2>5. AI në tafs</h2>
				<p>tafs përdor AI-në Claude të Anthropic për Coach dhe taf-et tuaja. Aplikacioni ju pyet para se diçka t'i dërgohet.</p>
				<ul>
					<li>Çfarë i dërgohet: ajo që i shkruani Coach dhe taf-eve tuaja, skedarët që bashkëngjitni, ajo që aplikacionet tuaja të lidhura i kthejnë një taf-i ndërsa punon dhe ajo që është në ekranin tuaj ndërsa Coach ju ndihmon në aplikacion.</li>
					<li>Nga Chrome: faqja përpara, kur i shkruani Coach në panelin anësor të shtesës, pasi t'i lejoni Coach të lexojë faqe atje.</li>
					<li>Çfarë nuk dërgohet kurrë: fjalëkalimet dhe çelësat që përdorin aplikacionet tuaja të lidhura, ose gjurma e gishtit tuaj.</li>
					<li>Anthropic e përdor për të përgjigjur dhe e ruan deri në 30 ditë.</li>
					<li>Asgjë nuk dërgohet derisa ta lejoni. Mund ta tërhiqni në Llogari.</li>
				</ul>
				<p>Kur e tërhiqni, Coach dhe taf-et tuaja ndalojnë së ju përgjigjuri, dhe një taf, ekzekutimet e të cilit mbështeten te pëlqimi juaj, pezullohet. tafs mban një regjistrim për çdo pëlqim që jepni ose tërhiqni, me kohën dhe versionin e tekstit të tij, për 10 vjet nga ndryshimi i fundit, për të treguar se për çfarë ramë dakord; fshirja e llogarisë e fshin më herët. <a href="/sq/privacy#ai-in-tafs">Politika e privatësisë e KIFF</a> ka detajet.</p>
			</section>
			@tafsPrivacyGoogleSQ()
			<section id="sharing">
				<h2>7. Kush tjetër merr të dhëna</h2>
				<p>Nuk i shesim të dhënat tuaja personale dhe nuk i ndajmë për reklamim.</p>
				<p>Për tafs, përdorim këto kompani: Amazon Web Services (pritja, përfshirë depon e tafs dhe lidhjet e planque), Clerk (hyrja për llogaritë KIFF), Anthropic (modeli AI), Composio (hyrjet e lidhjeve të menaxhuara dhe thirrjet që planque i kërkon të bëjë), Apple (njoftimet push), Google (njoftimet push në Android dhe faturimi i Google Play) dhe Resend (dera e emailit e një taf-i). Lista zyrtare, aktuale, me atë që prek secila dhe ku, është te <a href="/subprocessors">/subprocessors</a> (në anglisht).</p>
				<p>Disa prej tyre janë jashtë Hapësirës Ekonomike Evropiane, kryesisht në Shtetet e Bashkuara. <a href="/sq/privacy#transfers">Politika e privatësisë e KIFF</a> thotë si mbrohen ata transferime.</p>
				<p><strong>Vendi juaj.</strong> Ligjet e disa vendeve kërkojnë më shumë se ç'thotë kjo politikë. Ajo që shtojnë, në anglisht dhe në gjuhën e vendit, është te <a href="/privacy/countries">Vendi juaj</a> (në anglisht).</p>
			</section>
			<section id="retention">
				<h2>8. Sa e ruajmë</h2>
				<ul>
					<li>Ajo që mjetet tuaja i kthejnë një taf-i: vetëm derisa të mbarojë ekzekutimi. Në një bisedë, ajo që është vetëm lexuar mbahet e enkriptuar për mesazhet e saj të ardhshme, përdoret derisa biseda të jetë e papunuar një orë dhe më së shumti katër orë pas leximit, pastaj fshihet automatikisht, brenda disa ditëve.</li>
					<li>Ekzekutimet dhe bisedat e një taf-i, me përmbledhjen e një bisede: 30 ditë. Shënimet e kujtesës të tij: derisa taf-i të hiqet.</li>
					<li>Shënimet e shkurtra të Coach për përgjigjen e tij të ardhshme, si pse një lidhje nuk u bë dot në një bisedë, ose që një Card u miratua: derisa ajo përgjigje t'i marrë, më së shumti 7 ditë; pas kësaj, si pjesë e asaj bisede, për aq kohë sa ruhet biseda. Një kopje mbahet 24 orë që një mesazh i ridërguar të marrë të njëjtin shënim. Shënimi i një bisede përdoret vetëm në atë bisedë.</li>
					<li>Skedarët që bashkëngjitni në një bisedë: me mesazhin ku janë bashkëngjitur, 30 ditë, ose më herët nëse biseda hiqet, dhe në çdo rast brenda 38 ditëve. Një skedar që asnjë mesazh nuk e përdor hiqet rreth një orë pasi ta ngarkoni. Fshirja e llogarisë suaj i fshin.</li>
					<li>Skedarët që dorëzojnë taf-et tuaja: 30 ditë nga koha kur i krijoi ekzekutimi, pastaj fshihen automatikisht brenda një dite. Kushdo në llogarinë tuaj mund ta fshijë një më herët me Fshi tani: vetë skedari shkon menjëherë, pa kopje të mbajtur; emri, madhësia dhe taf-i e ekzekutimi që e krijuan mund të mbeten në kopjet e enkriptuara në një çast të caktuar të depos së tafs deri në 35 ditë, të përdorura vetëm për ta rikthyer pas një dështimi. Heqja e një taf-i ose fshirja e llogarisë suaj fshin skedarët e tij. Ndarja e një skedari dërgon vetë skedarin, dhe kopja që ndani qëndron me aplikacionin ku e ndatë. Për të shkarkuar një skedar, bëjmë një lidhje për një anëtar të hyrë të llogarisë suaj që ndalon së punuari pas një minute; nuk bëjmë asnjë lidhje tjetër për të.</li>
					<li>Ajo që një mjet ktheu, në regjistrimin e planque të çdo thirrjeje: 24 orë. Pas kësaj, regjistrimi mban vetëm nëse thirrja u dërgua, kështu që nuk dërgohet kurrë dy herë.</li>
					<li>Tokeni ose çelësi i një lidhjeje në planque, ose hyrja e një lidhjeje të menaxhuar te Composio: derisa ta shkëputni. Nëse një tjetër lidhje e juaja mund ta përdorë të njëjtën llogari te ai furnitor, mbahet, e papërdorur, derisa të shkëputet edhe ajo, pastaj revokohet. Regjistrimi i miratimeve të saj: derisa llogaria të mbarojë.</li>
					<li>Push token-i i një pajisjeje: derisa të dilni nga aplikacioni, ta hiqni pajisjen, ose Apple apo Google të raportojë që tokeni nuk ekziston më. Çelësi publik, emri, platforma dhe datat e një pajisjeje: sa kohë e përdorni; pasi e dilni, shënohet si e hequr dhe mbahet deri në fshirjen e llogarisë, që KIFF të mund të refuzojë një përgjigje të vonuar prej saj dhe të tregojë cila pajisje nënshkroi një më të hershme. Çelësi publik, id dhe emri i një passkey-t: si të pajisjes së tij. Sesioni i një kompjuteri: deri në 90 ditë, ose derisa të dilni.</li>
					<li>Llogaria juaj: derisa të fshihet. Regjistrat e shërbimit: 30 ditë. Depot e tafs dhe planque mbajnë kopje të enkriptuara në një çast të caktuar për 35 ditë, të përdorura vetëm për rikthimin e një depoje pas një dështimi.</li>
				</ul>
				<p>Gjithçka tjetër është te <a href="/sq/privacy#retention">seksioni i Ruajtjes i KIFF</a>.</p>
			</section>
			<section id="lawful-bases">
				<h2>9. Bazat ligjore</h2>
				<p>Ekzekutimi i një kontrate, për të drejtuar llogarinë tuaj dhe taf-et tuaja. Interesat legjitime, për siguri, parandalim të mashtrimit dhe zbulim të abuzimit. Pëlqimi, për AI në tafs (<a href="#ai">seksioni 5</a>). Detyrimi ligjor, për regjistrat tatimorë. <a href="/sq/privacy#lawful-bases">Politika e privatësisë e KIFF</a> ka detajet.</p>
			</section>
			<section id="rights">
				<h2>10. Të drejtat tuaja</h2>
				<p>Sipas GDPR-së mund të kërkoni qasje në të dhënat tuaja, korrigjimin, fshirjen, kufizimin ose një kopje të bartshme, të kundërshtoni përpunimin e bazuar në interesa legjitime dhe të tërhiqni pëlqimin. Dërgoni email te <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>; përgjigjemi pa vonesë të panevojshme dhe jo më vonë se brenda një muaji; për një kërkesë të ndërlikuar mund të na duhen edhe dy muaj, dhe jua themi brenda muajit të parë. Në aplikacion, Llogari → Eksporto bisedat e mia shkarkon bisedat dhe shënimet tuaja.</p>
				<p>Për të fshirë llogarinë tuaj tafs, hapni aplikacionin, shkoni te Llogari dhe prekni <em>Fshi llogarinë</em>, pastaj konfirmoni. Nuk mund të zhbëhet. <a href="/sq/privacy#delete-account">Politika e privatësisë e KIFF</a> thotë çfarë fshihet dhe kur, dhe si të kërkoni me email.</p>
				<p>Mund të ankoheni te <a href="https://www.aki.ee/en" target="_blank" rel="noopener">Inspektorati Estonez i Mbrojtjes së të Dhënave (Andmekaitse Inspektsioon)</a>, ose te autoriteti mbikëqyrës ku jetoni.</p>
				<p><strong>Vendi juaj.</strong> Ligjet e disa vendeve kërkojnë më shumë se ç'thotë kjo politikë. Ajo që shtojnë, në anglisht dhe në gjuhën e vendit, është te <a href="/privacy/countries">Vendi juaj</a> (në anglisht).</p>
			</section>
			<section id="more">
				<h2>11. Siguria, fëmijët dhe ndryshimet</h2>
				<p>Masat tona të sigurisë janë te <a href="/security">/security</a> (në anglisht). tafs nuk u drejtohet fëmijëve, dhe nuk mbledhim me dijeni të dhëna personale nga fëmijë nën 16 vjeç. E ndryshojmë këtë politikë ashtu siç thotë <a href="/sq/privacy#changes">Politika e privatësisë e KIFF</a> për të vetën.</p>
			</section>
			<section id="contact">
				<h2>12. Kontakti</h2>
				<p>Pyetje dhe kërkesa për privatësinë: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>. Njoftime formale ligjore: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>. Kushtet e vetë aplikacionit janë te <a href="/sq/tafs/terms">/tafs/terms</a>.</p>
			</section>
		</article>
	}
}

// tafsPrivacyGoogle is what tafs does with the data it receives from Google,
// for Google's review of tafs's sign-in, with the Limited Use statement in
// Google's own words.
templ tafsPrivacyGoogleSQ() {
	<section id="google">
		<h2>6. Të dhënat e përdoruesit nga Google</h2>
		if len(googleManaged()) == 0 && len(googleInHouse("sq")) > 0 {
			<p>Kur e kërkoni, tafs lidh një taf me llogarinë tuaj Google, për shembull me Google Sheets ose Google Calendar që përdor puna e tij, te Lidh aplikacionet në aplikacion. Ky seksion thotë çfarë bën tafs me të dhënat që merr nga Google.</p>
		} else {
			<p>Kur e kërkoni, tafs lidh një taf me llogarinë tuaj Google, për shembull me Gmail-in tuaj, ose me Google Calendar ose Google Sheets që përdor puna e tij, te Lidh aplikacionet në aplikacion. Ky seksion thotë çfarë bën tafs me të dhënat që merr nga Google.</p>
		}
		<ul>
			if len(googleManaged()) == 0 && len(googleInHouse("sq")) > 0 {
				<li><strong>Çfarë lexon dhe shkruan:</strong> atë që i duhet punës së taf-it: fletët e llogaritjes që i mban të përditësuara, ose ngjarjet në kalendarët që kujdeset. I ndryshon vetëm ku e lejon Card-i i taf-it, dhe çdo gjë mbi kufijtë e Card-it pret miratimin tuaj.</li>
			} else {
				<li><strong>Çfarë lexon dhe shkruan:</strong> atë që i duhet punës së taf-it. Në Gmail-in tuaj, lexon mesazhet dhe fijet tuaja për të gjetur ato që kanë nevojë për përgjigje, dhe shkruan drafte; dërgon postë vetëm ku e lejon Card-i i taf-it. Në Google Calendar dhe Google Sheets, lexon ngjarjet në kalendarët që kujdeset, ose fletët e llogaritjes që i mban të përditësuara, dhe i ndryshon vetëm ku e lejon Card-i i taf-it.
					if googleListed("Google Tasks") {
						Në Google Tasks, lexon listat e detyrave që kujdeset dhe shton, përfundon, zhvendos ose fshin detyra vetëm ku e lejon Card-i i taf-it.
					}
					Çdo gjë mbi kufijtë e Card-it pret miratimin tuaj.</li>
			}
			<li><strong>Pse:</strong> vetëm për të bërë punën që keni ngritur për atë taf, dhe për t'ju treguar me cilën llogari Google është lidhur: adresën e saj të emailit, të mbajtur me lidhjen derisa ta shkëputni.</li>
			if len(googleManaged()) > 0 || len(googleInHouse("sq")) > 0 {
				<li>
					<strong>Si lidhet çdo aplikacion Google:</strong>
					<ul>
						if len(googleManaged()) > 0 {
							<li>Përmes partnerit tonë të hyrjes, të listuar te <a href="/subprocessors">/subprocessors</a> (në anglisht): { appList(googleManaged()) }.</li>
						}
						if len(googleInHouse("sq")) > 0 {
							<li>Përmes hyrjes së vet Google të tafs, pa asnjë kompani tjetër në mes: { appList(googleInHouseNames()) }.</li>
						}
					</ul>
					if googleBoth() {
						Një aplikacion i emërtuar në të dyja lidhet në një mënyrë ose tjetrën, sipas llogarisë suaj. Faqja e vet e hyrjes e Google tregon cilën po lejoni.
					}
				</li>
			}
			if googleBoth() {
				<li>
					<strong>Çfarë lejoni:</strong> hyni në faqen e vet të Google dhe zgjidhni çfarë të lejoni.
					<ul>
						<li><strong>Përmes partnerit tonë të hyrjes:</strong> tafs kërkon vetëm qasjen që u duhet mjeteve të taf-it. Nëse ajo qasje më e ngushtë nuk është e mundur, kërkon qasjen e zakonshme të aplikacionit, dhe e thotë para se të hyni. Nëse qasja e zakonshme do të përfshinte të dhëna personale që taf-i nuk i përdor, tafs nuk lidhet.</li>
						<li><strong>Përmes hyrjes së vet Google të tafs:</strong> hyrja kërkon të gjithë qasjen e listuar më poshtë për atë aplikacion njëherësh, edhe kur taf-i vetëm lexon.</li>
					</ul>
				</li>
			} else if len(googleInHouse("sq")) > 0 {
				<li><strong>Çfarë lejoni:</strong> hyni në faqen e vet të Google dhe zgjidhni çfarë të lejoni. Hyrja kërkon të gjithë qasjen e listuar më poshtë për atë aplikacion njëherësh, edhe kur taf-i vetëm lexon.</li>
			} else {
				<li><strong>Çfarë lejoni:</strong> hyni në faqen e vet të Google dhe zgjidhni çfarë të lejoni. tafs kërkon vetëm qasjen që u duhet mjeteve të taf-it. Nëse ajo qasje më e ngushtë nuk është e mundur, kërkon qasjen e zakonshme të aplikacionit, dhe e thotë para se të hyni. Nëse qasja e zakonshme do të përfshinte të dhëna personale që taf-i nuk i përdor, tafs nuk lidhet.</li>
			}
			<li><strong>Si e përdor një taf:</strong> një taf përdor vetëm mjetet e miratuara në Card-in e tij. Çdo thirrje kontrollohet kundrejt një lejeje për atë mjet të saktë dhe ata argumente para se të dërgohet diçka, dhe një thirrje jashtë qasjes që dhatë refuzohet. Cilat veprime kërkojnë miratimin tuaj çdo herë caktohet në Card.</li>
			if len(googleInHouse("sq")) > 0 {
				<li>
					if googleBoth() {
						<strong>Qasja që kërkon hyrja e vet Google e tafs:</strong>
					} else {
						<strong>Qasja që kërkon tafs:</strong>
					}
					<ul>
						for _, a := range googleInHouse("sq") {
							<li>
								{ a.Name }
								<ul>
									for _, s := range a.Scopes {
										<li><code>{ s.ID }</code>: { s.What }</li>
									}
								</ul>
							</li>
						}
					</ul>
					Sado që lejon një hyrje, taf-i përdor vetëm mjetet në Card-in e tij.
				</li>
			}
			if googleBoth() {
				<li>
					<strong>Kush e mban hyrjen tuaj:</strong>
					<ul>
						<li><strong>Përmes partnerit tonë të hyrjes:</strong> hyrja juaj Google mbahet nga partneri ynë i hyrjes, i listuar te <a href="/subprocessors">/subprocessors</a> (në anglisht), dhe nuk i jepet kurrë një taf-i ose planque. As taf-i as tafs nuk e shohin fjalëkalimin tuaj ose tokenat tuaj Google. Një tjetër taf i juaji që ka nevojë për të njëjtën qasje e ripërdor hyrjen, dhe çdo taf përdor vetëm mjetet që i keni miratuar.</li>
						<li><strong>Përmes hyrjes së vet Google të tafs:</strong> planque, shërbimi i vet i lidhjes i tafs, e mban tokenin tuaj Google për kompaninë tuaj, të enkriptuar me AWS KMS në Bashkimin Evropian (Irlandë), dhe e përdor vetëm për të bërë një thirrje që e lejon Card-i i taf-it. Nuk i jepet kurrë një taf-i, dhe as taf-i as modeli AI nuk e shohin fjalëkalimin tuaj ose tokenat tuaj Google. Një tjetër taf i juaji që ka nevojë për të njëjtën qasje e ripërdor hyrjen, dhe çdo taf përdor vetëm mjetet që i keni miratuar.</li>
					</ul>
				</li>
			} else if len(googleInHouse("sq")) > 0 {
				<li><strong>Kush e mban hyrjen tuaj:</strong> planque, shërbimi i vet i lidhjes i tafs, e mban tokenin tuaj Google për kompaninë tuaj, të enkriptuar me AWS KMS në Bashkimin Evropian (Irlandë), dhe e përdor vetëm për të bërë një thirrje që e lejon Card-i i taf-it. Nuk i jepet kurrë një taf-i, dhe as taf-i as modeli AI nuk e shohin fjalëkalimin tuaj ose tokenat tuaj Google. Një tjetër taf i juaji që ka nevojë për të njëjtën qasje e ripërdor hyrjen, dhe çdo taf përdor vetëm mjetet që i keni miratuar.</li>
			} else {
				<li><strong>Kush e mban hyrjen tuaj:</strong> hyrja juaj Google mbahet nga partneri ynë i hyrjes, i listuar te <a href="/subprocessors">/subprocessors</a> (në anglisht), dhe nuk i jepet kurrë një taf-i ose planque. As taf-i as tafs nuk e shohin fjalëkalimin tuaj ose tokenat tuaj Google. Një tjetër taf i juaji që ka nevojë për të njëjtën qasje e ripërdor hyrjen, dhe çdo taf përdor vetëm mjetet që i keni miratuar.</li>
			}
			if googleBoth() {
				<li>
					<strong>Kush tjetër e merr:</strong> ajo që një taf lexon nga Google shkon te modeli AI që ekzekuton taf-in, vetëm pasi ta lejoni (shihni <a href="#ai">AI në tafs</a>), që e ruan deri në 30 ditë sipas kushteve të ofruesit të tij.
					<ul>
						<li><strong>Përmes partnerit tonë të hyrjes:</strong> kalon edhe përmes partnerit tonë të hyrjes, që bën çdo thirrje.</li>
						<li><strong>Përmes hyrjes së vet Google të tafs:</strong> planque thërret vetë Google, pra asnjë kompani tjetër nuk bën thirrjen ose nuk mban hyrjen tuaj.</li>
					</ul>
					Të dyja janë të listuara te <a href="/subprocessors">/subprocessors</a> (në anglisht).
				</li>
			} else if len(googleInHouse("sq")) > 0 {
				<li><strong>Kush tjetër e merr:</strong> ajo që një taf lexon nga Google shkon te modeli AI që ekzekuton taf-in, vetëm pasi ta lejoni (shihni <a href="#ai">AI në tafs</a>), që e ruan deri në 30 ditë sipas kushteve të ofruesit të tij. planque thërret vetë Google, pra asnjë kompani tjetër nuk bën thirrjen ose nuk mban hyrjen tuaj. Ofruesi i modelit AI është i listuar te <a href="/subprocessors">/subprocessors</a> (në anglisht).</li>
			} else {
				<li><strong>Kush tjetër e merr:</strong> ajo që një taf lexon nga Google shkon te modeli AI që ekzekuton taf-in, vetëm pasi ta lejoni (shihni <a href="#ai">AI në tafs</a>), që e ruan deri në 30 ditë sipas kushteve të ofruesit të tij. Kalon edhe përmes partnerit tonë të hyrjes, që bën çdo thirrje. Të dyja janë të listuara te <a href="/subprocessors">/subprocessors</a> (në anglisht).</li>
			}
			<li><strong>Trajnimi i AI:</strong> të dhënat e përdoruesit nga Google nuk përdoren për të trajnuar modele AI.</li>
			<li><strong>Imazhet:</strong> tafs nuk krijon ose redakton imazhe ose video: AI-ja e tij shkruan tekst. Nuk i përdor kurrë API-të e Google ose të dhënat e përdoruesit nga Google për të krijuar, redaktuar ose ndarë imazhe intime të dikujt pa pëlqimin e tij (NCII), ose çdo imazh tjetër të një personi.</li>
			if len(googleManaged()) == 0 && len(googleInHouse("sq")) > 0 {
				<li><strong>Sa gjatë, dhe ku:</strong> fletët tuaja të llogaritjes dhe ngjarjet qëndrojnë në llogarinë tuaj Google. Në depon e vet të tafs, ajo që kthen një mjet mbahet vetëm derisa të mbarojë ekzekutimi i taf-it. planque, që e kalon çdo thirrje më tej, mban atë që kthen Google për 24 orë, kështu që një thirrje e përsëritur merr të njëjtën përgjigje dhe nuk dërgohet kurrë dy herë; pas kësaj mban vetëm nëse thirrja u dërgua. Në një bisedë, ajo që u lexua vetëm mbahet e enkriptuar, përdoret derisa biseda të jetë e papunuar një orë dhe më së shumti katër orë pas leximit, pastaj fshihet automatikisht, brenda disa ditëve. Regjistrimi i një ekzekutimi dhe biseda e tij mbahen 30 ditë, dhe shënimet e një taf-i derisa ta hiqni taf-in (shihni <a href="#retention">Sa e ruajmë</a>).</li>
			} else {
				<li><strong>Sa gjatë, dhe ku:</strong> draftet, ngjarjet dhe fletët tuaja të llogaritjes qëndrojnë në llogarinë tuaj Google. Në depon e vet të tafs, ajo që kthen një mjet mbahet vetëm derisa të mbarojë ekzekutimi i taf-it. planque, që e kalon çdo thirrje më tej, mban atë që kthen Google për 24 orë, kështu që një thirrje e përsëritur merr të njëjtën përgjigje dhe nuk dërgohet kurrë dy herë; pas kësaj mban vetëm nëse thirrja u dërgua. Në një bisedë, ajo që u lexua vetëm mbahet e enkriptuar, përdoret derisa biseda të jetë e papunuar një orë dhe më së shumti katër orë pas leximit, pastaj fshihet automatikisht, brenda disa ditëve. Regjistrimi i një ekzekutimi dhe biseda e tij mbahen 30 ditë, dhe shënimet e një taf-i derisa ta hiqni taf-in (shihni <a href="#retention">Sa e ruajmë</a>).</li>
			}
			<li>
				<strong>Ndalimi:</strong>
				<ul>
					<li>Shkëputni Google në aplikacion, te Lidh aplikacionet ose te skeda Card e taf-it. Mjetet e tij Google ndalojnë menjëherë, dhe tafs i kërkon Google të revokojë hyrjen menjëherë; kjo mund të plotësohet pak më vonë.</li>
					<li>Hiqni një taf, dhe lidhjet e tij mbarojnë me të. Një hyrje Google që një tjetër taf i juaji ende e përdor qëndron derisa të largohet i fundit.</li>
					<li>Hiqni qasjen e tafs në çdo kohë në Llogarinë tuaj Google, te <a href="https://myaccount.google.com/permissions">myaccount.google.com/permissions</a>. Taf-et tuaja ndalojnë së arrituri Google, dhe aplikacioni ju tregon se lidhja Google është e dalë.</li>
					<li>Fshini llogarinë tuaj: taf-et, bisedat, shënimet, skedarët dhe lidhjet e saj fshihen menjëherë, dhe nga kopjet e tyre në një çast të caktuar brenda 35 ditëve, dhe tokenat e saj Google revokohen ku e lejon Google.</li>
				</ul>
			</li>
		</ul>
		<p lang="en">tafs's use and transfer to any other app of information received from Google APIs will adhere to <a href="https://developers.google.com/terms/api-services-user-data-policy">Google API Services User Data Policy</a>, including the Limited Use requirements.</p>
	</section>
