package pages

import (
	"github.com/kiff/cloud/web/internal/components"
	"github.com/kiff/cloud/web/internal/content/country"
)

// CountryLink is one served country (or language) on the "Your country" pages.
type CountryLink struct {
	Name string
	Path string
	Lang string
}

// CountryIndex lists the countries with a section of their own: what that
// country's law asks beyond KIFF's and tafs's privacy policies.
templ CountryIndex(links []CountryLink) {
	@components.LayoutSiteWithMeta("Your country", "What a country's law adds to KIFF's and tafs's privacy policies, in English and in that country's language.", "article", "", "css/prose.css") {
		<article class="legal prose">
			<h1>Your country</h1>
			<p>
				Some countries' laws ask for more than <a href="/privacy">KIFF's Privacy Policy</a> and
				the <a href="/tafs/privacy">tafs Privacy Policy</a> say. Each country below has a section with what
				its law adds, in English and in its own language. The English text binds, except where local law
				requires the local text to.
			</p>
			<ul>
				for _, l := range links {
					<li><a href={ templ.SafeURL(l.Path) }>{ l.Name }</a></li>
				}
			</ul>
		</article>
	}
}

// CountrySection is one country's section in one language, with its other
// languages linked.
templ CountrySection(s country.Section, others []CountryLink) {
	@components.LayoutSiteWithMeta(s.Title+" · Your country", "What "+s.Title+"'s law adds to KIFF's and tafs's privacy policies.", "article", "", "css/prose.css") {
		<article class="legal prose" lang={ s.Lang }>
			<p class="eyebrow"><a href="/privacy/countries">Your country</a></p>
			if len(others) > 0 {
				<p>
					for i, o := range others {
						if i > 0 {
							{ " · " }
						}
						<a href={ templ.SafeURL(o.Path) } hreflang={ o.Lang } lang={ o.Lang }>{ o.Name }</a>
					}
				</p>
			}
			@templ.Raw(string(s.HTML))
		</article>
	}
}

// LegalNotice is a legal notice (Japan's seller notice) in one language, with
// its other languages linked.
templ LegalNotice(s country.Section, others []CountryLink) {
	@components.LayoutSiteWithMeta(s.Title, s.Title+" · Kiff Agents OÜ", "article", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose" lang={ s.Lang }>
			if len(others) > 0 {
				<p>
					for i, o := range others {
						if i > 0 {
							{ " · " }
						}
						<a href={ templ.SafeURL(o.Path) } hreflang={ o.Lang } lang={ o.Lang }>{ o.Name }</a>
					}
				</p>
			}
			@templ.Raw(string(s.HTML))
		</article>
	}
}
