package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// TermsHY is KIFF's terms (/terms) in Armenian, at /hy/terms.
// It is a translation of Terms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Armenian has the legal
// texts only, so a link to any other page goes to English and says so.
templ TermsHY() {
	@components.LayoutSite("KIFF — terms of service", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@termsHeadHY()
			@termsDefinitionsHY()
			@termsAgreementHY()
			@termsServiceHY()
			@termsTafsHY()
			@termsAccountHY()
			@termsAcceptableUseHY()
			@termsCustomerDataHY()
			@termsConfidentialityHY()
			@termsFeesHY()
			@termsTermHY()
			@termsWarrantiesHY()
			@termsDisclaimerHY()
			@termsLiabilityHY()
			@termsIndemnityHY()
			@termsSLAHY()
			@termsServiceModsHY()
			@termsTermsModsHY()
			@termsForceMajeureHY()
			@termsGoverningLawHY()
			@termsGeneralHY()
			@termsContactHY()
		</article>
	}
}

templ termsHeadHY() {
	<header class="legal-head">
		<p class="legal-badge">Ծառայության պայմաններ · v0.1</p>
		<h1>Ծառայության պայմաններ</h1>
		<p class="legal-meta">
			<strong>Վերջին թարմացում՝</strong> 2026 թվականի նոյեմբերի 22։ <strong>Ուժի մեջ մտնելու ամսաթիվ՝</strong> 2026 թվականի մայիսի 24։
		</p>
		<p class="legal-disclaimer">
			<strong>Ինչ է փոխվել՝</strong> ում հետ է ձեր պայմանագիրը, երբ մեկ այլ բիզնես ձեզ ծանոթացրել է (§2), և միկրոձեռնարկությունները (§8)։ Ավելի վաղ՝ ով կարող է օգտագործել Ծառայությունը՝ ըստ տարածաշրջանի, սեփականության և պատժամիջոցների (§4). tafs հավելվածը Android-ում և Solo-ն, գնված Google Play-ով (§1, §8)։ Դրանից առաջ՝ վճարովի պլանները (§3A, §8), <a href="/legal/sla">ծառայության մակարդակի համաձայնագիրը</a> (անգլերեն) (§14) և արգելված օգտագործումների ցանկը, որն այժմ գտնվում է <a href="/acceptable-use">Թույլատրելի օգտագործման քաղաքականության</a> (անգլերեն) մեջ (§5)։
		</p>
		<p class="legal-disclaimer">
			Այս պայմանները կարգավորում են KIFF Cloud-ի օգտագործումը, ներառյալ tafs-ը։ Պայմանագրային հարցեր՝ <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>։
		</p>
	</header>
}

templ termsDefinitionsHY() {
	<section id="definitions">
		<h2>1. Սահմանումներ</h2>
		<ul>
			<li><strong>«Kiff Agents OÜ»</strong>, <strong>«մենք»</strong>, <strong>«մեզ»</strong>, <strong>«մեր»</strong> — Էստոնիայի սահմանափակ պատասխանատվությամբ մասնավոր ընկերությունը, որը մատուցում է Ծառայությունը։ Գրանցման կոդ 17372313։</li>
			<li><strong>«Հաճախորդ»</strong>, <strong>«դուք»</strong>, <strong>«ձեր»</strong> — ֆիզիկական կամ իրավաբանական անձը, որը համաձայնվում է այս պայմաններին։</li>
			<li><strong>«Օգտատեր»</strong> — ցանկացած անհատ, որին Հաճախորդը թույլատրում է մուտք գործել Ծառայություն Հաճախորդի հաշվի միջոցով։</li>
			<li><strong>«Ծառայություն»</strong> — KIFF Cloud արտադրանքը, ներառյալ <code>api.kiff.dev</code>, <code>app.kiff.dev</code>, <code>kiff.dev</code>, tafs-ը և փաստաթղթերը, վահանակները և API-ները, որոնք հրապարակում ենք այնտեղ։</li>
			<li><strong>«tafs»</strong> — tafs հավելվածը iPhone-ի, iPad-ի, Android-ի և համակարգիչների (Mac, Windows և Linux) համար և դրա հետևում գտնվող ծառայությունը, ներառյալ Setup-ը և planque-ը (§3A), որտեղ Հաճախորդը աշխատանք է վստահում AI գործակալի, որն աշխատում է KIFF Card-երի շրջանակներում։ <strong>«taf»</strong>-ը այդպիսի մեկ գործակալ է։</li>
			<li><strong>«Թենանտ»</strong> — Ծառայության ներսում տրամաբանորեն մեկուսացված աշխատանքային տարածք, որը պատկանում է մեկ Հաճախորդի։</li>
			<li><strong>«Աուդիտի տվյալներ»</strong> — իրադարձությունները, որոշումները, գործողությունները, հաստատումները և անդորրագրերը, որոնք Ծառայությունը պահում է Հաճախորդի անունից runtime-ի միջոցով։</li>
			<li><strong>«tafs տվյալներ»</strong> — այն, ինչ tafs-ը պահում է Հաճախորդի անունից՝ յուրաքանչյուր taf-ի գործարկումները և զրույցները (ներառյալ այն, ինչ Հաճախորդի միացված գործիքները վերադարձնում են դրան), նրա հաշվետվությունները, հիշողության նշումները և հեռախոսները, որոնք գրանցված են նրա ծանուցումների համար։</li>
			<li><strong>«Անդորրագիր»</strong> — ստորագրված, տարբերակավորված որոշման գրառում, որը Ծառայությունը թողարկում է յուրաքանչյուր կառավարվող գործողության համար։</li>
			<li><strong>«Փաստաթղթեր»</strong> — Ծառայության տեխնիկական փաստաթղթերը և անվտանգության միջոցառումները այս Պայմաններից հղված ամսաթվավորված խմբագրությամբ (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>)։ Բացառում է ռազմավարական սպիտակ գիրքը, մարքեթինգային նյութերը և առանձին լիցենզավորված բաց կոդով շրջանակի փաստաթղթերը։</li>
			<li><strong>«DPA»</strong> — Տվյալների մշակման համաձայնագիրը <a href="/legal/dpa">/legal/dpa</a> (անգլերեն) հասցեում, որը կարգավորում է մեր հարաբերությունը որպես մշակող։</li>
		</ul>
	</section>
}

templ termsAgreementHY() {
	<section id="agreement">
		<h2>2. Համաձայնագիրը</h2>
		<p>
			Այս պայմանները կարգավորում են Ծառայության ձեր օգտագործումը։ Հաշիվ ստեղծելով, API բանալի ստեղծելով կամ այլ կերպ Ծառայությունն օգտագործելով՝ դուք համաձայնվում եք այս պայմաններին։ Եթե համաձայնվում եք ընկերության կամ այլ իրավաբանական անձի անունից, հայտարարում եք, որ իրավասու եք պարտավորեցնել այդ անձին, և «դուք» ու «ձեր» վերաբերում են այդ անձին։
		</p>
		<p>
			Եթե մշակողը, գործընկերը կամ այլ բիզնես ձեզ ծանոթացրել է KIFF-ին կամ ստեղծել է գործակալը, որն օգտագործում եք, Ծառայության վերաբերյալ ձեր պայմանագիրը ուղղակիորեն մեզ հետ է՝ այս պայմաններով, և դուք ինքներդ եք դրանք ընդունում։ Այդ բիզնեսը մեր գործակալը չէ. այն չի կարող ընդունել այս պայմանները, համաձայնություն տալ կամ հաստատել վճարում ձեզ համար, և չի վաճառում Ծառայությունը մեզ համար։
		</p>
		<p>
			Կարող ենք հրապարակել լրացուցիչ պայմաններ կոնկրետ գործառույթների համար (բետա գործառույթներ, երրորդ կողմի ինտեգրացիաներ)։ Որտեղ դրանք հակասում են այս պայմաններին, լրացուցիչ պայմանները գերակայում են կոնկրետ գործառույթի համար։
		</p>
	</section>
}

templ termsServiceHY() {
	<section id="service">
		<h2>3. Ծառայությունը</h2>
		<p>
			KIFF Cloud-ը հոսթավորվող ծառայություն է՝ պատվիրակված գործողությունների կառավարման համար։ Այն գնահատում է հարցումները Հաճախորդի կազմաձևված թույլտվությունների և Card-երի դիմաց, կարող է պահանջել մարդկային հաստատում և գրանցում է կառավարման որոշումները։ Կախված կազմաձևված ինտեգրացիայից՝ KIFF-ը փոխանցում է թույլատրված հարցումը կամ տալիս է թույլտվություն, որը պաշտպանված համակարգը ստուգում է։ Միացված համակարգը կատարում է հիմնական գործողությունը։
		</p>
		<p>
			Կիրառելի տեխնիկական վարքագիծը, ապացույցները, ինտեգրացիայի պահանջները և կատարման սահմանները նշված են այս Պայմաններից հղված ամսաթվավորված Փաստաթղթերում։ Ռազմավարական <a href="/whitepaper">սպիտակ գիրքը</a> (անգլերեն) բացատրում է KIFF-ի սկզբունքներն ու մոդելը. այն այս Պայմաններով որպես տեխնիկական Փաստաթուղթ չի ներառվում։
		</p>
		<p>
			KIFF Cloud-ի կառավարման ծառայությունը <em>չէ</em> գործակալների շրջանակ, աշխատանքային հոսքերի շարժիչ, մոդելների gateway կամ կառավարվող գործակալների հարթակ։ Այն համադրվում է այն ամենի հետ, ինչ արդեն օգտագործում եք։ Բացահայտ ցանկի համար տե՛ս գլխավոր էջի <a href="/#not">«Ինչ չէ KIFF-ը»</a> (անգլերեն)։ tafs-ը Ծառայության միակ մասն է, որը ձեզ համար գործակալներ է աշխատեցնում՝ ձեր թողարկած Card-երի շրջանակներում. §3A-ն այն նկարագրում է։
		</p>
		<p>
			<a href="https://github.com/kiff/kiff" target="_blank" rel="noopener">kiff/kiff</a> բաց կոդով շրջանակը կարգավորվում է իր սեփական MIT լիցենզիայով և այս պայմաններից դուրս է։ Երբ շրջանակը գործարկում եք սեփական ենթակառուցվածքում, Kiff Agents OÜ-ի հետ պայմանագիր չի ստեղծվում։
		</p>
	</section>
}

templ termsTafsHY() {
	<section id="tafs">
		<h2>3A. tafs</h2>
		<p>
			tafs-ում աշխատանք (օրինակ՝ փոխհատուցումներ, հաշիվների վճարում կամ քարտային վեճեր) վստահում եք taf-ին՝ AI գործակալին, որը աշխատում է ժամանակացույցով ձեր միացրած գործիքներով, նրա համար թողարկված KIFF Card-երի շրջանակներում։ Յուրաքանչյուր taf աշխատում է մեր գործակալների runtime-ում, և այն օգտագործվող AI մոդելը տրամադրում է Anthropic-ը։ Նրա կասեցված զանգերին պատասխանում եք tafs հավելվածում։
		</p>
		<p>
			<strong>Ձեր գործիքների միացումը։</strong> Setup-ը՝ tafs-ի AI գործակալը, որն աշխատում է taf-ի պես, օգնում է ձեզ միացնել գործիք և taf կարգավորել աշխատանքի համար։ Ինքն ոչինչ չի միացնում։ Մուտք եք գործում գործիքի սեփական մատակարարի մոտ (օրինակ՝ Stripe), և ձեր սարքի վրա հաստատում եք յուրաքանչյուր կապ, գործիքները, որոնք taf-ը կարող է օգտագործել, և նրա Card-երը։ Այդ մուտքի token-ը պահում է planque-ը՝ մեր կապի ծառայությունը։ Այն գաղտնագրված է, օգտագործվում է միայն KIFF-ի որոշած զանգ կատարելու համար և երբեք չի տրվում taf-ին։ Գործիքի անջատումը չեղարկում է token-ը մատակարարի մոտ և ջնջում այն։
		</p>
		<p>
			<strong>Ձեր Card-երը ձեր ցուցումներն են։</strong> Taf-ը ձեր գործիքներին հասնում է միայն KIFF-ի միջոցով, որը յուրաքանչյուր զանգ ուղարկելուց առաջ ստուգում է taf-ի Card-երի դիմաց։ Ձեր թողարկած Card-ի շրջանակներում կատարվող զանգը կատարվում է ձեր ցուցումով։ Card-ից դուրս զանգը կասեցվում կամ մերժվում է, ինչպես Card-ն է ասում։ Կասեցված զանգը կատարվում է միայն այն բանից հետո, երբ այն հաստատում է մեկը, ում ձեր հաշիվը թույլ է տալիս պատասխանել կասեցված զանգերին։ tafs հավելվածում պատասխանը կրում է նրանց սարքի ստորագրությունը, որը KIFF-ը ստուգում է, և անդորրագիրը պահում է այդ ապացույցը։ Ձեր հաշիվը կարող է պատասխանել նաև հենց KIFF-ում (վահանակ, դրա հրամանի տողի գործիքը կամ հաստատող, որին այնտեղ լիազորում եք). անդորրագիրը այդ դեպքում գրանցում է, թե ով և ինչպես պատասխանեց։
		</p>
		<p>
			<strong>Վճարումներ։</strong> Երբ taf-ը ձեր փոխարեն վճարում է կայքի վճարման էջում քարտով կամ վճարման այլ եղանակով, որը պահպանել եք այդ կայքում, դա անում է միայն Card-ի ներսում և միայն այն բանից հետո, երբ հեռախոսում հաստատել եք այդ վճարումը։ Ձեր հաստատումը ձեր անունից թույլատրում է միայն այդ մեկ վճարումը։ Կայքը և նրա վճարային ծառայություն մատուցողը մշակում են այն։ KIFF-ը և planque-ը երբեք չեն պահում ձեր փողը, երբեք չեն պահպանում ձեր քարտի տվյալները, և taf-ը երբեք չի մուտքագրում քարտի համար։
		</p>
		<p>
			<strong>Ինչ է մնում ձեզ։</strong> Դուք ընտրում եք յուրաքանչյուր taf-ի աշխատանքն ու Card-երը, պատասխանում եք նրա կասեցված զանգերին և համոզվում, որ իրավունք ունեք օգտագործել գործիքները և հաշիվները, որոնք միացնում եք։ Taf-ի հաշվետվությունները, հաղորդագրությունները և հիշողության նշումները գրվում են AI մոդելի կողմից և կարող են սխալ լինել. ստուգեք կարևորը՝ նախքան դրանց վրա հիմնվելը։
		</p>
		<p>
			<strong>Taf-ի կանգնեցումը։</strong> Կարող եք կանգնեցնել (halt) մեկ taf կամ բոլորը, դադարեցնել taf, չեղարկել նրա ցանկացած Card կամ հեռացնել այն։ Այն պահից, երբ taf-ը կանգնեցնում եք կամ Card-ը չեղարկում, KIFF-ը այդ taf-ի կամ Card-ի տակ նոր զանգ թույլ չի տալիս։ tafs հավելվածը taf-ը կանգնեցված է ցույց տալիս միայն այն բանից հետո, երբ KIFF-ը և planque-ը երկուսն էլ հաստատել են կանգնեցումը. այդ պահից planque-ը նրա ոչ մի զանգ չի ուղարկում, ներառյալ այն, որ KIFF-ը թույլատրել էր քիչ առաջ։ Գործիքի մատակարարին արդեն ուղարկված հարցումը դեռ կարող է ավարտվել. մենք կանգնեցնում ենք նոր զանգերը և չենք կարող չեղարկել այն, ինչ մատակարարն արդեն արել է։ Գործիքը, որն ինքն է ստուգում KIFF-ի թույլտվությունները՝ առանց planque-ի, դեռ կարող է ընդունել թույլտվություն, որը KIFF-ը թողարկել էր քիչ առաջ, առավելագույնը 90 վայրկյան։ Կանգնեցված taf-ի վերսկսումը պահանջում է ձեր հաստատումը ձեր սարքի վրա, և կանգնեցումից առաջ կասեցված կամ հերթագրված ոչինչ չի կատարվում դրանից հետո։
		</p>
		<p>
			<strong>Taf-ի հեռացումը</strong> դադարեցնում է նրա ժամանակացույցը և ջնջում նրա գործարկումները, զրույցները, հիշողությունը և բանալին, որն օգտագործում էր։ Դրանից էլ առաջ այն, ինչ ձեր գործիքները վերադարձնում են taf-ին, պահվում է միայն մինչև նրա գործարկման ավարտը (այն, ինչ զրույցը միայն կարդացել է, գաղտնագրված, հաջորդ հաղորդագրությունների համար. օգտագործվում է առավելագույնը չորս ժամ, հետո ջնջվում է), և նրա գործարկումներն ու զրույցները՝ 30 օր։ KIFF-ը պահում է իր արածի անդորրագրերը։
		</p>
		<p>
			<strong>ԵՄ AI օրենքը։</strong> tafs-ի համար Kiff Agents OÜ-ն AI համակարգի մատակարարն է, իսկ դուք՝ դրա deployer-ը։ Մենք համոզվում ենք, որ ցանկացած բան, որ taf-ը գրում է ձեր ընկերությունից դուրս որևէ մեկին, ասում է, որ գրել է AI գործակալը։ tafs-ը օգտագործում եք միայն այն աշխատանքների համար, որոնք առաջարկում է, և ոչ մի օգտագործման համար, որն AI օրենքը արգելում է կամ դասում է բարձր ռիսկի, ինչպիսիք են անձի աշխատանքի, վարկի կամ կարևոր ծառայություններին մուտքի վերաբերյալ որոշումները։ Պահում եք մարդկային հաստատումները, որոնք պահանջում են ձեր Card-երը, և համոզվում, որ մարդիկ, ովքեր tafs-ը օգտագործում են ձեզ համար, հասկանում են, թե ինչ է անում և որոնք են նրա սահմանները։
		</p>
		<p>
			<strong>Ծախսեր։</strong> tafs-ը ձեր KIFF պլանի մասն է (§8). taf-ի յուրաքանչյուր գործարկում կրեդիտներ է օգտագործում AI-ի համար, որն օգտագործել է։ Coach-ը և taf-երի կարգավորումը ներառված են Coach-ի արդար օգտագործման շրջանակներում։
		</p>
	</section>
}

templ termsAccountHY() {
	<section id="account">
		<h2>4. Հաշիվներ և մուտք</h2>
		<p>
			Ծառայությունն օգտագործելու համար պետք է հաշիվ ստեղծեք։ Համաձայնվում եք տրամադրել ճշգրիտ գրանցման տվյալներ, ձեր հավատարմագրերը պահել գաղտնի և պատասխանատու լինել ձեր հաշվի ներքո ողջ գործունեության համար։
		</p>
		<p>
			Պետք է լինեք առնվազն 16 տարեկան, կամ ձեր իրավազորության թվային համաձայնության տարիքի, որն ավելի բարձր է։ Ծառայությունը նախատեսված չէ երեխաների համար։
		</p>
		<p>
			Ծառայությունն առաջարկվում է միայն այն երկրներում և տարածաշրջաններում, որտեղ Anthropic-ը, որը տրամադրում է նրա AI մոդելը, առաջարկում է իր սեփական ծառայությունը, ինչպես <a href="https://www.anthropic.com/supported-countries">նշում է Anthropic-ը</a>։ Այն չեք կարող օգտագործել որևէ այլ վայրից։ Ընկերությունը չի կարող օգտագործել այն, եթե նրա կենտրոնակայանը, կամ նրան մեծամասնությամբ տիրապետող կամ վերահսկող ընկերության կենտրոնակայանը, այդ ցանկից դուրս գտնվող երկրում կամ տարածաշրջանում է, որտեղ էլ լինեն նրա օգտատերերը։ Չեք կարող օգտագործել նաև, եթե դուք կամ այն ընկերությունը, որի համար օգտագործում եք, ենթակա եք Եվրոպական միության, Միավորված ազգերի կազմակերպության կամ Միացյալ Նահանգների պատժամիջոցներին։ Մենք մերժում ենք այս կանոնը խախտող հաշիվները և կարող ենք կասեցնել այն հաշիվը, որը խախտում է։
		</p>
		<p>
			Դուք պատասխանատու եք ձեր հաշվի վրա լիազորած յուրաքանչյուր Օգտատիրոջ գործողությունների համար։ Կարող ենք կասեցնել հաշիվը կամ չեղարկել մուտքը ողջամիտ ծանուցմամբ, եթե հայտնաբերենք այս պայմանների հավաստի խախտում։ Թույլատրելի օգտագործման խախտումների դեպքում (տե՛ս §5) կասեցումը կարող է լինել անմիջական։
		</p>
	</section>
}

templ termsAcceptableUseHY() {
	<section id="acceptable-use">
		<h2>5. Թույլատրելի օգտագործում</h2>
		<p>
			Դուք, ձեր օգտատերերը և ձեր գործակալները պետք է պահպանեք <a href="/acceptable-use">Թույլատրելի օգտագործման քաղաքականությունը</a> (անգլերեն)։ Այն այս պայմանների մասն է և թվարկում է, թե ինչի համար չի կարելի օգտագործել Ծառայությունը։
		</p>
		<p>
			Կարող ենք անմիջապես կասեցնել AUP-ի հավաստի խախտման դեպքում։ Պարտավոր չենք վերահսկել Հաճախորդի բովանդակությունը, բայց կարող ենք գործել հավաստի հաղորդումների հիման վրա։
		</p>
	</section>
}

templ termsCustomerDataHY() {
	<section id="customer-data">
		<h2>6. Հաճախորդի տվյալներ և բովանդակություն</h2>
		<p>
			Դուք տիրապետում եք ձեր Աուդիտի տվյալներին։ Դուք Kiff Agents OÜ-ին շնորհում եք սահմանափակ, ոչ բացառիկ, անհատույց, համաշխարհային լիցենզիա՝ հոսթավորելու, պատճենելու, փոխանցելու, ցուցադրելու և այլ կերպ մշակելու ձեր Աուդիտի տվյալները միայն այնքանով, որքանով անհրաժեշտ է Ծառայությունը ձեզ համար աշխատեցնելու, պահպանելու և բարելավելու համար։
		</p>
		<p>
			Մենք գործում ենք որպես <strong>մշակող</strong> ձեր Աուդիտի տվյալների և ձեր tafs տվյալների համար GDPR-ի 28-րդ հոդվածի համաձայն. <a href="/legal/dpa">DPA</a> (անգլերեն)-ն մանրամասնորեն կարգավորում է այդ հարաբերությունը։ Մենք գործում ենք որպես <strong>վերահսկիչ</strong> ձեր հաշվի մետատվյալների համար. <a href="/hy/privacy">գաղտնիության քաղաքականությունը</a> կարգավորում է այդ հարաբերությունը։
		</p>
		<p>
			Դուք հայտարարում եք, որ ունեք բոլոր իրավունքները, որոնք անհրաժեշտ են ձեր ներկայացրած տվյալները ներկայացնելու համար, և որ ներկայացումը համապատասխանում է կիրառելի օրենքներին (ներառյալ տվյալների պաշտպանության օրենքները և, որտեղ կիրառելի է, ԵՄ AI օրենքը)։
		</p>
	</section>
}

templ termsConfidentialityHY() {
	<section id="confidentiality">
		<h2>7. Գաղտնիություն</h2>
		<p>
			Յուրաքանչյուր կողմ կարող է մյուսից ստանալ ոչ հրապարակային տեղեկատվություն («Գաղտնի տեղեկատվություն»)։ Ստացող կողմը Գաղտնի տեղեկատվությունը կօգտագործի միայն այնքանով, որքանով անհրաժեշտ է այս պայմաններով իր պարտավորությունները կատարելու և իր իրավունքները իրականացնելու համար, և այն կպաշտպանի առնվազն նույն խնամքով, ինչ օգտագործում է իր սեփական գաղտնի տեղեկատվության համար։
		</p>
		<p>
			Գաղտնի տեղեկատվությունը չի ներառում տեղեկատվություն, որը (ա) դառնում է կամ հանրությանը հասանելի է առանց խախտման, (բ) ստացող կողմին հայտնի էր բացահայտումից առաջ, (գ) անկախ կերպով մշակվել է Գաղտնի տեղեկատվությունն օգտագործելու առանց, կամ (դ) պետք է բացահայտվի օրենքով (մյուս կողմին ծանուցմամբ, որտեղ թույլատրվում է)։
		</p>
	</section>
}

templ termsFeesHY() {
	<section id="fees">
		<h2>8. Վճարներ և վճարում</h2>
		<p>
			<strong>Պլաններ։</strong> Յուրաքանչյուր հաշիվ ունի մեկ պլան։ Ընթացիկ գները <a href="/pricing">գների էջում</a> (անգլերեն) են. այս թարմացման պահին՝
		</p>
		<ul>
			<li><strong>Solo՝</strong> մեկ անձ, tafs-ի համար, վաճառվում է tafs հավելվածում App Store-ի կամ Google Play-ի միջոցով ամսական 12,50 €, ԱԱՀ-ն ներառյալ, ամսական 500 ներառված կրեդիտով։</li>
			<li><strong>Company՝</strong> ամսական 10,50 € յուրաքանչյուր տեղի համար, ամսական 500 կրեդիտ յուրաքանչյուր տեղի համար, միավորված, և ձեր սեփական գործակալների զանգերի համար KIFF Cloud-ով՝ ամսական 500 գործողություն յուրաքանչյուր տեղի համար, միավորված։</li>
			<li><strong>Համաձայնագիր՝</strong> վճարները և պայմանները նրա պատվերի ձևում։</li>
		</ul>
		<p>
			Տեղերը հաշվի ադմինիստրատորներն ու խմբագիրներն են։ Հաստատողները և դիտողները անվճար են ցանկացած պլանում։ Company-ում, ներառվածից բացի, կրեդիտը արժե 0,01 €, իսկ գործողությունը՝ 0,02 €։ Ներառվածից ավելի կրեդիտները հաշվարկվում են մինչև ամսական ծախսի սահմանաչափը, որը սահմանում է հաշիվը (50 € սկզբում). սահմանաչափին KIFF-ը հաշվի taf-երի նոր գործարկում չի սկսում, մինչև հաջորդ ժամանակահատվածը սկսվի, կամ վճարումները կառավարող որևէ մեկը այն բարձրացնի։
		</p>
		<p>
			<strong>Կրեդիտների փաթեթներ։</strong> Solo-ում ամսվա ներառվածից ավելի կրեդիտները գալիս են կրեդիտների փաթեթներից, որոնք գնվում են tafs հավելվածում։ Փաթեթը գնվում է մեկ անգամ, ժամկետը չի լրանում և բաժանորդագրություն չէ. նրա կրեդիտները օգտագործվում են ամսվա ներառվածներից հետո, ամենահին փաթեթը՝ առաջինը։ Փաթեթը, որի վճարումը լրիվ վերադարձվել է, հետ է վերցվում՝ իր մնացած կրեդիտներով։ Երբ ամսվա կրեդիտները և փաթեթները սպառվում են, KIFF-ը հաշվի taf-երի նոր գործարկում չի սկսում, մինչև հաջորդ ժամանակահատվածը սկսվի կամ փաթեթ ավելացվի։ Բոնուս կրեդիտները, որոնք KIFF-ը ավելացնում է հաշվին, նույնպես ժամկետ չունեն, ինչպես փաթեթները։
		</p>
		<p>
			<strong>Ինչ է հաշվվում։</strong> <em>Կրեդիտը</em> վճարում է այն AI-ի համար, որն օգտագործել է taf-ի գործարկումը, ամբողջ կրեդիտներով, կլորացված վերև մեկ անգամ յուրաքանչյուր գործարկման համար և հաշվվում է մեկ անգամ, երբ գործարկումն ավարտվում է։ Գործարկում, որի զանգը KIFF-ը մերժել է, միևնույն է, օգտագործել է իր AI-ն։ Երբեք չեն հաշվվում՝ Coach-ը և taf-երի կարգավորումը՝ Coach-ի արդար օգտագործման շրջանակում. նոր տարբերակի փորձարկում, որը ոչինչ չի ուղարկում. և գործարկում, որը ձախողվել է մեր կողմից։ <em>Գործողությունը</em> ձեր սեփական գործակալի զանգն է KIFF Cloud-ով, որը ինչ-որ բան արեց. KIFF-ը թույլ տվեց այն, ուղարկվեց, և գործիքը հաջողություն հաղորդեց։ Երբեք չի հաշվվում որպես գործողություն՝ զանգ, որը մերժվել է, կասեցվել և հետո մերժվել, կանգնեցվել է կանգնեցմամբ (halt), անվավեր է, ձախողվել է գործիքի մոտ կամ որի արդյունքն անհայտ է, և զանգ, որը միայն կարդում է։
		</p>
		<p>
			<strong>Առանց փորձաշրջանի։</strong> Հաշիվը վճարում է առաջին օրից։ Պլանը սկսվելուց առաջ KIFF-ը չի սկսում նրա taf-երի ոչ մի գործարկում, բացի Coach-ի կարգավորումից. ոչինչ չի ջնջվում։
		</p>
		<p>
			<strong>Վճարում և հաշիվ-ապրանքագրեր։</strong> Պլանը հաշվարկվում է մեկ տեղում։ kiff.dev-ում գնված պլանը գնվում է, փոխվում և չեղարկվում է այնտեղ և այն վճարումների պորտալում, որին այն հղում է, և նրա վճարումները մշակում է Stripe-ը։ tafs հավելվածում գնված Solo-ն վաճառվում է App Store-ի միջոցով iPhone-ում և iPad-ում, կամ Google Play-ի միջոցով Android-ում, և կառավարվում է ձեր Apple-ի կամ Google Play-ի բաժանորդագրություններում՝ այդ խանութի վճարման, թարմացման և վերադարձի պայմաններով։ Կրեդիտների փաթեթները գնվում են հավելվածում։ Company-ն գնվում է kiff.dev-ում։ Վճարները հաշվարկվում են ամսական՝ նախապես. ներառվածից ավելի օգտագործումը հաշվարկվում է հաջորդ հաշիվ-ապրանքագրով։ Մարդկանց թվի փոփոխությունը կիրառվում է հաջորդ հաշիվ-ապրանքագրից։ Եթե վճարումը ձախողվի և չուղղվի, պլանը ավարտվում է, և KIFF-ը մերժում է հաշվի զանգերը, մինչև պլան ընտրվի։
		</p>
		<p>
			<strong>Չեղարկում։</strong> Կարող եք չեղարկել ցանկացած ժամանակ վճարումների պորտալում, կամ հավելվածում գնված Solo-ի համար՝ ձեր Apple-ի կամ Google Play-ի բաժանորդագրություններում։ Պլանը տևում է մինչև վճարված ժամանակահատվածի ավարտը և չի թարմացվում։ Օրենքի պահանջից բացի, արդեն վճարված վճարները չեն վերադարձվում։ Եթե ԵՄ-ում սպառող եք, կարող եք գնումից 14 օրվա ընթացքում հրաժարվել առանց պատճառ նշելու, և մենք վերադարձնում ենք ձեր վճարածը՝ հանած պլանի արդեն անցած օրերի բաժինը։ Solo-ի գնումները վերադարձվում են App Store-ի կամ Google Play-ի միջոցով՝ նրանց պայմաններով։
		</p>
		<p>
			<strong>Միկրոձեռնարկություններ։</strong> Եթե ձեր բիզնեսն ունի 10-ից քիչ մարդ և տարեկան շրջանառություն կամ հաշվեկշռի ընդհանուր գումար ոչ ավելի, քան 2 միլիոն €, մենք այն դիտարկում ենք որպես սպառող այս պայմանների յուրաքանչյուր կանոնի համար՝ քարտով վճարումների վերաբերյալ, ներառյալ Company-ն։
		</p>
		<p>
			<strong>ԱԱՀ։</strong> Company-ի գները ԱԱՀ չեն ներառում. Solo-ն ու կրեդիտների փաթեթները վաճառվում են App Store-ի կամ Google Play-ի կողմից ԱԱՀ-ով։ Kiff Agents OÜ-ն (ԱԱՀ համար EE102924327) ավելացնում է Էստոնիայի ԱԱՀ-ն, որտեղ կիրառելի է։ ԵՄ բիզնես-բիզնես վաճառքները Էստոնիայից դուրս Հաճախորդին՝ վավեր ԱԱՀ նույնականացման համարով, հաշվարկվում են ԵՄ հակադարձ գանձման մեխանիզմով։
		</p>
		<p>
			<strong>Փոփոխություններ։</strong> Ակտիվ հաշիվներին գրավոր ծանուցում ենք տալիս գնի բարձրացման մասին առնվազն երեսուն օր առաջ (§16)։ Գնի իջեցումը կիրառվում է հաջորդ հաշիվ-ապրանքագրից։
		</p>
	</section>
}

templ termsTermHY() {
	<section id="term">
		<h2>9. Ժամկետ և դադարեցում</h2>
		<p>
			Այս պայմանները ուժի մեջ են մտնում, երբ առաջին անգամ օգտագործում եք Ծառայությունը, և շարունակվում են մինչև դադարեցումը։
		</p>
		<p>
			Կարող եք դադարեցնել ցանկացած ժամանակ՝ ջնջելով ձեր հաշիվը։ Մենք կարող ենք դադարեցնել (ա) էական խախտման համար, որը չի ուղղվել գրավոր ծանուցումից երեսուն օրվա ընթացքում, կամ (բ) անմիջապես թույլատրելի օգտագործման խախտումների կամ անվճարունակության դեպքերի համար։
		</p>
		<p id="leaving">
			<strong>Հեռանալը և ձեր տվյալները ձեզ հետ վերցնելը։</strong> Ձեր տվյալները կարող եք արտահանել ցանկացած ժամանակ՝ կառուցվածքավորված, մեքենայով ընթեռնելի ձևաչափով. KIFF-ում Կարգավորումներ → Տվյալներ տալիս է JSON ֆայլ ձեր հաշվով, ձեր Card-երով՝ յուրաքանչյուր տարբերակով, ձեր Գրանցամատյանի որոշումներով (վերջին 10 000. խնդրեք մեզնից ավելին), յուրաքանչյուր KIFF-ի թույլատրածի ստորագրված անդորրագրով և ձեր API բանալիների մանրամասներով (երբեք բանալիներն իրենք)։ tafs հավելվածում յուրաքանչյուր մարդ արտահանում է իր սեփական զրույցները, ֆայլերը և նշումները Հաշիվ → Արտահանել իմ զրույցները. զրույցները ամեն դեպքում պահվում են երեսուն օր, ինչպես ասում է գաղտնիության քաղաքականությունը։ Ձեր հաշվի ջնջումը անմիջապես ավարտում է Ծառայությունը, ուստի նախ արտահանեք։
		</p>
		<p>
			Կարող եք փոխարենը հեռանալ ծանուցմամբ՝ մեկ այլ մատակարարի կամ ձեր սեփական համակարգերին անցնելու համար, գրելով <a href="mailto:support@kiff.dev">support@kiff.dev</a> հասցեին։ Մենք երբեք երկու ամսից ավելի ծանուցում չենք պահանջում. ձեր ծանուցումը ուժի մեջ է մտնում ձեր ընտրած ամսաթվին, ոչ ուշ, քան այն ուղարկելուց երկու ամիս հետո։ Այդ ամսաթվից հետո հետևում է երեսուն օրվա անցումային ժամանակահատված, որի ընթացքում Ծառայությունը շարունակում է աշխատել, դուք արտահանում եք ձեր տվյալները և տեղափոխում եք ձեր աշխատանքը, և մենք օգնում ենք դրա համար ողջամիտ հարցումներով։ Անցումային ժամանակահատվածը կարող եք երկարացնել մեկ անգամ՝ որքան անհրաժեշտ է։ Եթե տեխնիկապես չկարողանանք ավարտել այն երեսուն օրվա ընթացքում, ձեզ կասենք ձեր ծանուցումից տասնչորս աշխատանքային օրվա ընթացքում՝ պատճառներով և ոչ ավելի, քան յոթ ամսվա նոր ժամանակահատվածով։ Անցումային ժամանակահատվածից հետո ձեր տվյալները մնում են արտահանման համար հասանելի առնվազն ևս երեսուն օր։ Պլանի վճարները շարունակվում են սովորաբար մինչև անցումային ժամանակահատվածի ավարտը։ App Store-ում կամ Google Play-ում գնված Solo-ն չեղարկվում է խանութում. անցման և արտահանման ժամանակահատվածները կիրառվում են նույն կերպ։
		</p>
		<p>
			Մենք վճար չենք գանձում հեռանալու, անցնելու կամ ձեր տվյալները արտահանելու համար։ Այս բաժինը յուրաքանչյուր հաճախորդին տալիս է ԵՄ Տվյալների օրենքի (Կանոնակարգ (ԵՄ) 2023/2854) VI գլխի անցման իրավունքները։
		</p>
		<p>
			Դադարեցման ժամանակ և ցանկացած անցման և արտահանման ժամանակահատվածից հետո ջնջում ենք ձեր Աուդիտի տվյալները, ձեր tafs տվյալները և հաշվի մետատվյալները՝ <a href="/hy/privacy#retention">գաղտնիության քաղաքականության</a> պահպանման կանոններին համապատասխան։
		</p>
		<p>
			Բաժինները, որոնք իրենց բնույթով պետք է գոյատևեն դադարեցումից հետո, գոյատևում են — ներառյալ գաղտնիությունը, մտավոր սեփականությունը, փոխհատուցումը, պատասխանատվության սահմանափակումը, հրաժարումները, կիրառելի իրավունքը և ցանկացած կուտակված վճար։
		</p>
	</section>
}

templ termsWarrantiesHY() {
	<section id="warranties">
		<h2>10. Երաշխիքներ</h2>
		<p>
			Յուրաքանչյուր կողմ հայտարարում է, որ ունի իրավունք և լիազորություն այս պայմանները կնքելու և կատարելու։
		</p>
		<p>
			Երաշխավորում ենք, որ Ծառայությունը կմատուցենք պրոֆեսիոնալ կերպով և Փաստաթղթերին էապես համապատասխան։ Այս երաշխիքի խախտման դեպքում ձեր միակ միջոցը, մեր ընտրությամբ, կրկնակի կատարումն է կամ խախտման ժամանակահատվածի համար տուժած Ծառայությանը վերագրվող վճարների համամասնական վերադարձը։
		</p>
		<p>
			Դուք երաշխավորում եք, որ Ծառայության ձեր օգտագործումը համապատասխանում է կիրառելի օրենքին և այս պայմաններին։
		</p>
	</section>
}

templ termsDisclaimerHY() {
	<section id="disclaimer">
		<h2>11. Հրաժարում</h2>
		<p>
			§10-ում արտահայտված երաշխիքներից բացի, Ծառայությունը տրամադրվում է <strong>«ինչպես կա» և «ինչպես հասանելի է»</strong>։ Օրենքով թույլատրված առավելագույն չափով մենք հրաժարվում ենք բոլոր այլ երաշխիքներից՝ արտահայտված, ենթադրյալ կամ օրենսդրական, ներառյալ առևտրային պիտանիության, կոնկրետ նպատակի համար համապատասխանության, չխախտման և գործարար պրակտիկայից կամ առևտրային սովորույթից բխող ցանկացած երաշխիք։
		</p>
		<p>
			Մենք չենք երաշխավորում, որ Ծառայությունը կլինի անընդհատ, առանց սխալների կամ վնասակար բաղադրիչներից զերծ, կամ որ որևէ տվյալ չի կորչի կամ չի վնասվի։ Դուք պատասխանատու եք ձեր տվյալների պահուստային պատճենների համար։
		</p>
	</section>
}

templ termsLiabilityHY() {
	<section id="liability">
		<h2>12. Պատասխանատվության սահմանափակում</h2>
		<p>
			Օրենքով թույլատրված առավելագույն չափով ոչ մի կողմ պատասխանատվություն չի կրի մյուսի առջև որևէ անուղղակի, պատահական, հետևանքային, հատուկ, օրինակելի կամ պատժիչ վնասի համար, ներառյալ կորցրած շահույթը, կորցրած եկամուտը, կորցրած տվյալները կամ բիզնեսի ընդհատումը, որոնք բխում են այս պայմաններից կամ Ծառայությունից կամ կապված են դրանց հետ, նույնիսկ եթե զգուշացվել է նման վնասների հնարավորության մասին։
		</p>
		<p>
			Յուրաքանչյուր կողմի ընդհանուր պատասխանատվությունը, որը բխում է այս պայմաններից կամ կապված է դրանց հետ, չի գերազանցի առավելագույնը՝ (ա) այն վճարները, որոնք Հաճախորդը վճարել է կամ պետք է վճարի Kiff Agents OÜ-ին պատասխանատվություն առաջացրած իրադարձությունից նախորդող տասներկու ամսվա ընթացքում, կամ (բ) հարյուր հազար եվրո (100 000 €)։
		</p>
		<p>
			Այս պայմաններում ոչինչ չի սահմանափակում կամ բացառում է պատասխանատվություն, որը կիրառելի իրավունքով չի կարող սահմանափակվել կամ բացառվել, ներառյալ պատասխանատվությունը մահվան, անփութությամբ պայմանավորված մարմնական վնասվածքի, խարդախության կամ դիտավորյալ սխալ վարքագծի համար, և պատասխանատվությունը թերի արտադրանքի համար այն օրենքներով, որոնք իրականացնում են Դիրեկտիվ (ԵՄ) 2024/2853-ը թերի արտադրանքի պատասխանատվության մասին։
		</p>
	</section>
}

templ termsIndemnityHY() {
	<section id="indemnification">
		<h2>13. Փոխհատուցում</h2>
		<p>
			Մենք կպաշտպանենք ձեզ երրորդ կողմերի պահանջներից, որ Ծառայությունը, ինչպես մեր կողմից տրամադրվում է և ձեր կողմից օգտագործվում այս պայմաններին համապատասխան, խախտում է այդ երրորդ կողմի մտավոր սեփականության իրավունքները, և կվճարենք ձեր դեմ վերջնականապես նշանակված վնասները (կամ համաձայնեցված հաշտության գումարը) նման պահանջների համար։
		</p>
		<p>
			Դուք կպաշտպանեք մեզ երրորդ կողմերի պահանջներից, որոնք բխում են (ա) ձեր Հաճախորդի տվյալներից կամ բովանդակությունից. (բ) Ծառայության ձեր օգտագործումից այս պայմանների խախտմամբ (ներառյալ AUP-ը). կամ (գ) ձեր կոպիտ անփութությունից կամ դիտավորյալ սխալ վարքագծից, և կվճարեք մեր դեմ վերջնականապես նշանակված վնասները (կամ համաձայնեցված հաշտության գումարը) նման պահանջների համար։
		</p>
		<p>
			Փոխհատուցումը պայմանավորված է պահանջի մասին անհապաղ ծանուցմամբ, պաշտպանության և հաշտության բացառիկ վերահսկողությամբ փոխհատուցողի կողմից և ողջամիտ համագործակցությամբ փոխհատուցվողի կողմից։ Փոխհատուցողը չի կարող հաշտվել պահանջի շուրջ, որը փոխհատուցվողի վրա պարտավորություններ է դնում, առանց համաձայնության։
		</p>
	</section>
}

templ termsSLAHY() {
	<section id="sla">
		<h2>14. Ծառայության մակարդակի պարտավորություն</h2>
		<p>
			Վճարովի պլանում <a href="/legal/sla">ծառայության մակարդակի համաձայնագիրը</a> (անգլերեն) սահմանում է մատչելիությունը, որի հանդեպ պարտավորվում ենք, ինչպես է հաշվվում դանդաղ կամ ձախողված հարցումը, մեր աջակցության պատասխանի ժամկետները և ծառայության կրեդիտները, երբ թերանում ենք։ Այն այս պայմանների մասն է։
		</p>
		<p>
			Գործառնական պրակտիկաները, միջադեպերին արձագանքը և խախտումների մասին ծանուցման պարտավորությունները փաստաթղթավորված են այս Պայմաններից հղված ամսաթվավորված խմբագրությամբ (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>). <a href="/security">/security</a> (անգլերեն)-ը ցույց է տալիս ընթացիկ պրակտիկաները։
		</p>
	</section>
}

templ termsServiceModsHY() {
	<section id="service-mods">
		<h2>15. Ծառայության փոփոխություններ</h2>
		<p>
			Կարող ենք ցանկացած ժամանակ ավելացնել, փոխել կամ հեռացնել գործառույթներ։ Գործառույթի էական կրճատումների կամ API մակերեսի հանման մասին, որը խախտում է փաստաթղթավորված վարքագիծը, ակտիվ հաճախորդներին ծանուցվում է առնվազն երեսուն օր առաջ՝ հրապարակված հանման ժամանակացույցով։ Անվտանգությամբ պայմանավորված փոփոխությունները կարող են կատարվել առանց ծանուցման, որտեղ ծանուցումն ինքնին ռիսկ կստեղծեր։
		</p>
	</section>
}

templ termsTermsModsHY() {
	<section id="terms-mods">
		<h2>16. Այս պայմանների փոփոխություններ</h2>
		<p>
			Կարող ենք ժամանակ առ ժամանակ փոփոխել այս պայմանները։ Էական փոփոխությունների մասին ծանուցվում է էլ. փոստով և այս էջի ակնառու պաստառով առնվազն երեսուն օր առաջ։ Ոչ էական փոփոխությունները (պարզաբանումներ, հղումներ) հրապարակվում են նոր «վերջին թարմացում» ամսաթվով։ Թարմացման ուժի մեջ մտնելուց հետո Ծառայության շարունակական օգտագործումը համաձայնություն է։
		</p>
	</section>
}

templ termsForceMajeureHY() {
	<section id="force-majeure">
		<h2>17. Ֆորս մաժոր</h2>
		<p>
			Ոչ մի կողմ պատասխանատու չէ կատարման որևէ ձախողման կամ ուշացման համար այն չափով, որքանով դա պայմանավորված է իր ողջամիտ վերահսկողությունից դուրս հանգամանքներով, ներառյալ ֆորս մաժորը, պատերազմը, ահաբեկչությունը, քաղաքացիական անկարգությունները, աշխատանքային վեճերը, հրդեհը, բնական աղետը, համաճարակի հետ կապված կառավարական գործողությունները, ինտերնետի կամ հոսանքի անջատումները կամ հեռահաղորդակցության մատակարարների կամ երրորդ կողմի հոսթինգի ենթակառուցվածքի գործողությունները։
		</p>
	</section>
}

templ termsGoverningLawHY() {
	<section id="governing-law">
		<h2>18. Կիրառելի իրավունք և իրավազորություն</h2>
		<p>
			Այս պայմանները կարգավորվում են Էստոնիայի Հանրապետության օրենքներով՝ առանց հաշվի առնելու նրա օրենքների բախման կանոնները։ Վեճերի բացառիկ ատյանը Հարյու շրջանային դատարանն է Տալլինում։
		</p>
		<p>
			Երբ դուք սպառող եք, որը բնակվում է ԵՄ մեկ այլ անդամ պետությունում, ձեր բնակության իրավազորության պարտադիր սպառողական պաշտպանության կանոնները շարունակում են կիրառվել այն չափով, որքանով տալիս են ձեզ իրավունքներ, որոնցից պայմանագրով չեք կարող հրաժարվել. այս դրույթը ձեզ չի զրկում այդ կանոնների պաշտպանությունից։
		</p>
	</section>
}

templ termsGeneralHY() {
	<section id="general">
		<h2>19. Ընդհանուր դրույթներ</h2>
		<p>
			<strong>Ամբողջ համաձայնագիր։</strong> Այս պայմանները, գաղտնիության քաղաքականության, DPA-ի, ցանկացած պատվերի ձևի և ցանկացած բացահայտ ներառված լրացուցիչ պայմանների հետ միասին, մեր միջև ամբողջ համաձայնագիրն են իրենց առարկայի վերաբերյալ և փոխարինում են ցանկացած նախորդ կամ միաժամանակյա պայմանավորվածության։
		</p>
		<p>
			<strong>Առանձնացվելիություն։</strong> Եթե դրույթը ճանաչվում է անկատարելի, մնացածը մնում են ուժի մեջ։
		</p>
		<p>
			<strong>Զիջում։</strong> Այս պայմանները չեք կարող զիջել առանց մեր գրավոր համաձայնության։ Մենք կարող ենք զիջել առանց համաձայնության՝ միաձուլման, ձեռքբերման կամ մեր ամբողջ կամ գրեթե ողջ ակտիվների վաճառքի կապակցությամբ՝ ձեզ ծանուցմամբ։
		</p>
		<p>
			<strong>Հրաժարման բացակայություն։</strong> Որևէ դրույթի չկիրառումը չի նշանակում դրա հետագայում կիրառելու իրավունքից հրաժարում։
		</p>
		<p>
			<strong>Ծանուցումներ։</strong> Ծանուցումները Kiff Agents OÜ-ին ուղարկվում են <a href="mailto:legal@kiff.dev">legal@kiff.dev</a> հասցեին կամ փոստով՝ Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Էստոնիա։ Ձեզ ուղղված ծանուցումները ուղարկվում են ձեր հաշվի հետ կապված էլ. փոստին կամ, եթե տվել եք, ձեր նշանակված իրավական ծանուցումների հասցեին։
		</p>
		<p>
			<strong>Անկախ կապալառուներ։</strong> Այս պայմաններում ոչինչ չի ստեղծում գործընկերություն, գործակալություն, համատեղ ձեռնարկություն կամ աշխատանքային հարաբերություն։
		</p>
		<p>
			<strong>Երրորդ կողմի շահառուներ։</strong> Չկան, բացի այն չափից, որով փոխհատուցվող կապակցված անձինք բացահայտ նույնականացված են։
		</p>
	</section>
}

