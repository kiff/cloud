package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// TermsMN is KIFF's terms (/terms) in Mongolian, at /mn/terms.
// It is a translation of Terms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Mongolian has the legal
// texts only, so a link to any other page goes to English and says so.
templ TermsMN() {
	@components.LayoutSite("KIFF — terms of service", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@termsHeadMN()
			@termsDefinitionsMN()
			@termsAgreementMN()
			@termsServiceMN()
			@termsTafsMN()
			@termsAccountMN()
			@termsAcceptableUseMN()
			@termsCustomerDataMN()
			@termsConfidentialityMN()
			@termsFeesMN()
			@termsTermMN()
			@termsWarrantiesMN()
			@termsDisclaimerMN()
			@termsLiabilityMN()
			@termsIndemnityMN()
			@termsSLAMN()
			@termsServiceModsMN()
			@termsTermsModsMN()
			@termsForceMajeureMN()
			@termsGoverningLawMN()
			@termsGeneralMN()
			@termsContactMN()
		</article>
	}
}

templ termsHeadMN() {
	<header class="legal-head">
		<p class="legal-badge">Үйлчилгээний нөхцөл · v0.1</p>
		<h1>Үйлчилгээний нөхцөл</h1>
		<p class="legal-meta">
			<strong>Сүүлд шинэчилсэн:</strong> 2026 оны арваннэгдүгээр сарын 21. <strong>Хүчинтэй болох огноо:</strong> 2026 оны тавдугаар сарын 24.
		</p>
		<p class="legal-disclaimer">
			<strong>Юу өөрчлөгдсөн:</strong> өөр бизнес таныг танилцуулсан үед таны гэрээ хэнтэй байх (§2), болон бичил аж ахуйн нэгжүүд (§8). Өмнө нь: Үйлчилгээг хэн ашиглаж болох, бүс нутгаар, өмчлөл ба хориг (§4); Android дээрх tafs апп, Google Play-ээр худалдан авсан Solo (§1, §8). Түүнээс өмнө: төлбөртэй төлөвлөгөө (§3A, §8), <a href="/legal/sla">үйлчилгээний түвшний гэрээ</a> (англиар) (§14), болон хориотой хэрэглээний жагсаалт, одоо <a href="/acceptable-use">Зөвшөөрөгдөх хэрэглээний бодлого</a> (англиар) (§5)-д байгаа.
		</p>
		<p class="legal-disclaimer">
			Эдгээр нөхцөл нь tafs-ийг оруулан KIFF Cloud-ын хэрэглээг зохицуулна. Гэрээний асуулт: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</header>
}

templ termsDefinitionsMN() {
	<section id="definitions">
		<h2>1. Тодорхойлолт</h2>
		<ul>
			<li><strong>"Kiff Agents OÜ"</strong>, <strong>"бид"</strong>, <strong>"биднийг"</strong>, <strong>"манай"</strong> — Үйлчилгээг үзүүлэгч Эстонийн хувийн хязгаарлагдмал хариуцлагатай компани. Бүртгэлийн код 17372313.</li>
			<li><strong>"Үйлчлүүлэгч"</strong>, <strong>"та"</strong>, <strong>"таны"</strong> — эдгээр нөхцөлийг зөвшөөрч буй хувь хүн эсвэл хуулийн этгээд.</li>
			<li><strong>"Хэрэглэгч"</strong> — Үйлчлүүлэгч өөрийн бүртгэлээр Үйлчилгээнд хандахыг эрх олгосон дурын хувь хүн.</li>
			<li><strong>"Үйлчилгээ"</strong> — <code>api.kiff.dev</code>, <code>app.kiff.dev</code>, <code>kiff.dev</code>, tafs, мөн тэнд бидний нийтэлсэн баримт бичиг, хяналтын самбар, API-г оруулсан KIFF Cloud бүтээгдэхүүн.</li>
			<li><strong>"tafs"</strong> — iPhone, iPad, Android болон компьютер (Mac, Windows, Linux)-д зориулсан tafs апп болон түүний цаадах үйлчилгээ, түүний дотор Setup болон planque (§3A), үүнд Үйлчлүүлэгч ажлыг KIFF Card-уудын хүрээнд ажилладаг AI агентад даалгадаг. <strong>"taf"</strong> нь тийм нэг агент юм.</li>
			<li><strong>"Тенант"</strong> — Үйлчилгээний дотор нэг Үйлчлүүлэгчид хамаарах логикоор тусгаарлагдсан ажлын орон зай.</li>
			<li><strong>"Аудитын өгөгдөл"</strong> — Үйлчилгээ runtime-аар дамжуулан Үйлчлүүлэгчийн нэрийн өмнөөс хадгалдаг үйл явдал, шийдвэр, үйлдэл, зөвшөөрөл, баримтууд.</li>
			<li><strong>"tafs өгөгдөл"</strong> — tafs Үйлчлүүлэгчийн нэрийн өмнөөс хадгалдаг зүйл: taf бүрийн ажиллалт, чат (Үйлчлүүлэгчийн холбосон хэрэгслүүдийн түүнд буцаасан зүйлийг оруулан), түүний тайлан, санах ойн тэмдэглэл, мөн түүний мэдэгдэлд бүртгүүлсэн утаснууд.</li>
			<li><strong>"Баримт"</strong> — Үйлчилгээний зохицуулагдсан үйлдэл бүрт гаргадаг гарын үсэг зурсан, хувилбартай шийдвэрийн бүртгэл.</li>
			<li><strong>"Баримт бичиг"</strong> — эдгээр Нөхцөлөөс холбосон огноотой хувилбар дахь Үйлчилгээний техникийн баримт бичиг болон аюулгүй байдлын арга хэмжээ (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>). Стратегийн цагаан ном, маркетингийн материал, тусад нь лицензтэй нээлттэй эхийн фреймворкийн баримт бичгийг оруулахгүй.</li>
			<li><strong>"DPA"</strong> — боловсруулагчийн талын харилцааг зохицуулдаг <a href="/legal/dpa">/legal/dpa</a> (англиар) дахь Өгөгдөл боловсруулах гэрээ.</li>
		</ul>
	</section>
}

templ termsAgreementMN() {
	<section id="agreement">
		<h2>2. Гэрээ</h2>
		<p>
			Эдгээр нөхцөл таны Үйлчилгээг ашиглахыг зохицуулна. Бүртгэл үүсгэх, API түлхүүр гаргах эсвэл Үйлчилгээг өөр байдлаар ашигласнаар та эдгээр нөхцөлийг зөвшөөрнө. Хэрэв та компани эсвэл бусад хуулийн этгээдийн өмнөөс зөвшөөрч байгаа бол тэр этгээдийг үүрэгжүүлэх эрхтэй гэдгээ мэдэгдэж, "та" болон "таны" нь тэр этгээдийг заана.
		</p>
		<p>
			Хэрэв хөгжүүлэгч, түнш эсвэл өөр бизнес таныг KIFF-д танилцуулсан эсвэл таны ашигладаг агентыг бүтээсэн бол Үйлчилгээний талаарх таны гэрээ эдгээр нөхцөлийн дагуу шууд бидэнтэй бөгөөд та тэдгээрийг өөрөө зөвшөөрнө. Тэр бизнес бидний төлөөлөгч биш: тэр эдгээр нөхцөлийг зөвшөөрч, таны өмнөөс зөвшөөрөл өгч эсвэл төлбөр батлах боломжгүй бөгөөд бидний өмнөөс Үйлчилгээг зардаггүй.
		</p>
		<p>
			Бид тодорхой онцлогуудад (бета онцлог, гуравдагч этгээдийн интеграци) нэмэлт нөхцөл нийтэлж болно. Тэдгээр нь эдгээр нөхцөлтэй зөрчилдөх үед тухайн онцлогийн хувьд нэмэлт нөхцөл давуу.
		</p>
	</section>
}

templ termsServiceMN() {
	<section id="service">
		<h2>3. Үйлчилгээ</h2>
		<p>
			KIFF Cloud нь шилжүүлсэн үйлдлийг удирдах хостинг үйлчилгээ юм. Энэ нь хүсэлтийг Үйлчлүүлэгчийн тохируулсан зөвшөөрөл ба Card-уудтай тулгаж, хүний зөвшөөрөл шаардаж болох ба удирдлагын шийдвэрийг бүртгэнэ. Тохируулсан интеграциас хамааран KIFF зөвшөөрөгдсөн хүсэлтийг дамжуулдаг эсвэл хамгаалагдсан систем шалгадаг зөвшөөрлийг олгодог. Холбогдсон систем үндсэн үйлдлийг гүйцэтгэнэ.
		</p>
		<p>
			Хамаарах техникийн үйл ажиллагаа, нотолгоо, интеграцийн шаардлага, гүйцэтгэлийн хязгаарыг эдгээр Нөхцөлөөс холбосон огноотой Баримт бичигт заасан. Стратегийн <a href="/whitepaper">цагаан ном</a> (англиар) KIFF-ийн зарчим, загварыг тайлбарлана; үүнийг эдгээр Нөхцөлийн дагуу техникийн Баримт бичиг болгон оруулаагүй.
		</p>
		<p>
			KIFF Cloud-ын удирдлагын үйлчилгээ нь агентын фреймворк, ажлын урсгалын хөдөлгүүр, загварын гарц эсвэл удирдагдах агентын платформ <em>биш</em>. Энэ нь таны аль хэдийн ашиглаж буй зүйлтэй хослоно. Тодорхой жагсаалтыг нүүр хуудсан дахь <a href="/#not">"KIFF юу биш вэ"</a> (англиар)-гээс үзнэ үү. tafs нь таны олгосон Card-уудын хүрээнд таны өмнөөс агент ажиллуулдаг Үйлчилгээний цорын ганц хэсэг; §3A үүнийг тайлбарлана.
		</p>
		<p>
			Нээлттэй эхийн <a href="https://github.com/kiff/kiff" target="_blank" rel="noopener">kiff/kiff</a> фреймворк өөрийн MIT лицензээр зохицуулагдах бөгөөд эдгээр нөхцөлөөс гадуур. Та фреймворкийг өөрийн дэд бүтэц дээр ажиллуулахад Kiff Agents OÜ-тэй гэрээ байгуулагдахгүй.
		</p>
	</section>
}

templ termsTafsMN() {
	<section id="tafs">
		<h2>3A. tafs</h2>
		<p>
			tafs-д та ажлыг (жишээлбэл буцаан олголт, төлбөр төлөлт эсвэл картын маргаан) taf-д даалгадаг: энэ нь таны холбосон хэрэгслүүдээр хуваарийн дагуу, таны түүнд олгосон KIFF Card-уудын хүрээнд ажилладаг AI агент юм. Taf бүр манай агентын runtime дээр ажилладаг бөгөөд түүний ашигладаг AI загварыг Anthropic хангана. Та түүний баригдсан дуудлагад tafs аппад хариулна.
		</p>
		<p>
			<strong>Хэрэгслүүдээ холбох.</strong> tafs дахь taf шиг ажилладаг AI агент Setup нь хэрэгсэл холбох, ажилд taf тохируулахад тусалдаг. Тэр өөрөө юу ч холбодоггүй. Та хэрэгслийн өөрийн үйлчилгээ үзүүлэгчид (жишээлбэл Stripe) нэвтэрч, холболт бүр, taf-ын ашиглаж болох хэрэгслүүд болон түүний Card-уудыг төхөөрөмж дээрээ зөвшөөрнө. Тэр нэвтрэлтийн токеныг манай холболтын үйлчилгээ planque хадгална. Тэр нь шифрлэгдсэн, зөвхөн KIFF-ийн шийдсэн дуудлага хийхэд ашиглагддаг, taf-д хэзээ ч өгөгддөггүй. Хэрэгслийг салгах нь токеныг үйлчилгээ үзүүлэгч дээр хүчингүй болгож, устгана.
		</p>
		<p>
			<strong>Таны Card-ууд бол таны заавар.</strong> Taf таны хэрэгслүүдэд зөвхөн KIFF-ээр дамжуулан хүрдэг бөгөөд KIFF дуудлага бүрийг илгээхээс өмнө taf-ын Card-уудтай тулгаж шалгана. Таны олгосон Card-ийн хүрээн доторх дуудлагыг таны зааврын дагуу хийдэг. Card-аас гадуурх дуудлагыг Card-д заасны дагуу барьж эсвэл татгалздаг. Баригдсан дуудлагыг таны бүртгэл баригдсан дуудлагад хариулахыг зөвшөөрсөн хүн зөвшөөрсний дараа л хийдэг. tafs аппад хариулт нь KIFF-ийн шалгадаг тэдний төхөөрөмжийн гарын үсгийг агуулах бөгөөд баримт тэр нотолгоог хадгална. Таны бүртгэл мөн KIFF-ийн өөрт нь (хяналтын самбар, түүний командын мөрийн хэрэгсэл, эсвэл таны тэнд эрх олгосон зөвшөөрөгч) хариулж болно; тэгвэл баримт хэн, хэрхэн хариулсныг бүртгэнэ.
		</p>
		<p>
			<strong>Танд юу үлддэг.</strong> Та taf бүрийн ажил болон Card-уудыг сонгож, түүний баригдсан дуудлагад хариулж, холбосон хэрэгсэл, бүртгэлээ ашиглах эрхтэй эсэхээ шалгана. Taf-ын тайлан, мессеж, санах ойн тэмдэглэлийг AI загвар бичдэг бөгөөд алдаатай байж болно; найдахаасаа өмнө чухал зүйлээ шалгаарай.
		</p>
		<p>
			<strong>Taf-ыг зогсоох.</strong> Та нэг taf эсвэл бүгдийг зогсоох, taf-ыг түр зогсоох, түүний аль ч Card-ийг хүчингүй болгох, эсвэл устгах боломжтой. Таныг taf-ыг зогсоосон эсвэл Card-ийг хүчингүй болгосон мөчөөс эхлэн KIFF түүний дор шинэ дуудлага зөвшөөрөхгүй. tafs апп taf-ыг зогссон гэж зөвхөн KIFF болон planque хоёулаа зогсолтыг баталгаажуулсны дараа харуулдаг; тэр үеэс planque түүний ямар ч дуудлага илгээхгүй, KIFF яг өмнө нь зөвшөөрсөн дуудлагыг оруулан. Хэрэгслийн үйлчилгээ үзүүлэгчид аль хэдийн илгээсэн хүсэлт дуусч болзошгүй: бид шинэ дуудлагыг зогсооно, харин үйлчилгээ үзүүлэгчийн хийснийг буцааж чадахгүй. KIFF-ийн зөвшөөрлийг planque-гүйгээр өөрөө шалгадаг хэрэгсэл KIFF яг өмнө гаргасан зөвшөөрлийг хамгийн ихдээ 90 секунд хүлээн авч болно. Зогссон taf-ыг үргэлжлүүлэхэд таны төхөөрөмж дээрх зөвшөөрөл шаардлагатай бөгөөд зогсолтоос өмнө баригдсан эсвэл дараалалд байсан юу ч түүний дараа ажиллахгүй.
		</p>
		<p>
			<strong>Taf-ыг устгах</strong> нь түүний хуваарийг зогсоож, ажиллалт, чат, санах ой, түүний ашигласан түлхүүрийг устгана. Үүнээс өмнө ч гэсэн таны хэрэгслүүд taf-д буцаасан зүйл зөвхөн түүний ажиллалт дуустал хадгалагдана (чатад зөвхөн уншсан зүйл дараагийн мессежүүдэд шифрлэгдэн, хамгийн ихдээ дөрвөн цаг ашиглагдаж, дараа нь устгагдана), түүний ажиллалт, чат 30 хоног. KIFF өөрийн хийснийн баримтыг хадгална.
		</p>
		<p>
			<strong>ЕХ-ны AI тухай хууль.</strong> tafs-ийн хувьд Kiff Agents OÜ нь AI системийн үйлчилгээ үзүүлэгч, та түүнийг ашиглагч юм. Taf таны компаниас гадуурх хэн нэгэнд бичсэн бүхэн AI агент бичсэн гэдгийг заахыг бид хангана. Та tafs-ийг зөвхөн санал болгодог ажлуудад ашиглаж, AI тухай хуулиар хориглосон эсвэл өндөр эрсдэлтэй гэж ангилсан ямар ч хэрэглээнд, тухайлбал хүний хөдөлмөр эрхлэлт, зээл эсвэл чухал үйлчилгээнд хүртээмжтэй холбоотой шийдвэрт ашиглахгүй. Та өөрийн Card-уудын шаарддаг хүний зөвшөөрлийг хадгалж, таны өмнөөс tafs-ийг ашигладаг хүмүүс үүний юу хийдэг, хязгаарыг ойлгохыг хангана.
		</p>
		<p>
			<strong>Зардал.</strong> tafs нь таны KIFF төлөвлөгөөний (§8) нэг хэсэг: taf-ын ажиллалт бүр ашигласан AI-д кредит зарцуулна. Coach болон taf тохируулах нь Coach-ийн боломжийн хэрэглээний хүрээнд багтдаг.
		</p>
	</section>
}

templ termsAccountMN() {
	<section id="account">
		<h2>4. Бүртгэл ба хандалт</h2>
		<p>
			Үйлчилгээг ашиглахын тулд та бүртгэл үүсгэх ёстой. Та үнэн зөв бүртгэлийн мэдээлэл өгч, нэвтрэх мэдээллээ нууцалж, бүртгэлийнхээ дор хийгдсэн бүх үйл ажиллагааг хариуцахыг зөвшөөрнө.
		</p>
		<p>
			Та хамгийн багадаа 16 настай, эсвэл өөрийн харьяаллын дижитал зөвшөөрлийн насанд хүрсэн байх ёстой, аль нь өндөр байна. Үйлчилгээ хүүхдэд чиглээгүй.
		</p>
		<p>
			Үйлчилгээг зөвхөн <a href="https://www.anthropic.com/supported-countries">Anthropic-ийн жагсаасан</a> ёсоор AI загвараа хангадаг Anthropic өөрийн үйлчилгээгээ санал болгодог улс, бүс нутагт санал болгодог. Та үүнийг өөр хаанаас ч ашиглаж болохгүй. Компани тухайн жагсаалтаас гадуурх улс эсвэл бүс нутагт төвтэй, эсвэл тийм төвтэй компанийн дийлэнх өмчлөл эсвэл хяналтад байдаг бол хэрэглэгчид нь хаана байгаагаас үл хамааран ашиглаж болохгүй. Мөн та, эсвэл таны ашиглаж буй компани Европын Холбоо, Нэгдсэн Үндэстний Байгууллага эсвэл АНУ-ын хориг арга хэмжээнд хамрагдсан бол ашиглаж болохгүй. Бид энэ дүрмийг зөрчсөн бүртгэлээс татгалзаж, зөрчсөнийг түр зогсоож болно.
		</p>
		<p>
			Та өөрийн бүртгэлд эрх олгосон Хэрэглэгч бүрийн үйлдлийг хариуцна. Бид эдгээр нөхцөлийн найдвартай зөрчлийг илрүүлбэл боломжийн мэдэгдэлтэйгээр бүртгэлийг түр зогсоож эсвэл хандалтыг хүчингүй болгож болно. Зөвшөөрөгдөх хэрэглээний зөрчил (§5-ыг үзнэ үү)-ийн хувьд түр зогсоолт тэр дор нь байж болно.
		</p>
	</section>
}

templ termsAcceptableUseMN() {
	<section id="acceptable-use">
		<h2>5. Зөвшөөрөгдөх хэрэглээ</h2>
		<p>
			Та, таны хэрэглэгчид болон таны агентууд <a href="/acceptable-use">Зөвшөөрөгдөх хэрэглээний бодлого</a> (англиар)-ыг дагах ёстой. Энэ нь эдгээр нөхцөлийн нэг хэсэг бөгөөд Үйлчилгээг юунд ашиглаж болохгүйг жагсаана.
		</p>
		<p>
			Бид Зөвшөөрөгдөх хэрэглээний бодлогын найдвартай зөрчлийн үед тэр дор нь түр зогсоож болно. Бид Үйлчлүүлэгчийн агуулгыг хянах үүрэггүй боловч найдвартай мэдээлэлд үндэслэн арга хэмжээ авч болно.
		</p>
	</section>
}

templ termsCustomerDataMN() {
	<section id="customer-data">
		<h2>6. Үйлчлүүлэгчийн өгөгдөл ба агуулга</h2>
		<p>
			Та өөрийн Аудитын өгөгдлийн эзэн. Та Kiff Agents OÜ-д таны Аудитын өгөгдлийг зөвхөн таны төлөө Үйлчилгээг ажиллуулах, хадгалах, сайжруулахад шаардлагатай хэмжээгээр хостлох, хуулах, дамжуулах, харуулах болон бусад байдлаар боловсруулах хязгаарлагдмал, онцгой бус, роялтигүй, дэлхий даяарх лиценз олгоно.
		</p>
		<p>
			Бид таны Аудитын өгөгдөл болон tafs өгөгдлийн хувьд GDPR-ийн 28-р зүйлийн дагуу <strong>боловсруулагч</strong> байдлаар ажиллана; <a href="/legal/dpa">DPA</a> (англиар) тэр харилцааг нарийвчлан зохицуулна. Бид таны бүртгэлийн мета өгөгдлийн хувьд <strong>хянагч</strong> байдлаар ажиллана; <a href="/mn/privacy">нууцлалын бодлого</a> тэр харилцааг зохицуулна.
		</p>
		<p>
			Та илгээсэн өгөгдлөө илгээхэд шаардлагатай бүх эрхтэй, илгээлт нь хамаарах хууль (өгөгдөл хамгаалах хууль болон, хамаарах бол ЕХ-ны AI тухай хууль)-ийг дагаж мөрдөж буйг мэдэгднэ.
		</p>
	</section>
}

templ termsConfidentialityMN() {
	<section id="confidentiality">
		<h2>7. Нууцлал</h2>
		<p>
			Тал бүр нөгөөгөөс нийтэд нээлттэй бус мэдээлэл ("Нууц мэдээлэл") хүлээн авч болно. Хүлээн авагч тал Нууц мэдээллийг эдгээр нөхцөлийн дагуу үүргээ биелүүлэх, эрхээ хэрэгжүүлэхэд шаардлагатай хэмжээгээр л ашиглаж, өөрийн нууц мэдээллээ хамгаалдагтай ядаж ижил түвшний болгоомжлолоор хамгаална.
		</p>
		<p>
			Нууц мэдээлэлд (а) зөрчилгүйгээр нийтэд ил болсон эсвэл болох, (б) задлахаас өмнө хүлээн авагч талд мэдэгдэж байсан, (в) Нууц мэдээллийг ашиглахгүйгээр бие даан боловсруулсан, эсвэл (г) хуулиар задлах ёстой (зөвшөөрөгдсөн бол нөгөө талд мэдэгдэж) мэдээлэл хамаарахгүй.
		</p>
	</section>
}

templ termsFeesMN() {
	<section id="fees">
		<h2>8. Төлбөр ба төлбөр тооцоо</h2>
		<p>
			<strong>Төлөвлөгөө.</strong> Бүртгэл бүр нэг төлөвлөгөөтэй. Одоогийн үнийг <a href="/pricing">үнийн хуудас</a> (англиар)-аас харна уу; энэ шинэчлэлийн үед:
		</p>
		<ul>
			<li><strong>Solo:</strong> нэг хүн, tafs-д зориулсан, tafs аппад App Store эсвэл Google Play-ээр сард €12.50, НӨАТ орсон, сард 500 кредит багтсан зардаг.</li>
			<li><strong>Company:</strong> суудал бүрт сард €10.50, суудал бүрт сард 500 кредит, нэгтгэн, мөн KIFF Cloud-аар дамжуулан таны өөрийн агентуудын дуудлагад суудал бүрт сард 500 үйлдэл, нэгтгэн.</li>
			<li><strong>Гэрээ:</strong> түүний захиалгын маягт дахь төлбөр, нөхцөл.</li>
		</ul>
		<p>
			Суудал гэдэг нь бүртгэлийн админ болон редакторууд. Зөвшөөрөгч болон үзэгчид бүх төлөвлөгөөнд үнэгүй. Company дээр багтсанаас хэтэрсэн кредит нь €0.01, үйлдэл €0.02. Багтсанаас хэтэрсэн кредитийг бүртгэлийн тогтоосон сарын зарцуулалтын хязгаар (эхлэхэд €50) хүртэл тооцно: хязгаарт хүрэхэд KIFF дараагийн хугацаа эхлэх хүртэл, эсвэл төлбөр тооцоог удирддаг хэн нэгэн түүнийг нэмэгдүүлэх хүртэл бүртгэлийн taf-уудын шинэ ажиллалтыг эхлүүлэхгүй.
		</p>
		<p>
			<strong>Кредитийн багц.</strong> Solo дээр сарын багтсанаас хэтэрсэн кредит нь tafs аппаас худалдан авсан кредитийн багцаас ирнэ. Багцыг нэг удаа худалдан авах бөгөөд дуусдаггүй, захиалга биш; түүний кредитийг сарын багтсаны дараа, хамгийн хуучин багцаас эхлэн ашиглана. Төлбөр нь бүрэн буцаагдсан багцыг үлдсэн кредитийн хамт буцааж авна. Сарын кредит болон багцууд ашиглагдсаны дараа KIFF дараагийн хугацаа эхлэх хүртэл эсвэл багц нэмэх хүртэл бүртгэлийн taf-уудын шинэ ажиллалтыг эхлүүлэхгүй. KIFF-ийн бүртгэлд нэмдэг бонус кредит ч багцын адил дуусдаггүй.
		</p>
		<p>
			<strong>Юу тоологддог.</strong> <em>Кредит</em> нь taf-ын ажиллалтын ашигласан AI-д төлөх, бүхэл кредитээр, ажиллалт тутамд нэг удаа дээш бөөрөнхийлж, ажиллалт дуусахад нэг удаа тоологдоно. KIFF-ийн татгалзсан дуудлагатай ажиллалт ч гэсэн өөрийн AI-г ашигласан. Хэзээ ч тооцохгүй: Coach, болон taf тохируулах, Coach-ийн боломжийн хэрэглээний хүрээнд; шинэ хувилбарын туршилт, ямар ч зүйл илгээдэггүй; бидний талаас амжилтгүй болсон ажиллалт. <em>Үйлдэл</em> гэдэг нь таны өөрийн агентын KIFF Cloud-аар дамжуулсан, ямар нэг зүйл хийсэн дуудлага: KIFF зөвшөөрсөн, илгээгдсэн, хэрэгсэл амжилтыг мэдээлсэн. Үйлдэл гэж хэзээ ч тооцохгүй: татгалзсан, барьж дараа нь татгалзсан, зогсоолтоор зогссон, хүчингүй, хэрэгсэл дээр амжилтгүй болсон, эсвэл үр дүн нь үл мэдэгдэх дуудлага, мөн зөвхөн уншдаг дуудлага.
		</p>
		<p>
			<strong>Туршилтын хугацаа байхгүй.</strong> Бүртгэл эхний өдрөөс төлнө. Төлөвлөгөө эхлэхээс өмнө KIFF Coach-ийн тохируулгаас бусад түүний taf-уудын ажиллалтыг эхлүүлэхгүй; юу ч устгагдахгүй.
		</p>
		<p>
			<strong>Төлбөр ба нэхэмжлэх.</strong> Төлөвлөгөөг нэг газраас нэхэмжилнэ. kiff.dev дээр худалдан авсан төлөвлөгөөг тэнд болон түүний холбосон төлбөр тооцооны порталд худалдан авч, өөрчилж, цуцлах бөгөөд төлбөрийг Stripe боловсруулна. tafs аппаас худалдан авсан Solo-г iPhone, iPad дээр App Store-оор, эсвэл Android дээр Google Play-ээр зардаг бөгөөд таны Apple захиалга эсвэл Google Play захиалгад удирдаж, төлбөр, сунгалт, буцаан олголтын тухай тухайн дэлгүүрийн нөхцөлөөр явагдана. Кредитийн багцыг аппаас худалдан авна. Company-г kiff.dev дээр худалдан авна. Төлбөрийг сар бүр урьдчилан нэхэмжилнэ; багтсанаас хэтэрсэн хэрэглээг дараагийн нэхэмжлэхээр нэхэмжилнэ. Хүний тооны өөрчлөлт дараагийн нэхэмжлэхээс хамаарна. Хэрэв төлбөр амжилтгүй болж засагдахгүй бол төлөвлөгөө дуусч, төлөвлөгөө сонгох хүртэл KIFF бүртгэлийн дуудлагаас татгалзана.
		</p>
		<p>
			<strong>Цуцлалт.</strong> Та төлбөр тооцооны порталд, эсвэл аппаас худалдан авсан Solo-ийн хувьд Apple захиалга эсвэл Google Play захиалгадаа хэзээ ч цуцалж болно. Төлөвлөгөө нь таны төлсөн хугацаа дуустал үргэлжилж, сунгагдахгүй. Хуулиар шаардсанаас бусад тохиолдолд аль хэдийн төлсөн төлбөр буцаагдахгүй. Хэрэв та ЕХ-ны хэрэглэгч бол худалдан авснаас хойш 14 хоногийн дотор шалтгаан хэлэлгүй татгалзаж болох бөгөөд бид таны төлснөөс төлөвлөгөө аль хэдийн ажилласан өдрүүдийн хувийг хасаж буцаана. Solo худалдан авалтыг App Store эсвэл Google Play-ээр тэдний нөхцөлийн дагуу буцаана.
		</p>
		<p>
			<strong>Бичил аж ахуйн нэгж.</strong> Хэрэв таны бизнес 10-аас цөөн хүнтэй бөгөөд жилийн эргэлт эсвэл балансын нийт дүн хамгийн ихдээ 2 сая евро бол бид картаар хийсэн төлбөрийн тухай эдгээр нөхцөлийн дүрэм бүрийн хувьд, Company-г оруулан, үүнийг хэрэглэгч гэж үзнэ.
		</p>
		<p>
			<strong>НӨАТ.</strong> Company-ийн үнэд НӨАТ ордоггүй; Solo болон кредитийн багцыг App Store эсвэл Google Play НӨАТ-тайгаар зардаг. Kiff Agents OÜ (НӨАТ-ын дугаар EE102924327) хамаарах газарт Эстонийн НӨАТ нэмдэг. Эстонигоос гадуурх хүчинтэй НӨАТ-ийн таних дугаартай Үйлчлүүлэгчид ЕХ-ны бизнесээс бизнес рүү борлуулалтыг ЕХ-ны урвуу төлбөрийн механизмаар нэхэмжилнэ.
		</p>
		<p>
			<strong>Өөрчлөлт.</strong> Бид идэвхтэй бүртгэлд үнийн өсөлтийн тухай хамгийн багадаа гучин хоногийн өмнө бичгээр мэдэгдэнэ (§16). Үнийн бууралт дараагийн нэхэмжлэхээс хамаарна.
		</p>
	</section>
}

templ termsTermMN() {
	<section id="term">
		<h2>9. Хугацаа ба дуусгавар болох</h2>
		<p>
			Эдгээр нөхцөл таныг Үйлчилгээг анх ашигласан үеэс хүчин төгөлдөр болж, дуусгавар болтол үргэлжилнэ.
		</p>
		<p>
			Та бүртгэлээ устгаж хэзээ ч дуусгавар болгож болно. Бид (а) бичгээр мэдэгдсэнээс хойш гучин хоногт арилгаагүй ноцтой зөрчил, эсвэл (б) Зөвшөөрөгдөх хэрэглээний зөрчил эсвэл төлбөрийн чадваргүй болох үед тэр дор нь дуусгавар болгож болно.
		</p>
		<p id="leaving">
			<strong>Гарч, өөрийн өгөгдлөө авч явах.</strong> Та өөрийн өгөгдлийг хэзээ ч бүтэцтэй, машинд уншигдах форматаар экспортолж болно: KIFF-д Тохиргоо → Өгөгдөл нь таны бүртгэл, таны Card-ууд бүх хувилбартайгаа, таны Бүртгэл дэх шийдвэрүүд (сүүлийн 10,000; илүү хүсвэл бидэнд хэлнэ), KIFF-ийн зөвшөөрсөн бүрийн гарын үсэг зурсан баримт, таны API түлхүүрүүдийн дэлгэрэнгүй (түлхүүрийг өөрийг нь хэзээ ч биш)-ийг агуулсан JSON файл өгнө. tafs аппад хүн бүр өөрийн чат, файл, тэмдэглэлээ Бүртгэл → Миний чатуудыг экспортлох-оос экспортолно; нууцлалын бодлогод заасны дагуу чатыг ямар ч тохиолдолд гучин хоног хадгална. Бүртгэлээ устгах нь Үйлчилгээг тэр дор нь дуусгах тул эхлээд экспортлоорой.
		</p>
		<p>
			Та оронд нь өөр үйлчилгээ үзүүлэгч эсвэл өөрийн системд шилжихийн тулд <a href="mailto:support@kiff.dev">support@kiff.dev</a> руу бичиж, мэдэгдэлтэйгээр гарч болно. Бид хэзээ ч хоёр сараас илүү мэдэгдэл шаарддаггүй: таны мэдэгдэл таны сонгосон огноонд, илгээснээс хойш хоёр сараас хэтрэхгүй хугацаанд хүчин төгөлдөр болно. Тэр огнооноос гучин хоногийн шилжилтийн хугацаа үргэлжилж, тэр хугацаанд Үйлчилгээ ажиллаж, та өгөгдлөө экспортолж ажлаа зөөж, бид үүнд боломжийн хүсэлтээр тусална. Та шилжилтийн хугацааг хэрэгтэй хэмжээгээр нэг удаа сунгаж болно. Хэрэв бид гучин хоногт техникийн хувьд дуусгаж чадахгүй бол таны мэдэгдлээс хойш арван дөрвөн ажлын өдрийн дотор шалтгаанууд болон долоо хоногоос ихгүй шинэ хугацааны хамт танд мэдэгдэнэ. Шилжилтийн хугацааны дараа таны өгөгдөл экспортлоход дор хаяж гучин хоног нэмэлт бэлэн байна. Төлөвлөгөөний төлбөр шилжилтийн хугацаа дуустал ердийнхөөрөө үргэлжилнэ. App Store эсвэл Google Play-ээс худалдан авсан Solo-г дэлгүүрт цуцлах бөгөөд шилжилт, экспортын хугацаа адилхан хамаарна.
		</p>
		<p>
			Бид гарах, шилжих эсвэл өгөгдлөө экспортлоход төлбөр авдаггүй. Энэ хэсэг нь ЕХ-ны Өгөгдлийн тухай хууль (Журам (ЕХ) 2023/2854)-ийн VI бүлгийн шилжих эрхийг үйлчлүүлэгч бүрд олгоно.
		</p>
		<p>
			Дуусгавар болох үед, мөн шилжилт, экспортын хугацааны дараа бид таны Аудитын өгөгдөл, tafs өгөгдөл болон бүртгэлийн мета өгөгдлийг <a href="/mn/privacy#retention">нууцлалын бодлого</a> дахь хадгалалтын дүрмийн дагуу устгана.
		</p>
		<p>
			Мөн чанараараа дуусгавар болсны дараа үлдэх ёстой хэсгүүд үлдэнэ — нууцлал, оюуны өмч, нөхөн төлбөр, хариуцлагын хязгаар, татгалзал, зохицуулах хууль, хуримтлагдсан төлбөрийг оруулан.
		</p>
	</section>
}

templ termsWarrantiesMN() {
	<section id="warranties">
		<h2>10. Баталгаа</h2>
		<p>
			Тал бүр эдгээр нөхцөлийг байгуулах, биелүүлэх эрх, эрх мэдэлтэй гэдгээ мэдэгднэ.
		</p>
		<p>
			Бид Үйлчилгээг мэргэжлийн түвшинд, Баримт бичигт үндсэндээ нийцүүлэн үзүүлэхийг баталгаажуулна. Энэ баталгааг зөрчсөний таны цорын ганц хамгаалалт нь бидний сонголтоор, зөрчлийн хугацаанд нөлөөлөгдсөн Үйлчилгээнд хамаарах төлбөрийн дахин гүйцэтгэл эсвэл хувь хэмжээгээр буцаан олголт юм.
		</p>
		<p>
			Та Үйлчилгээг ашиглахдаа хамаарах хууль болон эдгээр нөхцөлийг дагаж мөрдөхийг баталгаажуулна.
		</p>
	</section>
}

templ termsDisclaimerMN() {
	<section id="disclaimer">
		<h2>11. Татгалзал</h2>
		<p>
			§10-д заасан тодорхой баталгааг эс тооцвол Үйлчилгээг <strong>"байгаагаар нь" болон "боломжтой байх хэмжээгээр"</strong> үзүүлнэ. Хуулиар зөвшөөрөгдөх дээд хэмжээнд бид худалдаалах чадвар, тодорхой зорилгод тохирох байдал, зөрчөөгүй байх болон худалдааны ёс заншил, гүйлгээний явцаас үүдэлтэй баталгааг оруулан, илэрхий, далд эсвэл хуулийн бусад бүх баталгаанаас татгалзана.
		</p>
		<p>
			Бид Үйлчилгээ тасалдалгүй, алдаагүй, хортой бүрэлдэхүүнгүй байхыг, эсвэл ямар ч өгөгдөл алдагдахгүй, гэмтэхгүй гэдгийг баталгаажуулахгүй. Өгөгдлөө нөөцлөх нь таны хариуцлага.
		</p>
	</section>
}

templ termsLiabilityMN() {
	<section id="liability">
		<h2>12. Хариуцлагын хязгаар</h2>
		<p>
			Хуулиар зөвшөөрөгдөх дээд хэмжээнд эдгээр нөхцөл эсвэл Үйлчилгээнээс үүдэлтэй эсвэл тэдгээртэй холбоотой, олзоо алдах, орлого алдах, өгөгдөл алдах эсвэл бизнесийн тасалдлыг оруулан, шууд бус, санамсаргүй, үр дагаврын, тусгай, үлгэрлэсэн эсвэл шийтгэлийн хохирлыг аль ч тал нөгөө талдаа хариуцахгүй, ийм хохирлын боломжийн тухай анхааруулсан ч гэсэн.
		</p>
		<p>
			Эдгээр нөхцөлөөс үүдэлтэй эсвэл тэдгээртэй холбоотой тал бүрийн нийт хариуцлага (а) хариуцлага үүсгэсэн үйл явдлаас өмнөх арван хоёр сарын дотор Үйлчлүүлэгчийн Kiff Agents OÜ-д төлсөн эсвэл төлөх ёстой төлбөр, эсвэл (б) зуун мянган евро (€100,000)-гийн аль нь их байхаас хэтрэхгүй.
		</p>
		<p>
			Эдгээр нөхцөлийн юу ч хамаарах хуулийн дагуу хязгаарлах, хасах боломжгүй хариуцлагыг хязгаарлахгүй, хасахгүй, үүнд үхэл, хайхрамжгүй байдлаас үүдсэн бэртэл, залилан, санаатай буруу үйлдлийн хариуцлага, мөн согогтой бүтээгдэхүүний хариуцлагын тухай Удирдамж (ЕХ) 2024/2853-ыг хэрэгжүүлэгч хуулиудын дагуу согогтой бүтээгдэхүүний хариуцлага орно.
		</p>
	</section>
}

templ termsIndemnityMN() {
	<section id="indemnification">
		<h2>13. Нөхөн төлбөр</h2>
		<p>
			Бидний үзүүлсэн, таны эдгээр нөхцөлийн дагуу ашигласан Үйлчилгээ тэр гуравдагч этгээдийн оюуны өмчийн эрхийг зөрчсөн гэсэн гуравдагч этгээдийн нэхэмжлэлээс бид таныг хамгаалж, ийм нэхэмжлэлийн төлөө таны эсрэг эцэслэн шийдвэрлэсэн хохирол (эсвэл тохиролцсон эвлэрлийн дүн)-г төлнө.
		</p>
		<p>
			Та (а) таны Үйлчлүүлэгчийн өгөгдөл эсвэл агуулга; (б) эдгээр нөхцөлийг (Зөвшөөрөгдөх хэрэглээний бодлогыг оруулан) зөрчсөн таны Үйлчилгээний хэрэглээ; эсвэл (в) таны ноцтой хайхрамжгүй байдал эсвэл санаатай буруу үйлдлээс үүдсэн гуравдагч этгээдийн нэхэмжлэлээс биднийг хамгаалж, ийм нэхэмжлэлийн төлөө бидний эсрэг эцэслэн шийдвэрлэсэн хохирол (эсвэл тохиролцсон эвлэрлийн дүн)-г төлнө.
		</p>
		<p>
			Нөхөн төлбөр нь нэхэмжлэлийн талаар шуурхай мэдэгдэх, нөхөн төлөгчийн хамгаалалт ба эвлэрлийн цорын ганц хяналт, нөхөн төлбөр авагчийн боломжийн хамтын ажиллагаанаас хамаарна. Нөхөн төлөгч нь нөхөн төлбөр авагчид үүрэг хүлээлгэх нэхэмжлэлийг зөвшөөрөлгүйгээр эвлэрүүлж болохгүй.
		</p>
	</section>
}

templ termsSLAMN() {
	<section id="sla">
		<h2>14. Үйлчилгээний түвшний амлалт</h2>
		<p>
			Төлбөртэй төлөвлөгөөнд <a href="/legal/sla">үйлчилгээний түвшний гэрээ</a> (англиар) нь бидний амласан бэлэн байдал, удаан эсвэл амжилтгүй хүсэлтийг хэрхэн тоолох, бидний дэмжлэгийн хариу өгөх хугацаа, мөн бид хүрэхгүй үед үйлчилгээний кредитийг тогтооно. Энэ нь эдгээр нөхцөлийн нэг хэсэг.
		</p>
		<p>
			Үйл ажиллагааны практик, тохиолдлын хариу арга хэмжээ, зөрчлийн мэдэгдлийн амлалтыг эдгээр Нөхцөлөөс холбосон огноотой хувилбарт баримтжуулсан (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>); <a href="/security">/security</a> (англиар) одоогийн практикийг харуулна.
		</p>
	</section>
}

templ termsServiceModsMN() {
	<section id="service-mods">
		<h2>15. Үйлчилгээний өөрчлөлт</h2>
		<p>
			Бид хүссэн үедээ онцлог нэмэх, өөрчлөх, хасах боломжтой. Үйл ажиллагааг мэдэгдэхүйц бууруулах эсвэл баримтжуулсан үйл ажиллагааг эвддэг API гадаргууг хүчингүй болгох тухай идэвхтэй үйлчлүүлэгчдэд хамгийн багадаа гучин хоногийн өмнө, нийтэлсэн хүчингүй болгох хуваарьтайгаар мэдэгдэнэ. Аюулгүй байдлын шалтгаант өөрчлөлтийг мэдэгдэл өөрөө эрсдэл үүсгэх газарт мэдэгдэлгүй хийж болно.
		</p>
	</section>
}

templ termsTermsModsMN() {
	<section id="terms-mods">
		<h2>16. Эдгээр нөхцөлийн өөрчлөлт</h2>
		<p>
			Бид эдгээр нөхцөлийг үе үе өөрчилж болно. Мэдэгдэхүйц өөрчлөлтийг имэйлээр болон энэ хуудсан дээрх тод баннераар хамгийн багадаа гучин хоногийн өмнө мэдэгднэ. Мэдэгдэхүйц бус өөрчлөлтийг (тодруулга, лавлагаа) шинэ "сүүлд шинэчилсэн" огнооотойгоор нийтэлнэ. Шинэчлэлийн хүчин төгөлдөр болсон огнооноос хойш та Үйлчилгээг үргэлжлүүлэн ашиглах нь зөвшөөрөл болно.
		</p>
	</section>
}

templ termsForceMajeureMN() {
	<section id="force-majeure">
		<h2>17. Давагдашгүй хүч</h2>
		<p>
			Аль ч тал өөрийн боломжийн хяналтаас гадуурх нөхцөл байдал, түүний дотор байгалийн гамшиг, дайн, терроризм, иргэний үймээн, хөдөлмөрийн маргаан, гал, байгалийн гамшиг, тахалтай холбоотой засгийн газрын арга хэмжээ, интернет эсвэл цахилгааны тасалдал, эсвэл харилцаа холбооны үйлчилгээ үзүүлэгч эсвэл гуравдагч этгээдийн хостингийн дэд бүтцийн үйлдлээс үүдсэн гүйцэтгэлийн алдаа эсвэл хоцролтыг хариуцахгүй.
		</p>
	</section>
}

templ termsGoverningLawMN() {
	<section id="governing-law">
		<h2>18. Хэрэглэгдэх хууль ба шүүхийн харьяалал</h2>
		<p>
			Эдгээр нөхцөлд хууль зөрчлийн дүрмийг үл харгалзан Бүгд Найрамдах Эстони Улсын хууль хамаарна. Маргааны онцгой шүүх нь Таллин дахь Харью мужийн шүүх.
		</p>
		<p>
			Та ЕХ-ны өөр гишүүн улсад оршин суудаг хэрэглэгч бол таны харьяаллын хэрэглэгчийн хамгааллын заавал дагах дүрмүүд гэрээгээр татгалзах боломжгүй эрхийг таньд олгох хэмжээнд үргэлжлэн хамаарна; энэ заалт таныг тэдгээр дүрмийн хамгаалалтаас хасахгүй.
		</p>
	</section>
}

templ termsGeneralMN() {
	<section id="general">
		<h2>19. Ерөнхий</h2>
		<p>
			<strong>Бүх гэрээ.</strong> Эдгээр нөхцөл, нууцлалын бодлого, DPA, дурын захиалгын маягт, илэрхий оруулсан нэмэлт нөхцөлийн хамт өөрсдийн сэдвийн талаар бидний хоорондын бүх гэрээ бөгөөд өмнөх эсвэл зэрэгцээ ойлголцлыг орлоно.
		</p>
		<p>
			<strong>Салгах боломж.</strong> Хэрэв заалт хэрэгжүүлэх боломжгүй гэж үзвэл бусад нь хүчинтэй хэвээр үлдэнэ.
		</p>
		<p>
			<strong>Шилжүүлэх.</strong> Та манай бичгээр зөвшөөрөлгүйгээр эдгээр нөхцөлийг шилжүүлж болохгүй. Бид нэгдэх, худалдан авах эсвэл бүх буюу үндсэндээ бүх хөрөнгөө худалдахтай холбогдуулан, танд мэдэгдэж, зөвшөөрөлгүйгээр шилжүүлж болно.
		</p>
		<p>
			<strong>Эрхээс татгалзаагүй.</strong> Аливаа заалтыг хэрэгжүүлээгүй нь түүнийг дараа хэрэгжүүлэх эрхээс татгалзсан гэсэн үг биш.
		</p>
		<p>
			<strong>Мэдэгдэл.</strong> Kiff Agents OÜ-д мэдэгдэл <a href="mailto:legal@kiff.dev">legal@kiff.dev</a> руу эсвэл шуудангаар Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Эстони хаягаар очно. Танд мэдэгдэл таны бүртгэлтэй холбогдсон имэйл эсвэл, өгсөн бол, таны томилсон хуулийн мэдэгдлийн хаягаар очно.
		</p>
		<p>
			<strong>Бие даасан гүйцэтгэгчид.</strong> Эдгээр нөхцөлийн юу ч түншлэл, төлөөлөгчийн харилцаа, хамтарсан үйлдвэр эсвэл хөдөлмөрийн харилцаа үүсгэхгүй.
		</p>
		<p>
			<strong>Гуравдагч талын ашиг хүртэгчид.</strong> Байхгүй, нөхөн төлбөр авах охин компаниуд илэрхий тодорхойлогдсон хэмжээнээс бусад.
		</p>
	</section>
}

templ termsContactMN() {
	<section id="contact">
		<h2>20. Бидэнтэй холбогдох</h2>
		<p>
			Худалдааны болон гэрээний асуулт: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
		<p>
			Бүтээгдэхүүний ерөнхий асуулт: <a href="mailto:hello@kiff.dev">hello@kiff.dev</a>. Нууцлалын асуулт: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>. Аюулгүй байдлын мэдээлэл: <a href="mailto:security@kiff.dev">security@kiff.dev</a>.
		</p>

		<hr/>

		<p class="legal-footnote">
			<strong>Баримт бичгийн хувилбар:</strong> v0.1.<br/> <strong>Сүүлд шинэчилсэн:</strong> 2026 оны арваннэгдүгээр сарын 21.
		</p>
	</section>
}
