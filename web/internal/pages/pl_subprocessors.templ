package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// SubprocessorsPL is the list of subprocessors (/subprocessors) in
// Polish, at /pl/subprocessors. It is a translation of Subprocessors:
// the same sections, anchors, links and figures, held to it by
// TestTranslationsKeepTheEnglishPage. The English page governs. Change
// the English page first, then this one.
templ SubprocessorsPL() {
	@components.LayoutSite("KIFF — podmioty podprzetwarzające", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@subprocessorsHeadPL()
			@subprocessorsListPL()
			@subprocessorsNotListedPL()
			@subprocessorsChangesPL()
		</article>
	}
}

templ subprocessorsHeadPL() {
	<header class="legal-head">
		<p class="legal-badge">Podmioty podprzetwarzające · v0.1</p>
		<h1>Podmioty podprzetwarzające</h1>
		<p class="legal-meta">
			<strong>Ostatnia aktualizacja:</strong> 17 listopada 2026.
		</p>
		<p class="legal-disclaimer">
			Firmy, z których Kiff Agents OÜ korzysta, aby prowadzić KIFF
			Cloud i tafs, i które przetwarzają dane osobowe w jej
			imieniu. To jest oficjalna lista. Zasady, na jakich je
			angażujemy, określa
			<a href="/pl/legal/dpa">umowa powierzenia przetwarzania danych (DPA)</a>.
			Pytania:
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</header>
}

templ subprocessorsListPL() {
	<section id="list">
		<h2>1. Lista</h2>
		<div class="legal-table" tabindex="0">
			<table>
				<thead>
					<tr>
						<th>Podmiot podprzetwarzający</th>
						<th>Co robi dla KIFF</th>
						<th>Z jakimi danymi ma styczność</th>
						<th>Lokalizacja</th>
					</tr>
				</thead>
				<tbody>
					<tr id="aws">
						<td>Amazon Web Services</td>
						<td>Hosting: serwery, baza danych i jej kopie zapasowe, zarządzanie kluczami, sekrety i monitoring. Dla tafs: jego własny magazyn danych i połączenia planque</td>
						<td>Wszystko, co przechowuje KIFF: konta i osoby, które się logują, Card, decyzje, potwierdzenia, logi. Dla tafs: uruchomienia, czaty, notatki pamięci i tokeny połączeń (zaszyfrowane) oraz, po włączeniu zrzutów ekranu Chrome, obraz zrobiony przed krokiem Chrome, zapieczętowany i przechowywany najwyżej 30 dni</td>
						<td>Irlandia (eu-west-1): KIFF Cloud, usługa tafs, uruchomienia, czaty i wywołania modelu tafs oraz planque, ze wszystkim, co przechowują. Z Irlandii działają też publiczne wersje demonstracyjne KIFF i filmy na stronie. Jedyne, co znajduje się w Stanach Zjednoczonych (us-east-1), to certyfikaty, których CloudFront tam wymaga i które nie zawierają danych klientów</td>
					</tr>
					<tr id="clerk">
						<td>Clerk</td>
						<td>Tożsamość: logowanie i sesje kont KIFF</td>
						<td>Adres e-mail oraz imię i nazwisko osób, które się logują, ich sesje, adres IP, urządzenie i przeglądarka oraz tożsamość z Apple, Google lub GitHub, gdy ktoś loguje się przez jedną z tych usług</td>
						<td>Stany Zjednoczone</td>
					</tr>
					<tr id="stripe">
						<td>Stripe</td>
						<td>Płatności: kasa, faktury i portal rozliczeniowy w płatnym planie</td>
						<td>Osoba kontaktowa do rozliczeń i dane płatnicze wpisane w kasie Stripe oraz liczniki wykorzystania przekazywane do fakturowania</td>
						<td>UE i Stany Zjednoczone</td>
					</tr>
					<tr id="resend">
						<td>Resend</td>
						<td>E-mail: powiadomienia o oczekujących wywołaniach i ostrzeżenia dotyczące Card, powiadomienia o wykorzystaniu i koncie, kod logowania, powiadomienia o nowym urządzeniu, powiadomienia o włączeniu lub wyłączeniu logowania kodem, odpowiedź na kod zażądany przy wyłączonym ustawieniu, e-maile o członkostwie, takie jak zaproszenia, oraz odpowiedzi wsparcia. Dla tafs: drzwi e-mailowe tafa, czyli poczta, którą ludzie do niego wysyłają, i jego odpowiedzi</td>
						<td>Adres e-mail odbiorcy i treść powiadomienia. Powiadomienie o oczekującym wywołaniu podaje agenta, akcję, jej kwotę i Card, poza którą akcja wykracza. E-mail z kodem logowania zawiera kod, czas oraz przeglądarkę i kraj, z których go zażądano; powiadomienie o nowym urządzeniu podaje urządzenie, jego przeglądarkę, sposób logowania, czas i przybliżone miasto i kraj; powiadomienie o włączeniu lub wyłączeniu podaje, że ustawienie włączono lub wyłączono, i kiedy; kod zażądany przy wyłączonym ustawieniu dostaje odpowiedź w e-mailu z czasem oraz przeglądarką i krajem, z których go zażądano; e-mail o członkostwie, taki jak zaproszenie, podaje konto i rolę, a osobę zapraszającą tylko jako administratora; powiadomienie o nowym zatwierdzającym lub ponownie połączonym telefonie podaje urządzenie. W przypadku drzwi e-mailowych: wiadomości, ich nadawcy i załączniki</td>
						<td>Stany Zjednoczone</td>
					</tr>
					<tr id="cloudflare">
						<td>Cloudflare</td>
						<td>E-mail: odbiera pocztę wysłaną na adresy kiff.dev, np. prośby o pomoc i wnioski dotyczące prywatności, i przekazuje ją do skrzynek zespołu (Email Routing)</td>
						<td>Wiadomości wysyłane na adresy kiff.dev: nadawca, odbiorcy, temat, treść i załączniki</td>
						<td>Stany Zjednoczone, w ogólnoświatowej sieci Cloudflare</td>
					</tr>
					<tr id="google-workspace">
						<td>Google Workspace</td>
						<td>E-mail: skrzynki zespołu, do których trafia poczta wysłana na adresy kiff.dev po przekazaniu przez Cloudflare, w tym prośby o pomoc i wnioski dotyczące prywatności</td>
						<td>Wiadomości wysyłane na adresy kiff.dev: nadawca, odbiorcy, temat, treść i załączniki</td>
						<td>Stany Zjednoczone i inne kraje, w których Google przechowuje dane Workspace</td>
					</tr>
					<tr id="composio">
						<td>Composio</td>
						<td>Dla tafs, przez planque: przechowuje logowania połączeń zarządzanych (usług, które klient łączy przez stronę logowania Composio) oraz bota Slacka stojącego za drzwiami w Slacku i wykonuje każde wywołanie, o które prosi planque.
							@composioUse("pl")
						</td>
						<td>Logowania połączonych usług (tokeny lub klucze), przechowywane przez Composio i nigdy nieprzekazywane tafowi ani planque; dane wejściowe każdego wywołania i odpowiedź usługi; wiadomości drzwi w Slacku</td>
						<td>Stany Zjednoczone</td>
					</tr>
					<tr id="apple">
						<td>Apple</td>
						<td>Powiadomienia push na urządzenia zarejestrowane w aplikacji tafs (Apple Push Notification service): oczekujące wywołania, wiadomości drzwi i aplikacja, która wylogowała tafa</td>
						<td>Token push urządzenia i tekst alertu: który taf, a w alercie drzwi imię i nazwisko lub adres e-mail osoby, która napisała. Bez kwot i szczegółów prośby</td>
						<td>Stany Zjednoczone</td>
					</tr>
					<tr id="google">
						<td>Google</td>
						<td>Aplikacja tafs na Androidzie: powiadomienia push na urządzenia zarejestrowane do alertów (Firebase Cloud Messaging) oraz zakupy przez rozliczenia Google Play</td>
						<td>Token push urządzenia i tekst alertu: który taf, a w alercie drzwi imię i nazwisko lub adres e-mail osoby, która napisała, bez kwot i szczegółów prośby; przy zakupie: co kupiono, losowy identyfikator konta, token zakupu i identyfikator zamówienia</td>
						<td>Stany Zjednoczone</td>
					</tr>
					<tr id="anthropic">
						<td>Anthropic</td>
						<td>Modele AI: model, dzięki któremu działają Coach i każdy taf (Claude API). Tylko tafs</td>
						<td>Co jest wysyłane: to, co piszesz do Coacha i Twoich tafów, załączone pliki, to, co Twoje połączone aplikacje zwracają tafowi podczas pracy, oraz to, co jest na Twoim ekranie, gdy Coach pomaga Ci w aplikacji; oraz odpowiedź modelu. Nigdy nie jest wysyłane: hasła i klucze używane przez Twoje połączone aplikacje ani odcisk palca. Wysyłane dopiero, gdy zezwolisz na to w aplikacji tafs (zob. <a href="/pl/privacy#ai-in-tafs">Prywatność</a>). Anthropic przechowuje to do 30 dni, dłużej tylko wtedy, gdy wymaga tego prawo, jego zasady użytkowania lub warunki</td>
						<td>Stany Zjednoczone, wywoływane z Irlandii (eu-west-1); wnioskowanie może odbywać się w Stanach Zjednoczonych, Europie, Azji lub Australii</td>
					</tr>
				</tbody>
			</table>
		</div>
		@composioApps("pl")
		<p>
			Gdy podmiot podprzetwarzający znajduje się poza Europejskim
			Obszarem Gospodarczym, przekazywanie danych opiera się na
			ramach ochrony danych UE–USA lub na standardowych klauzulach
			umownych, jak określa §11
			<a href="/pl/legal/dpa#transfers">DPA</a>.
		</p>
	</section>
}

templ subprocessorsNotListedPL() {
	<section id="not-listed">
		<h2>2. Kogo nie ma na liście</h2>
		<ul>
			<li>
				<strong>Twoje własne aplikacje.</strong> Gdy KIFF wysyła
				wywołanie agenta do aplikacji połączonej przez Ciebie,
				takiej jak Twój system płatności lub wsparcia, ta
				aplikacja pracuje dla Ciebie, nie dla nas. Jej dostawca
				jest Twoim dostawcą.
			</li>
			<li>
				<strong>Publiczny weryfikowalny ślad.</strong> Publikowane
				są w nim wyłącznie zbiorcze skróty (hashe). Nie trafiają
				do niego żadne dane osobowe.
			</li>
		</ul>
	</section>
}

templ subprocessorsChangesPL() {
	<section id="changes">
		<h2>3. Zmiany</h2>
		<p>
			Zanim dodamy lub zastąpimy podmiot podprzetwarzający, który
			przetwarza Twoje dane osobowe, informujemy Cię o tym z co
			najmniej trzydziestodniowym wyprzedzeniem i możesz zgłosić
			sprzeciw, jak określa §10
			<a href="/pl/legal/dpa#sub-processors">DPA</a>. Tę stronę
			aktualizujemy w ciągu 30 dni od każdej zmiany.
		</p>

		<hr/>

		<p class="legal-footnote">
			<strong>Wersja dokumentu:</strong> v0.1.<br/>
			<strong>Ostatnia aktualizacja:</strong> 17 listopada 2026.
		</p>
	</section>
}
