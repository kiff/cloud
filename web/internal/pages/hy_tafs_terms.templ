	@components.LayoutSiteWithMeta("tafs-ի պայմաններ", "tafs-ի՝ KIFF-ի հավելվածի պայմանները. ով է տրամադրում, ձեր հաշիվը, ինչ է անում taf-ը և ինչպես եք այն վերահսկում, թույլատրելի օգտագործում, վճարներ, պատասխանատվություն և ավարտ։", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · պայմաններ</p>
				<h1>tafs-ի պայմաններ</h1>
				<p class="legal-meta"><strong>Վերջին թարմացում՝</strong> 2026 թվականի նոյեմբերի 21։</p>
				<p class="legal-disclaimer">Այս պայմանները tafs-ի համար են՝ KIFF-ի հավելվածի iPhone-ի, iPad-ի, Android-ի և համակարգիչների համար, և դրա հետևում գտնվող ծառայության։ tafs-ը KIFF Cloud-ի մասն է, և այս էջը կրկնում է, թե ինչ են ասում <a href="/hy/terms">KIFF-ի Ծառայության պայմանները</a> դրա մասին՝ նրանց ոչինչ չավելացնելով։ KIFF-ի Պայմանները կիրառվում են այն ամենի նկատմամբ, ինչ այս էջը չի ներառում։ Հարցեր՝ <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>։</p>
			</header>
			<section id="provider">
				<h2>1. Ով է տրամադրում tafs-ը</h2>
				<p>tafs-ը տրամադրվում է <strong>Kiff Agents OÜ</strong>-ի կողմից՝ Էստոնիայի սահմանափակ պատասխանատվությամբ մասնավոր ընկերության (գրանցման կոդ 17372313), Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Էստոնիա հասցեում։ Հաշիվ ստեղծելով կամ այլ կերպ tafs-ն օգտագործելով՝ դուք համաձայնվում եք այս պայմաններին և KIFF-ի Պայմաններին։ Եթե համաձայնվում եք ընկերության համար, հաստատում եք, որ կարող եք պարտավորեցնել այն։</p>
			</section>
			<section id="account">
				<h2>2. Ձեր հաշիվը</h2>
				<p>tafs-ում մուտք եք գործում KIFF հաշվով։ Տվեք ճշգրիտ տեղեկություն, ձեր հավատարմագրերը պահեք գաղտնի, և դուք պատասխանատու եք ձեր հաշվի ներքո ողջ գործունեության և յուրաքանչյուր մարդու համար, ում ներս եք թողնում։ Պետք է լինեք առնվազն 16 տարեկան կամ այն վայրում թվային համաձայնության տարիքի, որտեղ ապրում եք, որը ավելի բարձր է։ tafs-ը կարող եք օգտագործել միայն այն երկրից կամ տարածաշրջանից, որտեղ Anthropic-ը առաջարկում է իր սեփական ծառայությունը, ինչպես <a href="https://www.anthropic.com/supported-countries">նշում է Anthropic-ը</a>. ոչ ընկերության համար, որի կենտրոնակայանը, կամ նրան մեծամասնությամբ տիրապետող կամ վերահսկող ընկերության կենտրոնակայանը, այդ ցանկից դուրս գտնվող երկրում կամ տարածաշրջանում է. և ոչ եթե դուք կամ այն ընկերությունը, որի համար օգտագործում եք, ենթակա եք Եվրոպական միության, Միավորված ազգերի կազմակերպության կամ Միացյալ Նահանգների պատժամիջոցներին (KIFF-ի Պայմաններ, §4)։</p>
			</section>
			<section id="what-a-taf-does">
				<h2>3. Ինչ է անում taf-ը</h2>
				<p>tafs-ում աշխատանք եք վստահում taf-ին՝ AI գործակալին, որն աշխատում է ժամանակացույցով ձեր միացրած գործիքներով, նրա համար թողարկված KIFF Card-երի շրջանակներում։ Այն օգտագործվող AI մոդելը տրամադրում է Anthropic-ը։ Setup-ը՝ tafs-ի AI գործակալը, օգնում է ձեզ միացնել գործիք և taf կարգավորել, բայց ինքն ոչինչ չի միացնում. դուք մուտք եք գործում գործիքի սեփական մատակարարի մոտ և ձեր սարքի վրա հաստատում եք յուրաքանչյուր կապ, գործիքները, որոնք taf-ը կարող է օգտագործել, և նրա Card-երը։</p>
				<p>Taf-ի հաշվետվությունները, հաղորդագրությունները և հիշողության նշումները գրվում են AI մոդելի կողմից և կարող են սխալ լինել։ Ստուգեք կարևորը՝ նախքան դրանց վրա հիմնվելը։ Այն ամենը, ինչ taf-ը գրում է ձեր ընկերությունից դուրս որևէ մեկին, ասում է, որ գրել է AI գործակալը։</p>
			</section>
			<section id="control">
				<h2>4. Ձեր վերահսկողությունը՝ Card-ը և հաստատումները</h2>
				<p>Taf-ը ձեր գործիքներին հասնում է միայն KIFF-ի միջոցով, որը յուրաքանչյուր զանգ ուղարկելուց առաջ ստուգում է taf-ի Card-երի դիմաց։ Ձեր թողարկած Card-ի շրջանակներում կատարվող զանգը կատարվում է ձեր ցուցումով։ Card-ից դուրս զանգը կասեցվում կամ մերժվում է, ինչպես Card-ն է ասում։ Կասեցված զանգը կատարվում է միայն այն բանից հետո, երբ այն հաստատում է մեկը, ում ձեր հաշիվը թույլ է տալիս պատասխանել կասեցված զանգերին։</p>
				<p>Դուք ընտրում եք յուրաքանչյուր taf-ի աշխատանքն ու Card-երը, պատասխանում եք նրա կասեցված զանգերին և համոզվում, որ իրավունք ունեք օգտագործել գործիքները և հաշիվները, որոնք միացնում եք։ Կարող եք կանգնեցնել (halt) մեկ taf կամ բոլորը, դադարեցնել taf, չեղարկել նրա ցանկացած Card կամ հեռացնել այն։ Այն պահից, երբ taf-ը կանգնեցնում եք կամ Card-ը չեղարկում, KIFF-ը այդ taf-ի կամ այդ Card-ի տակ նոր զանգ թույլ չի տալիս։ Գործիքի մատակարարին արդեն ուղարկված հարցումը դեռ կարող է ավարտվել. մենք կանգնեցնում ենք նոր զանգերը և չենք կարող չեղարկել այն, ինչ մատակարարն արդեն արել է։ <a href="/hy/terms#tafs">KIFF-ի Պայմաններ, §3A</a>-ն ունի մանրամասները։ Երբ taf-ը վճարում է վճարման էջում այն եղանակով, որը պահպանել եք այդ կայքում, դա անում է միայն Card-ի ներսում և միայն այն բանից հետո, երբ հեռախոսում հաստատել եք այդ վճարումը. կայքը և նրա վճարային ծառայություն մատուցողը մշակում են այն, իսկ KIFF-ը և planque-ը երբեք չեն պահում ձեր փողը, երբեք չեն պահպանում ձեր քարտի տվյալները, և taf-ը երբեք չի մուտքագրում քարտի համար։</p>
				<p>ԵՄ AI օրենքի համաձայն Kiff Agents OÜ-ն tafs-ի մատակարարն է, իսկ դուք՝ դրա deployer-ը։ tafs-ը օգտագործեք միայն այն աշխատանքների համար, որոնք առաջարկում է, և ոչ որևէ օգտագործման համար, որն AI օրենքը արգելում է կամ դասում է բարձր ռիսկի, ինչպիսիք են անձի աշխատանքի, վարկի կամ կարևոր ծառայություններին մուտքի վերաբերյալ որոշումները։</p>
			</section>
			<section id="acceptable-use">
				<h2>5. Թույլատրելի օգտագործում</h2>
				<p>Դուք, ձեր մարդիկ և ձեր taf-երը պետք է պահպանեք <a href="/acceptable-use">Թույլատրելի օգտագործման քաղաքականությունը</a> (անգլերեն)։ Գործակալի գործողությունը ձեր գործողությունն է։ Ի թիվս այլոց, չեք կարող tafs-ը օգտագործել օրենքը խախտելու, համակարգի կամ հաշվի վրա գործելու համար, որը չեք լիազորված օգտագործել, գործիք միացնելու մուտքով, որը ձեր տալու իրավունքը չէ, սպամ ուղարկելու կամ Card-ը, սահմանաչափը կամ կասեցումը շրջանցելու համար։ Կարող ենք անմիջապես կասեցնել հավաստի խախտման դեպքում։</p>
			</section>
			<section id="fees">
				<h2>6. Վճարներ</h2>
				<p>Այս թարմացման պահին Solo-ն { tafsCostHY.money(TafsSoloCents) } է ամսական, ԱԱՀ-ն ներառյալ, ամսական { tafsCostHY.number(TafsSoloCredits) } կրեդիտով, վաճառվում է հավելվածում App Store-ի կամ Google Play-ի միջոցով։ Կրեդիտների փաթեթները, գնված հավելվածում, սկսվում են { tafsCostHY.money(TafsPackCents[TafsSoloCredits]) }-ից. դրանք ժամկետ չունեն։ Taf-ի յուրաքանչյուր գործարկում կրեդիտներ է օգտագործում AI-ի համար, որն օգտագործել է։ Coach-ը և taf-երի կարգավորումը ներառված են Coach-ի արդար օգտագործման շրջանակներում։ Սրանք գներն են եվրոյի գոտում։ Այլուր App Store-ը կամ Google Play-ը գինը ցույց է տալիս ձեր արժույթով՝ տեղական հարկով կամ առանց դրա, ինչպես պահանջում են այդ երկրի կանոնները, և դա է այն գինը, որը վճարում եք։ Ընթացիկ գները <a href="/pricing">գների էջում</a> (անգլերեն) են. tafs-ը նաև KIFF-ի Company պլանի մասն է։</p>
				<p>Փորձաշրջան չկա։ Հավելվածում գնված Solo-ն կառավարվում և չեղարկվում է ձեր Apple-ի կամ Google Play-ի բաժանորդագրություններում՝ այդ խանութի վճարման, թարմացման և վերադարձի պայմաններով։ Պլանը տևում է մինչև վճարված ժամանակահատվածի ավարտը։ Եթե ԵՄ-ում սպառող եք, կարող եք գնումից 14 օրվա ընթացքում հրաժարվել։ <a href="/hy/terms#fees">KIFF-ի Պայմաններ, §8</a>-ն ունի մանրամասները։</p>
			</section>
			<section id="liability">
				<h2>7. Պատասխանատվություն</h2>
				<p>tafs-ը տրամադրվում է «ինչպես կա» և «ինչպես հասանելի է», բացառությամբ KIFF-ի Պայմանների երաշխիքների (§10)։ Օրենքի թույլատրած չափով ոչ մի կողմ պատասխանատու չէ անուղղակի կամ հետևանքային վնասների համար, և յուրաքանչյուր կողմի ընդհանուր պատասխանատվությունը սահմանափակվում է, ինչպես ասում է <a href="/hy/terms#liability">KIFF-ի Պայմաններ, §12</a>-ը։ Ոչինչ չի սահմանափակում պատասխանատվություն, որը օրենքը թույլ չի տալիս սահմանափակել։</p>
			</section>
			<section id="termination">
				<h2>8. Ավարտ</h2>
				<p>Կարող եք դադարել ցանկացած ժամանակ՝ ջնջեք ձեր հաշիվը հավելվածում, Հաշիվ → <em>Ջնջել հաշիվը</em>։ Նախ արտահանեք ձեր զրույցները՝ Հաշիվ → Արտահանել իմ զրույցները։ Կարող ենք ավարտել ձեր օգտագործումը էական խախտման համար, որը չի ուղղվել ծանուցումից երեսուն օրվա ընթացքում, կամ անմիջապես թույլատրելի օգտագործման խախտման համար։ Հեռանալու և ձեր տվյալները ձեզ հետ վերցնելու ձեր իրավունքները <a href="/hy/terms#term">KIFF-ի Պայմաններ, §9</a>-ում են։</p>
			</section>
			<section id="governing-law">
				<h2>9. Փոփոխություններ և կիրառելի իրավունք</h2>
				<p>Այս պայմանները փոխում ենք այնպես, ինչպես KIFF-ի Պայմանները ասում են իրենց սեփականի համար (§16)։ Դրանք կարգավորվում են Էստոնիայի Հանրապետության օրենքներով, և վեճերը գնում են Հարյու շրջանային դատարան Տալլինում։ Եթե ԵՄ մեկ այլ անդամ պետությունում սպառող եք, ձեր երկրի պարտադիր սպառողական պաշտպանության կանոնները դեռ կիրառվում են։</p>
			</section>
