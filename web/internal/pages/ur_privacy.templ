package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// PrivacyUR is KIFF's privacy policy (/privacy) in Urdu, at /ur/privacy.
// It is a translation of Privacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Urdu has the legal
// texts only, so a link to any other page goes to English and says so. It is
// written right to left (components.IsRightToLeft).
templ PrivacyUR() {
	@components.LayoutSite("KIFF — privacy policy", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@privacyHeadUR()
			@privacyWhoWeAreUR()
			@privacyScopeUR()
			@privacyRolesUR()
			@privacyCategoriesUR()
			@privacyLawfulBasesUR()
			@privacySubprocessorsUR()
			@privacyTransfersUR()
			@privacyRetentionUR()
			@privacyRightsUR()
			@privacyCookiesUR()
			@privacySecurityUR()
			@privacyChildrenUR()
			@privacyAutomatedUR()
			@privacyChangesUR()
			@privacyContactUR()
		</article>
	}
}

templ privacyHeadUR() {
	<header class="legal-head">
		<p class="legal-badge">رازداری کی پالیسی · v0.1</p>
		<h1>رازداری کی پالیسی</h1>
		<p class="legal-meta">
			<strong>آخری تازہ کاری:</strong> 24 نومبر 2026۔
			<strong>نفاذ کی تاریخ:</strong> 24 مئی 2026۔
		</p>
		<p class="legal-disclaimer">
			یہ پالیسی بتاتی ہے کہ KIFF Cloud ویب سائٹ، ڈیش بورڈ، API اور iPhone، iPad، Android اور کمپیوٹرز کے لیے tafs ایپ میں ذاتی ڈیٹا کو کیسے پراسیس کرتا ہے۔ سوالات:
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>۔
		</p>
	</header>
}

templ privacyWhoWeAreUR() {
	<section id="who-we-are">
		<h2>1. ہم کون ہیں</h2>
		<p>
			KIFF Cloud کو <strong>Kiff Agents OÜ</strong> چلاتی ہے، جو ایسٹونیا میں رجسٹرڈ ایک نجی محدود ذمہ داری کمپنی ہے۔ رجسٹریشن کی معلومات:
		</p>
		<ul>
			<li><strong>رجسٹریشن کوڈ:</strong> 17372313 (ایسٹونیا کا e-Business Register)</li>
			<li><strong>VAT نمبر:</strong> EE102924327</li>
			<li><strong>رجسٹرڈ پتہ:</strong> Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416، ایسٹونیا</li>
			<li><strong>رازداری کے لیے رابطہ:</strong> <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a></li>
			<li><strong>رسمی قانونی نوٹسز:</strong> <a href="mailto:legal@kiff.dev">legal@kiff.dev</a></li>
		</ul>
		<p>
			چونکہ Kiff Agents OÜ یورپی یونین میں قائم ہے، یورپی یونین کا جنرل ڈیٹا پروٹیکشن ریگولیشن
			(<abbr title="جنرل ڈیٹا پروٹیکشن ریگولیشن">GDPR</abbr>)
			ہماری پراسیسنگ پر براہِ راست لاگو ہوتا ہے۔ ہمیں آرٹیکل 27 کے EU نمائندے کی ضرورت نہیں۔
		</p>
	</section>
}

templ privacyScopeUR() {
	<section id="scope">
		<h2>2. اس پالیسی کا دائرہ</h2>
		<p>
			یہ پالیسی اس ذاتی ڈیٹا کا احاطہ کرتی ہے جسے ہم تب پراسیس کرتے ہیں جب آپ ان کے ساتھ تعامل کرتے ہیں:
		</p>
		<ul>
			<li><a href="https://kiff.dev"><code>kiff.dev</code></a> — ہماری مارکیٹنگ سائٹ، یہ پالیسی کا صفحہ اور عوامی رسید دکھانے والا صفحہ۔</li>
			<li><a href="https://app.kiff.dev"><code>app.kiff.dev</code></a> — ہمارا تصدیق شدہ ڈیش بورڈ۔</li>
			<li><a href="https://api.kiff.dev"><code>api.kiff.dev</code></a> — ہماری HTTP API۔</li>
			<li id="tafs"><strong>tafs</strong> — iPhone، iPad، Android اور کمپیوٹرز (Mac، Windows اور Linux) کے لیے ہماری ایپ اور اس کے پیچھے کی سروس (جس میں کمپنی کے ٹولز جوڑنے والا Setup اور ان کنکشنز کو رکھنے والا planque شامل ہیں)، جس میں کمپنی KIFF Card کے اندر کام کرنے والے AI ایجنٹ کو کام سونپتی ہے۔</li>
		</ul>
		<p>
			یہ پالیسی اوپن سورس <code>kiff/kiff</code> فریم ورک کا احاطہ <em>نہیں</em> کرتی، جسے آپ خود چلا سکتے ہیں۔
			جب آپ فریم ورک اپنے انفراسٹرکچر پر چلاتے ہیں، تو وہ جو بھی ڈیٹا پراسیس کرتا ہے اس کے کنٹرولر آپ ہیں، اور
			Kiff Agents OÜ اس پراسیسنگ میں شامل نہیں۔
		</p>
	</section>
}

templ privacyRolesUR() {
	<section id="roles">
		<h2>3. GDPR کے تحت ہمارے کردار</h2>
		<p>
			ہم ڈیٹا کے مطابق دو حیثیتوں میں کام کرتے ہیں:
		</p>
		<ul>
			<li>
				<strong>کنٹرولر</strong> اکاؤنٹ اور سائن اِن میٹا ڈیٹا، بلنگ ڈیٹا (بلنگ فعال ہونے پر)، آپ کے منتخب کردہ مارکیٹنگ مواصلات، اور ہماری اپنی سروس کی آپریشنل ٹیلی میٹری کے لیے۔
			</li>
			<li>
				<strong>پراسیسر</strong> آڈٹ ڈیٹا، ایکشن ریکارڈز، فیصلہ رسیدوں اور اس دوسرے مواد کے لیے جو ہمارے صارفین کی طرف سے رن ٹائم سے گزرتا ہے، اور tafs ان کے لیے جو رکھتا ہے اس کے لیے (ہر taf کے رن، چیٹس، رپورٹیں، میموری نوٹس اور ان کی فراہم کردہ فائلیں)۔
				صارفین (ٹیننٹس) اس ڈیٹا کے کنٹرولر ہیں؛
				وہ اپنی اکاؤنٹ سیٹنگز اور ڈومین کنفیگریشن کے ذریعے ہمیں ہدایت دیتے ہیں۔ ڈیٹا پراسیسنگ معاہدہ
				(<abbr title="ڈیٹا پراسیسنگ معاہدہ">DPA</abbr>)
				اس تعلق کو منظم کرتا ہے؛ شائع شدہ شرائط کے لیے
				<a href="/legal/dpa">DPA ٹیمپلیٹ</a>
				دیکھیں۔
			</li>
		</ul>
		<p>
			یہ پالیسی بنیادی طور پر ہماری کنٹرولر کی طرف کی پراسیسنگ کو بیان کرتی ہے۔ جہاں ہم پراسیسر کی طرف کے ڈیٹا کا ذکر کرتے ہیں، وہاں DPA زیادہ مخصوص دستاویز ہے۔
		</p>
	</section>
}

templ privacyCategoriesUR() {
	<section id="categories">
		<h2>4. ہم ذاتی ڈیٹا کی کن اقسام کو پراسیس کرتے ہیں</h2>
		<p>
			نیچے کی اقسام
			<a href="/security#data-we-process">/security#data-we-process</a>
			پر دی گئی تکنیکی فہرست کے مطابق ہیں۔
			جہاں دونوں میں فرق ہو، تکنیکی صفحہ ہی سچائی کا ماخذ ہے اور ہم اس حصے کو اس کے مطابق تازہ کرتے ہیں۔
		</p>
		<ul>
			<li>
				<strong>اکاؤنٹ شناخت کنندگان</strong> — ہمارے شناخت فراہم کنندہ کا جاری کردہ آپ کا اپ اسٹریم تصدیقی موضوع اور وہ ای میل پتہ جس سے آپ سائن اِن کرتے ہیں۔
				آج یہ جوں کا توں رکھا جاتا ہے؛ ہیش کر کے رکھنا منصوبے میں ہے۔
				اگر آپ ای میل سے بھیجے گئے کوڈ سے سائن اِن آن کرتے ہیں (آپ نہ کریں تو وہ بند رہتا ہے)، تو KIFF وہ سیٹنگ آپ کی سائن اِن id اور اسے بدلنے کی تاریخ کے ساتھ رکھتا ہے۔ ہم آپ کو جو کوڈ ای میل کرتے ہیں وہ صرف کلیدی ہیش کی شکل میں، استعمال ہونے تک یا دس منٹ گزرنے تک رکھا جاتا ہے۔ غلط استعمال روکنے کے لیے، ہم درخواست کرنے والے پتے کے کلیدی ہیش اور IP پتے کے لحاظ سے درخواستوں کی گنتی ایک دن تک رکھتے ہیں۔ کوڈ سے سائن اِن کرنے کے بعد، ہم اسے ایک چوتھائی گھنٹے تک نوٹ کرتے ہیں، تاکہ حالیہ سائن اِن کی ضرورت والی تبدیلیاں آپ سے کسی اور طریقے سے سائن اِن کرنے کو کہیں۔
			</li>
			<li>
				<strong>ٹیننٹ میٹا ڈیٹا</strong> — ٹیننٹ id، سلگ، ڈسپلے نام، تخلیق کا ٹائم اسٹیمپ، اور ہر شخص کی ایپ کی آخری زبان، تاکہ KIFF انہیں جو ای میلز بھیجتا ہے وہ اسی میں آئیں۔
			</li>
			<li>
				<strong>API اسناد</strong> — غیر واضح API key ریکارڈز
				(ہم ہیشز رکھتے ہیں، سادہ متن کبھی نہیں)۔
			</li>
			<li>
				<strong>سیشن کوکی ڈیٹا</strong> — سائن اِن کے بعد لگائی گئی HMAC سے دستخط شدہ سیشن کوکی۔ نیچے کوکیز کا حصہ دیکھیں۔
			</li>
			<li>
				<strong>HTTP درخواست میٹا ڈیٹا</strong> — IP پتہ، یوزر ایجنٹ، درخواست کا راستہ، جواب کی حالت، تاخیر۔
				سیکیورٹی اور غلط استعمال کی روک تھام کے لیے محدود برقرار رکھنے کی مدت تک ہمارے ریورس پراکسی کے ایکسیس لاگز میں رکھا جاتا ہے۔
			</li>
			<li>
				<strong>ٹیننٹ کے زیرِ کنٹرول مواد</strong> —
				وہ <code>parameters</code>، <code>actor</code> اور
				<code>entity</code> ڈیٹا جو آپ رن ٹائم کو بھیجتے ہیں۔
				ہم اسے صارف کی طرف سے <em>پراسیسر کے طور پر</em> رکھتے ہیں؛
				تار پر کیا پہنچتا ہے، اس کی ذمہ داری صارف کی ہے۔ فی ڈومین ریڈیکشن کنفیگریشن منصوبے میں ہے۔
			</li>
			<li>
				<strong>مواصلات</strong> — آپ ہمارے سپورٹ، سیلز، سیکیورٹی یا رازداری کے میل باکسز کو جو ای میلز بھیجتے ہیں۔
			</li>
			<li>
				<strong>tafs ایپ</strong> — آپ tafs میں اپنے KIFF اکاؤنٹ سے سائن اِن کرتے ہیں۔ فون یا ٹیبلیٹ پر ایپ آپ کا سیشن آلے کے Keychain میں (Android پر اس کی خفیہ کردہ اسٹوریج میں) رکھتی ہے۔ کمپیوٹر پر وہ اسے آپ کے صارف اکاؤنٹ کے لیے سیل کر کے رکھتی ہے: Windows PC پر Windows کے اپنے ڈیٹا تحفظ سے، Linux پر آپ کی کی رنگ میں، Mac پر اس کے Keychain میں۔ کمپیوٹر کا سیشن 90 دن تک چلتا ہے۔
				ایپ ایک دستخطی کلید بناتی ہے جو آلے سے کبھی باہر نہیں جاتی:
				iPhone، iPad یا Mac کے Secure Enclave میں، Android آلے کے
				Keystore میں، یا Windows PC کے TPM میں۔ Linux پر، اور Secure Enclave کے بغیر Mac پر،
				کلید ایک سافٹ ویئر کلید ہے جو آپ کی کی رنگ یا Keychain میں رہتی ہے،
				اور وہ کمپیوٹر یہ دکھا سکتا ہے کہ آپ کا کیا انتظار ہو رہا ہے مگر اسے منظور نہیں کر سکتا؛ آپ اپنے فون پر منظور کرتے ہیں{ macSecurityKey("ur") }۔ TPM کے بغیر Windows PC
				tafs میں سائن اِن نہیں کر سکتا۔ KIFF کلید کا عوامی آدھا حصہ، آلے کا
				نام اور پلیٹ فارم، اور یہ کہ وہ کب شامل ہوا اور آخری بار کب استعمال ہوا، رکھتا ہے،
				تاکہ روکی گئی کالز پر آپ کے جوابات اور کنکشنز کی آپ کی منظوریاں جانچ سکے۔ اگر آپ اپنے کمپیوٹر پر passkey سے منظور کرتے ہیں، جیسے Windows Hello یا سیکیورٹی
				کلید، تو آپ کا چہرہ،
				فنگر پرنٹ یا PIN کمپیوٹر کے اپنے سسٹم میں رہتا ہے؛
				KIFF passkey کی عوامی کلید، اس کی id، ایک کاؤنٹر
				اور ایک نام رکھتا ہے، کبھی کچھ خفیہ نہیں، اور دوسرے آلات پر سنک ہونے والی passkey کو مسترد کرتا ہے۔ اگر آپ فون، ٹیبلیٹ یا iPad ایپ چلانے والے Mac پر الرٹس آن کرتے ہیں، تو ہم آلے کا push ٹوکن
				آپ کی KIFF شخص id کے ساتھ، اور ایپ نے جو زبان دکھائی وہ رکھتے ہیں، تاکہ
				اس کے الرٹس اسی میں آئیں۔ tafs سروس اکاؤنٹ کی زبان بھی، جس نے آخری بار Coach سے چیٹ کی اس کی، تین ماہ تک رکھتی ہے، تاکہ taf کی رپورٹیں اسی میں آئیں۔
				فون کا الرٹ Apple یا Google سے ہو کر صرف یہ بتا کر جاتا ہے کہ کون سا taf اور وہ کیا چاہتا ہے،
				اور کسی دروازے کے الرٹ میں لکھنے والے کا نام یا ای میل پتہ: کبھی کوئی
				رقم یا درخواست کی تفصیل نہیں۔ ایپ یہ باتیں آلے پر
				ہی، KIFF سے، جوڑتی ہے، اس لیے ان لاک فون کا الرٹ رقم، تاجر یا شخص دکھا سکتا ہے۔ لاک
				Android فون پر وہ صرف "کسی taf کو آپ کی ضرورت ہے" دکھاتا ہے، اور لاک iPhone پر بھی، جب تک آپ نے اس کے پیش منظر
				ہمیشہ دکھانے پر نہ رکھے ہوں۔ <strong>آپ کی گھڑی:</strong> گھڑی میں کوئی پاس ورڈ یا کلید نہیں ہوتی، وہ صرف آپ کے جوڑے ہوئے فون سے بات کرتی ہے، اور کبھی منظور نہیں کرتی۔ آپ Coach یا اپنے منتخب taf سے جو کہتے ہیں وہ AI کی اجازت دینے کے بعد، فون کے ذریعے، صرف ٹیکسٹ کی شکل میں بھیجتی ہے۔ گھڑی کی اپنی بول چال کی سروس، Apple کی یا Google کی، آپ کے الفاظ کو اس ٹیکسٹ میں بدلتی ہے۔ Wear OS پر، اگر آپ کے مکمل کرنے سے پہلے وہ رک جائے، تو آپ کے فون کی اپنی شناخت کی سروس یہ کام فون پر ہی کرتی ہے۔ وہ مسترد کرنے، روکنے یا Coach یا taf کو بھیجنے کا کام صرف تب کر سکتی ہے جب اس میں اسکرین لاک یا پاس کوڈ ہو اور وہ ان لاک ہو۔ آپ taf کو جو بھیجتے ہیں وہ اس taf کی اپنی چیٹ میں جاتا ہے، گویا آپ نے اسے اپنے فون پر لکھا ہو۔ کسی taf کی چیٹ، رقموں سمیت، ہر بار کھلنے پر فون کے ذریعے پڑھی جاتی ہے، اور گھڑی صرف وہ حالیہ پیغامات رکھتی ہے جن کا ذکر نیچے اس کے اپنے حصے میں ہے۔ <strong>Apple Watch:</strong> وہ آپ کے tafs اور ان کے صفحات بغیر رکھے دکھاتی ہے۔ وہ آپ کا Inbox رکھتی ہے، ایک ایسی فائل میں جسے لاک رہتے وہ پڑھ نہیں سکتی: ہر روکی گئی کال taf کے نام اور وہ کیا مانگتا ہے کی شکل میں، کبھی کوئی رقم نہیں، اور گھڑی سے آپ کے بھیجے پر Coach کے جوابات، ٹیکسٹ کی شکل میں۔ اگر آپ گھڑی پر سائن آؤٹ کرتے ہیں، تو وہ یہ بھی رکھتی ہے کہ آپ نے کیا، جب تک آپ گھڑی پر دوبارہ سائن اِن نہ کریں۔ اس کے علاوہ، گھڑی میں پاس کوڈ نہ ہو تو وہ کچھ نہیں رکھتی۔ Inbox تب چلا جاتا ہے جب آپ گھڑی پر سائن آؤٹ کرتے ہیں یا آپ کا iPhone سائن آؤٹ ہوتا ہے، یا ایپ اگلی بار بغیر پاس کوڈ کے کھلتی یا بند ہوتی ہے۔ وہ کوئی ریکارڈنگ نہیں کرتی، اور جو اطلاعات دکھاتی ہے وہ صرف آپ کے iPhone کی ہوتی ہیں۔ تاکہ گفتگو فوراً کھلے، وہ اس پر کھولی گئی زیادہ سے زیادہ 20 گفتگوؤں میں سے ہر ایک کے آخری 30 پیغامات بھی رکھتی ہے، Coach کے اور آپ کے tafs کے، صرف متن کے طور پر اور کبھی کوئی رقم نہیں، Inbox کی طرح لاک؛ یہ Inbox کے ساتھ ہٹ جاتے ہیں، اور جب کوئی گفتگو 30 دن تک نہ کھولی جائے۔ <strong>Wear OS:</strong> وہ آپ کے اکاؤنٹ کا ای میل اور آج کا کیلنڈر بغیر رکھے دکھاتی ہے۔ فوراً کھلنے کے لیے وہ خفیہ کردہ شکل میں آپ کا انتظار کرنے والی چیزوں کی گنتی، اور ہر taf کا نام اور وہ رکا یا تھما ہوا ہے یا نہیں رکھتی: کبھی کوئی رقم، روکی گئی کال کی تفصیل یا taf کی چیٹ نہیں۔ یہ تب صاف ہو جاتا ہے جب آپ سائن آؤٹ کرتے ہیں، جب گھڑی لاک ہوتی ہے یا کلائی سے اتاری جاتی ہے، اور 24 گھنٹے بعد۔ وہ آپ کا Inbox رکھتی ہے، جس میں ہر سطر taf کا نام اور وہ جو کہتا ہے ہے، کبھی کوئی رقم نہیں، اور بعد کے لیے رکھا ایک پیغام، ٹیکسٹ کی شکل میں۔ گھڑی یا فون پر سائن آؤٹ کرنے سے یہ سب صاف ہو جاتا ہے۔ اپنی ٹائل کے لیے وہ آپ کا انتظار کرنے والی چیزوں کی گنتی بھی رکھتی ہے، جو صرف گھڑی کے ان لاک رہتے دکھائی دیتی ہے، اور جب آپ سائن آؤٹ کرتے ہیں، یا اگلی بار ٹائل گھڑی کے لاک یا بغیر اسکرین لاک کے رہتے دکھائی دیتی ہے، تب صاف ہو جاتی ہے۔ گھڑی پر سائن آؤٹ کے بعد وہ اس کا نوٹ رکھتی ہے کہ آپ نے کیا، جب تک آپ دوبارہ سائن اِن نہ کریں۔ Inbox بھی تب چلا جاتا ہے جب ایپ اگلی بار گھڑی کے لاک یا بغیر اسکرین لاک کے رہتے کھلتی یا بند ہوتی ہے۔ بعد کے لیے رکھا پیغام تب تک رہتا ہے جب تک آپ اسے بھیجیں یا حذف کریں، کیونکہ آپ نے اسے بھیجنے کو کہا تھا۔ اگر گھڑی کی بول چال کی سروس آپ کے مکمل کرنے سے پہلے رک جائے، تو گھڑی ریکارڈنگ آپ کے فون کو بھیجتی ہے، جو اسے فون پر ہی ٹیکسٹ میں بدلتا ہے، کبھی کسی سرور پر نہیں۔ ٹیکسٹ واپس آنے یا آپ کے منسوخ کرنے پر، اور زیادہ سے زیادہ 2 منٹ بعد، ریکارڈنگ دونوں جگہ مٹا دی جاتی ہے۔ صرف ٹیکسٹ آگے Coach یا آپ کے taf تک جاتا ہے۔ taf کا نتیجہ گھڑی کی اطلاعات میں تب تک رہ سکتا ہے جب تک آپ اسے مسترد نہ کریں یا گھڑی پر سائن آؤٹ نہ کریں۔ تاکہ گفتگو فوراً کھلے، وہ اس پر کھولی گئی زیادہ سے زیادہ 20 گفتگوؤں میں سے ہر ایک کے آخری 30 پیغامات بھی رکھتی ہے، Coach کے اور آپ کے tafs کے، صرف متن کے طور پر اور کبھی کوئی رقم نہیں، انکرپٹ کر کے؛ آپ گھڑی یا فون پر سائن آؤٹ کریں تو، اور کوئی گفتگو 30 دن تک نہ کھولی جائے تو، یہ ہٹ جاتے ہیں، اور اسکرین لاک کے بغیر گھڑی ان میں سے کچھ نہیں رکھتی۔ Windows PC،
				Linux کمپیوٹر یا macOS 12 ایپ والے Mac پر الرٹس ایپ خود چلتے ہوئے بناتی ہے،
				بغیر push ٹوکن کے اور کسی اور کمپنی کے ذریعے نہیں۔ Windows اور Linux پر
				وہ دکھاتے ہیں کہ کون سا taf، وہ کیا کرنا چاہتا ہے، رقم، کیوں
				اور کب تک؛ macOS 12 ایپ پر، آپ کے انہیں آن کرنے کے بعد، وہ کال کے لیے KIFF کے الفاظ دکھاتے ہیں،
				اور لاک اسکرین وہ دکھاتی ہے جو Mac کی پیش منظر سیٹنگ اجازت دے۔ Windows پر
				وہ آپ کے آن کرنے تک بند رہتے ہیں، اور اسکرین لاک ہونے پر صرف "کسی taf کو آپ کی ضرورت ہے" دکھاتے ہیں۔ اسکرین لاک ہونے سے پہلے دکھایا گیا الرٹ
				اپنی تفصیل Windows کی اطلاعات کی فہرست میں رکھتا ہے۔ Linux پر وہ آپ کے
				بند کرنے تک آن رہتے ہیں، اور لاک اسکرین کیا دکھاتی ہے وہ آپ کے ڈیسک ٹاپ پر منحصر ہے۔ جب آپ
				کوئی ٹول جوڑتے ہیں، تو آپ ٹول کے اپنے فراہم کنندہ پر سائن اِن کرتے ہیں۔ جس ایپ میں planque خود سائن اِن کرتا ہے، جیسے Stripe، یا آپ کی دی ہوئی key کے لیے، planque وہ ٹوکن یا key آپ کی کمپنی کے لیے خفیہ کردہ شکل میں رکھتا ہے؛ منظم کنکشن کے لیے، planque کی ساتھی کنکشن سروس Composio سائن اِن رکھتی ہے، اور planque صرف کنکشن کا ریکارڈ اور آپ کے منظور کیے ہوئے ٹولز رکھتا ہے (سب پراسیسر کے طور پر، نیچے دیکھیں)۔ اگر آپ tafs ایکسٹینشن کو جوڑتے ہیں، تو taf آپ کے اپنے Chrome میں، آپ کی اجازت دی ہوئی سائٹس کے صفحات پڑھ اور ان پر کارروائی بھی کر سکتا ہے (پراسیسر کے طور پر؛ <a href="/ur/tafs/privacy">tafs رازداری کا صفحہ</a> بتاتا ہے کہ کیا پڑھا جاتا ہے، کیا رکھا جاتا ہے اور کتنی دیر)۔ کنکشن کے ریکارڈ میں وہ اکاؤنٹ (اس کا نام یا ای میل) ہو سکتا ہے جس میں وہ سائن اِن ہے، تاکہ ایپ آپ کو دکھا سکے کہ وہ کون سا ہے۔ KIFF منظم کنکشنز صرف <a href="/subprocessors#composio">/subprocessors</a> پر بتائی گئی ایپس کے لیے استعمال کرتا ہے۔ ایپ میں کوئی اینالیٹکس یا
				اشتہاری ٹریکر نہیں ہیں۔
			</li>
			<li>
				<strong>App Store خریداریاں</strong> — جب آپ tafs میں Solo یا کریڈٹ پیک خریدتے ہیں، تو Apple اسے آپ کو بیچتی ہے: Apple
				ریکارڈ کی فروخت کنندہ ہے، ادائیگی لیتی ہے اور آپ کی ادائیگی کی تفصیل رکھتی ہے۔ Apple ہمیں بتاتی ہے کہ کیا خریدا گیا،
				کس KIFF اکاؤنٹ کے لیے (ایپ خریداری کے ساتھ جو بے ترتیب id جوڑتی ہے)، کب، Apple کی لین دین id، اور Solo کے لیے
				مدت کب ختم یا تجدید ہوتی ہے۔ ہم اسے آپ کے اکاؤنٹ میں
				کریڈٹس یا پلان شامل کرنے کے لیے استعمال کرتے ہیں۔ Apple ہمیں
				آپ کا Apple ID، نام، ای میل پتہ یا کارڈ نہیں دیتی۔
			</li>
			<li>
				<strong>Google Play خریداریاں</strong> — Android پر
				وہی خریداریاں Google Play کی بلنگ سے ہوتی ہیں:
				Google ادائیگی لیتی ہے اور آپ کی ادائیگی کی تفصیل رکھتی ہے۔ Google ہمیں بتاتی ہے کہ کیا خریدا گیا، کس
				KIFF اکاؤنٹ کے لیے (وہی بے ترتیب id)، کب، خریداری کا ٹوکن اور آرڈر id، اور Solo کے لیے
				مدت کب ختم یا تجدید ہوتی ہے، اور ہم اس کا استعمال اسی طرح کرتے ہیں۔
				Google ہمیں آپ کا Google اکاؤنٹ، نام،
				ای میل پتہ یا کارڈ نہیں دیتی۔
			</li>
		</ul>
	</section>
}

templ privacyLawfulBasesUR() {
	<section id="lawful-bases">
		<h2>5. پراسیسنگ کی قانونی بنیادیں</h2>
		<p>
			GDPR کے آرٹیکل 6 کے تحت، ہم ان قانونی بنیادوں پر انحصار کرتے ہیں:
		</p>
		<ul>
			<li>
				<strong>معاہدے کی تکمیل</strong> (آرٹیکل
				6(1)(b)) — اکاؤنٹ بنانے، تصدیق، آپ کی طرف سے رن ٹائم چلانے، بلنگ (فعال ہونے پر) اور بنیادی سروس سطحوں کے لیے۔
			</li>
			<li>
				<strong>جائز مفادات</strong> (آرٹیکل 6(1)(f))
				— سیکیورٹی، دھوکہ دہی کی روک تھام، غلط استعمال کی نشاندہی،
				آپریشنل ٹیلی میٹری اور سروس کی حفاظت کے لیے۔
				ہم اپنے مفادات کو آپ کے حقوق سے تولتے ہیں اور درخواست پر بتائیں گے کہ اس توازن کے امتحان کا
				کیا نتیجہ رہا۔
			</li>
			<li>
				<strong>رضامندی</strong> (آرٹیکل 6(1)(a)) — tafs ایپ میں AI کے لیے: Coach اور آپ کے tafs کو چلانے والے AI ماڈل کو جو بھیجا جاتا ہے، جیسا <a href="#ai-in-tafs">نیچے</a> بیان ہے۔ آپ کے اجازت دینے تک کچھ نہیں بھیجا جاتا، اور آپ اکاؤنٹ میں واپس لے سکتے ہیں۔ رضامندی وہ بھی ہے جو ہم کسی اینالیٹکس کوکی، اختیاری مارکیٹنگ مواصلات، یا ایسی نئی پراسیسنگ سے پہلے مانگیں گے جو آپ کے ڈیٹا کے ہمارے استعمال کو واقعی بڑھائے۔ ہم کوئی اینالیٹکس، کوئی اشتہار اور کوئی غیر ضروری ٹریکنگ نہیں چلاتے۔
			</li>
			<li>
				<strong>قانونی ذمہ داری</strong> (آرٹیکل 6(1)(c))
				— ٹیکس ریکارڈ (ایسٹونیا کا اکاؤنٹنگ ایکٹ §12، 7
				سال)، قانونی حکام کی درخواستوں کے جوابات، اور جہاں لاگو ہو
				منی لانڈرنگ مخالف قواعد کے مطلوبہ برقرار رکھنے کے لیے۔
			</li>
		</ul>
		<h3 id="ai-in-tafs">tafs ایپ میں AI</h3>
		<p>tafs ایپ کچھ بھی AI کو جانے سے پہلے آپ سے ان الفاظ میں پوچھتی ہے:</p>
		<ul>
			<li>tafs، Coach اور آپ کے tafs کے لیے Anthropic کا Claude AI استعمال کرتا ہے۔</li>
			<li>Coach اور آپ کے tafs AI ایجنٹ ہیں: وہ جو لکھتے ہیں وہ AI سے بنا ہوتا ہے اور غلط ہو سکتا ہے۔ taf آپ کی کمپنی سے باہر جو پیغام بھیجتا ہے، اس میں بتایا جاتا ہے کہ اسے ایک AI ایجنٹ نے لکھا ہے۔</li>
			<li>اسے کیا بھیجا جاتا ہے: آپ Coach اور اپنے tafs کو جو لکھتے ہیں، آپ کی جوڑی ہوئی فائلیں، کام کرتے وقت آپ کی جڑی ایپس taf کو جو لوٹاتی ہیں، اور ایپ میں Coach آپ کی مدد کرتے وقت آپ کی اسکرین پر کیا ہے۔</li>
			<li>جو کبھی نہیں بھیجا جاتا: آپ کی جڑی ایپس کے استعمال کیے گئے پاس ورڈ اور کلیدیں، یا آپ کا فنگر پرنٹ۔</li>
			<li>Anthropic اسے جواب دینے کے لیے استعمال کرتی ہے اور 30 دن تک رکھتی ہے۔</li>
			<li>آپ کے اجازت دینے تک کچھ نہیں بھیجا جاتا۔ آپ اکاؤنٹ میں واپس لے سکتے ہیں۔</li>
		</ul>
		<p>جو taf اس وقت کسی کے موجود ہوئے بغیر چلتا ہے (اپنے مقررہ وقت پر، یا جب کچھ آتا ہے)، وہ اس شخص کی رضامندی پر ٹکا ہے جس نے اسے بنایا یا سنبھالا، یا پھر اکاؤنٹ کے tafs سنبھالنے والے پہلے شخص کی جس نے اجازت دی۔</p>
		<p><strong>جب آپ واپس لیتے ہیں،</strong> Coach اور آپ کے tafs آپ کو جواب دینا بند کر دیتے ہیں۔ جس taf کے رن آپ کی رضامندی پر ٹکے ہیں وہ تھم جاتا ہے: اس کے مقررہ اوقات رک جاتے ہیں، اور جو آتا ہے وہ انتظار کرتا ہے۔ وہ تب پھر چلتا ہے جب رضامندی دوبارہ دی جائے، یا اکاؤنٹ کے tafs سنبھالنے والا کوئی اپنی رضامندی سے اسے سنبھال لے۔ واپس لینے سے پہلے جو بھیجا گیا اس میں تبدیلی نہیں ہوتی۔</p>
		<p>Anthropic <a href="/subprocessors">/subprocessors</a> (انگریزی میں) پر درج ہے، جس میں بتایا ہے کہ وہ کہاں پراسیس کرتی ہے اور کب ڈیٹا زیادہ دیر رکھ سکتی ہے۔</p>
	</section>
}

templ privacySubprocessorsUR() {
	<section id="sub-processors">
		<h2>6. ذیلی پراسیسرز</h2>
		<p>ہم آپ کا ذاتی ڈیٹا نہیں بیچتے، اور اشتہار کے لیے شیئر نہیں کرتے۔</p>
		<p>
			ہم سروس دینے کے لیے چند وینڈرز کو لگاتے ہیں۔
			سرکاری، موجودہ فہرست
			<a href="/subprocessors">/subprocessors</a> (انگریزی میں) پر ہے؛
			کسی بھی تبدیلی کے 30 دن کے اندر وہ صفحہ تازہ ہوتا ہے۔ ہم ہر ذیلی پراسیسر سے تحریری معاہدوں کے تحت ہمارے برابر تحفظ کی توقع رکھتے ہیں،
			جس میں ذاتی ڈیٹا کے EU سے باہر جانے پر EU کی معیاری معاہدہ جاتی شقیں
			شامل ہیں۔
		</p>
		<p>
			ذاتی ڈیٹا کو متاثر کرنے والے ذیلی پراسیسرز کے مادی اضافے یا تبدیلیوں کی اطلاع فعال صارفین کو پہلے سے، اعتراض کے حق کے ساتھ دی جاتی ہے۔
		</p>
	</section>
}

templ privacyTransfersUR() {
	<section id="transfers">
		<h2>7. بین الاقوامی منتقلیاں</h2>
		<p>
			ہمارے کچھ ذیلی پراسیسرز یورپی اقتصادی علاقے سے باہر، بنیادی طور پر ریاستہائے متحدہ میں، قائم ہیں۔
			ایسی ہر منتقلی کے لیے ہم نیچے کے کم از کم ایک تحفظ پر انحصار کرتے ہیں:
		</p>
		<ul>
			<li>
				<strong>EU–US ڈیٹا پرائیویسی فریم ورک</strong> —
				ان امریکی ذیلی پراسیسرز کے لیے جنہوں نے فریم ورک کی توثیق کی ہے۔ مناسبیت کا فیصلہ 2023 کے وسط سے نافذ ہے؛
				ہم اس کی حیثیت میں کسی بھی تبدیلی پر نظر رکھتے ہیں۔
			</li>
			<li>
				<strong>معیاری معاہدہ جاتی شقیں</strong> —
				ہمارے براہِ راست ذیلی پراسیسرز کے لیے ماڈیول 2 (کنٹرولر سے پراسیسر) اور جہاں زنجیری پراسیسرز لاگو ہوں وہاں ماڈیول 3 (پراسیسر سے ذیلی پراسیسر)۔ ہم کمیشن کی منظور شدہ 2021 کی معیاری معاہدہ جاتی شقیں استعمال کرتے ہیں۔
			</li>
			<li>
				<strong>تکمیلی اقدامات</strong> — جہاں خطرے کا جائزہ بتائے کہ اضافی تحفظات ضروری ہیں
				(ترسیل اور ذخیرے میں خفیہ کاری، ایکسیس لاگنگ، ڈیٹا کی کمی)۔
			</li>
		</ul>
		<p>
			کسی ذیلی پراسیسر پر لاگو مخصوص منتقلی کا آلہ آپ
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> پر ای میل کر کے مانگ سکتے ہیں۔
		</p>
		<p><strong>آپ کا ملک۔</strong> کچھ ممالک کے قوانین اس پالیسی سے زیادہ مانگتے ہیں۔ وہ جو شامل کرتے ہیں، انگریزی میں اور اس ملک کی زبان میں، <a href="/privacy/countries">آپ کا ملک</a> (انگریزی میں) پر ہے۔</p>
	</section>
}

templ privacyRetentionUR() {
	<section id="retention">
		<h2>8. برقرار رکھنا</h2>
		<p>
			ہم ذاتی ڈیٹا ان مقاصد کے مطابق سب سے کم مدت تک رکھتے ہیں جن کے لیے ہم اسے پراسیس کرتے ہیں، اور کسی بھی لاگو قانونی ذمہ داری کے مطابق۔
		</p>
		<ul>
			<li>
				<strong>اکاؤنٹ اور سائن اِن میٹا ڈیٹا</strong> —
				اکاؤنٹ حذف ہونے تک۔ tafs ایپ میں
				مالک اسے اکاؤنٹ ← <em>اکاؤنٹ حذف کریں</em> میں حذف کرتا ہے۔ ویب پر بنایا اکاؤنٹ
				<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> کو ای میل کر کے،
				GDPR آرٹیکل 12(3) کی ایک ماہ کی مدت میں حذف کیا جاتا ہے۔
				دونوں صورتوں میں، اکاؤنٹ کی کلیدیں فوراً رک جاتی ہیں۔ tafs ایپ میں حذف کرنے پر
				اسے واپس نہیں کیا جا سکتا: اس کی tafs چیٹس،
				نوٹس اور کنکشنز فوراً مٹ جاتے ہیں، اور
				KIFF جو رکھتا ہے وہ 30 دن کے اندر مٹ جاتا ہے۔ ویب پر حذف کرنے پر،
				ہم اس کا ڈیٹا 30 دن کی رعایتی مدت تک رکھتے ہیں، اگر مالک اسے واپس چاہے، پھر مٹا دیتے ہیں۔
			</li>
			<li>
				<strong>API key ریکارڈز</strong> — اکاؤنٹ حذف ہونے تک،
				key منسوخ ہونے کے بعد بھی۔ ایجنٹ سائن اِن کنکشن سے جڑی key
				اسی کنکشن کے ساتھ، اس کے ختم ہونے کے 30 دن بعد حذف کی جاتی ہے۔
			</li>
			<li>
				<strong>سیشن کوکیز</strong> — میعاد ختم ہونے تک (ڈیفالٹ 24
				گھنٹے) یا آپ کے سائن آؤٹ کرنے تک۔
			</li>
			<li>
				<strong>ریورس پراکسی ایکسیس لاگز</strong> — 90
				دن تک، پھر مجموعی کیے یا حذف کیے جاتے ہیں۔
			</li>
			<li>
				<strong>سروس لاگز</strong> — KIFF کی سروسز
				اور planque چلتے وقت جو ریکارڈ کرتے ہیں: غلطیاں اور درخواستیں،
				جن میں کسی اکاؤنٹ، شخص یا ایجنٹ کا نام ہو سکتا ہے۔ 30
				دن، پھر حذف کر دیے جاتے ہیں۔
			</li>
			<li>
				<strong>بیک اپس</strong> — KIFF کا ڈیٹا بیس روزانہ
				خفیہ کردہ بیک اپ ہوتا ہے، اور ہر بیک اپ 7 دن رکھا جاتا ہے، اس لیے
				حذف شدہ ریکارڈ ان سے 7 دن کے اندر چلا جاتا ہے۔
				tafs اور planque کے اسٹورز خفیہ کردہ پوائنٹ ان ٹائم کاپیاں 35 دن رکھتے ہیں، صرف ناکامی کے بعد
				اسٹور بحال کرنے کے لیے استعمال ہوتی ہیں، اس لیے حذف شدہ ریکارڈ
				ان سے 35 دن کے اندر چلا جاتا ہے۔
			</li>
			<li>
				<strong>ٹیننٹ آڈٹ ڈیٹا</strong> — پراسیسر کے طور پر
				صارف کی ٹیننٹ کنفیگریشن کے مطابق رکھا جاتا ہے۔ ڈیفالٹ:
				ٹیننٹ کی زندگی تک رکھا جاتا ہے؛ ٹیننٹ حذف کرنے پر حذف ہوتا ہے۔ دیکھیں:
				<a href="/security#deletion">/security#deletion</a>۔
			</li>
			<li>
				<strong>KIFF گیٹ وے سے کالز</strong> —
				کال کے دلائل اس کے بھیجے جانے، مسترد ہونے یا ناکام ہونے تک،
				پھر حذف کر دیے جاتے ہیں؛ ٹول کا نتیجہ 24 گھنٹے، پھر
				حذف کر دیا جاتا ہے۔ فیصلے کا ریکارڈ اور دلائل کا ہیش ٹیننٹ آڈٹ ڈیٹا کے طور پر رکھے جاتے ہیں۔ دیکھیں:
				<a href="/security#data-kept">/security#data-kept</a>۔
			</li>
			<li>
				<strong>استعمال</strong> — گیٹ وے سے ہر کال کے لیے،
				اس کے ختم ہونے پر: کس ایجنٹ نے کی، کون سا ٹول،
				اور وہ عمل گنا گیا یا مفت تھا (اور
				کیوں)۔ taf یا Coach کے ہر رن کے لیے، اس کے ختم ہونے پر:
				taf، کب، AI نے کتنے کریڈٹس استعمال کیے، اور وہ
				گنے گئے یا کیوں نہیں۔ اکاؤنٹ حذف ہونے تک؛ ہمارے ادائیگی پراسیسر کو بلنگ کے لیے جو بتایا جاتا ہے وہ
				بلنگ ریکارڈز کے ساتھ رکھا جاتا ہے۔
			</li>
			<li>
				<strong>ایجنٹ سائن اِن کنکشنز</strong> — کون سا
				ایجنٹ، ایپ کا نام، کس نے اجازت دی، کب، اور اس کا
				آخری استعمال: کنکشن کے فعال رہتے، پھر اس کے ختم ہونے کے 30
				دن بعد (اس دوران وہ ڈیش بورڈ میں درج رہتا ہے)، پھر اس کے ٹوکنز اور
				API key کے ساتھ حذف کر دیا جاتا ہے۔ یہ سب اکاؤنٹ کے ساتھ حذف ہو جاتا ہے۔
			</li>
			<li>
				<strong>tafs</strong> — آلے کا push ٹوکن آپ کے
				ایپ سے سائن آؤٹ کرنے، آلہ ہٹانے، یا Apple یا
				Google کے ٹوکن کے جانے کی اطلاع دینے تک۔ آلے کی عوامی کلید،
				نام، پلیٹ فارم اور تاریخیں جب تک آپ اسے استعمال کرتے ہیں؛ اسے سائن آؤٹ کرنے کے بعد،
				وہ ہٹایا ہوا نشان زد ہوتا ہے اور اکاؤنٹ حذف ہونے تک رکھا جاتا ہے، تاکہ KIFF اس سے دیر سے آیا جواب مسترد کر سکے اور دکھا سکے کہ پہلے والے پر
				کس آلے نے دستخط کیے تھے۔ Passkey کی عوامی
				کلید، id اور نام اس کے آلے کی طرح رکھے جاتے ہیں۔ کمپیوٹر اپنا سیشن
				90 دن تک، یا آپ کے سائن آؤٹ کرنے تک رکھتا ہے۔ tafs جو
				آپ کی کمپنی کے لیے رکھتا ہے وہ پراسیسر کے طور پر رکھا جاتا ہے: taf کے رن اور
				چیٹس، چیٹ کے خلاصے کے ساتھ (اور Setup کی)، 30 دن،
				آپ کے ٹولز جو لوٹاتے ہیں وہ صرف رن ختم ہونے تک (چیٹ میں،
				جو اس نے صرف پڑھا وہ اس کے اگلے پیغامات کے لیے خفیہ کردہ شکل میں رکھا جاتا ہے،
				چیٹ کے ایک گھنٹہ غیر فعال رہنے تک اور پڑھنے کے بعد زیادہ سے زیادہ چار گھنٹے تک استعمال ہوتا ہے، پھر چند دنوں کے اندر
				خود بخود مٹا دیا جاتا ہے)، اور اس کے میموری نوٹس
				taf کے ہٹائے جانے تک؛ اس کی فراہم کردہ فائلیں انہیں بنانے والے رن سے 30 دن، پھر ایک دن کے اندر خود بخود مٹا دی جاتی ہیں، یا آپ کے اکاؤنٹ کا کوئی شخص کسی کو حذف کرے تو پہلے؛ planque میں کنکشن کا ٹوکن یا key، یا Composio پر منظم کنکشن کا سائن اِن، آپ کے ڈسکنیکٹ کرنے تک (اگر آپ کا کوئی اور کنکشن اس وینڈر پر وہی اکاؤنٹ استعمال کر سکتا ہو، تو وہ اس کے بھی ڈسکنیکٹ ہونے تک غیر استعمال شدہ رکھا جاتا ہے)، اور اس کی منظوریوں کا ریکارڈ
				اکاؤنٹ ختم ہونے تک؛ دیکھیں
				<a href="/legal/dpa#annex-4">DPA کا ضمیمہ 4</a>۔
			</li>
			<li>
				<strong>بلنگ ریکارڈز</strong> — مالی سال کے
				اختتام سے 7 سال (ایسٹونیا کا اکاؤنٹنگ ایکٹ
				§12)۔
			</li>
			<li>
				<strong>App Store اور Google Play خریداریاں</strong> —
				Apple یا Google نے ہمیں ہر خریداری کے بارے میں جو بتایا
				وہ اکاؤنٹ حذف ہونے تک آپ کے اکاؤنٹ میں رہتا ہے۔ ان کی
				فروخت اور ادائیگی کی رپورٹیں، جنہیں ہم بلنگ ریکارڈز کے طور پر 7 سال رکھتے ہیں، آپ کا نام نہیں بتاتیں۔
			</li>
			<li>
				<strong>سپورٹ خط و کتابت</strong> — آخری تعامل سے 3
				سال، پھر حذف کر دی جاتی ہے۔
			</li>
		</ul>
	</section>
}

templ privacyRightsUR() {
	<section id="rights">
		<h2>9. آپ کے حقوق</h2>
		<p>
			GDPR کے تحت آپ کے ذاتی ڈیٹا کے حوالے سے آپ کے یہ حقوق ہیں:
		</p>
		<ul>
			<li><strong>رسائی</strong> (آرٹیکل 15) — اس کی تصدیق کہ ہم آپ کا ڈیٹا پراسیس کرتے ہیں یا نہیں، اور اس کی ایک کاپی۔</li>
			<li><strong>درستی</strong> (آرٹیکل 16) — غلط یا نامکمل ڈیٹا کی درستی۔</li>
			<li><strong>مٹانا</strong> (آرٹیکل 17) — آپ کے ڈیٹا کو حذف کرنا، قانونی برقرار رکھنے کے استثنا کے تابع۔</li>
			<li><strong>پابندی</strong> (آرٹیکل 18) — تنازع طے ہونے تک پراسیسنگ روکنا۔</li>
			<li><strong>منتقلی کی صلاحیت</strong> (آرٹیکل 20) — آپ کے دیے ہوئے ڈیٹا کا مشین سے پڑھا جانے والا ایکسپورٹ۔</li>
			<li><strong>اعتراض</strong> (آرٹیکل 21) — جائز مفادات پر مبنی پراسیسنگ پر؛ جب تک ہم غالب بنیاد نہ دکھا سکیں، ہم رک جاتے ہیں۔</li>
			<li><strong>رضامندی واپس لینا</strong> (آرٹیکل 7(3)) — رضامندی پر مبنی کسی بھی پراسیسنگ کے لیے، جیسے tafs ایپ میں AI (اکاؤنٹ میں، جیسا <a href="#ai-in-tafs">اوپر</a> ہے)۔ واپس لینے سے پہلے کی قانونی پراسیسنگ پر اثر نہیں پڑتا۔</li>
		</ul>
		<p>
			ان میں سے کوئی بھی حق استعمال کرنے کے لیے
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> پر ای میل کریں۔
			ہم آرٹیکل 12(3) کے مطابق بلاوجہ تاخیر کے بغیر اور زیادہ سے زیادہ ایک ماہ کے اندر جواب دیتے ہیں؛ پیچیدہ درخواستوں کے لیے ہم
			اسے دو مزید ماہ تک بڑھا سکتے ہیں
			اور ایسا کرنے پر آپ کو بتائیں گے۔
		</p>
		<h3 id="export-chats">آپ کی اپنی tafs چیٹس</h3>
		<p>
			tafs ایپ میں اکاؤنٹ ←  میری چیٹس ایکسپورٹ کریں
			ہر taf کے ساتھ، Coach سمیت، آپ کی اپنی چیٹس،
			آپ کی جوڑی ہوئی فائلوں کے نام، اور آپ کے اپنے
			نوٹس، پڑھنے کے قابل فائل اور JSON کی شکل میں ڈاؤن لوڈ کرتا ہے۔ انہیں صرف آپ
			ایکسپورٹ کر سکتے ہیں: ایڈمن یا اکاؤنٹ کا مالک نہیں کر سکتا،
			اور KIFF کا اکاؤنٹ ایکسپورٹ انہیں شامل نہیں کرتا۔
		</p>
		<h3 id="delete-account">اپنا tafs اکاؤنٹ حذف کرنا</h3>
		<p>
			tafs KIFF کی ایپ ہے۔ اپنا tafs اکاؤنٹ اور اس کا
			ڈیٹا حذف کرنے کے لیے:
		</p>
		<ol>
			<li>tafs ایپ کھولیں اور سائن اِن کریں۔</li>
			<li>اکاؤنٹ پر جائیں، پھر <em>اکاؤنٹ حذف کریں</em> پر ٹیپ کریں۔</li>
			<li>تصدیق کریں۔ اکاؤنٹ حذف کرنا واپس نہیں کیا جا سکتا۔</li>
		</ol>
		<p>
			<em>اکاؤنٹ حذف کریں</em> اسے دکھائی دیتا ہے جو کمپنی کا اکاؤنٹ حذف کر سکتا ہے،
			عموماً اس کا مالک۔ اگر آپ کو یہ نظر نہیں آتا، یا اب آپ کے پاس
			ایپ نہیں ہے، تو
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			پر اس پتے سے ای میل کریں جس سے آپ سائن اِن کرتے ہیں، اور ہم آپ کا ڈیٹا بلاوجہ تاخیر کے بغیر اور زیادہ سے زیادہ ایک ماہ کے اندر حذف کر دیتے ہیں۔
		</p>
		<p>
			کیا حذف ہوتا ہے: اکاؤنٹ کی کلیدیں فوراً رک جاتی ہیں۔ اس کے
			tafs، چیٹس، نوٹس، جوڑی ہوئی فائلیں اور کنکشنز
			فوراً مٹ جاتے ہیں، اور ان کی پوائنٹ ان ٹائم کاپیوں سے
			35 دن کے اندر۔ KIFF اکاؤنٹ کے لیے جو رکھتا ہے وہ
			30 دن کے اندر، اور اس کے بعد 7 دن کے اندر بیک اپس سے مٹا دیا جاتا ہے۔
			اکاؤنٹ کا نام بتانے والے سروس لاگز
			30 دن کے اندر چلے جاتے ہیں۔ ٹیننٹ آڈٹ ڈیٹا
			ٹیننٹ کے ساتھ حذف ہوتا ہے۔ ہر قسم کے ڈیٹا کے لیے <a href="#retention">برقرار رکھنا</a> دیکھیں۔
		</p>
		<p id="delete-data">
			اکاؤنٹ رکھ کر اپنا کچھ ڈیٹا حذف کرنے کے لیے: ایپ میں
			چیٹ حذف کریں، اور اس کے پیغامات اور جوڑی ہوئی
			فائلیں اس کے ساتھ چلی جاتی ہیں؛ taf ہٹائیں، اور اس کی چیٹس، نوٹس اور
			کنکشنز اس کے ساتھ چلے جاتے ہیں۔ کسی اور چیز کے لیے
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			پر ای میل کریں اور بتائیں کہ کیا حذف کرنا ہے۔ ہم یہ بلاوجہ تاخیر کے بغیر اور زیادہ سے زیادہ ایک ماہ کے اندر کرتے ہیں۔
		</p>
		<p>
			آپ کو نگران ادارے میں شکایت درج کرانے کا حق ہے۔ ہمارا بنیادی نگران ادارہ
			<a href="https://www.aki.ee/en" target="_blank" rel="noopener">ایسٹونیا کا ڈیٹا پروٹیکشن انسپکٹوریٹ (Andmekaitse Inspektsioon)</a> ہے۔
			آپ اپنی رہائش کے رکن ملک کے نگران ادارے میں بھی شکایت کر سکتے ہیں۔
		</p>
		<p><strong>آپ کا ملک۔</strong> کچھ ممالک کے قوانین اس پالیسی سے زیادہ مانگتے ہیں۔ وہ جو شامل کرتے ہیں، انگریزی میں اور اس ملک کی زبان میں، <a href="/privacy/countries">آپ کا ملک</a> (انگریزی میں) پر ہے۔</p>
	</section>
}

templ privacyCookiesUR() {
	<section id="cookies">
		<h2>10. کوکیز</h2>
		<p>
			ہم تین کوکیز لگاتے ہیں، تینوں بالکل ضروری، فرسٹ پارٹی،
			صرف HTTPS پر بھیجی جاتی ہیں اور صفحے کی اسکرپٹس انہیں پڑھ نہیں سکتیں۔
			EU کے ePrivacy قواعد کے تحت انہیں رضامندی کی ضرورت نہیں؛ ہم انہیں اس لیے درج کرتے ہیں کہ آپ کو ان کے ہونے کا پتہ رہے۔
			<a href="/cookies">کوکی پالیسی</a> (انگریزی میں) میں تفصیل ہے۔
		</p>
		<ul>
			<li>
				<strong><code>kiff_session</code></strong> — آپ کو
				سائن اِن رکھتی ہے۔ ایک دستخط شدہ سیشن کوکی جو آپ کی سائن اِن id، ای میل اور نام، اور ڈیش بورڈ جو اسناد آپ کے لیے استعمال کرتا ہے،
				وہ لے جاتی ہے۔ <code>.kiff.dev</code> کے لیے لگائی جاتی ہے۔ یہ 24 گھنٹے چلتی ہے،
				یا آپ کے سائن آؤٹ کرنے تک۔
			</li>
			<li>
				<strong><code>kiff_flash</code></strong> — اگلے صفحے تک
				ایک بار کا پیغام لے جاتی ہے، جیسے "آپ کی key
				بنائی گئی"۔ دستخط شدہ؛ نئی key کبھی اس میں نہیں ہوتی۔ <code>.kiff.dev</code>
				کے لیے لگائی جاتی ہے۔ اگلا صفحہ پڑھ لے تو حذف کر دی جاتی ہے،
				اور زیادہ سے زیادہ 5 منٹ۔
			</li>
			<li>
				<strong><code>kiff_cb_attempts</code></strong> — گنتی ہے کہ سائن اِن صفحہ
				کتنی بار دوبارہ لوڈ ہوا، تاکہ گھومتا سائن اِن روکا جا سکے۔ صرف اسی صفحے کو بھیجی جاتی ہے۔ یہ 5
				منٹ چلتی ہے، اور سائن اِن شروع ہونے یا کامیاب ہونے پر صاف ہو جاتی ہے۔
			</li>
		</ul>
		<p>
			ہم اینالیٹکس کوکیز، اشتہاری کوکیز یا
			کسی تیسرے فریق کے ٹریکرز کا استعمال نہیں کرتے۔ اگر ہم کبھی کوئی شامل کریں، تو کوکی لگنے سے پہلے
			رضامندی کا بینر دکھائیں گے، ePrivacy اور ٹریکنگ ٹیکنالوجیز پر EDPB کی
			2023 کی رہنمائی کے مطابق۔
		</p>
		<p>
			اگر آپ Clerk (ہمارے تصدیقی ذیلی پراسیسر) کے ذریعے سائن اِن کرتے ہیں، تو Clerk اپنے
			فرنٹ اینڈ ڈومین (<code>clerk.kiff.dev</code>) پر بھی کوکیز لگاتا ہے۔ وہ
			کوکیز Clerk کو اس کے سائن اِن بہاؤ میں آپ کو پہچاننے کے لیے ضروری ہیں اور ہماری طرح Clerk کی رازداری
			پالیسی سے بھی منظم ہیں۔ تفصیل کے لیے ذیلی پراسیسرز کی فہرست دیکھیں۔
		</p>
	</section>
}

templ privacySecurityUR() {
	<section id="security">
		<h2>11. سیکیورٹی</h2>
		<p>
			ہمارے تکنیکی اور تنظیمی سیکیورٹی اقدامات
			<a href="/security">/security</a> (انگریزی میں) پر درج ہیں۔ ان میں ڈیٹا بیس کی سطح پر ٹیننٹ کی علیحدگی،
			ترسیل میں TLS 1.2+، منظم
			فراہم کنندہ کی ڈیفالٹ سیٹنگز کے ذریعے ذخیرے میں خفیہ کاری، اور کم سے کم استحقاق
			کے اصول پر مبنی ایکسیس کنٹرول شامل ہیں۔
		</p>
		<p>
			ہم ذاتی ڈیٹا کی خلاف ورزی کی اطلاع متاثرہ صارفین کو
			غیر ضروری تاخیر کے بغیر اور تصدیق کے 72 گھنٹے کے اندر دیتے ہیں،
			GDPR کے آرٹیکل 33 کے مطابق۔ اطلاع میں خلاف ورزی کی
			نوعیت، متعلقہ ڈیٹا سبجیکٹس اور ریکارڈز کی اقسام اور تخمینی تعداد، ممکنہ
			نتائج، اور کیے گئے یا تجویز کردہ اقدامات شامل ہوتے ہیں۔
		</p>
	</section>
}

templ privacyChildrenUR() {
	<section id="children">
		<h2>12. بچے</h2>
		<p>
			KIFF Cloud ڈویلپر انفراسٹرکچر مصنوعہ ہے جو بچوں کے لیے
			نہیں ہے۔ ہم 16 سال سے کم عمر کے بچوں سے ذاتی ڈیٹا
			جان بوجھ کر جمع نہیں کرتے۔ اگر آپ کو لگتا ہے کہ کسی بچے نے ہمیں ذاتی ڈیٹا دیا ہے،
			تو <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			سے رابطہ کریں اور ہم اسے حذف کر دیں گے۔
		</p>
	</section>
}

templ privacyAutomatedUR() {
	<section id="automated">
		<h2>13. خودکار فیصلہ سازی</h2>
		<p>
			KIFF Cloud کا رن ٹائم ہمارے صارفین کے بھیجے ڈیٹا پر متعین پالیسی فیصلے کرتا ہے۔ یہ GDPR کے آرٹیکل 22 کے مفہوم میں آپ کے بارے میں ایسے فیصلے نہیں ہیں جن کا قانونی یا اسی طرح کا اہم اثر ہو؛ یہ
			صارف کے اعمال (رقم واپسیاں، آرڈرز،
			پیغامات وغیرہ) کے بارے میں فیصلے ہیں، جو صارف کی اپنی
			پالیسی کے تحت انجام پاتے ہیں۔
		</p>
		<p>
			جو صارفین اپنے آخری صارفین کو متاثر کرنے والے فیصلے کرنے کے لیے KIFF Cloud استعمال کرتے ہیں،
			وہ آرٹیکل 22 کی تعمیل کے لیے خود ذمہ دار ہیں۔ ہماری گورننس رسیدیں ان صارفین کو انسانی نگرانی دکھانے کے لیے
			ضروری آڈٹ ٹریل دینے کے لیے
			بنائی گئی ہیں، مگر وہ نگرانی فراہم کرنے کی قانونی
			ذمہ داری صارف پر ہے۔
		</p>
	</section>
}

templ privacyChangesUR() {
	<section id="changes">
		<h2>14. اس پالیسی میں تبدیلیاں</h2>
		<p>
			ہم وقتاً فوقتاً اس پالیسی کو تازہ کر سکتے ہیں۔ مادی
			تبدیلیوں کی اطلاع فعال صارفین کو ای میل سے اور اس صفحے پر کم از کم 30 دن
			ایک نمایاں بینر سے دی جاتی ہے۔
			غیر مادی تبدیلیاں نئی
			"آخری تازہ کاری" کی تاریخ کے ساتھ پوسٹ کی جاتی ہیں۔
		</p>
	</section>
}

