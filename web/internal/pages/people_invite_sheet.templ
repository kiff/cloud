package pages

import "github.com/kiff/cloud/web/internal/components"

// inviteLifetimes are the choices for when an invitation stops working.
var inviteLifetimes = []struct{ Value, Label, Hint string }{
	{"0", "The default", "90 days; 72 hours for an admin"},
	{"24", "1 day", ""},
	{"72", "3 days", ""},
	{"168", "7 days", ""},
	{"720", "30 days", ""},
}

// InviteSheet invites a person on its own full screen, one decision a
// step, as the Card sheets do: who, then what they may do and how long
// the link works. It posts to the route that sends invitations.
templ InviteSheet() {
	@components.LayoutAppThemedWithCSS("KIFF Cloud — Invite someone", "css/fonts.css", "css/app-shell.css", "css/walkthrough.css") {
		@wkFrame("/dashboard/people?tab=invite", "Step 1 of 2", 2, "1", false) {
			<form class="wk-form" method="post" action="/dashboard/people/invite" novalidate>
				<section class="wk-step" data-wk-step="1" data-wk-check="text:email" data-wk-msg="Enter their email address." aria-labelledby="wk-h1">
					<div class="wk-head">
						<h1 id="wk-h1">Who are you inviting?</h1>
						<p>KIFF emails them a link. It works once, for whoever signs in and accepts it.</p>
					</div>
					<label class="wk-field">
						<span class="wk-label">Email</span>
						<input class="wk-input" type="email" name="email" required maxlength="320" autocomplete="off" inputmode="email" placeholder="name@company.com"/>
					</label>
				</section>
				<section class="wk-step" data-wk-step="2" data-wk-check="choice:role" data-wk-msg="Choose a role." aria-labelledby="wk-h2">
					<div class="wk-head">
						<h1 id="wk-h2">What can they do?</h1>
						<p>The role decides what they can change.</p>
					</div>
					<fieldset class="wk-choices">
						<legend class="wk-sr">Role</legend>
						for _, r := range roleSummaries {
							<label class="wk-choice wk-choice-tall">
								<input type="radio" name="role" value={ r.Role } checked?={ r.Role == "approver" }/>
								<span class="wk-strong">{ components.RoleLabel(r.Role) }</span>
								<span class="wk-body">{ r.What }</span>
							</label>
						}
					</fieldset>
					<fieldset class="wk-choices">
						<legend class="wk-label">The link works for</legend>
						for _, l := range inviteLifetimes {
							<label class="wk-choice">
								<input type="radio" name="lifetime_hours" value={ l.Value } checked?={ l.Value == "0" }/>
								<span class="wk-choice-body">
									<span>{ l.Label }</span>
									if l.Hint != "" {
										<span class="wk-sub">{ l.Hint }</span>
									}
								</span>
								<span class="wk-radio" aria-hidden="true"></span>
							</label>
						}
					</fieldset>
					<aside class="wk-note">
						@wkInfoIcon()
						<span>The email address alone grants nothing. Inviting an admin needs a sign-in from the last ten minutes.</span>
					</aside>
				</section>
				@wkBar("Send invitation")
			</form>
		}
	}
}
