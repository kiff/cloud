package pages

import (
	"fmt"
	"github.com/kiff/cloud/web/internal/components"
	"github.com/kiff/cloud/web/internal/content/videos"
)

// ProofVideo opens the selected clip first, with the gallery one click away.
templ ProofVideo(c videos.Clip) {
	@components.LayoutSiteWithMeta(c.Title+" — KIFF", c.Lead, "website", "proof", "css/home.css", "css/proof-share.css") {
		<div class="k-home">
			<section class="k-hero k-video-watch">
				<p class="k-kicker"><a class="k-link" href="/proof#videos">← All proof videos</a></p>
				<h1 class="k-display">{ c.Title }</h1>
				<p class="k-sub">{ c.Lead }</p>
				if c.DurationSeconds > 0 {
					@proofShortPlayer(c)
				} else {
				<div class="k-proof-video">
					@kWindow(c.Slug) {
						if c.Language != "" {
							<video controls preload="none" playsinline crossorigin="anonymous" poster={ c.Poster() }>
								<source src={ c.Src720() } type="video/mp4" media="(min-width: 1000px)"/>
								<source src={ c.Src540() } type="video/mp4" media="(min-width: 760px)"/>
								<source src={ c.Src480() } type="video/mp4" media="(min-width: 560px)"/>
								<source src={ c.Src360() } type="video/mp4"/>
								<track kind="captions" src={ c.Captions() } srclang={ c.Language } label={ c.LanguageLabel }/>
								<a href={ templ.SafeURL(c.Src720()) }>Download the clip</a>.
							</video>
						} else {
							<video controls preload="none" playsinline poster={ c.Poster() }>
								<source src={ c.Src540() } type="video/mp4"/>
								<a href={ templ.SafeURL(c.Src540()) }>Download the clip</a>.
							</video>
						}
					}
				</div>
				}
				@proofVideoShare(c)
				<p class="k-small">{ c.Shows }</p>
				if c.DurationSeconds > 0 {
					<p class="k-small">{ c.LanguageLabel } · { fmt.Sprint(c.DurationSeconds) }s · { c.FormatLabel() } · <a href={ templ.SafeURL(c.ShortDownload()) } download>Download MP4</a> · <a href={ templ.SafeURL(c.Subtitles()) }>Subtitles</a> · <a href="/proof#capsules">All short films</a></p>
					<p class="k-small"><a class="k-link" href="/delegate">Explore the interactive version →</a></p>
				} else if c.Language != "" {
					<p class="k-small">{ c.LanguageLabel } · Download: <a href={ templ.SafeURL(c.Src360()) }>360p</a> · <a href={ templ.SafeURL(c.Src480()) }>480p</a> · <a href={ templ.SafeURL(c.Src540()) }>540p</a> · <a href={ templ.SafeURL(c.Src720()) }>720p</a> · <a href={ templ.SafeURL(c.Subtitles()) }>Subtitles</a></p>
				}
			</section>
		</div>
	}
}

templ proofShortPlayer(c videos.Clip) {
	<div class={ "k-short-player", templ.KV("k-capsule-player", c.Portrait), templ.KV("k-landscape-player", !c.Portrait) }>
		<video controls preload="none" playsinline crossorigin="anonymous" poster={ c.Poster() }>
			if c.Portrait {
				<source src={ c.SrcPortrait() } type="video/mp4"/>
			} else {
				<source src={ c.Src720() } type="video/mp4"/>
			}
			<track kind="captions" src={ c.Captions() } srclang={ c.Language } label={ c.LanguageLabel }/>
			Your browser can't play embedded video. <a href={ templ.SafeURL(c.ShortDownload()) }>Download the clip</a>.
		</video>
	</div>
}

templ proofVideoShare(c videos.Clip) {
	<nav class="k-video-share" aria-label={ "Share video: " + c.Title }>
		<span>Share</span>
		<a href={ templ.SafeURL(c.WhatsAppURL()) } target="_blank" rel="noopener noreferrer" aria-label={ "Share on WhatsApp: " + c.Title } title="Share on WhatsApp">
			<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 11.5a9 9 0 0 1-13.4 7.9L3 21l1.6-4.6A9 9 0 1 1 21 11.5Z"></path><path d="M8 7.5c-.8 1.2-.3 3 1.5 4.8s3.6 2.3 4.8 1.5l1.2-1.1-2.5-1.3-.9.9a5.7 5.7 0 0 1-2.3-2.3l.9-.9-1.3-2.5Z"></path></svg>
		</a>
		<a href={ templ.SafeURL(c.LinkedInURL()) } target="_blank" rel="noopener noreferrer" aria-label={ "Share on LinkedIn: " + c.Title } title="Share on LinkedIn">
			<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M5.2 3a2.2 2.2 0 1 0 0 4.4 2.2 2.2 0 0 0 0-4.4ZM3.4 9H7v12H3.4V9Zm5.9 0h3.5v1.6c.6-1 1.6-1.9 3.5-1.9 3.7 0 4.3 2.4 4.3 5.5V21H17v-6c0-1.4 0-3.2-2-3.2s-2.3 1.5-2.3 3.1V21H9.3V9Z"></path></svg>
		</a>
		<a href={ templ.SafeURL(c.PagePath()) } aria-label={ "Open video link: " + c.Title } title="Open video link">
			<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m10 13 4-4M8 16l-2 2a4 4 0 0 1-6-6l4-4a4 4 0 0 1 6 0M16 8l2-2a4 4 0 0 1 6 6l-4 4a4 4 0 0 1-6 0" transform="translate(2 0) scale(.85)"></path></svg>
		</a>
	</nav>
}
