package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// TermsVI is KIFF's terms (/terms) in Vietnamese, at /vi/terms.
// It is a translation of Terms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Vietnamese has the legal
// texts only, so a link to any other page goes to English and says so.
templ TermsVI() {
	@components.LayoutSite("KIFF — terms of service", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@termsHeadVI()
			@termsDefinitionsVI()
			@termsAgreementVI()
			@termsServiceVI()
			@termsTafsVI()
			@termsAccountVI()
			@termsAcceptableUseVI()
			@termsCustomerDataVI()
			@termsConfidentialityVI()
			@termsFeesVI()
			@termsTermVI()
			@termsWarrantiesVI()
			@termsDisclaimerVI()
			@termsLiabilityVI()
			@termsIndemnityVI()
			@termsSLAVI()
			@termsServiceModsVI()
			@termsTermsModsVI()
			@termsForceMajeureVI()
			@termsGoverningLawVI()
			@termsGeneralVI()
			@termsContactVI()
		</article>
	}
}

templ termsHeadVI() {
	<header class="legal-head">
		<p class="legal-badge">Điều khoản dịch vụ · v0.1</p>
		<h1>Điều khoản dịch vụ</h1>
		<p class="legal-meta">
			<strong>Cập nhật lần cuối:</strong> 21 tháng mười một năm 2026. <strong>Ngày có hiệu lực:</strong> 24 tháng Năm năm 2026.
		</p>
		<p class="legal-disclaimer">
			<strong>Điều gì đã thay đổi:</strong> hợp đồng của bạn là với ai khi một doanh nghiệp khác giới thiệu bạn (§2), và các doanh nghiệp siêu nhỏ (§8). Trước đó: ai được dùng Dịch vụ, theo khu vực, quyền sở hữu và lệnh trừng phạt (§4); ứng dụng tafs trên Android, và Solo mua qua Google Play (§1, §8). Trước nữa: các gói trả phí (§3A, §8), <a href="/legal/sla">thỏa thuận mức dịch vụ</a> (bằng tiếng Anh) (§14), và danh sách các mục đích sử dụng bị cấm, nay nằm trong <a href="/acceptable-use">Chính sách sử dụng được chấp nhận</a> (bằng tiếng Anh) (§5).
		</p>
		<p class="legal-disclaimer">
			Các điều khoản này điều chỉnh việc sử dụng KIFF Cloud, gồm cả tafs. Câu hỏi về hợp đồng: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</header>
}

templ termsDefinitionsVI() {
	<section id="definitions">
		<h2>1. Định nghĩa</h2>
		<ul>
			<li><strong>“Kiff Agents OÜ”</strong>, <strong>“chúng tôi”</strong>, <strong>“chúng ta”</strong>, <strong>“của chúng tôi”</strong> — công ty trách nhiệm hữu hạn tư nhân Estonia cung cấp Dịch vụ. Mã đăng ký 17372313.</li>
			<li><strong>“Khách hàng”</strong>, <strong>“bạn”</strong>, <strong>“của bạn”</strong> — cá nhân hoặc pháp nhân đồng ý với các điều khoản này.</li>
			<li><strong>“Người dùng”</strong> — bất kỳ cá nhân nào Khách hàng ủy quyền truy cập Dịch vụ qua tài khoản của Khách hàng.</li>
			<li><strong>“Dịch vụ”</strong> — sản phẩm KIFF Cloud, gồm <code>api.kiff.dev</code>, <code>app.kiff.dev</code>, <code>kiff.dev</code>, tafs, cùng tài liệu, bảng điều khiển và API chúng tôi công bố tại đó.</li>
			<li><strong>“tafs”</strong> — ứng dụng tafs trên iPhone, iPad, Android và máy tính (Mac, Windows và Linux) và dịch vụ đằng sau nó, gồm Setup và planque (§3A), trong đó một Khách hàng giao việc cho một tác nhân AI làm việc bên trong các KIFF Card. Một <strong>“taf”</strong> là một tác nhân như vậy.</li>
			<li><strong>“Tenant”</strong> — một không gian làm việc được cô lập về mặt logic trong Dịch vụ, thuộc về một Khách hàng duy nhất.</li>
			<li><strong>“Dữ liệu kiểm toán”</strong> — các sự kiện, quyết định, hành động, phê duyệt và biên nhận mà Dịch vụ lưu trữ thay mặt Khách hàng qua môi trường chạy.</li>
			<li><strong>“Dữ liệu tafs”</strong> — những gì tafs lưu giữ thay mặt Khách hàng: các lần chạy và cuộc trò chuyện của mỗi taf (gồm những gì các công cụ đã kết nối của Khách hàng trả về cho nó), báo cáo, ghi chú bộ nhớ của nó, và các điện thoại đã đăng ký nhận thông báo của nó.</li>
			<li><strong>“Biên nhận”</strong> — một bản ghi quyết định có chữ ký, có phiên bản, do Dịch vụ phát ra cho mỗi hành động được quản trị.</li>
			<li><strong>“Tài liệu”</strong> — tài liệu kỹ thuật của Dịch vụ và các biện pháp bảo mật trong bản sửa đổi có ghi ngày được liên kết từ các Điều khoản này (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>). Không bao gồm sách trắng chiến lược, tài liệu tiếp thị và tài liệu của khung mã nguồn mở được cấp phép riêng.</li>
			<li><strong>“DPA”</strong> — Thỏa thuận xử lý dữ liệu tại <a href="/legal/dpa">/legal/dpa</a> (bằng tiếng Anh), điều chỉnh mối quan hệ phía bên xử lý của chúng tôi.</li>
		</ul>
	</section>
}

templ termsAgreementVI() {
	<section id="agreement">
		<h2>2. Thỏa thuận</h2>
		<p>
			Các điều khoản này điều chỉnh việc bạn sử dụng Dịch vụ. Khi tạo tài khoản, tạo khóa API hoặc sử dụng Dịch vụ theo cách khác, bạn đồng ý với các điều khoản này. Nếu bạn chấp nhận thay mặt một công ty hoặc pháp nhân khác, bạn cam đoan rằng bạn có thẩm quyền ràng buộc pháp nhân đó, và “bạn” và “của bạn” chỉ pháp nhân đó.
		</p>
		<p>
			Nếu một nhà phát triển, đối tác hoặc doanh nghiệp khác giới thiệu bạn đến KIFF hoặc xây dựng tác nhân bạn dùng, hợp đồng của bạn về Dịch vụ là trực tiếp với chúng tôi, theo các điều khoản này, và chính bạn chấp nhận chúng. Doanh nghiệp đó không phải đại lý của chúng tôi: nó không thể chấp nhận các điều khoản này, đưa ra sự đồng ý hay phê duyệt một khoản thanh toán thay bạn, và nó không bán Dịch vụ cho chúng tôi.
		</p>
		<p>
			Chúng tôi có thể công bố các điều khoản bổ sung cho các tính năng cụ thể (tính năng beta, tích hợp bên thứ ba). Khi chúng mâu thuẫn với các điều khoản này, các điều khoản bổ sung được ưu tiên cho tính năng cụ thể đó.
		</p>
	</section>
}

templ termsServiceVI() {
	<section id="service">
		<h2>3. Dịch vụ</h2>
		<p>
			KIFF Cloud là một dịch vụ lưu trữ để quản trị các hành động được ủy quyền. Nó đánh giá các yêu cầu theo các quyền và Card đã cấu hình của Khách hàng, có thể yêu cầu sự phê duyệt của con người, và ghi lại các quyết định quản trị. Tùy theo tích hợp đã cấu hình, KIFF chuyển tiếp một yêu cầu được ủy quyền hoặc cung cấp sự ủy quyền mà hệ thống được bảo vệ xác minh. Hệ thống được kết nối thực hiện hành động bên dưới.
		</p>
		<p>
			Hành vi kỹ thuật áp dụng, bằng chứng, yêu cầu tích hợp và giới hạn thực thi được nêu trong Tài liệu có ghi ngày được liên kết từ các Điều khoản này. <a href="/whitepaper">Sách trắng</a> (bằng tiếng Anh) chiến lược giải thích các nguyên tắc và mô hình của KIFF; nó không được đưa vào làm Tài liệu kỹ thuật theo các Điều khoản này.
		</p>
		<p>
			Dịch vụ quản trị của KIFF Cloud <em>không</em> phải là một khung tác nhân, một công cụ quy trình làm việc, một cổng mô hình hay một nền tảng tác nhân được quản lý. Nó kết hợp với bất cứ thứ gì bạn đã dùng. Xem <a href="/#not">“KIFF không phải là gì”</a> (bằng tiếng Anh) trên trang chủ để biết danh sách cụ thể. tafs là phần duy nhất của Dịch vụ chạy các tác nhân cho bạn, bên trong các Card bạn phát hành; §3A mô tả nó.
		</p>
		<p>
			Khung mã nguồn mở <a href="https://github.com/kiff/kiff" target="_blank" rel="noopener">kiff/kiff</a> được điều chỉnh bởi giấy phép MIT riêng của nó và nằm ngoài các điều khoản này. Khi bạn chạy khung đó trên hạ tầng của chính bạn, không có hợp đồng nào với Kiff Agents OÜ được tạo ra.
		</p>
	</section>
}

templ termsTafsVI() {
	<section id="tafs">
		<h2>3A. tafs</h2>
		<p>
			Trong tafs, bạn giao một công việc (ví dụ hoàn tiền, thanh toán hóa đơn hoặc khiếu nại thẻ) cho một taf: một tác nhân AI làm việc theo lịch với các công cụ bạn kết nối, bên trong các KIFF Card bạn phát hành cho nó. Mỗi taf chạy trên môi trường chạy tác nhân của chúng tôi, và Anthropic cung cấp mô hình AI nó dùng. Bạn trả lời các lệnh gọi bị giữ của nó trong ứng dụng tafs.
		</p>
		<p>
			<strong>Kết nối các công cụ của bạn.</strong> Setup, một tác nhân AI trong tafs chạy như một taf, giúp bạn kết nối một công cụ và thiết lập một taf cho một công việc. Nó không tự kết nối gì. Bạn đăng nhập tại nhà cung cấp của chính công cụ đó (ví dụ Stripe), và phê duyệt trên thiết bị của bạn từng kết nối, các công cụ một taf được dùng, và Card của nó. Mã thông báo từ lần đăng nhập đó do planque, dịch vụ kết nối của chúng tôi, giữ. Nó được mã hóa, chỉ dùng để thực hiện một lệnh gọi mà KIFF đã quyết định, và không bao giờ được đưa cho một taf. Ngắt một công cụ sẽ thu hồi mã thông báo tại nhà cung cấp và xóa nó.
		</p>
		<p>
			<strong>Card của bạn là chỉ dẫn của bạn.</strong> Một taf chỉ tiếp cận công cụ của bạn qua KIFF, nơi kiểm tra mọi lệnh gọi theo các Card của taf đó trước khi gửi. Một lệnh gọi nằm trong một Card bạn đã phát hành được thực hiện theo chỉ dẫn của bạn. Một lệnh gọi nằm ngoài một Card bị giữ lại hoặc bị từ chối, như Card quy định. Một lệnh gọi bị giữ chỉ được thực hiện sau khi người mà tài khoản của bạn cho phép trả lời lệnh gọi bị giữ phê duyệt. Trong ứng dụng tafs, câu trả lời mang một chữ ký từ thiết bị của họ mà KIFF xác minh, và biên nhận giữ bằng chứng đó. Tài khoản của bạn cũng có thể trả lời ngay trong KIFF (bảng điều khiển, công cụ dòng lệnh của nó, hoặc một người phê duyệt bạn ủy quyền ở đó); biên nhận khi đó ghi lại ai đã trả lời và bằng cách nào.
		</p>
		<p>
			<strong>Thanh toán.</strong> Khi một taf thanh toán thay bạn tại trang thanh toán của một trang web, bằng thẻ hoặc phương thức thanh toán khác mà bạn đã lưu trên trang đó, nó chỉ làm vậy trong một Card và sau khi bạn phê duyệt khoản thanh toán đó trên điện thoại. Sự phê duyệt của bạn ủy quyền cho đúng một khoản thanh toán đó thay mặt bạn. Trang web và nhà cung cấp thanh toán của nó xử lý khoản thanh toán. KIFF và planque không bao giờ giữ tiền của bạn, không bao giờ lưu thông tin thẻ của bạn, và một taf không bao giờ gõ số thẻ.
		</p>
		<p>
			<strong>Những gì ở lại với bạn.</strong> Bạn chọn công việc và Card của từng taf, trả lời các lệnh gọi bị giữ của nó, và đảm bảo bạn được phép dùng các công cụ và tài khoản bạn kết nối. Báo cáo, tin nhắn và ghi chú bộ nhớ của một taf do một mô hình AI viết và có thể sai; hãy kiểm tra điều quan trọng trước khi dựa vào nó.
		</p>
		<p>
			<strong>Dừng một taf.</strong> Bạn có thể dừng một taf hoặc tất cả, tạm dừng một taf, thu hồi bất kỳ Card nào của nó, hoặc gỡ bỏ nó. Từ lúc bạn dừng một taf hoặc thu hồi một Card, KIFF không cho phép lệnh gọi mới nào theo đó. Ứng dụng tafs chỉ hiển thị một taf là đã dừng khi cả KIFF và planque đã xác nhận việc dừng; từ đó planque không gửi lệnh gọi nào của nó, kể cả lệnh gọi KIFF vừa cho phép ngay trước đó. Một yêu cầu đã gửi đến nhà cung cấp của một công cụ vẫn có thể hoàn tất: chúng tôi dừng các lệnh gọi mới, và không thể hoàn tác những gì nhà cung cấp đã làm. Một công cụ tự kiểm tra các giấy phép của KIFF, không qua planque, vẫn có thể chấp nhận một giấy phép KIFF vừa cấp ngay trước đó, tối đa 90 giây. Tiếp tục một taf đã dừng cần sự phê duyệt của bạn trên thiết bị của bạn, và không có gì bị giữ hay xếp hàng trước khi dừng được chạy sau đó.
		</p>
		<p>
			<strong>Gỡ một taf</strong> dừng lịch của nó và xóa các lần chạy, cuộc trò chuyện, bộ nhớ và khóa nó đã dùng. Ngay cả trước đó, những gì công cụ của bạn trả về cho một taf chỉ được giữ cho đến khi lần chạy của nó kết thúc (những gì một cuộc trò chuyện chỉ đọc, được mã hóa, cho các tin nhắn tiếp theo của nó: dùng tối đa bốn giờ, rồi xóa), và các lần chạy cùng cuộc trò chuyện của nó trong 30 ngày. KIFF giữ các biên nhận về những gì nó đã làm.
		</p>
		<p>
			<strong>Đạo luật AI của EU.</strong> Với tafs, Kiff Agents OÜ là nhà cung cấp hệ thống AI và bạn là bên triển khai (deployer). Chúng tôi bảo đảm bất cứ điều gì một taf viết cho người ngoài công ty bạn đều nói rằng một tác nhân AI đã viết. Bạn chỉ dùng tafs cho những công việc nó cung cấp, và không dùng cho bất kỳ mục đích nào mà Đạo luật AI cấm hoặc xếp vào rủi ro cao, chẳng hạn các quyết định về việc làm, tín dụng hoặc khả năng tiếp cận dịch vụ thiết yếu của một người. Bạn giữ các phê duyệt của con người mà các Card của bạn yêu cầu, và bảo đảm những người dùng tafs cho bạn hiểu nó làm gì và các giới hạn của nó.
		</p>
		<p>
			<strong>Chi phí.</strong> tafs là một phần của gói KIFF của bạn (§8): mỗi lần chạy của một taf dùng tín dụng cho phần AI nó đã dùng. Coach, và việc thiết lập taf, được bao gồm trong mức sử dụng hợp lý của Coach.
		</p>
	</section>
}

templ termsAccountVI() {
	<section id="account">
		<h2>4. Tài khoản và quyền truy cập</h2>
		<p>
			Để dùng Dịch vụ, bạn phải tạo một tài khoản. Bạn đồng ý cung cấp thông tin đăng ký chính xác, giữ bí mật thông tin đăng nhập của bạn, và chịu trách nhiệm cho mọi hoạt động dưới tài khoản của bạn.
		</p>
		<p>
			Bạn phải từ 16 tuổi trở lên, hoặc đủ tuổi đồng ý kỹ thuật số tại nơi bạn thuộc thẩm quyền, tùy mức nào cao hơn. Dịch vụ không hướng đến trẻ em.
		</p>
		<p>
			Dịch vụ chỉ được cung cấp tại các quốc gia và khu vực mà Anthropic, đơn vị cung cấp mô hình AI của nó, cung cấp dịch vụ của chính mình, như <a href="https://www.anthropic.com/supported-countries">Anthropic liệt kê</a>. Bạn không được dùng nó từ nơi nào khác. Một công ty không được dùng nó nếu có trụ sở chính tại, hoặc do một công ty có trụ sở chính tại, một quốc gia hoặc khu vực ngoài danh sách đó sở hữu đa số hoặc kiểm soát, dù người dùng của nó ở đâu. Bạn cũng không được dùng nếu bạn, hoặc công ty bạn dùng cho, bị Liên minh châu Âu, Liên Hợp Quốc hoặc Hoa Kỳ trừng phạt. Chúng tôi từ chối các tài khoản vi phạm quy tắc này và có thể tạm ngưng tài khoản đã vi phạm.
		</p>
		<p>
			Bạn chịu trách nhiệm về hành động của mọi Người dùng bạn ủy quyền trên tài khoản của bạn. Chúng tôi có thể tạm ngưng một tài khoản hoặc thu hồi quyền truy cập với thông báo hợp lý nếu phát hiện vi phạm đáng tin cậy các điều khoản này. Với các vi phạm Sử dụng được chấp nhận (xem §5), việc tạm ngưng có thể diễn ra ngay lập tức.
		</p>
	</section>
}

templ termsAcceptableUseVI() {
	<section id="acceptable-use">
		<h2>5. Sử dụng được chấp nhận</h2>
		<p>
			Bạn, người dùng của bạn và các tác nhân của bạn phải tuân theo <a href="/acceptable-use">Chính sách sử dụng được chấp nhận</a> (bằng tiếng Anh). Nó là một phần của các điều khoản này và liệt kê những gì không được dùng Dịch vụ để làm.
		</p>
		<p>
			Chúng tôi có thể tạm ngưng ngay lập tức khi có vi phạm AUP đáng tin cậy. Chúng tôi không có nghĩa vụ giám sát nội dung của Khách hàng nhưng có thể hành động dựa trên các báo cáo đáng tin cậy.
		</p>
	</section>
}

templ termsCustomerDataVI() {
	<section id="customer-data">
		<h2>6. Dữ liệu và nội dung của Khách hàng</h2>
		<p>
			Bạn sở hữu Dữ liệu kiểm toán của bạn. Bạn cấp cho Kiff Agents OÜ giấy phép giới hạn, không độc quyền, miễn phí bản quyền, trên toàn thế giới để lưu trữ, sao chép, truyền, hiển thị và xử lý Dữ liệu kiểm toán của bạn theo cách khác chỉ trong phạm vi cần thiết để vận hành, duy trì và cải thiện Dịch vụ cho bạn.
		</p>
		<p>
			Chúng tôi hành động với tư cách <strong>bên xử lý</strong> đối với Dữ liệu kiểm toán và Dữ liệu tafs của bạn theo Điều 28 GDPR; <a href="/legal/dpa">DPA</a> (bằng tiếng Anh) điều chỉnh mối quan hệ đó một cách chi tiết. Chúng tôi hành động với tư cách <strong>bên kiểm soát</strong> đối với siêu dữ liệu tài khoản của bạn; <a href="/vi/privacy">chính sách quyền riêng tư</a> điều chỉnh mối quan hệ đó.
		</p>
		<p>
			Bạn cam đoan rằng bạn có mọi quyền cần thiết để gửi dữ liệu bạn gửi, và việc gửi tuân thủ luật hiện hành (gồm luật bảo vệ dữ liệu và, khi áp dụng, Đạo luật AI của EU).
		</p>
	</section>
}

templ termsConfidentialityVI() {
	<section id="confidentiality">
		<h2>7. Bảo mật thông tin</h2>
		<p>
			Mỗi bên có thể nhận thông tin không công khai từ bên kia (“Thông tin mật”). Bên nhận sẽ chỉ dùng Thông tin mật trong phạm vi cần thiết để thực hiện nghĩa vụ và thực thi quyền của mình theo các điều khoản này, và sẽ bảo vệ nó với mức độ cẩn trọng ít nhất bằng mức nó dùng cho thông tin mật của chính mình.
		</p>
		<p>
			Thông tin mật không bao gồm thông tin (a) đang hoặc trở nên công khai mà không có vi phạm, (b) đã được bên nhận biết trước khi tiết lộ, (c) được phát triển độc lập mà không dùng Thông tin mật, hoặc (d) phải được tiết lộ theo luật (kèm thông báo cho bên kia khi được phép).
		</p>
	</section>
}

templ termsFeesVI() {
	<section id="fees">
		<h2>8. Phí và thanh toán</h2>
		<p>
			<strong>Các gói.</strong> Mỗi tài khoản có một gói. Giá hiện hành có trên <a href="/pricing">trang giá</a> (bằng tiếng Anh); tại thời điểm cập nhật này:
		</p>
		<ul>
			<li><strong>Solo:</strong> một người, cho tafs, bán trong ứng dụng tafs qua App Store hoặc Google Play với giá 12,50 € mỗi tháng, đã gồm VAT, kèm 500 tín dụng mỗi tháng.</li>
			<li><strong>Company:</strong> 10,50 € mỗi tháng cho mỗi chỗ, kèm 500 tín dụng mỗi tháng cho mỗi chỗ, dùng chung, và, cho các lệnh gọi của chính các tác nhân của bạn qua KIFF Cloud, 500 hành động mỗi tháng cho mỗi chỗ, dùng chung.</li>
			<li><strong>Một thỏa thuận:</strong> các khoản phí và điều khoản trong đơn đặt hàng của nó.</li>
		</ul>
		<p>
			Chỗ là các quản trị viên và biên tập viên của một tài khoản. Người phê duyệt và người xem miễn phí ở mọi gói. Ở Company, vượt quá phần đã bao gồm, một tín dụng giá 0,01 € và một hành động 0,02 €. Các tín dụng vượt phần đã bao gồm được tính phí đến giới hạn chi tiêu hằng tháng mà tài khoản đặt (50 € khi bắt đầu): tại giới hạn, KIFF không bắt đầu lần chạy mới nào của các taf của tài khoản cho đến khi kỳ tiếp theo bắt đầu, hoặc người quản lý thanh toán nâng giới hạn.
		</p>
		<p>
			<strong>Gói tín dụng.</strong> Ở Solo, các tín dụng vượt phần đã bao gồm của tháng đến từ các gói tín dụng, mua trong ứng dụng tafs. Một gói được mua một lần, không hết hạn, và không phải là gói đăng ký; tín dụng của nó được dùng sau phần đã bao gồm của tháng, gói cũ nhất trước. Một gói có khoản thanh toán được hoàn đầy đủ sẽ bị thu hồi, cùng số tín dụng còn lại. Khi tín dụng của tháng và các gói đã dùng hết, KIFF không bắt đầu lần chạy mới nào của các taf của tài khoản cho đến khi kỳ tiếp theo bắt đầu hoặc một gói được thêm. Các tín dụng thưởng KIFF thêm vào một tài khoản cũng không hết hạn, như các gói.
		</p>
		<p>
			<strong>Những gì được tính.</strong> Một <em>tín dụng</em> trả cho phần AI mà lần chạy của một taf đã dùng, theo tín dụng nguyên, làm tròn lên một lần mỗi lần chạy và tính một lần, khi lần chạy kết thúc. Một lần chạy có lệnh gọi bị KIFF từ chối vẫn đã dùng AI của nó. Không bao giờ được tính: Coach, và việc thiết lập taf, trong mức sử dụng hợp lý của Coach; bản chạy thử một phiên bản mới, không gửi gì; và một lần chạy thất bại về phía chúng tôi. Một <em>hành động</em> là một lệnh gọi của chính tác nhân của bạn qua KIFF Cloud đã hoàn thành được việc: KIFF cho phép, nó được gửi, và công cụ báo thành công. Không bao giờ được tính là hành động: một lệnh gọi bị từ chối, bị giữ rồi bị từ chối, bị chặn bởi một lệnh dừng, không hợp lệ, thất bại tại công cụ, hoặc có kết quả không rõ, và một lệnh gọi chỉ đọc.
		</p>
		<p>
			<strong>Không dùng thử.</strong> Một tài khoản trả tiền từ ngày đầu. Trước khi một gói bắt đầu, KIFF không bắt đầu lần chạy nào của các taf của nó, ngoài phần thiết lập của Coach; không có gì bị xóa.
		</p>
		<p>
			<strong>Thanh toán và hóa đơn.</strong> Một gói được tính phí ở một nơi. Một gói mua trên kiff.dev được mua, thay đổi và hủy ở đó và trong cổng thanh toán nó liên kết đến, và các khoản thanh toán của nó do Stripe xử lý. Solo mua trong ứng dụng tafs được bán qua App Store trên iPhone và iPad, hoặc Google Play trên Android, và được quản lý trong các gói đăng ký Apple hoặc gói đăng ký Google Play của bạn, theo điều khoản của cửa hàng đó về thanh toán, gia hạn và hoàn tiền. Các gói tín dụng được mua trong ứng dụng. Company được mua trên kiff.dev. Phí được tính hằng tháng trả trước; mức sử dụng vượt phần đã bao gồm được tính cùng hóa đơn tiếp theo. Thay đổi về số người áp dụng từ hóa đơn tiếp theo. Nếu một khoản thanh toán thất bại và không được khắc phục, gói kết thúc và KIFF từ chối các lệnh gọi của tài khoản cho đến khi một gói được chọn.
		</p>
		<p>
			<strong>Hủy.</strong> Bạn có thể hủy bất cứ lúc nào trong cổng thanh toán, hoặc, với Solo mua trong ứng dụng, trong các gói đăng ký Apple hoặc gói đăng ký Google Play của bạn. Gói kéo dài đến hết kỳ bạn đã trả, và không được gia hạn. Trừ khi luật yêu cầu, các khoản phí đã trả không được hoàn lại. Nếu bạn là người tiêu dùng ở EU, bạn có thể rút lui trong vòng 14 ngày kể từ khi mua mà không cần nêu lý do, và chúng tôi hoàn lại những gì bạn đã trả trừ phần cho số ngày gói đã chạy. Các giao dịch mua Solo được hoàn qua App Store hoặc Google Play, theo điều khoản của họ.
		</p>
		<p>
			<strong>Doanh nghiệp siêu nhỏ.</strong> Nếu doanh nghiệp của bạn có ít hơn 10 người và doanh thu hằng năm hoặc tổng tài sản trên bảng cân đối tối đa 2 triệu €, chúng tôi coi nó là người tiêu dùng đối với mọi quy tắc trong các điều khoản này về các khoản thanh toán bằng thẻ, gồm cả Company.
		</p>
		<p>
			<strong>VAT.</strong> Giá của Company chưa gồm VAT; Solo và các gói tín dụng được App Store hoặc Google Play bán đã gồm VAT. Kiff Agents OÜ (mã số VAT EE102924327) cộng VAT của Estonia khi áp dụng. Các giao dịch bán giữa doanh nghiệp với doanh nghiệp trong EU cho một Khách hàng ngoài Estonia có mã số VAT hợp lệ được lập hóa đơn theo cơ chế đảo ngược nghĩa vụ thuế (reverse-charge) của EU.
		</p>
		<p>
			<strong>Thay đổi.</strong> Chúng tôi thông báo bằng văn bản cho các tài khoản đang hoạt động ít nhất ba mươi ngày về việc tăng giá (§16). Việc giảm giá áp dụng từ hóa đơn tiếp theo.
		</p>
	</section>
}

templ termsTermVI() {
	<section id="term">
		<h2>9. Thời hạn và chấm dứt</h2>
		<p>
			Các điều khoản này có hiệu lực khi bạn lần đầu sử dụng Dịch vụ và tiếp tục cho đến khi bị chấm dứt.
		</p>
		<p>
			Bạn có thể chấm dứt bất cứ lúc nào bằng cách xóa tài khoản của bạn. Chúng tôi có thể chấm dứt (a) vì vi phạm nghiêm trọng không được khắc phục trong ba mươi ngày kể từ thông báo bằng văn bản, hoặc (b) ngay lập tức vì các vi phạm Sử dụng được chấp nhận hoặc các sự kiện mất khả năng thanh toán.
		</p>
		<p id="leaving">
			<strong>Rời đi, và mang dữ liệu của bạn theo.</strong> Bạn có thể xuất dữ liệu của bạn bất cứ lúc nào, ở định dạng có cấu trúc, máy đọc được: trong KIFF, Cài đặt → Dữ liệu cho một tệp JSON với tài khoản của bạn, các Card của bạn cùng mọi phiên bản, các quyết định trong Sổ ghi của bạn (10.000 quyết định mới nhất; hãy hỏi chúng tôi để có thêm), biên nhận có chữ ký cho từng quyết định KIFF đã cho phép, và thông tin chi tiết về các khóa API của bạn (không bao giờ là bản thân các khóa). Trong ứng dụng tafs, mỗi người xuất các cuộc trò chuyện, tệp và ghi chú của chính mình từ Tài khoản → Xuất cuộc trò chuyện của tôi; các cuộc trò chuyện dù sao cũng được giữ ba mươi ngày, như chính sách quyền riêng tư nói. Xóa tài khoản của bạn chấm dứt Dịch vụ ngay lập tức, vì vậy hãy xuất trước.
		</p>
		<p>
			Thay vào đó, bạn có thể rời đi bằng thông báo, để chuyển sang một nhà cung cấp khác hoặc sang hệ thống của riêng bạn, bằng cách viết thư đến <a href="mailto:support@kiff.dev">support@kiff.dev</a>. Chúng tôi không bao giờ yêu cầu thông báo trước quá hai tháng: thông báo của bạn có hiệu lực vào ngày bạn chọn, chậm nhất hai tháng sau khi bạn gửi. Từ ngày đó, tiếp theo là giai đoạn chuyển tiếp ba mươi ngày, trong đó Dịch vụ tiếp tục chạy, bạn xuất dữ liệu và chuyển công việc, và chúng tôi hỗ trợ các yêu cầu hợp lý để làm việc đó. Bạn có thể gia hạn giai đoạn chuyển tiếp một lần, trong bao lâu bạn cần. Nếu chúng tôi không thể hoàn tất về mặt kỹ thuật trong ba mươi ngày, chúng tôi báo cho bạn trong vòng mười bốn ngày làm việc kể từ thông báo của bạn, kèm lý do và một khoảng thời gian mới không quá bảy tháng. Sau giai đoạn chuyển tiếp, dữ liệu của bạn vẫn có thể được xuất thêm ít nhất ba mươi ngày. Phí của gói tiếp tục như thường cho đến khi giai đoạn chuyển tiếp kết thúc. Solo mua trên App Store hoặc Google Play được hủy trong cửa hàng; các giai đoạn chuyển tiếp và xuất áp dụng theo cách tương tự.
		</p>
		<p>
			Chúng tôi không thu phí cho việc rời đi, chuyển đổi hay xuất dữ liệu của bạn. Mục này trao quyền chuyển đổi của Chương VI của Đạo luật Dữ liệu EU (Quy định (EU) 2023/2854) cho mọi khách hàng.
		</p>
		<p>
			Khi chấm dứt, và sau mọi giai đoạn chuyển tiếp và xuất, chúng tôi xóa Dữ liệu kiểm toán, Dữ liệu tafs và siêu dữ liệu tài khoản của bạn theo các quy tắc lưu giữ trong <a href="/vi/privacy#retention">chính sách quyền riêng tư</a>.
		</p>
		<p>
			Các mục theo bản chất cần còn hiệu lực sau khi chấm dứt vẫn còn hiệu lực — gồm bảo mật thông tin, sở hữu trí tuệ, bồi thường, giới hạn trách nhiệm, tuyên bố miễn trừ, luật áp dụng, và mọi khoản phí đã phát sinh.
		</p>
	</section>
}

templ termsWarrantiesVI() {
	<section id="warranties">
		<h2>10. Bảo đảm</h2>
		<p>
			Mỗi bên cam đoan rằng mình có quyền và thẩm quyền ký kết và thực hiện các điều khoản này.
		</p>
		<p>
			Chúng tôi bảo đảm sẽ cung cấp Dịch vụ một cách chuyên nghiệp và phù hợp về cơ bản với Tài liệu. Biện pháp khắc phục duy nhất của bạn khi vi phạm bảo đảm này là, theo lựa chọn của chúng tôi, thực hiện lại hoặc hoàn tiền theo tỷ lệ các khoản phí liên quan đến Dịch vụ bị ảnh hưởng trong thời gian vi phạm.
		</p>
		<p>
			Bạn bảo đảm rằng việc bạn sử dụng Dịch vụ tuân thủ luật hiện hành và các điều khoản này.
		</p>
	</section>
}

templ termsDisclaimerVI() {
	<section id="disclaimer">
		<h2>11. Tuyên bố miễn trừ</h2>
		<p>
			Ngoại trừ các bảo đảm rõ ràng trong §10, Dịch vụ được cung cấp <strong>“nguyên trạng” và “theo khả năng sẵn có”</strong>. Trong phạm vi tối đa luật cho phép, chúng tôi từ chối mọi bảo đảm khác, dù rõ ràng, ngụ ý hay theo luật định, gồm các bảo đảm về khả năng thương mại, sự phù hợp cho một mục đích cụ thể, không vi phạm, và mọi bảo đảm phát sinh từ quá trình giao dịch hoặc thông lệ thương mại.
		</p>
		<p>
			Chúng tôi không bảo đảm rằng Dịch vụ sẽ không bị gián đoạn, không có lỗi hoặc không có thành phần có hại, hoặc rằng bất kỳ dữ liệu nào sẽ không bị mất hay hỏng. Bạn chịu trách nhiệm sao lưu dữ liệu của mình.
		</p>
	</section>
}

templ termsLiabilityVI() {
	<section id="liability">
		<h2>12. Giới hạn trách nhiệm</h2>
		<p>
			Trong phạm vi tối đa luật cho phép, không bên nào chịu trách nhiệm với bên kia về bất kỳ thiệt hại gián tiếp, ngẫu nhiên, hệ quả, đặc biệt, mang tính gương mẫu hay trừng phạt nào, gồm mất lợi nhuận, mất doanh thu, mất dữ liệu hoặc gián đoạn kinh doanh, phát sinh từ hoặc liên quan đến các điều khoản này hoặc Dịch vụ, ngay cả khi đã được thông báo về khả năng xảy ra các thiệt hại đó.
		</p>
		<p>
			Tổng trách nhiệm của mỗi bên phát sinh từ hoặc liên quan đến các điều khoản này sẽ không vượt quá mức lớn hơn của (a) các khoản phí Khách hàng đã trả hoặc phải trả cho Kiff Agents OÜ trong mười hai tháng trước sự kiện làm phát sinh trách nhiệm, hoặc (b) một trăm nghìn euro (100.000 €).
		</p>
		<p>
			Không có gì trong các điều khoản này giới hạn hoặc loại trừ trách nhiệm không thể bị giới hạn hoặc loại trừ theo luật hiện hành, gồm trách nhiệm về tử vong, thương tích cá nhân do cẩu thả, gian lận hoặc cố ý sai phạm, và trách nhiệm về sản phẩm khiếm khuyết theo các luật thực thi Chỉ thị (EU) 2024/2853 về trách nhiệm đối với sản phẩm khiếm khuyết.
		</p>
	</section>
}

templ termsIndemnityVI() {
	<section id="indemnification">
		<h2>13. Bồi thường</h2>
		<p>
			Chúng tôi sẽ bảo vệ bạn trước các yêu cầu của bên thứ ba cho rằng Dịch vụ, như được chúng tôi cung cấp và bạn sử dụng theo các điều khoản này, vi phạm quyền sở hữu trí tuệ của bên thứ ba đó, và chúng tôi sẽ trả các khoản bồi thường thiệt hại được phán quyết cuối cùng đối với bạn (hoặc số tiền dàn xếp đã thỏa thuận) cho các yêu cầu đó.
		</p>
		<p>
			Bạn sẽ bảo vệ chúng tôi trước các yêu cầu của bên thứ ba phát sinh từ (a) dữ liệu hoặc nội dung Khách hàng của bạn; (b) việc bạn sử dụng Dịch vụ vi phạm các điều khoản này (gồm AUP); hoặc (c) sự cẩu thả nghiêm trọng hoặc cố ý sai phạm của bạn, và bạn sẽ trả các khoản bồi thường thiệt hại được phán quyết cuối cùng đối với chúng tôi (hoặc số tiền dàn xếp đã thỏa thuận) cho các yêu cầu đó.
		</p>
		<p>
			Việc bồi thường phụ thuộc vào thông báo kịp thời về yêu cầu, quyền kiểm soát duy nhất đối với việc bào chữa và dàn xếp thuộc về bên bồi thường, và sự hợp tác hợp lý của bên được bồi thường. Bên bồi thường không được dàn xếp một yêu cầu áp đặt nghĩa vụ lên bên được bồi thường nếu không có sự đồng ý.
		</p>
	</section>
}

templ termsSLAVI() {
	<section id="sla">
		<h2>14. Cam kết mức dịch vụ</h2>
		<p>
			Trên một gói trả phí, <a href="/legal/sla">thỏa thuận mức dịch vụ</a> (bằng tiếng Anh) nêu mức sẵn sàng chúng tôi cam kết, cách một yêu cầu chậm hoặc thất bại được tính, thời gian phản hồi hỗ trợ của chúng tôi, và các khoản tín dụng dịch vụ khi chúng tôi không đạt. Nó là một phần của các điều khoản này.
		</p>
		<p>
			Thực hành vận hành, ứng phó sự cố và cam kết thông báo vi phạm được ghi trong bản sửa đổi có ghi ngày được liên kết từ các Điều khoản này (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>); <a href="/security">/security</a> (bằng tiếng Anh) cho thấy các thực hành hiện hành.
		</p>
	</section>
}

templ termsServiceModsVI() {
	<section id="service-mods">
		<h2>15. Sửa đổi Dịch vụ</h2>
		<p>
			Chúng tôi có thể thêm, thay đổi hoặc gỡ bỏ các tính năng bất cứ lúc nào. Việc giảm đáng kể chức năng hoặc ngừng hỗ trợ một giao diện API làm hỏng hành vi đã được ghi lại được thông báo cho khách hàng đang hoạt động ít nhất ba mươi ngày trước, kèm lịch ngừng hỗ trợ được công bố. Các thay đổi vì an ninh có thể được thực hiện mà không thông báo khi chính thông báo sẽ tạo ra rủi ro.
		</p>
	</section>
}

templ termsTermsModsVI() {
	<section id="terms-mods">
		<h2>16. Sửa đổi các điều khoản này</h2>
		<p>
			Chúng tôi có thể sửa đổi các điều khoản này theo thời gian. Các thay đổi đáng kể được thông báo qua email và một biểu ngữ nổi bật trên trang này ít nhất ba mươi ngày trước. Các thay đổi không đáng kể (làm rõ, tham chiếu) được đăng với ngày “cập nhật lần cuối” mới. Việc bạn tiếp tục sử dụng Dịch vụ sau ngày có hiệu lực của một bản cập nhật là sự chấp nhận.
		</p>
	</section>
}

templ termsForceMajeureVI() {
	<section id="force-majeure">
		<h2>17. Bất khả kháng</h2>
		<p>
			Không bên nào chịu trách nhiệm về bất kỳ sự không thực hiện hay chậm trễ nào trong phạm vi do các hoàn cảnh nằm ngoài tầm kiểm soát hợp lý của mình gây ra, gồm thiên tai, chiến tranh, khủng bố, rối loạn dân sự, tranh chấp lao động, hỏa hoạn, thảm họa tự nhiên, hành động của chính phủ liên quan đến đại dịch, sự cố internet hoặc mất điện, hoặc hành động của các nhà cung cấp viễn thông hay hạ tầng lưu trữ của bên thứ ba.
		</p>
	</section>
}

templ termsGoverningLawVI() {
	<section id="governing-law">
		<h2>18. Luật áp dụng và nơi giải quyết</h2>
		<p>
			Các điều khoản này được điều chỉnh bởi pháp luật của Cộng hòa Estonia, không tính đến các quy tắc xung đột pháp luật của nó. Nơi giải quyết tranh chấp duy nhất là Tòa án quận Harju tại Tallinn.
		</p>
		<p>
			Khi bạn là người tiêu dùng cư trú tại một quốc gia thành viên EU khác, các quy định bắt buộc về bảo vệ người tiêu dùng của khu vực pháp lý nơi bạn cư trú tiếp tục áp dụng trong phạm vi chúng trao cho bạn các quyền mà bạn không thể từ bỏ bằng hợp đồng; điều khoản này không tước đi sự bảo vệ của các quy định đó.
		</p>
	</section>
}

templ termsGeneralVI() {
	<section id="general">
		<h2>19. Điều khoản chung</h2>
		<p>
			<strong>Toàn bộ thỏa thuận.</strong> Các điều khoản này, cùng chính sách quyền riêng tư, DPA, mọi đơn đặt hàng và mọi điều khoản bổ sung được đưa vào một cách rõ ràng, là toàn bộ thỏa thuận giữa chúng ta về đối tượng của chúng và thay thế mọi hiểu biết trước đó hoặc đồng thời.
		</p>
		<p>
			<strong>Tính tách rời.</strong> Nếu một điều khoản bị coi là không thể thi hành, phần còn lại vẫn có hiệu lực.
		</p>
		<p>
			<strong>Chuyển nhượng.</strong> Bạn không được chuyển nhượng các điều khoản này nếu không có sự đồng ý bằng văn bản của chúng tôi. Chúng tôi có thể chuyển nhượng mà không cần đồng ý liên quan đến sáp nhập, mua lại hoặc bán toàn bộ hoặc phần lớn tài sản của chúng tôi, kèm thông báo cho bạn.
		</p>
		<p>
			<strong>Không từ bỏ quyền.</strong> Việc không thực thi một điều khoản không phải là từ bỏ quyền thực thi nó sau này.
		</p>
		<p>
			<strong>Thông báo.</strong> Thông báo gửi Kiff Agents OÜ được gửi đến <a href="mailto:legal@kiff.dev">legal@kiff.dev</a> hoặc, bằng bưu điện, đến Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estonia. Thông báo gửi bạn được gửi đến email gắn với tài khoản của bạn hoặc, nếu bạn đã cung cấp, địa chỉ nhận thông báo pháp lý mà bạn chỉ định.
		</p>
		<p>
			<strong>Nhà thầu độc lập.</strong> Không có gì trong các điều khoản này tạo ra quan hệ đối tác, đại lý, liên doanh hay quan hệ lao động.
		</p>
		<p>
			<strong>Người thụ hưởng là bên thứ ba.</strong> Không có, trừ khi các công ty liên kết được bồi thường được nêu rõ.
		</p>
	</section>
}

templ termsContactVI() {
	<section id="contact">
		<h2>20. Liên hệ với chúng tôi</h2>
		<p>
			Câu hỏi thương mại và hợp đồng: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
		<p>
			Câu hỏi chung về sản phẩm: <a href="mailto:hello@kiff.dev">hello@kiff.dev</a>. Câu hỏi về quyền riêng tư: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>. Báo cáo lỗ hổng bảo mật: <a href="mailto:security@kiff.dev">security@kiff.dev</a>.
		</p>

		<hr/>

		<p class="legal-footnote">
			<strong>Phiên bản tài liệu:</strong> v0.1.<br/> <strong>Cập nhật lần cuối:</strong> 21 tháng mười một năm 2026.
		</p>
	</section>
}
