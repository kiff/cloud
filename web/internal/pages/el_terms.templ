package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// TermsEL is the Terms of Service (/terms) in Greek, at /el/terms. It is
// a translation of Terms: the same sections, anchors, links and figures,
// held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Greek has the
// legal texts only, so a link to any other page goes to English and says so.
templ TermsEL() {
	@components.LayoutSite("KIFF — Όροι Χρήσης", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@termsHeadEL()
			@termsDefinitionsEL()
			@termsAgreementEL()
			@termsServiceEL()
			@termsTafsEL()
			@termsAccountEL()
			@termsAcceptableUseEL()
			@termsCustomerDataEL()
			@termsConfidentialityEL()
			@termsFeesEL()
			@termsTermEL()
			@termsWarrantiesEL()
			@termsDisclaimerEL()
			@termsLiabilityEL()
			@termsIndemnityEL()
			@termsSLAEL()
			@termsServiceModsEL()
			@termsTermsModsEL()
			@termsForceMajeureEL()
			@termsGoverningLawEL()
			@termsGeneralEL()
			@termsContactEL()
		</article>
	}
}

templ termsHeadEL() {
	<header class="legal-head">
		<p class="legal-badge">Όροι Χρήσης · v0.1</p>
		<h1>Όροι Χρήσης</h1>
		<p class="legal-meta">
			<strong>Τελευταία ενημέρωση:</strong> 21 Νοεμβρίου 2026.
			<strong>Ημερομηνία έναρξης ισχύος:</strong> 24 Μαΐου 2026.
		</p>
		<p class="legal-disclaimer">
			<strong>Τι άλλαξε:</strong> με ποιον συνάπτεται η σύμβασή σας όταν σας σύστησε μια άλλη επιχείρηση (§2) και οι πολύ μικρές επιχειρήσεις (§8). Προηγουμένως: ποιος μπορεί να χρησιμοποιεί την Υπηρεσία, ανάλογα με την περιοχή, την ιδιοκτησία και τις κυρώσεις (§4)· η εφαρμογή tafs στο Android και το Solo που αγοράζεται μέσω του Google Play (§1, §8). Ακόμη νωρίτερα: τα επί πληρωμή προγράμματα (§3A, §8), η <a href="/legal/sla">συμφωνία επιπέδου υπηρεσιών</a> (στα αγγλικά) (§14) και ο κατάλογος των απαγορευμένων χρήσεων, που βρίσκεται πλέον στην <a href="/acceptable-use">Πολιτική Αποδεκτής Χρήσης</a> (στα αγγλικά) (§5).
		</p>
		<p class="legal-disclaimer">
			Οι όροι αυτοί διέπουν τη χρήση του KIFF Cloud, συμπεριλαμβανομένου του tafs. Συμβατικά ερωτήματα: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</header>
}

templ termsDefinitionsEL() {
	<section id="definitions">
		<h2>1. Ορισμοί</h2>
		<ul>
			<li><strong>«Kiff Agents OÜ»</strong>, <strong>«εμείς»</strong>, <strong>«μας»</strong> — η εσθονική εταιρεία περιορισμένης ευθύνης που παρέχει την Υπηρεσία. Αριθμός μητρώου 17372313.</li>
			<li><strong>«Πελάτης»</strong>, <strong>«εσείς»</strong>, <strong>«σας»</strong> — το φυσικό ή νομικό πρόσωπο που αποδέχεται τους παρόντες όρους.</li>
			<li><strong>«Χρήστης»</strong> — κάθε φυσικό πρόσωπο στο οποίο ο Πελάτης επιτρέπει την πρόσβαση στην Υπηρεσία μέσω του λογαριασμού του Πελάτη.</li>
			<li><strong>«Υπηρεσία»</strong> — το προϊόν KIFF Cloud, συμπεριλαμβανομένων των <code>api.kiff.dev</code>, <code>app.kiff.dev</code>, <code>kiff.dev</code>, του tafs, καθώς και της τεκμηρίωσης, των πινάκων ελέγχου και των API που δημοσιεύουμε εκεί.</li>
			<li><strong>«tafs»</strong> — η εφαρμογή tafs για iPhone, iPad, Android και υπολογιστές (Mac, Windows και Linux) και η υπηρεσία που τη στηρίζει, συμπεριλαμβανομένων του Setup και του planque (§3A), στην οποία ο Πελάτης αναθέτει μια εργασία σε έναν πράκτορα τεχνητής νοημοσύνης (AI) που εργάζεται εντός KIFF Cards. Ένα <strong>«taf»</strong> είναι ένας τέτοιος πράκτορας.</li>
			<li><strong>«Tenant»</strong> — ένας λογικά απομονωμένος χώρος εργασίας εντός της Υπηρεσίας, που ανήκει σε έναν μόνο Πελάτη.</li>
			<li><strong>«Δεδομένα Ελέγχου»</strong> — τα συμβάντα, οι αποφάσεις, οι ενέργειες, οι εγκρίσεις και οι αποδείξεις (receipts) που η Υπηρεσία αποθηκεύει για λογαριασμό του Πελάτη μέσω του runtime.</li>
			<li><strong>«Δεδομένα tafs»</strong> — ό,τι κρατά το tafs για λογαριασμό του Πελάτη: τις εκτελέσεις και τις συνομιλίες κάθε taf (συμπεριλαμβανομένων όσων του επιστρέφουν τα συνδεδεμένα εργαλεία του Πελάτη), τις αναφορές του, τις σημειώσεις μνήμης του και τα τηλέφωνα που έχουν καταχωριστεί για τις ειδοποιήσεις του.</li>
			<li><strong>«Απόδειξη»</strong> (Receipt) — ένα υπογεγραμμένο αρχείο απόφασης με έκδοση, που εκδίδει η Υπηρεσία για κάθε ενέργεια που ελέγχει.</li>
			<li><strong>«Τεκμηρίωση»</strong> — η τεχνική τεκμηρίωση της Υπηρεσίας και τα μέτρα ασφαλείας στη χρονολογημένη αναθεώρηση στην οποία παραπέμπουν οι παρόντες Όροι (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>). Δεν περιλαμβάνει τη στρατηγική λευκή βίβλο (whitepaper), το διαφημιστικό υλικό ούτε την τεκμηρίωση του πλαισίου ανοιχτού κώδικα που διατίθεται με ξεχωριστή άδεια.</li>
			<li><strong>«DPA»</strong> — η Συμφωνία Επεξεργασίας Δεδομένων στη διεύθυνση <a href="/legal/dpa">/legal/dpa</a> (στα αγγλικά), που διέπει τη σχέση μας ως εκτελούντων την επεξεργασία.</li>
		</ul>
	</section>
}

templ termsAgreementEL() {
	<section id="agreement">
		<h2>2. Η συμφωνία</h2>
		<p>
			Οι όροι αυτοί διέπουν τη χρήση της Υπηρεσίας από εσάς. Δημιουργώντας λογαριασμό, δημιουργώντας κλειδί API ή χρησιμοποιώντας με άλλο τρόπο την Υπηρεσία, αποδέχεστε τους παρόντες όρους. Αν αποδέχεστε για λογαριασμό εταιρείας ή άλλου νομικού προσώπου, δηλώνετε ότι έχετε την εξουσία να δεσμεύσετε το πρόσωπο αυτό, και τα «εσείς» και «σας» αναφέρονται σε αυτό.
		</p>
		<p>
			Αν ένας προγραμματιστής, ένας συνεργάτης ή άλλη επιχείρηση σας σύστησε στην KIFF ή δημιούργησε τον πράκτορα που χρησιμοποιείτε, η σύμβασή σας για την Υπηρεσία συνάπτεται απευθείας με εμάς, βάσει των παρόντων όρων, και τους αποδέχεστε εσείς οι ίδιοι. Η επιχείρηση αυτή δεν είναι αντιπρόσωπός μας: δεν μπορεί να αποδεχτεί τους παρόντες όρους, να δώσει συγκατάθεση ή να εγκρίνει πληρωμή για λογαριασμό σας, και δεν πωλεί την Υπηρεσία για λογαριασμό μας.
		</p>
		<p>
			Μπορούμε να δημοσιεύουμε συμπληρωματικούς όρους για συγκεκριμένες λειτουργίες (λειτουργίες beta, ενσωματώσεις τρίτων). Όπου έρχονται σε αντίθεση με τους παρόντες όρους, υπερισχύουν οι συμπληρωματικοί όροι για τη συγκεκριμένη λειτουργία.
		</p>
	</section>
}

templ termsServiceEL() {
	<section id="service">
		<h2>3. Η Υπηρεσία</h2>
		<p>
			Το KIFF Cloud είναι μια φιλοξενούμενη υπηρεσία για τον έλεγχο ενεργειών που ανατίθενται. Αξιολογεί τα αιτήματα με βάση τα δικαιώματα και τις Cards που έχει ορίσει ο Πελάτης, μπορεί να απαιτεί ανθρώπινη έγκριση και καταγράφει τις αποφάσεις ελέγχου. Ανάλογα με την ενσωμάτωση που έχει οριστεί, η KIFF προωθεί ένα εγκεκριμένο αίτημα ή παρέχει εξουσιοδότηση την οποία επαληθεύει το προστατευόμενο σύστημα. Την ίδια την ενέργεια την εκτελεί το συνδεδεμένο σύστημα.
		</p>
		<p>
			Η τεχνική συμπεριφορά, τα αποδεικτικά στοιχεία, οι απαιτήσεις ενσωμάτωσης και τα όρια εκτέλεσης που ισχύουν ορίζονται στη χρονολογημένη Τεκμηρίωση στην οποία παραπέμπουν οι παρόντες Όροι. Η στρατηγική <a href="/whitepaper">λευκή βίβλος</a> (στα αγγλικά) εξηγεί τις αρχές και το μοντέλο της KIFF· δεν ενσωματώνεται ως τεχνική Τεκμηρίωση στους παρόντες Όρους.
		</p>
		<p>
			Η υπηρεσία ελέγχου του KIFF Cloud <em>δεν</em> είναι πλαίσιο πρακτόρων, μηχανή ροών εργασίας, πύλη μοντέλων ούτε διαχειριζόμενη πλατφόρμα πρακτόρων. Συνδυάζεται με ό,τι ήδη χρησιμοποιείτε. Δείτε το <a href="/#not">«Τι δεν είναι η KIFF»</a> (στα αγγλικά) στην αρχική σελίδα για τον ρητό κατάλογο. Το tafs είναι το μόνο μέρος της Υπηρεσίας που εκτελεί πράκτορες για εσάς, εντός των Cards που εκδίδετε· το περιγράφει το §3A.
		</p>
		<p>
			Το πλαίσιο ανοιχτού κώδικα <a href="https://github.com/kiff/kiff" target="_blank" rel="noopener">kiff/kiff</a> διέπεται από τη δική του άδεια MIT και δεν εμπίπτει στους παρόντες όρους. Όταν εκτελείτε το πλαίσιο στη δική σας υποδομή, δεν δημιουργείται σύμβαση με την Kiff Agents OÜ.
		</p>
	</section>
}

templ termsTafsEL() {
	<section id="tafs">
		<h2>3A. tafs</h2>
		<p>
			Στο tafs αναθέτετε μια εργασία (για παράδειγμα επιστροφές χρημάτων, πληρωμή λογαριασμών ή αμφισβητήσεις συναλλαγών με κάρτα) σε ένα taf: έναν πράκτορα AI που εργάζεται με πρόγραμμα, με τα εργαλεία που συνδέετε, εντός των KIFF Cards που εκδίδετε γι' αυτό. Κάθε taf εκτελείται στο runtime πρακτόρων μας, και το μοντέλο AI που χρησιμοποιεί το παρέχει η Anthropic. Απαντάτε στις κλήσεις του που είναι σε αναμονή στην εφαρμογή tafs.
		</p>
		<p>
			<strong>Σύνδεση των εργαλείων σας.</strong> Το Setup, ένας πράκτορας AI στο tafs που εκτελείται όπως ένα taf, σας βοηθά να συνδέσετε ένα εργαλείο και να ρυθμίσετε ένα taf για μια εργασία. Δεν συνδέει τίποτα από μόνο του. Συνδέεστε στον πάροχο του ίδιου του εργαλείου (για παράδειγμα Stripe) και εγκρίνετε στη συσκευή σας κάθε σύνδεση, τα εργαλεία που μπορεί να χρησιμοποιεί ένα taf και τις Cards του. Το token από αυτή τη σύνδεση το κρατά το planque, η υπηρεσία συνδέσεών μας. Είναι κρυπτογραφημένο, χρησιμοποιείται μόνο για να γίνει μια κλήση που έχει αποφασίσει η KIFF και δεν δίνεται ποτέ σε taf. Η αποσύνδεση ενός εργαλείου ανακαλεί το token στον πάροχο και το διαγράφει.
		</p>
		<p>
			<strong>Οι Cards σας είναι οι εντολές σας.</strong> Ένα taf φτάνει στα εργαλεία σας μόνο μέσω της KIFF, η οποία ελέγχει κάθε κλήση με βάση τις Cards του taf πριν σταλεί. Μια κλήση εντός Card που εκδώσατε γίνεται με δική σας εντολή. Μια κλήση εκτός Card τίθεται σε αναμονή ή απορρίπτεται, όπως ορίζει η Card. Μια κλήση σε αναμονή γίνεται μόνο αφού την εγκρίνει κάποιος στον οποίο ο λογαριασμός σας επιτρέπει να απαντά σε κλήσεις σε αναμονή. Στην εφαρμογή tafs, η απάντηση φέρει υπογραφή από τη συσκευή του, την οποία επαληθεύει η KIFF, και η απόδειξη διατηρεί αυτό το τεκμήριο. Ο λογαριασμός σας μπορεί επίσης να απαντά στην ίδια την KIFF (στον πίνακα ελέγχου, στο εργαλείο γραμμής εντολών της ή μέσω ενός εγκρίνοντος που εξουσιοδοτείτε εκεί)· η απόδειξη καταγράφει τότε ποιος απάντησε και πώς.
		</p>
		<p>
			<strong>Πληρωμές.</strong> Όταν ένα taf πληρώνει για λογαριασμό σας σε μια σελίδα ολοκλήρωσης αγοράς, με κάρτα ή άλλον τρόπο πληρωμής που έχετε αποθηκεύσει στον ιστότοπο αυτό, το κάνει μόνο μέσα σε μια Card και αφού εγκρίνετε την πληρωμή αυτή στο τηλέφωνό σας. Η έγκρισή σας εξουσιοδοτεί αυτή τη μία πληρωμή εκ μέρους σας. Ο ιστότοπος και ο πάροχος πληρωμών του την επεξεργάζονται. Η KIFF και η planque δεν κατέχουν ποτέ τα χρήματά σας, δεν αποθηκεύουν ποτέ τα στοιχεία της κάρτας σας, και ένα taf δεν πληκτρολογεί ποτέ αριθμό κάρτας.
		</p>
		<p>
			<strong>Τι παραμένει σε εσάς.</strong> Εσείς επιλέγετε την εργασία και τις Cards κάθε taf, απαντάτε στις κλήσεις του που είναι σε αναμονή και διασφαλίζετε ότι έχετε δικαίωμα να χρησιμοποιείτε τα εργαλεία και τους λογαριασμούς που συνδέετε. Οι αναφορές, τα μηνύματα και οι σημειώσεις μνήμης ενός taf γράφονται από μοντέλο AI και μπορεί να είναι λανθασμένα· ελέγξτε ό,τι έχει σημασία πριν βασιστείτε σε αυτό.
		</p>
		<p>
			<strong>Διακοπή ενός taf.</strong> Μπορείτε να σταματήσετε ένα taf ή όλα, να θέσετε ένα taf σε παύση, να ανακαλέσετε οποιαδήποτε Card του ή να το αφαιρέσετε. Από τη στιγμή που σταματάτε ένα taf ή ανακαλείτε μια Card, η KIFF δεν επιτρέπει καμία νέα κλήση βάσει αυτών. Η εφαρμογή tafs δείχνει ένα taf ως σταματημένο μόνο αφού η KIFF και το planque επιβεβαιώσουν και τα δύο το σταμάτημα· από εκεί και πέρα το planque δεν στέλνει καμία από τις κλήσεις του, ούτε μια κλήση που η KIFF επέτρεψε λίγο πριν. Ένα αίτημα που έχει ήδη σταλεί στον πάροχο ενός εργαλείου μπορεί να ολοκληρωθεί: σταματάμε τις νέες κλήσεις, αλλά δεν μπορούμε να αναιρέσουμε ό,τι έχει κάνει ένας πάροχος. Ένα εργαλείο που ελέγχει το ίδιο τις άδειες (permits) της KIFF, χωρίς το planque, μπορεί να δεχτεί ακόμη μια άδεια που εξέδωσε η KIFF λίγο πριν, για το πολύ 90 δευτερόλεπτα. Η συνέχιση ενός σταματημένου taf απαιτεί την έγκρισή σας στη συσκευή σας, και τίποτα που ήταν σε αναμονή ή σε ουρά πριν από το σταμάτημα δεν εκτελείται μετά από αυτό.
		</p>
		<p>
			<strong>Η αφαίρεση ενός taf</strong> σταματά το πρόγραμμά του και διαγράφει τις εκτελέσεις, τις συνομιλίες, τη μνήμη του και το κλειδί που χρησιμοποιούσε. Ακόμη και πριν από αυτό, ό,τι επιστρέφουν τα εργαλεία σας σε ένα taf κρατιέται μόνο μέχρι να τελειώσει η εκτέλεσή του (ό,τι μια συνομιλία μόνο διάβασε, κρυπτογραφημένο, για τα επόμενα μηνύματά της: χρησιμοποιείται για το πολύ τέσσερις ώρες και μετά διαγράφεται), και οι εκτελέσεις και οι συνομιλίες του για 30 ημέρες. Η KIFF κρατά τις αποδείξεις όσων έκανε.
		</p>
		<p>
			<strong>Ο Κανονισμός της ΕΕ για την Τεχνητή Νοημοσύνη.</strong> Για το tafs, η Kiff Agents OÜ είναι ο πάροχος του συστήματος AI και εσείς ο φορέας εφαρμογής του. Διασφαλίζουμε ότι ό,τι γράφει ένα taf σε κάποιον εκτός της εταιρείας σας αναφέρει ότι το έγραψε πράκτορας AI. Χρησιμοποιείτε το tafs μόνο για τις εργασίες που προσφέρει και όχι για χρήση που ο Κανονισμός απαγορεύει ή κατατάσσει ως υψηλού κινδύνου, όπως αποφάσεις για την απασχόληση, την πίστωση ή την πρόσβαση ενός προσώπου σε βασικές υπηρεσίες. Διατηρείτε τις ανθρώπινες εγκρίσεις που απαιτούν οι Cards σας και διασφαλίζετε ότι τα πρόσωπα που χρησιμοποιούν το tafs για εσάς κατανοούν τι κάνει και ποια είναι τα όριά του.
		</p>
		<p>
			<strong>Κόστος.</strong> Το tafs αποτελεί μέρος του προγράμματος KIFF σας (§8): κάθε εκτέλεση ενός taf χρησιμοποιεί μονάδες για την AI που χρησιμοποίησε. Ο Coach και η ρύθμιση των tafs περιλαμβάνονται στο πλαίσιο της εύλογης χρήσης του Coach.
		</p>
	</section>
}

templ termsAccountEL() {
	<section id="account">
		<h2>4. Λογαριασμοί και πρόσβαση</h2>
		<p>
			Για να χρησιμοποιήσετε την Υπηρεσία πρέπει να δημιουργήσετε λογαριασμό. Συμφωνείτε να δίνετε ακριβή στοιχεία εγγραφής, να κρατάτε εμπιστευτικά τα διαπιστευτήριά σας και να είστε υπεύθυνοι για κάθε δραστηριότητα στον λογαριασμό σας.
		</p>
		<p>
			Πρέπει να είστε τουλάχιστον 16 ετών ή να έχετε την ηλικία ψηφιακής συναίνεσης της δικαιοδοσίας σας, όποια είναι μεγαλύτερη. Η Υπηρεσία δεν απευθύνεται σε παιδιά.
		</p>
		<p>
			Η Υπηρεσία προσφέρεται μόνο στις χώρες και περιοχές όπου η Anthropic, η οποία παρέχει το μοντέλο AI της Υπηρεσίας, προσφέρει τη δική της υπηρεσία, όπως <a href="https://www.anthropic.com/supported-countries">τις απαριθμεί η Anthropic</a>. Δεν επιτρέπεται να τη χρησιμοποιείτε από οπουδήποτε αλλού. Μια εταιρεία δεν επιτρέπεται να τη χρησιμοποιεί αν έχει την έδρα της σε χώρα ή περιοχή εκτός αυτού του καταλόγου ή αν ανήκει κατά πλειοψηφία σε εταιρεία με έδρα σε τέτοια χώρα ή περιοχή ή ελέγχεται από αυτήν, όπου κι αν βρίσκονται οι χρήστες της. Ούτε επιτρέπεται να τη χρησιμοποιείτε αν εσείς ή η εταιρεία για την οποία τη χρησιμοποιείτε υπόκειστε σε κυρώσεις της Ευρωπαϊκής Ένωσης, των Ηνωμένων Εθνών ή των Ηνωμένων Πολιτειών. Απορρίπτουμε λογαριασμούς που παραβιάζουν τον κανόνα αυτό και μπορούμε να αναστείλουμε λογαριασμό που τον παραβιάζει.
		</p>
		<p>
			Είστε υπεύθυνοι για τις ενέργειες κάθε Χρήστη στον οποίο δίνετε πρόσβαση στον λογαριασμό σας. Μπορούμε να αναστείλουμε έναν λογαριασμό ή να ανακαλέσουμε την πρόσβαση με εύλογη ειδοποίηση αν εντοπίσουμε αξιόπιστη παραβίαση των παρόντων όρων. Για παραβιάσεις της Πολιτικής Αποδεκτής Χρήσης (βλ. §5) η αναστολή μπορεί να είναι άμεση.
		</p>
	</section>
}

templ termsAcceptableUseEL() {
	<section id="acceptable-use">
		<h2>5. Αποδεκτή χρήση</h2>
		<p>
			Εσείς, οι χρήστες σας και οι πράκτορές σας πρέπει να τηρείτε την <a href="/acceptable-use">Πολιτική Αποδεκτής Χρήσης</a> (στα αγγλικά). Αποτελεί μέρος των παρόντων όρων και απαριθμεί για ποιους σκοπούς δεν επιτρέπεται να χρησιμοποιείται η Υπηρεσία.
		</p>
		<p>
			Μπορούμε να αναστείλουμε αμέσως σε περίπτωση αξιόπιστης παραβίασης της Πολιτικής Αποδεκτής Χρήσης. Δεν έχουμε υποχρέωση να παρακολουθούμε το περιεχόμενο του Πελάτη, αλλά μπορούμε να ενεργήσουμε βάσει αξιόπιστων αναφορών.
		</p>
	</section>
}

templ termsCustomerDataEL() {
	<section id="customer-data">
		<h2>6. Δεδομένα και περιεχόμενο του Πελάτη</h2>
		<p>
			Τα Δεδομένα Ελέγχου σας ανήκουν σε εσάς. Παραχωρείτε στην Kiff Agents OÜ περιορισμένη, μη αποκλειστική, χωρίς καταβολή δικαιωμάτων, παγκόσμια άδεια να φιλοξενεί, να αντιγράφει, να μεταδίδει, να εμφανίζει και να επεξεργάζεται με άλλο τρόπο τα Δεδομένα Ελέγχου σας αποκλειστικά στον βαθμό που είναι αναγκαίο για να λειτουργεί, να συντηρεί και να βελτιώνει την Υπηρεσία για εσάς.
		</p>
		<p>
			Ενεργούμε ως <strong>εκτελών την επεξεργασία</strong> για τα Δεδομένα Ελέγχου σας και τα Δεδομένα tafs σας βάσει του άρθρου 28 του ΓΚΠΔ· η <a href="/legal/dpa">DPA</a> (στα αγγλικά) διέπει αναλυτικά αυτή τη σχέση. Ενεργούμε ως <strong>υπεύθυνος επεξεργασίας</strong> για τα μεταδεδομένα του λογαριασμού σας· η <a href="/el/privacy">πολιτική απορρήτου</a> διέπει αυτή τη σχέση.
		</p>
		<p>
			Δηλώνετε ότι έχετε όλα τα απαραίτητα δικαιώματα για να υποβάλλετε τα δεδομένα που υποβάλλετε και ότι η υποβολή τους συμμορφώνεται με την ισχύουσα νομοθεσία (συμπεριλαμβανομένης της νομοθεσίας για την προστασία δεδομένων και, όπου ισχύει, του Κανονισμού της ΕΕ για την Τεχνητή Νοημοσύνη).
		</p>
	</section>
}

templ termsConfidentialityEL() {
	<section id="confidentiality">
		<h2>7. Εμπιστευτικότητα</h2>
		<p>
			Κάθε μέρος μπορεί να λάβει μη δημόσιες πληροφορίες από το άλλο («Εμπιστευτικές Πληροφορίες»). Το μέρος που τις λαμβάνει χρησιμοποιεί τις Εμπιστευτικές Πληροφορίες μόνο στον βαθμό που είναι αναγκαίο για να εκπληρώσει τις υποχρεώσεις του και να ασκήσει τα δικαιώματά του βάσει των παρόντων όρων, και τις προστατεύει με τουλάχιστον την ίδια επιμέλεια που χρησιμοποιεί για τις δικές του εμπιστευτικές πληροφορίες.
		</p>
		<p>
			Εμπιστευτικές Πληροφορίες δεν είναι οι πληροφορίες που (α) είναι ή γίνονται δημόσια διαθέσιμες χωρίς παραβίαση, (β) ήταν γνωστές στο μέρος που τις λαμβάνει πριν από την κοινοποίηση, (γ) αναπτύσσονται ανεξάρτητα χωρίς χρήση των Εμπιστευτικών Πληροφοριών ή (δ) πρέπει να κοινοποιηθούν βάσει νόμου (με ειδοποίηση του άλλου μέρους όπου επιτρέπεται).
		</p>
	</section>
}

templ termsFeesEL() {
	<section id="fees">
		<h2>8. Χρεώσεις και πληρωμή</h2>
		<p>
			<strong>Προγράμματα.</strong> Κάθε λογαριασμός έχει ένα πρόγραμμα. Οι τρέχουσες τιμές βρίσκονται στη <a href="/pricing">σελίδα τιμών</a> (στα αγγλικά)· κατά τον χρόνο αυτής της ενημέρωσης:
		</p>
		<ul>
			<li><strong>Solo:</strong> ένα πρόσωπο, για το tafs, πωλείται στην εφαρμογή tafs μέσω του App Store ή του Google Play προς 12,50 € τον μήνα, με ΦΠΑ, και περιλαμβάνει 500 μονάδες τον μήνα.</li>
			<li><strong>Company:</strong> 10,50 € τον μήνα για κάθε θέση, με 500 μονάδες τον μήνα για κάθε θέση, από κοινού, και, για τις κλήσεις των δικών σας πρακτόρων μέσω του KIFF Cloud, 500 ενέργειες τον μήνα για κάθε θέση, από κοινού.</li>
			<li><strong>Μια συμφωνία:</strong> οι χρεώσεις και οι όροι της εντολής αγοράς της.</li>
		</ul>
		<p>
			Θέσεις είναι οι διαχειριστές και οι συντάκτες ενός λογαριασμού. Οι εγκρίνοντες και οι θεατές είναι δωρεάν σε κάθε πρόγραμμα. Στο Company, πέραν όσων περιλαμβάνονται, μια μονάδα κοστίζει 0,01 € και μια ενέργεια 0,02 €. Οι μονάδες πέραν των περιλαμβανόμενων χρεώνονται έως το μηνιαίο όριο δαπανών που ορίζει ο λογαριασμός (50 € στην αρχή): στο όριο, η KIFF δεν ξεκινά καμία νέα εκτέλεση των tafs του λογαριασμού μέχρι να αρχίσει η επόμενη περίοδος ή να το αυξήσει κάποιος που διαχειρίζεται τη χρέωση.
		</p>
		<p>
			<strong>Πακέτα μονάδων.</strong> Στο Solo, οι μονάδες πέραν των περιλαμβανόμενων του μήνα προέρχονται από πακέτα μονάδων, που αγοράζονται στην εφαρμογή tafs. Ένα πακέτο αγοράζεται μία φορά, δεν λήγει και δεν είναι συνδρομή· οι μονάδες του χρησιμοποιούνται μετά τις περιλαμβανόμενες του μήνα, πρώτα από το παλαιότερο πακέτο. Ένα πακέτο του οποίου η πληρωμή επιστρέφεται πλήρως αφαιρείται, μαζί με τις μονάδες που του απομένουν. Όταν εξαντληθούν οι μονάδες του μήνα και τα πακέτα, η KIFF δεν ξεκινά καμία νέα εκτέλεση των tafs του λογαριασμού μέχρι να αρχίσει η επόμενη περίοδος ή να προστεθεί ένα πακέτο. Οι μονάδες μπόνους που προσθέτει η KIFF σε έναν λογαριασμό δεν λήγουν ούτε αυτές, όπως και τα πακέτα.
		</p>
		<p>
			<strong>Τι μετράει.</strong> Μια <em>μονάδα</em> πληρώνει την AI που χρησιμοποίησε η εκτέλεση ενός taf, σε ακέραιες μονάδες, με στρογγυλοποίηση προς τα πάνω μία φορά ανά εκτέλεση, και μετριέται μία φορά, όταν τελειώνει η εκτέλεση. Μια εκτέλεση της οποίας την κλήση απέρριψε η KIFF χρησιμοποίησε παρ' όλα αυτά την AI της. Δεν μετρούν ποτέ: ο Coach και η ρύθμιση των tafs, στο πλαίσιο της εύλογης χρήσης του Coach· μια δοκιμή νέας έκδοσης, που δεν στέλνει τίποτα· και μια εκτέλεση που απέτυχε από δική μας πλευρά. <em>Ενέργεια</em> είναι μια κλήση του δικού σας πράκτορα μέσω του KIFF Cloud που έφερε αποτέλεσμα: η KIFF την επέτρεψε, στάλθηκε και το εργαλείο ανέφερε επιτυχία. Δεν μετρά ποτέ ως ενέργεια: μια κλήση που απορρίφθηκε, που τέθηκε σε αναμονή και μετά απορρίφθηκε, που διακόπηκε από σταμάτημα, που ήταν άκυρη, που απέτυχε στο εργαλείο ή της οποίας το αποτέλεσμα είναι άγνωστο, καθώς και μια κλήση που μόνο διαβάζει.
		</p>
		<p>
			<strong>Χωρίς δοκιμαστική περίοδο.</strong> Ένας λογαριασμός πληρώνει από την πρώτη του ημέρα. Πριν ξεκινήσει ένα πρόγραμμα, η KIFF δεν ξεκινά καμία εκτέλεση των tafs του, εκτός από τη ρύθμιση από τον Coach· τίποτα δεν διαγράφεται.
		</p>
		<p>
			<strong>Πληρωμή και τιμολόγια.</strong> Ένα πρόγραμμα χρεώνεται σε ένα σημείο. Ένα πρόγραμμα που αγοράζεται στο kiff.dev αγοράζεται, αλλάζει και ακυρώνεται εκεί και στην πύλη χρέωσης στην οποία παραπέμπει, και οι πληρωμές του διεκπεραιώνονται από τη Stripe. Το Solo που αγοράζεται στην εφαρμογή tafs πωλείται μέσω του App Store σε iPhone και iPad ή του Google Play σε Android, και το διαχειρίζεστε στις συνδρομές σας στην Apple ή στο Google Play, σύμφωνα με τους όρους του καταστήματος αυτού για την πληρωμή, την ανανέωση και τις επιστροφές χρημάτων. Τα πακέτα μονάδων αγοράζονται στην εφαρμογή. Το Company αγοράζεται στο kiff.dev. Οι χρεώσεις τιμολογούνται μηνιαίως προκαταβολικά· η χρήση πέραν όσων περιλαμβάνονται τιμολογείται με το επόμενο τιμολόγιο. Μια αλλαγή στον αριθμό των προσώπων ισχύει από το επόμενο τιμολόγιο. Αν μια πληρωμή αποτύχει και δεν διευθετηθεί, το πρόγραμμα λήγει και η KIFF απορρίπτει τις κλήσεις του λογαριασμού μέχρι να επιλεγεί πρόγραμμα.
		</p>
		<p>
			<strong>Ακύρωση.</strong> Μπορείτε να ακυρώσετε οποιαδήποτε στιγμή στην πύλη χρέωσης ή, για το Solo που αγοράστηκε στην εφαρμογή, στις συνδρομές σας στην Apple ή στο Google Play. Το πρόγραμμα διαρκεί έως το τέλος της περιόδου που πληρώσατε και δεν ανανεώνεται. Εκτός αν ο νόμος ορίζει διαφορετικά, οι χρεώσεις που έχουν ήδη καταβληθεί δεν επιστρέφονται. Αν είστε καταναλωτής στην ΕΕ, μπορείτε να υπαναχωρήσετε εντός 14 ημερών από την αγορά χωρίς να αιτιολογήσετε την απόφασή σας, και σας επιστρέφουμε ό,τι πληρώσατε, αφαιρώντας το μέρος που αντιστοιχεί στις ημέρες που το πρόγραμμα ήταν ήδη ενεργό. Οι αγορές Solo επιστρέφονται μέσω του App Store ή του Google Play, σύμφωνα με τους όρους τους.
		</p>
		<p>
			<strong>Πολύ μικρές επιχειρήσεις.</strong> Αν η επιχείρησή σας έχει λιγότερα από 10 άτομα και ετήσιο κύκλο εργασιών ή σύνολο ισολογισμού που δεν υπερβαίνει τα 2 εκατομμύρια €, την αντιμετωπίζουμε ως καταναλωτή για κάθε κανόνα των παρόντων όρων σχετικά με πληρωμές που γίνονται με κάρτα, συμπεριλαμβανομένου του Company.
		</p>
		<p>
			<strong>ΦΠΑ.</strong> Οι τιμές του Company δεν περιλαμβάνουν ΦΠΑ· το Solo και τα πακέτα μονάδων πωλούνται από το App Store ή το Google Play με ΦΠΑ. Η Kiff Agents OÜ (αριθμός ΦΠΑ EE102924327) προσθέτει εσθονικό ΦΠΑ όπου ισχύει. Οι πωλήσεις μεταξύ επιχειρήσεων εντός ΕΕ σε Πελάτη εκτός Εσθονίας με έγκυρο αριθμό φορολογικού μητρώου ΦΠΑ τιμολογούνται με τον μηχανισμό αντίστροφης επιβάρυνσης της ΕΕ.
		</p>
		<p>
			<strong>Αλλαγές.</strong> Δίνουμε στους ενεργούς λογαριασμούς γραπτή ειδοποίηση τουλάχιστον τριάντα ημερών πριν από αύξηση τιμής (§16). Μια μείωση τιμής ισχύει από το επόμενο τιμολόγιο.
		</p>
	</section>
}

templ termsTermEL() {
	<section id="term">
		<h2>9. Διάρκεια και λύση</h2>
		<p>
			Οι όροι αυτοί τίθενται σε ισχύ όταν χρησιμοποιείτε για πρώτη φορά την Υπηρεσία και ισχύουν μέχρι να λυθούν.
		</p>
		<p>
			Μπορείτε να λύσετε τη σύμβαση οποιαδήποτε στιγμή διαγράφοντας τον λογαριασμό σας. Μπορούμε να τη λύσουμε (α) για ουσιώδη παράβαση που δεν διορθώθηκε εντός τριάντα ημερών από γραπτή ειδοποίηση ή (β) αμέσως για παραβιάσεις της Πολιτικής Αποδεκτής Χρήσης ή γεγονότα αφερεγγυότητας.
		</p>
		<p id="leaving">
			<strong>Αποχώρηση και μεταφορά των δεδομένων σας.</strong> Μπορείτε να εξαγάγετε τα δεδομένα σας οποιαδήποτε στιγμή, σε δομημένη, αναγνώσιμη από μηχανή μορφή: στην KIFF, το Settings → Data δίνει ένα αρχείο JSON με τον λογαριασμό σας, τις Cards σας με κάθε έκδοσή τους, τις αποφάσεις στο Ιστορικό σας (Record) (τις πιο πρόσφατες 10.000· ζητήστε μας περισσότερες), την υπογεγραμμένη απόδειξη καθεμιάς που επέτρεψε η KIFF και τα στοιχεία των κλειδιών API σας (ποτέ τα ίδια τα κλειδιά). Στην εφαρμογή tafs, κάθε πρόσωπο εξάγει τις δικές του συνομιλίες, αρχεία και σημειώσεις από Λογαριασμός → Εξαγωγή των συνομιλιών μου· οι συνομιλίες κρατιούνται σε κάθε περίπτωση για τριάντα ημέρες, όπως αναφέρει η πολιτική απορρήτου. Η διαγραφή του λογαριασμού σας τερματίζει αμέσως την Υπηρεσία, γι' αυτό εξαγάγετε πρώτα τα δεδομένα σας.
		</p>
		<p>
			Μπορείτε, αντί γι' αυτό, να αποχωρήσετε με ειδοποίηση, για να μεταβείτε σε άλλον πάροχο ή στα δικά σας συστήματα, γράφοντας στο <a href="mailto:support@kiff.dev">support@kiff.dev</a>. Δεν απαιτούμε ποτέ ειδοποίηση μεγαλύτερη των δύο μηνών: η ειδοποίησή σας ισχύει από την ημερομηνία που επιλέγετε, το αργότερο δύο μήνες μετά την αποστολή της. Από εκείνη την ημερομηνία ακολουθεί μεταβατική περίοδος τριάντα ημερών, κατά την οποία η Υπηρεσία συνεχίζει να λειτουργεί, εξάγετε τα δεδομένα σας και μεταφέρετε την εργασία σας, και σας βοηθάμε με εύλογα αιτήματα για τον σκοπό αυτό. Μπορείτε να παρατείνετε τη μεταβατική περίοδο μία φορά, για όσο χρειάζεστε. Αν δεν μπορούμε τεχνικά να την ολοκληρώσουμε σε τριάντα ημέρες, σας ενημερώνουμε εντός δεκατεσσάρων εργάσιμων ημερών από την ειδοποίησή σας, με τους λόγους και νέα περίοδο όχι μεγαλύτερη των επτά μηνών. Μετά τη μεταβατική περίοδο, τα δεδομένα σας παραμένουν διαθέσιμα για εξαγωγή για τουλάχιστον τριάντα ακόμη ημέρες. Οι χρεώσεις του προγράμματος συνεχίζονται κανονικά μέχρι να λήξει η μεταβατική περίοδος. Το Solo που αγοράστηκε στο App Store ή στο Google Play ακυρώνεται στο κατάστημα· οι περίοδοι μετάβασης και εξαγωγής ισχύουν με τον ίδιο τρόπο.
		</p>
		<p>
			Δεν χρεώνουμε για την αποχώρηση, τη μετάβαση ή την εξαγωγή των δεδομένων σας. Η ενότητα αυτή δίνει σε κάθε πελάτη τα δικαιώματα μετάβασης του Κεφαλαίου VI της Πράξης της ΕΕ για τα Δεδομένα (Κανονισμός (ΕΕ) 2023/2854).
		</p>
		<p>
			Με τη λύση, και μετά από κάθε περίοδο μετάβασης και εξαγωγής, διαγράφουμε τα Δεδομένα Ελέγχου σας, τα Δεδομένα tafs σας και τα μεταδεδομένα του λογαριασμού σύμφωνα με τους κανόνες διατήρησης της <a href="/el/privacy#retention">πολιτικής απορρήτου</a>.
		</p>
		<p>
			Οι ενότητες που από τη φύση τους πρέπει να επιβιώνουν της λύσης εξακολουθούν να ισχύουν, όπως η εμπιστευτικότητα, η πνευματική ιδιοκτησία, η αποζημίωση, ο περιορισμός της ευθύνης, οι αποποιήσεις, το εφαρμοστέο δίκαιο και τυχόν χρεώσεις που έχουν ήδη προκύψει.
		</p>
	</section>
}

templ termsWarrantiesEL() {
	<section id="warranties">
		<h2>10. Εγγυήσεις</h2>
		<p>
			Κάθε μέρος δηλώνει ότι έχει το δικαίωμα και την εξουσία να συνάψει και να εκτελέσει τους παρόντες όρους.
		</p>
		<p>
			Εγγυόμαστε ότι θα παρέχουμε την Υπηρεσία με επαγγελματικό τρόπο και σε ουσιαστική συμμόρφωση με την Τεκμηρίωση. Η μόνη σας θεραπεία για παραβίαση αυτής της εγγύησης είναι, κατ' επιλογή μας, η εκ νέου εκτέλεση ή η αναλογική επιστροφή των χρεώσεων που αντιστοιχούν στην Υπηρεσία που επηρεάστηκε για την περίοδο της παραβίασης.
		</p>
		<p>
			Εγγυάστε ότι η χρήση της Υπηρεσίας από εσάς συμμορφώνεται με την ισχύουσα νομοθεσία και τους παρόντες όρους.
		</p>
	</section>
}

templ termsDisclaimerEL() {
	<section id="disclaimer">
		<h2>11. Αποποίηση</h2>
		<p>
			Με εξαίρεση τις ρητές εγγυήσεις του §10, η Υπηρεσία παρέχεται <strong>«ως έχει» και «όπως είναι διαθέσιμη»</strong>. Στον μέγιστο βαθμό που επιτρέπει ο νόμος, αποποιούμαστε κάθε άλλη εγγύηση, ρητή, σιωπηρή ή εκ του νόμου, συμπεριλαμβανομένων των εγγυήσεων εμπορευσιμότητας, καταλληλότητας για συγκεκριμένο σκοπό, μη προσβολής δικαιωμάτων και κάθε εγγύησης που απορρέει από συναλλακτικά ήθη ή εμπορική συνήθεια.
		</p>
		<p>
			Δεν εγγυόμαστε ότι η Υπηρεσία θα λειτουργεί αδιάλειπτα, χωρίς σφάλματα ή χωρίς επιβλαβή στοιχεία, ούτε ότι δεν θα χαθούν ή δεν θα αλλοιωθούν δεδομένα. Είστε υπεύθυνοι για τη δημιουργία αντιγράφων ασφαλείας των δεδομένων σας.
		</p>
	</section>
}

templ termsLiabilityEL() {
	<section id="liability">
		<h2>12. Περιορισμός της ευθύνης</h2>
		<p>
			Στον μέγιστο βαθμό που επιτρέπει ο νόμος, κανένα μέρος δεν ευθύνεται έναντι του άλλου για έμμεσες, παρεπόμενες, αποθετικές, ειδικές, παραδειγματικές ή τιμωρητικές ζημίες, συμπεριλαμβανομένων των διαφυγόντων κερδών, των απολεσθέντων εσόδων, των απολεσθέντων δεδομένων ή της διακοπής της επιχειρηματικής δραστηριότητας, που προκύπτουν από ή σχετίζονται με τους παρόντες όρους ή την Υπηρεσία, ακόμη και αν είχε ενημερωθεί για την πιθανότητα τέτοιων ζημιών.
		</p>
		<p>
			Η συνολική ευθύνη κάθε μέρους που προκύπτει από ή σχετίζεται με τους παρόντες όρους δεν υπερβαίνει το μεγαλύτερο από (α) τις χρεώσεις που κατέβαλε ή οφείλει να καταβάλει ο Πελάτης στην Kiff Agents OÜ κατά τους δώδεκα μήνες πριν από το γεγονός που γεννά την ευθύνη ή (β) εκατό χιλιάδες ευρώ (100.000 €).
		</p>
		<p>
			Τίποτα στους παρόντες όρους δεν περιορίζει ούτε αποκλείει ευθύνη που δεν μπορεί να περιοριστεί ή να αποκλειστεί βάσει της ισχύουσας νομοθεσίας, συμπεριλαμβανομένης της ευθύνης για θάνατο, για σωματική βλάβη από αμέλεια, για απάτη ή για δόλο, και της ευθύνης για ελαττωματικό προϊόν βάσει των νόμων που ενσωματώνουν την Οδηγία (ΕΕ) 2024/2853 για την ευθύνη για ελαττωματικά προϊόντα.
		</p>
	</section>
}

templ termsIndemnityEL() {
	<section id="indemnification">
		<h2>13. Αποζημίωση</h2>
		<p>
			Θα σας υπερασπιστούμε έναντι αξιώσεων τρίτων ότι η Υπηρεσία, όπως την παρέχουμε και όπως τη χρησιμοποιείτε σύμφωνα με τους παρόντες όρους, προσβάλλει δικαιώματα πνευματικής ιδιοκτησίας του τρίτου, και θα καταβάλουμε τις αποζημιώσεις που επιδικάζονται τελεσίδικα εις βάρος σας (ή το ποσό συμβιβασμού που συμφωνήθηκε) για τέτοιες αξιώσεις.
		</p>
		<p>
			Θα μας υπερασπιστείτε έναντι αξιώσεων τρίτων που προκύπτουν από (α) τα δεδομένα ή το περιεχόμενό σας ως Πελάτη· (β) τη χρήση της Υπηρεσίας από εσάς κατά παράβαση των παρόντων όρων (συμπεριλαμβανομένης της Πολιτικής Αποδεκτής Χρήσης)· ή (γ) τη βαριά αμέλεια ή τον δόλο σας, και θα καταβάλετε τις αποζημιώσεις που επιδικάζονται τελεσίδικα εις βάρος μας (ή το ποσό συμβιβασμού που συμφωνήθηκε) για τέτοιες αξιώσεις.
		</p>
		<p>
			Η αποζημίωση προϋποθέτει άμεση ειδοποίηση για την αξίωση, αποκλειστικό έλεγχο της υπεράσπισης και του συμβιβασμού από το μέρος που αποζημιώνει και εύλογη συνεργασία από το μέρος που αποζημιώνεται. Το μέρος που αποζημιώνει δεν μπορεί να συμβιβάσει αξίωση που επιβάλλει υποχρεώσεις στο μέρος που αποζημιώνεται χωρίς τη συναίνεσή του.
		</p>
	</section>
}

templ termsSLAEL() {
	<section id="sla">
		<h2>14. Δέσμευση επιπέδου υπηρεσιών</h2>
		<p>
			Σε επί πληρωμή πρόγραμμα, η <a href="/legal/sla">συμφωνία επιπέδου υπηρεσιών</a> (στα αγγλικά) ορίζει τη διαθεσιμότητα στην οποία δεσμευόμαστε, πώς μετράει ένα αργό ή αποτυχημένο αίτημα, τους χρόνους απόκρισης της υποστήριξής μας και τις πιστώσεις υπηρεσιών όταν υστερούμε. Αποτελεί μέρος των παρόντων όρων.
		</p>
		<p>
			Οι λειτουργικές πρακτικές, η αντιμετώπιση περιστατικών και οι δεσμεύσεις για την ειδοποίηση παραβιάσεων περιγράφονται στη χρονολογημένη αναθεώρηση στην οποία παραπέμπουν οι παρόντες Όροι (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>)· η σελίδα <a href="/security">/security</a> (στα αγγλικά) δείχνει τις τρέχουσες πρακτικές.
		</p>
	</section>
}

templ termsServiceModsEL() {
	<section id="service-mods">
		<h2>15. Αλλαγές στην Υπηρεσία</h2>
		<p>
			Μπορούμε να προσθέτουμε, να αλλάζουμε ή να αφαιρούμε λειτουργίες οποιαδήποτε στιγμή. Οι ουσιώδεις μειώσεις λειτουργικότητας ή η κατάργηση ενός API που καταστρέφει τεκμηριωμένη συμπεριφορά γνωστοποιούνται στους ενεργούς πελάτες τουλάχιστον τριάντα ημέρες νωρίτερα, με δημοσιευμένο χρονοδιάγραμμα κατάργησης. Αλλαγές για λόγους ασφαλείας μπορούν να γίνονται χωρίς ειδοποίηση όπου η ίδια η ειδοποίηση θα δημιουργούσε κίνδυνο.
		</p>
	</section>
}

templ termsTermsModsEL() {
	<section id="terms-mods">
		<h2>16. Αλλαγές στους παρόντες όρους</h2>
		<p>
			Μπορούμε να τροποποιούμε τους παρόντες όρους κατά καιρούς. Οι ουσιώδεις αλλαγές γνωστοποιούνται με email και με εμφανές πλαίσιο στη σελίδα αυτή τουλάχιστον τριάντα ημέρες νωρίτερα. Οι μη ουσιώδεις αλλαγές (διευκρινίσεις, παραπομπές) δημοσιεύονται με νέα ημερομηνία «τελευταίας ενημέρωσης». Η συνέχιση της χρήσης της Υπηρεσίας από εσάς μετά την ημερομηνία έναρξης ισχύος μιας ενημέρωσης συνιστά αποδοχή.
		</p>
	</section>
}

templ termsForceMajeureEL() {
	<section id="force-majeure">
		<h2>17. Ανωτέρα βία</h2>
		<p>
			Κανένα μέρος δεν ευθύνεται για αδυναμία ή καθυστέρηση εκτέλεσης στον βαθμό που οφείλεται σε περιστάσεις πέρα από τον εύλογο έλεγχό του, όπως θεομηνίες, πόλεμος, τρομοκρατία, κοινωνικές ταραχές, εργασιακές διαφορές, πυρκαγιά, φυσικές καταστροφές, κρατικά μέτρα λόγω πανδημίας, διακοπές του διαδικτύου ή του ρεύματος, ή ενέργειες παρόχων τηλεπικοινωνιών ή υποδομών φιλοξενίας τρίτων.
		</p>
	</section>
}

templ termsGoverningLawEL() {
	<section id="governing-law">
		<h2>18. Εφαρμοστέο δίκαιο και δικαιοδοσία</h2>
		<p>
			Οι όροι αυτοί διέπονται από το δίκαιο της Δημοκρατίας της Εσθονίας, χωρίς να λαμβάνονται υπόψη οι κανόνες του για τη σύγκρουση νόμων. Αποκλειστικά αρμόδιο για τις διαφορές είναι το Περιφερειακό Δικαστήριο Harju (Harju Maakohus) στο Ταλίν.
		</p>
		<p>
			Αν είστε καταναλωτής με κατοικία σε άλλο κράτος μέλος της ΕΕ, οι υποχρεωτικοί κανόνες προστασίας του καταναλωτή της χώρας σας εξακολουθούν να ισχύουν στον βαθμό που σας παρέχουν δικαιώματα από τα οποία δεν μπορείτε να παραιτηθείτε με σύμβαση· η ρήτρα αυτή δεν σας στερεί την προστασία των κανόνων αυτών.
		</p>
	</section>
}

templ termsGeneralEL() {
	<section id="general">
		<h2>19. Γενικές διατάξεις</h2>
		<p>
			<strong>Πλήρης συμφωνία.</strong> Οι όροι αυτοί, μαζί με την πολιτική απορρήτου, την DPA, τυχόν εντολές αγοράς και τυχόν συμπληρωματικούς όρους που ενσωματώνονται ρητά, αποτελούν την πλήρη συμφωνία μεταξύ μας για το αντικείμενό τους και αντικαθιστούν κάθε προηγούμενη ή σύγχρονη συνεννόηση.
		</p>
		<p>
			<strong>Διαιρετό.</strong> Αν μια διάταξη κριθεί ανεφάρμοστη, οι υπόλοιπες εξακολουθούν να ισχύουν.
		</p>
		<p>
			<strong>Εκχώρηση.</strong> Δεν μπορείτε να εκχωρήσετε τους παρόντες όρους χωρίς τη γραπτή μας συναίνεση. Μπορούμε να τους εκχωρήσουμε χωρίς συναίνεση στο πλαίσιο συγχώνευσης, εξαγοράς ή πώλησης του συνόλου ή ουσιαστικά του συνόλου των περιουσιακών μας στοιχείων, με ειδοποίησή σας.
		</p>
		<p>
			<strong>Μη παραίτηση.</strong> Η μη επιβολή μιας διάταξης δεν συνιστά παραίτηση από το δικαίωμα να επιβληθεί αργότερα.
		</p>
		<p>
			<strong>Ειδοποιήσεις.</strong> Οι ειδοποιήσεις προς την Kiff Agents OÜ αποστέλλονται στο <a href="mailto:legal@kiff.dev">legal@kiff.dev</a> ή, ταχυδρομικά, στη διεύθυνση Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Εσθονία. Οι ειδοποιήσεις προς εσάς αποστέλλονται στο email που συνδέεται με τον λογαριασμό σας ή, όπου έχετε δηλώσει, στη διεύθυνση που έχετε ορίσει για νομικές ειδοποιήσεις.
		</p>
		<p>
			<strong>Ανεξάρτητοι συμβαλλόμενοι.</strong> Τίποτα στους παρόντες όρους δεν δημιουργεί σχέση εταιρείας, αντιπροσώπευσης, κοινοπραξίας ή εργασίας.
		</p>
		<p>
			<strong>Τρίτοι δικαιούχοι.</strong> Δεν υπάρχουν, εκτός από τις συνδεδεμένες επιχειρήσεις που αποζημιώνονται και κατονομάζονται ρητά.
		</p>
	</section>
}

