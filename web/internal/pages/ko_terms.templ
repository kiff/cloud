package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// TermsKO is the Terms of Service (/terms) in Korean, at /ko/terms. It is
// a translation of Terms: the same sections, anchors, links and figures,
// held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Korean has the
// legal texts only, so a link to any other page goes to English and says so.
templ TermsKO() {
	@components.LayoutSite("KIFF — 서비스 약관", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@termsHeadKO()
			@termsDefinitionsKO()
			@termsAgreementKO()
			@termsServiceKO()
			@termsTafsKO()
			@termsAccountKO()
			@termsAcceptableUseKO()
			@termsCustomerDataKO()
			@termsConfidentialityKO()
			@termsFeesKO()
			@termsTermKO()
			@termsWarrantiesKO()
			@termsDisclaimerKO()
			@termsLiabilityKO()
			@termsIndemnityKO()
			@termsSLAKO()
			@termsServiceModsKO()
			@termsTermsModsKO()
			@termsForceMajeureKO()
			@termsGoverningLawKO()
			@termsGeneralKO()
			@termsContactKO()
		</article>
	}
}

templ termsHeadKO() {
	<header class="legal-head">
		<p class="legal-badge">서비스 약관 · v0.1</p>
		<h1>서비스 약관</h1>
		<p class="legal-meta">
			<strong>최종 업데이트:</strong> 2026년 십일월 21일.
			<strong>시행일:</strong> 2026년 오월 24일.
		</p>
		<p class="legal-disclaimer">
			<strong>변경 사항:</strong> 지역, 소유 구조, 제재에 따라 서비스를 이용할 수 있는 자(§4). 그 이전: Android용 tafs 앱과
			Google Play를 통해 구매하는 Solo(§1, §8). 그보다 앞서: 유료
			요금제(§3A, §8),
			<a href="/legal/sla">서비스 수준 계약</a>(영어)(§14), 그리고
			현재는
			<a href="/acceptable-use">허용되는 이용 정책</a>(영어)에 있는 금지된 이용 목록(§5).
		</p>
		<p class="legal-disclaimer">
			이 약관은 tafs를 포함한 KIFF Cloud의 이용에 적용됩니다. 계약
			관련 문의:
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</header>
}

templ termsDefinitionsKO() {
	<section id="definitions">
		<h2>1. 정의</h2>
		<ul>
			<li><strong>"Kiff Agents OÜ"</strong>, <strong>"당사"</strong> — 서비스를 제공하는 에스토니아 유한회사(private limited company). 등록번호 17372313.</li>
			<li><strong>"고객"</strong>, <strong>"귀하"</strong> — 이 약관에 동의하는 자연인 또는 법인.</li>
			<li><strong>"사용자"</strong> — 고객이 고객의 계정을 통해 서비스에 접근하도록 승인한 개인.</li>
			<li><strong>"서비스"</strong> — <code>api.kiff.dev</code>, <code>app.kiff.dev</code>, <code>kiff.dev</code>, tafs, 그리고 당사가 그곳에 게시하는 문서, 대시보드, API를 포함하는 KIFF Cloud 제품.</li>
			<li><strong>"tafs"</strong> — iPhone, iPad, Android와 컴퓨터(Mac, Windows, Linux)용 tafs 앱과 그 바탕이 되는 서비스로, 구성(Setup)과 planque(§3A)를 포함하며, 고객이 KIFF Card 안에서 일하는 AI 에이전트에게 일을 맡기는 곳. <strong>"taf"</strong>는 그러한 에이전트 하나를 말합니다.</li>
			<li><strong>"테넌트"</strong> — 단일 고객에게 속하는, 서비스 내에서 논리적으로 격리된 작업 공간.</li>
			<li><strong>"감사 데이터"</strong> — 서비스가 런타임을 통해 고객을 대신하여 저장하는 이벤트, 결정, 행동, 승인, 영수증.</li>
			<li><strong>"tafs 데이터"</strong> — tafs가 고객을 대신하여 보관하는 것: 각 taf의 실행과 채팅(고객이 연결한 도구가 taf에게 돌려주는 내용 포함), 보고서, 메모, 그리고 알림을 받도록 등록된 휴대폰.</li>
			<li><strong>"영수증"</strong> — 서비스가 통제 대상 행동마다 발행하는, 서명되고 버전이 관리되는 결정 기록.</li>
			<li><strong>"문서"</strong> — 이 약관이 링크하는 날짜가 표시된 개정판(<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>)에 있는 서비스의 기술 문서와 보안 조치. 전략 백서, 마케팅 자료, 별도로 라이선스되는 오픈 소스 프레임워크의 문서는 제외됩니다.</li>
			<li><strong>"DPA"</strong> — 당사의 프로세서로서의 관계를 규율하는 <a href="/legal/dpa">/legal/dpa</a>(영어)의 데이터 처리 계약.</li>
		</ul>
	</section>
}

templ termsAgreementKO() {
	<section id="agreement">
		<h2>2. 계약</h2>
		<p>
			이 약관은 귀하의 서비스 이용에 적용됩니다. 계정을 만들거나,
			API 키를 생성하거나, 그 밖의 방법으로 서비스를 이용하면
			귀하는 이 약관에 동의하는 것입니다. 회사나 그 밖의 법적
			실체를 대신하여 동의하는 경우, 귀하는 그 실체를 구속할
			권한이 있음을 진술하며, "귀하"는 그 실체를 가리킵니다.
		</p>
		<p>
			당사는 특정 기능(베타 기능, 제삼자 통합)에 대한 추가 약관을
			게시할 수 있습니다. 추가 약관이 이 약관과 충돌하는 경우,
			해당 기능에 대해서는 추가 약관이 우선합니다.
		</p>
	</section>
}

templ termsServiceKO() {
	<section id="service">
		<h2>3. 서비스</h2>
		<p>
			KIFF Cloud는 위임된 행동을 통제하기 위한 호스팅 서비스입니다.
			서비스는 고객이 구성한 권한과 Card에 비추어 요청을 평가하고,
			사람의 승인을 요구할 수 있으며, 통제 결정을 기록합니다.
			구성된 통합 방식에 따라 KIFF는 승인된 요청을 전달하거나,
			보호 대상 시스템이 검증하는 승인을 제공합니다. 실제 행동은
			연결된 시스템이 수행합니다.
		</p>
		<p>
			적용되는 기술적 동작, 증거, 통합 요건, 실행 한도는 이
			약관이 링크하는 날짜가 표시된 문서에 명시되어 있습니다.
			전략 <a href="/whitepaper">백서</a>(영어)는 KIFF의 원칙과
			모델을 설명하며, 이 약관상의 기술 문서로 편입되지
			않습니다.
		</p>
		<p>
			KIFF Cloud의 거버넌스 서비스는 에이전트 프레임워크, 워크플로
			엔진, 모델 게이트웨이 또는 관리형 에이전트 플랫폼이
			<em>아닙니다</em>. 귀하가 이미 사용하는 것과 함께 구성되어
			작동합니다. 명시적인 목록은 홈페이지의
			<a href="/#not">"KIFF가 아닌 것"</a>(영어)을
			참조하십시오. tafs는 서비스 중 귀하가 발급한 Card 안에서
			귀하를 위해 에이전트를 실행하는 유일한 부분이며, §3A에서
			설명합니다.
		</p>
		<p>
			오픈 소스 <a href="https://github.com/kiff/kiff" target="_blank" rel="noopener">kiff/kiff</a>
			프레임워크에는 자체 MIT 라이선스가 적용되며, 이 약관의
			적용 대상이 아닙니다. 귀하가 자신의 인프라에서 프레임워크를
			운영하는 경우, Kiff Agents OÜ와의 계약은 성립하지
			않습니다.
		</p>
	</section>
}

templ termsTafsKO() {
	<section id="tafs">
		<h2>3A. tafs</h2>
		<p>
			tafs에서 귀하는 일(예: 환불, 청구서 지급, 카드 분쟁)을
			taf에게 맡깁니다. taf는 귀하가 연결한 도구를 사용해 일정에
			따라, 귀하가 그 taf를 위해 발급한 KIFF Card 안에서 일하는
			AI 에이전트입니다. 각 taf는 당사의 에이전트 런타임에서
			실행되며, taf가 사용하는 AI 모델은 Anthropic이 제공합니다.
			귀하는 taf의 보류된 호출에 tafs 앱에서 응답합니다.
		</p>
		<p>
			<strong>도구 연결.</strong> taf처럼 실행되는 tafs의 AI
			에이전트인 구성(Setup)은 귀하가 도구를 연결하고 일을 위한
			taf를 설정하도록 돕습니다. 구성은 스스로 아무것도 연결하지
			않습니다. 귀하는 도구 제공업체(예: Stripe)의 자체 페이지에서
			로그인하고, 각 연결, taf가 사용할 수 있는 도구, 그리고
			taf의 Card를 귀하의 기기에서 승인합니다. 그 로그인에서
			받은 토큰은 당사의 연결 서비스인 planque가 보관합니다.
			토큰은 암호화되며, KIFF가 결정한 호출을 하는 데에만
			사용되고, taf에 절대 제공되지 않습니다. 도구 연결을
			해제하면 제공업체에서 토큰이 취소되고 토큰이 삭제됩니다.
		</p>
		<p>
			<strong>귀하의 Card는 귀하의 지시입니다.</strong> taf는
			KIFF를 통해서만 귀하의 도구에 접근하며, KIFF는 모든 호출을
			보내기 전에 그 taf의 Card에 비추어 확인합니다. 귀하가
			발급한 Card 안의 호출은 귀하의 지시에 따라 이루어집니다.
			Card 밖의 호출은 Card가 정한 대로 보류되거나 거절됩니다.
			보류된 호출은 귀하의 계정이 보류된 호출에 응답하도록 허용한
			사람이 승인한 후에만 이루어집니다. tafs 앱에서는 응답에
			KIFF가 검증하는 그 사람의 기기 서명이 포함되며, 영수증이 그
			증거를 보관합니다. 귀하의 계정은 KIFF 자체(대시보드, 그
			명령줄 도구, 또는 귀하가 그곳에서 승인한 승인자)에서도
			응답할 수 있으며, 이 경우 영수증에는 누가 어떻게
			응답했는지가 기록됩니다.
		</p>
		<p>
			<strong>귀하에게 남는 책임.</strong> 귀하는 각 taf의 일과
			Card를 정하고, 보류된 호출에 응답하며, 귀하가 연결하는
			도구와 계정을 사용할 권한이 있는지 확인합니다. taf의
			보고서, 메시지, 메모는 AI 모델이 작성하며 틀릴 수
			있습니다. 중요한 내용은 의존하기 전에 확인하십시오.
		</p>
		<p>
			<strong>taf 멈추기.</strong> 귀하는 taf 하나 또는 전체를
			차단하거나, taf를 일시 중지하거나, 그 taf의 Card를
			취소하거나, taf를 삭제할 수 있습니다. 귀하가 taf를
			차단하거나 Card를 취소한 순간부터 KIFF는 그에 따른 새
			호출을 허용하지 않습니다. tafs 앱은 KIFF와 planque가 모두
			차단을 확인한 후에만 taf를 차단된 것으로 표시하며, 그때부터
			planque는 KIFF가 직전에 허용한 호출을 포함하여 그 taf의
			어떤 호출도 보내지 않습니다. 이미 도구 제공업체에 보내진
			요청은 그대로 완료될 수 있습니다. 당사는 새 호출을 멈추지만,
			제공업체가 이미 한 일을 되돌릴 수는 없습니다.
			planque 없이 KIFF의 허가를 스스로 확인하는 도구는 KIFF가
			직전에 발급한 허가를 최대 90초 동안 여전히 받아들일 수
			있습니다. 차단된 taf를 재개하려면 귀하의 기기에서 승인해야
			하며, 차단 전에 보류되었거나 대기 중이던 것은 차단 후에
			실행되지 않습니다.
		</p>
		<p>
			<strong>taf를 삭제하면</strong> 그 일정이
			멈추고 그 실행, 채팅, 기억, 그리고 taf가 사용한 키가
			삭제됩니다. 그 전에도 도구가 taf에게 돌려준 내용은 실행이
			끝날 때까지만 보관되며(채팅에서 읽기만 한 내용은 다음
			메시지를 위해 암호화하여 보관하며, 최대 네 시간 동안 사용한
			후 삭제됩니다), 실행과 채팅은 30일간 보관됩니다. KIFF는 taf가 한 일의 영수증을 보관합니다.
		</p>
		<p>
			<strong>EU 인공지능법.</strong> tafs에 대해 Kiff Agents OÜ는
			AI 시스템의 제공자이고 귀하는 그 배포자입니다. 당사는
			taf가 귀하의 회사 밖의 사람에게 쓰는 모든 글에 AI 에이전트가
			썼다는 사실이 표시되도록 합니다. 귀하는 tafs를 tafs가
			제공하는 일에만 이용하고, 사람의 고용, 신용 또는 필수
			서비스 이용에 관한 결정처럼 인공지능법이 금지하거나
			고위험으로 분류하는 용도에는 이용하지 않습니다. 귀하는
			귀하의 Card가 요구하는 사람의 승인을 유지하며, 귀하를 위해
			tafs를 이용하는 사람들이 tafs가 하는 일과 그 한계를
			이해하도록 합니다.
		</p>
		<p>
			<strong>비용.</strong> tafs는 귀하의 KIFF 요금제(§8)에
			포함됩니다. taf의 각 실행은 그 실행이 사용한 AI에 대해
			크레딧을 사용합니다. Coach와 taf 설정은 Coach의 공정 이용
			범위 안에서 포함되어 있습니다.
		</p>
	</section>
}

templ termsAccountKO() {
	<section id="account">
		<h2>4. 계정과 접근</h2>
		<p>
			서비스를 이용하려면 계정을 만들어야 합니다. 귀하는 정확한
			등록 정보를 제공하고, 로그인 정보를 비밀로 유지하며, 귀하의
			계정에서 이루어지는 모든 활동에 대해 책임을 지는 데
			동의합니다.
		</p>
		<p>
			귀하는 만 16세 이상이거나, 귀하의 관할 지역의 디지털 동의
			연령 이상이어야 하며, 둘 중 더 높은 연령이 적용됩니다.
			서비스는 아동을 대상으로 하지 않습니다.
		</p>
		<p>
			서비스는 서비스의 AI 모델을 제공하는 Anthropic이 자체 서비스를 제공하는 국가 및 지역(<a href="https://www.anthropic.com/supported-countries">Anthropic이 게시한 목록</a>)에서만 제공됩니다. 그 밖의 곳에서는 서비스를 이용할 수 없습니다. 회사는 그 목록 밖의 국가 또는 지역에 본사를 두고 있거나, 그러한 곳에 본사를 둔 회사가 과반수 지분을 소유하거나 지배하는 경우, 사용자가 어디에 있든 서비스를 이용할 수 없습니다. 또한 귀하 또는 귀하가 서비스를 이용하는 대상 회사가 유럽연합, 국제연합 또는 미국의 제재 대상인 경우에도 이용할 수 없습니다. 당사는 이 규칙에 위배되는 계정을 거부하며, 위배되는 계정의 이용을 정지할 수 있습니다.
		</p>
		<p>
			귀하는 귀하의 계정에서 승인한 모든 사용자의 행동에 대해
			책임을 집니다. 당사는 이 약관의 신빙성 있는 위반을 발견하면
			합리적인 통지를 한 후 계정의 이용을 정지하거나 접근 권한을
			취소할 수 있습니다. 허용되는 이용 정책 위반(§5 참조)의
			경우 즉시 이용을 정지할 수 있습니다.
		</p>
	</section>
}

templ termsAcceptableUseKO() {
	<section id="acceptable-use">
		<h2>5. 허용되는 이용</h2>
		<p>
			귀하, 귀하의 사용자, 귀하의 에이전트는
			<a href="/acceptable-use">허용되는 이용 정책</a>(영어)을
			따라야 합니다. 이 정책은 이 약관의 일부이며, 서비스를
			이용해서는 안 되는 용도를 나열합니다.
		</p>
		<p>
			당사는 신빙성 있는 허용되는 이용 정책 위반이 있으면 즉시
			이용을 정지할 수 있습니다. 당사는 고객의 콘텐츠를 감시할
			의무는 없지만, 신빙성 있는 신고에 따라 조치할 수 있습니다.
		</p>
	</section>
}

templ termsCustomerDataKO() {
	<section id="customer-data">
		<h2>6. 고객 데이터와 콘텐츠</h2>
		<p>
			귀하의 감사 데이터는 귀하의 소유입니다. 귀하는 Kiff Agents
			OÜ에게 귀하를 위해 서비스를 운영, 유지, 개선하는 데 필요한
			범위에서만 귀하의 감사 데이터를 호스팅, 복제, 전송, 표시
			및 그 밖의 방법으로 처리할 수 있는 제한적, 비독점적, 무상,
			전 세계적 라이선스를 부여합니다.
		</p>
		<p>
			당사는 GDPR 제28조에 따라 귀하의 감사 데이터와 tafs
			데이터에 대해 <strong>프로세서(processor)</strong>로서
			행동하며, 그 관계는
			<a href="/legal/dpa">DPA</a>(영어)가 자세히 규율합니다.
			당사는 귀하의 계정 메타데이터에 대해
			<strong>컨트롤러(controller)</strong>로서 행동하며, 그
			관계에는
			<a href="/ko/privacy">개인정보처리방침</a>이 적용됩니다.
		</p>
		<p>
			귀하는 귀하가 제출하는 데이터를 제출하는 데 필요한 모든
			권리를 보유하고 있으며, 그 제출이 관련 법률(개인정보 보호
			법률 및 해당하는 경우 EU 인공지능법 포함)을 준수함을
			진술합니다.
		</p>
	</section>
}

templ termsConfidentialityKO() {
	<section id="confidentiality">
		<h2>7. 비밀 유지</h2>
		<p>
			각 당사자는 상대방으로부터 비공개 정보("비밀정보")를 받을 수
			있습니다. 수령 당사자는 이 약관에 따른 의무를 이행하고
			권리를 행사하는 데 필요한 범위에서만 비밀정보를 사용하며,
			적어도 자신의 비밀 정보에 기울이는 것과 같은 정도의 주의로
			이를 보호합니다.
		</p>
		<p>
			비밀정보에는 (a) 위반 없이 공개되어 있거나 공개된 정보,
			(b) 공개 전에 수령 당사자가 알고 있던 정보, (c) 비밀정보를
			사용하지 않고 독자적으로 개발된 정보, 또는 (d) 법에 따라
			공개해야 하는 정보(허용되는 경우 상대방에게 통지)는 포함되지
			않습니다.
		</p>
	</section>
}

templ termsFeesKO() {
	<section id="fees">
		<h2>8. 요금과 결제</h2>
		<p>
			<strong>요금제.</strong> 각 계정에는 하나의 요금제가
			있습니다. 현재 가격은 <a href="/pricing">가격
			페이지</a>(영어)에 있으며, 이 업데이트 시점의 가격은 다음과
			같습니다.
		</p>
		<ul>
			<li><strong>Solo:</strong> tafs를 위한 한 사람용 요금제로, tafs 앱에서 App Store 또는 Google Play를 통해 월 €12.50(부가가치세 포함)에 판매되며, 매월 500 크레딧이 포함됩니다.</li>
			<li><strong>Company:</strong> 좌석당 월 €10.50이며, 좌석당 매월 500 크레딧이 합산되어 제공되고, KIFF Cloud를 통한 귀하 자체 에이전트의 호출에 대해 좌석당 매월 500 행동이 합산되어 제공됩니다.</li>
			<li><strong>계약:</strong> 해당 주문서의 요금과 조건.</li>
		</ul>
		<p>
			좌석은 계정의 관리자와 편집자입니다. 승인자와 뷰어는 모든
			요금제에서 무료입니다. Company에서는 포함된 양을 넘으면
			크레딧 하나에 €0.01, 행동 하나에 €0.02가 부과됩니다.
			포함된 양을 넘는 크레딧은 계정이 설정한 월 지출 한도(시작
			시 €50)까지 청구됩니다. 한도에 도달하면 KIFF는 다음 기간이
			시작되거나 결제를 관리하는 사람이 한도를 올릴 때까지 그
			계정의 taf에 대해 새 실행을 시작하지 않습니다.
		</p>
		<p>
			<strong>크레딧 팩.</strong> Solo에서는 그 달에 포함된
			크레딧을 넘는 크레딧이 tafs 앱에서 구매하는 크레딧 팩에서
			나옵니다. 팩은 한 번 구매하는 것으로, 만료되지 않으며 구독이
			아닙니다. 팩의 크레딧은 그 달에 포함된 크레딧 다음에, 가장
			오래된 팩부터 사용됩니다. 대금이 전액 환불된 팩은 남은
			크레딧과 함께 회수됩니다. 그 달의 크레딧과 팩이 모두
			사용되면, KIFF는 다음 기간이 시작되거나 팩이 추가될 때까지
			그 계정의 taf에 대해 새 실행을 시작하지 않습니다.
			KIFF가 계정에 추가하는 보너스 크레딧도 팩과
			마찬가지로 만료되지 않습니다.
		</p>
		<p>
			<strong>집계 대상.</strong> <em>크레딧</em>은 taf의
			실행이 사용한 AI에 대한 대가로, 정수 단위의 크레딧으로
			계산하며, 실행마다 한 번 올림하고, 실행이 끝날 때 한 번
			집계합니다. KIFF가 호출을 거절한 실행도 AI는 사용한
			것입니다. 다음은 절대 집계되지 않습니다. Coach의 공정 이용
			범위 안에서의 Coach와 taf 설정, 아무것도 보내지 않는 새
			버전의 시험, 그리고 당사 측 원인으로 실패한 실행.
			<em>행동</em>은 귀하 자체 에이전트가 KIFF Cloud를 통해 한
			호출 중 무언가를 실제로 해낸 호출로, KIFF가 허용했고,
			보내졌으며, 도구가 성공을 보고한 호출입니다. 다음은 절대
			행동으로 집계되지 않습니다. 거절된 호출, 보류된 후 거절된
			호출, 차단으로 멈춘 호출, 유효하지 않은 호출, 도구에서
			실패한 호출, 결과를 알 수 없는 호출, 그리고 읽기만 하는
			호출.
		</p>
		<p>
			<strong>체험 기간 없음.</strong> 계정은 첫날부터 요금을
			지불합니다. 요금제가 시작되기 전에는 KIFF가 Coach의 설정을
			제외하고 그 계정의 taf 실행을 시작하지 않으며, 아무것도
			삭제되지 않습니다.
		</p>
		<p>
			<strong>결제와 인보이스.</strong> 요금제는 한 곳에서
			청구됩니다. kiff.dev에서 구매한 요금제는 그곳과 그곳에서
			링크하는 결제 포털에서 구매, 변경, 해지하며, 결제는
			Stripe가 처리합니다. tafs 앱에서 구매한 Solo는 iPhone과
			iPad에서는 App Store를, Android에서는 Google Play를 통해
			판매되며, 귀하의 Apple 구독 또는 Google Play 구독에서
			관리하고, 결제, 갱신, 환불에는 해당 스토어의 약관이
			적용됩니다. 크레딧 팩은 앱에서 구매합니다. Company는
			kiff.dev에서 구매합니다. 요금은 매월 선불로 청구되며,
			포함된 양을 넘는 사용량은 다음 인보이스와 함께 청구됩니다.
			인원 수의 변경은 다음 인보이스부터 적용됩니다. 결제가
			실패하고 보완되지 않으면, 요금제가 종료되고 KIFF는 요금제가
			선택될 때까지 그 계정의 호출을 거절합니다.
		</p>
		<p>
			<strong>해지.</strong> 귀하는 언제든지 결제 포털에서, 또는
			앱에서 구매한 Solo의 경우 귀하의 Apple 구독 또는 Google Play 구독에서 해지할 수 있습니다. 요금제는
			귀하가 대금을 지불한 기간이 끝날 때까지 유지되며, 갱신되지
			않습니다. 법이 요구하는 경우를 제외하고, 이미 지불한 요금은
			환불되지 않습니다. 귀하가 EU의 소비자라면 구매일로부터
			14일 이내에 이유를 밝히지 않고 청약을 철회할 수 있으며,
			당사는 귀하가 지불한 금액에서 요금제가 이미 운영된 일수에
			해당하는 몫을 뺀 금액을 환불합니다.
			Solo 구매는 App Store 또는 Google Play의 약관에 따라 그곳을 통해 환불됩니다.
		</p>
		<p>
			<strong>부가가치세.</strong> Company의 가격에는 부가가치세가
			포함되어 있지 않습니다. Solo와 크레딧 팩은 App Store 또는
			Google Play가 부가가치세를 포함하여 판매합니다. Kiff Agents
			OÜ(부가가치세 번호 EE102924327)는 해당하는 경우 에스토니아
			부가가치세를 추가합니다. 유효한 부가가치세 식별번호가 있는
			에스토니아 밖의 고객에 대한 EU 기업 간 판매는 EU 역발행
			과세(reverse-charge) 제도에 따라 인보이스가 발행됩니다.
		</p>
		<p>
			<strong>변경.</strong> 당사는 가격 인상에 대해 활성 계정에
			최소 삼십 일 전에 서면으로 통지합니다(§16). 가격 인하는
			다음 인보이스부터 적용됩니다.
		</p>
	</section>
}

templ termsTermKO() {
	<section id="term">
		<h2>9. 계약 기간과 해지</h2>
		<p>
			이 약관은 귀하가 서비스를 처음 이용할 때 효력이 발생하며,
			해지될 때까지 계속됩니다.
		</p>
		<p>
			귀하는 계정을 삭제하여 언제든지 해지할 수 있습니다. 당사는
			(a) 서면 통지 후 삼십 일 이내에 시정되지 않은 중대한 위반이
			있는 경우, 또는 (b) 허용되는 이용 정책 위반이나 지급불능
			사유가 있는 경우 즉시 해지할 수 있습니다.
		</p>
		<p id="leaving">
			<strong>서비스를 떠나고 데이터를 가져가기.</strong>
			귀하는 언제든지 구조화되고 기계가 읽을 수 있는 형식으로
			데이터를 내보낼 수 있습니다. KIFF에서는 설정 → 데이터에서
			귀하의 계정, 모든 버전을 포함한 귀하의 Card, 귀하의 기록에
			있는 결정(최근 10,000건, 더 필요하면 당사에 요청하십시오),
			KIFF가 허용한 각 결정의 서명된 영수증, 그리고 귀하의 API 키
			정보(키 자체는 절대 포함되지 않음)를 담은 JSON 파일을 받을
			수 있습니다. tafs 앱에서는 각 사람이 계정 → 내 채팅
			내보내기에서 자신의 채팅, 파일, 메모를 내보냅니다. 채팅은
			개인정보처리방침에 따라 어떤 경우에도 삼십 일간
			보관됩니다. 계정을 삭제하면 서비스가 즉시 종료되므로, 먼저
			내보내십시오.
		</p>
		<p>
			또는 다른 제공업체나 귀하 자체의 시스템으로 전환하기 위해
			<a href="mailto:support@kiff.dev">support@kiff.dev</a>로
			서면 통지를 보내 통지에 의해 떠날 수도 있습니다.
			당사는 두 달을 넘는 통지 기간을 절대 요구하지 않습니다.
			귀하의 통지는 귀하가 선택한 날, 다만 통지를 보낸 후 두
			달 이내의 날에 효력이 발생합니다. 그날부터 삼십 일의 전환
			기간이 이어지며, 그 기간 동안 서비스는 계속 운영되고, 귀하는
			데이터를 내보내고 작업을 옮기며, 당사는 이를 위한 합리적인
			요청을 돕습니다. 귀하는 전환 기간을 필요한 만큼 한 번 연장할
			수 있습니다. 당사가 기술적으로 삼십 일 안에 전환을 완료할 수
			없는 경우, 귀하의 통지로부터 십사 영업일 이내에 그 이유와
			칠 개월을 넘지 않는 새 기간을 귀하에게 알립니다.
			전환 기간이 끝난 후에도 귀하의 데이터는 최소 삼십 일 더
			내보낼 수 있는 상태로 유지됩니다. 요금제의 요금은 전환
			기간이 끝날 때까지 평소처럼 계속 부과됩니다. App Store 또는
			Google Play에서 구매한 Solo는 스토어에서 해지하며, 전환 및
			내보내기 기간은 같은 방식으로 적용됩니다.
		</p>
		<p>
			당사는 서비스를 떠나거나, 전환하거나, 데이터를 내보내는 데
			요금을 부과하지 않습니다. 이 조항은 EU 데이터법(규정 (EU)
			2023/2854) 제VI장의 전환 권리를 모든 고객에게
			부여합니다.
		</p>
		<p>
			해지 시, 그리고 전환 및 내보내기 기간이 있는 경우 그 기간이
			끝난 후, 당사는
			<a href="/ko/privacy#retention">개인정보처리방침</a>의
			보유 규칙에 따라 귀하의 감사 데이터, tafs 데이터, 계정
			메타데이터를 삭제합니다.
		</p>
		<p>
			그 성격상 해지 후에도 존속해야 하는 조항은 존속하며,
			여기에는 비밀 유지, 지식재산권, 면책, 책임의 제한, 보증의
			부인, 준거법, 그리고 발생한 모든 요금이 포함됩니다.
		</p>
	</section>
}

templ termsWarrantiesKO() {
	<section id="warranties">
		<h2>10. 보증</h2>
		<p>
			각 당사자는 이 약관을 체결하고 이행할 권리와 권한이 있음을
			진술합니다.
		</p>
		<p>
			당사는 서비스를 전문적인 방식으로, 그리고 문서에 실질적으로
			부합하게 제공할 것을 보증합니다. 이 보증 위반에 대한
			귀하의 유일한 구제 수단은 당사의 선택에 따라 재이행, 또는
			위반 기간 동안 영향을 받은 서비스에 귀속되는 요금의 비례
			환불입니다.
		</p>
		<p>
			귀하는 귀하의 서비스 이용이 관련 법률과 이 약관을
			준수함을 보증합니다.
		</p>
	</section>
}

templ termsDisclaimerKO() {
	<section id="disclaimer">
		<h2>11. 보증의 부인</h2>
		<p>
			§10의 명시적 보증을 제외하고, 서비스는 <strong>"있는
			그대로" 및 "이용 가능한 상태로"</strong> 제공됩니다. 법이
			허용하는 최대 범위에서 당사는 명시적, 묵시적 또는 법정
			보증인지를 불문하고 그 밖의 모든 보증을 부인하며, 여기에는
			상품성, 특정 목적에의 적합성, 비침해에 대한 보증과 거래
			과정 또는 거래 관행에서 발생하는 모든 보증이 포함됩니다.
		</p>
		<p>
			당사는 서비스가 중단 없이, 오류 없이, 또는 유해한 구성
			요소 없이 제공된다거나, 어떠한 데이터도 손실되거나 손상되지
			않는다고 보증하지 않습니다. 귀하는 귀하의 데이터를
			백업할 책임이 있습니다.
		</p>
	</section>
}

templ termsLiabilityKO() {
	<section id="liability">
		<h2>12. 책임의 제한</h2>
		<p>
			법이 허용하는 최대 범위에서, 어느 당사자도 이 약관 또는
			서비스로 인하여 또는 이와 관련하여 발생하는 간접적, 부수적,
			결과적, 특별, 징벌적 또는 처벌적 손해(일실 이익, 일실 수익,
			데이터 손실 또는 영업 중단 포함)에 대해, 그러한 손해의
			가능성을 통지받은 경우에도 상대방에게 책임을 지지
			않습니다.
		</p>
		<p>
			이 약관으로 인하여 또는 이와 관련하여 발생하는 각 당사자의
			총 책임은 (a) 책임을 발생시킨 사건 직전 십이 개월 동안
			고객이 Kiff Agents OÜ에 지급했거나 지급해야 하는 요금, 또는
			(b) 십만 유로(€100,000) 중 더 큰 금액을 넘지 않습니다.
		</p>
		<p>
			이 약관의 어떠한 내용도 관련 법률상 제한하거나 배제할 수
			없는 책임을 제한하거나 배제하지 않으며, 여기에는 사망,
			과실로 인한 신체 상해, 사기 또는 고의적 위법 행위에 대한
			책임, 그리고 결함 제조물 책임에 관한 지침
			(EU) 2024/2853을 시행하는 법률에 따른 결함 제조물에 대한
			책임이 포함됩니다.
		</p>
	</section>
}

templ termsIndemnityKO() {
	<section id="indemnification">
		<h2>13. 면책</h2>
		<p>
			당사는 당사가 제공하고 귀하가 이 약관에 따라 이용한 서비스가
			제삼자의 지식재산권을 침해한다는 그 제삼자의 청구에 대해 귀하를
			방어하며, 그러한 청구에 대해 귀하에게 최종적으로 선고된
			손해배상액(또는 합의된 화해 금액)을 지급합니다.
		</p>
		<p>
			귀하는 (a) 귀하의 고객 데이터 또는 콘텐츠, (b) 이 약관(허용되는
			이용 정책 포함)을 위반한 귀하의 서비스 이용, 또는 (c) 귀하의
			중과실 또는 고의적 위법 행위로 인하여 발생하는 제삼자의
			청구에 대해 당사를 방어하며, 그러한 청구에 대해 당사에게
			최종적으로 선고된 손해배상액(또는 합의된 화해 금액)을
			지급합니다.
		</p>
		<p>
			면책은 청구에 대한 신속한 통지, 면책 당사자의 방어 및 화해에
			대한 단독 통제, 그리고 피면책 당사자의 합리적인 협조를
			조건으로 합니다. 면책 당사자는 동의 없이 피면책 당사자에게
			의무를 부과하는 청구를 화해로 종결할 수 없습니다.
		</p>
	</section>
}

templ termsSLAKO() {
	<section id="sla">
		<h2>14. 서비스 수준 약정</h2>
		<p>
			유료 요금제에서는 <a href="/legal/sla">서비스 수준
			계약</a>(영어)이 당사가 약정하는 가용성, 느리거나 실패한 요청의
			집계 방식, 당사의 지원 응답 시간, 그리고 당사가 이에 미치지
			못할 때의 서비스 크레딧을 정합니다. 이 계약은 이 약관의
			일부입니다.
		</p>
		<p>
			운영 관행, 사고 대응, 침해 통지 약정은 이 약관이 링크하는
			날짜가 표시된 개정판
			(<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>)에
			문서화되어 있으며,
			<a href="/security">/security</a>(영어)에서 현재 관행을
			볼 수 있습니다.
		</p>
	</section>
}

templ termsServiceModsKO() {
	<section id="service-mods">
		<h2>15. 서비스의 변경</h2>
		<p>
			당사는 언제든지 기능을 추가, 변경 또는 제거할 수 있습니다.
			기능의 중대한 축소 또는 문서화된 동작을 깨뜨리는 API 화면의
			지원 중단은 공개된 지원 중단 일정과 함께 최소 삼십 일 전에
			활성 고객에게 통지합니다.
			통지 자체가 위험을 초래하는 경우, 보안상의 변경은 통지
			없이 이루어질 수 있습니다.
		</p>
	</section>
}

templ termsTermsModsKO() {
	<section id="terms-mods">
		<h2>16. 이 약관의 변경</h2>
		<p>
			당사는 이 약관을 수시로 개정할 수 있습니다. 중대한 변경은
			최소 삼십 일 전에 이메일과 이 페이지의 눈에 띄는 배너로
			통지합니다. 중대하지 않은 변경(명확화, 참조)은 새로운
			"최종 업데이트" 날짜와 함께 게시합니다. 업데이트의 시행일
			이후에도 귀하가 서비스를 계속 이용하면 이를 수락한 것으로
			봅니다.
		</p>
	</section>
}

templ termsForceMajeureKO() {
	<section id="force-majeure">
		<h2>17. 불가항력</h2>
		<p>
			어느 당사자도 천재지변, 전쟁, 테러, 시민 소요, 노동 쟁의,
			화재, 자연재해, 팬데믹 관련 정부 조치, 인터넷 또는 전력
			중단, 통신 사업자나 제삼자 호스팅 인프라의 조치를 포함하여
			합리적인 통제를 벗어난 상황으로 인한 범위에서는 이행의 불이행
			또는 지연에 대해 책임을 지지 않습니다.
		</p>
	</section>
}

templ termsGoverningLawKO() {
	<section id="governing-law">
		<h2>18. 준거법과 관할</h2>
		<p>
			이 약관에는 저촉법 규칙과 관계없이 에스토니아 공화국 법이
			적용됩니다. 분쟁의 전속 관할 법원은 탈린에 있는 하르유
			카운티 법원(Harju County Court)입니다.
		</p>
		<p>
			귀하가 다른 EU 회원국에 거주하는 소비자인 경우, 귀하 본국
			관할 지역의 강행적인 소비자 보호 규정은 계약으로 포기할 수
			없는 권리를 귀하에게 부여하는 범위에서 계속 적용되며, 이
			조항은 그러한 규정의 보호를 귀하에게서 박탈하지 않습니다.
		</p>
	</section>
}

templ termsGeneralKO() {
	<section id="general">
		<h2>19. 일반 조항</h2>
		<p>
			<strong>완전 합의.</strong> 이 약관은 개인정보처리방침, DPA,
			모든 주문서, 그리고 명시적으로 편입된 모든 추가 약관과 함께
			그 대상에 관한 당사자 간의 완전한 합의를 이루며, 이전 또는
			동시의 모든 양해를 대체합니다.
		</p>
		<p>
			<strong>분리 가능성.</strong> 어느 조항이 집행할 수 없는
			것으로 판단되더라도, 나머지 조항은 효력을 유지합니다.
		</p>
		<p>
			<strong>양도.</strong> 귀하는 당사의 서면 동의 없이 이
			약관을 양도할 수 없습니다. 당사는 합병, 인수, 또는 당사
			자산의 전부 또는 실질적으로 전부의 매각과 관련하여 귀하에게
			통지하고 동의 없이 양도할 수 있습니다.
		</p>
		<p>
			<strong>권리 불포기.</strong> 어느 조항을 집행하지 않더라도
			나중에 이를 집행할 권리를 포기하는 것이 아닙니다.
		</p>
		<p>
			<strong>통지.</strong> Kiff Agents OÜ에 대한 통지는
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>로,
			또는 우편으로 Tööstuse tn 75-71, Põhja-Tallinna
			linnaosa, Tallinn 10416, Estonia로 보냅니다. 귀하에 대한
			통지는 귀하의 계정과 연결된 이메일로, 또는 귀하가 지정한
			법적 통지 주소가 있는 경우 그 주소로 보냅니다.
		</p>
		<p>
			<strong>독립 계약자.</strong> 이 약관의 어떠한 내용도
			동업, 대리, 합작 투자 또는 고용 관계를 형성하지
			않습니다.
		</p>
		<p>
			<strong>제삼자 수익자.</strong> 면책 대상 계열사가
			명시적으로 특정된 범위를 제외하고는 없습니다.
		</p>
	</section>
}

templ termsContactKO() {
	<section id="contact">
		<h2>20. 연락처</h2>
		<p>
			영업 및 계약 관련 문의:
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
		<p>
			일반 제품 문의:
			<a href="mailto:hello@kiff.dev">hello@kiff.dev</a>.
			개인정보 관련 문의:
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
			보안 취약점 신고:
			<a href="mailto:security@kiff.dev">security@kiff.dev</a>.
		</p>

		<hr/>

		<p class="legal-footnote">
			<strong>문서 버전:</strong> v0.1.<br/>
			<strong>최종 업데이트:</strong> 2026년 십일월 21일.
		</p>
	</section>
}
