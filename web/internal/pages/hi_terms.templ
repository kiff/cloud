package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// TermsHI is KIFF's Terms of Service (/terms) in Hindi, at /hi/terms.
// It is a translation of Terms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Hindi has the legal
// texts only, so a link to any other page goes to English and says so.
// (Sections 8 to 20 are in hi_terms_more.templ.)
templ TermsHI() {
	@components.LayoutSite("KIFF — terms of service", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@termsHeadHI()
			@termsDefinitionsHI()
			@termsAgreementHI()
			@termsServiceHI()
			@termsTafsHI()
			@termsAccountHI()
			@termsAcceptableUseHI()
			@termsCustomerDataHI()
			@termsConfidentialityHI()
			@termsFeesHI()
			@termsTermHI()
			@termsWarrantiesHI()
			@termsDisclaimerHI()
			@termsLiabilityHI()
			@termsIndemnityHI()
			@termsSLAHI()
			@termsServiceModsHI()
			@termsTermsModsHI()
			@termsForceMajeureHI()
			@termsGoverningLawHI()
			@termsGeneralHI()
			@termsContactHI()
		</article>
	}
}

templ termsHeadHI() {
	<header class="legal-head">
		<p class="legal-badge">सेवा की शर्तें · v0.1</p>
		<h1>सेवा की शर्तें</h1>
		<p class="legal-meta">
			<strong>अंतिम अपडेट:</strong> 22 नवंबर 2026।
			<strong>प्रभावी तिथि:</strong> 24 मई 2026।
		</p>
		<p class="legal-disclaimer">
			<strong>क्या बदला:</strong> जब किसी दूसरे व्यवसाय ने आपको परिचित कराया तब आपका अनुबंध किसके साथ है (§2), और सूक्ष्म उद्यम (§8)। पहले: सेवा कौन उपयोग कर सकता है, क्षेत्र, स्वामित्व और प्रतिबंधों के अनुसार (§4); Android पर tafs ऐप, और
			Google Play से खरीदा Solo (§1, §8)। उससे पहले: सशुल्क
			योजनाएँ (§3A, §8),
			<a href="/legal/sla">सेवा-स्तर अनुबंध</a> (§14), और
			निषिद्ध उपयोगों की सूची, जो अब
			<a href="/acceptable-use">स्वीकार्य उपयोग नीति</a> (§5) में है।
		</p>
		<p class="legal-disclaimer">
			ये शर्तें tafs सहित KIFF Cloud के उपयोग को नियंत्रित करती हैं। अनुबंध संबंधी
			प्रश्न:
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>।
		</p>
	</header>
}

templ termsDefinitionsHI() {
	<section id="definitions">
		<h2>1. परिभाषाएँ</h2>
		<ul>
			<li><strong>"Kiff Agents OÜ"</strong>, <strong>"हम"</strong>, <strong>"हमें"</strong>, <strong>"हमारा"</strong> — सेवा उपलब्ध कराने वाली एस्टोनियाई निजी सीमित देयता कंपनी। पंजीकरण कोड 17372313।</li>
			<li><strong>"ग्राहक"</strong>, <strong>"आप"</strong>, <strong>"आपका"</strong> — इन शर्तों पर सहमत होने वाला प्राकृतिक या कानूनी व्यक्ति।</li>
			<li><strong>"उपयोगकर्ता"</strong> — कोई भी व्यक्ति जिसे ग्राहक अपने खाते के ज़रिए सेवा तक पहुँचने के लिए अधिकृत करता है।</li>
			<li><strong>"सेवा"</strong> — KIFF Cloud उत्पाद, जिसमें <code>api.kiff.dev</code>, <code>app.kiff.dev</code>, <code>kiff.dev</code>, tafs, और वहाँ हमारे प्रकाशित दस्तावेज़, डैशबोर्ड और API शामिल हैं।</li>
			<li><strong>"tafs"</strong> — iPhone, iPad, Android और कंप्यूटर (Mac, Windows और Linux) के लिए tafs ऐप और उसके पीछे की सेवा, जिसमें Setup और planque (§3A) शामिल हैं, जिसमें ग्राहक KIFF Card के भीतर काम करने वाले AI एजेंट को काम सौंपता है। <strong>"taf"</strong> ऐसा एक एजेंट है।</li>
			<li><strong>"टेनेंट"</strong> — सेवा के भीतर एक ग्राहक का तार्किक रूप से अलग कार्यक्षेत्र।</li>
			<li><strong>"ऑडिट डेटा"</strong> — वे घटनाएँ, निर्णय, कार्रवाइयाँ, मंज़ूरियाँ और रसीदें जिन्हें सेवा रनटाइम के ज़रिए ग्राहक की ओर से सहेजती है।</li>
			<li><strong>"tafs डेटा"</strong> — जो tafs ग्राहक की ओर से रखता है: हर taf की रन और चैट (जिसमें ग्राहक के जुड़े टूल उसे जो लौटाते हैं वह भी), उसकी रिपोर्ट, उसके मेमोरी नोट, और उसके अलर्ट के लिए पंजीकृत फ़ोन।</li>
			<li><strong>"रसीद"</strong> — सेवा द्वारा हर नियंत्रित कार्रवाई के लिए जारी हस्ताक्षरित, संस्करणबद्ध निर्णय रिकॉर्ड।</li>
			<li><strong>"दस्तावेज़ीकरण"</strong> — इन शर्तों से जुड़े दिनांकित संस्करण में तकनीकी सेवा दस्तावेज़ और सुरक्षा उपाय (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>)। इसमें रणनीतिक श्वेतपत्र, मार्केटिंग सामग्री और अलग से लाइसेंस प्राप्त ओपन-सोर्स फ्रेमवर्क के दस्तावेज़ शामिल नहीं हैं।</li>
			<li><strong>"DPA"</strong> — <a href="/legal/dpa">/legal/dpa</a> पर डेटा प्रोसेसिंग अनुबंध, जो हमारे प्रोसेसर-पक्ष के संबंध को नियंत्रित करता है।</li>
		</ul>
	</section>
}

templ termsAgreementHI() {
	<section id="agreement">
		<h2>2. अनुबंध</h2>
		<p>
			ये शर्तें सेवा के आपके उपयोग को नियंत्रित करती हैं। खाता बनाकर,
			API key बनाकर या किसी और तरह से सेवा का उपयोग करके
			आप इन शर्तों से सहमत होते हैं। यदि आप किसी कंपनी या अन्य कानूनी
			इकाई की ओर से स्वीकार करते हैं, तो आप घोषित करते हैं कि आपको उस इकाई को बाध्य करने का अधिकार है, और "आप"
			और "आपका" उस इकाई के लिए हैं।
		</p>
		<p>
			यदि किसी डेवलपर, भागीदार या अन्य व्यवसाय ने आपको KIFF से परिचित कराया या आपके उपयोग किए एजेंट को बनाया, तो सेवा के लिए आपका अनुबंध सीधे हमारे साथ, इन शर्तों के तहत है, और आप उन्हें स्वयं स्वीकार करते हैं। वह व्यवसाय हमारा एजेंट नहीं है: वह इन शर्तों को स्वीकार नहीं कर सकता, आपकी ओर से सहमति या भुगतान की मंज़ूरी नहीं दे सकता, और वह हमारी ओर से सेवा नहीं बेचता।
		</p>
		<p>
			हम विशिष्ट सुविधाओं (बीटा सुविधाएँ, तीसरे पक्ष के
			इंटीग्रेशन) के लिए अनुपूरक शर्तें प्रकाशित कर सकते हैं। जहाँ वे इन शर्तों से टकराएँ,
			उस विशिष्ट सुविधा के लिए अनुपूरक शर्तें प्रभावी होती हैं।
		</p>
	</section>
}

templ termsServiceHI() {
	<section id="service">
		<h2>3. सेवा</h2>
		<p>
			KIFF Cloud सौंपी गई कार्रवाइयों को नियंत्रित करने की होस्टेड सेवा है। वह अनुरोधों को ग्राहक की
			कॉन्फ़िगर की अनुमतियों और Card से जाँचती है, मानवीय
			मंज़ूरी माँग सकती है, और गवर्नेंस निर्णय दर्ज करती है। कॉन्फ़िगर किए इंटीग्रेशन के अनुसार, KIFF अधिकृत
			अनुरोध आगे भेजता है या ऐसा प्राधिकार देता है जिसे संरक्षित
			सिस्टम सत्यापित करता है। जुड़ा हुआ सिस्टम
			मूल कार्रवाई करता है।
		</p>
		<p>
			लागू तकनीकी व्यवहार, साक्ष्य, इंटीग्रेशन
			आवश्यकताएँ और निष्पादन की सीमाएँ इन शर्तों से जुड़े
			दिनांकित दस्तावेज़ीकरण में निर्दिष्ट हैं। रणनीतिक
			<a href="/whitepaper">श्वेतपत्र</a> (अंग्रेज़ी में) KIFF के
			सिद्धांत और मॉडल समझाता है; वह इन शर्तों के तहत तकनीकी दस्तावेज़ीकरण के रूप में शामिल नहीं है।
		</p>
		<p>
			KIFF Cloud की गवर्नेंस सेवा एजेंट फ्रेमवर्क, वर्कफ़्लो इंजन, मॉडल गेटवे या प्रबंधित एजेंट प्लेटफ़ॉर्म <em>नहीं</em> है। वह उसी के साथ जुड़ती है जो आप पहले से उपयोग करते हैं।
			स्पष्ट सूची के लिए होमपेज पर <a href="/#not">"KIFF क्या नहीं है"</a> (अंग्रेज़ी में)
			देखें। tafs सेवा का वह एकमात्र हिस्सा है जो आपके लिए एजेंट चलाता है, आपके जारी किए
			Card के भीतर; §3A उसका वर्णन करता है।
		</p>
		<p>
			ओपन-सोर्स <a href="https://github.com/kiff/kiff" target="_blank" rel="noopener">kiff/kiff</a>
			फ्रेमवर्क अपने MIT लाइसेंस से शासित है और इन शर्तों से बाहर है।
			जब आप फ्रेमवर्क अपने बुनियादी ढाँचे पर चलाते हैं, तो Kiff Agents OÜ के साथ कोई अनुबंध
			नहीं बनता।
		</p>
	</section>
}

templ termsTafsHI() {
	<section id="tafs">
		<h2>3A. tafs</h2>
		<p>
			tafs में आप taf को काम (जैसे रिफंड, बिल भुगतान या
			कार्ड विवाद) सौंपते हैं: एक AI एजेंट जो आपके जोड़े टूल के साथ, आपके उसके लिए जारी किए
			KIFF Card के भीतर, निर्धारित समय पर काम करता है। हर taf हमारे एजेंट रनटाइम पर चलता है, और
			वह जो AI मॉडल उपयोग करता है उसे Anthropic उपलब्ध कराती है। आप उसकी रोकी गई कॉल का उत्तर tafs ऐप में देते हैं।
		</p>
		<p>
			<strong>अपने टूल जोड़ना।</strong> Setup, tafs का एक AI एजेंट जो taf की तरह चलता है, आपको टूल जोड़ने और
			किसी काम के लिए taf बनाने में मदद करता है। वह अपने आप
			कुछ नहीं जोड़ता। आप टूल के अपने प्रदाता पर (जैसे
			Stripe) साइन इन करते हैं, और आप अपने डिवाइस पर हर
			कनेक्शन, taf जो टूल उपयोग कर सकता है, और उसके Card को मंज़ूर करते हैं। उस साइन-इन का
			टोकन हमारी कनेक्शन सेवा planque रखती है। वह एन्क्रिप्टेड है, केवल KIFF के तय की गई कॉल करने के लिए उपयोग होता है, और कभी किसी taf को नहीं दिया जाता। किसी टूल को डिस्कनेक्ट करना
			प्रदाता पर टोकन रद्द करता है और उसे हटा देता है।
		</p>
		<p>
			<strong>आपके Card आपके निर्देश हैं।</strong> taf
			आपके टूल तक केवल KIFF के ज़रिए पहुँचता है, जो हर
			कॉल को भेजने से पहले taf के Card से जाँचता है। आपके जारी किए
			Card के भीतर की कॉल आपके निर्देश पर की जाती है।
			Card के बाहर की कॉल रोकी या अस्वीकार की जाती है, जैसा Card कहता है।
			रोकी गई कॉल तभी की जाती है जब आपका खाता जिसे रोकी गई कॉल का उत्तर देने की अनुमति देता है वह उसे मंज़ूर करे। tafs ऐप में
			उत्तर के साथ उनके डिवाइस का हस्ताक्षर होता है जिसे KIFF सत्यापित करता है, और
			रसीद वह प्रमाण रखती है। आपका खाता KIFF में भी जवाब दे सकता है
			(डैशबोर्ड, उसका कमांड-लाइन टूल, या वहाँ आपका अधिकृत किया मंज़ूरीकर्ता);
			तब रसीद दर्ज करती है कि किसने और कैसे उत्तर दिया।
		</p>
		<p>
			<strong>भुगतान।</strong> जब taf आपके लिए किसी
			चेकआउट पर, उस साइट पर सहेजे कार्ड या अन्य भुगतान विधि से भुगतान करता है, तो वह यह केवल Card के भीतर और आपके
			उस भुगतान को अपने फ़ोन पर मंज़ूर करने के बाद करता है। आपकी मंज़ूरी
			उस एक भुगतान को आपकी ओर से अधिकृत करती है। साइट और
			उसका भुगतान प्रदाता उसे प्रोसेस करते हैं। KIFF और planque आपका पैसा कभी
			अपने पास नहीं रखते, आपके कार्ड का विवरण कभी संग्रहीत नहीं करते, और taf
			कभी कार्ड नंबर नहीं टाइप करता।
		</p>
		<p>
			<strong>आपके पास क्या रहता है।</strong> आप हर
			taf का काम और Card चुनते हैं, उसकी रोकी गई कॉल का उत्तर देते हैं, और यह सुनिश्चित करते हैं कि
			आपको अपने जोड़े टूल और खातों का उपयोग करने का अधिकार है। taf की
			रिपोर्ट, संदेश और मेमोरी नोट एक AI
			मॉडल लिखता है और वे गलत हो सकते हैं; भरोसा करने से
			पहले जो बातें मायने रखती हैं उन्हें जाँच लें।
		</p>
		<p>
			<strong>taf को रोकना।</strong> आप एक taf या
			सभी को रोक सकते हैं, किसी taf को थाम सकते हैं, उसका कोई भी Card रद्द कर सकते हैं, या
			उसे हटा सकते हैं। जिस क्षण आप taf को रोकते हैं या
			Card रद्द करते हैं, उसी क्षण से KIFF उसके तहत कोई नई कॉल नहीं होने देता। tafs ऐप
			taf को रोका हुआ तभी दिखाता है जब KIFF और planque दोनों ने रोक की
			पुष्टि कर दी हो; तब से planque उसकी कोई
			कॉल नहीं भेजता, KIFF की ठीक पहले अनुमति दी हुई कॉल भी नहीं। टूल के प्रदाता को
			पहले ही भेजा जा चुका अनुरोध फिर भी पूरा हो सकता है: हम
			नई कॉल रोकते हैं, पर प्रदाता ने जो कर दिया उसे पलट नहीं सकते।
			जो टूल KIFF के अनुमति-पत्र खुद जाँचता है, planque के बिना,
			वह KIFF के ठीक पहले जारी किए अनुमति-पत्र को अधिकतम 90 सेकंड तक अब भी स्वीकार कर सकता है। रुके taf को फिर चालू करने के लिए आपके डिवाइस पर
			आपकी मंज़ूरी चाहिए, और रोक से पहले रोका या कतार में लगा कुछ भी
			उसके बाद नहीं चलता।
		</p>
		<p>
			<strong>taf को हटाना</strong> उसका निर्धारित समय रोकता है और उसकी
			रन, चैट, मेमोरी और उसकी उपयोग की key हटाता है। उससे पहले भी, आपके टूल taf को जो लौटाते हैं
			वह केवल उसकी रन खत्म होने तक रखा जाता है (चैट ने जो केवल पढ़ा,
			एन्क्रिप्टेड, उसके अगले संदेशों के लिए: अधिकतम चार
			घंटे उपयोग होता है, फिर हटा दिया जाता है), और उसकी रन और चैट 30 दिन। KIFF जो उसने किया उसकी रसीदें रखता है।
		</p>
		<p>
			<strong>EU AI Act।</strong> tafs के लिए Kiff Agents OÜ
			AI सिस्टम की प्रदाता है और आप उसके तैनातकर्ता हैं।
			हम सुनिश्चित करते हैं कि taf आपकी कंपनी के बाहर किसी को जो भी लिखता है उसमें बताया जाता है कि AI एजेंट ने लिखा।
			आप tafs का उपयोग केवल उन कामों के लिए करते हैं जो वह देता है, और किसी ऐसे उपयोग के लिए नहीं जिसे AI Act
			प्रतिबंधित करता है या उच्च जोखिम वाला मानता है, जैसे
			किसी व्यक्ति के रोज़गार, ऋण या आवश्यक सेवाओं तक पहुँच के बारे में निर्णय। आप अपने Card की माँगी मानवीय मंज़ूरियाँ बनाए रखते हैं,
			और सुनिश्चित करते हैं कि जो लोग आपके लिए tafs का उपयोग करते हैं वे
			समझते हैं कि वह क्या करता है और उसकी सीमाएँ क्या हैं।
		</p>
		<p>
			<strong>लागत।</strong> tafs आपकी KIFF योजना का हिस्सा है
			(§8): taf की हर रन अपने उपयोग किए AI के लिए क्रेडिट खर्च करती है।
			Coach और tafs बनाना Coach के
			उचित उपयोग के भीतर शामिल हैं।
		</p>
	</section>
}

templ termsAccountHI() {
	<section id="account">
		<h2>4. खाते और पहुँच</h2>
		<p>
			सेवा का उपयोग करने के लिए आपको खाता बनाना होगा। आप सही पंजीकरण जानकारी
			देने, अपने क्रेडेंशियल गोपनीय रखने, और अपने खाते की
			सारी गतिविधि के लिए ज़िम्मेदार होने से सहमत हैं।
		</p>
		<p>
			आपकी आयु कम से कम 16 वर्ष होनी चाहिए, या आपके क्षेत्राधिकार में डिजिटल
			सहमति की आयु, जो भी अधिक हो। सेवा
			बच्चों के लिए नहीं है।
		</p>
		<p>
			सेवा केवल उन देशों और क्षेत्रों में दी जाती है जहाँ Anthropic, जो इसका AI मॉडल उपलब्ध कराती है, अपनी सेवा देती है, जैसा <a href="https://www.anthropic.com/supported-countries">Anthropic उन्हें सूचीबद्ध करती है</a>। आप इसे कहीं और से उपयोग नहीं कर सकते। कोई कंपनी इसका उपयोग नहीं कर सकती यदि उसका मुख्यालय उस सूची से बाहर किसी देश या क्षेत्र में है, या उसका अधिकांश स्वामित्व या नियंत्रण उस सूची से बाहर मुख्यालय वाली किसी कंपनी के पास है, चाहे उसके उपयोगकर्ता कहीं भी हों। न ही आप इसका उपयोग कर सकते हैं यदि आप, या वह कंपनी जिसके लिए आप इसका उपयोग करते हैं, यूरोपीय संघ, संयुक्त राष्ट्र या संयुक्त राज्य अमेरिका के प्रतिबंधों के अधीन हों। हम इस नियम को तोड़ने वाले खातों को अस्वीकार करते हैं और जो तोड़े उसे निलंबित कर सकते हैं।
		</p>
		<p>
			आप अपने खाते पर अधिकृत हर उपयोगकर्ता की
			कार्रवाइयों के लिए ज़िम्मेदार हैं। इन शर्तों के विश्वसनीय
			उल्लंघन का पता चलने पर हम उचित सूचना पर खाता निलंबित या पहुँच रद्द कर सकते हैं। स्वीकार्य उपयोग के उल्लंघनों के लिए
			(देखें §5) निलंबन तत्काल हो सकता है।
		</p>
	</section>
}

templ termsAcceptableUseHI() {
	<section id="acceptable-use">
		<h2>5. स्वीकार्य उपयोग</h2>
		<p>
			आप, आपके उपयोगकर्ता और आपके एजेंट को
			<a href="/acceptable-use">स्वीकार्य उपयोग नीति</a> (अंग्रेज़ी में) का पालन करना होगा। वह
			इन शर्तों का हिस्सा है और बताती है कि सेवा का किस काम के लिए
			उपयोग नहीं किया जा सकता।
		</p>
		<p>
			हम विश्वसनीय AUP उल्लंघन पर तुरंत निलंबित कर सकते हैं।
			हम ग्राहक की सामग्री की निगरानी के लिए बाध्य नहीं हैं पर
			विश्वसनीय रिपोर्टों पर कार्रवाई कर सकते हैं।
		</p>
	</section>
}

templ termsCustomerDataHI() {
	<section id="customer-data">
		<h2>6. ग्राहक डेटा और सामग्री</h2>
		<p>
			आपका ऑडिट डेटा आपका है। आप Kiff Agents OÜ को
			सीमित, गैर-अनन्य, रॉयल्टी-मुक्त, विश्वव्यापी लाइसेंस देते हैं:
			आपके ऑडिट डेटा को केवल उतना होस्ट करने, कॉपी करने, संचारित करने, प्रदर्शित करने और अन्यथा प्रोसेस करने के लिए जितना आपके लिए सेवा को चलाने, बनाए रखने
			और सुधारने के लिए आवश्यक हो।
		</p>
		<p>
			हम आपके ऑडिट डेटा और आपके tafs डेटा के लिए GDPR के अनुच्छेद 28 के तहत
			<strong>प्रोसेसर</strong> के रूप में काम करते हैं;
			<a href="/legal/dpa">DPA</a> उस संबंध को विस्तार से नियंत्रित करता है। हम आपके खाते के
			मेटाडेटा के लिए <strong>नियंत्रक</strong> के रूप में काम करते हैं;
			<a href="/hi/privacy">गोपनीयता नीति</a> उस
			संबंध को नियंत्रित करती है।
		</p>
		<p>
			आप घोषित करते हैं कि आपके पास वह डेटा प्रस्तुत करने के सारे ज़रूरी अधिकार हैं जो आप प्रस्तुत करते हैं,
			और प्रस्तुति लागू कानूनों (डेटा-संरक्षण कानूनों और,
			जहाँ लागू हो, EU AI Act सहित) के अनुरूप है।
		</p>
	</section>
}

templ termsConfidentialityHI() {
	<section id="confidentiality">
		<h2>7. गोपनीयता</h2>
		<p>
			हर पक्ष दूसरे से गैर-सार्वजनिक जानकारी पा सकता है
			("गोपनीय जानकारी")। प्राप्तकर्ता पक्ष गोपनीय जानकारी का उपयोग केवल उतना करेगा जितना
			इन शर्तों के तहत अपने दायित्व निभाने और अधिकार प्रयोग करने के लिए आवश्यक हो, और उसकी रक्षा कम से कम उसी
			स्तर की सावधानी से करेगा जिससे वह अपनी गोपनीय
			जानकारी की करता है।
		</p>
		<p>
			गोपनीय जानकारी में वह जानकारी शामिल नहीं जो
			(a) बिना उल्लंघन के सार्वजनिक रूप से उपलब्ध है या हो जाती है,
			(b) प्रकटीकरण से पहले प्राप्तकर्ता पक्ष को ज्ञात थी,
			(c) गोपनीय जानकारी के उपयोग के बिना स्वतंत्र रूप से विकसित की गई, या (d) कानून द्वारा
			प्रकट करनी आवश्यक है
			(जहाँ अनुमति हो वहाँ दूसरे पक्ष को सूचना के साथ)।
		</p>
	</section>
}
