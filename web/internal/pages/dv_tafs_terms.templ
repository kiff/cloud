package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsTermsDV is tafs's terms (/tafs/terms) in Dhivehi, at /dv/tafs/terms.
// It is a translation of TafsTerms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Dhivehi has the legal
// texts only, so a link to any other page goes to English and says so.
templ TafsTermsDV() {
	@components.LayoutSiteWithMeta("tafs ގެ ޝަރުތުތައް", "KIFF ގެ އެޕް tafs ގެ ޝަރުތުތައް: އެ ފޯރުކޮށްދެނީ ކާކުބާއެވެ، ތިބާގެ އެކައުންޓް، taf އަކުން ކުރާ ކަންތައްތަކާއި އެ ކޮންޓްރޯލް ކުރާނެ ގޮތް، ޤަބޫލުކުރެވޭ ބޭނުންކުރުން، ފީ، ޒިންމާއާއި ނިމުން.", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · ޝަރުތުތައް</p>
				<h1>tafs ގެ ޝަރުތުތައް</h1>
				<p class="legal-meta"><strong>ފަހުން އަޚާރު ކުރެވުނީ:</strong> 21 ނޮވެމްބަރު 2026.</p>
				<p class="legal-disclaimer">މި ޝަރުތުތައް އެއީ iPhone، iPad، Android އާއި ކޮމްޕިޔުޓަރުތަކަށް KIFF ގެ އެޕް tafs އާއި އޭގެ ފަހަތުގައިވާ ޚިދުމަތަށް ހުށަހަޅާ ޝަރުތުތަކެކެވެ. tafs އަކީ KIFF Cloud ގެ ބައެކެވެ؛ މި ސަފްހާގައި <a href="/dv/terms">KIFF ގެ ޚިދުމަތުގެ ޝަރުތުތަކުން</a> އޭގެ ބޭނުމަށް ބުނާ ވާހަކަ އަލުން ބުނާއިރު، އެ ޝަރުތުތަކަށް އެއްވެސް ކަމެއް ނުއިތުރުކުރެއެވެ. މި ސަފްހާއިން ނުހިމެނޭ ކޮންމެ ކަމެއްގައި KIFF ގެ ޝަރުތުތައް ހިނގާނެއެވެ. ސުވާލު: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.</p>
			</header>
			<section id="provider">
				<h2>1. tafs ފޯރުކޮށްދެނީ ކާކުބާ</h2>
				<p>tafs ފޯރުކޮށްދެނީ އެސްޓޯނިޔާގައި ރަޖިސްޓަރީ ކޮށްފައިވާ ޕްރައިވެޓް ލިމިޓެޑް ކުންފުންޏެއް <strong>Kiff Agents OÜ</strong> އިންނެވެ (ރަޖިސްޓްރީ ކޯޑު 17372313)، އެ އެޑްރެސް Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, އެސްޓޯނިޔާއެވެ. އެކައުންޓެއް ހަދައިގެން ނުވަތަ އެހެން ގޮތަކުން tafs ބޭނުންކުރުމުން، ތިބާ މި ޝަރުތުތަކާއި KIFF ގެ ޝަރުތުތަކަށް އެއްބަސްވެއެވެ. ތިބާ ކުންފުންޏެއްގެ ނަމުގައި ޤަބޫލުކުރާނަމަ، އެ ކުންފުންޏަށް ބާރުއަޅުވުމުގެ ބާރު ތިބާގެ އަތުގައި ވާކަން ކަށަވަރުކުރައްވައެވެ.</p>
			</section>
			<section id="account">
				<h2>2. ތިބާގެ އެކައުންޓް</h2>
				<p>ތިބާ tafs އަށް ވަންނަނީ KIFF އެކައުންޓަކުންނެވެ. ރަނގަޅު މައުލޫމާތު ދީ، ތިބާގެ ލޮގިން މައުލޫމާތު ސިއްރުކޮށް ބަހައްޓަވާށެވެ؛ ތިބާގެ އެކައުންޓް ދަށުން ހިނގާ ހުރިހާ ކަމެއްގެ އަދި ތިބާ އެ ތެރެއަށް ވަންނަން ދޭ ކޮންމެ މީހަކާ ބެހޭ ގޮތުން ތިބާ ޒިންމާވާނެއެވެ. ތިބާގެ ޢުމުރު މަދުވެގެން 16 އަހަރު، ނުވަތަ ތިބާ ދިރިއުޅޭ ތަނުގެ ޑިޖިޓަލް ރުހުމުގެ ޢުމުރު، އެ ދެކަމުގެ ތެރެއިން ބޮޑު ކަމެއް، ވާންޖެހެއެވެ. tafs ބޭނުންކުރެވޭނީ <a href="https://www.anthropic.com/supported-countries">Anthropic ލިސްޓް ކޮށްފައިވާ</a> ގޮތަށް Anthropic އިން އޭގެ އަމިއްލަ ޚިދުމަތް ފޯރުކޮށްދޭ ޤައުމަކުން ނުވަތަ ސަރަހައްދަކުން ކަމުގައި ވާނަމައެވެ؛ އެ ލިސްޓުން ބޭރުގައި މައި އޮފީސް ހުރި، ނުވަތަ އެފަދަ މައި އޮފީހެއް ހުރި ކުންފުންޏެއްގެ ބޮޑަށް ބޭނުންކުރާ ނުވަތަ ކޮންޓްރޯލް ކުރާ ކުންފުންޏަކަށް ނޫނެވެ؛ އަދި ތިބާ، ނުވަތަ ތިބާ ބޭނުންކުރާ ކުންފުނި، ޔޫރަޕިއަން ޔޫނިއަން، ޔުނައިޓެޑް ނޭޝަންސް ނުވަތަ އެމެރިކާގެ ހަރުދަނާ ޖަޒާތަކަށް ހުށަހެޅިފައިވާނަމަ ނޫނެވެ (KIFF ގެ ޝަރުތުތައް، §4).</p>
			</section>
			<section id="what-a-taf-does">
				<h2>3. taf އަކުން ކުރަނީ ކޮންކަމެއް</h2>
				<p>tafs ގައި ތިބާ ކަމެއް taf އަކަށް ހަވާލުކުރެއެވެ: ތިބާ ގުޅުއްވާ ޓޫލްތަކާއެކު، ތިބާ އެކަމަށް ދޭ KIFF Card ތަކުގެ ތެރޭގައި، ޝެޑިއުލްއަކަށް ބަލާގެން ޢަމަލުކުރާ AI އޭޖެންޓެއް. އެ ބޭނުންކުރާ AI މޮޑެލް ފޯރުކޮށްދެނީ Anthropic އެވެ. tafs ގެ AI އޭޖެންޓެއް Setup، ޓޫލެއް ގުޅުއްވައި taf އެއް ސެޓްކުރުމަށް ތިބާއަށް އެހީތެރިވެއެވެ، އެކަމަކު އަމިއްލައަށް އެއްވެސް ކަމެއް ނުގުޅުއްވައެވެ: ތިބާ ޓޫލުގެ އަމިއްލަ ފޯރުކޮށްދޭ ފަރާތުގައި ވަދެ، ކޮންމެ ގުޅުމެއް، taf އަކަށް ބޭނުންކުރެވޭނެ ޓޫލްތަކާއި އޭގެ Card ތައް ތިބާގެ ޑިވައިސްގައި ރުހުން ދެއެވެ.</p>
				<p>taf އެއްގެ ރިޕޯޓްތަކާއި މެސެޖުތަކާއި މެމޯރީ ނޯޓުތައް ލިޔަނީ AI މޮޑެލެކެވެ، އަދި އެ ރަނގަޅު ނުވެދާނެއެވެ. އެ މައްޗަށް ބަރޯސާވުމުގެ ކުރިން މުހިންމު ކަންތައްތައް ޗެކް ކުރައްވާށެވެ. ތިބާގެ ކުންފުންޏުން ބޭރުގެ މީހަކަށް taf އަކުން ލިޔާ ކޮންމެ ކަމެއްގައި، އެ ލިޔީ AI އޭޖެންޓެއް ކަމަށް ބުނެވޭނެއެވެ.</p>
			</section>
			<section id="control">
				<h2>4. ތިބާގެ ކޮންޓްރޯލް: Card އާއި ރުހުން</h2>
				<p>taf އެއް ތިބާގެ ޓޫލްތަކަށް ވާސިލްވަނީ KIFF މެދުވެރިކޮށް ކަމުގައި ވާއިރު، KIFF އިން ކޮންމެ ކޯލެއް ފޮނުވުމުގެ ކުރިން taf ގެ Card ތަކާ ޗެކް ކުރެއެވެ. ތިބާ ދިން Card އެއްގެ ތެރޭގައި ހުރި ކޯލެއް ކުރެވެނީ ތިބާގެ އިރުޝާދުގެ މަތިންނެވެ. Card އަކުން ބޭރުގައި ހުރި ކޯލެއް، Card ބުނާ ގޮތަށް ހިފެހެއްޓުމަށް ނުވަތަ ބާތިލް ކުރުމަށް ލިބެއެވެ. ހިފެހެއްޓިފައިވާ ކޯލެއް ކުރެވެނީ ހިފެހެއްޓިފައިވާ ކޯލްތަކަށް ޖަވާބުދެވޭނެ ގޮތަށް ތިބާގެ އެކައުންޓުން ހުއްދަ ދޭ މީހަކު އެ ރުހުން ދިނުމަށް ފަހުއެވެ.</p>
				<p>ތިބާ ކޮންމެ taf އެއްގެ ކަމާއި Card ތައް ހޮވައި، އޭގެ ހިފެހެއްޓިފައިވާ ކޯލްތަކަށް ޖަވާބުދީ، ތިބާ ގުޅުއްވާ ޓޫލްތަކާއި އެކައުންޓްތައް ބޭނުންކުރުމުގެ ހައްގު ތިބާގެ އަތުގައި ވާކަން ކަށަވަރުކުރައްވައެވެ. ތިބާއަށް taf އެއް ނުވަތަ ހުރިހާ taf ތަކެއް ހުއްޓުވައިލެވޭނެއެވެ، taf އެއް ވަގުތީގޮތުން ހުއްޓުވައިލެވޭނެއެވެ، އޭގެ ކޮންމެ Card އެއް ބާތިލް ކުރެވޭނެއެވެ، ނުވަތަ އެ ދުރުކޮށްލެވޭނެއެވެ. ތިބާ taf އެއް ހުއްޓުވާ ނުވަތަ Card އެއް ބާތިލް ކުރާ ވަގުތުން ފެށިގެން، އެ taf އަކުން ނުވަތަ އެ Card ގެ ދަށުން އައު ކޯލެއް KIFF އިން ހުއްދަ ނުދެއެވެ. ޓޫލެއްގެ ފޯރުކޮށްދޭ ފަރާތަށް ކުރިން ފޮނުވާފައިވާ އެދުމެއް ފުރިހަމަވެދާނެއެވެ: އަޅުގަނޑުމެން އައު ކޯލްތައް ހުއްޓުވާލަމުއެވެ، އެކަމަކު ފޯރުކޮށްދޭ ފަރާތް ކޮށްފައިވާ ކަމެއް ފަހަތަށް ނުވެއެވެ. ތަފްސީލް <a href="/dv/terms#tafs">KIFF ގެ ޝަރުތުތަކުގެ، §3A</a> ގައި ހުއްޓެވެ.</p>
				<p>EU AI ޤާނޫނުގެ ދަށުން، Kiff Agents OÜ އަކީ tafs ގެ ފޯރުކޮށްދޭ ފަރާތް ކަމަށާއި ތިބާ އޭގެ ބޭނުންކުރާ ފަރާތް ކަމަށް ވެއެވެ. tafs ބޭނުންކުރައްވާނީ އެ ހުށަހަޅާ ކަންތައްތަކަށް ބާވައެވެ، AI ޤާނޫނުން މަނާކުރާ ނުވަތަ ބޮޑު ހިތްގައިރާ ގެ ގޮތުގައި ބެލޭ ކޮންމެ ބޭނުންކުރުމަކަށް ނޫނެވެ، މިސާލަކަށް މީހެއްގެ ވަޒީފާއާއި ދަރަނި ނުވަތަ އެކަށީގެންވާ ޚިދުމަތްތަކަށް ވާސިލްވުމާ ބެހޭ ގޮތުން ނިންމުންތައް.</p>
			</section>
			<section id="acceptable-use">
				<h2>5. ޤަބޫލުކުރެވޭ ބޭނުންކުރުން</h2>
				<p>ތިބާ، ތިބާގެ މީހުން އަދި ތިބާގެ tafs ތަކުން <a href="/acceptable-use">ޤަބޫލުކުރެވޭ ބޭނުންކުރުމުގެ ސިޔާސަތު</a> (އިނގިރޭސިން) ފުރިހަމަކުރަންވާނެއެވެ. އޭޖެންޓެއްގެ ޢަމަލެއް ތިބާގެ ޢަމަލެކެވެ. އެހެން ކަންތައްތަކާއެކު، ޤާނޫނު ބިދިނުމަށް، ބޭނުންކުރަން ހުއްދަ ނެތް ސިސްޓަމެއް ނުވަތަ އެކައުންޓެއްގައި ޢަމަލުކުރުމަށް، ތިބާގެ ނޫން ލޮގިންއެއް ބޭނުންކޮށްގެން ޓޫލެއް ގުޅުއްވުމަށް، ސްޕެމް ފޮނުވުމަށް، ނުވަތަ Card އެއް، ހައްދެއް ނުވަތަ ހިފެހެއްޓުމެއް ފާއިތުވުމަށް tafs ބޭނުން ނުކުރަންވާނެއެވެ. ޤަބޫލުކުރެވޭ ބިދިނުމެއްގެ މައްސަލައެއްގައި ހިނގައްޖެ ނަމަ އަޅުގަނޑުމެން ވަގުތުން ހުއްޓުވިދާނެއެވެ.</p>
			</section>
			<section id="fees">
				<h2>6. ފީ</h2>
				<p>މި އަޚާރު ކުރާ ވަގުތު، Solo އަކީ މަހަކު { tafsCostDV.money(TafsSoloCents) } ގެ އަގަށް، VAT ހިމެނިގެން، މަހަކު ކްރެޑިޓް { tafsCostDV.number(TafsSoloCredits) } އާއެކު، އެޕްގައި App Store ނުވަތަ Google Play މެދުވެރިކޮށް ވިއްކާ ތަކެއް. އެޕްގައި ގަނެވޭ ކްރެޑިޓް ޕެކެޖުތައް { tafsCostDV.money(TafsPackCents[TafsSoloCredits]) } އިން ފެށެއެވެ؛ އެ ވަގުތު ހަމަނުވެއެވެ. taf އެއްގެ ކޮންމެ ރަނާއެއް އެ ބޭނުންކުރި AI އަށް ކްރެޑިޓް ބޭނުންކުރެއެވެ. Coach އާއި tafs ސެޓްކުރުމަކީ Coach ގެ އިންސާފުވެރި ބޭނުންކުރުމުގެ ތެރޭގައި ހިމެނެއެވެ. މިއީ ޔޫރޯ ސަރަހައްދުގެ އަގުތަކެވެ. އެހެން ތަންތަނުގައި، App Store ނުވަތަ Google Play އިން އެ ޤައުމުގެ ޤަވާޢިދުން ބޭނުންވާ ގޮތަށް ލޯކަލް ޓެކްސް ހިމެނިގެން ނުވަތަ ނުހިމެނި ތިބާގެ ފައިސާގައި އަގު ދައްކައެވެ، އެއީ ތިބާ ދައްކާ އަގެވެ. މިހާރުގެ އަގުތައް <a href="/pricing">އަގުގެ ސަފްހާގައި</a> (އިނގިރޭސިން) ހުއްޓެވެ؛ tafs އަކީ KIFF ގެ Company ޕްލޭނުގެ ބައެއްވެސް ކަމަށް ވެއެވެ.</p>
				<p>ޓްރަޔަލް ނެތެވެ. އެޕްގައި ގަނެވުނު Solo މެނޭޖް ކުރެވި އެ ބާތިލް ކުރެވެނީ ފައިސާ ދެއްކުން، އަލުން އައު ކުރުން އަދި ރިފަންޑް ކުރުމާ ބެހޭ އެ ސްޓޯރުގެ ޝަރުތުތަކުގެ ދަށުން ތިބާގެ Apple ނުވަތަ Google Play ސަބްސްކްރިޕްޝަންތަކުގައެވެ. ޕްލޭނެއް ތިބާ ދެއްކި މުއްދަތު ހަމަވުމާ ހަމައަށް ހިނގާނެއެވެ. ތިބާ EU ގައި ކަސްޓަމަރެއް ނަމަ، ގަތް ދުވަހުން 14 ދުވަހުގެ ތެރޭގައި ތިބާއަށް ދުރުވެވޭނެއެވެ. ތަފްސީލް <a href="/dv/terms#fees">KIFF ގެ ޝަރުތުތަކުގެ، §8</a> ގައި ހުއްޓެވެ.</p>
			</section>
			<section id="liability">
				<h2>7. ޒިންމާ</h2>
				<p>tafs ފޯރުކޮށްދެނީ "ހުރިހާ ގޮތަކަށް" އަދި "ލިބިފައިވާ ގޮތަކަށް" ކަމުގައި ވާއިރު، KIFF ގެ ޝަރުތުތަކުގެ (§10) ޟަމާނާތްތަކުގެ ގޮތުން ނޫނެވެ. ޤާނޫނުން ހުއްދަދޭ މިންވަރަކަށް، އެއްވެސް ފަރާތަކުން ވަކި ނުވަތަ ނަތީޖާގެ ގެއްލުންތަކަށް ޒިންމާ ނުވާއިރު، ކޮންމެ ފަރާތެއްގެ ޖުމްލަ ޒިންމާ <a href="/dv/terms#liability">KIFF ގެ ޝަރުތުތައް، §12</a> ބުނާ ގޮތަށް ހަމަތަކުރެވިފައިވެއެވެ. ޤާނޫނުން ހަމަތަކުރުމަށް ހުއްދަ ނުދޭ ޒިންމާއެއް އެއްވެސް ކަމަކުން ހަމަތަ ނުކުރެއެވެ.</p>
			</section>
			<section id="termination">
				<h2>8. ނިމުން</h2>
				<p>ތިބާއަށް ކޮންމެ ވަގުތެއްގައި ހުއްޓުވިދާނެއެވެ: އެޕްގައި އެކައުންޓް → <em>އެކައުންޓް ފޮހެލާ</em> ގައި ތިބާގެ އެކައުންޓް ފޮހެލާށެވެ. ކުރިން އެކައުންޓް → ބަހުސްތައް އެކްސްޕޯޓް ކުރޭ އިން ތިބާގެ ބަހުސްތައް އެކްސްޕޯޓް ކުރައްވާށެވެ. އަޅުގަނޑުމެންނަށް ތިބާގެ ބޭނުންކުރުން ނިންމާލެވިދާނެ ނޯޓިސް ދިނުމަށް ފަހު ތިރީސް ދުވަހުގެ ތެރޭގައި ރަނގަޅު ނުކުރެވޭ ބޮޑު ބިދިނުމެއްގެ ސަބަބުން، ނުވަތަ ޤަބޫލުކުރެވޭ ބޭނުންކުރުމުގެ ބިދިނުމެއްގެ ސަބަބުން ވަގުތުން. ދޫކޮށްލުމާއި ތިބާގެ ޑޭޓާ ނަގައިގެން ދިއުމުގެ ތިބާގެ ހައްގުތައް <a href="/dv/terms#term">KIFF ގެ ޝަރުތުތަކުގެ، §9</a> ގައި ހުއްޓެވެ.</p>
			</section>
			<section id="governing-law">
				<h2>9. ބަދަލުތަކާއި ހިނގާ ޤާނޫނު</h2>
				<p>KIFF ގެ ޝަރުތުތަކުން އެމީހުންގެ ގޮތުން ބުނާ ގޮތަށް (§16) އަޅުގަނޑުމެން މި ޝަރުތުތައް ބަދަލުކުރަމެވެ. އެ ހިނގަނީ އެސްޓޯނިއާ ޖުމްހޫރިއްޔާގެ ޤާނޫނުތަކުގެ ދަށުންނެވެ، އަދި މައްސަލަތައް ދެނީ Tallinn ގެ Harju ސިޓީ ކޯޓަށެވެ. ތިބާ އެހެން EU މެންބަރ ޤައުމެއްގައި ކަސްޓަމަރެއް ނަމަ، ތިބާގެ ޤައުމުގެ ކޮންމެހެން ކަސްޓަމަރ ރައްކާތެރިކަމުގެ ޤަވާޢިދުތައް ކުރިއަށް ހިނގާނެއެވެ.</p>
			</section>
			<section id="contact">
				<h2>10. އަޅުގަނޑުމެންނާ ގުޅުއްވާ</h2>
				<p>ކޮންޓްރެކްޓާ ބެހޭ ސުވާލު: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>. އެޕަށް އެހީތެރިކަން: <a href="mailto:support@kiff.dev">support@kiff.dev</a>. ޕްރައިވަސީ: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>، އަދި tafs އިން ޕަރސަނަލް ޑޭޓާ ހަންދާނާ ގޮތް <a href="/dv/tafs/privacy">tafs ގެ ޕްރައިވަސީ ސިޔާސަތުގައި</a> ހުއްޓެވެ.</p>
			</section>
		</article>
	}
}
