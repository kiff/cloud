package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// TermsBG is the Terms of Service (/terms) in Bulgarian, at /bg/terms. It
// is a translation of Terms: the same sections, anchors, links and figures,
// held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Bulgarian has the
// legal texts only, so a link to any other page goes to English and says
// so.
templ TermsBG() {
	@components.LayoutSite("KIFF — общи условия", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@termsHeadBG()
			@termsDefinitionsBG()
			@termsAgreementBG()
			@termsServiceBG()
			@termsTafsBG()
			@termsAccountBG()
			@termsAcceptableUseBG()
			@termsCustomerDataBG()
			@termsConfidentialityBG()
			@termsFeesBG()
			@termsTermBG()
			@termsWarrantiesBG()
			@termsDisclaimerBG()
			@termsLiabilityBG()
			@termsIndemnityBG()
			@termsSLABG()
			@termsServiceModsBG()
			@termsTermsModsBG()
			@termsForceMajeureBG()
			@termsGoverningLawBG()
			@termsGeneralBG()
			@termsContactBG()
		</article>
	}
}

templ termsHeadBG() {
	<header class="legal-head">
		<p class="legal-badge">Общи условия · v0.1</p>
		<h1>Общи условия</h1>
		<p class="legal-meta">
			<strong>Последна актуализация:</strong> 22 ноември 2026 г.
			<strong>Дата на влизане в сила:</strong> 24 май 2026 г.
		</p>
		<p class="legal-disclaimer">
			<strong>Какво се промени:</strong> с кого е договорът ви, когато ви е представила друга фирма (§2), и микропредприятията (§8). По-рано: кой може да използва Услугата според региона, собствеността и санкциите (§4); приложението tafs за Android и
			Solo, закупен чрез Google Play (§1, §8). Преди това: платените
			планове (§3A, §8),
			<a href="/legal/sla">споразумението за ниво на обслужване</a> (на английски) (§14) и
			списъкът със забранени употреби, който сега се намира в
			<a href="/acceptable-use">Политиката за допустима употреба</a> (на английски) (§5).
		</p>
		<p class="legal-disclaimer">
			Тези условия уреждат използването на KIFF Cloud, включително
			tafs. Въпроси относно договора:
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</header>
}

templ termsDefinitionsBG() {
	<section id="definitions">
		<h2>1. Определения</h2>
		<ul>
			<li><strong>„Kiff Agents OÜ“</strong>, <strong>„ние“</strong>, <strong>„нас“</strong>, <strong>„наш“</strong> — естонското дружество с ограничена отговорност, което предоставя Услугата. Регистрационен код 17372313.</li>
			<li><strong>„Клиент“</strong>, <strong>„вие“</strong>, <strong>„ваш“</strong> — физическото или юридическото лице, което приема тези условия.</li>
			<li><strong>„Потребител“</strong> — всяко физическо лице, на което Клиентът разреши достъп до Услугата чрез акаунта на Клиента.</li>
			<li><strong>„Услуга“</strong> — продуктът KIFF Cloud, включително <code>api.kiff.dev</code>, <code>app.kiff.dev</code>, <code>kiff.dev</code>, tafs, както и документацията, таблата за управление и API интерфейсите, които публикуваме там.</li>
			<li><strong>„tafs“</strong> — приложението tafs за iPhone, iPad, Android и компютри (Mac, Windows и Linux) и услугата зад него, включително Setup и planque (§3A), в което Клиентът възлага задача на AI агент, който работи в рамките на KIFF Cards. <strong>„Taf“</strong> е един такъв агент.</li>
			<li><strong>„Наемател“</strong> — логически изолирано работно пространство в Услугата, което принадлежи на един Клиент.</li>
			<li><strong>„Данни за одит“</strong> — събитията, решенията, действията, одобренията и разписките, които Услугата съхранява от името на Клиента чрез средата за изпълнение.</li>
			<li><strong>„Данни на tafs“</strong> — това, което tafs съхранява от името на Клиента: изпълненията и чатовете на всеки taf (включително това, което свързаните инструменти на Клиента му връщат), неговите отчети, бележките му в паметта и телефоните, регистрирани за неговите известия.</li>
			<li><strong>„Разписка“</strong> — подписан запис на решение с версия, който Услугата издава за всяко управлявано действие.</li>
			<li><strong>„Документация“</strong> — техническата документация на Услугата и мерките за сигурност в датираната версия, към която препращат тези Условия (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>). Тя не включва стратегическата бяла книга, маркетинговите материали и документацията за отделно лицензираната рамка с отворен код.</li>
			<li><strong>„DPA“</strong> — Споразумението за обработване на данни на <a href="/legal/dpa">/legal/dpa</a> (на английски), което урежда отношенията ни като обработващ лични данни.</li>
		</ul>
	</section>
}

templ termsAgreementBG() {
	<section id="agreement">
		<h2>2. Споразумението</h2>
		<p>
			Тези условия уреждат използването на Услугата от вас. Като
			създадете акаунт, генерирате API ключ или използвате
			Услугата по друг начин, вие приемате тези условия. Ако ги
			приемате от името на дружество или друго юридическо лице,
			вие декларирате, че имате правомощие да го обвържете, и
			„вие“ и „ваш“ се отнасят до това лице.
		</p>
		<p>
			Ако разработчик, партньор или друга фирма ви е представила KIFF или е създала агента, който използвате, договорът ви за Услугата е пряко с нас, съгласно тези условия, и вие ги приемате лично. Тази фирма не е наш представител: тя не може да приеме тези условия, да даде съгласие или да одобри плащане от ваше име и не продава Услугата от наше име.
		</p>
		<p>
			Можем да публикуваме допълнителни условия за определени
			функции (бета функции, интеграции с трети страни). Когато
			те противоречат на тези условия, за съответната функция
			предимство имат допълнителните условия.
		</p>
	</section>
}

templ termsServiceBG() {
	<section id="service">
		<h2>3. Услугата</h2>
		<p>
			KIFF Cloud е хоствана услуга за управление на делегирани
			действия. Тя оценява заявките спрямо разрешенията и Cards,
			конфигурирани от Клиента, може да изисква одобрение от
			човек и записва решенията за управление. В зависимост от
			конфигурираната интеграция KIFF препраща разрешената заявка
			или предоставя разрешение, което защитената система
			проверява. Самото действие се извършва от свързаната система.
		</p>
		<p>
			Приложимото техническо поведение, доказателствата,
			изискванията за интеграция и ограниченията на изпълнението
			са посочени в датираната Документация, към която препращат
			тези Условия. Стратегическата
			<a href="/whitepaper">бяла книга</a> (на английски) обяснява
			принципите и модела на KIFF; съгласно тези Условия тя не е
			включена като техническа Документация.
		</p>
		<p>
			Услугата за управление на KIFF Cloud <em>не е</em> рамка за
			агенти, система за работни потоци, шлюз за модели или
			управлявана платформа за агенти. Тя се съчетава с всичко,
			което вече използвате. Вижте
			<a href="/#not">„Какво не е KIFF“</a> (на английски) на началната
			страница за изричния списък. tafs е единствената
			част от Услугата, която изпълнява агенти вместо вас, в
			рамките на Cards, които издавате; §3A я описва.
		</p>
		<p>
			Рамката с отворен код <a href="https://github.com/kiff/kiff" target="_blank" rel="noopener">kiff/kiff</a>
			се урежда от собствения си лиценз MIT и е извън обхвата на
			тези условия. Когато изпълнявате рамката на собствена
			инфраструктура, не възниква договор с Kiff Agents OÜ.
		</p>
	</section>
}

templ termsTafsBG() {
	<section id="tafs">
		<h2>3A. tafs</h2>
		<p>
			В tafs възлагате задача (например възстановяване на
			плащания, плащане на сметки или оспорване на картови
			плащания) на taf: AI агент, който работи по график с
			инструментите, които свържете, в рамките на KIFF Cards,
			които издавате за него. Всеки taf работи в нашата среда за
			изпълнение на агенти, а AI моделът, който използва, се
			предоставя от Anthropic. На задържаните му заявки отговаряте
			в приложението tafs.
		</p>
		<p>
			<strong>Свързване на инструментите ви.</strong> Setup, AI агент
			в tafs, който работи като taf, ви помага да свържете
			инструмент и да настроите taf за задача. Той не свързва
			нищо сам. Влизате при собствения доставчик на инструмента
			(например Stripe) и одобрявате на устройството си всяка
			връзка, инструментите, които даден taf може да използва, и
			неговите Cards. Токенът от този вход се съхранява от
			planque, нашата услуга за връзки. Той е криптиран, използва
			се само за извършване на заявка, за която KIFF е взел
			решение, и никога не се дава на taf. Прекъсването на връзката
			с инструмент оттегля токена при доставчика и го изтрива.
		</p>
		<p>
			<strong>Вашите Cards са вашите указания.</strong> Taf
			достига до инструментите ви само чрез KIFF, който проверява
			всяка заявка спрямо Cards на taf, преди тя да бъде
			изпратена. Заявка в рамките на издаден от вас Card се
			извършва по ваше указание. Заявка извън Card се задържа или
			отказва, както предвижда Card. Задържаната заявка се
			извършва само след като я одобри някой, на когото акаунтът
			ви разрешава да отговаря на задържани заявки. В
			приложението tafs отговорът носи подпис от устройството на
			този човек, който KIFF проверява, а разписката запазва това
			доказателство. Акаунтът ви може да отговаря и в самия KIFF
			(в таблото за управление, чрез неговия инструмент за команден
			ред или чрез одобряващ, когото упълномощите там); тогава
			разписката записва кой е отговорил и как.
		</p>
		<p>
			<strong>Плащания.</strong> Когато taf плаща вместо вас при финализиране на поръчка, с карта или друг начин на плащане, който сте запазили в този сайт, той прави това само в рамките на Card и едва след като одобрите това плащане на телефона си. Вашето одобрение упълномощава това едно плащане от ваше име. Сайтът и неговият платежен доставчик го обработват. KIFF и planque никога не държат парите ви, никога не съхраняват данните за картата ви, а taf никога не въвежда номер на карта.
		</p>
		<p>
			<strong>Какво остава за вас.</strong> Избирате задачата и
			Cards на всеки taf, отговаряте на задържаните му заявки и
			се уверявате, че имате право да използвате инструментите и
			акаунтите, които свързвате. Отчетите, съобщенията и
			бележките в паметта на taf се пишат от AI модел и може да
			са грешни; проверете важното, преди да разчитате на него.
		</p>
		<p>
			<strong>Спиране на taf.</strong> Можете да спрете един taf
			или всички, да поставите taf на пауза, да оттеглите който и
			да е от неговите Cards или да го премахнете. От момента, в
			който спрете taf или оттеглите Card, KIFF не допуска нова
			заявка въз основа на тях. Приложението tafs показва taf като
			спрян едва след като KIFF и planque са потвърдили спирането;
			оттогава planque не изпраща нито една негова заявка, дори
			такава, която KIFF е разрешил непосредствено преди това.
			Заявка, която вече е изпратена до доставчика на инструмент,
			може все пак да бъде изпълнена: спираме новите заявки и не
			можем да отменим това, което доставчикът е направил.
			Инструмент, който сам проверява разрешенията на KIFF, без
			planque, може все още да приеме разрешение, издадено от KIFF
			непосредствено преди това, за не повече от 90 секунди.
			Възобновяването на спрян taf изисква вашето одобрение на
			устройството ви и нищо, задържано или поставено на опашка
			преди спирането, не се изпълнява след него.
		</p>
		<p>
			<strong>Премахването на taf</strong> спира неговия
			график и изтрива изпълненията, чатовете, паметта и ключа,
			който е използвал. Дори преди това, това, което
			инструментите ви връщат на taf, се съхранява само до края на
			изпълнението (това, което даден чат само е прочел,
			криптирано, за следващите му съобщения: използва се не повече
			от четири часа, след което се изтрива), а изпълненията и
			чатовете му — 30 дни. KIFF запазва разписките за това, което е направил.
		</p>
		<p>
			<strong>Законодателният акт на ЕС за ИИ.</strong> За tafs Kiff Agents OÜ
			е доставчикът на системата с ИИ, а вие сте неин внедрител.
			Гарантираме, че всичко, което taf пише на някого извън
			вашата компания, посочва, че е написано от AI агент.
			Използвате tafs само за задачите, които предлага, и не за
			употреба, която Законодателният акт за ИИ забранява или
			класифицира като високорискова, например решения относно
			наемането на работа на дадено лице, кредит или достъп до
			основни услуги. Запазвате човешките одобрения, които
			изискват вашите Cards, и се уверявате, че хората, които
			използват tafs вместо вас, разбират какво прави и какви са
			ограниченията му.
		</p>
		<p>
			<strong>Разходи.</strong> tafs е част от вашия план в KIFF
			(§8): всяко изпълнение на taf използва кредити за AI, който е
			използвал. Coach и настройването на tafs са включени в
			рамките на справедливото използване на Coach.
		</p>
	</section>
}

templ termsAccountBG() {
	<section id="account">
		<h2>4. Акаунти и достъп</h2>
		<p>
			За да използвате Услугата, трябва да създадете акаунт.
			Съгласявате се да предоставите точни данни при
			регистрацията, да пазите поверителността на данните си за
			вход и да отговаряте за цялата дейност в акаунта си.
		</p>
		<p>
			Трябва да сте навършили поне 16 години или възрастта за
			цифрово съгласие във вашата юрисдикция, ако тя е по-висока.
			Услугата не е предназначена за деца.
		</p>
		<p>
			Услугата се предлага само в държавите и регионите, в които Anthropic, който предоставя нейния AI модел, предлага собствената си услуга, както <a href="https://www.anthropic.com/supported-countries">ги изброява Anthropic</a>. Не можете да я използвате от другаде. Дружество не може да я използва, ако е със седалище в държава или регион извън този списък или е мажоритарно притежавано или контролирано от дружество със седалище в такава държава или регион, независимо къде са неговите потребители. Не можете да я използвате и ако вие или дружеството, за което я използвате, сте обект на санкции на Европейския съюз, Организацията на обединените нации или Съединените щати. Отказваме акаунти, които нарушават това правило, и можем да спрем такъв акаунт.
		</p>
		<p>
			Отговаряте за действията на всеки Потребител, когото
			упълномощите в акаунта си. Можем да спрем акаунт или да
			оттеглим достъп с разумно предизвестие, ако установим
			достоверно нарушение на тези условия. При нарушения на
			Политиката за допустима употреба (вж. §5) спирането може да
			бъде незабавно.
		</p>
	</section>
}

templ termsAcceptableUseBG() {
	<section id="acceptable-use">
		<h2>5. Допустима употреба</h2>
		<p>
			Вие, вашите потребители и вашите агенти трябва да спазвате
			<a href="/acceptable-use">Политиката за допустима употреба</a> (на английски). Тя
			е част от тези условия и изброява за какво Услугата не може
			да се използва.
		</p>
		<p>
			Можем да спрем незабавно при достоверно нарушение на тази
			политика. Не сме задължени да наблюдаваме съдържанието на
			Клиента, но можем да действаме въз основа на достоверни
			сигнали.
		</p>
	</section>
}

templ termsCustomerDataBG() {
	<section id="customer-data">
		<h2>6. Данни и съдържание на Клиента</h2>
		<p>
			Данните за одит са ваша собственост. Вие предоставяте на Kiff
			Agents OÜ ограничен, неизключителен, безвъзмезден лиценз със
			световен обхват да хоства, копира, предава, показва и
			обработва по друг начин вашите Данни за одит единствено в
			необходимата степен, за да експлоатира, поддържа и подобрява
			Услугата за вас.
		</p>
		<p>
			По отношение на вашите Данни за одит и Данни на tafs
			действаме като <strong>обработващ лични данни</strong>
			съгласно член 28 от ОРЗД; <a href="/legal/dpa">DPA</a> (на английски)
			урежда подробно това отношение. По отношение на
			метаданните на акаунта ви действаме като
			<strong>администратор</strong>; това отношение се урежда от
			<a href="/bg/privacy">политиката за поверителност</a>.
		</p>
		<p>
			Декларирате, че имате всички права, необходими за
			предоставянето на данните, които предоставяте, и че
			предоставянето им е в съответствие с приложимото право
			(включително законодателството за защита на данните и,
			когато е приложимо, Законодателния акт на ЕС за ИИ).
		</p>
	</section>
}

templ termsConfidentialityBG() {
	<section id="confidentiality">
		<h2>7. Поверителност</h2>
		<p>
			Всяка страна може да получи непублична информация от
			другата („Поверителна информация“). Получаващата страна ще
			използва Поверителната информация само доколкото е
			необходимо за изпълнение на задълженията си и упражняване
			на правата си по тези условия и ще я защитава с поне
			същата степен на грижа, която полага за собствената си
			поверителна информация.
		</p>
		<p>
			Поверителна информация не включва информация, която (а) е
			или стане публично достъпна без нарушение, (б) е била
			известна на получаващата страна преди разкриването, (в) е
			разработена независимо, без използване на Поверителната
			информация, или (г) трябва да бъде разкрита по закон (с
			уведомяване на другата страна, когато това е разрешено).
		</p>
	</section>
}

templ termsFeesBG() {
	<section id="fees">
		<h2>8. Такси и плащане</h2>
		<p>
			<strong>Планове.</strong> Всеки акаунт има един план.
			Актуалните цени са на <a href="/pricing">страницата с
			цени</a> (на английски); към момента на тази актуализация:
		</p>
		<ul>
			<li><strong>Solo:</strong> едно лице, за tafs, продава се в приложението tafs чрез App Store или Google Play за 12,50 € на месец с включен ДДС, с включени 500 кредита на месец.</li>
			<li><strong>Company:</strong> 10,50 € на месец за всяко място, с 500 кредита на месец за всяко място, обединени, и за заявките на собствените ви агенти чрез KIFF Cloud — 500 действия на месец за всяко място, обединени.</li>
			<li><strong>Споразумение:</strong> таксите и условията в неговата поръчка.</li>
		</ul>
		<p>
			Местата са администраторите и редакторите на акаунта.
			Одобряващите и наблюдателите са безплатни във всеки план.
			В Company, над включеното, един кредит струва 0,01 €, а едно
			действие — 0,02 €. Кредитите над включените се таксуват до
			месечния лимит на разходите, зададен от акаунта (50 € в
			началото): при достигане на лимита KIFF не стартира ново
			изпълнение на tafs на акаунта, докато не започне следващият
			период или някой, който управлява плащанията, не го увеличи.
		</p>
		<p>
			<strong>Пакети кредити.</strong> В Solo кредитите над
			включените за месеца идват от пакети кредити, закупени в
			приложението tafs. Пакетът се купува веднъж, не изтича и не
			е абонамент; кредитите му се използват след включените за
			месеца, като се започне от най-стария пакет. Пакет, чието
			плащане е възстановено изцяло, се отнема заедно с оставащите
			му кредити. Когато кредитите за месеца и пакетите се
			изчерпят, KIFF не стартира ново изпълнение на tafs на
			акаунта, докато не започне следващият период или не бъде
			добавен пакет.
			Бонус кредитите, които KIFF добавя към даден акаунт, също
			не изтичат, както пакетите.
		</p>
		<p>
			<strong>Какво се отчита.</strong> <em>Кредитът</em> заплаща
			AI, използван от изпълнението на taf, в цели кредити,
			закръглено нагоре веднъж на изпълнение и отчетено веднъж, при
			приключване на изпълнението. Изпълнение, чиято заявка KIFF е
			отказал, все пак е използвало своя AI. Никога не се отчитат:
			Coach и настройването на tafs в рамките на справедливото
			използване на Coach; проба на нова версия, която не изпраща
			нищо; и изпълнение, което е неуспешно по наша вина.
			<em>Действие</em> е заявка на собствения ви агент чрез KIFF
			Cloud, която е свършила нещо: KIFF я е разрешил, тя е
			изпратена и инструментът е съобщил за успех. Никога не се
			отчита като действие: заявка, която е отказана, задържана и
			след това отказана, спряна при спиране, невалидна, неуспешна
			в инструмента или с неизвестен резултат, както и заявка,
			която само чете.
		</p>
		<p>
			<strong>Без пробен период.</strong> Акаунтът плаща от първия
			ден. Преди даден план да започне, KIFF не стартира
			изпълнение на неговите tafs, освен настройването от Coach;
			нищо не се изтрива.
		</p>
		<p>
			<strong>Плащане и фактури.</strong> Планът се таксува на едно
			място. План, закупен на kiff.dev, се купува, променя и
			анулира там и в портала за плащания, към който той води,
			а плащанията му се обработват от Stripe. Solo, закупен в
			приложението tafs, се продава чрез App Store на iPhone и
			iPad или чрез Google Play на Android и се управлява в
			абонаментите ви в Apple или Google Play, съгласно условията
			на съответния магазин за плащане, подновяване и
			възстановяване. Пакетите кредити се купуват в приложението.
			Company се купува на kiff.dev. Таксите се фактурират
			месечно авансово; използването над включеното се фактурира
			със следващата фактура. Промяна в броя на хората се прилага
			от следващата фактура. Ако плащане е неуспешно и не бъде
			уредено, планът приключва и KIFF отказва заявките на
			акаунта, докато не бъде избран план.
		</p>
		<p>
			<strong>Анулиране.</strong> Можете да анулирате по всяко
			време в портала за плащания или, за Solo, закупен в
			приложението, в абонаментите си в Apple или Google Play. Планът продължава до края на
			платения период и не се подновява. Освен когато законът
			изисква друго, вече платените такси не се възстановяват.
			Ако сте потребител в ЕС, можете да се откажете в срок от
			14 дни от покупката, без да посочвате причина, и ние ви
			възстановяваме платеното, намалено с частта за дните, през
			които планът вече е работил.
			Покупките на Solo се възстановяват чрез App Store или Google Play, съгласно техните условия.
		</p>
		<p>
			<strong>Микропредприятия.</strong> Ако вашата фирма има по-малко от 10 души и годишен оборот или обща сума на баланса до 2 милиона евро, я третираме като потребител за всички правила в тези условия относно плащания с карта, включително за Company.
		</p>
		<p>
			<strong>ДДС.</strong> Цените на Company не включват ДДС; Solo
			и пакетите кредити се продават от App Store или Google
			Play с включен ДДС. Kiff Agents OÜ
			(ДДС номер EE102924327) начислява естонски ДДС, когато е
			приложимо. Продажбите между предприятия в ЕС на Клиент
			извън Естония с валиден идентификационен номер по ДДС се
			фактурират по механизма за обратно начисляване на ЕС.
		</p>
		<p>
			<strong>Промени.</strong> Уведомяваме активните акаунти
			писмено поне тридесет дни предварително за увеличение на
			цените (§16). Намалението на цените се прилага от следващата
			фактура.
		</p>
	</section>
}

templ termsTermBG() {
	<section id="term">
		<h2>9. Срок и прекратяване</h2>
		<p>
			Тези условия влизат в сила, когато за първи път използвате
			Услугата, и действат до прекратяването им.
		</p>
		<p>
			Можете да ги прекратите по всяко време, като изтриете
			акаунта си. Ние можем да ги прекратим (а) при съществено
			нарушение, което не е отстранено в срок от тридесет дни от
			писменото уведомление, или (б) незабавно при нарушения на
			Политиката за допустима употреба или при несъстоятелност.
		</p>
		<p id="leaving">
			<strong>Напускане и вземане на данните ви със себе си.</strong>
			Можете да експортирате данните си по всяко време в
			структуриран, машинночетим формат: в KIFF Настройки → Данни
			дава JSON файл с акаунта ви, вашите Cards с всяка тяхна
			версия, решенията в Регистъра ви (последните 10 000; за
			повече се обърнете към нас), подписаната разписка за всяко
			решение, което KIFF е разрешил, и данните за API ключовете
			ви (никога самите ключове). В приложението tafs всеки
			експортира собствените си чатове, файлове и бележки от
			Акаунт →  Експортиране на моите
			чатове; чатовете се съхраняват тридесет дни във всички
			случаи, както посочва политиката за поверителност.
			Изтриването на акаунта прекратява Услугата незабавно, затова
			първо експортирайте.
		</p>
		<p>
			Вместо това можете да напуснете с предизвестие, за да
			преминете към друг доставчик или към собствени системи,
			като пишете на
			<a href="mailto:support@kiff.dev">support@kiff.dev</a>.
			Никога не изискваме предизвестие, по-дълго от два месеца:
			предизвестието ви влиза в сила на избраната от вас дата, не
			по-късно от два месеца след изпращането му. От тази дата
			следва преходен период от тридесет дни, през който Услугата
			продължава да работи, вие експортирате данните си и
			премествате работата си, а ние помагаме при разумни искания
			за това. Можете да удължите преходния период веднъж, за
			колкото време ви е нужно. Ако технически не можем да го
			завършим за тридесет дни, ви уведомяваме в срок от
			четиринадесет работни дни от предизвестието ви, с причините
			и с нов срок, не по-дълъг от седем месеца. След преходния
			период данните ви остават достъпни за експортиране още поне
			тридесет дни. Таксите по плана продължават както обикновено
			до края на преходния период. Solo, закупен в App Store или
			Google Play, се анулира в магазина; преходният период и
			периодът за експортиране се прилагат по същия начин.
		</p>
		<p>
			Не начисляваме такси за напускане, смяна на доставчик или
			експортиране на данните ви. Този раздел предоставя на всеки
			клиент правата за смяна на доставчик по глава VI от
			Регламента на ЕС за данните (Регламент (ЕС) 2023/2854).
		</p>
		<p>
			При прекратяване и след всеки преходен период и период за
			експортиране изтриваме вашите Данни за одит, Данни на tafs и
			метаданни на акаунта в съответствие с правилата за
			съхранение в
			<a href="/bg/privacy#retention">политиката за поверителност</a>.
		</p>
		<p>
			Разпоредбите, които по своето естество следва да останат в
			сила след прекратяването, остават в сила — включително
			поверителността, интелектуалната собственост,
			обезщетяването, ограничаването на отговорността, отказите
			от гаранции, приложимото право и всички натрупани такси.
		</p>
	</section>
}

templ termsWarrantiesBG() {
	<section id="warranties">
		<h2>10. Гаранции</h2>
		<p>
			Всяка страна декларира, че има правото и правомощието да
			сключи и изпълни тези условия.
		</p>
		<p>
			Гарантираме, че ще предоставяме Услугата професионално и в
			съществено съответствие с Документацията. Единственото ви
			средство за защита при нарушение на тази гаранция е, по
			наш избор, повторно изпълнение или пропорционално
			възстановяване на таксите, отнасящи се до засегнатата
			Услуга за периода на нарушението.
		</p>
		<p>
			Гарантирате, че използването на Услугата от вас е в
			съответствие с приложимото право и тези условия.
		</p>
	</section>
}

templ termsDisclaimerBG() {
	<section id="disclaimer">
		<h2>11. Отказ от отговорност</h2>
		<p>
			С изключение на изричните гаранции в §10, Услугата се
			предоставя <strong>„такава, каквато е“ и „според
			наличността“</strong>. В максималната степен, разрешена от
			закона, отхвърляме всички други гаранции, изрични,
			подразбиращи се или законови, включително гаранциите за
			продаваемост, пригодност за определена цел, ненарушаване на
			права и всяка гаранция, произтичаща от търговска практика
			или обичай.
		</p>
		<p>
			Не гарантираме, че Услугата ще бъде непрекъсната, без
			грешки или без вредни компоненти, нито че данни няма да
			бъдат загубени или повредени. Вие отговаряте за
			архивирането на данните си.
		</p>
	</section>
}

templ termsLiabilityBG() {
	<section id="liability">
		<h2>12. Ограничаване на отговорността</h2>
		<p>
			В максималната степен, разрешена от закона, никоя от
			страните не носи отговорност пред другата за непреки,
			случайни, последващи, специални, примерни или наказателни
			вреди, включително пропуснати ползи, пропуснати приходи,
			загубени данни или прекъсване на дейността, произтичащи от
			или свързани с тези условия или Услугата, дори ако е била
			уведомена за възможността от такива вреди.
		</p>
		<p>
			Общата отговорност на всяка страна, произтичаща от или
			свързана с тези условия, няма да надвишава по-голямата от
			двете суми: (а) таксите, платени или дължими от Клиента на
			Kiff Agents OÜ през дванадесетте месеца преди събитието,
			породило отговорността, или (б) сто хиляди евро
			(100 000 €).
		</p>
		<p>
			Нищо в тези условия не ограничава и не изключва
			отговорност, която не може да бъде ограничена или изключена
			съгласно приложимото право, включително отговорност за
			смърт, телесна повреда, причинена по небрежност, измама или
			умишлено неправомерно поведение, както и отговорност за
			дефектен продукт съгласно законите, транспониращи
			Директива (ЕС) 2024/2853 относно отговорността за
			дефектни продукти.
		</p>
	</section>
}

templ termsIndemnityBG() {
	<section id="indemnification">
		<h2>13. Обезщетяване</h2>
		<p>
			Ще ви защитим срещу претенции на трети страни, че Услугата,
			така както я предоставяме и както я използвате в
			съответствие с тези условия, нарушава правата върху
			интелектуална собственост на тази трета страна, и ще
			платим присъденото окончателно срещу вас обезщетение (или
			договорената сума по споразумение) за такива претенции.
		</p>
		<p>
			Вие ще ни защитите срещу претенции на трети страни,
			произтичащи от (а) вашите данни или съдържание като Клиент;
			(б) използването от вас на Услугата в нарушение на тези
			условия (включително Политиката за допустима употреба);
			или (в) вашата груба небрежност или умишлено неправомерно
			поведение, и ще платите присъденото окончателно срещу нас
			обезщетение (или договорената сума по споразумение) за
			такива претенции.
		</p>
		<p>
			Обезщетяването е обусловено от своевременно уведомяване за
			претенцията, изключителен контрол върху защитата и
			споразумението от страна на обезщетяващия и разумно
			съдействие от страна на обезщетявания. Обезщетяващият не
			може без съгласие да сключи споразумение, което налага
			задължения на обезщетявания.
		</p>
	</section>
}

templ termsSLABG() {
	<section id="sla">
		<h2>14. Ангажимент за ниво на обслужване</h2>
		<p>
			При платен план <a href="/legal/sla">споразумението за ниво на
			обслужване</a> (на английски) определя наличността, която
			поемаме, как се отчита бавна или неуспешна заявка, нашите
			срокове за отговор на поддръжката и кредитите за услугата,
			когато не изпълним ангажимента си. То е част от тези условия.
		</p>
		<p>
			Оперативните практики, реагирането при инциденти и
			ангажиментите за уведомяване за нарушения са описани в
			датираната версия, към която препращат тези Условия
			(<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>);
			<a href="/security">/security</a> (на английски) показва
			текущите практики.
		</p>
	</section>
}

templ termsServiceModsBG() {
	<section id="service-mods">
		<h2>15. Промени в Услугата</h2>
		<p>
			Можем да добавяме, променяме или премахваме функции по
			всяко време. За съществено намаляване на функционалността
			или прекратяване на част от API, което нарушава
			документираното поведение, уведомяваме активните клиенти
			поне тридесет дни предварително, с публикуван график за
			прекратяването. Промени, наложени от съображения за
			сигурност, може да бъдат направени без уведомление, когато
			самото уведомление би създало риск.
		</p>
	</section>
}

templ termsTermsModsBG() {
	<section id="terms-mods">
		<h2>16. Промени в тези условия</h2>
		<p>
			Можем да изменяме тези условия от време на време. За
			съществени промени уведомяваме по имейл и с видим банер на
			тази страница поне тридесет дни предварително. Несъществени
			промени (пояснения, препратки) се публикуват с нова дата на
			„последна актуализация“. Продължаването на използването на
			Услугата след датата на влизане в сила на актуализацията
			представлява приемане.
		</p>
	</section>
}

templ termsForceMajeureBG() {
	<section id="force-majeure">
		<h2>17. Непреодолима сила</h2>
		<p>
			Никоя от страните не носи отговорност за неизпълнение или
			забава в изпълнението, доколкото те са причинени от
			обстоятелства извън нейния разумен контрол, включително
			природни бедствия, война, тероризъм, граждански
			безредици, трудови спорове, пожар, природни катастрофи,
			правителствени мерки, свързани с пандемия, прекъсвания на
			интернета или електрозахранването или действия на
			доставчици на далекосъобщителни услуги или на хостинг
			инфраструктура на трети страни.
		</p>
	</section>
}

templ termsGoverningLawBG() {
	<section id="governing-law">
		<h2>18. Приложимо право и компетентен съд</h2>
		<p>
			Тези условия се уреждат от правото на Република Естония,
			без оглед на нейните стълкновителни норми. Изключително
			компетентен за спорове е Окръжният съд Харю (Harju
			Maakohus) в Талин.
		</p>
		<p>
			Ако сте потребител с обичайно местопребиваване в друга
			държава членка на ЕС, императивните правила за защита на
			потребителите на вашата държава продължават да се прилагат,
			доколкото ви предоставят права, от които не можете да се
			откажете с договор; тази клауза не ви лишава от защитата на
			тези правила.
		</p>
	</section>
}

templ termsGeneralBG() {
	<section id="general">
		<h2>19. Общи разпоредби</h2>
		<p>
			<strong>Цялостно споразумение.</strong> Тези условия, заедно
			с политиката за поверителност, DPA, евентуалните поръчки и
			всички изрично включени допълнителни условия, представляват
			цялостното споразумение между нас относно техния предмет и
			заменят всички предходни или едновременни договорености.
		</p>
		<p>
			<strong>Делимост.</strong> Ако дадена разпоредба бъде
			призната за неприложима, останалите остават в сила.
		</p>
		<p>
			<strong>Прехвърляне.</strong> Не можете да прехвърляте тези
			условия без нашето писмено съгласие. Ние можем да ги
			прехвърлим без съгласие във връзка със сливане, придобиване
			или продажба на всички или почти всички наши активи, като
			ви уведомим.
		</p>
		<p>
			<strong>Липса на отказ от права.</strong> Неприлагането на
			разпоредба не представлява отказ от правото тя да бъде
			приложена по-късно.
		</p>
		<p>
			<strong>Уведомления.</strong> Уведомленията до Kiff Agents OÜ
			се изпращат на <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>
			или по пощата на адрес Tööstuse tn 75-71, Põhja-Tallinna
			linnaosa, Tallinn 10416, Естония. Уведомленията до вас се
			изпращат на имейла, свързан с акаунта ви, или, ако сте
			посочили такъв, на определения от вас адрес за правни
			уведомления.
		</p>
		<p>
			<strong>Независими изпълнители.</strong> Нищо в тези условия
			не създава съдружие, представителство, съвместно
			предприятие или трудово правоотношение.
		</p>
		<p>
			<strong>Трети лица бенефициери.</strong> Няма такива, освен
			доколкото обезщетявани свързани лица са изрично посочени.
		</p>
	</section>
}

