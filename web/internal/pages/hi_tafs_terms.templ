package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsTermsHI is tafs's terms (/tafs/terms) in Hindi, at /hi/tafs/terms.
// It is a translation of TafsTerms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Hindi has the legal
// texts only, so a link to any other page goes to English and says so.
templ TafsTermsHI() {
	@components.LayoutSiteWithMeta("tafs की शर्तें", "KIFF के ऐप tafs की शर्तें: इसे कौन उपलब्ध कराता है, आपका खाता, taf क्या करता है और आप उसे कैसे नियंत्रित करते हैं, स्वीकार्य उपयोग, शुल्क, दायित्व और समाप्ति।", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · शर्तें</p>
				<h1>tafs की शर्तें</h1>
				<p class="legal-meta"><strong>अंतिम अपडेट:</strong> 22 नवंबर 2026।</p>
				<p class="legal-disclaimer">ये शर्तें KIFF के ऐप tafs (iPhone, iPad, Android और कंप्यूटर के लिए) और उसके पीछे की सेवा के लिए हैं। tafs, KIFF Cloud का हिस्सा है; यह पृष्ठ वही दोहराता है जो <a href="/hi/terms">KIFF की सेवा की शर्तें</a> इसके बारे में कहती हैं, और उनमें कुछ नहीं जोड़ता। जो बात इस पृष्ठ में नहीं है, उस पर KIFF की शर्तें लागू होती हैं। प्रश्न: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>।</p>
			</header>
			<section id="provider">
				<h2>1. tafs कौन उपलब्ध कराता है</h2>
				<p>tafs को <strong>Kiff Agents OÜ</strong> उपलब्ध कराती है, जो एस्टोनिया की एक निजी सीमित देयता कंपनी है (पंजीकरण कोड 17372313), पता: Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, एस्टोनिया। खाता बनाकर या किसी और तरह से tafs का उपयोग करके आप इन शर्तों और KIFF की शर्तों से सहमत होते हैं। यदि आप किसी कंपनी की ओर से स्वीकार करते हैं, तो आप पुष्टि करते हैं कि आपको उसे बाध्य करने का अधिकार है।</p>
			</section>
			<section id="account">
				<h2>2. आपका खाता</h2>
				<p>आप tafs में अपने KIFF खाते से साइन इन करते हैं। सही जानकारी दें, अपने क्रेडेंशियल गोपनीय रखें; आप अपने खाते की सारी गतिविधि और अपने खाते में आने देने वाले हर व्यक्ति के लिए जिम्मेदार हैं। आपकी आयु कम से कम 16 वर्ष होनी चाहिए, या आपके निवास स्थान पर डिजिटल सहमति की आयु, जो भी अधिक हो। tafs का उपयोग केवल ऐसे देश या क्षेत्र से किया जा सकता है जहाँ Anthropic अपनी सेवा देती है, जैसा <a href="https://www.anthropic.com/supported-countries">Anthropic उन्हें सूचीबद्ध करती है</a>; ऐसी कंपनी के लिए नहीं जिसका मुख्यालय उस सूची से बाहर किसी देश या क्षेत्र में है, या जिसका अधिकांश स्वामित्व या नियंत्रण उस सूची से बाहर मुख्यालय वाली किसी कंपनी के पास है; और तब नहीं जब आप, या वह कंपनी जिसके लिए आप इसका उपयोग करते हैं, यूरोपीय संघ, संयुक्त राष्ट्र या संयुक्त राज्य अमेरिका के प्रतिबंधों के अधीन हों (KIFF की शर्तें, §4)।</p>
			</section>
			<section id="what-a-taf-does">
				<h2>3. taf क्या करता है</h2>
				<p>tafs में आप एक taf को काम सौंपते हैं: एक AI एजेंट जो आपके जोड़े गए टूल के साथ, आपके द्वारा उसके लिए जारी किए गए KIFF Card के दायरे में, निर्धारित समय पर काम करता है। वह जो AI मॉडल उपयोग करता है, उसे Anthropic उपलब्ध कराती है। Setup, tafs का एक AI एजेंट, आपको टूल जोड़ने और taf बनाने में मदद करता है, लेकिन अपने आप कुछ नहीं जोड़ता: आप टूल के अपने प्रदाता पर साइन इन करते हैं, और हर कनेक्शन, taf जिन टूल का उपयोग कर सकता है, और उसके Card को अपने डिवाइस पर मंज़ूर करते हैं।</p>
				<p>taf की रिपोर्ट, संदेश और मेमोरी नोट एक AI मॉडल लिखता है और वे गलत हो सकते हैं। भरोसा करने से पहले जो बातें मायने रखती हैं, उन्हें जाँच लें। taf आपकी कंपनी के बाहर किसी को जो भी लिखता है, उसमें बताया जाता है कि उसे एक AI एजेंट ने लिखा है।</p>
			</section>
			<section id="control">
				<h2>4. आपका नियंत्रण: Card और मंज़ूरियाँ</h2>
				<p>taf आपके टूल तक केवल KIFF के ज़रिए पहुँचता है, जो हर कॉल को भेजने से पहले taf के Card से जाँचता है। आपके जारी किए Card के दायरे में की गई कॉल आपके निर्देश पर की जाती है। Card के बाहर की कॉल रोकी जाती है या अस्वीकार की जाती है, जैसा Card कहता है। रोकी गई कॉल तभी की जाती है जब आपका खाता जिसे रोकी गई कॉल का उत्तर देने की अनुमति देता है, वह उसे मंज़ूर कर दे।</p>
				<p>आप हर taf का काम और Card चुनते हैं, उसकी रोकी गई कॉल का उत्तर देते हैं, और यह सुनिश्चित करते हैं कि आपको अपने जोड़े गए टूल और खातों का उपयोग करने का अधिकार है। आप एक taf या सभी को रोक सकते हैं, किसी taf को रोककर रख सकते हैं, उसका कोई भी Card रद्द कर सकते हैं, या उसे हटा सकते हैं। जिस क्षण आप taf को रोकते हैं या Card रद्द करते हैं, उसी क्षण से KIFF उस taf या उस Card के तहत कोई नई कॉल नहीं होने देता। टूल के प्रदाता को पहले ही भेजा जा चुका अनुरोध फिर भी पूरा हो सकता है: हम नई कॉल रोकते हैं, लेकिन प्रदाता ने जो कर दिया उसे पलट नहीं सकते। विवरण <a href="/hi/terms#tafs">KIFF की शर्तें, §3A</a> में हैं। जब कोई taf किसी चेकआउट पर उस साइट पर सहेजी गई विधि से भुगतान करता है, तो वह यह केवल Card के भीतर और आपके फ़ोन पर उस भुगतान को मंज़ूर करने के बाद ही करता है; साइट और उसका भुगतान प्रदाता उसे संसाधित करते हैं, KIFF और planque आपका पैसा कभी अपने पास नहीं रखते, आपके कार्ड का विवरण कभी संग्रहीत नहीं करते, और taf कभी कार्ड नंबर नहीं टाइप करता।</p>
				<p>EU AI Act के तहत Kiff Agents OÜ tafs की प्रदाता है और आप उसके तैनातकर्ता (deployer) हैं। tafs का उपयोग केवल उन कामों के लिए करें जो वह देता है, और किसी ऐसे उपयोग के लिए नहीं जिसे AI Act प्रतिबंधित करता है या उच्च जोखिम वाला मानता है, जैसे किसी व्यक्ति के रोज़गार, ऋण या आवश्यक सेवाओं तक पहुँच के बारे में निर्णय।</p>
			</section>
			<section id="acceptable-use">
				<h2>5. स्वीकार्य उपयोग</h2>
				<p>आप, आपके लोग और आपके taf को <a href="/acceptable-use">स्वीकार्य उपयोग नीति</a> (अंग्रेज़ी में) का पालन करना होगा। एजेंट की कार्रवाई आपकी कार्रवाई है। अन्य बातों के साथ, आप tafs का उपयोग कानून तोड़ने, किसी ऐसे सिस्टम या खाते पर कार्रवाई करने जिसके उपयोग का आपको अधिकार नहीं है, ऐसे साइन-इन से टूल जोड़ने जो आपका नहीं है, स्पैम भेजने, या किसी Card, सीमा या रोक को दरकिनार करने के लिए नहीं कर सकते। विश्वसनीय उल्लंघन पर हम तुरंत निलंबित कर सकते हैं।</p>
			</section>
			<section id="fees">
				<h2>6. शुल्क</h2>
				<p>इस अपडेट के समय Solo { tafsCostHI.money(TafsSoloCents) } प्रति माह है, VAT सहित, प्रति माह { tafsCostHI.number(TafsSoloCredits) } क्रेडिट के साथ, जो ऐप में App Store या Google Play के माध्यम से बिकता है। ऐप में खरीदे गए क्रेडिट पैक { tafsCostHI.money(TafsPackCents[TafsSoloCredits]) } से शुरू होते हैं; उनकी अवधि समाप्त नहीं होती। taf की हर रन अपने उपयोग किए AI के लिए क्रेडिट खर्च करती है। Coach और taf बनाना, Coach के उचित उपयोग के भीतर, शामिल हैं। ये यूरो क्षेत्र की कीमतें हैं। अन्यत्र, App Store या Google Play आपकी मुद्रा में कीमत दिखाता है, उस देश के नियमों के अनुसार स्थानीय कर के साथ या बिना, और वही कीमत आप चुकाते हैं। मौजूदा कीमतें <a href="/pricing">कीमतों के पृष्ठ</a> (अंग्रेज़ी में) पर हैं; tafs KIFF की Company योजना का भी हिस्सा है।</p>
				<p>कोई ट्रायल नहीं है। ऐप में खरीदा गया Solo आपकी Apple या Google Play सदस्यताओं में, उस स्टोर की भुगतान, नवीनीकरण और रिफंड की शर्तों के तहत, प्रबंधित और रद्द किया जाता है। योजना आपके भुगतान की अवधि के अंत तक चलती है। यदि आप EU में उपभोक्ता हैं, तो आप खरीद के 14 दिनों के भीतर वापस ले सकते हैं। विवरण <a href="/hi/terms#fees">KIFF की शर्तें, §8</a> में हैं।</p>
			</section>
			<section id="liability">
				<h2>7. दायित्व</h2>
				<p>KIFF की शर्तों (§10) की वारंटियों को छोड़कर, tafs "जैसा है" और "जैसा उपलब्ध है" के आधार पर दिया जाता है। कानून जितना अनुमति देता है, उस सीमा तक, कोई भी पक्ष अप्रत्यक्ष या परिणामी नुकसान के लिए उत्तरदायी नहीं है, और हर पक्ष का कुल दायित्व उसी तरह सीमित है जैसा <a href="/hi/terms#liability">KIFF की शर्तें, §12</a> कहती हैं। जिस दायित्व को कानून सीमित करने की अनुमति नहीं देता, उसे कुछ भी सीमित नहीं करता।</p>
			</section>
			<section id="termination">
				<h2>8. समाप्ति</h2>
				<p>आप कभी भी रुक सकते हैं: ऐप में अपना खाता, खाता → <em>खाता हटाएँ</em> में हटा दें। पहले अपनी चैट खाता → मेरी चैट निर्यात करें से निर्यात करें। हम सूचना के तीस दिनों के भीतर ठीक न किए गए गंभीर उल्लंघन पर, या स्वीकार्य उपयोग के उल्लंघन पर तुरंत, आपका उपयोग समाप्त कर सकते हैं। छोड़ने और अपना डेटा साथ ले जाने के आपके अधिकार <a href="/hi/terms#term">KIFF की शर्तें, §9</a> में हैं।</p>
			</section>
			<section id="governing-law">
				<h2>9. बदलाव और लागू कानून</h2>
				<p>हम इन शर्तों को उसी तरह बदलते हैं जैसा KIFF की शर्तें अपने लिए कहती हैं (§16)। ये एस्टोनिया गणराज्य के कानूनों से शासित हैं, और विवाद तालिन की Harju County Court में जाते हैं। यदि आप किसी अन्य EU सदस्य देश में उपभोक्ता हैं, तो आपके देश के अनिवार्य उपभोक्ता संरक्षण नियम फिर भी लागू होते हैं।</p>
			</section>
			<section id="contact">
				<h2>10. संपर्क</h2>
				<p>अनुबंध संबंधी प्रश्न: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>। ऐप में मदद: <a href="mailto:support@kiff.dev">support@kiff.dev</a>। गोपनीयता: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>, और tafs व्यक्तिगत डेटा को कैसे संभालता है, यह <a href="/hi/tafs/privacy">tafs गोपनीयता नीति</a> में है।</p>
			</section>
		</article>
	}
}
