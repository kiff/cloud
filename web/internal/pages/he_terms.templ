package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// TermsHE is KIFF's terms (/terms) in Hebrew, at /he/terms.
// It is a translation of Terms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Hebrew has the legal
// texts only, so a link to any other page goes to English and says so.
templ TermsHE() {
	@components.LayoutSite("KIFF — terms of service", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@termsHeadHE()
			@termsDefinitionsHE()
			@termsAgreementHE()
			@termsServiceHE()
			@termsTafsHE()
			@termsAccountHE()
			@termsAcceptableUseHE()
			@termsCustomerDataHE()
			@termsConfidentialityHE()
			@termsFeesHE()
			@termsTermHE()
			@termsWarrantiesHE()
			@termsDisclaimerHE()
			@termsLiabilityHE()
			@termsIndemnityHE()
			@termsSLAHE()
			@termsServiceModsHE()
			@termsTermsModsHE()
			@termsForceMajeureHE()
			@termsGoverningLawHE()
			@termsGeneralHE()
			@termsContactHE()
		</article>
	}
}

templ termsHeadHE() {
	<header class="legal-head">
		<p class="legal-badge">תנאי שירות · v0.1</p>
		<h1>תנאי שירות</h1>
		<p class="legal-meta">
			<strong>עודכן לאחרונה:</strong> 22 בנובמבר 2026. <strong>תאריך כניסה לתוקף:</strong> 24 במאי 2026.
		</p>
		<p class="legal-disclaimer">
			<strong>מה השתנה:</strong> עם מי החוזה שלכם כשעסק אחר הכיר לכם אותנו (§2), ומיקרו-עסקים (§8). קודם: מי רשאי להשתמש בשירות, לפי אזור, בעלות וסנקציות (§4); אפליקציית tafs ב-Android, ו-Solo שנרכש דרך Google Play (§1, §8). לפני כן: תוכניות בתשלום (§3A, §8), <a href="/legal/sla">הסכם רמת השירות</a> (באנגלית) (§14), ורשימת השימושים האסורים, שנמצאת עכשיו ב<a href="/acceptable-use">מדיניות השימוש המקובל</a> (באנגלית) (§5).
		</p>
		<p class="legal-disclaimer">
			תנאים אלה חלים על השימוש ב-KIFF Cloud, כולל tafs. שאלות חוזיות: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</header>
}

templ termsDefinitionsHE() {
	<section id="definitions">
		<h2>1. הגדרות</h2>
		<ul>
			<li><strong>“Kiff Agents OÜ”</strong>, <strong>“אנחנו”</strong>, <strong>“לנו”</strong>, <strong>“שלנו”</strong> — החברה הפרטית בערבון מוגבל האסטונית שמספקת את השירות. מספר רישום 17372313.</li>
			<li><strong>“הלקוח”</strong>, <strong>“אתם”</strong>, <strong>“שלכם”</strong> — האדם הטבעי או המשפטי שמסכים לתנאים אלה.</li>
			<li><strong>“משתמש”</strong> — כל אדם שהלקוח מתיר לו לגשת לשירות דרך חשבון הלקוח.</li>
			<li><strong>“השירות”</strong> — מוצר KIFF Cloud, כולל <code>api.kiff.dev</code>, <code>app.kiff.dev</code>, <code>kiff.dev</code>, tafs, והתיעוד, לוחות הבקרה וממשקי ה-API שאנו מפרסמים שם.</li>
			<li><strong>“tafs”</strong> — אפליקציית tafs ל-iPhone, ל-iPad, ל-Android ולמחשבים (Mac, Windows ו-Linux) והשירות שמאחוריה, כולל Setup ו-planque (§3A), שבהם לקוח מוסר משימה לסוכן בינה מלאכותית שפועל בתוך כרטיסי KIFF. <strong>“taf”</strong> הוא סוכן כזה.</li>
			<li><strong>“דייר”</strong> — סביבת עבודה מבודדת לוגית בתוך השירות ששייכת ללקוח יחיד.</li>
			<li><strong>“נתוני ביקורת”</strong> — האירועים, ההחלטות, הפעולות, האישורים והקבלות שהשירות שומר מטעם הלקוח באמצעות סביבת הריצה.</li>
			<li><strong>“נתוני tafs”</strong> — מה ש-tafs שומרת מטעם הלקוח: ההרצות והשיחות של כל taf (כולל מה שהכלים המחוברים של הלקוח מחזירים לו), הדוחות שלו, הערות הזיכרון שלו, והטלפונים הרשומים להתראות שלו.</li>
			<li><strong>“קבלה”</strong> — רשומת החלטה חתומה ומוגדרת-גרסה שהשירות מפיק לכל פעולה מוסדרת.</li>
			<li><strong>“תיעוד”</strong> — התיעוד הטכני של השירות ואמצעי האבטחה בגרסה המתוארכת שמקושרת מתנאים אלה (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>). הוא אינו כולל את הספר הלבן האסטרטגי, חומרי שיווק ותיעוד של מסגרת הקוד הפתוח המורשית בנפרד.</li>
			<li><strong>“DPA”</strong> — הסכם עיבוד המידע בכתובת <a href="/legal/dpa">/legal/dpa</a> (באנגלית), שמסדיר את היחסים שלנו כמעבד.</li>
		</ul>
	</section>
}

templ termsAgreementHE() {
	<section id="agreement">
		<h2>2. ההסכם</h2>
		<p>
			תנאים אלה חלים על השימוש שלכם בשירות. בעצם יצירת חשבון, יצירת מפתח API או שימוש אחר בשירות, אתם מסכימים לתנאים אלה. אם אתם מסכימים מטעם חברה או גוף משפטי אחר, אתם מצהירים שיש לכם סמכות לחייב אותו, ו“אתם” ו“שלכם” מתייחסים לאותו גוף.
		</p>
		<p>
			אם מפתח, שותף או עסק אחר הכיר לכם את KIFF או בנה את הסוכן שבו אתם משתמשים, החוזה שלכם לשירות הוא ישירות איתנו, לפי תנאים אלה, ואתם מקבלים אותם בעצמכם. אותו עסק אינו הסוכן שלנו: הוא אינו יכול לקבל תנאים אלה, לתת הסכמה או לאשר תשלום בשמכם, והוא אינו מוכר את השירות מטעמנו.
		</p>
		<p>
			אנו עשויים לפרסם תנאים משלימים לתכונות מסוימות (תכונות בטא, אינטגרציות של צד שלישי). כשהם סותרים תנאים אלה, התנאים המשלימים גוברים לגבי התכונה המסוימת.
		</p>
	</section>
}

templ termsServiceHE() {
	<section id="service">
		<h2>3. השירות</h2>
		<p>
			KIFF Cloud הוא שירות מתארח להסדרת פעולות שהואצלו. הוא בוחן בקשות מול ההרשאות והכרטיסים שהוגדרו אצל הלקוח, עשוי לדרוש אישור אנושי, ורושם החלטות ממשל. בהתאם לאינטגרציה שהוגדרה, KIFF מעבירה בקשה מורשית או מספקת אישור שהמערכת המוגנת מאמתת. המערכת המחוברת מבצעת את הפעולה עצמה.
		</p>
		<p>
			ההתנהגות הטכנית החלה, הראיות, דרישות האינטגרציה ומגבלות הביצוע מפורטות בתיעוד המתוארך שמקושר מתנאים אלה. <a href="/whitepaper">הספר הלבן</a> (באנגלית) האסטרטגי מסביר את העקרונות והמודל של KIFF; הוא אינו משולב כתיעוד טכני לפי תנאים אלה.
		</p>
		<p>
			שירות הממשל של KIFF Cloud הוא <em>לא</em> מסגרת סוכנים, מנוע זרימות עבודה, שער מודלים או פלטפורמת סוכנים מנוהלת. הוא משתלב עם כל מה שאתם כבר משתמשים בו. ראו <a href="/#not">“מה KIFF איננה”</a> (באנגלית) בדף הבית לרשימה המפורשת. tafs היא החלק היחיד בשירות שמריץ סוכנים בשבילכם, בתוך הכרטיסים שאתם מנפיקים; §3A מתאר אותה.
		</p>
		<p>
			מסגרת הקוד הפתוח <a href="https://github.com/kiff/kiff" target="_blank" rel="noopener">kiff/kiff</a> כפופה לרישיון MIT שלה ואינה חלק מתנאים אלה. כשאתם מריצים את המסגרת בתשתית שלכם, לא נוצר חוזה עם Kiff Agents OÜ.
		</p>
	</section>
}

templ termsTafsHE() {
	<section id="tafs">
		<h2>3A. tafs</h2>
		<p>
			ב-tafs אתם מוסרים משימה (למשל החזרים, תשלום חשבונות או מחלוקות כרטיס) ל-taf: סוכן בינה מלאכותית שעובד לפי לוח זמנים עם הכלים שאתם מחברים, בתוך כרטיסי KIFF שאתם מנפיקים עבורו. כל taf רץ על סביבת הסוכנים שלנו, ו-Anthropic מספקת את מודל הבינה המלאכותית שהוא משתמש בו. אתם עונים על הקריאות המעוכבות שלו באפליקציית tafs.
		</p>
		<p>
			<strong>חיבור הכלים שלכם.</strong> Setup, סוכן בינה מלאכותית ב-tafs שרץ כמו taf, עוזר לכם לחבר כלי ולהקים taf למשימה. הוא אינו מחבר דבר בעצמו. אתם נכנסים אצל הספק של הכלי עצמו (למשל Stripe), ומאשרים במכשיר שלכם כל חיבור, את הכלים ש-taf רשאי להשתמש בהם ואת הכרטיסים שלו. האסימון מההתחברות הזו נשמר בידי planque, שירות החיבור שלנו. הוא מוצפן, משמש רק לביצוע קריאה ש-KIFF החליטה עליה, ולעולם אינו ניתן ל-taf. ניתוק כלי שולל את האסימון אצל הספק ומוחק אותו.
		</p>
		<p>
			<strong>הכרטיסים שלכם הם ההוראות שלכם.</strong> taf מגיע לכלים שלכם רק דרך KIFF, שבודקת כל קריאה מול הכרטיסים של ה-taf לפני שהיא נשלחת. קריאה בתוך כרטיס שהנפקתם מבוצעת על פי הוראתכם. קריאה מחוץ לכרטיס מעוכבת או נדחית, כפי שהכרטיס קובע. קריאה מעוכבת מבוצעת רק לאחר שמי שהחשבון שלכם מתיר לו לענות על קריאות מעוכבות מאשר אותה. באפליקציית tafs התשובה נושאת חתימה מהמכשיר שלו ש-KIFF מאמתת, והקבלה שומרת את ההוכחה הזו. החשבון שלכם יכול לענות גם ב-KIFF עצמה (לוח הבקרה, כלי שורת הפקודה שלה, או מאשר שהרשיתם שם); הקבלה רושמת אז מי ענה ואיך.
		</p>
		<p>
			<strong>תשלומים.</strong> כשtaf משלם בשבילך בקופה של אתר, בכרטיס או באמצעי תשלום אחר ששמרת באתר הזה, הוא עושה זאת רק בתוך Card ורק אחרי שאישרת את התשלום הזה בטלפון. האישור שלך מסמיך את התשלום האחד הזה בלבד בשמך. האתר וספק התשלומים שלו מעבדים אותו. KIFF ו-planque לעולם אינם מחזיקים את הכסף שלך, לעולם אינם שומרים את פרטי הכרטיס שלך, וtaf לעולם אינו מקליד מספר כרטיס.
		</p>
		<p>
			<strong>מה שנשאר אצלכם.</strong> אתם בוחרים את המשימה והכרטיסים של כל taf, עונים על הקריאות המעוכבות שלו, ומוודאים שמותר לכם להשתמש בכלים ובחשבונות שאתם מחברים. הדוחות, ההודעות והערות הזיכרון של taf נכתבים בידי מודל בינה מלאכותית ויכולים להיות שגויים; בדקו מה שחשוב לפני שאתם נשענים עליו.
		</p>
		<p>
			<strong>עצירת taf.</strong> אפשר לעצור (halt) taf אחד או את כולם, להשהות taf, לשלול כל אחד מהכרטיסים שלו, או להסיר אותו. מהרגע שאתם עוצרים taf או שוללים כרטיס, KIFF אינה מתירה שום קריאה חדשה תחתיו. אפליקציית tafs מציגה taf כעצור רק לאחר ש-KIFF ו-planque אישרו שתיהן את העצירה; מאותו רגע planque אינה שולחת אף אחת מהקריאות שלו, כולל קריאה ש-KIFF התירה רגע לפני כן. בקשה שכבר נשלחה לספק של כלי עשויה עדיין להסתיים: אנו עוצרים קריאות חדשות, ואיננו יכולים לבטל מה שספק כבר עשה. כלי שבודק בעצמו את אישורי KIFF, בלי planque, עשוי עדיין לקבל אישור ש-KIFF הנפיקה רגע לפני כן, לכל היותר 90 שניות. חידוש taf עצור מחייב את אישורכם במכשיר שלכם, ושום דבר שהוחזק או הועמד בתור לפני העצירה אינו רץ אחריה.
		</p>
		<p>
			<strong>הסרת taf</strong> עוצרת את לוח הזמנים שלו ומוחקת את ההרצות, השיחות, הזיכרון והמפתח שבו השתמש. עוד לפני כן, מה שהכלים שלכם מחזירים ל-taf נשמר רק עד שההרצה שלו מסתיימת (מה ששיחה רק קראה, מוצפן, להודעותיה הבאות: בשימוש לכל היותר ארבע שעות, ואז נמחק), וההרצות והשיחות שלו 30 ימים. KIFF שומרת את הקבלות על מה שעשתה.
		</p>
		<p>
			<strong>חוק הבינה המלאכותית של האיחוד האירופי.</strong> לגבי tafs, Kiff Agents OÜ היא ספקית מערכת הבינה המלאכותית ואתם הפורסים שלה. אנו מוודאים שכל דבר ש-taf כותב למי שמחוץ לחברה שלכם מציין שסוכן בינה מלאכותית כתב אותו. אתם משתמשים ב-tafs רק למשימות שהיא מציעה, ולא לשום שימוש שחוק הבינה המלאכותית אוסר או מסווג כבעל סיכון גבוה, כמו החלטות על תעסוקה, אשראי או גישה לשירותים חיוניים של אדם. אתם שומרים על האישורים האנושיים שהכרטיסים שלכם דורשים, ומוודאים שמי שמשתמש ב-tafs עבורכם מבין מה היא עושה ומה מגבלותיה.
		</p>
		<p>
			<strong>עלויות.</strong> tafs היא חלק מהתוכנית שלכם ב-KIFF (§8): כל הרצה של taf משתמשת בקרדיטים עבור הבינה המלאכותית שבה השתמשה. Coach והקמת tafs כלולים במסגרת השימוש ההוגן של Coach.
		</p>
	</section>
}

templ termsAccountHE() {
	<section id="account">
		<h2>4. חשבונות וגישה</h2>
		<p>
			כדי להשתמש בשירות עליכם ליצור חשבון. אתם מסכימים למסור פרטי הרשמה מדויקים, לשמור את האישורים שלכם בסוד, ולהיות אחראים לכל הפעילות בחשבונכם.
		</p>
		<p>
			עליכם להיות בני 16 לפחות, או בגיל ההסכמה הדיגיטלית בתחום השיפוט שלכם, הגבוה מביניהם. השירות אינו מיועד לילדים.
		</p>
		<p>
			השירות מוצע רק במדינות ובאזורים שבהם Anthropic, שמספקת את מודל הבינה המלאכותית שלו, מציעה את השירות שלה עצמה, כפי ש<a href="https://www.anthropic.com/supported-countries">Anthropic מפרטת אותם</a>. אסור להשתמש בו מכל מקום אחר. חברה אינה רשאית להשתמש בו אם מושבה, או מושבה של חברה שמחזיקה ברוב הבעלות או בשליטה בה, נמצא במדינה או באזור שמחוץ לרשימה זו, בכל מקום שבו המשתמשים שלה נמצאים. כמו כן אסור לכם להשתמש בו אם אתם, או החברה שבשבילה אתם משתמשים בו, כפופים לסנקציות של האיחוד האירופי, האו"ם או ארצות הברית. אנו מסרבים לחשבונות שמפרים כלל זה ורשאים להשעות חשבון כזה.
		</p>
		<p>
			אתם אחראים למעשיו של כל משתמש שאתם מתירים בחשבונכם. אנו רשאים להשעות חשבון או לשלול גישה בהודעה סבירה אם אנו מזהים הפרה אמינה של תנאים אלה. בהפרות של השימוש המקובל (ראו §5) ההשעיה יכולה להיות מיידית.
		</p>
	</section>
}

templ termsAcceptableUseHE() {
	<section id="acceptable-use">
		<h2>5. שימוש מקובל</h2>
		<p>
			אתם, המשתמשים שלכם והסוכנים שלכם חייבים לציית ל<a href="/acceptable-use">מדיניות השימוש המקובל</a> (באנגלית). היא חלק מתנאים אלה ומפרטת למה אסור להשתמש בשירות.
		</p>
		<p>
			אנו רשאים להשעות מיד בהפרה אמינה של מדיניות השימוש המקובל. איננו מחויבים לפקח על תוכן הלקוח, אך רשאים לפעול על סמך דיווחים אמינים.
		</p>
	</section>
}

templ termsCustomerDataHE() {
	<section id="customer-data">
		<h2>6. נתוני הלקוח ותוכנו</h2>
		<p>
			נתוני הביקורת שלכם הם שלכם. אתם מעניקים ל-Kiff Agents OÜ רישיון מוגבל, לא בלעדי, ללא תמלוגים, עולמי, לאחסן, להעתיק, להעביר, להציג ולעבד בדרך אחרת את נתוני הביקורת שלכם אך ורק כנדרש להפעלה, לתחזוקה ולשיפור של השירות עבורכם.
		</p>
		<p>
			אנו פועלים כ<strong>מעבד</strong> של נתוני הביקורת שלכם ונתוני ה-tafs שלכם לפי סעיף 28 ל-GDPR; ה-<a href="/legal/dpa">DPA</a> (באנגלית) מסדיר את היחסים האלה בפירוט. אנו פועלים כ<strong>בקר</strong> של מטא-נתוני החשבון שלכם; <a href="/he/privacy">מדיניות הפרטיות</a> מסדירה את היחסים האלה.
		</p>
		<p>
			אתם מצהירים שיש לכם כל הזכויות הנחוצות למסירת המידע שאתם מוסרים, ושהמסירה עומדת בחוקים החלים (כולל חוקי הגנת מידע, ובמקום שהוא חל, חוק הבינה המלאכותית של האיחוד האירופי).
		</p>
	</section>
}

templ termsConfidentialityHE() {
	<section id="confidentiality">
		<h2>7. סודיות</h2>
		<p>
			כל צד עשוי לקבל מהצד האחר מידע שאינו פומבי (“מידע סודי”). הצד המקבל ישתמש במידע סודי רק כנדרש לביצוע התחייבויותיו ולמימוש זכויותיו לפי תנאים אלה, ויגן עליו לפחות באותה מידת זהירות שבה הוא נוהג במידע הסודי של עצמו.
		</p>
		<p>
			מידע סודי אינו כולל מידע ש-(א) הוא או נעשה זמין לציבור ללא הפרה, (ב) היה ידוע לצד המקבל לפני הגילוי, (ג) פותח באופן עצמאי ללא שימוש במידע הסודי, או (ד) חובה לגלותו על פי דין (בהודעה לצד האחר במקום שהדבר מותר).
		</p>
	</section>
}

templ termsFeesHE() {
	<section id="fees">
		<h2>8. תשלומים ועמלות</h2>
		<p>
			<strong>תוכניות.</strong> לכל חשבון תוכנית אחת. המחירים הנוכחיים נמצאים ב<a href="/pricing">דף התמחור</a> (באנגלית); בעת עדכון זה:
		</p>
		<ul>
			<li><strong>Solo:</strong> אדם אחד, עבור tafs, נמכרת באפליקציית tafs דרך App Store או Google Play ב-€12.50 לחודש, כולל מע"מ, וכוללת 500 קרדיטים בחודש.</li>
			<li><strong>Company:</strong> €10.50 לחודש לכל מושב, עם 500 קרדיטים בחודש לכל מושב, במאגר משותף, ועבור קריאות הסוכנים שלכם דרך KIFF Cloud, 500 פעולות בחודש לכל מושב, במאגר משותף.</li>
			<li><strong>הסכם:</strong> העמלות והתנאים שבטופס ההזמנה שלו.</li>
		</ul>
		<p>
			מושבים הם המנהלים והעורכים של חשבון. מאשרים וצופים הם חינם בכל תוכנית. ב-Company, מעבר לכלול, קרדיט עולה €0.01 ופעולה €0.02. קרדיטים מעבר לכלולים מחויבים עד מגבלת ההוצאה החודשית שהחשבון קובע (€50 כשהיא מתחילה): במגבלה, KIFF אינה מתחילה הרצה חדשה של ה-tafs של החשבון עד שהתקופה הבאה מתחילה, או שמי שמנהל את החיוב מעלה אותה.
		</p>
		<p>
			<strong>חבילות קרדיטים.</strong> ב-Solo, קרדיטים מעבר לכלולים בחודש מגיעים מחבילות קרדיטים, שנרכשות באפליקציית tafs. חבילה נרכשת פעם אחת, אינה פוקעת ואינה מנוי; הקרדיטים שלה משמשים אחרי הכלולים בחודש, החבילה הוותיקה ביותר קודם. חבילה שתשלומה הוחזר במלואו נלקחת בחזרה, עם הקרדיטים שנותרו בה. כשקרדיטי החודש והחבילות נגמרו, KIFF אינה מתחילה הרצה חדשה של ה-tafs של החשבון עד שהתקופה הבאה מתחילה או שמתווספת חבילה. קרדיטי בונוס ש-KIFF מוסיפה לחשבון אינם פוקעים אף הם, כמו חבילות.
		</p>
		<p>
			<strong>מה נספר.</strong> <em>קרדיט</em> משלם עבור הבינה המלאכותית שהרצה של taf השתמשה בה, בקרדיטים שלמים, מעוגל כלפי מעלה פעם אחת להרצה ונספר פעם אחת, כשההרצה מסתיימת. הרצה שהקריאה שלה נדחתה בידי KIFF עדיין השתמשה בבינה המלאכותית שלה. לעולם לא נספרים: Coach והקמת tafs, במסגרת השימוש ההוגן של Coach; ניסוי של גרסה חדשה, שאינו שולח דבר; והרצה שנכשלה מצדנו. <em>פעולה</em> היא קריאה של הסוכן שלכם דרך KIFF Cloud שהשיגה משהו: KIFF התירה אותה, היא נשלחה, והכלי דיווח על הצלחה. לעולם לא נספרת כפעולה: קריאה שנדחתה, שעוכבה ואז נדחתה, שנעצרה בעצירה (halt), לא תקינה, שנכשלה בכלי, או שתוצאתה לא ידועה, וקריאה שרק קוראת.
		</p>
		<p>
			<strong>ללא ניסיון.</strong> חשבון משלם מהיום הראשון. לפני שתוכנית מתחילה, KIFF אינה מתחילה שום הרצה של ה-tafs שלו, מלבד ההקמה של Coach; דבר אינו נמחק.
		</p>
		<p>
			<strong>תשלום וחשבוניות.</strong> תוכנית מחויבת במקום אחד. תוכנית שנרכשה ב-kiff.dev נרכשת, משתנה ומבוטלת שם ובפורטל החיוב שהוא מקשר אליו, והתשלומים שלה מעובדים בידי Stripe. Solo שנרכשה באפליקציית tafs נמכרת דרך App Store ב-iPhone וב-iPad, או Google Play ב-Android, ומנוהלת במנויי Apple או במנויי Google Play שלכם, לפי תנאי אותה חנות לתשלום, חידוש והחזרים. חבילות קרדיטים נרכשות באפליקציה. Company נרכשת ב-kiff.dev. העמלות מחויבות מדי חודש מראש; שימוש מעבר לכלול מחויב עם החשבונית הבאה. שינוי במספר האנשים חל מהחשבונית הבאה. אם תשלום נכשל ואינו מתוקן, התוכנית מסתיימת ו-KIFF דוחה את קריאות החשבון עד שתיבחר תוכנית.
		</p>
		<p>
			<strong>ביטול.</strong> אפשר לבטל בכל עת בפורטל החיוב, או, עבור Solo שנרכשה באפליקציה, במנויי Apple או במנויי Google Play שלכם. התוכנית נמשכת עד סוף התקופה ששילמתם עליה, ואינה מתחדשת. מלבד כנדרש בדין, עמלות ששולמו כבר אינן מוחזרות. אם אתם צרכנים באיחוד האירופי, אתם רשאים לבטל בתוך 14 ימים מהרכישה בלי לתת סיבה, ואנו מחזירים את מה ששילמתם בניכוי החלק עבור הימים שהתוכנית כבר רצה. רכישות Solo מוחזרות דרך App Store או Google Play, לפי תנאיהן.
		</p>
		<p>
			<strong>מיקרו-עסקים.</strong> אם בעסק שלכם פחות מ-10 אנשים ומחזור שנתי או סך מאזן של €2 מיליון לכל היותר, אנו מתייחסים אליו כצרכן לכל כלל בתנאים אלה על תשלומים בכרטיס, כולל Company.
		</p>
		<p>
			<strong>מע"מ.</strong> המחירים של Company אינם כוללים מע"מ; Solo וחבילות הקרדיטים נמכרות בידי App Store או Google Play כולל מע"מ. Kiff Agents OÜ (מספר מע"מ EE102924327) מוסיפה מע"מ אסטוני במקום שהוא חל. מכירות עסק-לעסק באיחוד האירופי ללקוח מחוץ לאסטוניה עם מספר זיהוי מע"מ תקף מחויבות במנגנון החיוב ההפוך של האיחוד האירופי.
		</p>
		<p>
			<strong>שינויים.</strong> אנו נותנים לחשבונות פעילים הודעה בכתב של שלושים יום לפחות על העלאת מחיר (§16). הורדת מחיר חלה מהחשבונית הבאה.
		</p>
	</section>
}

templ termsTermHE() {
	<section id="term">
		<h2>9. תקופה והפסקה</h2>
		<p>
			תנאים אלה נכנסים לתוקף כשאתם משתמשים בשירות לראשונה וממשיכים עד שיופסקו.
		</p>
		<p>
			אפשר להפסיק בכל עת על ידי מחיקת החשבון. אנו רשאים להפסיק (א) בשל הפרה מהותית שלא תוקנה בתוך שלושים יום מהודעה בכתב, או (ב) מיד בשל הפרות של השימוש המקובל או אירועי חדלות פירעון.
		</p>
		<p id="leaving">
			<strong>עזיבה, ולקיחת המידע שלכם איתכם.</strong> אפשר לייצא את המידע שלכם בכל עת, בפורמט מובנה וקריא למכונה: ב-KIFF, Settings ← Data נותן קובץ JSON עם החשבון שלכם, הכרטיסים שלכם עם כל גרסה, ההחלטות ב-Record שלכם (10,000 האחרונות; בקשו מאיתנו עוד), הקבלה החתומה של כל החלטה ש-KIFF התירה, ופרטי מפתחות ה-API שלכם (לעולם לא המפתחות עצמם). באפליקציית tafs כל אדם מייצא את השיחות, הקבצים וההערות שלו מ-Account ← Export my chats; שיחות נשמרות שלושים יום בכל מקרה, כפי שמדיניות הפרטיות קובעת. מחיקת החשבון מסיימת את השירות מיד, ולכן ייצאו קודם.
		</p>
		<p>
			אפשר לעזוב גם בהודעה, כדי לעבור לספק אחר או למערכות שלכם, בכתיבה אל <a href="mailto:support@kiff.dev">support@kiff.dev</a>. איננו דורשים לעולם יותר משני חודשי הודעה: ההודעה שלכם נכנסת לתוקף בתאריך שתבחרו, לא יאוחר משני חודשים אחרי ששלחתם אותה. מאותו תאריך נמשכת תקופת מעבר של שלושים יום, שבה השירות ממשיך לרוץ, אתם מייצאים את המידע שלכם ומעבירים את העבודה, ואנו עוזרים בבקשות סבירות לעשות זאת. אפשר להאריך את תקופת המעבר פעם אחת, כל עוד אתם זקוקים. אם איננו יכולים להשלים אותה מבחינה טכנית בשלושים יום, אנו מודיעים לכם בתוך ארבעה עשר ימי עבודה מההודעה, עם הסיבות ועם תקופה חדשה שלא תעלה על שבעה חודשים. אחרי תקופת המעבר, המידע שלכם נשאר זמין לייצוא לפחות שלושים יום נוספים. עמלות התוכנית ממשיכות כרגיל עד שתקופת המעבר מסתיימת. Solo שנרכשה ב-App Store או ב-Google Play מבוטלת בחנות; תקופות המעבר והייצוא חלות באותו אופן.
		</p>
		<p>
			איננו גובים על עזיבה, מעבר או ייצוא של המידע שלכם. סעיף זה נותן את זכויות המעבר של פרק VI בחוק הנתונים של האיחוד האירופי (תקנה (EU) 2023/2854) לכל לקוח.
		</p>
		<p>
			עם ההפסקה, ואחרי כל תקופת מעבר וייצוא, אנו מוחקים את נתוני הביקורת שלכם, את נתוני ה-tafs ואת מטא-נתוני החשבון בהתאם לכללי השמירה ב<a href="/he/privacy#retention">מדיניות הפרטיות</a>.
		</p>
		<p>
			סעיפים שמטבעם אמורים לשרוד את ההפסקה שורדים — כולל סודיות, קניין רוחני, שיפוי, הגבלת אחריות, התנערויות, הדין החל וכל עמלה שנצברה.
		</p>
	</section>
}

templ termsWarrantiesHE() {
	<section id="warranties">
		<h2>10. אחריות</h2>
		<p>
			כל צד מצהיר שיש לו הזכות והסמכות להתקשר בתנאים אלה ולבצעם.
		</p>
		<p>
			אנו מתחייבים שנספק את השירות באופן מקצועי ובהתאמה מהותית לתיעוד. התרופה היחידה שלכם להפרת התחייבות זו היא, לפי בחירתנו, ביצוע חוזר או החזר יחסי של העמלות המיוחסות לשירות שנפגע בתקופת ההפרה.
		</p>
		<p>
			אתם מתחייבים שהשימוש שלכם בשירות עומד בדין החל ובתנאים אלה.
		</p>
	</section>
}

templ termsDisclaimerHE() {
	<section id="disclaimer">
		<h2>11. הסתייגות מאחריות</h2>
		<p>
			מלבד ההתחייבויות המפורשות ב-§10, השירות ניתן <strong>“כמות שהוא” ו“כפי שהוא זמין”</strong>. עד למידה המרבית שהדין מתיר, אנו מתנערים מכל התחייבות אחרת, בין מפורשת, משתמעת או סטטוטורית, כולל התחייבויות לסחירות, להתאמה למטרה מסוימת, לאי-הפרה וכל התחייבות הנובעת מדרך התנהלות או מנוהג מסחרי.
		</p>
		<p>
			איננו מתחייבים שהשירות יהיה רציף, נטול שגיאות או נקי מרכיבים מזיקים, או שמידע לא יאבד או ייפגם. אתם אחראים לגבות את המידע שלכם.
		</p>
	</section>
}

templ termsLiabilityHE() {
	<section id="liability">
		<h2>12. הגבלת אחריות</h2>
		<p>
			עד למידה המרבית שהדין מתיר, אף צד לא יהיה אחראי כלפי הצד האחר לנזקים עקיפים, מקריים, תוצאתיים, מיוחדים, מופתיים או עונשיים, כולל אובדן רווחים, אובדן הכנסות, אובדן מידע או הפרעה לעסק, הנובעים מתנאים אלה או מהשירות או הקשורים אליהם, אפילו אם הוזהר מאפשרות נזקים כאלה.
		</p>
		<p>
			האחריות המצטברת של כל צד הנובעת מתנאים אלה או הקשורה אליהם לא תעלה על הגבוה מבין (א) העמלות ששולמו או שיש לשלם מהלקוח ל-Kiff Agents OÜ בשנים עשר החודשים שקדמו לאירוע שהוליד את האחריות, או (ב) מאה אלף אירו (€100,000).
		</p>
		<p>
			שום דבר בתנאים אלה אינו מגביל או שולל אחריות שאי אפשר להגביל או לשלול לפי הדין החל, כולל אחריות למוות, לפגיעה גופנית שנגרמה ברשלנות, להונאה או למעשה זדון, ואחריות למוצר פגום לפי החוקים שמיישמים את הדירקטיבה (EU) 2024/2853 בדבר אחריות למוצרים פגומים.
		</p>
	</section>
}

templ termsIndemnityHE() {
	<section id="indemnification">
		<h2>13. שיפוי</h2>
		<p>
			נגן עליכם מפני תביעות של צד שלישי לפיהן השירות, כפי שאנו מספקים אותו וכפי שאתם משתמשים בו בהתאם לתנאים אלה, מפר את זכויות הקניין הרוחני של אותו צד שלישי, ונשלם את הנזקים שנפסקו סופית נגדכם (או את סכום ההסדר המוסכם) בגין תביעות כאלה.
		</p>
		<p>
			תגנו עלינו מפני תביעות של צד שלישי הנובעות מ-(א) נתוני הלקוח או התוכן שלכם; (ב) השימוש שלכם בשירות תוך הפרת תנאים אלה (כולל מדיניות השימוש המקובל); או (ג) רשלנות רבתי או מעשה זדון שלכם, ותשלמו את הנזקים שנפסקו סופית נגדנו (או את סכום ההסדר המוסכם) בגין תביעות כאלה.
		</p>
		<p>
			השיפוי מותנה במתן הודעה מהירה על התביעה, בשליטה בלעדית של המשפה בהגנה ובהסדר, ובשיתוף פעולה סביר של המשופה. המשפה אינו רשאי להסדיר תביעה שמטילה חובות על המשופה ללא הסכמה.
		</p>
	</section>
}

templ termsSLAHE() {
	<section id="sla">
		<h2>14. התחייבות לרמת שירות</h2>
		<p>
			בתוכנית בתשלום, <a href="/legal/sla">הסכם רמת השירות</a> (באנגלית) קובע את הזמינות שאנו מתחייבים לה, כיצד בקשה איטית או כושלת נספרת, זמני התגובה של התמיכה שלנו, וקרדיטי השירות כשאיננו עומדים בכך. הוא חלק מתנאים אלה.
		</p>
		<p>
			נהלי התפעול, התגובה לאירועים והתחייבויות להודעה על הפרה מתועדים בגרסה המתוארכת שמקושרת מתנאים אלה (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>); <a href="/security">/security</a> (באנגלית) מציג את הנהלים הנוכחיים.
		</p>
	</section>
}

templ termsServiceModsHE() {
	<section id="service-mods">
		<h2>15. שינויים בשירות</h2>
		<p>
			אנו רשאים להוסיף, לשנות או להסיר תכונות בכל עת. צמצומים מהותיים בפונקציונליות או הוצאה משימוש של משטח API ששוברת התנהגות מתועדת מובאים לידיעת לקוחות פעילים לפחות שלושים יום מראש, עם לוח זמנים מפורסם להוצאה משימוש. שינויים מטעמי אבטחה עשויים להיעשות ללא הודעה כשההודעה עצמה הייתה יוצרת סיכון.
		</p>
	</section>
}

templ termsTermsModsHE() {
	<section id="terms-mods">
		<h2>16. שינויים בתנאים אלה</h2>
		<p>
			אנו רשאים לתקן תנאים אלה מעת לעת. שינויים מהותיים מובאים לידיעה בדוא"ל ובבאנר בולט בדף זה לפחות שלושים יום מראש. שינויים שאינם מהותיים (הבהרות, הפניות) מתפרסמים עם תאריך “עודכן לאחרונה” חדש. המשך השימוש שלכם בשירות אחרי תאריך התוקף של עדכון מהווה קבלה.
		</p>
	</section>
}

templ termsForceMajeureHE() {
	<section id="force-majeure">
		<h2>17. כוח עליון</h2>
		<p>
			אף צד אינו אחראי לכל כשל או עיכוב בביצוע במידה שנגרמו מנסיבות שמחוץ לשליטתו הסבירה, כולל כוח עליון, מלחמה, טרור, הפרות סדר אזרחיות, סכסוכי עבודה, שריפה, אסון טבע, פעולה ממשלתית הקשורה למגפה, הפסקות אינטרנט או חשמל, או פעולות של ספקי תקשורת או תשתית אירוח של צד שלישי.
		</p>
	</section>
}

templ termsGoverningLawHE() {
	<section id="governing-law">
		<h2>18. הדין החל וסמכות השיפוט</h2>
		<p>
			תנאים אלה כפופים לדיני הרפובליקה של אסטוניה, ללא התחשבות בכללי ברירת הדין שלה. הפורום הבלעדי לסכסוכים הוא בית המשפט המחוזי של Harju בטאלין.
		</p>
		<p>
			כשאתם צרכנים המתגוררים במדינה אחרת באיחוד האירופי, כללי הגנת הצרכן המחייבים של תחום השיפוט שלכם ממשיכים לחול במידה שהם מעניקים לכם זכויות שאי אפשר לוותר עליהן בחוזה; סעיף זה אינו שולל מכם את ההגנה של כללים אלה.
		</p>
	</section>
}

templ termsGeneralHE() {
	<section id="general">
		<h2>19. כללי</h2>
		<p>
			<strong>הסכם שלם.</strong> תנאים אלה, יחד עם מדיניות הפרטיות, ה-DPA, כל טופס הזמנה וכל תנאים משלימים שנכללו במפורש, הם ההסכם השלם בינינו בנושאם ומחליפים כל הבנה קודמת או בו-זמנית.
		</p>
		<p>
			<strong>הפרדה.</strong> אם הוראה נמצאת בלתי ניתנת לאכיפה, השאר ממשיכות לחול.
		</p>
		<p>
			<strong>המחאה.</strong> אסור לכם להמחות תנאים אלה ללא הסכמתנו בכתב. אנו רשאים להמחות ללא הסכמה בקשר למיזוג, רכישה או מכירה של כל נכסינו או כמעט כולם, בהודעה אליכם.
		</p>
		<p>
			<strong>אי-ויתור.</strong> אי-אכיפה של הוראה כלשהי אינה מהווה ויתור על הזכות לאכוף אותה מאוחר יותר.
		</p>
		<p>
			<strong>הודעות.</strong> הודעות אל Kiff Agents OÜ נשלחות אל <a href="mailto:legal@kiff.dev">legal@kiff.dev</a> או, בדואר, אל Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estonia. הודעות אליכם נשלחות לדוא"ל המשויך לחשבונכם או, אם מסרתם כזה, לכתובת הודעות משפטיות שייעדתם.
		</p>
		<p>
			<strong>קבלנים עצמאיים.</strong> שום דבר בתנאים אלה אינו יוצר שותפות, סוכנות, מיזם משותף או יחסי עבודה.
		</p>
		<p>
			<strong>נהנים צדדים שלישיים.</strong> אין, אלא במידה שגופים קשורים משופים זוהו במפורש.
		</p>
	</section>
}

