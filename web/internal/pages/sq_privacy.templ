package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// PrivacySQ is KIFF's privacy policy (/privacy) in Albanian, at /sq/privacy.
// It is a translation of Privacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Albanian has the legal
// texts only, so a link to any other page goes to English and says so.
templ PrivacySQ() {
	@components.LayoutSite("KIFF — privacy policy", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@privacyHeadSQ()
			@privacyWhoWeAreSQ()
			@privacyScopeSQ()
			@privacyRolesSQ()
			@privacyCategoriesSQ()
			@privacyLawfulBasesSQ()
			@privacySubprocessorsSQ()
			@privacyTransfersSQ()
			@privacyRetentionSQ()
			@privacyRightsSQ()
			@privacyCookiesSQ()
			@privacySecuritySQ()
			@privacyChildrenSQ()
			@privacyAutomatedSQ()
			@privacyChangesSQ()
			@privacyContactSQ()
		</article>
	}
}

templ privacyHeadSQ() {
	<header class="legal-head">
		<p class="legal-badge">Politika e privatësisë · v0.1</p>
		<h1>Politika e privatësisë</h1>
		<p class="legal-meta">
			<strong>Përditësuar së fundi:</strong> 21 nëntor 2026. <strong>Data e hyrjes në fuqi:</strong> 24 maj 2026.
		</p>
		<p class="legal-disclaimer">
			Kjo politikë shpjegon se si KIFF Cloud përpunon të dhënat personale në faqen e internetit, panelin, API-n dhe aplikacionin tafs për iPhone, iPad, Android dhe kompjuterë. Pyetje: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</header>
}

templ privacyWhoWeAreSQ() {
	<section id="who-we-are">
		<h2>1. Kush jemi</h2>
		<p>
			KIFF Cloud drejtohet nga <strong>Kiff Agents OÜ</strong>, një shoqëri private me përgjegjësi të kufizuar e themeluar në Estoni. Të dhënat e regjistrit:
		</p>
		<ul>
			<li><strong>Kodi i regjistrit:</strong> 17372313 (e-Business Register i Estonisë)</li>
			<li><strong>Numri i TVSH-së:</strong> EE102924327</li>
			<li><strong>Adresa e regjistruar:</strong> Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estoni</li>
			<li><strong>Kontakti për privatësinë:</strong> <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a></li>
			<li><strong>Njoftime formale ligjore:</strong> <a href="mailto:legal@kiff.dev">legal@kiff.dev</a></li>
		</ul>
		<p>
			Meqenëse Kiff Agents OÜ është themeluar në Bashkimin Evropian, Rregullorja e Përgjithshme e BE-së për Mbrojtjen e të Dhënave (<abbr title="General Data Protection Regulation">GDPR</abbr>) zbatohet drejtpërdrejt për përpunimin tonë. Nuk kërkojmë një përfaqësues në BE sipas nenit 27.
		</p>
	</section>
}

templ privacyScopeSQ() {
	<section id="scope">
		<h2>2. Fusha e kësaj politike</h2>
		<p>
			Kjo politikë mbulon të dhënat personale që përpunojmë kur ndërveproni me:
		</p>
		<ul>
			<li><a href="https://kiff.dev"><code>kiff.dev</code></a> — faqen tonë promovuese, këtë faqe të politikës dhe sipërfaqen publike të shfaqjes së vërtetimeve.</li>
			<li><a href="https://app.kiff.dev"><code>app.kiff.dev</code></a> — panelin tonë të vërtetuar.</li>
			<li><a href="https://api.kiff.dev"><code>api.kiff.dev</code></a> — API-n tonë HTTP.</li>
			<li id="tafs"><strong>tafs</strong> — aplikacionin tonë për iPhone, iPad, Android dhe kompjuterë (Mac, Windows dhe Linux) dhe shërbimin pas tij (përfshirë Setup, që lidh mjetet e një kompanie, dhe planque, që i ruan ato lidhje), ku një kompani ia beson një punë një agjenti AI që punon brenda KIFF Card-eve.</li>
		</ul>
		<p>
			Kjo politikë <em>nuk</em> mbulon kornizën me kod të hapur <code>kiff/kiff</code> që mund ta ekzekutoni vetë. Kur e ekzekutoni kornizën në infrastrukturën tuaj, ju jeni kontrolluesi i çdo të dhëne që ajo përpunon, dhe Kiff Agents OÜ nuk përfshihet në atë përpunim.
		</p>
	</section>
}

templ privacyRolesSQ() {
	<section id="roles">
		<h2>3. Rolet tona sipas GDPR-së</h2>
		<p>
			Veprojmë në dy ccilësi, sipas të dhënave:
		</p>
		<ul>
			<li>
				<strong>Kontrollues</strong> për metadatat e llogarisë dhe hyrjes, të dhënat e faturimit (kur faturimi është aktiv), komunikimet marketingu që pranoni dhe telemetrinë operative të shërbimit tonë.
			</li>
			<li>
				<strong>Përpunues</strong> për të dhënat e auditimit, regjistrimet e veprimeve, vërtetimet e vendimeve dhe përmbajtjen tjetër që kalon nëpër runtime në emër të klientëve tanë, dhe për atë që tafs ruan për ta (ekzekutimet, bisedat, raportet, shënimet e kujtesës të secilit taf dhe skedarët që dorëzojnë). Klientët (qiramarrësit) janë kontrolluesit e atyre të dhënave; na japin udhëzime përmes cilësimeve të llogarisë dhe konfigurimit të domenit. Marrëveshja e Përpunimit të të Dhënave (<abbr title="Data Processing Agreement">DPA</abbr>) rregullon atë marrëdhënie; shihni <a href="/legal/dpa">modelin e DPA-së</a> (në anglisht) për kushtet e publikuara.
			</li>
		</ul>
		<p>
			Kjo politikë i drejtohet kryesisht përpunimit tonë si kontrollues. Kur përmendim të dhëna si përpunues, DPA është dokumenti më specifik.
		</p>
	</section>
}

templ privacyCategoriesSQ() {
	<section id="categories">
		<h2>4. Kategoritë e të dhënave personale që përpunojmë</h2>
		<p>
			Kategoritë më poshtë përputhen me inventarin teknik te <a href="/security#data-we-process">/security#data-we-process</a> (në anglisht). Kur të dyja ndryshojnë, faqja teknike është burimi i së vërtetës dhe ne e përditësojmë këtë seksion që të përputhet.
		</p>
		<ul>
			<li>
				<strong>Identifikuesit e llogarisë</strong> — subjekti juaj i vërtetimit (lëshuar nga ofruesi ynë i identitetit) dhe adresa e emailit me të cilën hyni. Ruhen siç janë sot; hashimi gjatë ruajtjes është planifikuar.
			</li>
			<li>
				<strong>Metadatat e qiramarrësit</strong> — id e qiramarrësit, slug, emri i shfaqur, koha e krijimit dhe gjuha që aplikacioni i çdo personi ka përdorur së fundi, që emailet që KIFF u dërgon të vijnë në atë gjuhë.
			</li>
			<li>
				<strong>Kredencialet API</strong> — regjistrime të errëta të çelësave API (ruajmë hashe, kurrë tekstin e hapur).
			</li>
			<li>
				<strong>Të dhënat e cookie-t të sesionit</strong> — një cookie sesioni i nënshkruar me HMAC, vendosur pas hyrjes. Shihni seksionin e cookie-ve më poshtë.
			</li>
			<li>
				<strong>Metadatat e kërkesave HTTP</strong> — adresa IP, user agent, shtegu i kërkesës, statusi i përgjigjes, vonesa. Mbahen në regjistrat e hyrjes të proxy-t tonë të kundërt për një afat të kufizuar ruajtjeje për siguri dhe parandalim të abuzimit.
			</li>
			<li>
				<strong>Përmbajtja nën kontrollin e qiramarrësit</strong> — të dhënat <code>parameters</code>, <code>actor</code> dhe <code>entity</code> që dërgoni te runtime. Këto i mbajmë <em>si përpunues</em> në emër të klientit; klienti është përgjegjës për atë që arrin në rrjet. Redaktimi për çdo domen është planifikuar.
			</li>
			<li>
				<strong>Komunikimet</strong> — emailet që u dërgoni kutive tona postare të mbështetjes, shitjeve, sigurisë ose privatësisë.
			</li>
			<li>
				<strong>Aplikacioni tafs</strong> — hyni në tafs me llogarinë tuaj KIFF. Në një telefon ose tablet aplikacioni e mban sesionin tuaj në Keychain të pajisjes (në Android, në hapësirën e saj të enkriptuar). Në një kompjuter e mban të vulosur për llogarinë tuaj të përdoruesit: në një PC Windows me mbrojtjen e vet të të dhënave të Windows, në Linux në keyring-un tuaj, në Mac në Keychain-in e tij. Sesioni i një kompjuteri zgjat deri në 90 ditë. Aplikacioni krijon një çelës nënshkrimi që nuk e lë kurrë pajisjen: në Secure Enclave të një iPhone, iPad ose Mac, në Keystore të një pajisjeje Android ose në TPM të një PC Windows. Në Linux, dhe në një Mac pa Secure Enclave, çelësi është një çelës softuerik i mbajtur në keyring-un ose Keychain-in tuaj, dhe ai kompjuter mund të tregojë çfarë ju pret por jo ta miratojë; miratoni në telefonin tuaj{ macSecurityKey("sq") }. Një PC Windows pa TPM nuk mund të hyjë në tafs. KIFF ruan gjysmën publike të çelësit, emrin dhe platformën e pajisjes dhe kur u shtua e kur u përdor së fundi, që të mund të kontrollojë përgjigjet tuaja ndaj thirrjeve të mbajtura dhe miratimet tuaja të lidhjeve. Nëse miratoni me një passkey në kompjuterin tuaj, si Windows Hello ose një çelës sigurie, fytyra, gjurma e gishtit ose PIN-i juaj mbetet te sistemi i vetë kompjuterit; KIFF ruan çelësin publik të passkey-t, id-në e tij, një numërues dhe një emër, kurrë asgjë të fshehtë, dhe refuzon një passkey që sinkronizohet në pajisje të tjera. Nëse aktivizoni njoftimet në një telefon, një tablet ose një Mac që ekzekuton aplikacionin iPad, ruajmë push token-in e pajisjes me id-në tuaj të personit në KIFF dhe gjuhën që aplikacioni tregoi, që njoftimet e tij të vijnë në atë gjuhë. Shërbimi tafs ruan edhe gjuhën e llogarisë, nga kush ka biseduar së fundi me Coach, deri në tre muaj, që raportet e një taf-i të vijnë në të. Njoftimi i një telefoni kalon përmes Apple ose Google vetëm me cili taf dhe çfarë dëshiron, dhe në njoftimin e një dere emrin ose adresën e emailit të atij që shkroi: kurrë një shumë ose detajet e një kërkese. Aplikacioni i shton ato në vetë pajisjen, nga KIFF, kështu që njoftimi i një telefoni të zhbllokuar mund të tregojë një shumë, një tregtar ose një person. Në një telefon Android të kyçur tregon vetëm „Një taf ka nevojë për ju“, dhe në një iPhone të kyçur po ashtu, përveç nëse keni vendosur që pamjet paraprake të shfaqen gjithmonë. <strong>Ora juaj:</strong> një orë nuk mban fjalëkalim ose çelës, flet vetëm me telefonin tuaj të çiftuar dhe nuk miraton kurrë. Dërgon atë që thoni te Coach, ose te taf-i që zgjodhët, vetëm si tekst, përmes telefonit, pasi të keni lejuar AI-n. Shërbimi i vet i të folurit i orës, i Apple ose i Google, i kthen fjalët tuaja në atë tekst. Në Wear OS, nëse ndalon para se të mbaroni, e bën në vend të tij njohësi i vetë telefonit tuaj, në telefon. Mund të refuzojë, të ndalojë ose të dërgojë te Coach ose një taf vetëm kur ka kyçje ekrani ose kod dhe është i zhbllokuar. Ajo që i dërgoni një taf-i shkon në bisedën e vet të atij taf-i, sikur ta kishit shkruar në telefon. Biseda e një taf-i, shumat e përfshira, shfaqet në orë vetëm ndërsa është e hapur, e lexuar përmes telefonit çdo herë; ora nuk mban asgjë prej saj. <strong>Apple Watch:</strong> tregon taf-et tuaja dhe faqet e tyre pa i mbajtur. Mban vetëm Kutinë tuaj, në një skedar që nuk mund ta lexojë kur është i kyçur: çdo thirrje e mbajtur si emri i taf-it të saj dhe çfarë kërkon, kurrë një shumë, dhe përgjigjet e Coach ndaj asaj që dërguat nga ora, si tekst. Nëse dilni në orë, mban edhe faktin që dolët, derisa të hyni përsëri në orë. Veç kësaj, nuk mban asgjë nëse ora nuk ka kod. Kutia hiqet kur dilni në orë ose iPhone-i juaj del, ose herën tjetër që aplikacioni hapet ose mbyllet pa kod. Nuk bën asnjë regjistrim, dhe të vetmet njoftime që tregon janë ato të iPhone-it tuaj. <strong>Wear OS:</strong> tregon emailin e llogarisë suaj dhe kalendarin e sotëm pa i mbajtur. Që të hapet menjëherë, mban, të enkriptuar, numrin e asaj që ju pret dhe emrin e çdo taf-i dhe nëse është i ndaluar apo i pezulluar: kurrë një shumë, detajet e një thirrjeje të mbajtur ose bisedën e një taf-i. Kjo pastrohet kur dilni, kur ora kyçet ose i hiqet nga kyçi i dorës dhe pas 24 orësh. Mban Kutinë tuaj, ku çdo rresht është emri i një taf-i dhe ajo që thotë, kurrë një shumë, dhe një mesazh të ruajtur për më vonë, si tekst. Dalja, në orë ose në telefon, pastron gjithçka. Për pllakën e saj, mban edhe numrin e asaj që ju pret, të shfaqur vetëm kur ora është e zhbllokuar dhe pastruar kur dilni ose herën tjetër që pllaka shfaqet kur ora është e kyçur ose pa kyçje ekrani. Pasi dilni në orë, mban një shënim që dolët, derisa të hyni përsëri. Kutia hiqet edhe herën tjetër që aplikacioni hapet ose mbyllet kur ora është e kyçur ose pa kyçje ekrani. Një mesazh i ruajtur për më vonë qëndron derisa ta dërgoni ose ta fshini, pasi keni kërkuar të dërgohet. Nëse shërbimi i të folurit të orës ndalon para se të mbaroni, ora e dërgon regjistrimin te telefoni juaj, që e kthen në tekst në vetë telefonin, kurrë në një server. Regjistrimi fshihet në të dyja, sapo teksti kthehet ose anuloni, dhe pas 2 minutash më së shumti. Vetëm teksti shkon më tej te Coach ose taf-i juaj. Rezultati i një taf-i mund të qëndrojë në njoftimet e orës derisa ta hiqni ose të dilni në orë. Në një PC Windows, një kompjuter Linux ose një Mac me aplikacionin macOS 12, njoftimet i bën vetë aplikacioni ndërsa punon, pa push token dhe përmes asnjë kompanie tjetër. Në Windows dhe Linux tregojnë cili taf, çfarë dëshiron të bëjë, shumën, pse dhe deri kur; në aplikacionin macOS 12 tregojnë fjalët e KIFF për thirrjen, pasi t'i aktivizoni, dhe një ekran i kyçur tregon atë që lejon cilësimi i pamjes paraprake të Mac-ut. Në Windows janë të çaktivizuara derisa t'i aktivizoni, dhe tregojnë vetëm „Një taf ka nevojë për ju“ kur ekrani është i kyçur. Një njoftim i shfaqur para kyçjes së ekranit i mban detajet në listën e njoftimeve të Windows. Në Linux janë të aktivizuara derisa t'i çaktivizoni, dhe ajo që tregon një ekran i kyçur varet nga desktopi juaj. Kur lidhni një mjet, hyni te ofruesi i vetë mjetit. Për një aplikacion ku planque hyn vetë, si Stripe, ose një çelës që jepni, planque e mban atë token ose çelës për kompaninë tuaj, të enkriptuar; për një lidhje të menaxhuar, Composio, shërbimi i lidhjes me të cilin punon planque, mban hyrjen, dhe planque mban vetëm regjistrimin e lidhjes dhe mjetet që miratuat (gjithçka si përpunues, shihni më poshtë). Nëse çiftoni shtesën tafs, një taf mund të lexojë dhe të veprojë edhe në faqet e sajteve që lejoni, në Chrome-in tuaj (si përpunues; <a href="/sq/tafs/privacy">faqja e privatësisë së tafs</a> thotë çfarë lexohet, çfarë ruhet dhe për sa kohë). Regjistrimi i një lidhjeje mund të përfshijë llogarinë në të cilën është hyrë (emrin ose emailin e saj), që aplikacioni t'ju tregojë cila është. KIFF përdor lidhje të menaxhuara vetëm për aplikacionet e emërtuara te <a href="/subprocessors#composio">/subprocessors</a> (në anglisht). Aplikacioni nuk ka gjurmues analitike ose reklamash.
			</li>
			<li>
				<strong>Blerjet në App Store</strong> — kur blini Solo ose një paketë kredish në tafs, Apple jua shet: Apple është shitësi i regjistruar, merr pagesën dhe mban të dhënat tuaja të pagesës. Apple na tregon çfarë u bë, për cilën llogari KIFF (një id e rastësishme që aplikacioni ia bashkëngjit blerjes), kur, id-në e transaksionit të Apple dhe, për Solo, kur përfundon ose rinovohet periudha. E përdorim për të shtuar kreditet ose planin në llogarinë tuaj. Apple nuk na jep Apple ID-në, emrin, adresën e emailit ose kartën tuaj.
			</li>
			<li>
				<strong>Blerjet në Google Play</strong> — në Android, të njëjtat blerje kalojnë përmes faturimit të Google Play: Google merr pagesën dhe mban të dhënat tuaja të pagesës. Google na tregon çfarë u bë, për cilën llogari KIFF (e njëjta id e rastësishme), kur, tokenin e blerjes dhe id-në e porosisë dhe, për Solo, kur përfundon ose rinovohet periudha, dhe e përdorim njësoj. Google nuk na jep llogarinë, emrin, adresën e emailit ose kartën tuaj të Google.
			</li>
		</ul>
	</section>
}

templ privacyLawfulBasesSQ() {
	<section id="lawful-bases">
		<h2>5. Bazat ligjore për përpunimin</h2>
		<p>
			Sipas nenit 6 të GDPR-së mbështetemi në bazat e mëposhtme ligjore:
		</p>
		<ul>
			<li>
				<strong>Ekzekutimi i një kontrate</strong> (neni 6(1)(b)) — për krijimin e llogarisë, vërtetimin, ekzekutimin e runtime në emrin tuaj, faturimin (kur është aktiv) dhe sipërfaqet kryesore të shërbimit.
			</li>
			<li>
				<strong>Interesat legjitime</strong> (neni 6(1)(f)) — për sigurinë, parandalimin e mashtrimit, zbulimin e abuzimit, telemetrinë operative dhe mbrojtjen e shërbimit. Peshojmë interesat tona kundrejt të drejtave tuaja dhe do t'ju themi, me kërkesë, çfarë dha ai test balancimi.
			</li>
			<li>
				<strong>Pëlqimi</strong> (neni 6(1)(a)) — për AI-n në aplikacionin tafs: çfarë i dërgohet modelit AI që ekzekuton Coach dhe taf-et tuaja, siç përshkruhet <a href="#ai-in-tafs">më poshtë</a>. Asgjë nuk dërgohet derisa ta lejoni, dhe mund ta tërhiqni në Llogari. Pëlqimi është edhe ajo që do të kërkonim para çdo cookie-je analitike, komunikimi marketingu opsional ose përpunimi të ri që zgjeron ndjeshëm përdorimin e të dhënave tuaja. Nuk kryejmë analitikë, reklamim ose gjurmim jo thelbësor.
			</li>
			<li>
				<strong>Detyrim ligjor</strong> (neni 6(1)(c)) — për regjistrat tatimorë (Ligji estonez i Kontabilitetit §12, 7 vjet), përgjigjet ndaj kërkesave të ligjshme të autoriteteve dhe ruajtjen e kërkuar nga rregullat kundër pastrimit të parave kur zbatohen.
			</li>
		</ul>
		<h3 id="ai-in-tafs">AI në aplikacionin tafs</h3>
		<p>Aplikacioni tafs ju pyet para se diçka t'i dërgohet AI-së, me këto fjalë:</p>
		<ul>
			<li>tafs përdor AI-në Claude të Anthropic për Coach dhe taf-et tuaja.</li>
			<li>Coach dhe taf-et tuaja janë agjentë AI: ajo që shkruajnë gjenerohet nga AI dhe mund të jetë e gabuar. Një mesazh që një taf dërgon jashtë kompanisë suaj thotë se është shkruar nga një agjent AI.</li>
			<li>Çfarë i dërgohet: ajo që i shkruani Coach dhe taf-eve tuaja, skedarët që bashkëngjitni, ajo që aplikacionet tuaja të lidhura i kthejnë një taf-i ndërsa punon dhe ajo që është në ekranin tuaj ndërsa Coach ju ndihmon në aplikacion.</li>
			<li>Çfarë nuk dërgohet kurrë: fjalëkalimet dhe çelësat që përdorin aplikacionet tuaja të lidhura, ose gjurma e gishtit tuaj.</li>
			<li>Anthropic e përdor për të përgjigjur dhe e ruan deri në 30 ditë.</li>
			<li>Asgjë nuk dërgohet derisa ta lejoni. Mund ta tërhiqni në Llogari.</li>
		</ul>
		<p>Një taf që ekzekutohet pa askënd aty në atë çast (sipas orarit të tij, ose kur vjen diçka) mbështetet te pëlqimi i personit që e krijoi ose e mori përsipër, ose përndryshe i personit të parë që menaxhon taf-et e llogarisë dhe e lejon.</p>
		<p><strong>Kur e tërhiqni,</strong> Coach dhe taf-et tuaja ndalojnë së ju përgjigjuri. Një taf, ekzekutimet e të cilit mbështeten te pëlqimi juaj, pezullohet: oraret e tij ndalojnë dhe ajo që vjen pret. Vazhdon kur pëlqimi jepet përsëri, ose kur dikush që menaxhon taf-et e llogarisë e merr përsipër me të vetin. Tërheqja nuk ndryshon atë që u dërgua më parë.</p>
		<p>Anthropic është i listuar te <a href="/subprocessors">/subprocessors</a> (në anglisht), me vendin ku përpunon dhe kur mund t'i mbajë të dhënat më gjatë.</p>
	</section>
}

templ privacySubprocessorsSQ() {
	<section id="sub-processors">
		<h2>6. Nënpërpunuesit</h2>
		<p>Nuk i shesim të dhënat tuaja personale dhe nuk i ndajmë për reklamim.</p>
		<p>
			Angazhojmë një grup të vogël furnitorësh për ta ofruar shërbimin. Lista zyrtare, aktuale gjendet te <a href="/subprocessors">/subprocessors</a> (në anglisht); ajo faqe përditësohet brenda 30 ditëve nga çdo ndryshim. I kërkojmë çdo nënpërpunuesi mbrojtje të barasvlershme me tonat sipas marrëveshjeve me shkrim, përfshirë Klauzolat Kontraktore Standarde të BE-së kur të dhënat personale dalin nga BE.
		</p>
		<p>
			Shtimet ose zëvendësimet thelbësore të nënpërpunuesve që prekin të dhënat personale u njoftohen klientëve aktivë paraprakisht, me të drejtën për kundërshtim.
		</p>
	</section>
}

templ privacyTransfersSQ() {
	<section id="transfers">
		<h2>7. Transferimet ndërkombëtare</h2>
		<p>
			Disa nga nënpërpunuesit tanë janë themeluar jashtë Hapësirës Ekonomike Evropiane, kryesisht në Shtetet e Bashkuara. Për çdo transferim të tillë mbështetemi te të paktën një nga garancitë e mëposhtme:
		</p>
		<ul>
			<li>
				<strong>Kuadri i Privatësisë së të Dhënave BE–SHBA</strong> — për nënpërpunuesit amerikanë që janë certifikuar te Kuadri. Vendim përshtatshmërie në fuqi që nga mesi i vitit 2023; monitorojmë çdo ndryshim të statusit të tij.
			</li>
			<li>
				<strong>Klauzolat Kontraktore Standarde</strong> — moduli 2 (kontrollues–përpunues) për nënpërpunuesit tanë të drejtpërdrejtë dhe moduli 3 (përpunues–nënpërpunues) kur zbatohen përpunues në zinxhir. Përdorim SCC-të e vitit 2021 të miratuara nga Komisioni.
			</li>
			<li>
				<strong>Masa plotësuese</strong> — kur vlerësimi i rrezikut tregon se garanci shtesë janë të justifikuara (enkriptim gjatë transmetimit dhe në prehje, regjistrim i qasjeve, minimizim i të dhënave).
			</li>
		</ul>
		<p>
			Mund të kërkoni instrumentin specifik të transferimit që zbatohet për një nënpërpunues të caktuar duke dërguar email te <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
		<p><strong>Vendi juaj.</strong> Ligjet e disa vendeve kërkojnë më shumë se ç'thotë kjo politikë. Ajo që shtojnë, në anglisht dhe në gjuhën e vendit, është te <a href="/privacy/countries">Vendi juaj</a> (në anglisht).</p>
	</section>
}

templ privacyRetentionSQ() {
	<section id="retention">
		<h2>8. Ruajtja</h2>
		<p>
			I ruajmë të dhënat personale për periudhën më të shkurtër që përputhet me qëllimet për të cilat i përpunojmë dhe me çdo detyrim ligjor të zbatueshëm.
		</p>
		<ul>
			<li>
				<strong>Metadatat e llogarisë dhe hyrjes</strong> — derisa llogaria të fshihet. Në aplikacionin tafs e fshin pronari te Llogari → <em>Fshi llogarinë</em>. Një llogari e krijuar në ueb fshihet duke dërguar email te <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>, brenda afatit një-mujor të nenit 12(3) të GDPR-së. Në të dyja rastet, çelësat e llogarisë ndalojnë menjëherë. Nëse fshihet në aplikacionin tafs, nuk mund të kthehet: bisedat, shënimet dhe lidhjet e tafs-it fshihen menjëherë, dhe ajo që KIFF ruan fshihet brenda 30 ditëve. Nëse fshihet në ueb, i mbajmë të dhënat e saj për një periudhë mirëkuptimi 30 ditore, në rast se pronari i do përsëri, pastaj i fshijmë.
			</li>
			<li>
				<strong>Regjistrimet e çelësave API</strong> — deri në fshirjen e llogarisë, përfshirë pas revokimit të një çelësi. Një çelës që i përket një lidhjeje hyrjeje të agjentit fshihet bashkë me atë lidhje, 30 ditë pasi ajo përfundon.
			</li>
			<li>
				<strong>Cookie-t e sesionit</strong> — deri në skadim (24 orë si parazgjedhje) ose derisa të dilni.
			</li>
			<li>
				<strong>Regjistrat e hyrjes të proxy-t të kundërt</strong> — deri në 90 ditë, pastaj grumbullohen ose fshihen.
			</li>
			<li>
				<strong>Regjistrat e shërbimit</strong> — ajo që shërbimet e KIFF dhe planque regjistrojnë ndërsa punojnë: gabime dhe kërkesa, që mund të emërtojnë një llogari, një person ose një agjent. 30 ditë, pastaj fshihen.
			</li>
			<li>
				<strong>Kopjet rezervë</strong> — baza e të dhënave e KIFF kopjohet çdo ditë, e enkriptuar, dhe çdo kopje mbahet 7 ditë, kështu që një regjistrim i fshirë zhduket prej tyre brenda 7 ditëve. Depot e tafs dhe planque mbajnë kopje të enkriptuara në një çast të caktuar për 35 ditë, të përdorura vetëm për rikthimin e një depoje pas një dështimi, kështu që një regjistrim i fshirë zhduket prej tyre brenda 35 ditëve.
			</li>
			<li>
				<strong>Të dhënat e auditimit të qiramarrësit</strong> — mbahen si përpunues sipas konfigurimit të qiramarrësit të klientit. Parazgjedhja: mbahen gjatë jetës së qiramarrësit; fshihen kur fshihet qiramarrësi. Shihni <a href="/security#deletion">/security#deletion</a> (në anglisht).
			</li>
			<li>
				<strong>Thirrjet përmes gateway-t të KIFF</strong> — argumentet e një thirrjeje derisa të dërgohet, të refuzohet ose të dështojë, pastaj fshihen; rezultati i mjetit 24 orë, pastaj fshihet. Regjistrimi i vendimit dhe një hash i argumenteve mbahen si të dhëna auditimi të qiramarrësit. Shihni <a href="/security#data-kept">/security#data-kept</a> (në anglisht).
			</li>
			<li>
				<strong>Përdorimi</strong> — për çdo thirrje përmes gateway-t, kur përfundon: cili agjent e bëri, mjeti dhe nëse u numërua si veprim ose ishte falas (dhe pse). Për çdo ekzekutim të një taf-i ose të Coach, kur përfundon: taf-i, kur, kreditet që AI-ja e tij përdori dhe nëse u numëruan ose pse jo. Derisa llogaria të fshihet; ajo që i raportohet përpunuesit tonë të pagesave për faturim mbahet me regjistrat e faturimit.
			</li>
			<li>
				<strong>Lidhjet e hyrjes të agjentit</strong> — cili agjent, emri i aplikacionit, kush e lejoi, kur dhe përdorimi i fundit: sa kohë lidhja është aktive, pastaj 30 ditë pasi përfundon (mbetet e listuar në panel për atë kohë), pastaj fshihet me tokenat e saj dhe çelësin e saj API. Gjithçka fshihet me llogarinë.
			</li>
			<li>
				<strong>tafs</strong> — push token-i i një pajisjeje derisa të dilni nga aplikacioni, ta hiqni pajisjen, ose Apple apo Google të raportojë që tokeni nuk ekziston më. Çelësi publik, emri, platforma dhe datat e një pajisjeje sa kohë e përdorni; pasi e dilni, shënohet si e hequr dhe mbahet deri në fshirjen e llogarisë, që KIFF të mund të refuzojë një përgjigje të vonuar prej saj dhe të tregojë cila pajisje nënshkroi një më të hershme. Çelësi publik, id dhe emri i një passkey-t mbahen si të pajisjes së tij. Një kompjuter e mban sesionin deri në 90 ditë, ose derisa të dilni. Ajo që tafs ruan për kompaninë tuaj mbahet si përpunues: ekzekutimet dhe bisedat e një taf-i, me përmbledhjen e një bisede (dhe të Setup), 30 ditë, ajo që mjetet tuaja kthejnë vetëm derisa të mbarojë një ekzekutim (në një bisedë, ajo që është vetëm lexuar mbahet e enkriptuar për mesazhet e saj të ardhshme, përdoret derisa biseda të jetë e papunuar një orë dhe më së shumti katër orë pas leximit, pastaj fshihet automatikisht, brenda disa ditëve), dhe shënimet e tij të kujtesës derisa taf-i të hiqet; skedarët që dorëzon 30 ditë nga ekzekutimi që i krijoi, pastaj fshihen automatikisht brenda një dite, ose më herët nëse dikush në llogarinë tuaj fshin një; token-i ose çelësi i një lidhjeje në planque, ose hyrja e një lidhjeje të menaxhuar te Composio, derisa ta shkëputni (nëse një tjetër lidhje e juaja mund ta përdorë të njëjtën llogari te ai furnitor, mbahet e papërdorur derisa të shkëputet edhe ajo), dhe regjistrimi i miratimeve të saj derisa llogaria të mbarojë; shihni <a href="/legal/dpa#annex-4">Shtojcën 4 të DPA-së</a> (në anglisht).
			</li>
			<li>
				<strong>Regjistrat e faturimit</strong> — 7 vjet nga fundi i vitit financiar (Ligji estonez i Kontabilitetit §12).
			</li>
			<li>
				<strong>Blerjet në App Store dhe Google Play</strong> — ajo që Apple ose Google na tha për çdo blerje mbetet në llogarinë tuaj derisa llogaria të fshihet. Raportet e tyre të shitjeve dhe pagesave, që i mbajmë si regjistra faturimi 7 vjet, nuk ju emërtojnë.
			</li>
			<li>
				<strong>Korrespondenca e mbështetjes</strong> — 3 vjet nga ndërveprimi i fundit, pastaj fshihet.
			</li>
		</ul>
	</section>
}

templ privacyRightsSQ() {
	<section id="rights">
		<h2>9. Të drejtat tuaja</h2>
		<p>
			Sipas GDPR-së keni të drejtat e mëposhtme lidhur me të dhënat tuaja personale:
		</p>
		<ul>
			<li><strong>Qasja</strong> (neni 15) — konfirmim nëse përpunojmë të dhënat tuaja dhe një kopje e tyre.</li>
			<li><strong>Korrigjimi</strong> (neni 16) — korrigjimi i të dhënave të pasakta ose të paplota.</li>
			<li><strong>Fshirja</strong> (neni 17) — fshirja e të dhënave tuaja, me përjashtime për ruajtjen ligjore.</li>
			<li><strong>Kufizimi</strong> (neni 18) — ndalim i përpunimit ndërsa zgjidhet një mosmarrëveshje.</li>
			<li><strong>Bartshmëria</strong> (neni 20) — një eksport i lexueshëm nga makina i të dhënave që keni dhënë.</li>
			<li><strong>Kundërshtimi</strong> (neni 21) — ndaj përpunimit të bazuar në interesa legjitime; ndalojmë përveç nëse mund të tregojmë arsye mbizotëruese.</li>
			<li><strong>Tërheqja e pëlqimit</strong> (neni 7(3)) — për çdo përpunim të bazuar në pëlqim, si AI në aplikacionin tafs (te Llogari, si <a href="#ai-in-tafs">më sipër</a>). Tërheqja nuk ndikon në përpunimin e mëparshëm të ligjshëm.</li>
		</ul>
		<p>
			Për të ushtruar cilëndo nga këto të drejta, dërgoni email te <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>. Përgjigjemi brenda një muaji sipas nenit 12(3); mund ta zgjasim deri në dy muaj të tjerë për kërkesa të ndërlikuara dhe do t'ju themi nëse e bëjmë.
		</p>
		<h3 id="export-chats">Bisedat tuaja në tafs</h3>
		<p>
			Në aplikacionin tafs, Llogari → Eksporto bisedat e mia shkarkon bisedat tuaja me çdo taf, edhe atë të Coach, emrat e skedarëve që keni bashkëngjitur dhe shënimet tuaja, si skedar të lexueshëm dhe si JSON. Vetëm ju mund t'i eksportoni: një administrator ose pronari i llogarisë nuk mundet, dhe eksporti i llogarisë i KIFF nuk i përfshin.
		</p>
		<h3 id="delete-account">Fshirja e llogarisë tuaj tafs</h3>
		<p>
			tafs është aplikacioni i KIFF. Për të fshirë llogarinë tuaj tafs dhe të dhënat e saj:
		</p>
		<ol>
			<li>Hapni aplikacionin tafs dhe hyni.</li>
			<li>Shkoni te Llogari, pastaj prekni <em>Fshi llogarinë</em>.</li>
			<li>Konfirmoni. Fshirja e një llogarie nuk mund të zhbëhet.</li>
		</ol>
		<p>
			<em>Fshi llogarinë</em> shfaqet te ai që mund ta fshijë llogarinë e kompanisë, zakonisht pronari i saj. Nëse nuk e shihni, ose nuk e keni më aplikacionin, dërgoni email te <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> nga adresa me të cilën hyni, dhe ne i fshijmë të dhënat tuaja brenda një muaji.
		</p>
		<p>
			Çfarë fshihet: çelësat e llogarisë ndalojnë menjëherë. Taf-et, bisedat, shënimet, skedarët e bashkëngjitur dhe lidhjet e saj fshihen menjëherë, dhe nga kopjet e tyre në një çast të caktuar brenda 35 ditëve. Ajo që KIFF ruan për llogarinë fshihet brenda 30 ditëve, dhe nga kopjet rezervë brenda 7 ditëve pas kësaj. Regjistrat e shërbimit që emërtojnë llogarinë zhduken brenda 30 ditëve. Të dhënat e auditimit të qiramarrësit fshihen me qiramarrësin. Shihni <a href="#retention">Ruajtja</a> për çdo lloj të dhënash.
		</p>
		<p id="delete-data">
			Për të fshirë disa nga të dhënat tuaja dhe për ta mbajtur llogarinë: në aplikacion, fshini një bisedë dhe mesazhet e saj dhe skedarët e bashkëngjitur shkojnë me të; hiqni një taf dhe bisedat, shënimet dhe lidhjet e tij shkojnë me të. Për çdo gjë tjetër, dërgoni email te <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> dhe thoni çfarë të fshijmë. E bëjmë brenda një muaji.
		</p>
		<p>
			Keni të drejtë të paraqisni ankesë te një autoritet mbikëqyrës. Autoriteti ynë kryesor mbikëqyrës është <a href="https://www.aki.ee/en" target="_blank" rel="noopener">Inspektorati Estonez i Mbrojtjes së të Dhënave (Andmekaitse Inspektsioon)</a>. Mund të ankoheni edhe te autoriteti mbikëqyrës në shtetin tuaj anëtar të banimit.
		</p>
		<p><strong>Vendi juaj.</strong> Ligjet e disa vendeve kërkojnë më shumë se ç'thotë kjo politikë. Ajo që shtojnë, në anglisht dhe në gjuhën e vendit, është te <a href="/privacy/countries">Vendi juaj</a> (në anglisht).</p>
	</section>
}

templ privacyCookiesSQ() {
	<section id="cookies">
		<h2>10. Cookie-t</h2>
		<p>
			Vendosim tri cookie, të gjitha rreptësisht të domosdoshme, të palës së parë, të dërguara vetëm përmes HTTPS dhe të palexueshme nga skriptet në faqe. Sipas rregullave të ePrivacy të BE-së nuk kërkojnë pëlqim; i listojmë që të dini se ekzistojnë. <a href="/cookies">Politika e cookie-ve</a> (në anglisht) ka detajet.
		</p>
		<ul>
			<li>
				<strong><code>kiff_session</code></strong> — ju mban të hyrë. Një cookie sesioni i nënshkruar që mban id-në tuaj të hyrjes, emailin dhe emrin, dhe kredencialin që paneli përdor për ju. Vendoset për <code>.kiff.dev</code>. Zgjat 24 orë, ose derisa të dilni.
			</li>
			<li>
				<strong><code>kiff_flash</code></strong> — bart një mesazh njëpërdorimsh te faqja tjetër, si „çelësi juaj u krijua“. I nënshkruar; një çelës i ri nuk është kurrë në të. Vendoset për <code>.kiff.dev</code>. Fshihet kur faqja tjetër e lexon, dhe më së shumti pas 5 minutash.
			</li>
			<li>
				<strong><code>kiff_cb_attempts</code></strong> — numëron sa herë është ringarkuar faqja e hyrjes, që një hyrje që bën rrotull të ndalohet. Dërgohet vetëm te ajo faqe. Zgjat 5 minuta dhe pastrohet kur një hyrje fillon ose ia del.
			</li>
		</ul>
		<p>
			Nuk përdorim cookie analitike, cookie reklamash ose ndonjë gjurmues të palëve të treta. Nëse ndonjëherë shtojmë ndonjë, do të paraqesim një banderolë pëlqimi para se cookie të vendoset, në përputhje me ePrivacy dhe udhëzimet e EDPB-së të vitit 2023 për teknologjitë e gjurmimit.
		</p>
		<p>
			Nëse hyni përmes Clerk (nënpërpunuesit tonë të vërtetimit), Clerk vendos edhe cookie në domenin e vet frontend (<code>clerk.kiff.dev</code>). Ato cookie janë të domosdoshme që Clerk t'ju njohë gjatë rrjedhës së hyrjes dhe rregullohen nga politika e privatësisë e Clerk si dhe nga e jona. Për detaje shihni listën e nënpërpunuesve.
		</p>
	</section>
}

templ privacySecuritySQ() {
	<section id="security">
		<h2>11. Siguria</h2>
		<p>
			Masat tona teknike dhe organizative të sigurisë janë dokumentuar te <a href="/security">/security</a> (në anglisht). Përfshijnë izolimin e qiramarrësve në shtresën e bazës së të dhënave, TLS 1.2+ gjatë transmetimit, enkriptim në prehje me parazgjedhjet e ofruesit të menaxhuar dhe kontrolle qasjeje të bazuara në parimin e privilegjit më të vogël.
		</p>
		<p>
			I njoftojmë klientët e prekur për një shkelje të të dhënave personale pa vonesë të pajustifikuar dhe brenda 72 orësh nga konfirmimi, në përputhje me nenin 33 të GDPR-së. Njoftimi përfshin natyrën e shkeljes, kategoritë dhe numrat e përafërt të subjekteve të të dhënave dhe regjistrimeve të prekura, pasojat e mundshme dhe masat e marra ose të propozuara.
		</p>
	</section>
}

templ privacyChildrenSQ() {
	<section id="children">
		<h2>12. Fëmijët</h2>
		<p>
			KIFF Cloud është një produkt infrastrukture për zhvillues që nuk i drejtohet fëmijëve. Nuk mbledhim me dijeni të dhëna personale nga fëmijë nën 16 vjeç. Nëse besoni se një fëmijë na ka dhënë të dhëna personale, kontaktoni <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> dhe do t'i fshijmë.
		</p>
	</section>
}

templ privacyAutomatedSQ() {
	<section id="automated">
		<h2>13. Vendimmarrja e automatizuar</h2>
		<p>
			Runtime i KIFF Cloud merr vendime deterministe politike mbi të dhënat që dërgojnë klientët tanë. Këto nuk janë vendime për ju që prodhojnë efekte ligjore ose të ngjashme të rëndësishme në kuptimin e nenit 22 të GDPR-së; janë vendime për veprimet e klientit (rimbursime, porosi, mesazhe e kështu me radhë) të ekzekutuara sipas politikës së vetë klientit.
		</p>
		<p>
			Klientët që përdorin KIFF Cloud për të marrë vendime që prekin përdoruesit e tyre fundorë janë vetë përgjegjës për përputhjen me nenin 22. Vërtetimet tona të qeverisjes janë hartuar që t'u japin atyre klientëve gjurmën e auditimit që u duhet për të dëshmuar mbikëqyrjen njerëzore, por detyrimi ligjor për ta ofruar atë mbikëqyrje i takon klientit.
		</p>
	</section>
}

templ privacyChangesSQ() {
	<section id="changes">
		<h2>14. Ndryshimet në këtë politikë</h2>
		<p>
			Mund ta përditësojmë këtë politikë herë pas here. Ndryshimet thelbësore u njoftohen klientëve aktivë me email dhe me një banderolë të dukshme në këtë faqe për të paktën 30 ditë. Ndryshimet jo thelbësore publikohen me një datë të re „përditësuar së fundi“.
		</p>
	</section>
}

