package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// PrivacyTG is KIFF's privacy policy (/privacy) in Tajik, at /tg/privacy.
// It is a translation of Privacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Tajik has the legal
// texts only, so a link to any other page goes to English and says so.
templ PrivacyTG() {
	@components.LayoutSite("KIFF — privacy policy", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@privacyHeadTG()
			@privacyWhoWeAreTG()
			@privacyScopeTG()
			@privacyRolesTG()
			@privacyCategoriesTG()
			@privacyLawfulBasesTG()
			@privacySubprocessorsTG()
			@privacyTransfersTG()
			@privacyRetentionTG()
			@privacyRightsTG()
			@privacyCookiesTG()
			@privacySecurityTG()
			@privacyChildrenTG()
			@privacyAutomatedTG()
			@privacyChangesTG()
			@privacyContactTG()
		</article>
	}
}

templ privacyHeadTG() {
	<header class="legal-head">
		<p class="legal-badge">Сиёсати махфият · v0.1</p>
		<h1>Сиёсати махфият</h1>
		<p class="legal-meta">
			<strong>Навсозии охирин:</strong> 24 ноябри 2026. <strong>Санаи эътибор:</strong> 24 майи 2026.
		</p>
		<p class="legal-disclaimer">
			Ин сиёсат шарҳ медиҳад, ки KIFF Cloud маълумоти шахсиро дар сайт, лавҳаи идоракунӣ, API ва барномаи tafs барои iPhone, iPad, Android ва компютерҳо чӣ гуна коркард мекунад. Саволҳо: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</header>
}

templ privacyWhoWeAreTG() {
	<section id="who-we-are">
		<h2>1. Мо кистем</h2>
		<p>
			KIFF Cloud-ро <strong>Kiff Agents OÜ</strong>, ҷамъияти хусусии ба масъулияти маҳдуд дар Эстония сабтшуда, идора мекунад. Маълумоти қайд:
		</p>
		<ul>
			<li><strong>Рамзи қайд:</strong> 17372313 (Феҳристи тиҷорати электронии Эстония)</li>
			<li><strong>Рақами ААИ:</strong> EE102924327</li>
			<li><strong>Суроғаи қайд:</strong> Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Эстония</li>
			<li><strong>Тамоси махфият:</strong> <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a></li>
			<li><strong>Огоҳиҳои расмии ҳуқуқӣ:</strong> <a href="mailto:legal@kiff.dev">legal@kiff.dev</a></li>
		</ul>
		<p>
			Азбаски Kiff Agents OÜ дар Иттиҳоди Аврупо таъсис ёфтааст, Қоидаҳои умумии ҳифзи маълумоти Иттиҳоди Аврупо (<abbr title="General Data Protection Regulation">GDPR</abbr>) ба коркарди мо ба таври табиӣ татбиқ мешаванд. Ба мо Намояндаи ИА тибқи моддаи 27 лозим нест.
		</p>
	</section>
}

templ privacyScopeTG() {
	<section id="scope">
		<h2>2. Доираи ин сиёсат</h2>
		<p>
			Ин сиёсат маълумоти шахсиеро, ки мо ҳангоми муошират бо инҳо коркард мекунем, фаро мегирад:
		</p>
		<ul>
			<li><a href="https://kiff.dev"><code>kiff.dev</code></a> — сайти маркетингии мо, ин саҳифаи сиёсат ва сатҳи оммавии намоиши квитансияҳо.</li>
			<li><a href="https://app.kiff.dev"><code>app.kiff.dev</code></a> — лавҳаи идоракунии мо, ки воридшавӣ талаб мекунад.</li>
			<li><a href="https://api.kiff.dev"><code>api.kiff.dev</code></a> — HTTP API-и мо.</li>
			<li id="tafs"><strong>tafs</strong> — барномаи мо барои iPhone, iPad, Android ва компютерҳо (Mac, Windows ва Linux), ва хизмати паси он (аз ҷумла Setup, ки абзорҳои ширкатро пайваст мекунад, ва planque, ки он пайвастшавиҳоро нигоҳ медорад), ки дар он ширкат кореро ба агенти AI месупорад, ки дар дохили KIFF Card-ҳо кор мекунад.</li>
		</ul>
		<p>
			Ин сиёсат чаҳорчӯбаи манбаи кушодаи <code>kiff/kiff</code>-ро, ки шумо метавонед худатон иҷро кунед, <em>фаро намегирад</em>. Вақте ки шумо чаҳорчӯбаро дар зерсохтори худ иҷро мекунед, шумо контролёри ҳар маълумоте ҳастед, ки он коркард мекунад, ва Kiff Agents OÜ ба он коркард ҷалб нест.
		</p>
	</section>
}

templ privacyRolesTG() {
	<section id="roles">
		<h2>3. Нақшҳои мо тибқи GDPR</h2>
		<p>
			Мо вобаста ба маълумот дар ду сифат амал мекунем:
		</p>
		<ul>
			<li>
				<strong>Контролёр</strong> барои метамаълумоти ҳисоб ва воридшавӣ, маълумоти ҳисобкунӣ (вақте ки ҳисобкунӣ фаъол аст), муоширотҳои маркетингие, ки шумо интихоб мекунед, ва телеметрияи амалиётии хизмати худамон.
			</li>
			<li>
				<strong>Коркардкунанда</strong> барои маълумоти аудит, сабтҳои амал, квитансияҳои қарор ва мундариҷаи дигаре, ки аз номи муштариёни мо тавассути runtime мегузарад, ва барои он чи tafs барои онҳо нигоҳ медорад (иҷроҳо, сӯҳбатҳо, ҳисоботҳо, ёддоштҳои хотираи ҳар як taf ва файлҳое, ки онҳо месупоранд). Муштариён (tenant-ҳо) контролёрони он маълумот мебошанд; онҳо ба мо тавассути танзимоти ҳисоб ва танзими домени худ дастур медиҳанд. Созишномаи коркарди маълумот (<abbr title="Data Processing Agreement">DPA</abbr>) он муносибатро танзим мекунад; барои шартҳои нашршуда <a href="/legal/dpa">шаблони DPA</a> (бо забони англисӣ)-ро бинед.
			</li>
		</ul>
		<p>
			Ин сиёсат асосан коркарди мо дар ҷониби контролёрро баррасӣ мекунад. Дар ҷое ки мо дар бораи маълумоти ҷониби коркардкунанда ёдовар мешавем, DPA ҳуҷҷати мушаххастар аст.
		</p>
	</section>
}

templ privacyCategoriesTG() {
	<section id="categories">
		<h2>4. Категорияҳои маълумоти шахсие, ки мо коркард мекунем</h2>
		<p>
			Категорияҳои зер бо феҳристи техникӣ дар <a href="/security#data-we-process">/security#data-we-process</a> (бо забони англисӣ) мувофиқанд. Дар ҷое ки ин ду фарқ мекунанд, саҳифаи техникӣ сарчашмаи ҳақиқат аст ва мо ин қисмро мувофиқ навсозӣ мекунем.
		</p>
		<ul>
			<li>
				<strong>Муайянкунандаҳои ҳисоб</strong> — мавзӯи аутентификатсияи болоии шумо (аз ҷониби таъминкунандаи ҳувияти мо додашуда) ва суроғаи почтаи электронӣ, ки шумо бо он ворид мешавед. Имрӯз ба таври айнан нигоҳ дошта мешавад; ҳэш кардан ҳангоми нигоҳдорӣ ба нақша гирифта шудааст.
				Агар воридшавӣ бо рамзи тавассути почтаи электронӣ фиристодашударо фаъол кунед (он хомӯш аст, то даме ки шумо фаъол накунед), KIFF ин танзимро бо шиносаи воридшавии шумо ва санаи тағйир нигоҳ медорад. Рамзе, ки мо ба шумо тавассути почтаи электронӣ мефиристем, танҳо ҳамчун хеши калиддор нигоҳ дошта мешавад, то даме ки истифода шавад ё даҳ дақиқа гузарад. Барои маҳдуд кардани сӯиистифода мо то як рӯз шумораи дархостҳоро аз рӯи хеши калиддори суроғае, ки дархост кард, ва суроғаи IP нигоҳ медорем. Пас аз воридшавӣ бо рамз мо инро як чоряк соат қайд мекунем, то тағйиротие, ки воридшавии тару тоза талаб мекунанд, аз шумо хоҳиш кунанд, ки бо роҳи дигар ворид шавед.
			</li>
			<li>
				<strong>Метамаълумоти Tenant</strong> — tenant id, slug, номи намоишӣ, мӯҳри вақти эҷод, ва забоне, ки барномаи ҳар шахс охирин бор истифода бурдааст, то почтаҳои электронии KIFF ба онҳо бо он забон биёянд.
			</li>
			<li>
				<strong>Маълумоти эътимодномаи API</strong> — сабтҳои шаффофнашавандаи калиди API (мо ҳэшҳоро нигоҳ медорем, ҳаргиз матни оддиро не).
			</li>
			<li>
				<strong>Маълумоти кукии ҷаласа</strong> — кукии ҷаласаи бо HMAC имзошуда, ки пас аз воридшавӣ гузошта мешавад. Қисми кукиҳоро дар зер бинед.
			</li>
			<li>
				<strong>Метамаълумоти дархости HTTP</strong> — суроғаи IP, user agent, роҳи дархост, ҳолати посух, таъхир. Барои амният ва пешгирии сӯиистифода дар давоми мӯҳлати маҳдуди нигоҳдорӣ дар ҳисоботҳои дастрасии reverse proxy-и мо нигоҳ дошта мешавад.
			</li>
			<li>
				<strong>Мундариҷаи аз тарафи tenant идорашаванда</strong> — маълумоти <code>parameters</code>, <code>actor</code> ва <code>entity</code>, ки шумо ба runtime мефиристед. Мо инро <em>ҳамчун коркардкунанда</em> аз номи муштарӣ нигоҳ медорем; муштарӣ барои он чи ба сим мерасад, масъул аст. Танзими махфикунӣ барои ҳар домен ба нақша гирифта шудааст.
			</li>
			<li>
				<strong>Муошират</strong> — почтаҳои электронии шумо ба қуттиҳои почтаи дастгирӣ, фурӯш, амният ё махфияти мо.
			</li>
			<li>
				<strong>Барномаи tafs</strong> — шумо ба tafs бо ҳисоби KIFF-и худ ворид мешавед. Дар телефон ё планшет барнома ҷаласаи шуморо дар Keychain-и дастгоҳ (дар Android дар захираи рамзгузоришудаи он) нигоҳ медорад. Дар компютер он барои ҳисоби корбарии шумо мӯҳр карда нигоҳ дошта мешавад: дар компютери Windows бо ҳифзи маълумоти худи Windows, дар Linux дар keyring-и шумо, дар Mac дар Keychain-и он. Ҷаласаи компютер то 90 рӯз давом мекунад. барнома калиди имзоеро месозад, ки ҳаргиз аз дастгоҳ берун намеравад: дар Secure Enclave-и iPhone, iPad ё Mac, дар Keystore-и дастгоҳи Android, ё дар TPM-и компютери Windows. Дар Linux ва дар Mac бе Secure Enclave калид калиди нармафзорӣ аст, ки дар keyring ё Keychain-и шумо нигоҳ дошта мешавад ва он компютер метавонад нишон диҳад, ки чӣ интизори шумост, вале тасдиқ карда наметавонад; шумо дар телефони худ тасдиқ мекунед{ macSecurityKey("tg") }. Компютери Windows бе TPM ба tafs ворид шуда наметавонад. KIFF нисфи оммавии калид, номи дастгоҳ ва платформаро, ва вақти илова шудан ва истифодаи охиринро нигоҳ медорад, то ҷавобҳои шуморо ба занги нигоҳдошташуда ва тасдиқҳои пайвастшавиҳои шуморо санҷад. вақте ки шумо дар компютери худ бо passkey, масалан Windows Hello ё калиди амният, тасдиқ мекунед, рӯй, ангушт ё PIN-и шумо бо низоми худи компютер мемонад. KIFF калиди оммавии passkey, id-и он, ҳисобкунак ва номро нигоҳ медорад, ҳаргиз чизи махфӣ не, ва passkey-ро, ки бо дастгоҳҳои дигар ҳамоҳанг мешавад, рад мекунад. дар телефон, планшет ё Mac, ки барномаи iPad-ро иҷро мекунад, вақте ки шумо онҳоро фаъол мекунед, мо push token-и дастгоҳро бо id-и шахси KIFF-и шумо ва забоне, ки барнома нишон дод, нигоҳ медорем. Огоҳӣ тавассути Apple ё Google танҳо бо он ки кадом taf ва чӣ мехоҳад, мегузарад, ва дар огоҳии дарвоза номи ё суроғаи почтаи электронии касе, ки навиштааст: ҳаргиз маблағ ё тафсилоти дархост не. Барнома инҳоро дар худи дастгоҳ, аз KIFF илова мекунад, бинобар ин огоҳии телефони кушода метавонад маблағ, фурӯшанда ё шахсро нишон диҳад. Дар телефони Android-и қуфлшуда он танҳо "taf ба шумо лозим аст"-ро нишон медиҳад, ва дар iPhone-и қуфлшуда низ, агар шумо пешнамоишҳои онро ба ҳамеша нишон додан танзим накарда бошед. Дар компютери Windows, компютери Linux ё Mac бо барномаи macOS 12 огоҳиҳоро худи барнома ҳангоми кор кардан месозад, бидуни push token ва тавассути ягон ширкати дигар. Дар Windows ва Linux онҳо нишон медиҳанд, ки кадом taf, чӣ кор карданӣ аст, маблағ, барои чӣ ва то кай; дар барномаи macOS 12 онҳо пас аз фаъол кардани шумо суханони KIFF-ро барои занг нишон медиҳанд, ва экрани қуфлшуда он чиро, ки танзими пешнамоиши Mac иҷозат медиҳад, нишон медиҳад. Дар Windows онҳо то фаъол кардани шумо хомӯшанд ва ҳангоми қуфл будани экран танҳо "taf ба шумо лозим аст"-ро нишон медиҳанд. Огоҳие, ки пеш аз қуфл шудани экран нишон дода шудааст, тафсилоти худро дар феҳристи огоҳиҳои Windows нигоҳ медорад. Дар Linux онҳо то хомӯш кардани шумо фаъоланд ва он чи экрани қуфлшуда нишон медиҳад, аз мизи корӣ вобаста аст. хизмати tafs забони ҳисобро, аз касе, ки охирин бор бо Coach сӯҳбат кардааст, то се моҳ нигоҳ медорад, то ҳисоботҳои taf бо он забон биёянд. <strong>Соати шумо:</strong> соат на гузарвожа ва на калидеро нигоҳ медорад, танҳо бо телефони ҷуфтшудаи шумо сӯҳбат мекунад ва ҳаргиз тасдиқ намекунад. Он он чиро, ки шумо ба Coach ё ба taf-и интихобкардаатон мегӯед, танҳо ҳамчун матн, тавассути телефон, пас аз он ки шумо ба AI иҷозат додед, мефиристад. Хизмати гуфтории худи соат, аз Apple ё Google, суханони шуморо ба он матн табдил медиҳад. Дар Wear OS, агар он пеш аз тамом кардани суханатон қатъ шавад, ошкорсози худи телефони шумо онро дар телефон анҷом медиҳад. Он метавонад танҳо ҳангоме рад кунад, қатъ кунад ё ба Coach ё taf фиристад, ки қуфли экран ё рамзи гузариш дошта бошад ва кушода бошад. Он чиро, ки шумо ба taf мефиристед, ба сӯҳбати худи ҳамон taf меравад, гӯё ки шумо онро дар телефон навиштаед. Сӯҳбати taf, бо маблағҳо, ҳар дафъа ҳангоми кушода шудан тавассути телефон хонда мешавад, ва соат танҳо паёмҳои охиринеро нигоҳ медорад, ки қисми худи он дар поён тавсиф мекунад. <strong>Apple Watch:</strong> он taf-ҳои шумо ва саҳифаҳои онҳоро бе нигоҳдорӣ нишон медиҳад. Он Inbox-и шуморо нигоҳ медорад, дар файле, ки ҳангоми қуфл будан хонда наметавонад: ҳар як занги нигоҳдошташуда ҳамчун номи taf-и он ва он чӣ мепурсад, ҳаргиз маблағ нест, ва ҷавобҳои Coach ба он чизе, ки шумо аз соат фиристодаед, ҳамчун матн. Агар шумо дар соат баромада равед, он инчунин нигоҳ медорад, ки шумо ин корро кардед, то он даме ки шумо боз дар соат ворид шавед. Ғайр аз ин, агар соат рамзи гузариш надошта бошад, он чизеро нигоҳ намедорад. Inbox ҳангоми баромадани шумо дар соат ё баромадани iPhone-и шумо, ё дафъаи дигаре, ки барнома бе рамзи гузариш кушода ё пӯшида мешавад, нест мешавад. Он ягон сабт намекунад ва танҳо огоҳиномаҳое, ки нишон медиҳад, огоҳиномаҳои iPhone-и шумо мебошанд. Барои он ки сӯҳбат фавран кушода шавад, он инчунин 30 паёми охирини ҳар яке аз то 20 сӯҳбати дар он кушодаатонро, аз Coach ва tafs-и шумо, танҳо ҳамчун матн ва ҳаргиз маблағ не, мисли Inbox қуфлшуда нигоҳ медорад; онҳо ҳангоми тоза шудани Inbox ва вақте ки сӯҳбат 30 рӯз кушода нашудааст, тоза мешаванд. <strong>Wear OS:</strong> он почтаи электронии ҳисоби шумо ва тақвими имрӯзаро бе нигоҳдорӣ нишон медиҳад. Барои он ки фавран кушода шавад, он рамзгузоришуда шумораи он чиро, ки интизори шумост, ва номи ҳар як taf ва ин ки мутаваққиф ё қатъшуда аст ё не, нигоҳ медорад: ҳаргиз маблағ, тафсилоти занги нигоҳдошташуда ё сӯҳбати taf нест. Ин ҳангоми баромадани шумо, ҳангоми қуфл шудани соат ё аз банди даст канда шудани он, ва пас аз 24 соат тоза мешавад. Он Inbox-и шуморо нигоҳ медорад, ки дар он ҳар сатр номи taf ва он чӣ мегӯяд, ҳаргиз маблағ нест, ва як паёме, ки барои баъдтар фиристодан нигоҳ дошта шудааст, ҳамчун матн. Баромадан, дар соат ё дар телефон, ҳамаашро тоза мекунад. Барои плиткаи худ, он инчунин шумораи он чиро, ки интизори шумост, нигоҳ медорад, ки танҳо ҳангоми кушода будани соат нишон дода мешавад ва ҳангоми баромадани шумо, ё дафъаи дигаре, ки плитка ҳангоми қуфл будани соат ё надоштани қуфли экран нишон дода мешавад, тоза мешавад. Пас аз он ки шумо дар соат баромадед, он қайдеро нигоҳ медорад, ки шумо ин корро кардед, то он даме ки шумо боз ворид шавед. Inbox дафъаи дигаре, ки барнома ҳангоми қуфл будани соат ё надоштани қуфли экран кушода ё пӯшида мешавад, низ нест мешавад. Паёме, ки барои баъдтар нигоҳ дошта шудааст, то он даме, ки шумо онро мефиристед ё нест мекунед, мемонад, зеро шумо хостаед, ки он фиристода шавад. Агар хизмати гуфтории соат пеш аз тамом кардани суханатон қатъ шавад, соат сабтро ба телефони шумо мефиристад, ки онро дар худи телефон ба матн табдил медиҳад, ҳаргиз дар сервер не. Сабт дар ҳар ду ҷо нест карда мешавад, вақте ки матн бармегардад ё шумо бекор мекунед, ва пас аз 2 дақиқа ҳадди аксар. Танҳо матн ба Coach ё taf-и шумо мегузарад. Натиҷаи taf метавонад дар огоҳиномаҳои соат бимонад, то он даме ки шумо онро рад кунед ё дар соат бароед. Барои он ки сӯҳбат фавран кушода шавад, он инчунин 30 паёми охирини ҳар яке аз то 20 сӯҳбати дар он кушодаатонро, аз Coach ва tafs-и шумо, танҳо ҳамчун матн ва ҳаргиз маблағ не, мисли Inbox рамзгузоришуда нигоҳ медорад; онҳо ҳангоми баромаданатон дар соат ё телефон ва вақте ки сӯҳбат 30 рӯз кушода нашудааст, тоза мешаванд, ва соати бе қуфли экран ягонтои онҳоро нигоҳ намедорад. вақте ки шумо абзореро пайваст мекунед, шумо дар назди таъминкунандаи худи абзор ворид мешавед. Барои барномае, ки planque худаш ворид мешавад, масалан Stripe, ё калиде, ки шумо медиҳед, planque он token ё калидро барои ширкати шумо рамзгузоришуда нигоҳ медорад. Барои пайвастшавии идорашаванда, Composio, хизмати пайвасткунӣ, ки planque бо он кор мекунад, воридшавиро нигоҳ медорад, ва planque танҳо сабти пайвастшавӣ ва абзорҳои тасдиқкардаи шуморо нигоҳ медорад (ҳамааш ҳамчун коркардкунанда, дар зер нигаред). Агар васеъшавии tafs-ро ҷуфт кунед, taf метавонад саҳифаҳои сайтҳоеро, ки иҷозат медиҳед, дар Chrome-и худи шумо хонад ва дар онҳо амал кунад (ҳамчун коркардкунанда; <a href="/tg/tafs/privacy">саҳифаи махфияти tafs</a> мегӯяд, ки чӣ хонда мешавад, чӣ нигоҳ дошта мешавад ва то кай). Сабти пайвастшавӣ метавонад ҳисоберо, ки ба он ворид шудааст (номи ё почтаи электронии он), дар бар гирад, то барнома ба шумо нишон диҳад, ки кадом аст. KIFF пайвастшавиҳои идорашавандаро танҳо барои барномаҳое, ки дар <a href="/subprocessors#composio">/subprocessors</a> (бо забони англисӣ) номбар шудаанд, истифода мебарад. Барнома ҳеҷ таҳлилгар ё пайгиркунандаи таблиғотӣ надорад.
			</li>
			<li>
				<strong>Харидҳо дар App Store</strong> — вақте ки шумо дар tafs Solo ё баста кредит мехаред, Apple онро ба шумо мефурӯшад: Apple фурӯшандаи сабтшуда аст, пардохтро мегирад ва тафсилоти пардохти шуморо нигоҳ медорад. Apple ба мо мегӯяд, ки чӣ харида шуд, барои кадом ҳисоби KIFF (id-и тасодуфие, ки барнома ба харид мепайвандад), кай, id-и муомилаи Apple, ва барои Solo кай давра ба охир мерасад ё нав мешавад. Мо онро барои илова кардани кредитҳо ё нақша ба ҳисоби шумо истифода мебарем. Apple Apple ID, ном, суроғаи почтаи электронӣ ё корти шуморо ба мо намедиҳад.
			</li>
			<li>
				<strong>Харидҳо дар Google Play</strong> — дар Android ҳамон харидҳо тавассути ҳисобкунии Google Play мегузаранд: Google пардохтро мегирад ва тафсилоти пардохти шуморо нигоҳ медорад. Google ба мо мегӯяд, ки чӣ харида шуд, барои кадом ҳисоби KIFF (ҳамон id-и тасодуфӣ), кай, token ва id-и фармоиши харид, ва барои Solo кай давра ба охир мерасад ё нав мешавад, ва мо онро ҳамон тавр истифода мебарем. Google ҳисоби Google, ном, суроғаи почтаи электронӣ ё корти шуморо ба мо намедиҳад.
			</li>
		</ul>
	</section>
}

templ privacyLawfulBasesTG() {
	<section id="lawful-bases">
		<h2>5. Асосҳои қонунӣ барои коркард</h2>
		<p>
			Тибқи моддаи 6-и GDPR мо ба асосҳои қонунии зерин такя мекунем:
		</p>
		<ul>
			<li>
				<strong>Иҷрои шартнома</strong> (моддаи 6(1)(b)) — барои эҷоди ҳисоб, аутентификатсия, иҷрои runtime аз номи шумо, ҳисобкунӣ (вақте ки фаъол аст), ва сатҳҳои асосии хизмат.
			</li>
			<li>
				<strong>Манфиатҳои қонунӣ</strong> (моддаи 6(1)(f)) — барои амният, пешгирии қаллобӣ, ошкор кардани сӯиистифода, телеметрияи амалиётӣ ва ҳифзи хизмат. Мо манфиатҳои худро бо ҳуқуқҳои шумо таносуб мекунем ва ба дархости шумо мегӯем, ки он санҷиши таносуб чӣ натиҷа дод.
			</li>
			<li>
				<strong>Розигӣ</strong> (моддаи 6(1)(a)) — барои AI дар барномаи tafs: он чи ба модели AI, ки Coach ва taf-ҳои шуморо иҷро мекунад, фиристода мешавад, ончунон ки <a href="#ai-in-tafs">дар зер</a> тавсиф шудааст. То иҷозати шумо чизе фиристода намешавад, ва шумо метавонед дар Ҳисоб бозпас гиред. Розигӣ инчунин он чизест, ки мо пеш аз ҳар гуна кукиҳои таҳлилӣ, муоширотҳои ихтиёрии маркетингӣ ё коркарди нав, ки истифодаи маълумоти шуморо ба таври назаррас васеъ мекунад, талаб мекунем. Мо ҳеҷ таҳлил, таблиғот ва пайгирии ғайризарурӣ иҷро намекунем.
			</li>
			<li>
				<strong>Ӯҳдадории қонунӣ</strong> (моддаи 6(1)(c)) — барои сабтҳои андоз (Қонуни ҳисобдории Эстония §12, 7 сол), посух ба дархостҳои қонунии мақомот, ва нигоҳдорие, ки қоидаҳои муқобили шустани пул талаб мекунанд, дар ҷое ки татбиқ мешавад.
			</li>
		</ul>
		<h3 id="ai-in-tafs">AI дар барномаи tafs</h3>
		<p>Барномаи tafs пеш аз он ки чизе ба AI равад, аз шумо бо ин суханон мепурсад:</p>
		<ul>
			<li>tafs барои Coach ва taf-ҳои шумо Claude AI-и Anthropic-ро истифода мебарад.</li>
			<li>Coach ва taf-ҳои шумо агентҳои AI ҳастанд: он чи онҳо менависанд, аз тарафи AI тавлид мешавад ва метавонад хато бошад. Паёме, ки taf берун аз ширкати шумо мефиристад, нишон медиҳад, ки онро агенти AI навиштааст.</li>
			<li>Ба он чӣ фиристода мешавад: он чиро, ки шумо ба Coach ва taf-ҳои худ менависед, файлҳое, ки замима мекунед, он чиро, ки барномаҳои пайвастшудаи шумо ҳангоми кор кардани taf ба он бармегардонанд, ва он чиро, ки дар экрани шумост, ҳангоме ки Coach дар барнома ба шумо кӯмак мекунад.</li>
			<li>Ҳаргиз фиристода намешавад: гузарвожаҳо ва калидҳое, ки барномаҳои пайвастшудаи шумо истифода мебаранд, ё изи ангушти шумо.</li>
			<li>Anthropic онро барои посух додан истифода мебарад ва то 30 рӯз нигоҳ медорад.</li>
			<li>То иҷозати шумо чизе фиристода намешавад. Шумо метавонед дар Ҳисоб бозпас гиред.</li>
		</ul>
		<p>taf, ки дар он лаҳза бе касе кор мекунад (аз рӯи ҷадвали худ, ё вақте ки чизе меояд), ба розигии шахсе, ки онро сохтааст ё гирифтааст, ё дар акси ҳол ба розигии аввалин шахсе, ки taf-ҳои ҳисобро идора мекунад ва иҷозат медиҳад, такя мекунад.</p>
		<p><strong>Вақте ки шумо бозпас мегиред,</strong> Coach ва taf-ҳои шумо посух додан ба шуморо қатъ мекунанд. taf, ки иҷроҳояш ба розигии шумо такя мекунанд, мутаваққиф мешавад: ҷадвалҳои он қатъ мешаванд ва он чи меояд, интизор мешавад. Он вақте идома меёбад, ки розигӣ дубора дода шавад, ё касе, ки taf-ҳои ҳисобро идора мекунад, онро бо розигии худаш бигирад. Бозпас гирифтан он чиро, ки пештар фиристода шуда буд, тағйир намедиҳад.</p>
		<p>Anthropic дар <a href="/subprocessors">/subprocessors</a> (бо забони англисӣ) номбар шудааст, бо он ки дар куҷо коркард мекунад ва кай метавонад маълумотро дарозтар нигоҳ дорад.</p>
	</section>
}

templ privacySubprocessorsTG() {
	<section id="sub-processors">
		<h2>6. Зеркоркардкунандагон</h2>
		<p>Мо маълумоти шахсии шуморо намефурӯшем ва онро барои таблиғот мубодила намекунем.</p>
		<p>
			Мо барои расонидани хизмат шумораи ками фурӯшандагонро ҷалб мекунем. Рӯйхати расмӣ ва ҷорӣ дар <a href="/subprocessors">/subprocessors</a> (бо забони англисӣ) аст; он саҳифа дар давоми 30 рӯз пас аз ҳар тағйир навсозӣ мешавад. Мо аз ҳар як зеркоркардкунанда талаб мекунем, ки тибқи созишномаҳои хаттӣ, аз ҷумла Бандҳои стандартии шартномавии ИА дар ҷое ки маълумоти шахсӣ аз ИА берун меравад, ҳимояеро, ки ба ҳимояи мо баробар аст, таъмин кунад.
		</p>
		<p>
			Иловаҳо ё иваз кардани зеркоркардкунандагони назаррас, ки ба маълумоти шахсӣ таъсир мерасонанд, ба муштариёни фаъол пешакӣ, бо ҳуқуқи эътироз, хабар дода мешаванд.
		</p>
	</section>
}

templ privacyTransfersTG() {
	<section id="transfers">
		<h2>7. Интиқолҳои байналмилалӣ</h2>
		<p>
			Баъзе аз зеркоркардкунандагони мо берун аз Минтақаи иқтисодии Аврупо, асосан дар Иёлоти Муттаҳида таъсис ёфтаанд. Барои ҳар чунин интиқол мо ба ҳадди ақал яке аз ҳифзҳои зерин такя мекунем:
		</p>
		<ul>
			<li>
				<strong>Чаҳорчӯбаи махфияти маълумоти ИА–ИМА</strong> — барои зеркоркардкунандагони амрикоие, ки чаҳорчӯбаро тасдиқ кардаанд. Қарори кифоягӣ аз миёнаи соли 2023 амал мекунад; мо барои ҳар тағйир дар вазъияти он назорат мекунем.
			</li>
			<li>
				<strong>Бандҳои стандартии шартномавӣ</strong> — модули 2 (аз контролёр ба коркардкунанда) барои зеркоркардкунандагони мустақими мо ва модули 3 (аз коркардкунанда ба зеркоркардкунанда) дар ҷое ки коркардкунандагони занҷирӣ татбиқ мешаванд. Мо SCC-ҳои соли 2021-и аз ҷониби Комиссия тасдиқшударо истифода мебарем.
			</li>
			<li>
				<strong>Чораҳои иловагӣ</strong> — дар ҷое ки арзёбии хавф нишон медиҳад, ки ҳифзҳои иловагӣ заруранд (рамзгузорӣ ҳангоми интиқол ва нигоҳдорӣ, сабти дастрасӣ, камкунии маълумот).
			</li>
		</ul>
		<p>
			Шумо метавонед воситаи мушаххаси интиқолро, ки ба зеркоркардкунандаи додашуда татбиқ мешавад, бо навиштани почтаи электронӣ ба <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> талаб кунед.
		</p>
		<p><strong>Кишвари шумо.</strong> Қонунҳои баъзе кишварҳо аз он чӣ ин сиёсат мегӯяд, бештар талаб мекунанд. Он чиро, ки онҳо илова мекунанд, ба забони англисӣ ва ба забони кишвар, дар <a href="/privacy/countries">Кишвари шумо</a> (бо забони англисӣ) ёфтан мумкин аст.</p>
	</section>
}

templ privacyRetentionTG() {
	<section id="retention">
		<h2>8. Нигоҳдорӣ</h2>
		<p>
			Мо маълумоти шахсиро барои кӯтоҳтарин мӯҳлате нигоҳ медорем, ки ба мақсадҳое, ки барои онҳо коркард мекунем, ва ҳар гуна ӯҳдадории қонунии татбиқшаванда мувофиқ аст.
		</p>
		<ul>
			<li>
				<strong>Метамаълумоти ҳисоб ва воридшавӣ</strong> — то нест шудани ҳисоб. Дар барномаи tafs соҳиб онро дар Ҳисоб → <em>Ҳисобро нест кунед</em> нест мекунад. Ҳисоби дар веб эҷодшуда бо навиштани почтаи электронӣ ба <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>, дар давоми мӯҳлати як моҳаи моддаи 12(3)-и GDPR, нест карда мешавад. Дар ҳар сурат калидҳои ҳисоб фавран қатъ мешаванд. Агар дар барномаи tafs нест шавад, онро бозгардонидан мумкин нест: сӯҳбатҳо, ёддоштҳо ва пайвастшавиҳои tafs-и он фавран нест карда мешаванд, ва он чи KIFF нигоҳ медорад, дар давоми 30 рӯз нест карда мешавад. Агар дар веб нест шавад, мо маълумоти онро барои мӯҳлати тамдиди 30 рӯза нигоҳ медорем, ба сурати он ки соҳиб онро бозхоҳад, баъд нест мекунем.
			</li>
			<li>
				<strong>Сабтҳои калиди API</strong> — то нест шудани ҳисоб, аз ҷумла пас аз бекор кардани калид. Калиде, ки ба пайвастшавии воридшавии агент тааллуқ дорад, бо он пайвастшавӣ, 30 рӯз пас аз анҷоми он нест карда мешавад.
			</li>
			<li>
				<strong>Кукиҳои ҷаласа</strong> — то поёни мӯҳлат (ба таври пешфарз 24 соат) ё то баромадани шумо.
			</li>
			<li>
				<strong>Ҳисоботҳои дастрасии reverse-proxy</strong> — то 90 рӯз, баъд ҷамъбаст ё нест карда мешаванд.
			</li>
			<li>
				<strong>Ҳисоботҳои хизмат</strong> — он чи хидматҳои KIFF ва planque ҳангоми кор сабт мекунанд: хатогиҳо ва дархостҳо, ки метавонанд ҳисоб, шахс ё агентро ном баранд. 30 рӯз, баъд нест карда мешавад.
			</li>
			<li>
				<strong>Нусхаҳои эҳтиётӣ</strong> — пойгоҳи додаҳои KIFF ҳар рӯз нусхабардорӣ мешавад, рамзгузоришуда, ва ҳар нусха 7 рӯз нигоҳ дошта мешавад, бинобар ин сабти нестшуда дар давоми 7 рӯз аз онҳо нест мешавад. Захираҳои tafs ва planque нусхаҳои нуқтаи-вақти рамзгузоришударо 35 рӯз нигоҳ медоранд, ки танҳо барои барқарор кардани захира пас аз вайроншавӣ истифода мешаванд, бинобар ин сабти нестшуда дар давоми 35 рӯз аз онҳо нест мешавад.
			</li>
			<li>
				<strong>Маълумоти аудити tenant</strong> — аз номи коркардкунанда мувофиқи танзими tenant-и муштарӣ нигоҳ дошта мешавад. Пешфарз: барои тамоми умри tenant нигоҳ дошта мешавад; ҳангоми нест кардани tenant нест карда мешавад. <a href="/security#deletion">/security#deletion</a> (бо забони англисӣ)-ро бинед.
			</li>
			<li>
				<strong>Занги тавассути дарвозаи KIFF</strong> — аргументҳои занг то он даме, ки фиристода, рад ё ноком мешавад, баъд нест карда мешаванд; натиҷаи абзор 24 соат, баъд нест карда мешавад. Сабти қарор ва ҳэши аргументҳо ҳамчун маълумоти аудити tenant нигоҳ дошта мешаванд. <a href="/security#data-kept">/security#data-kept</a> (бо забони англисӣ)-ро бинед.
			</li>
			<li>
				<strong>Истифода</strong> — барои ҳар занг тавассути дарвоза, вақте ки ба охир мерасад: кадом агент онро кардааст, абзор, ва ҳамчун амал ҳисоб шуд ё ройгон буд (ва чаро). Барои ҳар иҷрои taf ё Coach, вақте ки ба охир мерасад: taf, кай, кредитҳое, ки AI-и он истифода бурд, ва ҳисоб шуданд ё чаро не. То нест шудани ҳисоб; он чи ба коркардкунандаи пардохти мо барои ҳисобкунӣ хабар дода мешавад, бо сабтҳои ҳисобкунӣ нигоҳ дошта мешавад.
			</li>
			<li>
				<strong>Пайвастшавиҳои воридшавии агент</strong> — кадом агент, номи барнома, кӣ иҷозат дод, кай, ва истифодаи охирини он: дар ҳоле ки пайвастшавӣ зинда аст, баъд 30 рӯз пас аз анҷоми он (он дар ин муддат дар лавҳаи идоракунӣ рӯйхат шуда мемонад), баъд бо token-ҳо ва калиди API-и он нест карда мешавад. Ҳамаи инҳо бо ҳисоб нест карда мешаванд.
			</li>
			<li>
				<strong>tafs</strong> — push token-и дастгоҳ то баромадани шумо аз барнома, хориҷ кардани дастгоҳ, ё хабар додани Apple ё Google, ки token нест шудааст. Калиди оммавӣ, ном, платформа ва санаҳои дастгоҳ ҳангоми истифодаи шумо; пас аз баромадани шумо аз он, он ҳамчун хориҷшуда қайд шуда то нест шудани ҳисоб нигоҳ дошта мешавад, то KIFF ҷавоби дерро аз он рад кунад ва нишон диҳад, ки кадом дастгоҳ пештарро имзо кардааст. Калиди оммавӣ, id ва номи passkey монанди дастгоҳи он нигоҳ дошта мешаванд. Компютер ҷаласаи худро то 90 рӯз, ё то баромадани шумо нигоҳ медорад. Он чи tafs барои ширкати шумо нигоҳ медорад, ҳамчун коркардкунанда нигоҳ дошта мешавад: иҷроҳо ва сӯҳбатҳои taf, бо хулосаи сӯҳбат (ва Setup), 30 рӯз, он чи абзорҳои шумо бармегардонанд, танҳо то поёни иҷро (дар сӯҳбат он чи танҳо хонда шуд, барои паёмҳои баъдии он рамзгузоришуда нигоҳ дошта мешавад, то яксоат ғайрифаъол мондани сӯҳбат ва ҳадди аксар то чор соат пас аз хондан истифода мешавад, баъд дар давоми чанд рӯз худкор нест карда мешавад), ва ёддоштҳои хотираи он то хориҷ шудани taf; файлҳое, ки он месупорад, 30 рӯз аз иҷрое, ки онҳоро сохт, баъд дар давоми як рӯз худкор нест карда мешаванд, ё барвақттар агар касе дар ҳисоби шумо яктоашро нест кунад; token ё калиди пайвастшавӣ дар planque, ё воридшавии пайвастшавии идорашаванда дар Composio, то қатъ кардани пайванди шумо (агар пайвастшавии дигари шумо метавонад ҳамон ҳисобро дар назди он фурӯшанда истифода барад, он бе истифода нигоҳ дошта мешавад, то он низ қатъ шавад), ва сабти тасдиқҳои он то поёни ҳисоб; <a href="/legal/dpa#annex-4">Замимаи 4-и DPA</a> (бо забони англисӣ)-ро бинед.
			</li>
			<li>
				<strong>Сабтҳои ҳисобкунӣ</strong> — 7 сол аз охири соли молиявӣ (Қонуни ҳисобдории Эстония §12).
			</li>
			<li>
				<strong>Харидҳо дар App Store ва Google Play</strong> — он чи Apple ё Google дар бораи ҳар харид ба мо гуфтаанд, то нест шудани ҳисоб дар ҳисоби шумо мемонад. Ҳисоботҳои фурӯш ва пардохти онҳо, ки мо ҳамчун сабтҳои ҳисобкунӣ 7 сол нигоҳ медорем, шуморо ном намебаранд.
			</li>
			<li>
				<strong>Мукотибаи дастгирӣ</strong> — 3 сол аз тамоси охирин, баъд нест карда мешавад.
			</li>
		</ul>
	</section>
}

templ privacyRightsTG() {
	<section id="rights">
		<h2>9. Ҳуқуқҳои шумо</h2>
		<p>
			Тибқи GDPR шумо нисбат ба маълумоти шахсии худ ҳуқуқҳои зеринро доред:
		</p>
		<ul>
			<li><strong>Дастрасӣ</strong> (моддаи 15) — тасдиқ, ки оё мо маълумоти шуморо коркард мекунем, ва нусхаи он.</li>
			<li><strong>Ислоҳ</strong> (моддаи 16) — ислоҳи маълумоти нодуруст ё нопурра.</li>
			<li><strong>Нест кардан</strong> (моддаи 17) — нест кардани маълумоти шумо, бо истиснои истисноҳои нигоҳдории қонунӣ.</li>
			<li><strong>Маҳдуд кардан</strong> (моддаи 18) — таваққуфи коркард ҳангоме ки баҳс ҳал мешавад.</li>
			<li><strong>Интиқолпазирӣ</strong> (моддаи 20) — содироти барои мошин хондашавандаи маълумоте, ки шумо додаед.</li>
			<li><strong>Эътироз</strong> (моддаи 21) — ба коркарди ба манфиатҳои қонунӣ асосёфта; мо қатъ мекунем, магар ки асосҳои бартаридошта нишон диҳем.</li>
			<li><strong>Бозпас гирифтани розигӣ</strong> (моддаи 7(3)) — барои ҳар коркарде, ки ба розигӣ асос ёфтааст, масалан AI дар барномаи tafs (дар Ҳисоб, ончунон ки <a href="#ai-in-tafs">дар боло</a>). Бозпас гирифтан ба коркарди қонунии пештара таъсир намерасонад.</li>
		</ul>
		<p>
			Барои истифодаи ҳар яке аз ин ҳуқуқҳо ба <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> нома фиристед. Мо мувофиқи моддаи 12(3) бе таъхири беасос ва дертаринаш дар давоми як моҳ ҷавоб медиҳем; барои дархостҳои мураккаб метавонем то ду моҳи дигар дароз кунем ва агар ин корро кунем, ба шумо мегӯем.
		</p>
		<h3 id="export-chats">Сӯҳбатҳои tafs-и худи шумо</h3>
		<p>
			Дар барномаи tafs, Ҳисоб → Содироти сӯҳбатҳои ман сӯҳбатҳои худи шуморо бо ҳар як taf, аз ҷумла сӯҳбатҳои Coach, номҳои файлҳои замимакардаатон ва ёддоштҳои худи шуморо ҳамчун файли хондашаванда ва ҳамчун JSON боргирӣ мекунад. Онҳоро танҳо шумо содир карда метавонед: админ ё соҳиби ҳисоб наметавонад, ва содироти ҳисоби KIFF онҳоро дар бар намегирад.
		</p>
		<h3 id="delete-account">Нест кардани ҳисоби tafs-и шумо</h3>
		<p>
			tafs барномаи KIFF аст. Барои нест кардани ҳисоби tafs-и худ ва маълумоти он:
		</p>
		<ol>
			<li>Барномаи tafs-ро кушоед ва ворид шавед.</li>
			<li>Ба Ҳисоб гузаред, баъд <em>Ҳисобро нест кунед</em>-ро пахш кунед.</li>
			<li>Тасдиқ кунед. Нест кардани ҳисобро бозгардонидан мумкин нест.</li>
		</ol>
		<p>
			<em>Ҳисобро нест кунед</em> ба касе нишон дода мешавад, ки метавонад ҳисоби ширкатро нест кунад, одатан соҳиби он. Агар шумо онро намебинед, ё дигар барнома надоред, аз суроғае, ки бо он ворид мешавед, ба <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> нома фиристед, ва мо маълумоти шуморо бе таъхири беасос ва дертаринаш дар давоми як моҳ нест мекунем.
		</p>
		<p>
			Чӣ нест карда мешавад: калидҳои ҳисоб фавран қатъ мешаванд. tafs, сӯҳбатҳо, ёддоштҳо, файлҳои замимашуда ва пайвастшавиҳои он фавран нест карда мешаванд, ва аз нусхаҳои нуқтаи-вақти онҳо дар давоми 35 рӯз. Он чи KIFF барои ҳисоб нигоҳ медорад, дар давоми 30 рӯз нест карда мешавад, ва аз нусхаҳои эҳтиётӣ дар давоми 7 рӯзи баъдӣ. Ҳисоботҳои хизмат, ки ҳисобро ном мебаранд, дар давоми 30 рӯз нест мешаванд. Маълумоти аудити tenant бо tenant нест карда мешавад. Барои ҳар навъи маълумот <a href="#retention">Нигоҳдорӣ</a>-ро бинед.
		</p>
		<p id="delete-data">
			Барои нест кардани баъзе маълумоти худ ва нигоҳ доштани ҳисоб: дар барнома сӯҳбатро нест кунед, ва паёмҳо ва файлҳои замимашудаи он бо он мераванд; taf-ро хориҷ кунед, ва сӯҳбатҳо, ёддоштҳо ва пайвастшавиҳои он бо он мераванд. Барои ҳар чизи дигар ба <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> нома фиристед ва бигӯед, ки чиро нест кунем. Мо инро бе таъхири беасос ва дертаринаш дар давоми як моҳ мекунем.
		</p>
		<p>
			Шумо ҳуқуқ доред ба мақоми назоратӣ шикоят кунед. Мақоми асосии назоратии мо <a href="https://www.aki.ee/en" target="_blank" rel="noopener">Нозироти ҳифзи маълумоти Эстония (Andmekaitse Inspektsioon)</a> аст. Шумо инчунин метавонед ба мақоми назоратӣ дар давлати узви ҷои зисти худ шикоят кунед.
		</p>
		<p><strong>Кишвари шумо.</strong> Қонунҳои баъзе кишварҳо аз он чӣ ин сиёсат мегӯяд, бештар талаб мекунанд. Он чиро, ки онҳо илова мекунанд, ба забони англисӣ ва ба забони кишвар, дар <a href="/privacy/countries">Кишвари шумо</a> (бо забони англисӣ) ёфтан мумкин аст.</p>
	</section>
}

templ privacyCookiesTG() {
	<section id="cookies">
		<h2>10. Кукиҳо</h2>
		<p>
			Мо се кукӣ мегузорем, ҳама ба таври қатъӣ зарурӣ, тарафи аввал, танҳо тавассути HTTPS фиристодашаванда ва барои скриптҳои саҳифа нахондашаванда. Тибқи қоидаҳои ePrivacy-и ИА онҳо розигӣ талаб намекунанд; мо онҳоро номбар мекунем, то шумо бидонед, ки онҳо ҳастанд. <a href="/cookies">Сиёсати кукиҳо</a> (бо забони англисӣ) тафсилот дорад.
		</p>
		<ul>
			<li>
				<strong><code>kiff_session</code></strong> — шуморо воридшуда нигоҳ медорад. Кукии ҷаласаи имзошуда, ки id-и воридшавӣ, почтаи электронӣ ва номи шумо, ва эътимодномаеро, ки лавҳаи идоракунӣ барои шумо истифода мебарад, дорад. Барои <code>.kiff.dev</code> гузошта мешавад. Он 24 соат, ё то баромадани шумо давом мекунад.
			</li>
			<li>
				<strong><code>kiff_flash</code></strong> — паёми якдафъаинаро ба саҳифаи навбатӣ мебарад, ба монанди "калиди шумо сохта шуд". Имзошуда; калиди нав ҳаргиз дар он нест. Барои <code>.kiff.dev</code> гузошта мешавад. Вақте ки саҳифаи навбатӣ онро мехонад, нест карда мешавад, ва ҳадди аксар 5 дақиқа.
			</li>
			<li>
				<strong><code>kiff_cb_attempts</code></strong> — мешуморад, ки саҳифаи воридшавӣ чанд маротиба аз нав бор шудааст, то воридшавии даврзананда қатъ шавад. Танҳо ба он саҳифа фиристода мешавад. Он 5 дақиқа давом мекунад ва вақте ки воридшавӣ оғоз ё муваффақ мешавад, тоза карда мешавад.
			</li>
		</ul>
		<p>
			Мо кукиҳои таҳлилӣ, кукиҳои таблиғотӣ ё ягон пайгиркунандаи тарафи сеюмро истифода намебарем. Агар мо ягонтоашро илова кунем, мувофиқи ePrivacy ва роҳнамои соли 2023-и EDPB оид ба технологияҳои пайгирӣ, пеш аз гузоштани кукӣ баннери розигӣ пешниҳод мекунем.
		</p>
		<p>
			Агар шумо тавассути Clerk (зеркоркардкунандаи аутентификатсияи мо) ворид шавед, Clerk инчунин дар домени frontend-и худ (<code>clerk.kiff.dev</code>) кукиҳо мегузорад. Он кукиҳо барои он ки Clerk шуморо дар ҷараёни воридшавии худ шиносад, заруранд ва ҳам аз ҷониби сиёсати махфияти Clerk ва ҳам аз ҷониби сиёсати мо танзим мешаванд. Барои тафсилот рӯйхати зеркоркардкунандагонро бинед.
		</p>
	</section>
}

templ privacySecurityTG() {
	<section id="security">
		<h2>11. Амният</h2>
		<p>
			Чораҳои техникӣ ва ташкилии амнияти мо дар <a href="/security">/security</a> (бо забони англисӣ) ҳуҷҷатгузорӣ шудаанд. Онҳо ҷудокунии tenant дар сатҳи пойгоҳи додаҳо, TLS 1.2+ ҳангоми интиқол, рамзгузорӣ ҳангоми нигоҳдорӣ тавассути пешфарзҳои таъминкунандаи идорашаванда, ва назорати дастрасӣ аз рӯи принсипи ҳадди ақали имтиёзро дар бар мегиранд.
		</p>
		<p>
			Мо муштариёни зарардидаро дар бораи вайроншавии маълумоти шахсӣ бидуни таъхири беасос ва дар давоми 72 соат пас аз тасдиқ, мувофиқи моддаи 33-и GDPR, хабар медиҳем. Огоҳӣ хусусияти вайронкуниро, категорияҳо ва шумораи тахминии субъектҳои маълумот ва сабтҳои дахлдор, оқибатҳои эҳтимолӣ, ва чорахои андешидашуда ё пешниҳодшударо дар бар мегирад.
		</p>
	</section>
}

templ privacyChildrenTG() {
	<section id="children">
		<h2>12. Кӯдакон</h2>
		<p>
			KIFF Cloud маҳсулоти зерсохтории барномасозон аст, ки ба кӯдакон нигаронида нашудааст. Мо маълумоти шахсиро аз кӯдаконе, ки аз 16 сол хурданд, огоҳона ҷамъ намекунем. Агар шумо боварӣ дошта бошед, ки кӯдаке ба мо маълумоти шахсӣ додааст, бо <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> тамос гиред, ва мо онро нест мекунем.
		</p>
	</section>
}

templ privacyAutomatedTG() {
	<section id="automated">
		<h2>13. Қабули қарори автоматӣ</h2>
		<p>
			Runtime-и KIFF Cloud қарорҳои сиёсати детерминистиро аз рӯи маълумоте, ки муштариёни мо мефиристанд, қабул мекунад. Инҳо қарорҳо дар бораи шумо нестанд, ки оқибатҳои ҳуқуқӣ ё ба ҳамин монанди назаррас доранд, дар маънои моддаи 22-и GDPR; онҳо қарорҳо дар бораи амалҳои муштарӣ (бозгардонидани маблағ, фармоишҳо, паёмҳо ва ғайра) мебошанд, ки тибқи сиёсати худи муштарӣ иҷро мешаванд.
		</p>
		<p>
			Муштариёне, ки KIFF Cloud-ро барои қабули қарорҳое, ки ба корбарони ниҳоии худашон таъсир мерасонанд, истифода мебаранд, барои риояи моддаи 22 худашон масъуланд. Квитансияҳои идоракунии мо барои он тарҳрезӣ шудаанд, ки ба он муштариён роҳи аудитеро диҳанд, ки барои нишон додани назорати инсонӣ лозим аст, вале ӯҳдадории қонунии таъмини он назорат ба зиммаи муштарӣ аст.
		</p>
	</section>
}

templ privacyChangesTG() {
	<section id="changes">
		<h2>14. Тағйирот дар ин сиёсат</h2>
		<p>
			Мо метавонем ин сиёсатро гоҳ-гоҳ навсозӣ кунем. Тағйироти назаррас ба муштариёни фаъол тавассути почтаи электронӣ ва баннери намоён дар ин саҳифа ҳадди ақал 30 рӯз хабар дода мешавад. Тағйироти ғайриназаррас бо санаи нави "навсозии охирин" нашр мешаванд.
		</p>
	</section>
}

