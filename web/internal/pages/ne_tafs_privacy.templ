package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsPrivacyNE is tafs's privacy policy (/tafs/privacy) in Nepali, at /ne/tafs/privacy.
// It is a translation of TafsPrivacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Nepali has the legal
// texts only, so a link to any other page goes to English and says so.
templ TafsPrivacyNE() {
	@components.LayoutSiteWithMeta("tafs को गोपनीयता नीति", "KIFF को एप tafs ले व्यक्तिगत डेटा कसरी सम्हाल्छ, तपाईंले आफ्नो Google खाता जोड्दा Google बाट पाउने डेटासहित।", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · गोपनीयता नीति</p>
				<h1>tafs को गोपनीयता नीति</h1>
				<p class="legal-meta"><strong>पछिल्लो पटक अद्यावधिक:</strong> 24 नोभेम्बर 2026।</p>
				<p class="legal-disclaimer">यो नीतिले KIFF को iPhone, iPad, Android र कम्प्युटरका लागि एप tafs ले व्यक्तिगत डेटा कसरी सम्हाल्छ भन्ने कुरा बताउँछ। tafs KIFF Cloud को हिस्सा भएकाले <a href="/ne/privacy">KIFF को गोपनीयता नीति</a> यसमा पनि लागू हुन्छ, र यो पृष्ठले नसमेटेका कुरामा पनि। प्रश्नहरू: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>।</p>
			</header>
			<section id="who-we-are">
				<h2>1. हामी को हौं</h2>
				<p>tafs एस्टोनियामा स्थापित निजी सीमित दायित्व कम्पनी <strong>Kiff Agents OÜ</strong> (दर्ता कोड 17372313, VAT नम्बर EE102924327) ले उपलब्ध गराउँछ, ठेगाना: Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, एस्टोनिया। हाम्रो प्रशोधनमा EU को सामान्य डेटा संरक्षण नियमन (GDPR) लागू हुन्छ।</p>
			</section>
			<section id="scope">
				<h2>2. यो नीतिले के समेट्छ</h2>
				<p>iPhone, iPad, Android र कम्प्युटर (Mac, Windows र Linux) का लागि tafs एप, र यसको पछाडिको सेवा, कम्पनीका औजार जोड्ने Setup र ती जडान राख्ने planque सहित। tafs मा कम्पनीले काम एउटा AI एजेन्ट, taf लाई सुम्पन्छ, जो KIFF Card हरूभित्र काम गर्छ।</p>
			</section>
			<section id="roles">
				<h2>3. हाम्रा भूमिका</h2>
				<p>हामी तपाईंको खाता र साइन इन डेटाको, र हाम्रो आफ्नै सेवाको सञ्चालन डेटाको <strong>नियन्त्रक</strong> हौं। tafs ले तपाईंको कम्पनीका लागि राख्ने कुरामा हामी कम्पनीको तर्फबाट <strong>प्रशोधक</strong> को रूपमा काम गर्छौं: हरेक taf का रन, च्याट, प्रतिवेदन, मेमोरी नोट र तिनले पुर्‍याउने फाइलहरू। तपाईंको कम्पनी त्यो डेटाको नियन्त्रक हो, र <a href="/legal/dpa">डेटा प्रशोधन सम्झौता (DPA)</a> (अङ्ग्रेजीमा) ले त्यो सम्बन्ध नियमन गर्छ।</p>
			</section>
			<section id="data">
				<h2>4. tafs ले के सङ्कलन गर्छ</h2>
				<ul>
					<li><strong>तपाईंको खाता:</strong> तपाईं आफ्नो KIFF खाताबाट tafs मा साइन इन गर्नुहुन्छ। फोन वा ट्याब्लेटमा एपले तपाईंको सत्र उपकरणको Keychain मा (Android मा, यसको इन्क्रिप्टेड भण्डारणमा) राख्छ। कम्प्युटरमा यसलाई तपाईंको प्रयोगकर्ता खाताका लागि सिल गरेर राख्छ: Windows PC मा Windows कै डेटा सुरक्षाले, Linux मा तपाईंको keyring मा, Mac मा यसको Keychain मा। कम्प्युटरको सत्र 90 दिनसम्म चल्छ।</li>
					<li><strong>तपाईंको उपकरण:</strong> एपले उपकरण नछाड्ने हस्ताक्षर कुञ्जी बनाउँछ: iPhone, iPad वा Mac को Secure Enclave मा, Android उपकरणको Keystore मा, वा Windows PC को TPM मा। Linux मा, र Secure Enclave नभएको Mac मा, कुञ्जी तपाईंको keyring वा Keychain मा राखिएको सफ्टवेयर कुञ्जी हो, र त्यो कम्प्युटरले तपाईंलाई के पर्खिरहेको छ देखाउन सक्छ तर स्वीकृत गर्न सक्दैन; तपाईं आफ्नो फोनमा स्वीकृत गर्नुहुन्छ{ macSecurityKey("ne") }। TPM नभएको Windows PC ले tafs मा साइन इन गर्न सक्दैन। KIFF ले कुञ्जीको सार्वजनिक आधा, उपकरणको नाम र प्लेटफर्म, र कहिले थपियो र अन्तिम पटक प्रयोग भयो राख्छ, ताकि रोकिएका कलमा तपाईंका जवाफ र जडानका तपाईंका स्वीकृति जाँच्न सकोस्।</li>
					<li><strong>तपाईंको घडी:</strong> घडीले कुनै पासवर्ड वा कुञ्जी राख्दैन, केवल तपाईंको जोडिएको फोनसँग कुरा गर्छ, र कहिल्यै स्वीकृत गर्दैन। तपाईंले AI लाई अनुमति दिएपछि यसले तपाईंले Coach, वा छानेको taf लाई भनेको कुरा फोन मार्फत केवल पाठको रूपमा पठाउँछ। घडीको आफ्नै बोली सेवा, Apple वा Google को, ले तपाईंका शब्दलाई त्यो पाठ बनाउँछ। Wear OS मा, तपाईंले सक्नुअघि रोकिए, तपाईंको फोनको आफ्नै पहिचानकर्ताले त्यो फोनमै गर्छ। यसले स्क्रिन लक वा पासकोड भएको र अनलक भएको बेलामा मात्र अस्वीकार, रोक्न, वा Coach वा taf लाई पठाउन सक्छ। तपाईंले taf लाई पठाएको कुरा त्यो taf को आफ्नै च्याटमा जान्छ, मानौं तपाईंले फोनमा लेख्नुभएको हो। Taf को च्याट, रकम सहित, खुला रहँदासम्म मात्र घडीमा देखिन्छ, प्रत्येक पटक फोन मार्फत पढिन्छ; घडीले त्यसको केही राख्दैन।</li>
					<li><strong>Apple Watch:</strong> यसले तपाईंका taf र तिनका पृष्ठ राख्दैन, देखाउँछ मात्र। यसले तपाईंको Inbox मात्र राख्छ, लक हुँदा पढ्न नसक्ने फाइलमा: हरेक रोकिएको कल यसको taf को नाम र यसले के सोध्छ भनेर, कहिल्यै रकम होइन, र घडीबाट तपाईंले पठाएकामा Coach का जवाफ, पाठको रूपमा। यदि तपाईं घडीमा साइन आउट गर्नुहुन्छ भने, यसले तपाईंले गर्नुभयो भन्ने पनि राख्छ, घडीमा फेरि साइन इन नगरेसम्म। त्योबाहेक, घडीमा पासकोड नभएसम्म यसले केही राख्दैन। तपाईंले घडीमा साइन आउट गर्दा वा तपाईंको iPhone साइन आउट हुँदा, वा पासकोडबिना एप अर्को पटक खुल्दा वा बन्द हुँदा Inbox जान्छ। यसले कुनै रेकर्डिङ गर्दैन, र यसले देखाउने सूचनाहरू तपाईंको iPhone का मात्र हुन्। यदि तपाईंले Coach का लागि सन्देश पछिका लागि राख्नुभयो भने, यसले त्यो एउटा सन्देश पनि पाठको रूपमा इनबक्सको जस्तै लक गरिएको आफ्नै फाइलमा राख्छ, र तपाईंको iPhone फर्केपछि पठाउँछ। पठाइसकेपछि, तपाईंले मेटाउँदा, तपाईं वा तपाईंको iPhone साइन आउट हुँदा, वा घडीमा पासकोड नरहँदा यो मेटिन्छ।</li>
					<li><strong>Wear OS:</strong> यसले तपाईंको खाताको इमेल र आजको क्यालेन्डर राख्दैन, देखाउँछ मात्र। तुरुन्तै खुल्न, यसले इन्क्रिप्ट गरेर तपाईंलाई पर्खिरहेका कुराको गणना, र हरेक taf को नाम र यो रोकिएको वा विराम दिएको छ कि छैन राख्छ: कहिल्यै रकम, रोकिएको कलको विवरण वा taf को च्याट होइन। तपाईं साइन आउट गर्दा, घडी लक हुँदा वा नाडीबाट झिक्दा, र 24 घण्टापछि त्यो हटाइन्छ। यसले तपाईंको Inbox राख्छ, जहाँ हरेक लाइन taf को नाम र यसले के भन्छ हो, कहिल्यै रकम होइन, र पछिका लागि राखिएको एउटा सन्देश, पाठको रूपमा। घडी वा फोनमा साइन आउट गर्दा सबै हटाइन्छ। यसको टाइलका लागि, यसले तपाईंलाई पर्खिरहेका कुराको गणना पनि राख्छ, घडी अनलक भएको बेलामा मात्र देखाइन्छ, र साइन आउट गर्दा, वा घडी लक भएको वा स्क्रिन लक नभएको बेला टाइल अर्को पटक देखिँदा हटाइन्छ। घडीमा साइन आउट गरेपछि, यसले तपाईंले गर्नुभयो भन्ने टिपोट राख्छ, फेरि साइन इन नगरेसम्म। घडी लक भएको वा स्क्रिन लक नभएको बेला एप अर्को पटक खुल्दा वा बन्द हुँदा पनि Inbox जान्छ। पछिका लागि राखिएको सन्देश तपाईंले पठाउने वा मेट्नेसम्म रहन्छ, किनभने तपाईंले यसलाई पठाउन भन्नुभएको थियो। यदि घडीको बोली सेवा तपाईंले सक्नुअघि रोकियो भने, घडीले रेकर्डिङ तपाईंको फोनमा पठाउँछ, जसले यसलाई फोनमै पाठ बनाउँछ, सर्भरमा कहिल्यै होइन। पाठ फर्किएपछि वा तपाईंले रद्द गरेपछि, र बढीमा 2 मिनेटपछि रेकर्डिङ दुवैमा मेटिन्छ। केवल पाठ Coach वा तपाईंको taf सम्म जान्छ। Taf को नतिजा तपाईंले हटाउने वा घडीमा साइन आउट गर्नेसम्म घडीका सूचनाहरूमा रहन सक्छ।</li>
					<li><strong>Passkey हरू:</strong> तपाईंले आफ्नो कम्प्युटरमा passkey ले स्वीकृत गर्दा, जस्तै Windows Hello वा सुरक्षा कुञ्जी, तपाईंको अनुहार, औँठाछाप वा PIN कम्प्युटरकै आफ्नै प्रणालीमा रहन्छ। KIFF ले passkey को सार्वजनिक कुञ्जी, यसको id, एउटा काउन्टर र नाम राख्छ, कहिल्यै गोप्य कुरा होइन, र अन्य उपकरणमा सिङ्क हुने passkey अस्वीकार गर्छ।</li>
					<li><strong>सतर्कता:</strong> फोन, ट्याब्लेट वा iPad एप चलाउने Mac मा, तपाईंले यिनलाई खोल्दा, हामी उपकरणको push टोकन तपाईंको KIFF व्यक्ति id र एपले देखाएको भाषासँगै राख्छौं। सतर्कता Apple वा Google मार्फत जान्छ केवल कुन taf र के चाहन्छ भनेर, र ढोकाको सतर्कतामा कसले लेख्यो त्यसको नाम वा इमेल ठेगाना: कहिल्यै रकम वा अनुरोधको विवरण होइन। एपले ती विवरण उपकरणमै KIFF बाट थप्छ, त्यसैले अनलक फोनको सतर्कताले रकम, व्यापारी वा व्यक्ति देखाउन सक्छ। लक भएको Android फोनमा यसले केवल "Taf लाई तपाईं चाहियो" देखाउँछ, र लक भएको iPhone मा पनि, तपाईंले यसको पूर्वावलोकन सधैँ देखाउने गरी सेट नगरेसम्म। Windows PC, Linux कम्प्युटर वा macOS 12 एप भएको Mac मा सतर्कता एप आफैंले चल्दा बनाउँछ, push टोकनबिना र अरू कुनै कम्पनी मार्फत नगई। Windows र Linux मा तिनले कुन taf, के गर्न चाहन्छ, रकम, किन र कहिलेसम्म देखाउँछन्; macOS 12 एपमा तपाईंले खोलेपछि कलका लागि KIFF का शब्द देखाउँछन्, र लक स्क्रिनले Mac को पूर्वावलोकन सेटिङले अनुमति दिएको देखाउँछ। Windows मा तपाईंले खोल्नुअघिसम्म बन्द छन्, र स्क्रिन लक हुँदा केवल "Taf लाई तपाईं चाहियो" देखाउँछन्। स्क्रिन लक हुनुअघि देखाइएकोले Windows को सूचना सूचीमा आफ्नो विवरण राख्छ। Linux मा तपाईंले बन्द गर्नुअघिसम्म खुला छन्, र लक स्क्रिनले के देखाउँछ त्यो तपाईंको डेस्कटपमा निर्भर गर्छ।</li>
					<li><strong>भाषा:</strong> tafs सेवाले खाताको भाषा, Coach सँग पछिल्लो पटक च्याट गर्नेबाट, तीन महिनासम्म राख्छ, ताकि taf का प्रतिवेदन त्यही भाषामा आउन्।</li>
					<li><strong>तपाईंका औजार:</strong> औजार जोड्दा, तपाईं औजारको आफ्नै प्रदायकमा साइन इन गर्नुहुन्छ। planque आफैं साइन इन गर्ने एप, जस्तै Stripe, वा तपाईंले दिएको कुञ्जीका लागि, planque ले त्यो टोकन वा कुञ्जी तपाईंको कम्पनीका लागि इन्क्रिप्ट गरेर राख्छ। व्यवस्थित जडानका लागि, planque ले काम गर्ने जडान सेवा Composio ले साइन इन राख्छ, र planque ले केवल जडानको रेकर्ड र तपाईंले स्वीकृत गरेका औजार राख्छ (<a href="#google">Google प्रयोगकर्ता डेटा</a> हेर्नुहोस्)। जडानको रेकर्डमा यो कुन खातामा साइन इन छ (यसको नाम वा इमेल) समावेश हुन सक्छ, ताकि एपले कुन हो भनेर तपाईंलाई देखाउन सकोस्। KIFF ले व्यवस्थित जडान <a href="/subprocessors#composio">/subprocessors</a> (अङ्ग्रेजीमा) मा नाम दिइएका एपका लागि मात्र प्रयोग गर्छ।</li>
					<li><strong>तपाईंको ब्राउजर (Chrome):</strong> जब तपाईंले tafs एक्सटेन्सनलाई आफ्नो फोनसँग जोड्नुहुन्छ, taf ले तपाईंले जोडेको Chrome प्रोफाइलमा, त्यसको जडानले सूचीबद्ध गरेका साइटहरूमा मात्र काम गर्न सक्छ। यसले आफ्ना ट्याबहरू तपाईंले हेर्न, रोक्न वा बन्द गर्न सक्ने ट्याब समूहमा खोल्छ, र तपाईंले तिनमध्ये कुनै छुँदा रोकिन्छ। यसले ती पृष्ठहरू पासवर्ड, कार्ड र कोड फिल्डहरू हटाएर पाठ र फारम फिल्डका रूपमा पढ्छ, तपाईंका अन्य ट्याब वा अन्य साइट कहिल्यै होइन। त्यो पाठ रनको भागका रूपमा हाम्रो AI प्रदायकमा जान्छ, र कुनै पनि उपकरणको नतिजा जस्तै रनसँगै राखिन्छ। प्रत्येक चरण साइट र फिल्डको नामसहित अभिलेखमा जान्छ, गोप्य फिल्डमा के टाइप गरियो त्यो कहिल्यै होइन। taf ले गर्ने प्रत्येक परिवर्तनका लागि, KIFF ले ती फिल्डहरू हटाइएको पाठका रूपमा अघि र पछिको पृष्ठ बढीमा 30 दिन राख्छ, र तपाईंले जडान हटाउँदा वा खाता मेटाउँदा त्यसभन्दा चाँडै मेट्छ। यी पृष्ठहरूले अरूका विवरण, जस्तै तपाईंका ग्राहकहरूको, देखाउन सक्छन्; KIFF ले ती तपाईंका लागि प्रशोधकका रूपमा प्रशोधन गर्छ। एक्सटेन्सनले तपाईंको कम्प्युटरमा आफ्नै साँचो मात्र राख्छ, तपाईंका पासवर्ड कहिल्यै होइन: साइन इन पृष्ठमा taf रोकिन्छ र तपाईंलाई आफ्नै ट्याबमा आफैँ साइन इन गर्न भन्छ। तपाईं एक्सटेन्सनको साइड प्यानलबाट पनि Coach सँग कुरा गर्न सक्नुहुन्छ। त्यहाँबाट यसलाई सन्देश पठाउँदा, अगाडिको पृष्ठ आफ्नो देखिने पाठको रूपमा मात्र त्यो सन्देशसँगै जान्छ, तपाईंले टाइप गरेको कहिल्यै होइन, बैंक, भुक्तानी, मेल वा स्वास्थ्य साइट वा Coach का लागि तपाईंले बन्द गरेको साइटबाहेक। यो त्यो सन्देशका लागि मात्र हाम्रो AI प्रदायकलाई जान्छ; tafs ले पृष्ठ उत्तर पूरा नहुँदासम्म मात्र राख्छ, र साइटको नाम तपाईंको च्याटसँग “पढ्दै:” को रूपमा 30 दिन राख्छ। Coach को उत्तरले पृष्ठबाट उद्धरण दिन सक्छ र अरू उत्तरजस्तै तपाईंको च्याटसँग राखिन्छ। जोडी हटाउँदा वा अनइन्स्टल गर्दा एक्सटेन्सनले राखेको कुरा मेटिन्छ। taf ले तपाईंको फोनमा तपाईंको स्वीकृतिबिना कहिल्यै भुक्तानी गर्दैन। काम गर्ने हरेक चरण (क्लिक, टाइप, पठाउने), तपाईंले स्वीकृत गरेको चरणसहित, यसले अभिलेखका लागि कामको ठीक अघि लिइएको पृष्ठको एउटा स्क्रिनसट पनि राख्छ; पढ्ने मात्र गरिएको पृष्ठका लागि कहिल्यै होइन, बैंक, वालेट, पासवर्ड म्यानेजर, भुक्तानी, स्वास्थ्य वा सरकारी साइटमा कहिल्यै होइन, र लिनु अघि पासवर्ड, कार्ड र कोडका ठाउँ लुकाइन्छन्। कार्ड नम्बर वा कुञ्जी जस्तो देखिने पाठलाई पनि कालो पारिन्छ, तर अर्कै तरिकाले लेखिएको कुरा अझै देखिन सक्छ। स्क्रिनसटहरू त्यही चरणसँग जोडेर इन्क्रिप्ट गरिएको भण्डारणमा 30 दिन राखिन्छन्, त्यसपछि स्वतः मेटिन्छन्, वा तपाईंले जडान हटाउनुभयो, यो Chrome को जोडी हटाउनुभयो वा खाता मेटाउनुभयो भने त्यसभन्दा चाँडो, र ती हाम्रो एआई प्रदायकसमक्ष कहिल्यै जाँदैनन्। तपाईं प्रत्येकलाई taf को गतिविधिमा यसको चरणमुनि देख्नुहुन्छ।</li>
					<li><strong>तपाईंका taf हरूको काम:</strong> हरेक taf का रन, च्याट, प्रतिवेदन, मेमोरी नोट र तिनले पुर्‍याउने फाइलहरू, प्रशोधकको रूपमा राखिएका। तपाईंको खाताका सबैले तपाईंका taf हरूले पुर्‍याएका फाइल देख्न सक्छन्।</li>
					<li><strong>ढोकाहरू:</strong> मानिसहरूले इमेल, Slack वा Telegram बाट taf लाई लेख्न सकून् भनेर तपाईंले ढोका खोल्दा, tafs सेवाले तपाईंले जोडेका हरेक पठाउनेलाई उनको इमेल ठेगाना, Slack सदस्य ID वा Telegram प्रयोगकर्ता ID (WhatsApp ढोकाका लागि फोन नम्बर) र तपाईंले दिएको नामसहित, तपाईंले ढोका वा taf हटाउँदासम्म राख्छ। तपाईंले नजोडेको व्यक्तिको सन्देश, कसले लेख्यो र के भनिएको छ सहित, ढकढकका रूपमा अन्तिमपछि 30 दिनसम्म तपाईंको प्रतीक्षामा रहन्छ। जोडिएको पठाउनेको सन्देश taf को च्याटमा जान्छ र च्याटको बाँकी भागजस्तै राखिन्छ। Slack र Telegram ले सन्देशहरू आफ्नै सर्तमा पुर्‍याउँछन्।</li>
					<li><strong>खरिदहरू:</strong> Solo र क्रेडिटका प्याकहरू Apple ले App Store मार्फत, वा Google ले Google Play को बिलिङ मार्फत बेच्छ। तिनले हामीलाई के किनियो, कुन KIFF खाताका लागि (अनियमित id), कहिले, र तिनका कारोबार वा अर्डर सन्दर्भ बताउँछन्। तिनले हामीलाई तपाईंको Apple ID वा Google खाता, नाम, इमेल ठेगाना वा कार्ड दिँदैनन्।</li>
				</ul>
				<p>एपमा कुनै एनालिटिक्स वा विज्ञापन ट्र्याकर छैन।</p>
			</section>
			<section id="ai">
				<h2>5. tafs मा AI</h2>
				<p>tafs ले Coach र तपाईंका taf हरूका लागि Anthropic को Claude AI प्रयोग गर्छ। केही पनि त्यसमा जानुअघि एपले तपाईंलाई सोध्छ।</p>
				<ul>
					<li>त्यसलाई के पठाइन्छ: तपाईंले Coach र आफ्ना taf हरूलाई लेख्नुभएको कुरा, तपाईंले जोड्ने फाइलहरू, तपाईंका जोडिएका एपले taf लाई काम गर्दा फर्काउने कुरा, र Coach ले तपाईंलाई एपमा मद्दत गर्दा तपाईंको स्क्रिनमा के छ।</li>
					<li>Chrome बाट: एक्सटेन्सनको साइड प्यानलमा Coach लाई लेख्दा अगाडिको पृष्ठ।</li>
					<li>के कहिल्यै पठाइँदैन: तपाईंका जोडिएका एपले प्रयोग गर्ने पासवर्ड र कुञ्जी, वा तपाईंको औँठाछाप।</li>
					<li>Anthropic ले यसलाई जवाफ दिन प्रयोग गर्छ र 30 दिनसम्म राख्छ।</li>
					<li>तपाईंले अनुमति नदिँदासम्म केही पठाइँदैन। तपाईं खातामा फिर्ता लिन सक्नुहुन्छ।</li>
				</ul>
				<p>तपाईंले फिर्ता लिँदा, Coach र तपाईंका taf हरूले तपाईंलाई जवाफ दिन छोड्छन्, र रन तपाईंको सहमतिमा आधारित taf ले विराम लिन्छ। <a href="/ne/privacy#ai-in-tafs">KIFF को गोपनीयता नीति</a> मा विवरण छन्।</p>
			</section>
			@tafsPrivacyGoogleNE()
			<section id="sharing">
				<h2>7. अरू कसले डेटा पाउँछ</h2>
				<p>हामी तपाईंको व्यक्तिगत डेटा बेच्दैनौं, र विज्ञापनका लागि साझा गर्दैनौं।</p>
				<p>tafs का लागि हामी यी कम्पनीहरू प्रयोग गर्छौं: Amazon Web Services (होस्टिङ, tafs को भण्डार र planque का जडान सहित), Clerk (KIFF खाताका लागि साइन इन), Anthropic (AI मोडेल), Composio (व्यवस्थित जडानका साइन इन, र planque ले यसलाई गर्न लगाउने कल), Apple (push सतर्कता), Google (Android मा push सतर्कता, र Google Play को बिलिङ), र Resend (taf को इमेल ढोका)। आधिकारिक, हालको सूची, प्रत्येकले के छुन्छ र कहाँ भन्ने कुरासहित, <a href="/subprocessors">/subprocessors</a> (अङ्ग्रेजीमा) मा छ।</p>
				<p>तिनमध्ये केही यूरोपेली आर्थिक क्षेत्रबाहिर छन्, प्रायः संयुक्त राज्य अमेरिकामा। ती स्थानान्तरण कसरी सुरक्षित गरिन्छन् भन्ने <a href="/ne/privacy#transfers">KIFF को गोपनीयता नीति</a> ले बताउँछ।</p>
				<p><strong>तपाईंको देश।</strong> केही देशका कानुनले यो नीतिले भनेभन्दा बढी माग गर्छन्। तिनले थप्ने कुरा, अङ्ग्रेजीमा र देशको भाषामा, <a href="/privacy/countries">तपाईंको देश</a> (अङ्ग्रेजीमा) मा छन्।</p>
			</section>
			<section id="retention">
				<h2>8. हामी यसलाई कति समय राख्छौं</h2>
				<ul>
					<li>तपाईंका औजारले taf लाई फर्काउने कुरा: रन समाप्त नहुँदासम्म मात्र। च्याटमा, यसले पढेको मात्र कुरा यसका अर्का सन्देशहरूका लागि इन्क्रिप्ट गरेर राखिन्छ, च्याट एक घण्टा निष्क्रिय नहुँदासम्म र पढेपछि बढीमा चार घण्टासम्म प्रयोग गरिन्छ, त्यसपछि केही दिनभित्र स्वचालित रूपमा मेटिन्छ।</li>
					<li>Taf का रन र च्याट, च्याटको सारांशसहित: 30 दिन। यसका मेमोरी नोट: taf हटाइँदासम्म।</li>
					<li>अर्को जवाफका लागि Coach का छोटा नोट, जस्तै च्याटमा जडान किन बनाउन सकिएन, वा Card स्वीकृत भयो: त्यो जवाफले तिनलाई नलिँदासम्म, बढीमा 7 दिन; त्यसपछि, त्यो च्याटको हिस्साको रूपमा, च्याट राखिएसम्म। पुन: पठाइएको सन्देशले उही नोट पाओस् भनेर एउटा प्रति 24 घण्टा राखिन्छ। च्याटको नोट त्यही च्याटमा मात्र प्रयोग गरिन्छ।</li>
					<li>तपाईंले च्याटमा जोड्ने फाइलहरू: जोडिएको सन्देशसँग, 30 दिन, वा च्याट हटाइए छिटो, र जुनसुकै अवस्थामा 38 दिनभित्र। कुनै सन्देशले प्रयोग नगरेको फाइल तपाईंले अपलोड गरेको लगभग एक घण्टापछि हटाइन्छ। तपाईंको खाता मेट्दा तिनलाई मेटिन्छ।</li>
					<li>तपाईंका taf हरूले पुर्‍याएका फाइलहरू: रनले बनाएदेखि 30 दिन, त्यसपछि एक दिनभित्र स्वचालित रूपमा मेटिन्छ। तपाईंको खाताका जो कोहीले अब मेट्नुहोस् बाट छिटो मेट्न सक्छ: फाइल तुरुन्तै जान्छ, कुनै प्रति नराखिकन; यसको नाम, आकार र यसलाई बनाउने taf र रन tafs को भण्डारको इन्क्रिप्टेड बिन्दु-समयका प्रतिहरूमा 35 दिनसम्म रहन सक्छन्, केवल विफलतापछि पुनर्स्थापना गर्न प्रयोग गरिने। Taf हटाउँदा वा तपाईंको खाता मेट्दा यसका फाइलहरू मेटिन्छन्। फाइल साझा गर्दा फाइल नै पठाइन्छ, र तपाईंले साझा गरेको प्रति तपाईंले साझा गरेको एपसँग रहन्छ। फाइल डाउनलोड गर्न, हामी तपाईंको खाताका साइन इन भएको सदस्यका लागि एक मिनेटपछि काम गर्न छाड्ने लिङ्क बनाउँछौं; यसका लागि अरू लिङ्क बनाउँदैनौं।</li>
					<li>औजारले फर्काएको कुरा, planque को प्रत्येक कलको रेकर्डमा: 24 घण्टा। त्यसपछि, रेकर्डले कल पठाइयो कि भनेर मात्र राख्छ, ताकि यो कहिल्यै दुई पटक नपठाइयोस्।</li>
					<li>planque मा जडानको टोकन वा कुञ्जी, वा Composio मा व्यवस्थित जडानको साइन इन: तपाईंले डिस्कनेक्ट नगरेसम्म। यदि तपाईंको अर्को जडानले त्यही विक्रेताको उही खाता प्रयोग गर्न सक्छ भने, यो प्रयोगबिना राखिन्छ, त्यो पनि डिस्कनेक्ट नहुँदासम्म, त्यसपछि रद्द गरिन्छ। यसका स्वीकृतिको रेकर्ड: खाता समाप्त नहुँदासम्म।</li>
					<li>उपकरणको push टोकन: तपाईंले एपबाट साइन आउट नगरेसम्म, उपकरण हटाउनुअघिसम्म, वा Apple वा Google ले टोकन गयो भनी रिपोर्ट नगरेसम्म। उपकरणको सार्वजनिक कुञ्जी, नाम, प्लेटफर्म र मिति: तपाईंले प्रयोग गर्दासम्म; तपाईंले यसलाई साइन आउट गरेपछि, यो हटाइएको चिह्नित हुन्छ र खाता नमेटिएसम्म राखिन्छ, ताकि KIFF ले त्यसबाट आएको ढिलो जवाफ अस्वीकार गर्न र पहिलेको जवाफमा कुन उपकरणले हस्ताक्षर गर्‍यो देखाउन सकोस्। Passkey को सार्वजनिक कुञ्जी, id र नाम: यसको उपकरणको जस्तै। कम्प्युटरको सत्र: 90 दिनसम्म, वा तपाईंले साइन आउट नगरेसम्म।</li>
					<li>तपाईंको खाता: मेटिँदासम्म। सेवाका लग: 30 दिन। tafs र planque का भण्डारले इन्क्रिप्टेड बिन्दु-समयका प्रतिहरू 35 दिन राख्छन्, केवल विफलतापछि भण्डार पुनर्स्थापना गर्न प्रयोग गरिने।</li>
				</ul>
				<p>बाँकी सबै कुरा <a href="/ne/privacy#retention">KIFF को अवधारण खण्ड</a> मा छ।</p>
			</section>
			<section id="lawful-bases">
				<h2>9. कानुनी आधार</h2>
				<p>सम्झौताको कार्यान्वयन, तपाईंको खाता र तपाईंका taf हरू चलाउन। वैध हित, सुरक्षा, ठगी रोकथाम र दुरुपयोग पत्ता लगाउनका लागि। सहमति, tafs मा AI का लागि (<a href="#ai">खण्ड 5</a>)। कानुनी दायित्व, कर अभिलेखका लागि। <a href="/ne/privacy#lawful-bases">KIFF को गोपनीयता नीति</a> मा विवरण छन्।</p>
			</section>
			<section id="rights">
				<h2>10. तपाईंका अधिकार</h2>
				<p>GDPR अन्तर्गत तपाईं आफ्नो डेटामा पहुँच, यसको सुधार, मेटाउने, सीमित गर्ने वा पोर्टेबल प्रति माग्न, वैध हितमा आधारित प्रशोधनको विरोध गर्न, र सहमति फिर्ता लिन सक्नुहुन्छ। <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> मा इमेल गर्नुहोस्; हामी एक महिनाभित्र जवाफ दिन्छौं। एपमा, खाता → मेरा च्याटहरू निर्यात गर्नुहोस् ले तपाईंका आफ्नै च्याट र नोट डाउनलोड गर्छ।</p>
				<p>आफ्नो tafs खाता मेट्न, एप खोल्नुहोस्, खातामा जानुहोस् र <em>खाता मेट्नुहोस्</em> ट्याप गर्नुहोस्, त्यसपछि पुष्टि गर्नुहोस्। यसलाई फर्काउन सकिँदैन। के मेटिन्छ र कहिले, र इमेलबाट कसरी माग्ने भन्ने <a href="/ne/privacy#delete-account">KIFF को गोपनीयता नीति</a> ले बताउँछ।</p>
				<p>तपाईं <a href="https://www.aki.ee/en" target="_blank" rel="noopener">एस्टोनियाको डेटा संरक्षण निरीक्षणालय (Andmekaitse Inspektsioon)</a> मा, वा तपाईं बस्ने ठाउँको सुपरिवेक्षक प्राधिकरणमा उजुरी गर्न सक्नुहुन्छ।</p>
				<p><strong>तपाईंको देश।</strong> केही देशका कानुनले यो नीतिले भनेभन्दा बढी माग गर्छन्। तिनले थप्ने कुरा, अङ्ग्रेजीमा र देशको भाषामा, <a href="/privacy/countries">तपाईंको देश</a> (अङ्ग्रेजीमा) मा छन्।</p>
			</section>
			<section id="more">
				<h2>11. सुरक्षा, बालबालिका र परिवर्तन</h2>
				<p>हाम्रा सुरक्षा उपाय <a href="/security">/security</a> (अङ्ग्रेजीमा) मा छन्। tafs बालबालिकाका लागि होइन, र हामी 16 वर्षमुनिका बालबालिकाको व्यक्तिगत डेटा जानीजानी सङ्कलन गर्दैनौं। हामी यो नीति <a href="/ne/privacy#changes">KIFF को गोपनीयता नीति</a> ले आफ्नाका लागि भनेको तरिकाले परिवर्तन गर्छौं।</p>
			</section>
			<section id="contact">
				<h2>12. सम्पर्क</h2>
				<p>गोपनीयता प्रश्न र अनुरोधहरू: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>। औपचारिक कानुनी सूचनाहरू: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>। एपका आफ्नै सर्तहरू <a href="/ne/tafs/terms">/tafs/terms</a> मा छन्।</p>
			</section>
		</article>
	}
}

// tafsPrivacyGoogle is what tafs does with the data it receives from Google,
// for Google's review of tafs's sign-in, with the Limited Use statement in
// Google's own words.
templ tafsPrivacyGoogleNE() {
	<section id="google">
		<h2>6. Google प्रयोगकर्ता डेटा</h2>
		if len(googleManaged()) == 0 && len(googleInHouse("ne")) > 0 {
			<p>तपाईंले भन्दा, tafs ले taf लाई तपाईंको Google खातासँग जोड्छ, उदाहरणका लागि यसको कामले प्रयोग गर्ने Google Sheets वा Google Calendar सँग, एपको एपहरू जोड्नुहोस् मा। यो खण्डले tafs ले Google बाट पाएको डेटाको के गर्छ भन्ने बताउँछ।</p>
		} else {
			<p>तपाईंले भन्दा, tafs ले taf लाई तपाईंको Google खातासँग जोड्छ, उदाहरणका लागि तपाईंको Gmail, वा यसको कामले प्रयोग गर्ने Google Calendar वा Google Sheets सँग, एपको एपहरू जोड्नुहोस् मा। यो खण्डले tafs ले Google बाट पाएको डेटाको के गर्छ भन्ने बताउँछ।</p>
		}
		<ul>
			if len(googleManaged()) == 0 && len(googleInHouse("ne")) > 0 {
				<li><strong>यसले के पढ्छ र लेख्छ:</strong> taf को कामलाई चाहिने कुरा: यसले अद्यावधिक राख्ने स्प्रेडसिट, वा यसले हेर्ने क्यालेन्डरका घटना। taf को Card ले अनुमति दिएको ठाउँमा मात्र यसले तिनलाई परिवर्तन गर्छ, र Card को सीमाभन्दा बढी जे पनि तपाईंको स्वीकृति पर्खन्छ।</li>
			} else {
				<li><strong>यसले के पढ्छ र लेख्छ:</strong> taf को कामलाई चाहिने कुरा। तपाईंको Gmail मा, यसले जवाफ चाहिने सन्देश र थ्रेड भेट्न पढ्छ, र मस्यौदा लेख्छ; taf को Card ले अनुमति दिएको ठाउँमा मात्र मेल पठाउँछ। Google Calendar र Google Sheets मा, यसले हेर्ने क्यालेन्डरका घटना, वा अद्यावधिक राख्ने स्प्रेडसिट पढ्छ, र taf को Card ले अनुमति दिएको ठाउँमा मात्र परिवर्तन गर्छ।
					if googleListed("Google Tasks") {
						Google Tasks मा, यसले हेर्ने कार्यसूची पढ्छ, र taf को Card ले अनुमति दिएको ठाउँमा मात्र कार्य थप्छ, पूरा गर्छ, सार्छ वा मेट्छ।
					}
					Card को सीमाभन्दा बढी जे पनि तपाईंको स्वीकृति पर्खन्छ।</li>
			}
			<li><strong>किन:</strong> त्यो taf का लागि तपाईंले सेट गरेको काम गर्न मात्र, र यो कुन Google खातासँग जोडिएको छ देखाउन: यसको इमेल ठेगाना, तपाईंले डिस्कनेक्ट नगरेसम्म जडानसँग राखिन्छ।</li>
			if len(googleManaged()) > 0 || len(googleInHouse("ne")) > 0 {
				<li>
					<strong>प्रत्येक Google एप कसरी जोडिन्छ:</strong>
					<ul>
						if len(googleManaged()) > 0 {
							<li>हाम्रो साइन इन साझेदार मार्फत, <a href="/subprocessors">/subprocessors</a> (अङ्ग्रेजीमा) मा सूचीबद्ध: { appList(googleManaged()) }.</li>
						}
						if len(googleInHouse("ne")) > 0 {
							<li>tafs को आफ्नै Google साइन इन मार्फत, बीचमा अरू कुनै कम्पनीबिना: { appList(googleInHouseNames()) }.</li>
						}
					</ul>
					if googleBoth() {
						दुवैमा नाम भएको एप तपाईंको खातामा निर्भर गर्दै एउटा वा अर्को तरिकाले जोडिन्छ। Google को आफ्नै साइन इन पृष्ठले तपाईंले कुन अनुमति दिँदै हुनुहुन्छ देखाउँछ।
					}
				</li>
			}
			if googleBoth() {
				<li>
					<strong>तपाईंले के अनुमति दिनुहुन्छ:</strong> तपाईं Google को आफ्नै पृष्ठमा साइन इन गर्नुहुन्छ र के अनुमति दिने छान्नुहुन्छ।
					<ul>
						<li><strong>हाम्रो साइन इन साझेदार मार्फत:</strong> tafs ले taf का औजारलाई चाहिने पहुँच मात्र माग्छ। यदि त्यो साँघुरो पहुँच सम्भव छैन भने, यसले एपको सामान्य पहुँच माग्छ, र तपाईंले साइन इन गर्नुअघि यो बताउँछ। यदि सामान्य पहुँचमा taf ले प्रयोग नगर्ने व्यक्तिगत डेटा समावेश हुन्छ भने, tafs जोड्दैन।</li>
						<li><strong>tafs को आफ्नै Google साइन इन मार्फत:</strong> साइन इनले taf ले पढ्ने मात्र भए पनि त्यो एपका लागि तल सूचीबद्ध सबै पहुँच एकैचोटि माग्छ।</li>
					</ul>
				</li>
			} else if len(googleInHouse("ne")) > 0 {
				<li><strong>तपाईंले के अनुमति दिनुहुन्छ:</strong> तपाईं Google को आफ्नै पृष्ठमा साइन इन गर्नुहुन्छ र के अनुमति दिने छान्नुहुन्छ। साइन इनले taf ले पढ्ने मात्र भए पनि त्यो एपका लागि तल सूचीबद्ध सबै पहुँच एकैचोटि माग्छ।</li>
			} else {
				<li><strong>तपाईंले के अनुमति दिनुहुन्छ:</strong> तपाईं Google को आफ्नै पृष्ठमा साइन इन गर्नुहुन्छ र के अनुमति दिने छान्नुहुन्छ। tafs ले taf का औजारलाई चाहिने पहुँच मात्र माग्छ। यदि त्यो साँघुरो पहुँच सम्भव छैन भने, यसले एपको सामान्य पहुँच माग्छ, र तपाईंले साइन इन गर्नुअघि यो बताउँछ। यदि सामान्य पहुँचमा taf ले प्रयोग नगर्ने व्यक्तिगत डेटा समावेश हुन्छ भने, tafs जोड्दैन।</li>
			}
			<li><strong>taf ले यसलाई कसरी प्रयोग गर्छ:</strong> taf ले आफ्नो Card मा स्वीकृत औजार मात्र प्रयोग गर्छ। हरेक कलले केही पठाउनुअघि त्यही औजार र ती तर्कका लागि अनुमतिपत्रसँग जाँचिन्छ, र तपाईंले दिएको पहुँचबाहिरको कल अस्वीकार गरिन्छ। कुन कार्यले प्रत्येक पटक तपाईंको स्वीकृति माग्छ भन्ने Card मा सेट गरिन्छ।</li>
			if len(googleInHouse("ne")) > 0 {
				<li>
					if googleBoth() {
						<strong>tafs को आफ्नै Google साइन इनले माग्ने पहुँच:</strong>
					} else {
						<strong>tafs ले माग्ने पहुँच:</strong>
					}
					<ul>
						for _, a := range googleInHouse("ne") {
							<li>
								{ a.Name }
								<ul>
									for _, s := range a.Scopes {
										<li><code>{ s.ID }</code>: { s.What }</li>
									}
								</ul>
							</li>
						}
					</ul>
					साइन इनले जति अनुमति दिए पनि, taf ले आफ्नो Card मा भएका औजार मात्र प्रयोग गर्छ।
				</li>
			}
			if googleBoth() {
				<li>
					<strong>तपाईंको साइन इन कसले राख्छ:</strong>
					<ul>
