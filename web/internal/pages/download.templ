package pages

import (
	"strconv"
	"strings"

	"github.com/kiff/cloud/web/internal/components"
	"github.com/kiff/cloud/web/internal/content/desktop"
)

// AppStoreURL is tafs's App Store listing. It is linked only once the app is
// live there (DownloadView.AppStoreLive): never a page that doesn't open.
const AppStoreURL = "https://apps.apple.com/app/id6822760338"

// The requirements each app really has: the Android app's minSdk 30, the iOS
// app's deployment target 16.0 (kiff/tafs android/app/build.gradle.kts,
// ios/project.yml).
const (
	downloadAndroidNeeds = "Android 11 or later"
	downloadIOSNeeds     = "iOS and iPadOS 16 or later"
)

// DesktopApp is one computer download on /tafs/download.
type DesktopApp struct {
	// OS is the download's channel (package desktop): "macos13", "macos",
	// "windows" or "linux".
	OS string
	// Device is what the handler calls the computer: "macos" for both Macs.
	Device string
	// Name is how the page names it: "macOS", "macOS 12".
	Name string
	// Family is the name the description uses for its computer: both Macs are
	// "macOS", so the sentence names the Mac once.
	Family string
	// Needs is the app's requirement, as its build sets it.
	Needs string
	// State is desktop.StateAvailable, StateComingSoon or StateNotAvailable.
	State string
	// URL is the file to download, from the computer's published release
	// (package desktop). Empty unless it's available: the page then says it's
	// coming soon, or not available, and links nowhere.
	URL string
	// Version, Size (bytes) and SHA256 are the release's, shown beside the link.
	Version string
	Size    int64
	SHA256  string
}

// DesktopApps are the computer downloads, each in the state its channel's
// published release gives it (package desktop): with KIFF_DESKTOP_RELEASES
// off, nothing is read and all are coming soon.
//
// The Mac has two, since a browser can't say which macOS it runs (Safari gives
// every Mac the same version): macOS 13 and later get the Catalyst app, and
// macOS 12 gets tafs-macos. Each is labelled by its macOS and has its own
// state.
func DesktopApps() []DesktopApp {
	apps := []DesktopApp{
		{OS: "macos13", Device: "macos", Name: "macOS", Family: "macOS", Needs: "macOS 13 or later"},
		{OS: "windows", Device: "windows", Name: "Windows", Family: "Windows", Needs: "Windows 10 or 11"},
		{OS: "linux", Device: "linux", Name: "Linux", Family: "Linux", Needs: "Ubuntu 24.04 or later"},
		// Last and quiet: only for the Macs that stay on macOS 12, never the
		// download a newer Mac is offered.
		{OS: "macos", Device: "macos", Name: "macOS 12", Family: "macOS", Needs: "macOS 12 (Monterey) only"},
	}
	for i := range apps {
		state, r := desktop.Of(apps[i].OS)
		apps[i].State = state
		if state == desktop.StateAvailable {
			apps[i].URL, apps[i].Version, apps[i].Size, apps[i].SHA256 = r.URL, r.Version, r.Size, r.SHA256
		}
	}
	return apps
}

// DownloadView is /download: the Play link, whether the App Store listing is
// live, and the device asking, which store comes first.
type DownloadView struct {
	PlayURL      string
	AppStoreLive bool
	// Device is "ios", "android", "macos", "windows", "linux", or "" for a
	// device the page can't name.
	Device string
	// Desktop is the computers' apps, in the page's order.
	Desktop []DesktopApp
	// W is the page's words; empty is English.
	W downloadWords
}

// words is the page's words: English unless a language was given.
func (v DownloadView) words() downloadWords {
	if v.W.Lang == "" {
		return downloadEN
	}
	return v.W
}

// phone says the visitor is on a phone or tablet, which has no use for the QR
// code.
func (v DownloadView) phone() bool { return v.Device == "ios" || v.Device == "android" }

// device is the computer a download is for: its Device, or its OS for a row
// that names none.
func (a DesktopApp) device() string {
	if a.Device != "" {
		return a.Device
	}
	return a.OS
}

// desktopFirst is the computers' apps in one order for every visitor: macOS
// 13 and later first, then Windows, then Linux, and the macOS 12 app last
// (the one on top is the one that works best). Only
// the phones put the visitor's own first.
func (v DownloadView) desktopFirst() []DesktopApp {
	out := make([]DesktopApp, 0, len(v.Desktop))
	for _, a := range v.Desktop {
		if a.OS != "macos" {
			out = append(out, a)
		}
	}
	for _, a := range v.Desktop {
		if a.OS == "macos" {
			out = append(out, a)
		}
	}
	return out
}

// big says whether a is the computer shown big: macOS 13 and later, for
// every visitor. The macOS 12 app is never big.
func (v DownloadView) big(a DesktopApp) bool { return a.OS == "macos13" }

// shortVersion is a release's version as the page shows it: the macOS 13+
// app's tag without its "mac-" prefix ("v1.0"), as its release names it.
func shortVersion(v string) string { return strings.TrimPrefix(v, "mac-") }

// shared is the words both download pages share, in the page's language.
func (v DownloadView) shared() getWords { return getFor(v.words().Lang) }

// Download is /tafs/download in v's language (English when v.W is empty), one screen: what tafs is in one line, then tafs
// for each device, the visitor's own first and big. A phone sees the stores
// first; a computer sees the computers first, and a QR code that opens this
// page on a phone.
templ Download(v DownloadView) {
	@components.LayoutSiteWithMeta(v.words().Title, v.description(), "website", "download", "css/home.css", "css/download.css") {
		<div class="k-home">
			<section class="k-hero k-download" id="get" aria-labelledby="download-title">
				<h1 id="download-title" class="k-display">{ v.words().Head }</h1>
				<p class="k-sub">{ v.words().Sub }</p>
				if v.phone() {
					@downloadPhones(v)
					@downloadComputers(v)
					@downloadWatches(v)
				} else {
					@downloadComputers(v)
					@downloadWatches(v)
					@downloadPhones(v)
					<figure class="dl-qr">
						<img src="/static/img/download/qr-download.svg" alt={ v.words().QRAlt } width="174" height="174"/>
						<figcaption>{ v.words().QRCaption }</figcaption>
					</figure>
				}
				<p class="k-small">{ v.words().Cost } <a href="/pricing">{ v.words().Pricing }</a>{ v.words().inEnglish() }.</p>
				<p class="k-small dl-legal">{ v.shared().Notice }</p>
			</section>
		</div>
	}
}

// downloadPhones is the two stores, the phone's own first and big.
templ downloadPhones(v DownloadView) {
	<h2 class="dl-group">{ v.words().Phones }</h2>
	<div class="dl-stores">
		if v.Device == "ios" {
			@downloadIOS(v, true)
			@downloadAndroid(v, false)
		} else {
			@downloadAndroid(v, v.Device == "android")
			@downloadIOS(v, false)
		}
	</div>
}

// downloadComputers is tafs for each computer, the visitor's own first and big.
// Each row carries its state and release as data attributes, which the
// download check (cmd/downloadcheck) reads: data-state, data-version,
// data-size (bytes, 0 unless available) and data-sha256.
templ downloadComputers(v DownloadView) {
	<h2 class="dl-group">{ v.words().Computer }</h2>
	<div class="dl-stores dl-rows">
		for _, a := range v.desktopFirst() {
			<div class={ "dl-store", templ.KV("dl-first", v.big(a)), "dl-os-" + a.OS, templ.KV("dl-pending", a.URL == "" && a.State != desktop.StateNotAvailable) } data-os={ a.OS } data-state={ a.State } data-version={ a.Version } data-size={ strconv.FormatInt(a.Size, 10) } data-sha256={ a.SHA256 }>
				<div class="dlr">
					<div class="dlr-t">
						<p class="dl-name">
							{ a.Name }
							if a.OS == "linux" {
								@tux()
							}
						</p>
						<p class="k-small dlr-needs">{ v.words().needs(a.OS, a.Needs) }</p>
						if a.URL != "" && a.Version != "" {
							<span class="dlr-ver">{ shortVersion(a.Version) } · { v.words().size(a.Size) }</span>
						}
					</div>
					if a.URL != "" {
						<a href={ templ.SafeURL(a.URL) } class="dl-get">{ v.words().downloadFor(a.Name) }<i aria-hidden="true">↓</i></a>
					} else if a.State == desktop.StateNotAvailable {
						<p class="dl-soon">{ v.words().notAvailable() }</p>
					}
				</div>
				if a.URL != "" && a.Version != "" {
					<details class="dlr-more">
						<summary>{ v.shared().Fold }</summary>
						<p class="k-small dl-file">{ v.words().version(shortVersion(a.Version)) } · { v.words().size(a.Size) }</p>
						<p class="k-small dl-sha">{ v.words().sha() } <code>{ a.SHA256 }</code></p>
						<p class="k-small">{ v.words().checkHow() }</p>
					</details>
				}
			</div>
		}
	</div>
}

// downloadWatches is the watches, shown before they ship: each says how it
// will arrive, quieter than a download and linking nowhere. Wear OS turns
// into a link to its Play listing once the watch is on Google Play
// (WatchLive, KIFF_WATCH_LIVE), Apple Watch with the iPhone app it ships in
// (AppStoreLive, KIFF_APP_STORE_LIVE).
templ downloadWatches(v DownloadView) {
	<div class="dl-watches">
		@watchTile("dl-os-wearos", "Wear OS", WatchesSub, v.shared().WearOS, WatchLive, v.PlayURL)
		@watchTile("dl-os-applewatch", "Apple Watch", "", v.shared().AppleWatch, v.AppStoreLive, AppStoreURL)
	</div>
}

// watchTile is one watch: a link to its store once live, else a quiet tile
// with its state line.
templ watchTile(class, name, sub, state string, live bool, url string) {
	if live && url != "" {
		<a class={ "dl-watch", "dl-watch-live", class } href={ templ.SafeURL(url) } rel="noopener">
			<b class="dl-watch-name">{ name }</b>
			if sub != "" {
				<span class="dl-watch-sub">{ sub }</span>
			}
		</a>
	} else {
		<div class={ "dl-watch", class } aria-disabled="true">
			<b class="dl-watch-name">{ name }</b>
			if sub != "" {
				<span class="dl-watch-sub">{ sub }</span>
			}
			<span class="dl-watch-state">{ state }</span>
		</div>
	}
}

