}

templ downloadAndroid(v DownloadView, first bool) {
	<div class={ "dl-store", templ.KV("dl-first", first) }>
		<a href={ templ.SafeURL(v.PlayURL) } class="dl-badge dl-play"><img src={ "/static/" + v.shared().PlayBadge } alt="Google Play" width="646" height="192"/></a>
		<p class="k-small">{ v.words().needs("android", downloadAndroidNeeds) }</p>
	</div>
}

templ downloadIOS(v DownloadView, first bool) {
	<div class={ "dl-store", templ.KV("dl-first", first) }>
		if v.AppStoreLive {
			<a href={ templ.SafeURL(AppStoreURL) } class="dl-badge dl-apple"><img src="/static/img/download/app-store-badge.svg" alt="Download on the App Store" width="120" height="40"/></a>
		} else {
			<p class="dl-soon">{ v.words().ComingAppStore }</p>
		}
		<p class="k-small">{ v.words().iPhoneIPad() }</p>
	</div>
}
