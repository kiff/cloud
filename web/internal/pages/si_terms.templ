package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// TermsSI is KIFF's terms (/terms) in Sinhala, at /si/terms.
// It is a translation of Terms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Sinhala has the legal
// texts only, so a link to any other page goes to English and says so.
templ TermsSI() {
	@components.LayoutSite("KIFF — terms of service", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@termsHeadSI()
			@termsDefinitionsSI()
			@termsAgreementSI()
			@termsServiceSI()
			@termsTafsSI()
			@termsAccountSI()
			@termsAcceptableUseSI()
			@termsCustomerDataSI()
			@termsConfidentialitySI()
			@termsFeesSI()
			@termsTermSI()
			@termsWarrantiesSI()
			@termsDisclaimerSI()
			@termsLiabilitySI()
			@termsIndemnitySI()
			@termsSLASI()
			@termsServiceModsSI()
			@termsTermsModsSI()
			@termsForceMajeureSI()
			@termsGoverningLawSI()
			@termsGeneralSI()
			@termsContactSI()
		</article>
	}
}

templ termsHeadSI() {
	<header class="legal-head">
		<p class="legal-badge">සේවා කොන්දේසි · v0.1</p>
		<h1>සේවා කොන්දේසි</h1>
		<p class="legal-meta">
			<strong>අවසන් යාවත්කාලීනය:</strong> 2026 නොවැම්බර් 21. <strong>ක්‍රියාත්මක වන දිනය:</strong> 2026 මැයි 24.
		</p>
		<p class="legal-disclaimer">
			<strong>මොනවා වෙනස් වුණාද:</strong> වෙනත් ව්‍යාපාරයක් ඔබව හඳුන්වා දුන් විට ඔබේ ගිවිසුම කා සමඟද (§2), සහ ක්ෂුද්‍ර ව්‍යවසාය (§8). ඊට පෙර: සේවාව භාවිත කළ හැක්කේ කා හටද, කලාපය, හිමිකාරිත්වය සහ සම්බාධක අනුව (§4); Android හි tafs යෙදුම, සහ Google Play හරහා මිලදී ගත් Solo (§1, §8). ඊටත් පෙර: ගෙවන සැලසුම් (§3A, §8), <a href="/legal/sla">සේවා මට්ටමේ ගිවිසුම</a> (ඉංග්‍රීසියෙන්) (§14), සහ තහනම් භාවිත ලැයිස්තුව, එය දැන් <a href="/acceptable-use">පිළිගත හැකි භාවිත ප්‍රතිපත්තියේ</a> (ඉංග්‍රීසියෙන්) ඇත (§5).
		</p>
		<p class="legal-disclaimer">
			මෙම කොන්දේසි tafs ඇතුළු KIFF Cloud භාවිතය පාලනය කරයි. ගිවිසුම් ප්‍රශ්න: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</header>
}

templ termsDefinitionsSI() {
	<section id="definitions">
		<h2>1. අර්ථ දැක්වීම්</h2>
		<ul>
			<li><strong>"Kiff Agents OÜ"</strong>, <strong>"අපි"</strong>, <strong>"අපට"</strong>, <strong>"අපගේ"</strong> — සේවාව සපයන එස්තෝනියානු පෞද්ගලික සීමිත සමාගම. ලියාපදිංචි කේතය 17372313.</li>
			<li><strong>"ගනුදෙනුකරු"</strong>, <strong>"ඔබ"</strong>, <strong>"ඔබේ"</strong> — මෙම කොන්දේසිවලට එකඟ වන ස්වාභාවික හෝ නීතිමය පුද්ගලයා.</li>
			<li><strong>"පරිශීලකයා"</strong> — ගනුදෙනුකරුගේ ගිණුම හරහා සේවාවට ප්‍රවේශ වීමට ගනුදෙනුකරු බලය දෙන ඕනෑම පුද්ගලයෙකු.</li>
			<li><strong>"සේවාව"</strong> — <code>api.kiff.dev</code>, <code>app.kiff.dev</code>, <code>kiff.dev</code>, tafs, සහ අප එහි පළ කරන ලේඛන, උපකරණ පුවරු සහ API ඇතුළු KIFF Cloud නිෂ්පාදනය.</li>
			<li><strong>"tafs"</strong> — iPhone, iPad, Android සහ පරිගණක (Mac, Windows සහ Linux) සඳහා tafs යෙදුම සහ එයට පිටුපස ඇති සේවාව, Setup සහ planque (§3A) ඇතුළුව, එහි ගනුදෙනුකරුවෙකු KIFF Card තුළ වැඩ කරන AI නියෝජිතයෙකුට කාර්යයක් භාර දෙයි. <strong>"taf"</strong> යනු එවැනි එක් නියෝජිතයෙකි.</li>
			<li><strong>"Tenant"</strong> — එක් ගනුදෙනුකරුවෙකුට අයත් සේවාව තුළ තාර්කිකව හුදෙකලා කළ වැඩ අවකාශයක්.</li>
			<li><strong>"විගණන දත්ත"</strong> — ධාවන කාලය (runtime) හරහා ගනුදෙනුකරු වෙනුවෙන් සේවාව තබාගන්නා සිදුවීම්, තීරණ, ක්‍රියා, අනුමත කිරීම් සහ ලදුපත්.</li>
			<li><strong>"tafs දත්ත"</strong> — ගනුදෙනුකරු වෙනුවෙන් tafs තබාගන්නා දේ: සෑම taf එකකම ධාවන සහ සංවාද (ගනුදෙනුකරුගේ සම්බන්ධිත මෙවලම් එයට ආපසු දෙන දේ ඇතුළුව), එහි වාර්තා, මතක සටහන්, සහ එහි ඇඟවීම් සඳහා ලියාපදිංචි කළ දුරකථන.</li>
			<li><strong>"ලදුපත"</strong> — පාලනය කරන ලද සෑම ක්‍රියාවක් සඳහාම සේවාව නිකුත් කරන අත්සන් කළ, අනුවාද කළ තීරණ වාර්තාවක්.</li>
			<li><strong>"ලේඛන"</strong> — මෙම කොන්දේසිවලින් සබැඳි දිනයක් සහිත සංශෝධනයේ ඇති තාක්ෂණික සේවා ලේඛන සහ ආරක්ෂණ ක්‍රියාමාර්ග (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>). එයට උපායමාර්ගික ධවල පත්‍රිකාව, අලෙවිකරණ ද්‍රව්‍ය සහ වෙන්ව බලපත්‍රලත් විවෘත මූලාශ්‍ර රාමුවේ ලේඛන ඇතුළත් නොවේ.</li>
			<li><strong>"DPA"</strong> — <a href="/legal/dpa">/legal/dpa</a> (ඉංග්‍රීසියෙන්) හි ඇති දත්ත සැකසුම් ගිවිසුම, අපගේ සැකසුම්කරු පාර්ශ්වීය සබඳතාව පාලනය කරන.</li>
		</ul>
	</section>
}

templ termsAgreementSI() {
	<section id="agreement">
		<h2>2. ගිවිසුම</h2>
		<p>
			මෙම කොන්දේසි ඔබේ සේවා භාවිතය පාලනය කරයි. ගිණුමක් සෑදීමෙන්, API යතුරක් ජනනය කිරීමෙන්, හෝ වෙනත් ආකාරයකින් සේවාව භාවිත කිරීමෙන්, ඔබ මෙම කොන්දේසිවලට එකඟ වේ. ඔබ සමාගමක් හෝ වෙනත් නීතිමය ආයතනයක් වෙනුවෙන් පිළිගන්නේ නම්, එම ආයතනය බැඳීමට ඔබට බලය ඇති බව ඔබ ප්‍රකාශ කරන අතර, "ඔබ" සහ "ඔබේ" යන්නෙන් එම ආයතනය අදහස් වේ.
		</p>
		<p>
			සංවර්ධකයෙකු, හවුල්කරුවෙකු හෝ වෙනත් ව්‍යාපාරයක් ඔබව KIFF වෙත හඳුන්වා දුන්නේ නම් හෝ ඔබ භාවිත කරන නියෝජිතයා ගොඩනැගුවේ නම්, සේවාව සඳහා ඔබේ ගිවිසුම මෙම කොන්දේසි යටතේ අප සමඟ සෘජුවම වන අතර, ඔබ ඒවා ඔබම පිළිගනී. ඒ ව්‍යාපාරය අපගේ නියෝජිතයා නොවේ: එයට මෙම කොන්දේසි පිළිගත නොහැක, ඔබ වෙනුවෙන් කැමැත්තක් දිය නොහැක හෝ ගෙවීමක් අනුමත කළ නොහැක, සහ එය අප වෙනුවෙන් සේවාව විකුණන්නේ නැත.
		</p>
		<p>
			අපට නිශ්චිත විශේෂාංග සඳහා (බීටා විශේෂාංග, තෙවන පාර්ශ්ව ඒකාබද්ධ කිරීම්) අතිරේක කොන්දේසි පළ කළ හැක. ඒවා මෙම කොන්දේසිවලට පටහැනි වන තැන, නිශ්චිත විශේෂාංගය සඳහා අතිරේක කොන්දේසි පාලනය කරයි.
		</p>
	</section>
}

templ termsServiceSI() {
	<section id="service">
		<h2>3. සේවාව</h2>
		<p>
			KIFF Cloud යනු ප්‍රතිනිර්දේශිත ක්‍රියා පාලනය කිරීම සඳහා සත්කාරක සේවාවකි. එය ගනුදෙනුකරුගේ වින්‍යාස කළ අවසර සහ Card වලට එරෙහිව ඉල්ලීම් ඇගයීමට ලක් කරයි, මිනිස් අනුමැතිය අවශ්‍ය කළ හැක, සහ පාලන තීරණ වාර්තා කරයි. වින්‍යාස කළ ඒකාබද්ධ කිරීම අනුව, KIFF අවසර ලත් ඉල්ලීමක් ඉදිරියට යවයි හෝ ආරක්ෂිත පද්ධතිය සත්‍යාපනය කරන අවසරයක් ලබා දෙයි. සම්බන්ධිත පද්ධතිය යටින් පවතින ක්‍රියාව ඉටු කරයි.
		</p>
		<p>
			අදාළ තාක්ෂණික හැසිරීම, සාක්ෂි, ඒකාබද්ධ කිරීමේ අවශ්‍යතා සහ ක්‍රියාත්මක කිරීමේ සීමා මෙම කොන්දේසිවලින් සබැඳි දිනයක් සහිත ලේඛනවල සඳහන් කර ඇත. උපායමාර්ගික <a href="/whitepaper">ධවල පත්‍රිකාව</a> (ඉංග්‍රීසියෙන්) KIFF හි මූලධර්ම සහ ආකෘතිය පැහැදිලි කරයි; එය මෙම කොන්දේසි යටතේ තාක්ෂණික ලේඛන ලෙස ඇතුළත් කර නැත.
		</p>
		<p>
			KIFF Cloud හි පාලන සේවාව නියෝජිත රාමුවක්, කාර්ය ප්‍රවාහ එන්ජිමක්, ආකෘති ද්වාරයක් හෝ කළමනාකරණය කළ නියෝජිත වේදිකාවක් <em>නොවේ</em>. ඔබ දැනටමත් භාවිත කරන ඕනෑම දෙයක් සමඟ එය එකතු වේ. පැහැදිලි ලැයිස්තුව සඳහා මුල් පිටුවේ <a href="/#not">"KIFF යනු කුමක් නොවේද"</a> (ඉංග්‍රීසියෙන්) බලන්න. tafs යනු ඔබ වෙනුවෙන්, ඔබ නිකුත් කරන Card තුළ, නියෝජිතයින් ධාවනය කරන සේවාවේ එකම කොටසයි; §3A එය විස්තර කරයි.
		</p>
		<p>
			විවෘත මූලාශ්‍ර <a href="https://github.com/kiff/kiff" target="_blank" rel="noopener">kiff/kiff</a> රාමුව තමන්ගේම MIT බලපත්‍රය යටතේ වන අතර මෙම කොන්දේසිවලින් පිටත වේ. ඔබ රාමුව ඔබේම යටිතල පහසුකම් මත ධාවනය කරන විට, Kiff Agents OÜ සමඟ ගිවිසුමක් නොපවතී.
		</p>
	</section>
}

templ termsTafsSI() {
	<section id="tafs">
		<h2>3A. tafs</h2>
		<p>
			tafs හි ඔබ කාර්යයක් (උදාහරණයක් ලෙස ආපසු ගෙවීම්, බිල්පත් ගෙවීම හෝ කාඩ්පත් ආරවුල්) taf එකකට භාර දෙයි: ඔබ සම්බන්ධ කරන මෙවලම් සමඟ, ඔබ එය සඳහා නිකුත් කරන KIFF Card තුළ කාලසටහනකට අනුව වැඩ කරන AI නියෝජිතයෙකි. සෑම taf එකක්ම අපගේ නියෝජිත ධාවන කාලය මත ධාවනය වන අතර, එය භාවිත කරන AI ආකෘතිය Anthropic සපයයි. ඔබ tafs යෙදුමේ එහි රඳවා ඇති ඇමතුම්වලට පිළිතුරු දෙයි.
		</p>
		<p>
			<strong>ඔබේ මෙවලම් සම්බන්ධ කිරීම.</strong> taf එකක් මෙන් ක්‍රියා කරන tafs හි AI නියෝජිතයෙකු වන Setup, මෙවලමක් සම්බන්ධ කිරීමට සහ කාර්යයක් සඳහා taf එකක් සකස් කිරීමට ඔබට උදව් කරයි. එය තනිවම කිසිවක් සම්බන්ධ නොකරයි. ඔබ මෙවලමේ සැපයුම්කරුගේම ස්ථානයේ (උදාහරණයක් ලෙස Stripe) පිවිසෙන අතර, සෑම සම්බන්ධතාවක්, taf එකකට භාවිත කළ හැකි මෙවලම් සහ එහි Card ඔබේ උපාංගයේ අනුමත කරයි. එම පිවිසුමෙන් ලැබෙන token එක අපගේ සම්බන්ධතා සේවාව වන planque විසින් තබාගනී. එය සංකේතනය කර ඇති අතර, KIFF දැනටමත් තීරණය කළ ඇමතුමක් කිරීමට පමණක් භාවිත වන අතර, කිසිදා taf එකකට ලබා නොදේ. මෙවලමක් විසන්ධි කිරීම සැපයුම්කරු වෙත token එක ඉවත් කර එය මකයි.
		</p>
		<p>
			<strong>ඔබේ Card ඔබේ උපදෙස් වේ.</strong> taf එකක් ඔබේ මෙවලම් වෙත ළඟා වන්නේ KIFF හරහා පමණි, එය යැවීමට පෙර සෑම ඇමතුමක්ම taf හි Card සමඟ පරීක්ෂා කරයි. ඔබ නිකුත් කළ Card එකක් තුළ ඇති ඇමතුමක් සිදු කරන්නේ ඔබේ උපදෙස් පරිදිය. Card එකෙන් පිටත ඇමතුමක් Card එක පවසන පරිදි රඳවා තබනු ලැබේ හෝ ප්‍රතික්ෂේප කෙරේ. රඳවා ඇති ඇමතුමක් සිදු කරන්නේ රඳවා ඇති ඇමතුම්වලට පිළිතුරු දීමට ඔබේ ගිණුම ඉඩ දුන් කෙනෙකු එය අනුමත කළ පසුව පමණි. tafs යෙදුමේ, පිළිතුර KIFF සත්‍යාපනය කරන ඔවුන්ගේ උපාංගයෙන් අත්සනක් රැගෙන යයි, සහ ලදුපත ඒ සාක්ෂිය තබාගනී. ඔබේ ගිණුමට KIFF තුළම (උපකරණ පුවරුව, එහි විධාන රේඛා මෙවලම, හෝ ඔබ එහි බලය පවරන අනුමතකරුවෙකු) පිළිතුරු දිය හැක; ඉන්පසු ලදුපත වාර්තා කරන්නේ කවුරුන්ද පිළිතුරු දුන්නේ සහ කෙසේද යන්නයි.
		</p>
		<p>
			<strong>ඔබ සමඟ පවතින දේ.</strong> ඔබ සෑම taf එකකම කාර්යය සහ Card තෝරයි, එහි රඳවා ඇති ඇමතුම්වලට පිළිතුරු දෙයි, සහ ඔබ සම්බන්ධ කරන මෙවලම් සහ ගිණුම් භාවිත කිරීමට ඔබට අවසර ඇති බව සහතික කරයි. taf එකක වාර්තා, පණිවිඩ සහ මතක සටහන් ලියන්නේ AI ආකෘතියක් විසින් වන අතර ඒවා වැරදි විය හැක; ඒවා මත රඳා පැවතීමට පෙර වැදගත් දේ පරීක්ෂා කරන්න.
		</p>
		<p>
			<strong>taf එකක් නැවැත්වීම.</strong> ඔබට එක taf එකක් හෝ සියල්ලම නැවැත්විය හැක, taf එකක් විරාම කළ හැක, එහි ඕනෑම Card එකක් අවලංගු කළ හැක, හෝ එය ඉවත් කළ හැක. ඔබ taf එකක් නැවැත්වූ හෝ Card එකක් අවලංගු කළ මොහොතේ සිට, KIFF ඒ යටතේ නව ඇමතුම් කිසිවකට ඉඩ නොදෙයි. tafs යෙදුම taf එකක් නැවැත්වූ බව පෙන්වන්නේ KIFF සහ planque දෙදෙනාම නැවැත්වීම තහවුරු කළ පසුව පමණි; එතැන් සිට planque එහි කිසිදු ඇමතුමක් නොයවයි, KIFF ටික වේලාවකට පෙර ඉඩ දුන් එකක් ඇතුළුව. මෙවලමක සැපයුම්කරුවෙකුට දැනටමත් යවා ඇති ඉල්ලීමක් තවමත් සම්පූර්ණ විය හැක: අපි නව ඇමතුම් නවත්වමු, නමුත් සැපයුම්කරුවෙකු කර ඇති දේ අහෝසි කළ නොහැක. planque නොමැතිව KIFF හි අවසර ස්වයං පරීක්ෂා කරන මෙවලමකට, KIFF ටික වේලාවකට පෙර නිකුත් කළ අවසරයක් තවමත් පිළිගත හැක, උපරිම තත්පර 90ක් දක්වා. නවත්වා ඇති taf එකක් නැවත ආරම්භ කිරීමට ඔබේ උපාංගයේ ඔබේ අනුමැතිය අවශ්‍ය වන අතර, නැවැත්වීමට පෙර රඳවා හෝ පෝලිමේ තිබූ කිසිවක් ඉන්පසු ධාවනය නොවේ.
		</p>
		<p>
			<strong>taf එකක් ඉවත් කිරීම</strong> එහි කාලසටහන නවත්වා එහි ධාවන, සංවාද, මතකය සහ එය භාවිත කළ යතුර මකයි. ඊට පෙරද, ඔබේ මෙවලම් taf එකකට ආපසු දෙන දේ තබාගන්නේ එහි ධාවනය අවසන් වන තුරු පමණි (සංවාදයක් කියවූ දේ පමණක්, සංකේතනය කර, එහි ඊළඟ පණිවිඩ සඳහා: උපරිම පැය හතරක් භාවිත කර, ඉන්පසු මකා දමයි), සහ එහි ධාවන සහ සංවාද දින 30ක්. KIFF එය කළ දේ පිළිබඳ ලදුපත් තබාගනී.
		</p>
		<p>
			<strong>EU AI පනත.</strong> tafs සඳහා, Kiff Agents OÜ යනු AI පද්ධතියේ සපයන්නා වන අතර ඔබ එහි යෙදවුම්කරු වේ. ඔබේ සමාගමෙන් පිටත කෙනෙකුට taf එකක් ලියන ඕනෑම දෙයක, එය AI නියෝජිතයෙකු විසින් ලියූ බව සඳහන් බව අපි සහතික කරමු. ඔබ tafs භාවිත කරන්නේ එය පිරිනමන කාර්යයන් සඳහා පමණි, AI පනත තහනම් කරන හෝ ඉහළ අවදානම් ලෙස වර්ග කරන කිසිදු භාවිතයක් සඳහා නොවේ, උදාහරණයක් ලෙස පුද්ගලයෙකුගේ රැකියාව, ණය හෝ අත්‍යවශ්‍ය සේවා වෙත ප්‍රවේශය පිළිබඳ තීරණ. ඔබේ Card අවශ්‍ය කරන මිනිස් අනුමත කිරීම් ඔබ පවත්වාගෙන, ඔබ වෙනුවෙන් tafs භාවිත කරන අය එය කරන දේ සහ එහි සීමා තේරුම් ගන්නා බව සහතික කරයි.
		</p>
		<p>
			<strong>වියදම්.</strong> tafs ඔබේ KIFF සැලැස්මේ කොටසකි (§8): taf එකක සෑම ධාවනයක්ම එය භාවිත කළ AI සඳහා ක්‍රෙඩිට් භාවිත කරයි. Coach, සහ tafs සකස් කිරීම, Coach හි සාධාරණ භාවිතය තුළ ඇතුළත් වේ.
		</p>
	</section>
}

templ termsAccountSI() {
	<section id="account">
		<h2>4. ගිණුම් සහ ප්‍රවේශය</h2>
		<p>
			සේවාව භාවිත කිරීමට ඔබ ගිණුමක් සෑදිය යුතුය. ඔබ නිවැරදි ලියාපදිංචි තොරතුරු සපයන්නට, ඔබේ අක්තපත්‍ර රහසිගතව තබාගන්නට, සහ ඔබේ ගිණුම යටතේ සියලු ක්‍රියාකාරකම් සඳහා වගකිව යුතු වීමට එකඟ වේ.
		</p>
		<p>
			ඔබට අවම වශයෙන් වයස අවුරුදු 16ක් හෝ ඔබේ අධිකරණ බල ප්‍රදේශයේ ඩිජිටල් කැමැත්තේ වයස, ඉන් ඉහළ වන ඒක, තිබිය යුතුය. සේවාව ළමයින් අරමුණු කර ගෙන නොමැත.
		</p>
		<p>
			සේවාව පිරිනමන්නේ <a href="https://www.anthropic.com/supported-countries">Anthropic ලැයිස්තුගත කර ඇති</a> පරිදි එහි AI ආකෘතිය සපයන Anthropic තමන්ගේම සේවාව පිරිනමන රටවල් සහ කලාපවල පමණි. ඔබට එය වෙනත් තැනකින් භාවිත කළ නොහැක. සමාගමක් එම ලැයිස්තුවෙන් පිටත රටක හෝ කලාපයක මූලස්ථානය ඇති නම්, හෝ එවැනි මූලස්ථානයක් ඇති සමාගමක බහුතර හිමිකාරිත්වය හෝ පාලනය ඇති නම්, එහි පරිශීලකයින් සිටින්නේ කොතැනදැයි නොසලකා එය භාවිත නොකළ යුතුය. ඔබ, හෝ ඔබ එය භාවිත කරන සමාගම, යුරෝපීය සංගමයේ, එක්සත් ජාතීන්ගේ හෝ එක්සත් ජනපදයේ සම්බාධකවලට යටත් නම්ද ඔබට එය භාවිත කළ නොහැක. මෙම නීතිය කඩ කරන ගිණුම් අපි ප්‍රතික්ෂේප කරන අතර ඒවා අත්හිටුවිය හැක.
		</p>
		<p>
			ඔබේ ගිණුමේ ඔබ බලය දෙන සෑම පරිශීලකයෙකුගේම ක්‍රියා සඳහා ඔබ වගකිව යුතුය. මෙම කොන්දේසි කඩ කිරීමක් විශ්වාසදායක ලෙස අපි හඳුනාගත්තොත් සාධාරණ දැනුම්දීමකින් අපට ගිණුමක් අත්හිටුවිය හැක හෝ ප්‍රවේශය ඉවත් කළ හැක. පිළිගත හැකි භාවිත උල්ලංඝනයන් සඳහා (බලන්න §5) අත්හිටුවීම වහාම විය හැක.
		</p>
	</section>
}

templ termsAcceptableUseSI() {
	<section id="acceptable-use">
		<h2>5. පිළිගත හැකි භාවිතය</h2>
		<p>
			ඔබ, ඔබේ පරිශීලකයින් සහ ඔබේ නියෝජිතයින් <a href="/acceptable-use">පිළිගත හැකි භාවිත ප්‍රතිපත්තිය</a> (ඉංග්‍රීසියෙන්) අනුගමනය කළ යුතුය. එය මෙම කොන්දේසිවල කොටසක් වන අතර සේවාව භාවිත නොකළ යුතු දේ ලැයිස්තුගත කරයි.
		</p>
		<p>
			විශ්වාසදායක AUP උල්ලංඝනයක් සඳහා අපට වහාම අත්හිටුවිය හැක. ගනුදෙනුකරුගේ අන්තර්ගතය නිරීක්ෂණය කිරීමට අපට බැඳීමක් නැත, නමුත් විශ්වාසදායක වාර්තා මත ක්‍රියා කළ හැක.
		</p>
	</section>
}

templ termsCustomerDataSI() {
	<section id="customer-data">
		<h2>6. ගනුදෙනුකරුගේ දත්ත සහ අන්තර්ගතය</h2>
		<p>
			ඔබ ඔබේ විගණන දත්තවල හිමිකරු වේ. ඔබ Kiff Agents OÜ හට ඔබේ විගණන දත්ත ඔබ වෙනුවෙන් සේවාව ක්‍රියාත්මක කිරීමට, නඩත්තු කිරීමට සහ වැඩිදියුණු කිරීමට අවශ්‍ය පමණින් පමණක් සත්කාරකත්වය, පිටපත් කිරීම, සම්ප්‍රේෂණය, සංදර්ශනය සහ වෙනත් ලෙස සැකසීමට සීමිත, සුවිශේෂී නොවන, රාජකාරි රහිත, ලෝකව්‍යාප්ත බලපත්‍රයක් ලබා දෙයි.
		</p>
		<p>
			ඔබේ විගණන දත්ත සහ ඔබේ tafs දත්ත සඳහා අපි GDPR 28 වන වගන්තිය යටතේ <strong>සැකසුම්කරු</strong> ලෙස ක්‍රියා කරමු; <a href="/legal/dpa">DPA</a> (ඉංග්‍රීසියෙන්) එම සබඳතාව විස්තරාත්මකව පාලනය කරයි. ඔබේ ගිණුම් මෙටා දත්ත සඳහා අපි <strong>පාලකයා</strong> ලෙස ක්‍රියා කරමු; <a href="/si/privacy">පෞද්ගලිකත්ව ප්‍රතිපත්තිය</a> එම සබඳතාව පාලනය කරයි.
		</p>
		<p>
			ඔබ ඉදිරිපත් කරන දත්ත ඉදිරිපත් කිරීමට අවශ්‍ය සියලු අයිතිවාසිකම් ඔබට ඇති බවත්, ඉදිරිපත් කිරීම අදාළ නීතිවලට (දත්ත ආරක්ෂණ නීති සහ, අදාළ තැන, EU AI පනත ඇතුළුව) අනුකූල බවත් ඔබ ප්‍රකාශ කරයි.
		</p>
	</section>
}

templ termsConfidentialitySI() {
	<section id="confidentiality">
		<h2>7. රහස්‍යභාවය</h2>
		<p>
			එක් එක් පාර්ශ්වයට අනෙක් පාර්ශ්වයෙන් පොදු නොවන තොරතුරු ("රහස්‍ය තොරතුරු") ලැබිය හැක. ලබන පාර්ශ්වය රහස්‍ය තොරතුරු භාවිත කරන්නේ මෙම කොන්දේසි යටතේ එහි බැඳීම් ඉටු කිරීමට සහ එහි අයිතිවාසිකම් ක්‍රියාත්මක කිරීමට අවශ්‍ය පමණින් පමණි, සහ තමන්ගේම රහස්‍ය තොරතුරු සඳහා භාවිත කරන තරමටම අවම වශයෙන් සැලකිල්ලකින් ඒවා ආරක්ෂා කරයි.
		</p>
		<p>
			රහස්‍ය තොරතුරුවලට (අ) උල්ලංඝනයකින් තොරව පොදු බවට පත් වූ හෝ වන, (ආ) හෙළිදරව් කිරීමට පෙර ලබන පාර්ශ්වය දැන සිටි, (ඉ) රහස්‍ය තොරතුරු භාවිත නොකර ස්වාධීනව සංවර්ධනය කළ, හෝ (ඊ) නීතියෙන් හෙළි කළ යුතු (අවසර ඇති තැන අනෙක් පාර්ශ්වයට දැනුම් දී) තොරතුරු ඇතුළත් නොවේ.
		</p>
	</section>
}

templ termsFeesSI() {
	<section id="fees">
		<h2>8. ගාස්තු සහ ගෙවීම</h2>
		<p>
			<strong>සැලසුම්.</strong> සෑම ගිණුමකටම එක් සැලැස්මක් ඇත. වත්මන් මිල ගණන් <a href="/pricing">මිල පිටුවේ</a> (ඉංග්‍රීසියෙන්) ඇත; මෙම යාවත්කාලීනය කරන අවස්ථාවේ:
		</p>
		<ul>
			<li><strong>Solo:</strong> එක් පුද්ගලයෙකු, tafs සඳහා, tafs යෙදුමේ App Store හෝ Google Play හරහා මසකට €12.50 බැගින්, VAT ඇතුළුව, මසකට ක්‍රෙඩිට් 500ක් ඇතුළත්ව විකුණනු ලැබේ.</li>
			<li><strong>Company:</strong> එක් අසුනකට මසකට €10.50, එක් අසුනකට මසකට ක්‍රෙඩිට් 500ක්, පොදුවේ, සහ, KIFF Cloud හරහා ඔබේම නියෝජිතයින්ගේ ඇමතුම් සඳහා, එක් අසුනකට මසකට ක්‍රියා 500ක්, පොදුවේ.</li>
			<li><strong>ගිවිසුමක්:</strong> එහි ඇණවුම් ආකෘතියේ ඇති ගාස්තු සහ කොන්දේසි.</li>
		</ul>
		<p>
			අසුන් යනු ගිණුමක පරිපාලකයින් සහ සංස්කාරකයින් ය. අනුමතකරුවන් සහ නරඹන්නන් සෑම සැලැස්මකම නොමිලේ ය. Company හි, ඇතුළත් දේට වඩා, ක්‍රෙඩිටයක් €0.01 ක් සහ ක්‍රියාවක් €0.02 ක් වේ. ඇතුළත් ක්‍රෙඩිට්වලට වඩා වැඩි ක්‍රෙඩිට් ගිණුම සකසන මාසික වියදම් සීමාව දක්වා බිල් කෙරේ (ආරම්භයේ දී €50): සීමාවේ දී, ඊළඟ කාල පරිච්ඡේදය ආරම්භ වන තුරු, හෝ බිල්පත් කළමනාකරණය කරන කෙනෙකු එය ඉහළ නංවන තුරු, KIFF ගිණුමේ taf වල නව ධාවනයක් ආරම්භ නොකරයි.
		</p>
		<p>
			<strong>ක්‍රෙඩිට් පැකේජ.</strong> Solo හි, මාසයේ ඇතුළත් ක්‍රෙඩිට්වලට වඩා වැඩි ක්‍රෙඩිට් ලැබෙන්නේ tafs යෙදුමේ මිලදී ගන්නා ක්‍රෙඩිට් පැකේජවලිනි. පැකේජයක් එක් වරක් මිලදී ගන්නා අතර, කල් ඉකුත් නොවේ, සහ දායකත්වයක් නොවේ; එහි ක්‍රෙඩිට් මාසයේ ඇතුළත් ඒවාට පසුව, පැරණිතම පැකේජය පළමුව භාවිත කෙරේ. ගෙවීම සම්පූර්ණයෙන් ආපසු ගෙවන ලද පැකේජයක් ඉතිරි ක්‍රෙඩිට් සමඟ ආපසු ගනු ලැබේ. මාසයේ ක්‍රෙඩිට් සහ පැකේජ භාවිත වූ විට, ඊළඟ කාල පරිච්ඡේදය ආරම්භ වන තුරු හෝ පැකේජයක් එකතු කරන තුරු KIFF ගිණුමේ taf වල නව ධාවනයක් ආරම්භ නොකරයි. KIFF ගිණුමකට එකතු කරන බෝනස් ක්‍රෙඩිට්ද පැකේජ මෙන් කල් ඉකුත් නොවේ.
		</p>
		<p>
			<strong>ගණන් ගන්නා දේ.</strong> <em>ක්‍රෙඩිටයක්</em> taf එකක ධාවනය භාවිත කළ AI සඳහා ගෙවයි, සම්පූර්ණ ක්‍රෙඩිට් වලින්, ධාවනයකට එක් වරක් වටයා ඉහළට, ධාවනය අවසන් වන විට එක් වරක් ගණන් කෙරේ. KIFF ප්‍රතික්ෂේප කළ ඇමතුමක් සහිත ධාවනයක් තවමත් එහි AI භාවිත කළේය. කිසිදා ගණන් නොගන්නේ: Coach, සහ tafs සකස් කිරීම, Coach හි සාධාරණ භාවිතය තුළ; කිසිවක් නොයවන නව අනුවාදයක පරීක්ෂණයක්; සහ අපගේ පැත්තෙන් අසාර්ථක වූ ධාවනයක්. <em>ක්‍රියාවක්</em> යනු KIFF Cloud හරහා ඔබේම නියෝජිතයෙකු කරන ඇමතුමක් වන අතර එය යමක් සිදු කළේය: KIFF එයට ඉඩ දුන්නේය, එය යවන ලදී, සහ මෙවලම සාර්ථක බව වාර්තා කළේය. ක්‍රියාවක් ලෙස කිසිදා ගණන් නොගන්නේ: ප්‍රතික්ෂේප කළ, රඳවා ඉන්පසු ප්‍රතික්ෂේප කළ, නැවැත්වීමකින් නතර කළ, අවලංගු, මෙවලමේ අසාර්ථක වූ, හෝ ප්‍රතිඵලය නොදන්නා ඇමතුමක්, සහ කියවන්නේ පමණක් වන ඇමතුමක්.
		</p>
		<p>
			<strong>පරීක්ෂණයක් නැත.</strong> ගිණුමක් ගෙවන්නේ එහි පළමු දිනයේ සිටය. සැලැස්මක් ආරම්භ වීමට පෙර, KIFF එහි taf වල ධාවනයක් ආරම්භ නොකරයි, Coach ගේ සකස් කිරීම හැර; කිසිවක් මකා නොදමයි.
		</p>
		<p>
			<strong>ගෙවීම සහ ඉන්වොයිස්.</strong> සැලැස්මක් බිල් කරන්නේ එක් තැනකිනි. kiff.dev මත මිලදී ගත් සැලැස්මක් මිලදී ගන්නා, වෙනස් කරන සහ අවලංගු කරන්නේ එහිදී සහ එය සම්බන්ධ කරන බිල්පත් ද්වාරයේදීය, සහ එහි ගෙවීම් සකසන්නේ Stripe විසිනි. tafs යෙදුමේ මිලදී ගත් Solo iPhone සහ iPad හි App Store හරහා, හෝ Android හි Google Play හරහා විකුණනු ලබන අතර, ගෙවීම්, අලුත් කිරීම් සහ ආපසු ගෙවීම් සඳහා එම ගබඩාවේ කොන්දේසි යටතේ ඔබේ Apple දායකත්ව හෝ Google Play දායකත්වවල කළමනාකරණය කෙරේ. ක්‍රෙඩිට් පැකේජ යෙදුමේ මිලදී ගැනේ. Company kiff.dev මත මිලදී ගැනේ. ගාස්තු මාසිකව ඉදිරියෙන් බිල් කෙරේ; ඇතුළත් දේට වඩා භාවිතය ඊළඟ ඉන්වොයිසිය සමඟ බිල් කෙරේ. පුද්ගලයින් ගණනේ වෙනසක් ඊළඟ ඉන්වොයිසියේ සිට අදාළ වේ. ගෙවීමක් අසාර්ථක වී නිවැරදි නොකළහොත්, සැලැස්ම අවසන් වන අතර සැලැස්මක් තෝරන තුරු KIFF ගිණුමේ ඇමතුම් ප්‍රතික්ෂේප කරයි.
		</p>
		<p>
			<strong>අවලංගු කිරීම.</strong> ඔබට ඕනෑම වේලාවක බිල්පත් ද්වාරයේ, හෝ යෙදුමේ මිලදී ගත් Solo සඳහා, ඔබේ Apple දායකත්ව හෝ Google Play දායකත්වවල අවලංගු කළ හැක. සැලැස්ම ඔබ ගෙවූ කාල පරිච්ඡේදය අවසන් වන තුරු පවතින අතර, අලුත් නොවේ. නීතිය අවශ්‍ය කරන ආකාරයට හැර, දැනටමත් ගෙවූ ගාස්තු ආපසු නොගෙවේ. ඔබ EU හි පාරිභෝගිකයෙකු නම්, ඔබට හේතුවක් නොදී මිලදී ගැනීමෙන් දින 14ක් ඇතුළත ඉවත් විය හැක, සහ අපි ඔබ ගෙවූ දේ, සැලැස්ම දැනටමත් ධාවනය වූ දින සඳහා කොටස අඩු කර ආපසු ගෙවමු. Solo මිලදී ගැනීම් ආපසු ගෙවනු ලබන්නේ App Store හෝ Google Play හරහා, ඔවුන්ගේ කොන්දේසි යටතේ ය.
		</p>
		<p>
			<strong>ක්ෂුද්‍ර ව්‍යවසාය.</strong> ඔබේ ව්‍යාපාරයේ පුද්ගලයින් 10ට අඩු ප්‍රමාණයක් සිටින අතර වාර්ෂික පිරිවැටුම හෝ ශේෂ පත්‍ර එකතුව උපරිම €2 මිලියනයක් නම්, කාඩ්පතකින් කරන ගෙවීම් පිළිබඳ මෙම කොන්දේසිවල සෑම රීතියකටම, Company ඇතුළුව, අපි එය පාරිභෝගිකයෙකු ලෙස සලකමු.
		</p>
		<p>
			<strong>VAT.</strong> Company හි මිල ගණන් VAT රහිතය; Solo සහ ක්‍රෙඩිට් පැකේජ App Store හෝ Google Play විසින් VAT ඇතුළුව විකුණනු ලබයි. Kiff Agents OÜ (VAT අංකය EE102924327) අදාළ තැන එස්තෝනියානු VAT එකතු කරයි. එස්තෝනියාවෙන් පිටත, වලංගු VAT හඳුනාගැනීමේ අංකයක් ඇති ගනුදෙනුකරුවෙකුට EU ව්‍යාපාරයෙන්-ව්‍යාපාරයට විකිණීම් EU reverse-charge යාන්ත්‍රණය යටතේ ඉන්වොයිස් කෙරේ.
		</p>
		<p>
			<strong>වෙනස්කම්.</strong> අපි ක්‍රියාකාරී ගිණුම්වලට මිල ඉහළ යාමක් පිළිබඳව අවම වශයෙන් දින තිහක ලිඛිත දැනුම්දීමක් ලබා දෙමු (§16). මිල අඩු වීමක් ඊළඟ ඉන්වොයිසියේ සිට අදාළ වේ.
		</p>
	</section>
}

templ termsTermSI() {
	<section id="term">
		<h2>9. කාලය සහ අවසන් කිරීම</h2>
		<p>
			මෙම කොන්දේසි ඔබ සේවාව පළමු වරට භාවිත කරන විට බලාත්මක වන අතර අවසන් කරන තුරු පවතී.
		</p>
		<p>
			ඔබට ඕනෑම වේලාවක ඔබේ ගිණුම මැකීමෙන් අවසන් කළ හැක. අපට අවසන් කළ හැක (අ) ලිඛිත දැනුම්දීමෙන් දින තිහක් ඇතුළත ප්‍රතිකර්ම නොකළ බරපතල උල්ලංඝනයක් සඳහා, හෝ (ආ) පිළිගත හැකි භාවිත උල්ලංඝනයන් හෝ ණය නොගෙවීමේ සිදුවීම් සඳහා වහාම.
		</p>
		<p id="leaving">
			<strong>ඉවත් වීම, සහ ඔබේ දත්ත ඔබ සමඟ ගෙන යාම.</strong> ඔබට ඕනෑම වේලාවක ඔබේ දත්ත සංවිධිත, යන්ත්‍රයට කියවිය හැකි ආකෘතියකින් නිර්යාත කළ හැක: KIFF හි, සැකසුම් → දත්ත මඟින් ඔබේ ගිණුම, සෑම අනුවාදයක්ම සහිත ඔබේ Card, ඔබේ වාර්තාවේ ඇති තීරණ (නවතම 10,000; තවත් අප ගෙන් ඉල්ලන්න), KIFF ඉඩ දුන් සෑම එකකම අත්සන් කළ ලදුපත, සහ ඔබේ API යතුරුවල විස්තර (යතුරු කිසිදා නොවේ) සහිත JSON ගොනුවක් ලබා දෙයි. tafs යෙදුමේ, සෑම කෙනෙකුම ඔවුන්ගේම සංවාද, ගොනු සහ සටහන් ගිණුම → මගේ සංවාද නිර්යාත කරන්න මඟින් නිර්යාත කරයි; පෞද්ගලිකත්ව ප්‍රතිපත්තිය පවසන පරිදි සංවාද ඕනෑම අවස්ථාවක දින තිහක් තබාගනී. ඔබේ ගිණුම මැකීම සේවාව වහාම අවසන් කරයි, එබැවින් මුලින් නිර්යාත කරන්න.
		</p>
		<p>
			ඔබට ඒ වෙනුවට වෙනත් සැපයුම්කරුවෙකුට හෝ ඔබේම පද්ධතිවලට මාරු වීමට, <a href="mailto:support@kiff.dev">support@kiff.dev</a> වෙත ලියමින්, දැනුම්දීමක් මත ඉවත් විය හැක. අපි කිසිදා මාස දෙකකට වඩා දැනුම්දීමක් අවශ්‍ය නොකරමු: ඔබේ දැනුම්දීම ඔබ තෝරන දිනයේ සිට බලපැවැත්වේ, ඔබ එය යැවූ දා සිට මාස දෙකකට නොපමා වී. එම දිනයේ සිට, දින තිහක සංක්‍රාන්ති කාලයක් අනුගමනය කරන අතර, එහි සේවාව දිගටම ධාවනය වේ, ඔබ ඔබේ දත්ත නිර්යාත කර ඔබේ වැඩ ගෙන යයි, සහ අපි ඒ සඳහා සාධාරණ ඉල්ලීම්වලට උදව් කරමු. ඔබට සංක්‍රාන්ති කාලය එක් වරක්, ඔබට අවශ්‍ය තරම් කාලයක් දීර්ඝ කළ හැක. දින තිහක් ඇතුළත තාක්ෂණිකව එය සම්පූර්ණ කිරීමට අපට නොහැකි නම්, ඔබේ දැනුම්දීමෙන් වැඩ කරන දින දහහතරක් ඇතුළත, හේතු සහ මාස හතකට නොවැඩි නව කාල සීමාවක් සමඟ අපි ඔබට දන්වමු. සංක්‍රාන්ති කාලයෙන් පසු, ඔබේ දත්ත නිර්යාත සඳහා අවම වශයෙන් තවත් දින තිහක් ලබා ගත හැකිව පවතී. සැලැස්මේ ගාස්තු සංක්‍රාන්ති කාලය අවසන් වන තුරු සුපුරුදු පරිදි දිගටම පවතී. App Store හෝ Google Play හි මිලදී ගත් Solo ගබඩාවේ අවලංගු කෙරේ; සංක්‍රාන්ති සහ නිර්යාත කාල එලෙසම අදාළ වේ.
		</p>
		<p>
			ඉවත් වීම, මාරු වීම හෝ ඔබේ දත්ත නිර්යාත කිරීම සඳහා අපි ගාස්තු අය නොකරමු. මෙම කොටස සෑම ගනුදෙනුකරුවෙකුටම EU දත්ත පනතේ (රෙගුලාසිය (EU) 2023/2854) VI පරිච්ඡේදයේ මාරු වීමේ අයිතිවාසිකම් ලබා දෙයි.
		</p>
		<p>
			අවසන් කිරීමේදී, සහ ඕනෑම සංක්‍රාන්ති සහ නිර්යාත කාලයකට පසු, අපි <a href="/si/privacy#retention">පෞද්ගලිකත්ව ප්‍රතිපත්තියේ</a> රඳවා ගැනීමේ නීතිවලට අනුව ඔබේ විගණන දත්ත, ඔබේ tafs දත්ත සහ ගිණුම් මෙටා දත්ත මකා දමමු.
		</p>
		<p>
			ස්වභාවයෙන්ම අවසන් කිරීමෙන් පසුවද පැවතිය යුතු කොටස් පවතී — රහස්‍යභාවය, බුද්ධිමය දේපළ, වන්දි ගෙවීම, වගකීම් සීමා කිරීම, ප්‍රතික්ෂේප කිරීම්, පාලන නීතිය, සහ උපචිත ගාස්තු ඇතුළුව.
		</p>
	</section>
}

templ termsWarrantiesSI() {
	<section id="warranties">
		<h2>10. වගකීම්</h2>
		<p>
			එක් එක් පාර්ශ්වය මෙම කොන්දේසි වලට ඇතුළත් වී ඒවා ඉටු කිරීමට තමන්ට අයිතිය සහ බලය ඇති බව ප්‍රකාශ කරයි.
		</p>
		<p>
			අපි සේවාව වෘත්තීය ආකාරයකින් සහ ලේඛන සමඟ සැලකිය යුතු අනුකූලතාවයකින් ලබා දෙන බවට වගකීමක් දෙමු. මෙම වගකීම කඩ කිරීම සඳහා ඔබේ එකම ප්‍රතිකර්මය, අපගේ විකල්පයෙන්, නැවත ඉටු කිරීම හෝ කඩ කිරීමේ කාලය සඳහා බලපෑමට ලක් වූ සේවාවට අදාළ ගාස්තු සමානුපාතිකව ආපසු ගෙවීමයි.
		</p>
		<p>
			ඔබේ සේවා භාවිතය අදාළ නීතියට සහ මෙම කොන්දේසිවලට අනුකූල බව ඔබ වගබලා ගනී.
		</p>
	</section>
}

templ termsDisclaimerSI() {
	<section id="disclaimer">
		<h2>11. ප්‍රතික්ෂේප කිරීම</h2>
		<p>
			§10 හි ප්‍රකාශිත වගකීම් හැර, සේවාව <strong>"ඇති පරිදි" සහ "ලබාගත හැකි පරිදි"</strong> සපයනු ලැබේ. නීතිය ඉඩ දෙන උපරිම තරමට, වෙළඳාමට සුදුසුකම, විශේෂිත අරමුණකට යෝග්‍යතාව, උල්ලංඝනය නොකිරීම, සහ ගනුදෙනු ක්‍රමයකින් හෝ වෙළඳ භාවිතයකින් පැන නගින ඕනෑම වගකීමක් ඇතුළුව, ප්‍රකාශිත, ව්‍යංග හෝ ව්‍යවස්ථාපිත වේවා, අනෙකුත් සියලු වගකීම් අපි ප්‍රතික්ෂේප කරමු.
		</p>
		<p>
			සේවාව නොකඩවා, දෝෂ රහිතව, හෝ හානිකර සංරචක රහිතව ඇති බවට, හෝ කිසිදු දත්තයක් නැති නොවන හෝ දූෂිත නොවන බවට අපි වගකියන්නේ නැත. ඔබේ දත්ත උපස්ථ කිරීම ඔබේ වගකීමයි.
		</p>
	</section>
}

templ termsLiabilitySI() {
	<section id="liability">
		<h2>12. වගකීම සීමා කිරීම</h2>
		<p>
			නීතිය ඉඩ දෙන උපරිම තරමට, මෙම කොන්දේසි හෝ සේවාව නිසා හෝ ඒවාට සම්බන්ධව පැන නගින වක්‍ර, ආනුෂංගික, ප්‍රතිඵලමය, විශේෂ, ආදර්ශමත් හෝ දඬුවම්කාරී හානි, ඇතුළුව අහිමි වූ ලාභ, අහිමි වූ ආදායම, අහිමි වූ දත්ත, හෝ ව්‍යාපාරික බාධාවන් සඳහා, එවැනි හානිවල හැකියාව පිළිබඳව දැනුම් දී තිබුණත්, කිසිදු පාර්ශ්වයක් අනෙකාට වගකිව යුතු නොවේ.
		</p>
		<p>
			මෙම කොන්දේසි නිසා හෝ ඒවාට සම්බන්ධව පැන නගින එක් එක් පාර්ශ්වයේ සමස්ත වගකීම (අ) වගකීම ඇති කරන සිද්ධියට පෙර මාස දොළහක් තුළ ගනුදෙනුකරු විසින් Kiff Agents OÜ වෙත ගෙවූ හෝ ගෙවිය යුතු ගාස්තු, හෝ (ආ) යුරෝ ලක්ෂයක් (€100,000), යන දෙකෙන් වැඩි මුදල ඉක්මවන්නේ නැත.
		</p>
		<p>
			අදාළ නීතිය යටතේ සීමා කළ නොහැකි හෝ බැහැර කළ නොහැකි වගකීමක්, මරණය, නොසැලකිල්ලෙන් සිදු වූ පුද්ගලික තුවාල, වංචාව, හෝ හිතාමතා අපචාරය සඳහා වගකීම, සහ දෝෂ සහිත නිෂ්පාදන සඳහා වගකීම පිළිබඳ (EU) 2024/2853 නියෝගය ක්‍රියාත්මක කරන නීතිවලට අනුව දෝෂ සහිත නිෂ්පාදනයක් සඳහා වගකීම ඇතුළුව, මෙම කොන්දේසි කිසිවක් සීමා හෝ බැහැර නොකරයි.
		</p>
	</section>
}

templ termsIndemnitySI() {
	<section id="indemnification">
		<h2>13. වන්දි ගෙවීම</h2>
		<p>
			සේවාව, අප විසින් සපයන ලද පරිදි සහ ඔබ විසින් මෙම කොන්දේසි අනුව භාවිත කරන ලද පරිදි, එම තෙවන පාර්ශ්වයේ බුද්ධිමය දේපළ අයිතිවාසිකම් උල්ලංඝනය කරන බවට තෙවන පාර්ශ්ව හිමිකම් පෑම් වලින් අපි ඔබව ආරක්ෂා කරන්නෙමු, සහ එවැනි හිමිකම් පෑම් සඳහා ඔබට එරෙහිව අවසාන වශයෙන් පිරිනමන ලද හානි (හෝ එකඟ වූ සමථ මුදල) අපි ගෙවන්නෙමු.
		</p>
		<p>
			(අ) ඔබේ ගනුදෙනුකරු දත්ත හෝ අන්තර්ගතය; (ආ) මෙම කොන්දේසි කඩ කරමින් (AUP ඇතුළුව) ඔබේ සේවා භාවිතය; හෝ (ඉ) ඔබේ දරුණු නොසැලකිල්ල හෝ හිතාමතා අපචාරය නිසා පැන නගින තෙවන පාර්ශ්ව හිමිකම් පෑම් වලින් ඔබ අපව ආරක්ෂා කරන්නෙහිය, සහ එවැනි හිමිකම් පෑම් සඳහා අප වෙත එරෙහිව අවසාන වශයෙන් පිරිනමන ලද හානි (හෝ එකඟ වූ සමථ මුදල) ඔබ ගෙවන්නෙහිය.
		</p>
		<p>
			වන්දි ගෙවීම, හිමිකම් පෑම පිළිබඳව ඉක්මන් දැනුම්දීමක්, ආරක්ෂාව සහ සමථය පිළිබඳ වන්දි ගෙවන්නාගේ එකම පාලනය, සහ වන්දි ලබන්නාගේ සාධාරණ සහයෝගය මත කොන්දේසි සහිත වේ. වන්දි ගෙවන්නාට වන්දි ලබන්නා මත බැඳීම් පනවන හිමිකම් පෑමක් එකඟතාවයකින් තොරව සමථයකට පත් කළ නොහැක.
		</p>
	</section>
}

templ termsSLASI() {
	<section id="sla">
		<h2>14. සේවා මට්ටමේ කැපවීම</h2>
		<p>
			ගෙවන සැලැස්මක, <a href="/legal/sla">සේවා මට්ටමේ ගිවිසුම</a> (ඉංග්‍රීසියෙන්) අප කැපවන ලබාගත හැකි බව, සෙමින් හෝ අසාර්ථක ඉල්ලීමක් ගණන් ගන්නා ආකාරය, අපගේ සහාය ප්‍රතිචාර කාල, සහ අපට අඩුපාඩු සිදු වූ විට සේවා ක්‍රෙඩිට් නියම කරයි. එය මෙම කොන්දේසිවල කොටසකි.
		</p>
		<p>
			මෙහෙයුම් භාවිතයන්, සිදුවීම් ප්‍රතිචාරය, සහ කඩ කිරීම් දැනුම්දීමේ කැපවීම් මෙම කොන්දේසිවලින් සබැඳි දිනයක් සහිත සංශෝධනයේ ලේඛනගත කර ඇත (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>); <a href="/security">/security</a> (ඉංග්‍රීසියෙන්) වත්මන් භාවිතයන් පෙන්වයි.
		</p>
	</section>
}

templ termsServiceModsSI() {
	<section id="service-mods">
		<h2>15. සේවාවේ වෙනස්කම්</h2>
		<p>
			අපට ඕනෑම වේලාවක විශේෂාංග එකතු කිරීමට, වෙනස් කිරීමට හෝ ඉවත් කිරීමට හැක. ක්‍රියාකාරීත්වයේ සැලකිය යුතු අඩු කිරීම් හෝ ලේඛනගත හැසිරීම බිඳ දමන API මතුපිටක් අත්හැරීම, පළ කළ අත්හැරීමේ කාලසටහනක් සමඟ, ක්‍රියාකාරී ගනුදෙනුකරුවන්ට අවම වශයෙන් දින තිහකට පෙර දැනුම් දෙනු ලැබේ. දැනුම්දීම ම අවදානමක් ඇති කරන්නේ නම්, ආරක්ෂාව මත පදනම් වූ වෙනස්කම් දැනුම්දීමකින් තොරව කළ හැක.
		</p>
	</section>
}

templ termsTermsModsSI() {
	<section id="terms-mods">
		<h2>16. මෙම කොන්දේසිවල වෙනස්කම්</h2>
		<p>
			අපට මෙම කොන්දේසි වරින් වර සංශෝධනය කළ හැක. සැලකිය යුතු වෙනස්කම් අවම වශයෙන් දින තිහකට පෙර ඊමේල් මගින් සහ මෙම පිටුවේ කැපී පෙනෙන බැනරයකින් දැනුම් දෙනු ලැබේ. සැලකිය යුතු නොවන වෙනස්කම් (පැහැදිලි කිරීම්, යොමු) නව "අවසන් යාවත්කාලීනය" දිනයක් සමඟ පළ කෙරේ. යාවත්කාලීනයක් බලාත්මක වන දිනයෙන් පසු ඔබ සේවාව දිගටම භාවිත කිරීම පිළිගැනීමක් වේ.
		</p>
	</section>
}

templ termsForceMajeureSI() {
	<section id="force-majeure">
		<h2>17. ඉක්මවූ බලය (Force majeure)</h2>
		<p>
			ඔවුන්ගේ සාධාරණ පාලනයෙන් ඔබ්බට ගිය තත්ත්වයන් නිසා ඇති වන ඕනෑම අසාර්ථක වීමක් හෝ ප්‍රමාදයක් සඳහා කිසිදු පාර්ශ්වයක් වගකිව යුතු නොවේ, ස්වාභාවික විපත්, යුද්ධය, ත්‍රස්තවාදය, සිවිල් කැලඹීම්, කම්කරු ආරවුල්, ගින්න, ස්වාභාවික ආපදා, වසංගත සම්බන්ධ රජයේ ක්‍රියාමාර්ග, අන්තර්ජාල හෝ විදුලි බිඳවැටීම්, හෝ විදුලි සංදේශ සැපයුම්කරුවන්ගේ හෝ තෙවන පාර්ශ්ව සත්කාරක යටිතල පහසුකම්වල ක්‍රියා ඇතුළුව.
		</p>
	</section>
}

templ termsGoverningLawSI() {
	<section id="governing-law">
		<h2>18. පාලන නීතිය සහ අධිකරණ බලය</h2>
		<p>
			මෙම කොන්දේසි එස්තෝනියා ජනරජයේ නීතිවලින්, එහි නීති ගැටුම් රීති නොසලකා, පාලනය වේ. ආරවුල් සඳහා සුවිශේෂ අධිකරණය Tallinn හි Harju ප්‍රාදේශීය අධිකරණයයි.
		</p>
		<p>
			ඔබ වෙනත් EU සාමාජික රටක පදිංචි පාරිභෝගිකයෙකු වන තැන, ගිවිසුමකින් ඔබට අත්හැරිය නොහැකි අයිතිවාසිකම් ඔබට ලබා දෙන තරමට ඔබේ මව් අධිකරණ බල ප්‍රදේශයේ අනිවාර්ය පාරිභෝගික ආරක්ෂණ රීති දිගටම අදාළ වේ; මෙම වගන්තිය ඒ රීතිවල ආරක්ෂාව ඔබෙන් ඉවත් නොකරයි.
		</p>
	</section>
}

templ termsGeneralSI() {
	<section id="general">
		<h2>19. සාමාන්‍ය</h2>
		<p>
			<strong>සම්පූර්ණ ගිවිසුම.</strong> මෙම කොන්දේසි, පෞද්ගලිකත්ව ප්‍රතිපත්තිය, DPA, ඕනෑම ඇණවුම් ආකෘති සහ පැහැදිලිව ඇතුළත් කළ ඕනෑම අතිරේක කොන්දේසි සමඟ, ඒවායේ විෂයය පිළිබඳව අප අතර සම්පූර්ණ ගිවිසුමයි, සහ කලින් හෝ සමගාමී ඕනෑම අවබෝධයක් ප්‍රතිස්ථාපනය කරයි.
		</p>
		<p>
			<strong>වෙන් කළ හැකි බව.</strong> ප්‍රතිපාදනයක් බලාත්මක කළ නොහැකි යැයි සලකන්නේ නම්, ඉතිරිය බලපැවැත්වේ.
		</p>
		<p>
			<strong>පැවරීම.</strong> අපගේ ලිඛිත කැමැත්තෙන් තොරව ඔබ මෙම කොන්දේසි පැවරිය නොහැක. අපට ඒකාබද්ධ වීමක්, අත්පත් කර ගැනීමක්, හෝ අපගේ සියලු හෝ සැලකිය යුතු ලෙස සියලු වත්කම් විකිණීමක් සම්බන්ධයෙන්, ඔබට දැනුම් දී, කැමැත්තෙන් තොරව පැවරිය හැක.
		</p>
		<p>
			<strong>අත්හැරීමක් නොවේ.</strong> ප්‍රතිපාදනයක් බලාත්මක කිරීම අසාර්ථක වීම පසුව එය බලාත්මක කිරීමට ඇති අයිතිය අත්හැරීමක් නොවේ.
		</p>
		<p>
			<strong>දැනුම්දීම්.</strong> Kiff Agents OÜ වෙත දැනුම්දීම් <a href="mailto:legal@kiff.dev">legal@kiff.dev</a> වෙත හෝ, තැපැල් මගින්, Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, එස්තෝනියාව වෙත යයි. ඔබට දැනුම්දීම් ඔබේ ගිණුම හා සම්බන්ධ ඊමේලයට හෝ, ඔබ ලබා දී ඇත්නම්, ඔබ නම් කළ නීතිමය-දැනුම්දීම් ලිපිනයට යයි.
		</p>
		<p>
			<strong>ස්වාධීන කොන්ත්‍රාත්කරුවන්.</strong> මෙම කොන්දේසිවල කිසිවක් හවුල්කාරිත්වයක්, නියෝජිත සබඳතාවක්, ඒකාබද්ධ ව්‍යාපාරයක් හෝ සේවා නියුක්තියක් නිර්මාණය නොකරයි.
		</p>
		<p>
			<strong>තෙවන පාර්ශ්ව ප්‍රතිලාභීන්.</strong> කිසිවෙක් නැත, වන්දි ලබන අනුබද්ධ ආයතන පැහැදිලිව හඳුනාගෙන ඇති තරම හැර.
		</p>
	</section>
}

