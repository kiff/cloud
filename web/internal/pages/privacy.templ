package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// Privacy renders the public privacy policy at /privacy.
//
// This is a v0.1 controller-side privacy notice aligned with the
// data-handling posture documented at /security#data-we-process.
// Keep public text free of private repository links, internal
// review notes, and source paths.
//
// Structure mirrors a standard EU-grade privacy notice:
//
//	1. Header + last-updated metadata
//	2. Who we are (Kiff Agents OÜ, Estonia, registry data)
//	3. Scope
//	4. Roles (controller for account, processor for tenant data)
//	5. Categories of personal data
//	6. Lawful bases (Article 6 GDPR)
//	7. Sub-processors (cross-link /subprocessors)
//	8. International transfers
//	9. Retention
//	10. Your rights (Articles 15–22 GDPR)
//	11. Cookies (three strictly-necessary first-party cookies)
//	12. Security (cross-link /security)
//	13. Children
//	14. Automated decision-making (Article 22)
//	15. Changes to this policy
//	16. Contact + supervisory authority
//
// Page voice rule: no "Merkle", "Sepolia", "anchor",
// or "on-chain" tokens — implementation-detail crypto vocabulary stays in
// the anchoring design and the cloud's docs.
templ Privacy() {
	@components.LayoutSite("KIFF — privacy policy", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@privacyHead()
			@privacyWhoWeAre()
			@privacyScope()
			@privacyRoles()
			@privacyCategories()
			@privacyLawfulBases()
			@privacySubprocessors()
			@privacyTransfers()
			@privacyRetention()
			@privacyRights()
			@privacyCookies()
			@privacySecurity()
			@privacyChildren()
			@privacyAutomated()
			@privacyChanges()
			@privacyContact()
		</article>
	}
}

templ privacyHead() {
	<header class="legal-head">
		<p class="legal-badge">Privacy policy · v0.1</p>
		<h1>Privacy Policy</h1>
		<p class="legal-meta">
			<strong>Last updated:</strong> 17 November 2026.
			<strong>Effective date:</strong> 24 May 2026.
		</p>
		<p class="legal-disclaimer">
			This policy explains how KIFF Cloud processes personal
			data across the website, dashboard, API, and the tafs
			app for iPhone, iPad, Android and computers. Questions:
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</header>
}

templ privacyWhoWeAre() {
	<section id="who-we-are">
		<h2>1. Who we are</h2>
		<p>
			KIFF Cloud is operated by <strong>Kiff Agents OÜ</strong>,
			a private limited company incorporated in Estonia.
			Registry information:
		</p>
		<ul>
			<li><strong>Registry code:</strong> 17372313 (Estonian e-Business Register)</li>
			<li><strong>VAT number:</strong> EE102924327</li>
			<li><strong>Registered address:</strong> Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estonia</li>
			<li><strong>Privacy contact:</strong> <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a></li>
			<li><strong>Formal legal notices:</strong> <a href="mailto:legal@kiff.dev">legal@kiff.dev</a></li>
		</ul>
		<p>
			Because Kiff Agents OÜ is established in the European
			Union, the EU General Data Protection Regulation
			(<abbr title="General Data Protection Regulation">GDPR</abbr>)
			applies natively to our processing. We do not require
			an Article 27 EU Representative.
		</p>
	</section>
}

templ privacyScope() {
	<section id="scope">
		<h2>2. Scope of this policy</h2>
		<p>
			This policy covers personal data we process when you
			interact with:
		</p>
		<ul>
			<li><a href="https://kiff.dev"><code>kiff.dev</code></a> — our marketing site, this policy page, and the public receipt-rendering surface.</li>
			<li><a href="https://app.kiff.dev"><code>app.kiff.dev</code></a> — our authenticated dashboard.</li>
			<li><a href="https://api.kiff.dev"><code>api.kiff.dev</code></a> — our HTTP API.</li>
			<li id="tafs"><strong>tafs</strong> — our app for iPhone, iPad, Android and computers (Mac, Windows and Linux), and the service behind it (including Setup, which connects a company's tools, and planque, which keeps those connections), in which a company hands a job to an AI agent that works inside KIFF Cards.</li>
		</ul>
		<p>
			This policy does <em>not</em> cover the open-source
			<code>kiff/kiff</code> framework you may run yourself.
			When you run the framework on your own infrastructure,
			you are the controller of any data it processes, and
			Kiff Agents OÜ is not involved in that processing.
		</p>
	</section>
}

templ privacyRoles() {
	<section id="roles">
		<h2>3. Our roles under GDPR</h2>
		<p>
			We act in two capacities depending on the data:
		</p>
		<ul>
			<li>
				<strong>Controller</strong> for account and sign-in
				metadata, billing data (when billing is active),
				marketing communications you opt into, and the
				operational telemetry of our own service.
			</li>
			<li>
				<strong>Processor</strong> for the audit data, action
				records, decision receipts, and other content that
				flows through the runtime on behalf of our customers,
				and for what tafs keeps for them (each taf's runs, chats, reports, memory notes and the files they deliver).
				Customers (the tenants) are controllers of that data;
				they instruct us via their account settings and
				domain configuration. The Data Processing Agreement
				(<abbr title="Data Processing Agreement">DPA</abbr>)
				governs that relationship; see the
				<a href="/legal/dpa">DPA template</a>
				for the published terms.
			</li>
		</ul>
		<p>
			This policy primarily addresses our controller-side
			processing. Where we mention processor-side data, the
			DPA is the more specific document.
		</p>
	</section>
}

templ privacyCategories() {
	<section id="categories">
		<h2>4. Categories of personal data we process</h2>
		<p>
			The categories below are aligned with the technical
			inventory at
			<a href="/security#data-we-process">/security#data-we-process</a>.
			Where the two diverge, the technical page is the source
			of truth and we update this section to match.
		</p>
		<ul>
			<li>
				<strong>Account identifiers</strong> — your upstream
				authentication subject (issued by our identity
				provider) and the email address you sign in with.
				Stored verbatim today; hashed-at-rest is planned.
			</li>
			<li>
				<strong>Tenant metadata</strong> — tenant id, slug,
				display name, creation timestamp, and the language each
				person's app last used, so the emails KIFF sends them
				come in it.
			</li>
			<li>
				<strong>API credentials</strong> — opaque API key
				records (we store hashes, never the plaintext).
			</li>
			<li>
				<strong>Session cookie data</strong> — an HMAC-signed
				session cookie set after sign-in. See the cookies
				section below.
			</li>
			<li>
				<strong>HTTP request metadata</strong> — IP address,
				user agent, request path, response status, latency.
				Held in our reverse proxy's access logs for a limited
				retention window for security and abuse prevention.
			</li>
			<li>
				<strong>Tenant-controlled content</strong> — the
				<code>parameters</code>, <code>actor</code>, and
				<code>entity</code> data you send to the runtime.
				We hold this <em>as processor</em> on the customer's
				behalf; the customer is responsible for what reaches
				the wire. Per-domain redaction config is planned.
			</li>
			<li>
				<strong>Communications</strong> — emails you send to
				our support, sales, security, or privacy mailboxes.
			</li>
			<li>
				<strong>The tafs app</strong> — you sign in to tafs
				with your KIFF account. On a phone or tablet the app
				keeps your session in the device's Keychain (on Android,
				its encrypted storage). On a computer it keeps it sealed
				for your user account: on a Windows PC with Windows' own
				data protection, on Linux in your keyring, on a Mac in
				its Keychain. A computer's session lasts up to 90 days.
				The app makes a signing key that never leaves the device:
				in the Secure Enclave of an iPhone, iPad or Mac, the
				Keystore of an Android device, or the TPM of a Windows
				PC. On Linux, and on a Mac without a Secure Enclave, the
				key is a software key kept in your keyring or Keychain,
				and that computer can show what waits for you but not
				approve it; you approve on your phone{ macSecurityKey("en") }. A Windows PC
				without a TPM can't sign in to tafs. KIFF keeps the key's public half, the device's
				name and platform, and when it was added and last used,
				so it can check your answers to held calls and your
				approvals of connections. If you approve with a passkey
				on your computer, such as Windows Hello or a security
				key, your face,
				fingerprint or PIN stays with the computer's own system;
				KIFF keeps the passkey's public key, its id, a counter
				and a name, never anything secret, and refuses a passkey
				that syncs to other devices. If you turn on alerts on a
				phone, a tablet or a Mac running the iPad app, we keep the device's push token with
				your KIFF person id, and the language the app showed, so
				its alerts come in it. The tafs service also keeps the
				account's language, from whoever last chatted with
				Coach, for up to three months, so a taf's reports come in
				it. A phone's alert goes through Apple or Google with
				only which taf and what it wants, and in a door's alert
				the name or email address of who wrote in: never an
				amount or a request's details. The app adds those on the
				device itself, from KIFF, so an unlocked phone's alert
				can show an amount, a merchant or a person. On a locked
				Android phone it shows only "A taf needs you", and on a
				locked iPhone too, unless you've set its previews to show
				always. <strong>Your watch:</strong> a watch holds no password or key, talks only to your paired phone, and never approves. It sends what you say to Coach, or to the taf you chose, only as text, through the phone, once you've allowed the AI. The watch's own speech service, Apple's or Google's, turns your words into that text. It can refuse, halt or send to Coach or a taf only while it has a screen lock or passcode and is unlocked. What you send to a taf goes into that taf's own chat, as if you'd written it on your phone. A taf's chat, amounts included, shows on the watch only while it's open, read through the phone each time; the watch keeps none of it. <strong>Apple Watch:</strong> it shows your tafs and their pages without keeping them. It keeps only your Inbox, in a file it can't read while it's locked: each held call as its taf's name and what it asks, never an amount, and Coach's replies to what you sent from the watch, as text. If you sign out on the watch, it also keeps that you did, until you sign in again on the watch. Apart from that, it keeps nothing unless the watch has a passcode. The Inbox goes when you sign out on the watch or your iPhone signs out, or the next time the app opens or closes without a passcode. It makes no recording, and the only notifications it shows are your iPhone's. <strong>Wear OS:</strong> it shows your account's email and today's calendar without keeping them. So that it opens at once, it keeps your tafs' names, states, counts and times, and Coach's latest text for each taf, encrypted: never an amount, a held call's details or a taf's chat. That's cleared when you sign out, when you take the watch off, and after 24 hours. It keeps your Inbox, where each line is a taf's name and what it says, never an amount, and one message kept for later, as text. Signing out, on the watch or on the phone, clears all of it. For its tile, it also keeps the count of what waits for you, shown only while the watch is unlocked, and cleared when you sign out, or the next time the tile shows while the watch is locked or has no screen lock. After you sign out on the watch, it keeps a note that you did, until you sign in again. The Inbox also goes the next time the app opens or closes while the watch is locked or has no screen lock. A message kept for later stays until you send or delete it, since you asked for it to be sent. If the watch's speech service stops before you've finished, the watch sends the recording to your phone, which turns it into text on the phone itself, never on a server. The recording is deleted once the text is back or you cancel, and after 2 minutes at most. A taf's result can stay in the watch's notifications until you dismiss it or sign out on the watch. On a Windows PC,
				a Linux computer or a Mac with the macOS 12 app, alerts
				are made by the app itself while it runs, with no push
				token and through no other company. On Windows and Linux
				they show which taf, what it wants to do, the amount, why
				and by when; on the macOS 12 app they show KIFF's words
				for the call, once you turn them on, and a locked screen
				shows what the Mac's preview setting allows. On Windows
				they're off
				until you turn them on, and show only "A taf needs you"
				while the screen is locked. One shown before
				the screen locked keeps its details in Windows'
				notification list. On Linux they're on until you
				turn them off, and what a locked screen shows depends on
				your desktop. When you
				connect a tool, you sign in at the tool's own provider. For an app planque signs in to itself, such as Stripe, or a key you give, planque keeps that token or key for your company, encrypted; for a managed connection, Composio, the connection service planque works with, holds the sign-in, and planque keeps only the connection's record and the tools you approved (all as processor, see below). KIFF uses managed connections only for the apps named on <a href="/subprocessors#composio">/subprocessors</a>. The app has no analytics or
				advertising trackers.
			</li>
			<li>
				<strong>App Store purchases</strong> — when you buy Solo
				or a pack of credits in tafs, Apple sells it to you: Apple is
				the seller of record, takes the payment and keeps your
				payment details. Apple tells us what was bought, for
				which KIFF account (a random id the app attaches to the
				purchase), when, Apple's transaction id, and for Solo
				when the period ends or renews. We use it to add the
				credits or the plan to your account. Apple doesn't give
				us your Apple ID, name, email address or card.
			</li>
			<li>
				<strong>Google Play purchases</strong> — on Android,
				the same purchases go through Google Play's billing:
				Google takes the payment and keeps your payment
				details. Google tells us what was bought, for which
				KIFF account (the same random id), when, the
				purchase's token and order id, and for Solo when the
				period ends or renews, and we use it the same way.
				Google doesn't give us your Google account, name,
				email address or card.
			</li>
		</ul>
	</section>
}

templ privacyLawfulBases() {
	<section id="lawful-bases">
		<h2>5. Lawful bases for processing</h2>
		<p>
			Under Article 6 of the GDPR, we rely on the following
			lawful bases:
		</p>
		<ul>
			<li>
				<strong>Performance of a contract</strong> (Article
				6(1)(b)) — for account creation, authentication,
				operating the runtime on your behalf, billing (when
				active), and the core service surfaces.
			</li>
			<li>
				<strong>Legitimate interests</strong> (Article 6(1)(f))
				— for security, fraud prevention, abuse detection,
				operational telemetry, and protecting the service.
				We balance our interests against your rights and
				will tell you on request what that balancing test
				produced.
			</li>
			<li>
				<strong>Consent</strong> (Article 6(1)(a)) — for the AI in the tafs app: what is sent to the AI model that runs Coach and your tafs, as described <a href="#ai-in-tafs">below</a>. Nothing is sent until you allow it, and you can withdraw in Account. Consent is also what we would ask for before any analytics cookies, optional marketing communications, or new processing that materially expands our use of your data. We run no analytics, no advertising, and no non-essential tracking.
			</li>
			<li>
				<strong>Legal obligation</strong> (Article 6(1)(c))
				— for tax records (Estonian Accounting Act §12, 7
				years), responses to lawful authority requests, and
				retention required by anti-money-laundering rules
				where applicable.
			</li>
		</ul>
		<h3 id="ai-in-tafs">The AI in the tafs app</h3>
		<p>The tafs app asks you before anything goes to the AI, in these words:</p>
		<ul>
			<li>tafs uses Anthropic's Claude AI for Coach and your tafs.</li>
			<li>Coach and your tafs are AI agents: what they write is generated by AI and can be wrong. A message a taf sends outside your company says it was written by an AI agent.</li>
			<li>What's sent to it: what you write to Coach and your tafs, the files you attach, what your connected apps return to a taf while it works, and what's on your screen while Coach helps you in the app.</li>
			<li>What's never sent: the passwords and keys your connected apps use, or your fingerprint.</li>
			<li>Anthropic uses it to answer and keeps it up to 30 days.</li>
			<li>Nothing is sent until you allow it. You can withdraw in Account.</li>
		</ul>
		<p>A taf that runs with no one there at the moment (on its schedule, or when something comes in) rests on the consent of the person who made it or took it over, or else of the first person who manages the account's tafs to allow it.</p>
		<p><strong>When you withdraw,</strong> Coach and your tafs stop answering you. A taf whose runs rest on your consent pauses: its schedules stop, and what comes in waits. It goes on once consent is given again, or someone who manages the account's tafs takes it over with their own. Withdrawing doesn't change what was sent before.</p>
		<p>Anthropic is listed on <a href="/subprocessors">/subprocessors</a>, with where it processes and when it may keep data longer.</p>
	</section>
}

templ privacySubprocessors() {
	<section id="sub-processors">
		<h2>6. Sub-processors</h2>
		<p>We don't sell your personal data, and we don't share it for advertising.</p>
		<p>
			We engage a small set of vendors to deliver the service.
			The official, current list lives at
			<a href="/subprocessors">/subprocessors</a>;
			that page is updated within 30 days of any change. We
			require each sub-processor to provide protections
			equivalent to ours under written agreements, including
			the EU Standard Contractual Clauses where personal data
			leaves the EU.
		</p>
		<p>
			Material additions to or replacements of sub-processors
			that affect personal data are notified to active
			customers in advance, with a right to object.
		</p>
	</section>
}

templ privacyTransfers() {
	<section id="transfers">
		<h2>7. International transfers</h2>
		<p>
			Some of our sub-processors are established outside the
			European Economic Area, primarily in the United States.
			For each such transfer we rely on at least one of the
			following safeguards:
		</p>
		<ul>
			<li>
				<strong>EU–US Data Privacy Framework</strong> — for
				US sub-processors that have certified to the
				Framework. Adequacy decision in force as of mid-2023;
				we monitor for any change in its status.
			</li>
			<li>
				<strong>Standard Contractual Clauses</strong> —
				module 2 (controller-to-processor) for our direct
				sub-processors and module 3 (processor-to-sub-processor)
				where chained processors apply. We use the 2021
				Commission-approved SCCs.
			</li>
			<li>
				<strong>Supplementary measures</strong> — where the
				risk assessment indicates additional safeguards are
				warranted (encryption in transit and at rest, access
				logging, data minimization).
			</li>
		</ul>
		<p>
			You can request the specific transfer instrument
			applicable to a given sub-processor by emailing
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
		<p><strong>Your country.</strong> Some countries' laws ask for more than this policy says. What they add, in English and in the country's language, is on <a href="/privacy/countries">Your country</a>.</p>
	</section>
}

templ privacyRetention() {
	<section id="retention">
		<h2>8. Retention</h2>
		<p>
			We retain personal data for the shortest period
			consistent with the purposes for which we process it
			and any applicable legal obligation.
		</p>
		<ul>
			<li>
				<strong>Account and sign-in metadata</strong> —
				until the account is deleted. In the tafs app, an
				owner deletes it in Account → <em>Delete
				account</em>. An account made on the web is deleted
				by emailing
				<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>,
				within the GDPR Article 12(3) one-month window.
				Either way, the account's keys stop at once. Deleted
				in the tafs app, it can't be undone: its tafs chats,
				notes and connections are erased at once, and what
				KIFF keeps is erased within 30 days. Deleted on the
				web, we keep its data for a grace window of 30 days,
				in case the owner wants it back, then erase it.
			</li>
			<li>
				<strong>API key records</strong> — until account
				deletion, including after a key is revoked. A key that
				belongs to an agent sign-in connection is deleted with
				that connection, 30 days after it ends.
			</li>
			<li>
				<strong>Session cookies</strong> — until expiry (24
				hours by default) or until you sign out.
			</li>
			<li>
				<strong>Reverse-proxy access logs</strong> — up to 90
				days, then aggregated or deleted.
			</li>
			<li>
				<strong>Service logs</strong> — what KIFF's services
				and planque record as they run: errors, and requests,
				which can name an account, a person or an agent. 30
				days, then deleted.
			</li>
			<li>
				<strong>Backups</strong> — KIFF's database is backed
				up daily, encrypted, and each backup is kept 7 days, so
				a deleted record is gone from them within 7 days.
				The stores of tafs and planque keep encrypted
				point-in-time copies for 35 days, used only to restore a
				store after a failure, so a deleted record is gone from
				them within 35 days.
			</li>
			<li>
				<strong>Tenant audit data</strong> — held as processor
				per the customer's tenant configuration. Default:
				retained for the lifetime of the tenant; deleted on
				tenant deletion. See
				<a href="/security#deletion">/security#deletion</a>.
			</li>
			<li>
				<strong>Calls through the KIFF gateway</strong> — a
				call's arguments until it is sent, refused or fails,
				then deleted; the tool's result for 24 hours, then
				deleted. The decision record and a hash of the
				arguments are kept as tenant audit data. See
				<a href="/security#data-kept">/security#data-kept</a>.
			</li>
			<li>
				<strong>Usage</strong> — for each call through the
				gateway, once it ends: which agent made it, the tool,
				and whether it counted as an action or was free (and
				why). For each run of a taf or of Coach, once it ends:
				the taf, when, the credits its AI used, and whether they
				counted or why not. Until the account is deleted; what
				is reported to our payment processor for billing is kept
				with the billing records.
			</li>
			<li>
				<strong>Agent sign-in connections</strong> — which
				agent, the app's name, who allowed it, when, and its
				last use: while the connection is live, then 30
				days after it ends (it stays listed in the dashboard
				for that time), then deleted with its tokens and its
				API key. All of it is deleted with the account.
			</li>
			<li>
				<strong>tafs</strong> — a device's push token until you
				sign out of the app, remove the device, or Apple or
				Google reports the token gone. A device's public key,
				name, platform and dates while you use it; once you sign
				it out, it's marked removed and kept until the account is
				deleted, so KIFF can refuse a late answer from it and show
				which device signed an earlier one. A passkey's public
				key, id and name are kept as its device's. A computer keeps its session up
				to 90 days, or until you sign out. What tafs keeps for
				your company is held as processor: a taf's runs and
				chats, with a chat's summary (and Setup's), for 30 days,
				what your tools return only until a run ends (in a chat,
				what it only read is kept encrypted for its next
				messages, used until the chat has been idle an hour and
				at most four hours after the read, then deleted
				automatically, within a few days), and its memory notes
				until the
				taf is removed; the files it delivers 30 days from the run that made them, then deleted automatically within a day, or sooner if someone on your account deletes one; a connection's token or key in planque, or a managed connection's sign-in at Composio, until you disconnect it, and the record of its approvals
				until the account ends; see the
				<a href="/legal/dpa#annex-4">DPA's Annex 4</a>.
			</li>
			<li>
				<strong>Billing records</strong> — 7 years from the
				end of the financial year (Estonian Accounting Act
				§12).
			</li>
			<li>
				<strong>App Store and Google Play purchases</strong> —
				what Apple or Google told us about each purchase stays
				in your account until the account is deleted. Their
				sales and payout reports, which we keep as billing
				records for 7 years, don't name you.
			</li>
			<li>
				<strong>Support correspondence</strong> — 3 years
				from the last interaction, then deleted.
			</li>
		</ul>
	</section>
}

templ privacyRights() {
	<section id="rights">
		<h2>9. Your rights</h2>
		<p>
			Under the GDPR you have the following rights with respect
			to your personal data:
		</p>
		<ul>
			<li><strong>Access</strong> (Article 15) — confirmation of whether we process your data, and a copy of it.</li>
			<li><strong>Rectification</strong> (Article 16) — correction of inaccurate or incomplete data.</li>
			<li><strong>Erasure</strong> (Article 17) — deletion of your data, subject to legal-retention exceptions.</li>
			<li><strong>Restriction</strong> (Article 18) — pause processing while a dispute is resolved.</li>
			<li><strong>Portability</strong> (Article 20) — a machine-readable export of data you provided.</li>
			<li><strong>Objection</strong> (Article 21) — to processing based on legitimate interests; we stop unless we can show overriding grounds.</li>
			<li><strong>Withdraw consent</strong> (Article 7(3)) — for any processing based on consent, such as the AI in the tafs app (in Account, as <a href="#ai-in-tafs">above</a>). Withdrawal does not affect prior lawful processing.</li>
		</ul>
		<p>
			To exercise any of these rights, email
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
			We respond within one month per Article 12(3); we may
			extend by up to two further months for complex requests
			and will tell you if we do.
		</p>
		<h3 id="export-chats">Your own tafs chats</h3>
		<p>
			In the tafs app, Account →  Export my chats
			downloads your own chats with each taf, Coach's
			included, the names of the files you attached, and your
			own notes, as a readable file and as JSON. Only you can
			export them: an admin or the account's owner can't, and
			KIFF's account export doesn't include them.
		</p>
		<h3 id="delete-account">Deleting your tafs account</h3>
		<p>
			tafs is KIFF's app. To delete your tafs account and its
			data:
		</p>
		<ol>
			<li>Open the tafs app and sign in.</li>
			<li>Go to Account, then tap <em>Delete account</em>.</li>
			<li>Confirm. Deleting an account can't be undone.</li>
		</ol>
		<p>
			<em>Delete account</em> shows to whoever may delete the
			company's account, usually its owner. If you don't see
			it, or no longer have the app, email
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			from the address you sign in with, and we delete your
			data within one month.
		</p>
		<p>
			What is deleted: the account's keys stop at once. Its
			tafs, chats, notes, attached files and connections are
			erased at once, and from their point-in-time copies within
			35 days. What KIFF keeps for the account is
			erased within 30 days, and from backups within 7 days
			after that. Service logs that name the account are gone
			within 30 days. Tenant audit data is deleted with the
			tenant. See <a href="#retention">Retention</a> for each
			kind of data.
		</p>
		<p id="delete-data">
			To delete some of your data and keep the account: in
			the app, delete a chat, and its messages and attached
			files go with it; remove a taf, and its chats, notes and
			connections go with it. For anything else, email
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			and say what to delete. We do it within one month.
		</p>
		<p>
			You have the right to lodge a complaint with a
			supervisory authority. Our lead supervisory authority
			is the
			<a href="https://www.aki.ee/en" target="_blank" rel="noopener">Estonian Data Protection Inspectorate (Andmekaitse Inspektsioon)</a>.
			You may also complain to the supervisory authority in
			your member state of residence.
		</p>
		<p><strong>Your country.</strong> Some countries' laws ask for more than this policy says. What they add, in English and in the country's language, is on <a href="/privacy/countries">Your country</a>.</p>
	</section>
}

templ privacyCookies() {
	<section id="cookies">
		<h2>10. Cookies</h2>
		<p>
			We set three cookies, all strictly necessary, first-party,
			sent only over HTTPS and unreadable by scripts on the page.
			Under EU ePrivacy rules they do not require consent; we
			list them so you know they exist. The
			<a href="/cookies">cookie policy</a> has the details.
		</p>
		<ul>
			<li>
				<strong><code>kiff_session</code></strong> — keeps you
				signed in. A signed session cookie carrying your sign-in
				id, email and name, and the credential the dashboard uses
				for you. Set for <code>.kiff.dev</code>. It lasts 24 hours,
				or until you sign out.
			</li>
			<li>
				<strong><code>kiff_flash</code></strong> — carries a
				one-time message to the next page, such as "your key was
				made". Signed; a new key is never in it. Set for
				<code>.kiff.dev</code>. Deleted when the next page reads
				it, and at most 5 minutes.
			</li>
			<li>
				<strong><code>kiff_cb_attempts</code></strong> — counts how
				often the sign-in page has reloaded, so a sign-in that
				loops is stopped. Sent only to that page. It lasts 5
				minutes, and is cleared when a sign-in starts or succeeds.
			</li>
		</ul>
		<p>
			We do not use analytics cookies, advertising cookies, or
			any third-party trackers. If we ever add any, we will
			present a consent banner before the cookie is set, in
			line with ePrivacy and the EDPB's 2023 guidance on
			tracking technologies.
		</p>
		<p>
			If you sign in via Clerk (our authentication
			sub-processor), Clerk also sets cookies on its own
			frontend domain (<code>clerk.kiff.dev</code>). Those
			cookies are necessary for Clerk to recognize you across
			its sign-in flow and are governed by Clerk's privacy
			policy as well as ours. See the sub-processor list for
			details.
		</p>
	</section>
}

templ privacySecurity() {
	<section id="security">
		<h2>11. Security</h2>
		<p>
			Our technical and organisational security measures are
			documented at <a href="/security">/security</a>. They
			include tenant isolation at the database layer,
			TLS 1.2+ in transit, encryption at rest via the managed
			provider's defaults, and access controls based on the
			principle of least privilege.
		</p>
		<p>
			We notify affected customers of a personal data breach
			without undue delay and within 72 hours of confirmation,
			consistent with Article 33 GDPR. Notice includes the
			nature of the breach, categories and approximate numbers
			of data subjects and records concerned, the likely
			consequences, and the measures taken or proposed.
		</p>
	</section>
}

templ privacyChildren() {
	<section id="children">
		<h2>12. Children</h2>
		<p>
			KIFF Cloud is a developer infrastructure product not
			directed at children. We do not knowingly collect
			personal data from children under 16. If you believe a
			child has provided personal data to us, contact
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			and we will delete it.
		</p>
	</section>
}

templ privacyAutomated() {
	<section id="automated">
		<h2>13. Automated decision-making</h2>
		<p>
			KIFF Cloud's runtime makes deterministic policy decisions
			on data sent by our customers. These are not decisions
			about you that produce legal or similarly significant
			effects in the sense of Article 22 GDPR; they are
			decisions about the customer's actions (refunds, orders,
			messages, and so on) executed under the customer's own
			policy.
		</p>
		<p>
			Customers who use KIFF Cloud to make decisions affecting
			their own end users are themselves responsible for
			Article 22 compliance. Our governance receipts are
			designed to give those customers the audit trail they
			need to demonstrate human oversight, but the legal
			obligation to provide that oversight rests with the
			customer.
		</p>
	</section>
}

templ privacyChanges() {
	<section id="changes">
		<h2>14. Changes to this policy</h2>
		<p>
			We may update this policy from time to time. Material
			changes are notified by email to active customers and
			by a prominent banner on this page for at least 30 days.
			Non-material changes are posted with a new
			"last updated" date.
		</p>
	</section>
}

templ privacyContact() {
	<section id="contact">
		<h2>15. Contact us</h2>
		<p>
			Privacy questions and rights requests:
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
		<p>
			Formal legal notices to Kiff Agents OÜ:
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>,
			or by post to Tööstuse tn 75-71, Põhja-Tallinna linnaosa,
			Tallinn 10416, Estonia.
		</p>
		<p>
			Lead supervisory authority for complaints:
			<a href="https://www.aki.ee/en" target="_blank" rel="noopener">Estonian Data Protection Inspectorate (Andmekaitse Inspektsioon)</a>.
		</p>

		<hr/>

		<p class="legal-footnote">
			<strong>Document version:</strong> v0.1.<br/>
			<strong>Last updated:</strong> 17 November 2026.
		</p>
	</section>
}
