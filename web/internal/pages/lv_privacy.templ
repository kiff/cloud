package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// PrivacyLV is the privacy policy (/privacy) in Latvian, at /lv/privacy.
// It is a translation of Privacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English
// page governs. Change the English page first, then this one. Latvian has
// the legal texts only, so a link to any other page goes to English and
// says so.
templ PrivacyLV() {
	@components.LayoutSite("KIFF — privātuma politika", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@privacyHeadLV()
			@privacyWhoWeAreLV()
			@privacyScopeLV()
			@privacyRolesLV()
			@privacyCategoriesLV()
			@privacyLawfulBasesLV()
			@privacySubprocessorsLV()
			@privacyTransfersLV()
			@privacyRetentionLV()
			@privacyRightsLV()
			@privacyCookiesLV()
			@privacySecurityLV()
			@privacyChildrenLV()
			@privacyAutomatedLV()
			@privacyChangesLV()
			@privacyContactLV()
		</article>
	}
}

templ privacyHeadLV() {
	<header class="legal-head">
		<p class="legal-badge">Privātuma politika · v0.1</p>
		<h1>Privātuma politika</h1>
		<p class="legal-meta">
			<strong>Pēdējoreiz atjaunināta:</strong> 2026. gada 24. novembrī.
			<strong>Spēkā stāšanās datums:</strong> 2026. gada 24. maijs.
		</p>
		<p class="legal-disclaimer">
			Šī politika izskaidro, kā KIFF Cloud apstrādā personas datus
			tīmekļa vietnē, vadības panelī, API un lietotnē tafs iPhone,
			iPad, Android ierīcēm un datoriem. Jautājumi:
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</header>
}

templ privacyWhoWeAreLV() {
	<section id="who-we-are">
		<h2>1. Kas mēs esam</h2>
		<p>
			KIFF Cloud darbina <strong>Kiff Agents OÜ</strong>, Igaunijā
			reģistrēta sabiedrība ar ierobežotu atbildību.
			Reģistra informācija:
		</p>
		<ul>
			<li><strong>Reģistra kods:</strong> 17372313 (Igaunijas e-komercreģistrs, e-Business Register)</li>
			<li><strong>PVN numurs:</strong> EE102924327</li>
			<li><strong>Juridiskā adrese:</strong> Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Igaunija</li>
			<li><strong>Kontakti privātuma jautājumos:</strong> <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a></li>
			<li><strong>Oficiāli juridiski paziņojumi:</strong> <a href="mailto:legal@kiff.dev">legal@kiff.dev</a></li>
		</ul>
		<p>
			Tā kā Kiff Agents OÜ ir reģistrēta Eiropas Savienībā, ES
			Vispārīgā datu aizsardzības regula
			(<abbr title="Vispārīgā datu aizsardzības regula">VDAR</abbr>)
			uz mūsu apstrādi attiecas tieši. Mums nav nepieciešams ES
			pārstāvis saskaņā ar 27. pantu.
		</p>
	</section>
}

templ privacyScopeLV() {
	<section id="scope">
		<h2>2. Šīs politikas darbības joma</h2>
		<p>
			Šī politika attiecas uz personas datiem, ko mēs apstrādājam,
			kad jūs izmantojat:
		</p>
		<ul>
			<li><a href="https://kiff.dev"><code>kiff.dev</code></a> — mūsu mārketinga vietni, šo politikas lapu un publisko kvīšu attēlošanas lapu.</li>
			<li><a href="https://app.kiff.dev"><code>app.kiff.dev</code></a> — mūsu vadības paneli, kam nepieciešama pierakstīšanās.</li>
			<li><a href="https://api.kiff.dev"><code>api.kiff.dev</code></a> — mūsu HTTP API.</li>
			<li id="tafs"><strong>tafs</strong> — mūsu lietotni iPhone, iPad, Android ierīcēm un datoriem (Mac, Windows un Linux) un pakalpojumu, uz kura tā darbojas (tostarp Setup, kas pievieno uzņēmuma rīkus, un planque, kas glabā šos savienojumus), kurā uzņēmums uztic darbu AI aģentam, kas strādā KIFF Card ietvaros.</li>
		</ul>
		<p>
			Šī politika <em>neattiecas</em> uz atvērtā koda ietvaru
			<code>kiff/kiff</code>, ko varat darbināt pats. Ja darbināt
			ietvaru savā infrastruktūrā, jūs esat pārzinis visiem
			datiem, ko tas apstrādā, un Kiff Agents OÜ šajā apstrādē
			nepiedalās.
		</p>
	</section>
}

templ privacyRolesLV() {
	<section id="roles">
		<h2>3. Mūsu lomas saskaņā ar VDAR</h2>
		<p>
			Atkarībā no datiem mēs darbojamies divās lomās:
		</p>
		<ul>
			<li>
				<strong>Pārzinis</strong> attiecībā uz konta un
				pierakstīšanās metadatiem, norēķinu datiem (kad norēķini
				ir aktīvi), mārketinga paziņojumiem, kuriem jūs
				piesakāties, un mūsu pašu pakalpojuma darbības
				telemetriju.
			</li>
			<li>
				<strong>Apstrādātājs</strong> attiecībā uz audita datiem,
				darbību ierakstiem, lēmumu kvītīm un citu saturu, kas
				plūst caur izpildlaiku (runtime) mūsu klientu vārdā, un
				attiecībā uz to, ko tafs viņiem glabā (katra taf palaišanas, tērzēšanas sarunas, ziņojumi, atmiņas piezīmes un faili, ko tie piegādā).
				Klienti (tenants) ir šo datu pārziņi; viņi sniedz mums
				norādījumus ar sava konta iestatījumiem un domēna
				konfigurāciju. Šīs attiecības regulē Datu apstrādes
				līgums (<abbr title="Datu apstrādes līgums">DPA</abbr>);
				publicētie noteikumi ir
				<a href="/legal/dpa">DPA veidnē</a> (angliski).
			</li>
		</ul>
		<p>
			Šī politika galvenokārt attiecas uz mūsu kā pārziņa veikto
			apstrādi. Ja minam datus, ko apstrādājam kā apstrādātājs,
			konkrētākais dokuments ir DPA.
		</p>
	</section>
}

templ privacyCategoriesLV() {
	<section id="categories">
		<h2>4. Mūsu apstrādāto personas datu kategorijas</h2>
		<p>
			Turpmāk norādītās kategorijas atbilst tehniskajam sarakstam
			lapā
			<a href="/security#data-we-process">/security#data-we-process</a> (angliski).
			Ja tie atšķiras, noteicošā ir tehniskā lapa, un mēs šo
			sadaļu atjauninām atbilstoši.
		</p>
		<ul>
			<li>
				<strong>Konta identifikatori</strong> — jūsu
				autentifikācijas subjekts (ko izdod mūsu identitātes
				nodrošinātājs) un e-pasta adrese, ar kuru pierakstāties.
				Pašlaik tiek glabāti nemainītā veidā; jaucējvērtību (hash)
				glabāšana ir plānota.
				Ja ieslēdzat pierakstīšanos ar e-pastā nosūtītu kodu (tā ir izslēgta, kamēr to nedarāt), KIFF glabā šo iestatījumu kopā ar jūsu pierakstīšanās ID un izmaiņu datumu. Kodu, ko jums nosūtām pa e-pastu, glabā tikai kā atslēgotu jaucējkodu, līdz tas tiek izmantots vai pagājušas desmit minūtes. Lai ierobežotu ļaunprātīgu izmantošanu, līdz vienai dienai glabājam pieprasījumu skaitu pēc pieprasījušās adreses un IP adreses atslēgotā jaucējkoda. Pēc pierakstīšanās ar kodu to atzīmējam piecpadsmit minūtes, lai izmaiņas, kam vajadzīga svaiga pierakstīšanās, lūgtu jums pierakstīties citādi.
			</li>
			<li>
				<strong>Tenant metadati</strong> — tenant identifikators,
				slug, attēlojamais nosaukums, izveides laikspiedols un
				valoda, ko katras personas lietotne izmantoja pēdējo
				reizi, lai e-pasta vēstules, ko KIFF šai personai sūta,
				būtu šajā valodā.
			</li>
			<li>
				<strong>API pierakstīšanās dati</strong> — necaurredzami
				API atslēgu ieraksti (mēs glabājam jaucējvērtības, nekad
				atklāto tekstu).
			</li>
			<li>
				<strong>Sesijas sīkdatnes dati</strong> — ar HMAC
				parakstīta sesijas sīkdatne, ko iestata pēc
				pierakstīšanās. Skatīt sadaļu par sīkdatnēm turpmāk.
			</li>
			<li>
				<strong>HTTP pieprasījumu metadati</strong> — IP adrese,
				lietotāja aģents (user agent), pieprasījuma ceļš, atbildes
				statuss, latentums. Tiek glabāti mūsu reversā
				starpniekservera (reverse proxy) piekļuves žurnālos
				ierobežotu laiku drošības un ļaunprātīgas izmantošanas
				novēršanas nolūkā.
			</li>
			<li>
				<strong>Tenant kontrolēts saturs</strong> — dati
				<code>parameters</code>, <code>actor</code> un
				<code>entity</code>, ko sūtāt izpildlaikam.
				Mēs tos glabājam <em>kā apstrādātājs</em> klienta
				vārdā; klients atbild par to, kas tiek nosūtīts.
				Rediģēšanas (redaction) konfigurācija katram domēnam ir
				plānota.
			</li>
			<li>
				<strong>Saziņa</strong> — e-pasta vēstules, ko sūtāt uz
				mūsu atbalsta, pārdošanas, drošības vai privātuma
				pastkastēm.
			</li>
			<li>
				<strong>Lietotne tafs</strong> — tafs pierakstāties ar
				savu KIFF kontu. Tālrunī vai planšetdatorā lietotne glabā
				jūsu sesiju ierīces Keychain (Android ierīcē — tās
				šifrētajā krātuvē). Datorā tā to glabā aizzīmogotu jūsu
				lietotāja kontam: Windows datorā ar pašas Windows datu
				aizsardzību, Linux — jūsu keyring, Mac — tā Keychain.
				Datora sesija ilgst līdz 90 dienām. Lietotne izveido
				parakstīšanas atslēgu, kas nekad neatstāj ierīci: iPhone,
				iPad vai Mac ierīces Secure Enclave, Android ierīces
				Keystore vai Windows datora TPM. Linux un Mac bez Secure
				Enclave atslēga ir programmatūras atslēga, kas glabājas
				jūsu keyring vai Keychain, un šis dators var parādīt, kas
				jūs gaida, bet nevar to apstiprināt; jūs apstiprināt savā tālrunī{ macSecurityKey("lv") }. Windows dators
				bez TPM nevar pierakstīties tafs. KIFF glabā atslēgas publisko daļu, ierīces
				nosaukumu un platformu, kā arī to, kad tā pievienota un
				pēdējoreiz izmantota, lai varētu pārbaudīt jūsu atbildes
				uz aizturētiem izsaukumiem un jūsu savienojumu
				apstiprinājumus. Ja apstiprināt ar piekļuves atslēgu
				(passkey) savā datorā, piemēram, Windows Hello vai drošības
				atslēgu, jūsu seja,
				pirksta nospiedums vai PIN paliek datora paša sistēmā;
				KIFF glabā piekļuves atslēgas publisko atslēgu, tās
				identifikatoru, skaitītāju un nosaukumu, nekad neko
				slepenu, un noraida piekļuves atslēgu, kas sinhronizējas
				ar citām ierīcēm. Ja ieslēdzat brīdinājumus tālrunī,
				planšetdatorā vai Mac, kurā darbojas iPad lietotne, mēs glabājam ierīces push žetonu kopā ar
				jūsu KIFF personas identifikatoru un valodu, ko rādīja
				lietotne, lai tās brīdinājumi būtu šajā valodā. Pakalpojums
				tafs glabā arī konta valodu, no tā, kurš pēdējais tērzēja
				ar Coach, līdz trim mēnešiem, lai taf ziņojumi būtu šajā
				valodā. Tālruņa brīdinājums iet caur Apple vai Google tikai
				ar to, kurš taf un ko tas vēlas, un durvju (door)
				brīdinājumā ar tā cilvēka vārdu vai e-pasta adresi, kurš
				rakstīja: nekad ar summu vai pieprasījuma informāciju.
				Lietotne tās pievieno pašā ierīcē, no KIFF, lai atbloķēta
				tālruņa brīdinājums varētu rādīt summu, tirgotāju vai
				personu. Bloķētā Android tālrunī tas rāda tikai "taf gaida
				tevi", un bloķētā iPhone tāpat, ja vien neesat iestatījis,
				lai tā priekšskatījumi tiktu rādīti vienmēr. <strong>Jūsu pulkstenis:</strong> pulkstenis neglabā paroli vai atslēgu, sazinās tikai ar jūsu pārī savienoto tālruni un nekad neapstiprina. Tas sūta to, ko sakāt Coach vai jūsu izvēlētajam taf, tikai kā tekstu, caur tālruni, kad esat atļāvis AI. Pulksteņa paša runas pakalpojums, Apple vai Google, pārvērš jūsu vārdus šajā tekstā. Wear OS pulkstenī, ja tas apstājas, pirms esat beidzis runāt, to tā vietā paveic jūsu tālruņa paša runas atpazīšana, tālrunī. Tas var atteikt, apturēt vai sūtīt Coach vai taf tikai tad, ja tam ir ekrāna bloķēšana vai piekļuves kods un tas ir atbloķēts. Tas, ko sūtāt taf, nonāk šī taf paša tērzēšanas sarunā, it kā jūs to būtu rakstījis tālrunī. Taf saruna, ieskaitot summas, katru reizi, kad tā ir atvērta, tiek lasīta caur tālruni, un pulkstenis glabā tikai jaunākās ziņas, ko apraksta tā sadaļa zemāk. Kad lietotnes ir aizvērtas, tālrunis jaunās atbildes un ziņas nodod pulkstenim pa sistēmas pašas tālruņa–pulksteņa savienojumu (Apple Watch – Apple, Wear OS – Google Play pakalpojumu), kas tās glabā tālrunī un pulkstenī tikai līdz brīdim, kad pulkstenis tās saņem; paziņojumā, kas pamodina tālruni, nav vārdu. Atbilde, kas pienāk, kamēr neskatāties pulkstenī, tiek parādīta arī kā paziņojums jūsu iPhone un Apple Watch vai Wear OS pulkstenī, ar tās vārdiem, bet nekad ar summu, un paliek, līdz to noraidāt; bloķēts Wear OS pulkstenis rāda tikai, ka atbilde ir gatava. <strong>Apple Watch:</strong> tas rāda jūsu taf un to lapas, tās neglabājot. Tas glabā jūsu iesūtni failā, ko tas nevar nolasīt, kamēr ir bloķēts: katru aizturēto izsaukumu kā tā taf nosaukumu un to, ko tas prasa, nekad summu, un Coach atbildes uz to, ko sūtījāt no pulksteņa, kā tekstu. Ja izrakstāties pulkstenī, tas glabā arī to, ka to izdarījāt, līdz atkal pierakstāties pulkstenī. Izņemot to, tas neko neglabā, ja vien pulkstenim nav piekļuves koda. Iesūtne tiek dzēsta, kad izrakstāties pulkstenī vai jūsu iPhone izrakstās, vai nākamreiz, kad lietotne tiek atvērta vai aizvērta bez piekļuves koda. Tas neveic audioierakstus, un vienīgie paziņojumi, ko tas rāda, ir jūsu iPhone paziņojumi. Lai saruna atvērtos uzreiz, tas glabā arī pēdējās 30 ziņas no katras no līdz 20 tajā atvērtajām sarunām, Coach un jūsu tafs, tikai kā tekstu un nekad summu, bloķētas kā iesūtne; tās tiek dzēstas kopā ar iesūtni un tad, ja saruna nav atvērta 30 dienas. <strong>Wear OS:</strong> tas rāda jūsu konta e-pastu un šodienas kalendāru, tos neglabājot. Lai tas atvērtos uzreiz, tas šifrēti glabā to, cik daudz jūs gaida, un katra taf nosaukumu un to, vai tas ir apturēts vai iepauzēts: nekad summu, aizturēta izsaukuma informāciju vai taf tērzēšanas sarunu. Tas tiek dzēsts, kad izrakstāties, kad pulkstenis tiek bloķēts vai noņemts no plaukstas, un pēc 24 stundām. Tas glabā jūsu iesūtni, kur katra rinda ir taf nosaukums un tas, ko tas saka, nekad summa, un vienu vēlākam laikam saglabātu ziņu, kā tekstu. Izrakstīšanās pulkstenī vai tālrunī to visu dzēš. Savai flīzei (tile) tas glabā arī to, cik daudz jūs gaida, ko rāda tikai tad, kad pulkstenis ir atbloķēts, un dzēš, kad izrakstāties, vai nākamreiz, kad flīze tiek rādīta, kamēr pulkstenis ir bloķēts vai tam nav ekrāna bloķēšanas. Pēc izrakstīšanās pulkstenī tas glabā piezīmi, ka to izdarījāt, līdz atkal pierakstāties. Iesūtne tiek dzēsta arī nākamreiz, kad lietotne tiek atvērta vai aizvērta, kamēr pulkstenis ir bloķēts vai tam nav ekrāna bloķēšanas. Vēlākam laikam saglabāta ziņa paliek, līdz to nosūtāt vai dzēšat, jo jūs lūdzāt to nosūtīt. Ja pulksteņa runas pakalpojums apstājas, pirms esat beidzis runāt, pulkstenis nosūta audioierakstu uz jūsu tālruni, kas to pārvērš tekstā pašā tālrunī, nekad serverī. Audioieraksts tiek dzēsts abās ierīcēs, tiklīdz teksts ir saņemts vai jūs atceļat, un ne vēlāk kā pēc 2 minūtēm. Coach vai jūsu taf tālāk tiek nodots tikai teksts. taf rezultāts var palikt pulksteņa paziņojumos, līdz to paslēpjat vai izrakstāties pulkstenī. Lai saruna atvērtos uzreiz, tas glabā arī pēdējās 30 ziņas no katras no līdz 20 tajā atvērtajām sarunām, Coach un jūsu tafs, tikai kā tekstu un nekad summu, šifrētas; tās tiek dzēstas, kad izrakstāties pulkstenī vai tālrunī, un tad, ja saruna nav atvērta 30 dienas, bet pulkstenis bez ekrāna bloķēšanas neglabā nevienu. Windows datorā,
				Linux datorā vai Mac ar macOS 12 lietotni brīdinājumus
				veido pati lietotne, kamēr tā darbojas, bez push žetona un
				bez jebkāda cita uzņēmuma. Windows un Linux tie rāda, kurš
				taf, ko tas vēlas darīt, summu, kāpēc un līdz kuram
				laikam; macOS 12 lietotnē tie rāda KIFF formulējumu par
				izsaukumu, kad tos ieslēdzat, un bloķēts ekrāns rāda to,
				ko atļauj Mac priekšskatījuma iestatījums. Windows tie ir
				izslēgti,
				līdz tos ieslēdzat, un, kamēr ekrāns ir bloķēts, rāda
				tikai "taf gaida tevi". Paziņojums, kas parādīts pirms
				ekrāna bloķēšanas, saglabā savu informāciju Windows
				paziņojumu sarakstā. Linux tie ir ieslēgti, līdz tos
				izslēdzat, un tas, ko rāda bloķēts ekrāns, ir atkarīgs no
				jūsu darbvirsmas vides. Kad
				pievienojat rīku, jūs pierakstāties pie paša rīka nodrošinātāja. Lietotnei, kurā planque pierakstās pats, piemēram, Stripe, vai jūsu sniegtai atslēgai planque glabā šo žetonu vai atslēgu jūsu uzņēmumam, šifrētu; pārvaldītam savienojumam pierakstīšanos glabā Composio, savienojumu pakalpojums, ar kuru strādā planque, un planque glabā tikai savienojuma ierakstu un jūsu apstiprinātos rīkus (visu kā apstrādātājs, skatīt turpmāk). Ja savienojat tafs paplašinājumu, taf var arī lasīt jūsu atļauto vietņu lapas un tajās darboties jūsu pašu Chrome (kā apstrādātājs; <a href="/lv/tafs/privacy">tafs privātuma lapa</a> norāda, kas tiek lasīts, kas tiek glabāts un cik ilgi). Savienojuma ierakstā var būt konts, kurā tas ir pierakstīts (tā nosaukums vai e-pasts), lai lietotne varētu jums parādīt, kurš tas ir. KIFF izmanto pārvaldītus savienojumus tikai lietotnēm, kas norādītas lapā <a href="/subprocessors#composio">/subprocessors</a> (angliski). Lietotnē nav analītikas vai
				reklāmas izsekotāju.
			</li>
			<li>
				<strong>App Store pirkumi</strong> — kad tafs pērkat Solo
				vai kredītu paketi, to jums pārdod Apple: Apple ir
				pārdevējs, iekasē maksājumu un glabā jūsu maksājumu
				informāciju. Apple mums paziņo, kas tika nopirkts, kuram
				KIFF kontam (nejaušs identifikators, ko lietotne pievieno
				pirkumam), kad, Apple darījuma identifikatoru un, Solo
				gadījumā, kad periods beidzas vai tiek atjaunots. Mēs to
				izmantojam, lai pievienotu kredītus vai plānu jūsu kontam.
				Apple mums nesniedz jūsu Apple ID, vārdu, e-pasta adresi
				vai karti.
			</li>
			<li>
				<strong>Google Play pirkumi</strong> — Android ierīcēs
				tie paši pirkumi notiek ar Google Play norēķinu sistēmu:
				Google iekasē maksājumu un glabā jūsu maksājumu
				informāciju. Google mums paziņo, kas tika nopirkts, kuram
				KIFF kontam (tas pats nejaušais identifikators), kad,
				pirkuma žetonu un pasūtījuma identifikatoru un, Solo
				gadījumā, kad periods beidzas vai tiek atjaunots, un mēs
				to izmantojam tāpat. Google mums nesniedz jūsu Google
				kontu, vārdu, e-pasta adresi vai karti.
			</li>
		</ul>
	</section>
}

templ privacyLawfulBasesLV() {
	<section id="lawful-bases">
		<h2>5. Apstrādes tiesiskais pamats</h2>
		<p>
			Saskaņā ar VDAR 6. pantu mēs balstāmies uz šādiem
			tiesiskajiem pamatiem:
		</p>
		<ul>
			<li>
				<strong>Līguma izpilde</strong> (6. panta 1. punkta b)
				apakšpunkts) — konta izveidei, autentifikācijai,
				izpildlaika darbināšanai jūsu vārdā, norēķiniem (kad tie
				ir aktīvi) un pakalpojuma pamatfunkcijām.
			</li>
			<li>
				<strong>Leģitīmās intereses</strong> (6. panta 1. punkta
				f) apakšpunkts) — drošībai, krāpšanas novēršanai,
				ļaunprātīgas izmantošanas atklāšanai, darbības
				telemetrijai un pakalpojuma aizsardzībai. Mēs izsveram
				savas intereses pret jūsu tiesībām un pēc pieprasījuma
				pastāstīsim, kāds bija šīs izsvēršanas rezultāts.
			</li>
			<li>
				<strong>Piekrišana</strong> (6. panta 1. punkta a) apakšpunkts) — AI izmantošanai lietotnē tafs: tam, kas tiek sūtīts AI modelim, kas darbina Coach un jūsu taf, kā aprakstīts <a href="#ai-in-tafs">turpmāk</a>. Nekas netiek sūtīts, līdz jūs to atļaujat, un piekrišanu varat atsaukt sadaļā Konts. Piekrišanu mēs lūgtu arī pirms jebkādām analītikas sīkdatnēm, neobligātiem mārketinga paziņojumiem vai jaunas apstrādes, kas būtiski paplašina jūsu datu izmantošanu. Mēs neveicam analītiku, reklāmu un nebūtisku izsekošanu.
			</li>
			<li>
				<strong>Juridisks pienākums</strong> (6. panta 1. punkta
				c) apakšpunkts) — nodokļu uzskaites ierakstiem (Igaunijas
				Grāmatvedības likuma 12. pants, 7 gadi), atbildēm uz
				likumīgiem iestāžu pieprasījumiem un glabāšanai, ko
				pieprasa noziedzīgi iegūtu līdzekļu legalizācijas
				novēršanas noteikumi, ja tie piemērojami.
			</li>
		</ul>
		<h3 id="ai-in-tafs">AI lietotnē tafs</h3>
		<p>Lietotne tafs jums jautā, pirms kaut kas tiek nosūtīts AI, ar šiem vārdiem:</p>
		<ul>
			<li>tafs izmanto Anthropic AI Claude, lai darbinātu Coach un jūsu taf.</li>
			<li>Coach un jūsu taf ir AI aģenti: to rakstīto ģenerē AI, un tas var būt kļūdains. Ziņā, ko taf sūta ārpus jūsu uzņēmuma, ir norādīts, ka to ir rakstījis AI aģents.</li>
			<li>Kas tam tiek sūtīts: tas, ko rakstāt Coach un saviem taf, jūsu pievienotie faili, tas, ko jūsu pievienotās lietotnes atgriež taf, kamēr tas strādā, un tas, kas ir jūsu ekrānā, kamēr Coach jums palīdz lietotnē.</li>
			<li>Kas nekad netiek sūtīts: paroles un atslēgas, ko izmanto jūsu pievienotās lietotnes, vai jūsu pirksta nospiedums.</li>
			<li>Anthropic to izmanto, lai atbildētu, un glabā to līdz 30 dienām.</li>
			<li>Nekas netiek sūtīts, līdz jūs to atļaujat. Piekrišanu varat atsaukt sadaļā Konts.</li>
		</ul>
		<p>taf, kas darbojas, kad neviens tobrīd nav klāt (pēc sava grafika vai kad kaut kas pienāk), balstās uz tās personas piekrišanu, kura to izveidoja vai pārņēma, vai citādi uz piekrišanu, ko sniedz pirmā persona, kas pārvalda konta taf un to atļauj.</p>
		<p><strong>Kad atsaucat piekrišanu,</strong> Coach un jūsu taf pārstāj jums atbildēt. taf, kura palaišanas balstās uz jūsu piekrišanu, tiek iepauzēts: tā grafiki apstājas, un tas, kas pienāk, gaida. Tas turpina darbu, kad piekrišana tiek sniegta atkārtoti vai kāds, kas pārvalda konta taf, to pārņem ar savu piekrišanu. Atsaukšana nemaina to, kas tika nosūtīts iepriekš.</p>
		<p>Anthropic ir norādīts lapā <a href="/subprocessors">/subprocessors</a> (angliski) kopā ar to, kur tas apstrādā datus un kad tas var tos glabāt ilgāk.</p>
	</section>
}

templ privacySubprocessorsLV() {
	<section id="sub-processors">
		<h2>6. Apakšapstrādātāji</h2>
		<p>Mēs nepārdodam jūsu personas datus un nekopīgojam tos reklāmas nolūkos.</p>
		<p>
			Pakalpojuma sniegšanai mēs piesaistām nelielu piegādātāju
			loku. Oficiālais, aktuālais saraksts ir lapā
			<a href="/subprocessors">/subprocessors</a> (angliski);
			šī lapa tiek atjaunināta 30 dienu laikā pēc jebkuras
			izmaiņas. Mēs pieprasām, lai katrs apakšapstrādātājs
			saskaņā ar rakstiskiem līgumiem nodrošina mūsējai
			līdzvērtīgu aizsardzību, tostarp ES līguma
			standartklauzulas, ja personas dati tiek nosūtīti ārpus ES.
		</p>
		<p>
			Par būtiskiem apakšapstrādātāju papildinājumiem vai
			aizstāšanu, kas skar personas datus, aktīvajiem klientiem
			paziņo iepriekš, ar tiesībām iebilst.
		</p>
	</section>
}

templ privacyTransfersLV() {
	<section id="transfers">
		<h2>7. Starptautiska datu nosūtīšana</h2>
		<p>
			Daži no mūsu apakšapstrādātājiem ir reģistrēti ārpus
			Eiropas Ekonomikas zonas, galvenokārt Amerikas Savienotajās
			Valstīs. Katrai šādai nosūtīšanai mēs balstāmies uz vismaz
			vienu no šīm garantijām:
		</p>
		<ul>
			<li>
				<strong>ES un ASV datu privātuma regulējums</strong>
				(EU–US Data Privacy Framework) — ASV apakšapstrādātājiem,
				kas ir sertificēti saskaņā ar šo regulējumu. Lēmums par
				aizsardzības līmeņa pietiekamību ir spēkā kopš 2023. gada
				vidus; mēs sekojam jebkurām tā statusa izmaiņām.
			</li>
			<li>
				<strong>Līguma standartklauzulas</strong> —
				2. modulis (no pārziņa apstrādātājam) mūsu tiešajiem
				apakšapstrādātājiem un 3. modulis (no apstrādātāja
				apakšapstrādātājam), ja ir apstrādātāju ķēde. Mēs
				izmantojam Komisijas apstiprinātās 2021. gada līguma
				standartklauzulas.
			</li>
			<li>
				<strong>Papildu pasākumi</strong> — ja riska novērtējums
				norāda, ka nepieciešamas papildu garantijas (šifrēšana
				pārsūtīšanas laikā un glabāšanā, piekļuves reģistrēšana,
				datu minimizēšana).
			</li>
		</ul>
		<p>
			Jūs varat pieprasīt konkrēto nosūtīšanas instrumentu, kas
			piemērojams konkrētam apakšapstrādātājam, rakstot uz
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
		<p><strong>Jūsu valsts.</strong> Dažu valstu tiesību akti prasa vairāk, nekā teikts šajā politikā. Ko tie papildina, angļu valodā un attiecīgās valsts valodā, ir lapā <a href="/privacy/countries">Jūsu valsts</a>.</p>
	</section>
}

templ privacyRetentionLV() {
	<section id="retention">
		<h2>8. Glabāšana</h2>
		<p>
			Mēs glabājam personas datus īsāko laiku, kas atbilst to
			apstrādes nolūkiem un jebkuram piemērojamam juridiskam
			pienākumam.
		</p>
		<ul>
			<li>
				<strong>Konta un pierakstīšanās metadati</strong> — līdz
				konta dzēšanai. Lietotnē tafs īpašnieks to dzēš sadaļā
				Konts → <em>Dzēst kontu</em>. Tīmeklī izveidots konts
				tiek dzēsts, rakstot uz
				<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>,
				VDAR 12. panta 3. punktā noteiktajā viena mēneša termiņā.
				Abos gadījumos konta atslēgas nekavējoties pārstāj
				darboties. Ja konts dzēsts lietotnē tafs, dzēšana ir
				neatgriezeniska: tā tafs tērzēšanas sarunas, piezīmes un
				savienojumi tiek nekavējoties dzēsti, un tas, ko glabā
				KIFF, tiek dzēsts 30 dienu laikā. Ja konts dzēsts
				tīmeklī, mēs glabājam tā datus 30 dienu labvēlības
				periodu, ja īpašnieks vēlas to atgūt, un pēc tam tos
				dzēšam.
			</li>
			<li>
				<strong>API atslēgu ieraksti</strong> — līdz konta
				dzēšanai, arī pēc atslēgas atsaukšanas. Atslēga, kas
				pieder aģenta pierakstīšanās savienojumam, tiek dzēsta
				kopā ar šo savienojumu 30 dienas pēc tā beigām.
			</li>
			<li>
				<strong>Sesijas sīkdatnes</strong> — līdz to derīguma
				beigām (pēc noklusējuma 24 stundas) vai līdz izrakstāties.
			</li>
			<li>
				<strong>Reversā starpniekservera piekļuves žurnāli</strong> —
				līdz 90 dienām, pēc tam apkopoti vai dzēsti.
			</li>
			<li>
				<strong>Pakalpojumu žurnāli</strong> — tas, ko KIFF
				pakalpojumi un planque reģistrē darbības laikā: kļūdas un
				pieprasījumi, kuros var būt minēts konts, persona vai
				aģents. 30 dienas, pēc tam dzēsti.
			</li>
			<li>
				<strong>Rezerves kopijas</strong> — KIFF datubāzei katru
				dienu tiek veidota šifrēta rezerves kopija, un katra kopija
				tiek glabāta 7 dienas, tāpēc dzēsts ieraksts no tām pazūd
				7 dienu laikā. tafs un planque krātuves glabā šifrētas
				kopijas noteiktā laika punktā 35 dienas, ko izmanto tikai
				krātuves atjaunošanai pēc kļūmes, tāpēc dzēsts ieraksts no
				tām pazūd 35 dienu laikā.
			</li>
			<li>
				<strong>Tenant audita dati</strong> — tiek glabāti kā
				apstrādātājam saskaņā ar klienta tenant konfigurāciju.
				Pēc noklusējuma: tiek glabāti visu tenant pastāvēšanas
				laiku; tiek dzēsti, dzēšot tenant. Skatīt
				<a href="/security#deletion">/security#deletion</a> (angliski).
			</li>
			<li>
				<strong>Izsaukumi caur KIFF vārteju</strong> — izsaukuma
				argumenti līdz tā nosūtīšanai, atteikšanai vai
				neizdošanās brīdim, pēc tam dzēsti; rīka rezultāts 24
				stundas, pēc tam dzēsts. Lēmuma ieraksts un argumentu
				jaucējvērtība tiek glabāti kā tenant audita dati. Skatīt
				<a href="/security#data-kept">/security#data-kept</a> (angliski).
			</li>
			<li>
				<strong>Lietojums</strong> — par katru izsaukumu caur
				vārteju, kad tas beidzas: kurš aģents to veica, rīks un
				vai tas tika ieskaitīts kā darbība vai bija bez maksas (un
				kāpēc). Par katru taf vai Coach palaišanu, kad tā beidzas:
				taf, kad, kredīti, ko izmantoja tā AI, un vai tie tika
				ieskaitīti vai kāpēc ne. Līdz konta dzēšanai; tas, kas
				tiek paziņots mūsu maksājumu apstrādātājam norēķinu
				vajadzībām, tiek glabāts kopā ar norēķinu ierakstiem.
			</li>
			<li>
				<strong>Aģentu pierakstīšanās savienojumi</strong> — kurš
				aģents, lietotnes nosaukums, kurš to atļāva, kad un tā
				pēdējā izmantošana: kamēr savienojums ir aktīvs, pēc tam
				30 dienas pēc tā beigām (šo laiku tas paliek redzams
				vadības panelī), pēc tam dzēsti kopā ar tā žetoniem un API
				atslēgu. Viss tiek dzēsts kopā ar kontu.
			</li>
			<li>
				<strong>tafs</strong> — ierīces push žetons, līdz
				izrakstāties no lietotnes, noņemat ierīci vai Apple vai
				Google paziņo, ka žetona vairs nav. Ierīces publiskā
				atslēga, nosaukums, platforma un datumi, kamēr to
				izmantojat; kad to izrakstāt, tā tiek atzīmēta kā noņemta
				un glabāta līdz konta dzēšanai, lai KIFF varētu noraidīt
				no tās novēlotu atbildi un parādīt, kura ierīce parakstīja
				agrāko. Piekļuves atslēgas publiskā atslēga, identifikators
				un nosaukums tiek glabāti tāpat kā tās ierīces dati. Dators glabā savu sesiju
				līdz 90 dienām vai līdz izrakstāties. Tas, ko tafs glabā
				jūsu uzņēmumam, tiek glabāts kā apstrādātājam: taf
				palaišanas un tērzēšanas sarunas kopā ar sarunas
				kopsavilkumu (un Setup kopsavilkumu) 30 dienas, tas, ko
				atgriež jūsu rīki, tikai līdz palaišanas beigām
				(tērzēšanas sarunā tas, ko tā tikai nolasīja, tiek glabāts
				šifrēti tās nākamajām ziņām, izmantots, līdz saruna ir
				bijusi neaktīva stundu un ne ilgāk kā četras stundas pēc
				nolasīšanas, pēc tam automātiski dzēsts dažu dienu laikā),
				un tā atmiņas piezīmes līdz
				taf noņemšanai; faili, ko tas piegādā, 30 dienas no palaišanas, kas tos izveidoja, pēc tam automātiski dzēsti dienas laikā vai ātrāk, ja kāds jūsu kontā kādu no tiem dzēš; savienojuma žetons vai atslēga planque vai pārvaldīta savienojuma pierakstīšanās Composio, līdz to atvienojat (ja cits jūsu savienojums var izmantot to pašu kontu pie šī piegādātāja, tas tiek glabāts neizmantots, līdz arī tas tiek atvienots), un tā apstiprinājumu ieraksts
				līdz konta beigām; skatīt
				<a href="/legal/dpa#annex-4">DPA 4. pielikumu</a> (angliski).
			</li>
			<li>
				<strong>Norēķinu ieraksti</strong> — 7 gadi no finanšu
				gada beigām (Igaunijas Grāmatvedības likuma 12. pants).
			</li>
			<li>
				<strong>App Store un Google Play pirkumi</strong> — tas,
				ko Apple vai Google mums paziņoja par katru pirkumu,
				paliek jūsu kontā līdz konta dzēšanai. To pārdošanas un
				izmaksu pārskati, ko glabājam kā norēķinu ierakstus 7
				gadus, jūs nenosauc.
			</li>
			<li>
				<strong>Atbalsta sarakste</strong> — 3 gadi no pēdējās
				saziņas, pēc tam dzēsta.
			</li>
		</ul>
	</section>
}

templ privacyRightsLV() {
	<section id="rights">
		<h2>9. Jūsu tiesības</h2>
		<p>
			Saskaņā ar VDAR jums ir šādas tiesības attiecībā uz jūsu
			personas datiem:
		</p>
		<ul>
			<li><strong>Piekļuve</strong> (15. pants) — apstiprinājums, vai mēs apstrādājam jūsu datus, un to kopija.</li>
			<li><strong>Labošana</strong> (16. pants) — neprecīzu vai nepilnīgu datu labošana.</li>
			<li><strong>Dzēšana</strong> (17. pants) — jūsu datu dzēšana, ievērojot juridiskās glabāšanas izņēmumus.</li>
			<li><strong>Ierobežošana</strong> (18. pants) — apstrādes apturēšana, kamēr tiek risināts strīds.</li>
			<li><strong>Pārnesamība</strong> (20. pants) — jūsu sniegto datu eksports mašīnlasāmā formātā.</li>
			<li><strong>Iebildumi</strong> (21. pants) — pret apstrādi, kas balstīta uz leģitīmajām interesēm; mēs to pārtraucam, ja vien nevaram pierādīt pārliecinošus pamatus, kas ir svarīgāki.</li>
			<li><strong>Piekrišanas atsaukšana</strong> (7. panta 3. punkts) — jebkurai apstrādei, kas balstīta uz piekrišanu, piemēram, AI lietotnē tafs (sadaļā Konts, kā <a href="#ai-in-tafs">iepriekš</a>). Atsaukšana neietekmē iepriekšējo likumīgo apstrādi.</li>
		</ul>
		<p>
			Lai izmantotu jebkuras no šīm tiesībām, rakstiet uz
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
			Mēs atbildam bez nepamatotas kavēšanās un ne vēlāk kā viena mēneša laikā saskaņā ar 12. panta
			3. punktu; sarežģītu pieprasījumu gadījumā mēs varam šo
			termiņu pagarināt vēl par diviem mēnešiem un jums par to
			paziņosim.
		</p>
		<h3 id="export-chats">Jūsu pašu tafs tērzēšanas sarunas</h3>
		<p>
			Lietotnē tafs sadaļa Konts → Eksportēt manas sarunas
			lejupielādē jūsu pašu tērzēšanas sarunas ar katru taf,
			ieskaitot Coach, jūsu pievienoto failu nosaukumus un jūsu
			pašu piezīmes, kā lasāmu failu un kā JSON. Tās varat
			eksportēt tikai jūs: administrators vai konta īpašnieks to
			nevar, un KIFF konta eksportā tās nav iekļautas.
		</p>
		<h3 id="delete-account">tafs konta dzēšana</h3>
		<p>
			tafs ir KIFF lietotne. Lai dzēstu savu tafs kontu un tā
			datus:
		</p>
		<ol>
			<li>Atveriet lietotni tafs un pierakstieties.</li>
			<li>Atveriet sadaļu Konts un pieskarieties <em>Dzēst kontu</em>.</li>
			<li>Apstipriniet. Konta dzēšana ir neatgriezeniska.</li>
		</ol>
		<p>
			<em>Dzēst kontu</em> tiek rādīts tam, kurš drīkst dzēst
			uzņēmuma kontu, parasti tā īpašniekam. Ja to neredzat vai
			jums vairs nav lietotnes, rakstiet uz
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			no adreses, ar kuru pierakstāties, un mēs dzēsīsim jūsu datus bez nepamatotas kavēšanās un ne vēlāk kā viena mēneša laikā.
		</p>
		<p>
			Kas tiek dzēsts: konta atslēgas nekavējoties pārstāj
			darboties. Tā taf, tērzēšanas sarunas, piezīmes,
			pievienotie faili un savienojumi tiek nekavējoties dzēsti,
			un no to kopijām noteiktā laika punktā 35 dienu laikā. Tas,
			ko KIFF glabā par kontu, tiek dzēsts 30 dienu laikā, un no
			rezerves kopijām 7 dienu laikā pēc tam. Pakalpojumu
			žurnāli, kuros minēts konts, pazūd 30 dienu laikā. Tenant
			audita dati tiek dzēsti kopā ar tenant. Katram datu veidam
			skatiet sadaļu <a href="#retention">Glabāšana</a>.
		</p>
		<p id="delete-data">
			Lai dzēstu daļu savu datu un saglabātu kontu: lietotnē
			dzēsiet tērzēšanas sarunu, un tās ziņas un pievienotie
			faili tiek dzēsti kopā ar to; noņemiet taf, un tā
			tērzēšanas sarunas, piezīmes un savienojumi tiek dzēsti
			kopā ar to. Visam citam rakstiet uz
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			un norādiet, ko dzēst. Mēs to izdarām bez nepamatotas kavēšanās un ne vēlāk kā viena mēneša laikā.
		</p>
		<p>
			Jums ir tiesības iesniegt sūdzību uzraudzības iestādei.
			Mūsu vadošā uzraudzības iestāde ir
			<a href="https://www.aki.ee/en" target="_blank" rel="noopener">Igaunijas Datu aizsardzības inspekcija (Andmekaitse Inspektsioon)</a>.
			Jūs varat iesniegt sūdzību arī savas dzīvesvietas
			dalībvalsts uzraudzības iestādei.
		</p>
		<p><strong>Jūsu valsts.</strong> Dažu valstu tiesību akti prasa vairāk, nekā teikts šajā politikā. Ko tie papildina, angļu valodā un attiecīgās valsts valodā, ir lapā <a href="/privacy/countries">Jūsu valsts</a>.</p>
	</section>
}

templ privacyCookiesLV() {
	<section id="cookies">
		<h2>10. Sīkdatnes</h2>
		<p>
			Mēs iestatām trīs sīkdatnes, visas noteikti nepieciešamas,
			pirmās puses, sūtītas tikai pa HTTPS un nenolasāmas lapas
			skriptiem. Saskaņā ar ES e-privātuma noteikumiem tām nav
			nepieciešama piekrišana; mēs tās uzskaitām, lai jūs zinātu,
			ka tās pastāv. Sīkāka informācija ir
			<a href="/cookies">sīkdatņu politikā</a> (angliski).
		</p>
		<ul>
			<li>
				<strong><code>kiff_session</code></strong> — uztur jūs
				pierakstītu. Parakstīta sesijas sīkdatne ar jūsu
				pierakstīšanās identifikatoru, e-pastu un vārdu, kā arī
				pierakstīšanās datiem, ko vadības panelis izmanto jūsu
				vārdā. Iestatīta <code>.kiff.dev</code>. Ilgst 24 stundas
				vai līdz izrakstāties.
			</li>
			<li>
				<strong><code>kiff_flash</code></strong> — nodod
				vienreizēju ziņojumu nākamajai lapai, piemēram, "jūsu
				atslēga ir izveidota". Parakstīta; jauna atslēga tajā
				nekad nav. Iestatīta <code>.kiff.dev</code>. Tiek dzēsta,
				kad nākamā lapa to nolasa, un ilgst ne vairāk kā 5 minūtes.
			</li>
			<li>
				<strong><code>kiff_cb_attempts</code></strong> — skaita,
				cik reižu pierakstīšanās lapa ir pārlādēta, lai apturētu
				pierakstīšanos, kas iestrēgusi ciklā. Tiek sūtīta tikai uz
				šo lapu. Ilgst 5 minūtes un tiek dzēsta, kad
				pierakstīšanās sākas vai izdodas.
			</li>
		</ul>
		<p>
			Mēs neizmantojam analītikas sīkdatnes, reklāmas sīkdatnes
			vai jebkādus trešo pušu izsekotājus. Ja kādreiz tādus
			pievienosim, pirms sīkdatnes iestatīšanas parādīsim
			piekrišanas joslu saskaņā ar e-privātuma noteikumiem un EDAK
			2023. gada vadlīnijām par izsekošanas tehnoloģijām.
		</p>
		<p>
			Ja pierakstāties ar Clerk (mūsu autentifikācijas
			apakšapstrādātāja) starpniecību, Clerk iestata sīkdatnes arī
			savā domēnā (<code>clerk.kiff.dev</code>). Šīs sīkdatnes ir
			nepieciešamas, lai Clerk jūs atpazītu visā pierakstīšanās
			procesā, un uz tām attiecas Clerk privātuma politika, kā arī
			mūsējā. Sīkāka informācija ir apakšapstrādātāju sarakstā.
		</p>
	</section>
}

templ privacySecurityLV() {
	<section id="security">
		<h2>11. Drošība</h2>
		<p>
			Mūsu tehniskie un organizatoriskie drošības pasākumi ir
			aprakstīti lapā <a href="/security">/security</a> (angliski).
			Tie ietver tenant nodalīšanu datubāzes līmenī, TLS 1.2+
			pārsūtīšanas laikā, šifrēšanu glabāšanā ar pārvaldītā
			nodrošinātāja noklusējuma iestatījumiem un piekļuves
			kontroli, kas balstīta uz mazāko privilēģiju principu.
		</p>
		<p>
			Par personas datu aizsardzības pārkāpumu mēs ietekmētajiem
			klientiem paziņojam bez nepamatotas kavēšanās un 72 stundu
			laikā pēc tā apstiprināšanas saskaņā ar VDAR 33. pantu.
			Paziņojumā ir norādīts pārkāpuma raksturs, attiecīgo datu
			subjektu un ierakstu kategorijas un aptuvenais skaits,
			iespējamās sekas un veiktie vai ierosinātie pasākumi.
		</p>
	</section>
}

templ privacyChildrenLV() {
	<section id="children">
		<h2>12. Bērni</h2>
		<p>
			KIFF Cloud ir infrastruktūras produkts izstrādātājiem, kas
			nav paredzēts bērniem. Mēs apzināti nevācam personas datus
			no bērniem, kas jaunāki par 16 gadiem. Ja uzskatāt, ka bērns
			mums ir sniedzis personas datus, sazinieties ar
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>,
			un mēs tos dzēsīsim.
		</p>
	</section>
}

templ privacyAutomatedLV() {
	<section id="automated">
		<h2>13. Automatizēta lēmumu pieņemšana</h2>
		<p>
			KIFF Cloud izpildlaiks pieņem deterministiskus politikas
			lēmumus par datiem, ko sūta mūsu klienti. Tie nav lēmumi
			par jums, kas rada tiesiskas vai līdzīgi būtiskas sekas
			VDAR 22. panta izpratnē; tie ir lēmumi par klienta
			darbībām (naudas atmaksām, pasūtījumiem, ziņām utt.), ko
			izpilda saskaņā ar paša klienta politiku.
		</p>
		<p>
			Klienti, kas izmanto KIFF Cloud, lai pieņemtu lēmumus, kas
			ietekmē viņu pašu galalietotājus, paši atbild par atbilstību
			22. pantam. Mūsu pārvaldības kvītis ir veidotas tā, lai
			sniegtu šiem klientiem audita liecības, kas tiem
			nepieciešamas cilvēka uzraudzības pierādīšanai, bet
			juridiskais pienākums nodrošināt šo uzraudzību ir klientam.
		</p>
	</section>
}

templ privacyChangesLV() {
	<section id="changes">
		<h2>14. Šīs politikas izmaiņas</h2>
		<p>
			Mēs laiku pa laikam varam atjaunināt šo politiku. Par
			būtiskām izmaiņām aktīvajiem klientiem paziņo pa e-pastu
			un ar labi redzamu paziņojumu šajā lapā vismaz 30 dienas.
			Nebūtiskas izmaiņas publicē ar jaunu "pēdējoreiz
			atjaunināta" datumu.
		</p>
	</section>
}

