package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsPrivacyDV is tafs's privacy policy (/tafs/privacy) in Dhivehi, at /dv/tafs/privacy.
// It is a translation of TafsPrivacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Dhivehi has the legal
// texts only, so a link to any other page goes to English and says so.
templ TafsPrivacyDV() {
	@components.LayoutSiteWithMeta("tafs ގެ ޕްރައިވަސީ ސިޔާސަތު", "KIFF ގެ އެޕް tafs، ތިބާ ތިބާގެ Google އެކައުންޓް ގުޅުއްވާއިރު Google އިން ލިބޭ ޑޭޓާ ހިމެނޭ ގޮތަށް، ޕަރސަނަލް ޑޭޓާ ހަންދާނާ ގޮތް.", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · ޕްރައިވަސީ ސިޔާސަތު</p>
				<h1>tafs ގެ ޕްރައިވަސީ ސިޔާސަތު</h1>
				<p class="legal-meta"><strong>ފަހުން އަޚާރު ކުރެވުނީ:</strong> 25 ނޮވެމްބަރު 2026.</p>
				<p class="legal-disclaimer">މި ސިޔާސަތުން ބަޔާންކުރަނީ iPhone، iPad، Android އާއި ކޮމްޕިޔުޓަރުތަކަށް KIFF ގެ އެޕް tafs ޕަރސަނަލް ޑޭޓާ ހަންދާނާ ގޮތެވެ. tafs އަކީ KIFF Cloud ގެ ބައެކެވެ، ފަހެ <a href="/dv/privacy">KIFF ގެ ޕްރައިވަސީ ސިޔާސަތު</a> އެއަށްވެސް، އަދި މި ސަފްހާއިން ނުހިމެނޭ ކޮންމެ ކަމެއްގައިވެސް ހިނގާނެއެވެ. ސުވާލު: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.</p>
			</header>
			<section id="who-we-are">
				<h2>1. އަޅުގަނޑުމެން ކާކުބާ</h2>
				<p>tafs ފޯރުކޮށްދެނީ އެސްޓޯނިޔާގައި ރަޖިސްޓަރީ ކޮށްފައިވާ ޕްރައިވެޓް ލިމިޓެޑް ކުންފުންޏެއް <strong>Kiff Agents OÜ</strong> އިންނެވެ (ރަޖިސްޓްރީ ކޯޑު 17372313، VAT ނަންބަރު EE102924327)، އެ އެޑްރެސް Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, އެސްޓޯނިޔާއެވެ. EU ގެ ޖެނެރަލް ޑޭޓާ ޕްރޮޓެކްޝަން ރެގިއުލޭޝަން (GDPR) އަޅުގަނޑުމެންގެ ޕްރޮސެސިންގއަށް ހިނގައެވެ.</p>
			</section>
			<section id="scope">
				<h2>2. މި ސިޔާސަތުން ހިމެނެނީ ކޮންކަމެއް</h2>
				<p>iPhone، iPad، Android އާއި ކޮމްޕިޔުޓަރުތަކަށް (Mac، Windows އާއި Linux) tafs އެޕް، އަދި އޭގެ ފަހަތުގައިވާ ޚިދުމަތް، ކުންފުންޏެއްގެ ޓޫލްތައް ގުޅުއްވާ Setup އާއި އެ ގުޅުންތައް ބަހައްޓާ planque ހިމެނިގެން. tafs ގައި ކުންފުންޏެއް KIFF Card ތަކުގެ ތެރޭގައި ޢަމަލުކުރާ AI އޭޖެންޓެއް، taf އަކަށް، ކަމެއް ހަވާލުކުރެއެވެ.</p>
			</section>
			<section id="roles">
				<h2>3. އަޅުގަނޑުމެންގެ ދައުރު</h2>
				<p>އަޅުގަނޑުމެން ތިބާގެ އެކައުންޓާއި ލޮގިން ޑޭޓާގެ، އަދި އަޅުގަނޑުމެންގެ އަމިއްލަ ޚިދުމަތުގެ އޮޕަރޭޝަނަލް ޑޭޓާގެ <strong>ކޮންޓްރޯލަރ</strong> ކަމަށް ވެއެވެ. tafs އިން ތިބާގެ ކުންފުންޏަށްޓަކައި ބަހައްޓާ ކަންތައްތަކުގައި ތިބާގެ ކުންފުންޏުގެ ނަމުގައި އަޅުގަނޑުމެން <strong>ޕްރޮސެސަރ</strong> ގެ ގޮތުގައި ޢަމަލުކުރަމެވެ: ކޮންމެ taf އެއްގެ ރަނާތައް، ބަހުސްތައް، ރިޕޯޓްތައް، މެމޯރީ ނޯޓުތައް އަދި އެ ހަވާލުކުރާ ފައިލްތައް. އެ ޑޭޓާގެ ކޮންޓްރޯލަރަކީ ތިބާގެ ކުންފުންޏެވެ، އަދި <a href="/legal/dpa">DPA</a> (އިނގިރޭސިން) އިން އެ ގުޅުން ކޮންޓްރޯލް ކުރެއެވެ.</p>
			</section>
			<section id="data">
				<h2>4. tafs އިން ޖަމާކުރަނީ ކޮންކަމެއް</h2>
				<ul>
					<li><strong>ތިބާގެ އެކައުންޓް:</strong> ތިބާ tafs އަށް ވަންނަނީ ތިބާގެ KIFF އެކައުންޓުންނެވެ. ފޯނެއް ނުވަތަ ޓެބްލެޓެއްގައި އެޕް ތިބާގެ ސެޝަން ޑިވައިސްގެ Keychain ގައި (Android ގައި، އޭގެ އެންކްރިޕްޓް ކޮށްފައިވާ ސްޓޯރޭޖްގައި) ބަހައްޓައެވެ. ކޮމްޕިޔުޓަރެއްގައި އެ ބަހައްޓަނީ ތިބާގެ ޔޫޒަރ އެކައުންޓަށްޓަކައި ސީލްކޮށްގެންނެވެ: Windows ކޮމްޕިޔުޓަރެއްގައި Windows ގެ އަމިއްލަ ޑޭޓާ ރައްކާތެރިކަމުން، Linux ގައި ތިބާގެ keyring ގައި، Mac އެއްގައި އޭގެ Keychain ގައެވެ. ކޮމްޕިޔުޓަރެއްގެ ސެޝަން 90 ދުވަހާ ހަމައަށް ދެމިއޮވެއެވެ.</li>
					<li><strong>ތިބާގެ ޑިވައިސް:</strong> އެޕް ޑިވައިސްއިން ދުވަހަކުވެސް ނުނިކުންނަ ސޮއިކުރާ ކީ އެއް ހަދައެވެ: iPhone، iPad ނުވަތަ Mac އެއްގެ Secure Enclave ގައި، Android ޑިވައިސްގެ Keystore ގައި، ނުވަތަ Windows ކޮމްޕިޔުޓަރެއްގެ TPM ގައެވެ. Linux ގައި، އަދި Secure Enclave ނެތް Mac އެއްގައި، ކީ އަކީ ތިބާގެ keyring ނުވަތަ Keychain ގައި ބަހައްޓާ ސޮފްޓްވެއަރ ކީ އެއް ކަމަށް ވާއިރު، އެ ކޮމްޕިޔުޓަރުން ތިބާއަށް ތިބި ކަންތައްތައް ދައްކާލެވޭނެ އެކަމަކު ރުހުން ދެވޭކަށް ނުވެއެވެ؛ ތިބާ ރުހުން ދެނީ ތިބާގެ ފޯނުގައެވެ{ macSecurityKey("dv") }. TPM ނެތް Windows ކޮމްޕިޔުޓަރަކުން tafs އަށް ވަދެވޭކަށް ނެތެވެ. KIFF ކީގެ ޕަބްލިކް ބައި، ޑިވައިސްގެ ނަމާއި ޕްލެޓްފޯމް، އަދި އެ އިތުރުކުރި އަދި ފަހުން ބޭނުންކުރި ވަގުތު ބަހައްޓައެވެ، އެއީ ހިފެހެއްޓިފައިވާ ކޯލްތަކަށް ތިބާގެ ޖަވާބުތަކާއި ގުޅުންތަކަށް ތިބާގެ ރުހުންތައް ޗެކް ކުރެވޭނެ ގޮތަށެވެ.</li>
					<li><strong>ތިބާގެ ގަޑި:</strong> ގަޑިއަކުން ޕާސްވޯޑަކާ ނުވަތަ ކީއެއް ނުބަހައްޓައެވެ، ތިބާގެ ޕެއާރު ކޮށްފައިވާ ފޯނާ ހަމައެކަނި ވާހަކަދައްކައެވެ، އަދި ދުވަހަކުވެސް ރުހުން ނުދެއެވެ. ތިބާ AI އަށް ހުއްދަ ދިނުމަށް ފަހު، ތިބާ Coach އަށް، ނުވަތަ ތިބާ ހޮވި taf އަށް ބުނާ ވާހަކަ ފޮނުވަނީ ފޯނުމެދުވެރިކޮށް ހަމައެކަނި ޓެކްސްޓެއްގެ ގޮތުގައެވެ. ގަޑީގެ އަމިއްލަ ވާހަކަދެއްކުމުގެ ޚިދުމަތް، Apple ގެ ނުވަތަ Google ގެ، ތިބާގެ ބަސްތައް އެ ޓެކްސްޓަކަށް ބަދަލުކުރެއެވެ. Wear OS ގައި، ތިބާ ވާހަކަ ނިމުމުގެ ކުރިން އެ ހުއްޓިއްޖެނަމަ، ތިބާގެ ފޯނުގެ އަމިއްލަ ރެކޮގްނައިޒަރއިން ފޯނުގައި އެ ކުރެއެވެ. އެކަމަށް ބާރުއަޅުވަން ނުވަތަ ހުއްޓުވަން ނުވަތަ Coach ނުވަތަ taf އެއްގެ ނަމުގައި ފޮނުވަން ޖެހޭނީ ސްކްރީން ލޮކް ނުވަތަ ޕާސްކޯޑު ހުރި ބަލަ އަދި ޢަނބާރު ކުރެވިފައިވާ ހާލަތުގައި ހަމައެކަނި ކަމުގައެވެ. ތިބާ taf އަކަށް ފޮނުވާ ކަމެއް ދަނީ ތިބާ ފޯނުގައި ލިޔުނު ފަދައިން އެ taf ގެ އަމިއްލަ ބަހުސަށެވެ. taf އެއްގެ ބަހުސް، ޢަދަދުތަކާއެކު، ހުޅުވާ ކޮންމެ ފަހަރަކު ފޯނުން ކިޔައެވެ. ގަޑީގައި ބަހައްޓަނީ ތިރީގައިވާ އޭގެ ބައިގައި ބަޔާންކޮށްފައިވާ އެންމެ ފަހުގެ މެސެޖުތައް އެކަނިއެވެ. އެޕްތައް ބަންދުކޮށްފައިވާއިރު، ތިބާގެ ފޯނުން އާ ޖަވާބުތަކާއި މެސެޖުތައް ގަޑިއަށް ފޮނުވަނީ ސިސްޓަމުގެ އަމިއްލަ ފޯނާއި ގަޑީގެ ގުޅުމުންނެވެ (Apple Watch ގައި Apple ގެ، Wear OS ގައި Google Play ގެ ޚިދުމަތުގެ). އެ ގުޅުން އެތަކެތި ފޯނާއި ގަޑީގައި ބަހައްޓަނީ ގަޑިން އެތަކެތި ހިފަންދެން އެކަނިއެވެ. ތިބާގެ ފޯނު ހޭލައްވާ ޕުޝްގައި އެއްވެސް ބަހެއް ނުހުންނާނެއެވެ. ތިބާ ގަޑިއަށް ނުބަލާއިރު އަންނަ ޖަވާބެއް، ނޯޓިފިކޭޝަނެއްގެ ގޮތުގައިވެސް ދައްކައެވެ، ތިބާގެ iPhone އާއި Apple Watch ގައި ނުވަތަ ތިބާގެ Wear OS ގަޑީގައި، އޭގެ ބަސްތަކާއެކު ނަމަވެސް ދުވަހަކުވެސް ޢަދަދެއް ނެތި، އަދި ތިބާ ފޮހެލާންދެން ހުންނާނެއެވެ. ލޮކްކޮށްފައިވާ Wear OS ގަޑީގައި ދައްކަނީ ޖަވާބެއް ތައްޔާރުވެފައިވާކަން އެކަނިއެވެ.</li>
					<li><strong>Apple Watch:</strong> އެ ތިބާގެ taf ތަކާއި އޭގެ ސަފްހާތައް ނުބަހައްޓައި ދައްކައެވެ. އެ ބަހައްޓަނީ ތިބާގެ Inbox، އެ ލޮކުކޮށްފައި ހުރިއިރު ކިޔަން ނުކުޅެދޭ ފައިލެއްގައެވެ: ހިފެހެއްޓިފައިވާ ކޮންމެ ކޯލެއް އޭގެ taf ގެ ނަމާއި އެ އެދޭ ކަމެއްގެ ގޮތުގައި، ދުވަހަކުވެސް ޢަދަދެއް ނޫނެވެ، އަދި ތިބާ ގަޑިން ފޮނުއްވި ކަންތައްތަކަށް Coach ގެ ޖަވާބުތައް، ޓެކްސްޓެއްގެ ގޮތުގައެވެ. ތިބާ ގަޑިއިން ނިކުތްނަމަ، ތިބާ ގަޑިއަށް އަލުން ވަންނަންދެން ތިބާ އެ ކުރި ކަން އެ ބަހައްޓައެވެ. އެ ނޫން ގޮތުން، ގަޑިއަށް ޕާސްކޯޑެއް ނެތްނަމަ އެއްވެސް ކަމެއް ނުބަހައްޓައެވެ. ތިބާ ގަޑިއިން ނިކުތް ވަގުތު ނުވަތަ ތިބާގެ iPhone ނިކުތް ވަގުތު، ނުވަތަ ޕާސްކޯޑެއް ނެތި އެޕް ދެން ހުޅުވާ ނުވަތަ ބަންދުކުރާ ވަގުތު Inbox ފޮހެވެއެވެ. އެ އެއްވެސް ރެކޯޑިންގއެއް ނުކުރެއެވެ، އަދި އެ ދައްކާ އެކަނި ނޮޓިފިކޭޝަންތަކަކީ ތިބާގެ iPhone ގެ ނޮޓިފިކޭޝަންތަކެވެ. ޗެޓެއް އަވަހަށް ހުޅުވޭތޯ، ގަޑީގައި ތިބާ ހުޅުވި 20 ޗެޓާ ހަމައަށް ކޮންމެ ޗެޓެއްގެ އެންމެ ފަހުގެ 30 މެސެޖު، Coach ގެ އާއި ތިބާގެ tafs ގެ، ލިޔުމެއްގެ ގޮތުގައި އެކަނި، އަދި ދުވަހަކުވެސް ޢަދަދެއް ނޫން ގޮތަށް، Inbox ފަދައިން ލޮކްކޮށް ބަހައްޓައެވެ. Inbox ފޮހެވޭއިރު އަދި ޗެޓެއް 30 ދުވަހު ނުހުޅުވާނަމަ އެ ފޮހެވެއެވެ. Coach އަށް ފޮނުވާ މެސެޖެއް ފަހުން ފޮނުވުމަށް ބަހައްޓަވައިފިނަމަ، އެ އެއް މެސެޖު، ލިޔުމުގެ ގޮތުގައި، އިންބޮކްސްގެ ފައިލު ފަދައިން ލޮކްކުރެވިފައިވާ ވަކި ފައިލެއްގައި ބަހައްޓައި، iPhone އަނބުރާ ލިބުމުން ފޮނުވައެވެ. ފޮނުވުމުން، ފޮހެލެއްވުމުން، ތިޔަބައިމީހާ ނުވަތަ iPhone ސައިން އައުޓް ވުމުން، ނުވަތަ ގަޑީގައި ޕާސްކޯޑެއް ނެތިއްޖެނަމަ އެ މެސެޖު ފޮހެލެވެއެވެ.</li>
					<li><strong>Wear OS:</strong> އެ ތިބާގެ އެކައުންޓުގެ އީމެއިލާއި މިއަދުގެ ކެލެންޑަރ ނުބަހައްޓައި ދައްކައެވެ. އެ ސީދާ ހުޅުވުމަށްޓަކައި، ތިބާއަށް ތިބި ކަންތައްތަކުގެ ޢަދަދާއި، ކޮންމެ taf އެއްގެ ނަމާއި އެ ހުއްޓިފައި ނުވަތަ ވަގުތީގޮތުން ހުއްޓިފައިވޭތޯ، އެންކްރިޕްޓް ކޮށް ބަހައްޓައެވެ: ދުވަހަކުވެސް ޢަދަދެއް، ހިފެހެއްޓިފައިވާ ކޯލެއްގެ ތަފްސީލް ނުވަތަ taf އެއްގެ ބަހުސެއް ނޫނެވެ. ތިބާ ނިކުންނަ ވަގުތު، ގަޑި ލޮކު ވާ ނުވަތަ އަތުގެ ކުރިއަށް ނެގޭ ވަގުތު، އަދި 24 ގަޑިއިރުގެ ފަހުން އެ ފޮހެވެއެވެ. އެ ތިބާގެ Inbox ބަހައްޓައެވެ، އެތަނުގައި ކޮންމެ ފޮތިގަނޑަކީ taf އެއްގެ ނަމާއި އެ ބުނާ ކަންތައްތަކެވެ، ދުވަހަކުވެސް ޢަދަދެއް ނޫނެވެ، އަދި ފަހުން ފޮނުވުމަށް ބަހައްޓާފައިވާ މެސެޖެއް، ޓެކްސްޓެއްގެ ގޮތުގައެވެ. ގަޑިން ނުވަތަ ފޯނުން ނިކުތުމުން އެ ހުރިހާ ކަމެއް ފޮހެވެއެވެ. އޭގެ ޓައިލަށްޓަކައި، އެ ތިބާއަށް ތިބި ކަންތައްތަކުގެ ޢަދަދު ބަހައްޓައެވެ، ގަޑި ޢަނބާރު ކުރެވިފައި ހުރިއިރު ހަމައެކަނި ދައްކާ، ތިބާ ނިކުންނަ ވަގުތު، ނުވަތަ ގަޑި ލޮކު ވެފައި ނުވަތަ ސްކްރީން ލޮކެއް ނެތް ވަގުތު ޓައިލް ދެން ދައްކާ ވަގުތު ފޮހެވެއެވެ. ތިބާ ގަޑިން ނިކުތުމަށް ފަހު، ތިބާ އަލުން ވަންނަންދެން ތިބާ އެ ކުރި ކަމުގެ ނޯޓެއް އެ ބަހައްޓައެވެ. ގަޑި ލޮކުވެފައި ނުވަތަ ސްކްރީން ލޮކެއް ނެތް ވަގުތު އެޕް ދެން ހުޅުވާ ނުވަތަ ބަންދުކުރާ ވަގުތުވެސް Inbox ފޮހެވެއެވެ. ފަހުން ފޮނުވުމަށް ބަހައްޓާފައިވާ މެސެޖެއް ތިބާ އެ ފޮނުއްވާ ނުވަތަ ފޮހެލާންދެން ދެމިއޮވެއެވެ، ސަބަބަކީ ތިބާ އެ ފޮނުވުމަށް އެދުނު ސަބަބުންނެވެ. ތިބާ ވާހަކަ ނިމުމުގެ ކުރިން ގަޑީގެ ވާހަކަދެއްކުމުގެ ޚިދުމަތް ހުއްޓިއްޖެނަމަ، ގަޑިއިން ރެކޯޑިންގ ތިބާގެ ފޯނަށް ފޮނުވައެވެ، އެ ފޯނުގައި ޓެކްސްޓަކަށް ބަދަލުކުރެއެވެ، ދުވަހަކުވެސް ސާވަރެއްގައި ނޫނެވެ. ޓެކްސްޓް އެނބުރި އައުމުން ނުވަތަ ތިބާ ކެންސަލް ކުރުމުން، އަދި އެންމެ ގިނައިން 2 މިނިޓުގެ ފަހުން، ރެކޯޑިންގ ދެތަނުން ފޮހެވެއެވެ. ޓެކްސްޓް ހަމައެކަނި Coach އަށް ނުވަތަ ތިބާގެ taf އަށް ކުރިއަށް ދެއެވެ. taf އެއްގެ ނަތީޖާއެއް ތިބާ ދޫކޮށްލާ ނުވަތަ ގަޑިން ނިކުންނަންދެން ގަޑީގެ ނޮޓިފިކޭޝަންތަކުގައި ދެމިއޮވެދާނެއެވެ. ޗެޓެއް އަވަހަށް ހުޅުވޭތޯ، ގަޑީގައި ތިބާ ހުޅުވި 20 ޗެޓާ ހަމައަށް ކޮންމެ ޗެޓެއްގެ އެންމެ ފަހުގެ 30 މެސެޖު، Coach ގެ އާއި ތިބާގެ tafs ގެ، ލިޔުމެއްގެ ގޮތުގައި އެކަނި، އަދި ދުވަހަކުވެސް ޢަދަދެއް ނޫން ގޮތަށް، އެންކްރިޕްޓްކޮށް ބަހައްޓައެވެ. ގަޑީގައި ނުވަތަ ފޯނުގައި ސައިން އައުޓް ކުރާއިރު އަދި ޗެޓެއް 30 ދުވަހު ނުހުޅުވާނަމަ އެ ފޮހެވެއެވެ. ސްކްރީން ލޮކެއް ނެތް ގަޑީގައި އެއްވެސް ޗެޓެއް ނުބަހައްޓައެވެ. ފަހުން ފޮނުވުމަށް ބެހެއްޓި މެސެޖު، ގަޑީގައި ސްކްރީން ލޮކެއް ނެތިއްޖެނަމަ ވެސް ފޮހެލެވެއެވެ.</li>
					<li><strong>ޕާސްކީ (Passkeys):</strong> ތިބާ ތިބާގެ ކޮމްޕިޔުޓަރުގައި Windows Hello ނުވަތަ ރައްކާތެރިކަމުގެ ކީއެއް ފަދަ passkey އަކުން ރުހުން ދެއްވާއިރު، ތިބާގެ މޫނާއި އަދި އިނގިލީގެ ދަލީލާއި PIN ކޮމްޕިޔުޓަރުގެ އަމިއްލަ ސިސްޓަމާއެކު ދެމިއޮވެއެވެ. KIFF passkey ގެ ޕަބްލިކް ކީ، އޭގެ id، ކައުންޓަރެއް އަދި ނަމެއް ބަހައްޓައެވެ، ދުވަހަކުވެސް ސިއްރު އެއްޗެއް ނޫނެވެ، އަދި އެހެން ޑިވައިސްތަކާ ސިންކް ވާ passkey އެއް ބާތިލް ކުރެއެވެ.</li>
					<li><strong>އެލާޓްތައް:</strong> ފޯނެއް، ޓެބްލެޓެއް ނުވަތަ iPad އެޕް ހިންގާ Mac އެއްގައި، ތިބާ އެ ހުޅުވާލުމުން، އަޅުގަނޑުމެން ޑިވައިސްގެ push token ތިބާގެ KIFF ޕާސަން id އާއި އެޕް ދެއްކި ބަހާއެކު ބަހައްޓަމެވެ. އެލާޓެއް Apple ނުވަތަ Google މެދުވެރިކޮށް ދަނީ ކޮން taf އެއްތޯއާއި އެ ބޭނުންވާ ކަމާއެކު ހަމައެކަނި، އަދި ދޮރުގެ އެލާޓެއްގައި ލިޔި މީހާގެ ނަމާއި ނުވަތަ އީމެއިލް އެޑްރެސް: ދުވަހަކުވެސް ޢަދަދެއް ނުވަތަ އެދުމުގެ ތަފްސީލެއް ނޫނެވެ. އެޕް އެ ކަންތައްތައް އިތުރުކުރަނީ ޑިވައިސްގައިމެވެ، KIFF އިންނެވެ، ފަހެ ޢަނބާރު ނުކުރެވިފައިވާ ފޯނެއްގެ އެލާޓެއްގައި ޢަދަދެއް، ވިޔަފާރިވެރިއެއް ނުވަތަ މީހެއް ދައްކައިދެވިދާނެއެވެ. ލޮކު ކުރެވިފައިވާ Android ފޯނެއްގައި އެ ދައްކަނީ "taf އަކަށް ތިބާ ބޭނުންވޭ" ހަމައެކަނި ކަމުގައި ވާއިރު، ލޮކު ކުރެވިފައިވާ iPhone އެއްގައިވެސް އެގޮތަށެވެ، ތިބާ އޭގެ ޕްރިވިއުތައް ހަމައިން ދައްކަން ސެޓްކޮށްފައި ނުވާނަމައެވެ. Windows ކޮމްޕިޔުޓަރެއްގައި، Linux ކޮމްޕިޔުޓަރެއްގައި ނުވަތަ macOS 12 އެޕް ހުރި Mac އެއްގައި، އެލާޓްތައް އުފައްދަނީ އެޕް ހިނގަމުންދާއިރު އެޕް އަމިއްލައަށް ކަމުގައި ވާއިރު، push token ނެތި އަދި އެހެން ކުންފުންޏެއް މެދުވެރި ނުކޮށެވެ. Windows އާއި Linux ގައި އެ ދައްކަނީ ކޮން taf އެއްތޯއާއި، އެ ކުރަން ބޭނުންވާ ކަމާއި، ޢަދަދާއި، ކީއްވެގެންނާއި، ކޮންހާ ވަގުތެއް ހަމައަށްތޯއެވެ؛ macOS 12 އެޕްގައި ތިބާ އެ ހުޅުވާލުމަށް ފަހު ކޯލުގެ ގޮތުން KIFF ގެ ބަސްތައް ދައްކައެވެ، އަދި ލޮކު ކުރެވިފައިވާ ސްކްރީންއެއް Mac ގެ ޕްރިވިއު ސެޓިންގ ހުއްދަ ދޭ ކަންތައްތައް ދައްކައެވެ. Windows ގައި އެ ތިބާ ހުޅުވާލަންދެން ބަންދުކޮށްގެންވެއެވެ، އަދި ސްކްރީން ލޮކުކޮށްފައި ހުރިއިރު ދައްކަނީ "taf އަކަށް ތިބާ ބޭނުންވޭ" ހަމައެކަނި ކަމުގައެވެ. ސްކްރީން ލޮކުވުމުގެ ކުރިން ދައްކާފައިވާ އެއްޗެއް އޭގެ ތަފްސީލް Windows ގެ ނޮޓިފިކޭޝަން ލިސްޓްގައި ބަހައްޓައެވެ. Linux ގައި އެ ތިބާ ބަންދުކުރަންދެން ހުޅުވިފައި އޮވެއެވެ، އަދި ލޮކު ކުރެވިފައިވާ ސްކްރީނެއް ދައްކާ ކަންތައްތައް ތިބާގެ ޑެސްކްޓޮޕް އަށް ބަރޯސާވެއެވެ. ގަޑިއަކަށް އަޕްޑޭޓްތައް ފޮނުވާ ފޯނެއް، އެލާޓްތައް ނިއްވާފައި ވިޔަސް، އޭގެ push token ރަޖިސްޓަރީ ކޮށްފައި ބަހައްޓާނެ، ހަމައެކަނި ހަޑު push އަކަށް އެ ފޯނު ހޭލައްވައި އަޕްޑޭޓްތައް ގަޑިއަށް ފޮނުވޭތޯއެވެ؛ އެ push ގައި އެއްވެސް ބަހެއް ނުހިމެނޭ އަދި އެއްވެސް އެއްޗެއް ނުދައްކާ.</li>
					<li><strong>ބަސް:</strong> tafs ގެ ޚިދުމަތުން އެކައުންޓުގެ ބަސް، ފަހުން Coach އާއެކު ވާހަކަދެއްކި މީހާގެ ގާތުން، ތިން މަސްދުވަހާ ހަމައަށް ބަހައްޓައެވެ، ފަހެ taf އެއްގެ ރިޕޯޓްތައް އެ ބަހުން އަންނާނެއެވެ.</li>
					<li><strong>ތިބާގެ ޓޫލްތައް:</strong> ތިބާ ޓޫލެއް ގުޅުއްވާއިރު، ތިބާ ވަންނަނީ ޓޫލުގެ އަމިއްލަ ފޯރުކޮށްދޭ ފަރާތުގައެވެ. Stripe ފަދަ planque އަމިއްލައަށް ވަންނަ އެޕެއްގެ ގޮތުން، ނުވަތަ ތިބާ ދޭ ކީއެއްގެ ގޮތުން، planque އެ token ނުވަތަ ކީ ތިބާގެ ކުންފުންޏަށްޓަކައި އެންކްރިޕްޓް ކޮށް ބަހައްޓައެވެ. މެނޭޖް ކުރެވޭ ގުޅުމެއްގެ ގޮތުން، planque އާއެކު މަސައްކަތްކުރާ ގުޅުމުގެ ޚިދުމަތް Composio ލޮގިން ބަހައްޓައެވެ، އަދި planque ބަހައްޓަނީ ގުޅުމުގެ ރެކޯޑާއި ތިބާ ރުހުން ދެއްވި ޓޫލްތައް ހަމައެކަނި (ބަލާށެވެ <a href="#google">Google ޔޫޒަރ ޑޭޓާ</a>). ގުޅުމެއްގެ ރެކޯޑްގައި އެ ވަދެފައިވާ އެކައުންޓް (އޭގެ ނަމާ ނުވަތަ އީމެއިލް) ހިމެނިދާނެއެވެ، ފަހެ އެޕަށް ތިބާއަށް ކޮންދެއްތޯ ދައްކާލެވޭނެއެވެ. KIFF މެނޭޖް ކުރެވޭ ގުޅުންތައް ބޭނުންކުރަނީ <a href="/subprocessors#composio">/subprocessors</a> (އިނގިރޭސިން) ގައި ނަންދީފައިވާ އެޕްތަކަށް ހަމައެކަނި ކަމުގައެވެ.</li>
					<li><strong>ތިޔަބައިމީހާގެ ބްރައުޒަރު (Chrome):</strong> ތިޔަބައިމީހާ tafs އެކްސްޓެންޝަން ފޯނާއެކު ޕެއާ ކުރާއިރު، ޓާފަކަށް ތިޔަބައިމީހާ ޕެއާ ކުރި Chrome ޕްރޮފައިލްގައި، އޭގެ ކަނެކްޝަނުގައި ލިސްޓްކޮށްފައިވާ ސައިޓުތަކުގައި އެކަނި މަސައްކަތް ކުރެވިދާނެއެވެ. އެއީ އަމިއްލަ ޓެބުތައް ތިޔަބައިމީހާއަށް ދެކެވޭ، ޕޯޒް ނުވަތަ ހުއްޓުވޭނެ ޓެބް ގްރޫޕެއްގައި ހުޅުވާ، އެއިން އެއްޗަކަށް ތިޔަބައިމީހާ ޓަޗް ކޮށްލުމުން ޕޯޒްވެއެވެ. އެކްސްޓެންޝަންގެ ސައިޑް ޕެނަލުން ތިބާ ފަށާ taf އެއް، އެ ވިންޑޯގައި ތިބާ ހުރި ޓެބް، އޭގެ ކަނެކްޝަނުގެ ސައިޓަކަށް ވާނަމަ، އެ ޓެބުގައި މަސައްކަތް ކުރެއެވެ. ޓެބް އޭގެ ގްރޫޕަށް ވަދެ އޭގެ އަމިއްލަ ޓެބެއްގެ ގޮތުގައި ބެލެވޭއިރު، taf ހުއްޓުމުން ޓެބް ހުޅުވިފައި ހުންނާނެއެވެ. އެ ޓެބާ ގުޅެނީ، އެ ސަފްޙާއަކީ އެއަށް ބޭނުންވާ ފުރަތަމަ ސަފްޙާ ކަމުގައިވާނަމަ އެކަނިއެވެ. އެތާނގައި އެއަށް ކްލިކް ކުރުމާއި ލިޔުން ކުރެވޭނީ، އޭގެ އަމިއްލަ ސައިޓްތަކުގައި އެކަނިއެވެ. އެ ޓެބުގައި ސަފްޙާ ހުރި ތަނުގައި ކިޔައި، އެހެން ކޮންމެ ސަފްޙާއެއް އޭގެ އަމިއްލަ ޓެބެއްގައި ހުޅުވައެވެ. ތިބާގެ ޓެބް ބަދަލުކުރެވޭނީ، ކްލިކެއް ފަދަ، އެތާނގައި އެ އަޅާ ފިޔަވަޅަކުން އެކަނި، އަދި އޭގެ ސައިޓްތަކުގެ ތެރޭގައި އެކަނިއެވެ. އެ ޕޭޖުތައް ކިޔަނީ ޓެކްސްޓާއި ފޯމް ފީލްޑްތަކެއްގެ ގޮތުގައި، ޕާސްވޯޑް، ކާޑު އަދި ކޯޑު ފީލްޑްތައް ނަގައިފައި، ތިޔަބައިމީހާގެ އެހެން ޓެބުތަކާއި އެހެން ސައިޓުތައް ދުވަހަކުވެސް ނުކިޔާ. އެ ޓެކްސްޓް ރަނގެ ބައެއްގެ ގޮތުގައި އަޅުގަނޑުމެންގެ AI ޕްރޮވައިޑަރަށް ގޮސް، ޓޫލެއްގެ ނަތީޖާ ފަދައިން ރަނާއެކު ބެހެއްޓެއެވެ. ކޮންމެ ފިޔަވަޅެއް ސައިޓާއި ފީލްޑްގެ ނަމާއެކު ރެކޯޑަށް ވެއްދޭ، ސިއްރު ފީލްޑެއްގައި ޓައިޕް ކުރި އެއްޗެއް ދުވަހަކުވެސް ނުވެއްދޭ. ޓާފް ކުރާ ކޮންމެ ބަދަލަކަށްޓަކައި، KIFF އެ ފީލްޑްތައް ނަގައިފައިވާ ޓެކްސްޓެއްގެ ގޮތުގައި، ކުރިން އާއި ފަހުގެ ޕޭޖު 30 ދުވަހަށްވުރެ ގިނަ ނުވާގޮތަށް ބަހައްޓައި، ތިޔަބައިމީހާ ޑިސްކަނެކްޓް ކުރުމުން ނުވަތަ އެކައުންޓް ޑިލީޓް ކުރުމުން އެއަށްވުރެ އަވަހަކަށް ޑިލީޓް ކުރެއެވެ. މި ޕޭޖުތަކުން ތިޔަބައިމީހާގެ ކަސްޓަމަރުން ފަދަ އެހެން މީހުންގެ ތަފްސީލު ދައްކާނެއެވެ؛ KIFF އެ ތަފްސީލު ތިޔަބައިމީހާއަށްޓަކައި ޕްރޮސެސަރެއްގެ ގޮތުގައި ޕްރޮސެސް ކުރެއެވެ. އެކްސްޓެންޝަނުން ތިޔަބައިމީހާގެ ކޮމްޕިއުޓަރުގައި ބަހައްޓަނީ އޭގެ އަމިއްލަ ކީ، KIFF ގެ ސެޝަން، އަދި އެތާނގައި ފެށި Coach ޗެޓުތަކުގެ ލިސްޓު، ދުވަހަކުވެސް ތިޔަބައިމީހާގެ ޕާސްވޯޑެއް ނޫނެވެ: ސައިން އިން ޕޭޖަކަށް ދިޔުމުން، taf ހުއްޓި، ތިޔަބައިމީހާގެ އަމިއްލަ ޓެބުގައި ތިޔަބައިމީހާ އަމިއްލައަށް ސައިން އިން ކުރެއްވުމަށް އެދެއެވެ. އެކްސްޓެންޝަނުގެ ސައިޑް ޕެނަލުން ވެސް Coach އާ ވާހަކަ ދެއްކެވިދާނެއެވެ. Coach ޕޭޖު ކިޔަނީ ހަމައެކަނި ތިބާ އެކްސްޓެންޝަނުގައި ހުއްދަ ދެއްވުމުންނެވެ. އެއީ ވަކި ރުހުމެއް، އެތަނުން ރުހުން ބާޠިލު ކުރެވޭނެއެވެ. އަދި ކޮންމެ ވަގުތަކު ޕޭޖު ނުލާ މެސެޖެއް ފޮނުވިދާނެއެވެ. އެތަނުން މެސެޖެއް ފޮނުއްވާއިރު، ކުރިމަތީގައިވާ ޕޭޖުގެ ފެންނަ ލިޔުން އެކަނި އެ މެސެޖާއެކު ދެއެވެ. ތިޔަބައިމީހާ ޖެއްސެވި އެއްވެސް އެއްޗެއް ނުދެއެވެ. ނަމަވެސް ބޭންކް، ފައިސާ ދެއްކުމުގެ، މެއިލް ނުވަތަ ސިއްހީ ސައިޓެއްގައި، ނުވަތަ Coach އަށް ތިޔަބައިމީހާ ނިއްވާލާފައިވާ ސައިޓެއްގައި ނުދެއެވެ. ފީލްޑުތަކުގެ އަގުތަކާއި ޕާސްވޯޑުތައް ނުކިޔައެވެ. ކާޑު ނަންބަރުތައް ކުރުކުރަނީ ފަހު ހަތަރު ޑިޖިޓަށެވެ. ކީތަކާއި ނަން ޖަހާފައިވާ ސިއްރުތައް ފޮރުވައެވެ. ޕޭޖުގެ ލިޔުމުގައި އިނގިރޭސި، ފަރަންސޭސި، ސްޕެނިޝް ނުވަތަ ޖަރުމަން ބަހުން އެގޮތަށް ނަން ކިޔާފައިވާ އެއްފަހަރު ބޭނުންކުރާ ކޯޑުތައްވެސް ފޮރުވައެވެ. އެއީ އެ މެސެޖަށް އެކަނި އަހަރެމެންގެ AI ފޯރުކޮށްދޭ ފަރާތަށް ދާ ތަކެއްޗެވެ. ޖަވާބު ނިމެންދެން އެކަނި tafs އިން ޕޭޖު ބަހައްޓައި، ސައިޓުގެ ނަން “ކިޔަނީ:” ގެ ގޮތުގައި ތިޔަބައިމީހާގެ ޗެޓާއެކު 30 ދުވަހު ބަހައްޓައެވެ. Coach ގެ ޖަވާބުގައި ޕޭޖުން ނަގާ ބަސް ހިމެނިދާނެ ކަމަށާއި، އެއީ އެހެން ކޮންމެ ޖަވާބެއް ފަދައިން ތިޔަބައިމީހާގެ ޗެޓާއެކު ބަހައްޓާ ތަކެއްޗެވެ. އެތަނުން taf އަކަށް ފޮނުވާ މެސެޖަށްވެސް މިއީ އެގޮތެވެ، އެ އެއްބަސްވުމާއެކު، ނަމަވެސް އެ taf ގެ އަމިއްލަ ސައިޓަކުން އެކަނި: އެހެން ތަނެއްގައި އެއްވެސް އެއްޗެއް ނުކިޔައެވެ، އެ ބުރުގައި taf ކިޔަނީ އެކަނި، އަދި އޭގެ ޖަވާބުގައި ސަފްޙާއިން ނަކަލު ކުރެވިދާނެއެވެ. taf އެއްގެ ހާލަތުގައި، ސަފްޙާގެ ލިޔުން އޭގެ ރަނާއެކު ރައްކާކުރެވެނީ އެ ރަން ނިމެންދެން އެކަނިއެވެ. ސައިޑް ޕެނަލުގައި ދައްކަނީ އެ Chrome ޕެއާ ކުރެއްވިފަހުން އެ Chrome ގައި ފެށި ޗެޓުތަކެވެ. ތިޔަބައިމީހާގެ އެހެން ޗެޓުތައް ހުންނާނީ ފޯނާއި އެހެން ޑިވައިސްތަކުގައެވެ. އެހެން ޑިވައިސްއަކުން ފޮނުވި މެސެޖަކަށް ޓާފެއް އެ Chrome ގައި މަސައްކަތް ކުރާނަމަ، ޕެނަލުގައި އެ ރަން ވެސް ދައްކާނެއެވެ: އެ މެސެޖާއި، އޭގެ ސްޓެޕްތަކާއި ޖަވާބު، އެ ޗެޓުގެ ބާކީ ބައެއް ނޫން، އެ ޗެޓު ފޮހެލައްވާ، Chrome ގެ ޕެއާ ކުރުން ނައްތާލައްވާ، ނުވަތަ ޓާފު އެހެން Chrome އަކަށް ބަދަލުކުރައްވާހާ ހިނދަކު. އެތަނުން މެސެޖަކާ ފައިލުވެސް ގުޅުވިދާނެއެވެ. tafs އެޕްތަކުގައި ގުޅުވާ ފައިލުތަކެއް ފަދައިން، އެ ފައިލުތައް އެ މެސެޖާއެކު އަހަރެމެންގެ AI ފޯރުކޮށްދޭ ފަރާތަށް ދެއެވެ. އަދި އެ މެސެޖާއެކު 30 ދުވަހު، ނުވަތަ ޗެޓް ފޮހެލައިފިނަމަ އެއަށްވުރެ ކުރިން ބަހައްޓައެވެ (އެއްވެސް މެސެޖެއް ބޭނުން ނުކުރާ ފައިލެއް ގާތްގަނޑަކަށް އެއް ގަޑިއިރު). ފައިލެއް ހުޅުވޭނީ އެ ފައިލު ގުޅުވި މީހާއަށް އެކަނިއެވެ. އޭގެ އިތުރުން ތިޔަބައިމީހާގެ ފޯނާ ޕެއާ ކުރެވިފައިވާ ގޮތް، Coach އަށް ތިޔަބައިމީހާ ނިއްވާލި ސައިޓުތައް، އަދި މި Chrome ޕްރޮފައިލްގެ ރެންޑަމް އައިޑީއެއް ވެސް ބަހައްޓައެވެ. އެ އައިޑީ ކޮންމެ ޕެއާ ކުރުމަކާއެކު KIFF އަށް ފޮނުވެނީ ތިޔަބައިމީހާގެ ފޯނަށް މި Chrome ދެނެގަނެވޭތޯއެވެ. އަންއިންސްޓޯލް ކުރުމުން ހުރިހާ އެއްޗެއް ޑިލީޓް ވެއެވެ؛ ޕެއާ ނަގާލުމުން އެ އައިޑީއާއި Coach އަށް ނިއްވާލި ސައިޓުތައް ފިޔަވައި ހުރިހާ އެއްޗެއް ޑިލީޓް ވެއެވެ. ތިޔަބައިމީހާގެ ފޯނުން ހުއްދަ ނުދެއްވައި taf އެއް ދުވަހަކުވެސް ފައިސާ ނުދައްކައެވެ. އަމަލު ކުރާ ކޮންމެ ފިޔަވަޅެއްގައި (ކްލިކެއް، ޓައިޕެއް، ފޮނުވުމެއް)، ތިޔަބޭފުޅާ ހުއްދަ ދެއްވި ފިޔަވަޅު ހިމެނޭގޮތުން، އެއީ ރެކޯޑަށްޓަކައި އަމަލުކުރުމުގެ ކުރިން ނެގި ޞަފްޙާގެ ސްކްރީންޝޮޓެއް ވެސް ބަހައްޓައެވެ؛ ކިޔަން ބޭނުންކުރާ ޞަފްޙާއަކަށް ދުވަހަކުވެސް ނޫން، ބޭންކު، ވޯލެޓް، ޕާސްވޯޑް މެނޭޖަރު، ފައިސާ ދެއްކުން، ސިއްހަތު ނުވަތަ ސަރުކާރު ސައިޓެއްގައި ދުވަހަކުވެސް ނޫން، އަދި ނެގުމުގެ ކުރިން ޕާސްވޯޑް، ކާޑް އަދި ކޯޑު ފީލްޑްތައް ފޮރުވާލެވޭނެއެވެ. ކާޑް ނަންބަރެއް ނުވަތަ ކީއެއް ފަދަ ފެންނަ ޓެކްސްޓް ވެސް ކަޅުކުރެވޭނެ، ނަމަވެސް އެހެން ގޮތަކަށް ލިޔެފައިވާ އެއްޗެއް އަދިވެސް ފެންނާނެ. ސްކްރީންޝޮޓްތައް އެ ފިޔަވަޅާ ގުޅުވައިގެން އެންކްރިޕްޓް ކުރެވިފައިވާ ސްޓޯރޭޖެއްގައި 30 ދުވަހު ބެހެއްޓޭނެ، ދެން އޮޓޮމެޓިކުން ޑިލީޓް ކުރެވޭނެއެވެ، ނުވަތަ ކަނެކްޝަން ކަނޑާލުމުން، މި ކްރޯމް ޕެއަރ ކުރުން ބާތިލު ކުރުމުން ނުވަތަ ތިޔަބޭފުޅުންގެ އެކައުންޓް ޑިލީޓް ކުރެވުމުން އެއަށްވުރެ ކުރިން، އަދި އެއީ އަޅުގަނޑުމެންގެ އޭއައި ޕްރޮވައިޑަރަށް ދުވަހަކުވެސް ނުދެއެވެ. ތިޔަބޭފުޅުންނަށް ކޮންމެ އެއްޗެއް taf ގެ އެކްޓިވިޓީގައި އޭގެ ފިޔަވަޅުގެ ދަށުގައި ފެންނާނެއެވެ. tafs އިން ބޭންކް، ވޮލެޓް، ޕާސްވޯޑް މެނޭޖަރ، ޕޭމަންޓް، މެއިލް، ސިއްޙީ އަދި ސަރުކާރުގެ ސައިޓުތައް ދެނެގަންނަނީ ލިސްޓަކުންނާއި އެ ސައިޓުތަކުގެ އެޑްރެހުގައިވާ ބަސްތަކުންނެވެ. އެހެންކަމުން ދެނެނުގަނެވޭ ސައިޓެއް ބަލާނީ އެހެން ކޮންމެ ސައިޓެއް ފަދައިންނެވެ.</li>
					<li><strong>ތިބާގެ taf ތަކުގެ މަސައްކަތް:</strong> ކޮންމެ taf އެއްގެ ރަނާތައް، ބަހުސްތައް، ރިޕޯޓްތައް، މެމޯރީ ނޯޓުތައް އަދި އެ ހަވާލުކުރާ ފައިލްތައް، ޕްރޮސެސަރެއްގެ ގޮތުގައި ބަހައްޓަވާފައިވެއެވެ. ތިބާގެ އެކައުންޓުގައިވާ ހުރިހާ މީހުންނަށް ތިބާގެ taf ތަކުން ހަވާލުކުރާ ފައިލްތައް ފެންނާނެއެވެ.</li>
					<li><strong>ދޮރުތައް:</strong> މީހުންނަށް އީމެއިލް، Slack ނުވަތަ Telegram އިން taf އަކަށް ލިޔުމަށް ދޮރެއް ހުޅުވާއިރު، tafs ޚިދުމަތުން ތިބާ ގުޅާ ކޮންމެ ފޮނުވާ މީހަކު، އެމީހުންގެ އީމެއިލް އެޑްރެސް، Slack މެމްބަރ ID ނުވަތަ Telegram ޔޫޒަރ ID އިން (WhatsApp ދޮރަކަށް ފޯނު ނަންބަރު)، ތިބާ ދޭ ނަމާއެކު، ދޮރު ނުވަތަ taf ފޮހެލާހާ ހިނދަކު ރައްކާކުރެއެވެ. ތިބާ ނުގުޅާ މީހެއްގެ މެސެޖު، ލިޔުނީ ކާކުކަމާއި އޭގައި ބުނާ ގޮތާއެކު، ޓަކިއެއް ގޮތުގައި، އެންމެ ފަހުގެ ޓަކިއަށް ފަހު 30 ދުވަހާ ހަމައަށް ތިބާއަށް އިންތިޒާރުކުރެއެވެ. ގުޅާފައިވާ ފޮނުވާ މީހެއްގެ މެސެޖު taf ގެ ޗެޓަށް ވަދެ، ޗެޓުގެ ބާކީ ބައި ފަދައިން ރައްކާކުރެވެއެވެ. Slack އާއި Telegram އިން މެސެޖުތައް ގެންދަނީ އެ ފަރާތްތަކުގެ އަމިއްލަ ޝަރުތުތަކުގެ ދަށުންނެވެ.</li>
					<li><strong>ގަނެވުންތައް:</strong> Solo އާއި ކްރެޑިޓް ޕެކެޖުތައް ވިއްކަނީ App Store މެދުވެރިކޮށް Apple އިން، ނުވަތަ Google Play ގެ ބިލިންގ މެދުވެރިކޮށް Google އިންނެވެ. އެމީހުން އަޅުގަނޑުމެންނަށް ކިޔައިދެނީ ގަނެވުނު ކަމާއި، ކޮން KIFF އެކައުންޓަކަށްތޯ (ރެންޑަމް id އެއް)، ކޮންވަގުތެއްތޯ، އަދި އެމީހުންގެ ޓްރާންސެކްޝަން ނުވަތަ އޯޑަރ ރެފަރެންސްތަކެވެ. އެމީހުން އަޅުގަނޑުމެންނަށް ތިބާގެ Apple ID ނުވަތަ Google އެކައުންޓް، ނަން، އީމެއިލް އެޑްރެސް ނުވަތަ ކާޑު ނުދެއެވެ.</li>
				</ul>
				<p>އެޕްގައި އެނަލިޓިކްސް ނުވަތަ އިޝްތިހާރު ޓްރެކަރުތައް ނެތެވެ.</p>
			</section>
			<section id="ai">
				<h2>5. tafs ގެ AI</h2>
				<p>tafs އިން Coach އާއި ތިބާގެ taf ތަކަށްޓަކައި Anthropic ގެ Claude AI ބޭނުންކުރެއެވެ. މިކަން އަޅުގަނޑުމެންނަށްޓަކައި ހިންގަނީ Anthropic ނުވަތަ އަޅުގަނޑުމެންގެ ސަބްޕްރޮސެސަރުންގެ ޞަފްޙާގައިވާ ކްލައުޑް ޕްރޮވައިޑަރެކެވެ. އެއީ ކޮންބައެއްކަމާއި ކޮންތާކުކަން އެ ޞަފްޙާގައި ބުނެދެއެވެ. އެއަށް ކަމެއް ދިއުމުގެ ކުރިން އެޕުން ތިބާގެ ގާތުން އަހާލައެވެ.</p>
				<ul>
					<li>އެއަށް ފޮނުވޭ ކަންތައްތައް: ތިބާ Coach އާއި ތިބާގެ taf ތަކަށް ލިޔާ ކަންތައްތައް، ތިބާ އެޓޭޗް ކުރާ ފައިލްތައް، ތިބާގެ ގުޅިފައިވާ އެޕްތަކުން taf އެއް މަސައްކަތް ކުރަމުންދާއިރު އެއަށް އެނބުރި ދޭ ކަންތައްތައް، އަދި Coach އެޕްގައި ތިބާއަށް އެހީތެރިވާ ވަގުތު ތިބާގެ ސްކްރީނުގައި ހުރި ކަންތައްތައް. ތިބާ ޖަވާބެއް ރިޕޯޓު ކުރައްވައިފިނަމަ، KIFF އިން އެ ޖަވާބާއި ތިބާގެ ސަބަބާއި ނޯޓު 180 ދުވަހު، ނުވަތަ ތިބާ އެ ޗެޓު ނުވަތަ އެކައުންޓް ފޮހެލައްވާހާ ހިނދަކު ބަހައްޓާނެއެވެ. KIFF އިން ރިޕޯޓުތައް ކިޔާ ޓީމަށް ވެސް އެތަކެތި އީމެއިލް ކުރާނެއެވެ، އަދި އެ އީމެއިލް ބަހައްޓާނީ KIFF ގެ ސަޕޯޓް މެއިލް ބަހައްޓާ ގޮތަށެވެ.</li>
					<li>Chrome އިން: އެކްސްޓެންޝަނުގެ ސައިޑް ޕެނަލުގައި Coach އަށް ލިޔުއްވާއިރު ކުރިމަތީގައިވާ ޕޭޖު (އެތަނުން ޕޭޖުތައް ކިޔުމުގެ ހުއްދަ Coach އަށް ދެއްވުމުން). އެތަނުން އަމިއްލަ ސައިޓަކުގައި ހުރި taf އަކަށް ލިޔުއްވާއިރުވެސް.</li>
					<li>ދުވަހަކުވެސް ނުފޮނުވޭ ކަންތައްތައް: ތިބާގެ ގުޅިފައިވާ އެޕްތަކުން ބޭނުންކުރާ ޕާސްވޯޑުތަކާއި ކީތައް، ނުވަތަ ތިބާގެ އިނގިލީގެ ދަލީލު.</li>
					<li>މި ހިންގާ ކުންފުނިން މި ބޭނުންކުރަނީ ޖަވާބުދިނުމަށެވެ. އަދި 30 ދުވަހުގެ ތެރޭގައި ފޮހެލައެވެ. ނަމަވެސް އެ ކުންފުނީގެ ބޭނުންކުރުމުގެ ޤަވާޢިދު މުޚާލަފާކުރާކަމަށް ފާހަގަކުރެވިއްޖެނަމަ ނުވަތަ ޤާނޫނުން ރައްކާކުރަން ލާޒިމުކޮށްފިނަމަ އެހެން ނޫނެވެ.</li>
					<li>ތިބާ ހުއްދަ ނުދެއްވަންދެން އެއްވެސް ކަމެއް ނުފޮނުވޭ. ތިބާއަށް އެކައުންޓްގައި އަނބުރާ ނެގޭނެއެވެ.</li>
				</ul>
				<p>ތިބާ އަނބުރާ ނަގާއިރު، Coach އާއި ތިބާގެ taf ތައް ތިބާއަށް ޖަވާބުދިނުން ހުއްޓައެވެ، އަދި ރަނާތައް ތިބާގެ ރުހުމަށް ބަރޯސާވާ taf އެއް ވަގުތީގޮތުން ހުއްޓެއެވެ. ތިބާ ރުހުން ދިން ކަންތައް ދައްކުމަށް، tafs އިން ތިބާ ދޭ ނުވަތަ ބާޠިލުކުރާ ކޮންމެ ރުހުމެއްގެ ރެކޯޑެއް، ކޮން އިރަކު، އަދި އޭގެ ބަސްތަކުގެ ކޮން ވަރޝަނަކަށްކަން، އެންމެ ފަހުން ބަދަލުކުރިފަހުން 10 އަހަރު ބަހައްޓައެވެ. ތިބާގެ އެކައުންޓް ފޮހެލުމުން އެ ރެކޯޑު އެއަށްވުރެ ކުރިން ފޮހެވޭނެއެވެ. ތަފްސީލް <a href="/dv/privacy#ai-in-tafs">KIFF ގެ ޕްރައިވަސީ ސިޔާސަތުގައި</a> ހުއްޓެވެ.</p>
			</section>
