package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsTermsKM is tafs's terms (/tafs/terms) in Khmer, at /km/tafs/terms.
// It is a translation of TafsTerms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Khmer has the legal
// texts only, so a link to any other page goes to English and says so.
templ TafsTermsKM() {
	@components.LayoutSiteWithMeta("លក្ខខណ្ឌរបស់ tafs", "លក្ខខណ្ឌសម្រាប់ tafs ជាកម្មវិធីរបស់ KIFF៖ អ្នកណាផ្តល់ជូន គណនីរបស់អ្នក អ្វីដែល taf ធ្វើ និងរបៀបដែលអ្នកគ្រប់គ្រងវា ការប្រើប្រាស់ដែលអនុញ្ញាត ថ្លៃសេវា ការទទួលខុសត្រូវ និងការបញ្ចប់។", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · លក្ខខណ្ឌ</p>
				<h1>លក្ខខណ្ឌរបស់ tafs</h1>
				<p class="legal-meta"><strong>ធ្វើបច្ចុប្បន្នភាពចុងក្រោយ៖</strong> 21 វិច្ឆិកា 2026។</p>
				<p class="legal-disclaimer">លក្ខខណ្ឌទាំងនេះសម្រាប់ tafs ជាកម្មវិធីរបស់ KIFF សម្រាប់ iPhone, iPad, Android និងកុំព្យូទ័រ ព្រមទាំងសេវាកម្មនៅពីក្រោយវា។ tafs ជាផ្នែកមួយនៃ KIFF Cloud ហើយទំព័រនេះបញ្ជាក់ឡើងវិញនូវអ្វីដែល <a href="/km/terms">លក្ខខណ្ឌសេវាកម្មរបស់ KIFF</a> និយាយអំពីវា ដោយមិនបន្ថែមអ្វីទៅលើវាទេ។ លក្ខខណ្ឌរបស់ KIFF អនុវត្តចំពោះអ្វីដែលទំព័រនេះមិនគ្របដណ្តប់។ សំណួរ៖ <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>។</p>
			</header>
			<section id="provider">
				<h2>1. អ្នកណាផ្តល់ tafs</h2>
				<p>tafs ត្រូវបានផ្តល់ដោយ <strong>Kiff Agents OÜ</strong> ជាក្រុមហ៊ុនឯកជនទទួលខុសត្រូវមានកម្រិតនៅប្រទេសអេស្តូនី (លេខកូដចុះបញ្ជី 17372313) នៅអាសយដ្ឋាន Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, អេស្តូនី។ ដោយបង្កើតគណនី ឬប្រើប្រាស់ tafs តាមរបៀបផ្សេង អ្នកយល់ព្រមតាមលក្ខខណ្ឌទាំងនេះ និងលក្ខខណ្ឌរបស់ KIFF។ ប្រសិនបើអ្នកទទួលយកជំនួសក្រុមហ៊ុនមួយ អ្នកបញ្ជាក់ថាអ្នកមានសិទ្ធិធ្វើឱ្យក្រុមហ៊ុននោះជាប់កាតព្វកិច្ច។</p>
			</section>
			<section id="account">
				<h2>2. គណនីរបស់អ្នក</h2>
				<p>អ្នកចូលទៅ tafs ដោយប្រើគណនី KIFF។ សូមផ្តល់ព័ត៌មានត្រឹមត្រូវ រក្សាអត្តសញ្ញាណចូលរបស់អ្នកជាការសម្ងាត់ ហើយអ្នកទទួលខុសត្រូវចំពោះសកម្មភាពទាំងអស់ក្រោមគណនីរបស់អ្នក និងចំពោះមនុស្សគ្រប់រូបដែលអ្នកអនុញ្ញាតឱ្យចូល។ អ្នកត្រូវមានអាយុយ៉ាងតិច 16 ឆ្នាំ ឬអាយុនៃការយល់ព្រមឌីជីថលនៅកន្លែងដែលអ្នករស់នៅ ណាមួយដែលខ្ពស់ជាង។ អ្នកអាចប្រើ tafs បានតែពីប្រទេស ឬតំបន់ដែល Anthropic ផ្តល់សេវាកម្មផ្ទាល់ខ្លួនរបស់ខ្លួន ដូចដែល <a href="https://www.anthropic.com/supported-countries">Anthropic រាយបញ្ជី</a>៖ មិនមែនសម្រាប់ក្រុមហ៊ុនដែលមានទីស្នាក់ការកណ្តាលនៅក្នុង ឬស្ថិតក្រោមភាគច្រើនជាកម្មសិទ្ធិ ឬការគ្រប់គ្រងរបស់ក្រុមហ៊ុនដែលមានទីស្នាក់ការកណ្តាលនៅក្នុងប្រទេស ឬតំបន់ក្រៅពីបញ្ជីនោះ ហើយមិនមែនប្រសិនបើអ្នក ឬក្រុមហ៊ុនដែលអ្នកប្រើសម្រាប់ ស្ថិតនៅក្រោមទណ្ឌកម្មរបស់សហភាពអឺរ៉ុប អង្គការសហប្រជាជាតិ ឬសហរដ្ឋអាមេរិក (លក្ខខណ្ឌរបស់ KIFF, §4)។</p>
			</section>
			<section id="what-a-taf-does">
				<h2>3. អ្វីដែល taf ធ្វើ</h2>
				<p>នៅក្នុង tafs អ្នកប្រគល់ការងារឱ្យ taf មួយ៖ ជាភ្នាក់ងារ AI ដែលធ្វើការតាមកាលវិភាគជាមួយឧបករណ៍ដែលអ្នកភ្ជាប់ ក្នុងកម្រិត KIFF Card ដែលអ្នកចេញសម្រាប់វា។ Anthropic ផ្តល់ម៉ូដែល AI ដែលវាប្រើ។ Setup ជាភ្នាក់ងារ AI ក្នុង tafs ជួយអ្នកភ្ជាប់ឧបករណ៍ និងរៀបចំ taf ប៉ុន្តែមិនភ្ជាប់អ្វីដោយខ្លួនឯងទេ៖ អ្នកចូលទៅអ្នកផ្តល់សេវារបស់ឧបករណ៍ផ្ទាល់ ហើយអនុម័តនៅលើឧបករណ៍របស់អ្នកនូវការតភ្ជាប់នីមួយៗ ឧបករណ៍ដែល taf អាចប្រើ និង Card របស់វា។</p>
				<p>របាយការណ៍ សារ និងកំណត់ត្រាអង្គចងចាំរបស់ taf ត្រូវបានសរសេរដោយម៉ូដែល AI ហើយអាចមានកំហុស។ សូមពិនិត្យអ្វីដែលសំខាន់មុនពេលពឹងផ្អែកលើវា។ អ្វីៗដែល taf សរសេរទៅកាន់នរណាម្នាក់នៅក្រៅក្រុមហ៊ុនរបស់អ្នក បញ្ជាក់ថាភ្នាក់ងារ AI ជាអ្នកសរសេរ។</p>
			</section>
			<section id="control">
				<h2>4. ការគ្រប់គ្រងរបស់អ្នក៖ Card និងការអនុម័ត</h2>
				<p>taf ទៅដល់ឧបករណ៍របស់អ្នកបានតាមរយៈ KIFF តែប៉ុណ្ណោះ ដែលពិនិត្យការហៅនីមួយៗជាមួយ Card របស់ taf មុនពេលផ្ញើ។ ការហៅក្នុងកម្រិត Card ដែលអ្នកបានចេញ ត្រូវបានធ្វើតាមការណែនាំរបស់អ្នក។ ការហៅក្រៅ Card ត្រូវបានរង់ចាំ ឬបដិសេធ ដូចដែល Card ចែង។ ការហៅដែលត្រូវបានរង់ចាំ ត្រូវបានធ្វើបន្ទាប់ពីអ្នកដែលគណនីរបស់អ្នកអនុញ្ញាតឱ្យឆ្លើយការហៅដែលត្រូវបានរង់ចាំ អនុម័តប៉ុណ្ណោះ។</p>
				<p>អ្នកជ្រើសរើសការងារ និង Card របស់ taf នីមួយៗ ឆ្លើយការហៅដែលត្រូវបានរង់ចាំរបស់វា ហើយធានាថាអ្នកមានសិទ្ធិប្រើឧបករណ៍ និងគណនីដែលអ្នកភ្ជាប់។ អ្នកអាចបញ្ឈប់ taf មួយ ឬទាំងអស់ ផ្អាក taf ដកហូត Card ណាមួយរបស់វា ឬលុបវាចេញ។ ចាប់ពីពេលដែលអ្នកបញ្ឈប់ taf ឬដកហូត Card KIFF មិនអនុញ្ញាតការហៅថ្មីដោយ taf នោះ ឬក្រោម Card នោះទេ។ សំណើដែលបានផ្ញើទៅអ្នកផ្តល់សេវារបស់ឧបករណ៍រួចហើយ អាចនៅតែបញ្ចប់បាន៖ យើងបញ្ឈប់ការហៅថ្មី ប៉ុន្តែមិនអាចទាញយកអ្វីដែលអ្នកផ្តល់សេវាបានធ្វើមកវិញបានទេ។ សូមមើលព័ត៌មានលម្អិតនៅ <a href="/km/terms#tafs">លក្ខខណ្ឌរបស់ KIFF, §3A</a>។</p>
				<p>យោងតាមច្បាប់ AI របស់សហភាពអឺរ៉ុប Kiff Agents OÜ ជាអ្នកផ្តល់ tafs ហើយអ្នកជាអ្នកដាក់ឱ្យប្រើប្រាស់។ ប្រើ tafs សម្រាប់តែការងារដែលវាផ្តល់ជូន ហើយមិនមែនសម្រាប់ការប្រើប្រាស់ណាមួយដែលច្បាប់ AI ហាមឃាត់ ឬចាត់ថ្នាក់ថាមានហានិភ័យខ្ពស់ ដូចជាការសម្រេចចិត្តអំពីការងារ ឥណទាន ឬការទទួលបានសេវាចាំបាច់របស់មនុស្សម្នាក់។</p>
			</section>
			<section id="acceptable-use">
				<h2>5. ការប្រើប្រាស់ដែលអនុញ្ញាត</h2>
				<p>អ្នក បុគ្គលិករបស់អ្នក និង taf របស់អ្នកត្រូវតែអនុវត្តតាម <a href="/acceptable-use">គោលការណ៍ប្រើប្រាស់ដែលអនុញ្ញាត</a> (ជាភាសាអង់គ្លេស)។ សកម្មភាពរបស់ភ្នាក់ងារគឺជាសកម្មភាពរបស់អ្នក។ ក្នុងចំណោមអ្វីផ្សេងទៀត អ្នកមិនអាចប្រើ tafs ដើម្បីបំពានច្បាប់ ធ្វើសកម្មភាពលើប្រព័ន្ធ ឬគណនីដែលអ្នកមិនមានសិទ្ធិប្រើ ភ្ជាប់ឧបករណ៍ជាមួយការចូលដែលមិនមែនជារបស់អ្នកក្នុងការផ្តល់ ផ្ញើសារឥតបានការ ឬគេចពី Card ដែនកំណត់ ឬការរង់ចាំ។ យើងអាចផ្អាកភ្លាមៗនៅពេលមានការបំពានដែលអាចជឿជាក់បាន។</p>
			</section>
			<section id="fees">
				<h2>6. ថ្លៃសេវា</h2>
				<p>នៅពេលធ្វើបច្ចុប្បន្នភាពនេះ Solo មានតម្លៃ { tafsCostKM.money(TafsSoloCents) } ក្នុងមួយខែ រួមបញ្ចូលអាករលើតម្លៃបន្ថែម (VAT) ជាមួយ { tafsCostKM.number(TafsSoloCredits) } ក្រេឌីតក្នុងមួយខែ លក់ក្នុងកម្មវិធីតាមរយៈ App Store ឬ Google Play។ កញ្ចប់ក្រេឌីតដែលទិញក្នុងកម្មវិធី ចាប់ផ្តើមពី { tafsCostKM.money(TafsPackCents[TafsSoloCredits]) }៖ វាមិនផុតកំណត់ទេ។ ការដំណើរការនីមួយៗរបស់ taf ប្រើក្រេឌីតសម្រាប់ AI ដែលវាបានប្រើ។ Coach និងការរៀបចំ taf ត្រូវបានរួមបញ្ចូលក្នុងការប្រើប្រាស់សមរម្យរបស់ Coach។ ទាំងនេះជាតម្លៃនៅតំបន់អឺរ៉ូ។ នៅកន្លែងផ្សេង App Store ឬ Google Play បង្ហាញតម្លៃជារូបិយប័ណ្ណរបស់អ្នក ជាមួយ ឬគ្មានពន្ធក្នុងស្រុកតាមច្បាប់របស់ប្រទេសនោះ ហើយនោះជាតម្លៃដែលអ្នកបង់។ តម្លៃបច្ចុប្បន្នមាននៅ <a href="/pricing">ទំព័រតម្លៃ</a> (ជាភាសាអង់គ្លេស)៖ tafs ក៏ជាផ្នែកមួយនៃផែនការ Company របស់ KIFF ដែរ។</p>
				<p>គ្មានការសាកល្បងទេ។ Solo ដែលទិញក្នុងកម្មវិធីត្រូវបានគ្រប់គ្រង និងលុបចោលនៅក្នុងការជាវ Apple ឬ Google Play របស់អ្នក ក្រោមលក្ខខណ្ឌរបស់ហាងនោះសម្រាប់ការបង់ប្រាក់ ការបន្ត និងការសងប្រាក់វិញ។ ផែនការដំណើរការរហូតដល់ចុងបញ្ចប់នៃរយៈពេលដែលអ្នកបានបង់។ ប្រសិនបើអ្នកជាអ្នកប្រើប្រាស់នៅក្នុងសហភាពអឺរ៉ុប អ្នកអាចដកខ្លួនក្នុងរយៈពេល 14 ថ្ងៃបន្ទាប់ពីការទិញ។ សូមមើលព័ត៌មានលម្អិតនៅ <a href="/km/terms#fees">លក្ខខណ្ឌរបស់ KIFF, §8</a>។</p>
			</section>
			<section id="liability">
				<h2>7. ការទទួលខុសត្រូវ</h2>
				<p>tafs ត្រូវបានផ្តល់ជូន "ដូចដែលវាមាន" និង "ដូចដែលអាចរកបាន" លើកលែងតែការធានានៅក្នុងលក្ខខណ្ឌរបស់ KIFF (§10)។ ក្នុងកម្រិតដែលច្បាប់អនុញ្ញាត ភាគីទាំងពីរមិនទទួលខុសត្រូវចំពោះការខូចខាតដោយប្រយោល ឬជាលទ្ធផលទេ ហើយការទទួលខុសត្រូវសរុបរបស់ភាគីនីមួយៗត្រូវបានកំណត់ដូចដែល <a href="/km/terms#liability">លក្ខខណ្ឌរបស់ KIFF, §12</a> ចែង។ គ្មានអ្វីកំណត់ការទទួលខុសត្រូវដែលច្បាប់មិនអនុញ្ញាតឱ្យកំណត់ទេ។</p>
			</section>
			<section id="termination">
				<h2>8. ការបញ្ចប់</h2>
				<p>អ្នកអាចឈប់បានគ្រប់ពេល៖ លុបគណនីរបស់អ្នកក្នុងកម្មវិធី នៅក្នុង គណនី → <em>លុបគណនី</em>។ សូមនាំចេញការជជែករបស់អ្នកជាមុន ពី គណនី → នាំចេញការជជែករបស់ខ្ញុំ។ យើងអាចបញ្ចប់ការប្រើប្រាស់របស់អ្នកសម្រាប់ការបំពានសំខាន់ដែលមិនត្រូវបានកែតម្រូវក្នុងរយៈពេលសាមសិបថ្ងៃបន្ទាប់ពីការជូនដំណឹង ឬភ្លាមៗសម្រាប់ការបំពានការប្រើប្រាស់ដែលអនុញ្ញាត។ សិទ្ធិរបស់អ្នកក្នុងការចាកចេញ និងយកទិន្នន័យរបស់អ្នកជាមួយមាននៅក្នុង <a href="/km/terms#term">លក្ខខណ្ឌរបស់ KIFF, §9</a>។</p>
			</section>
			<section id="governing-law">
				<h2>9. ការផ្លាស់ប្តូរ និងច្បាប់គ្រប់គ្រង</h2>
				<p>យើងផ្លាស់ប្តូរលក្ខខណ្ឌទាំងនេះតាមរបៀបដែលលក្ខខណ្ឌរបស់ KIFF ចែងសម្រាប់លក្ខខណ្ឌខ្លួនឯង (§16)។ វាស្ថិតក្រោមច្បាប់នៃសាធារណរដ្ឋអេស្តូនី ហើយវិវាទទៅតុលាការខោនធី Harju នៅ Tallinn។ ប្រសិនបើអ្នកជាអ្នកប្រើប្រាស់នៅរដ្ឋសមាជិកសហភាពអឺរ៉ុបផ្សេងទៀត ច្បាប់ការពារអ្នកប្រើប្រាស់ដែលចាំបាច់នៃប្រទេសកំណើតរបស់អ្នកនៅតែអនុវត្ត។</p>
			</section>
			<section id="contact">
				<h2>10. ទំនាក់ទំនង</h2>
				<p>សំណួរអំពីកិច្ចសន្យា៖ <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>។ ជំនួយអំពីកម្មវិធី៖ <a href="mailto:support@kiff.dev">support@kiff.dev</a>។ ឯកជនភាព៖ <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> ហើយរបៀបដែល tafs គ្រប់គ្រងទិន្នន័យផ្ទាល់ខ្លួនមាននៅក្នុង <a href="/km/tafs/privacy">គោលការណ៍ឯកជនភាពរបស់ tafs</a>។</p>
			</section>
		</article>
	}
}
