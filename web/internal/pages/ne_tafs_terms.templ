package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsTermsNE is tafs's terms (/tafs/terms) in Nepali, at /ne/tafs/terms.
// It is a translation of TafsTerms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Nepali has the legal
// texts only, so a link to any other page goes to English and says so.
templ TafsTermsNE() {
	@components.LayoutSiteWithMeta("tafs का सर्तहरू", "KIFF को एप tafs का सर्तहरू: यो को ले उपलब्ध गराउँछ, तपाईंको खाता, taf ले के गर्छ र तपाईंले यसलाई कसरी नियन्त्रण गर्नुहुन्छ, स्वीकार्य प्रयोग, शुल्क, उत्तरदायित्व र समाप्ति।", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · सर्तहरू</p>
				<h1>tafs का सर्तहरू</h1>
				<p class="legal-meta"><strong>पछिल्लो पटक अद्यावधिक:</strong> 21 नोभेम्बर 2026।</p>
				<p class="legal-disclaimer">यी सर्तहरू KIFF को iPhone, iPad, Android र कम्प्युटरका लागि एप tafs र यसको पछाडिको सेवाका लागि हुन्। tafs KIFF Cloud को एक हिस्सा हो, र यो पृष्ठले <a href="/ne/terms">KIFF का सेवाका सर्तहरू</a> ले यसबारे भनेको कुरा दोहोर्‍याउँछ, तिनमा केही थप्दैन। यो पृष्ठले नसमेटेका कुराहरूमा KIFF का सर्तहरू लागू हुन्छन्। प्रश्नहरू: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>।</p>
			</header>
			<section id="provider">
				<h2>1. tafs को उपलब्ध गराउने को हो</h2>
				<p>tafs एस्टोनियामा दर्ता भएको निजी सीमित दायित्व कम्पनी <strong>Kiff Agents OÜ</strong> (दर्ता कोड 17372313) ले उपलब्ध गराउँछ, ठेगाना: Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, एस्टोनिया। खाता बनाएर वा अन्य तरिकाले tafs प्रयोग गरेर तपाईं यी सर्तहरू र KIFF का सर्तहरूमा सहमत हुनुहुन्छ। यदि तपाईं कम्पनीको तर्फबाट स्वीकार गर्दै हुनुहुन्छ भने, तपाईंले त्यसलाई बाध्य गराउन सक्ने अधिकार भएको पुष्टि गर्नुहुन्छ।</p>
			</section>
			<section id="account">
				<h2>2. तपाईंको खाता</h2>
				<p>तपाईं KIFF खाताबाट tafs मा साइन इन गर्नुहुन्छ। सही जानकारी दिनुहोस्, आफ्ना प्रमाणहरू गोप्य राख्नुहोस्, र तपाईंको खाताअन्तर्गत हुने सबै गतिविधि र तपाईंले भित्र पस्न दिएका हरेक व्यक्तिका लागि तपाईं जिम्मेवार हुनुहुन्छ। तपाईं कम्तीमा 16 वर्षको, वा तपाईं बस्ने ठाउँको डिजिटल सहमतिको उमेर पुगेको हुनुपर्छ, जुन बढी हुन्छ। <a href="https://www.anthropic.com/supported-countries">Anthropic ले सूचीबद्ध गरेझैं</a> Anthropic ले आफ्नै सेवा दिने देश वा क्षेत्रबाट मात्र तपाईंले tafs प्रयोग गर्न सक्नुहुन्छ; त्यो सूचीबाहिरको देश वा क्षेत्रमा मुख्यालय भएको, वा त्यस्तो मुख्यालय भएको कम्पनीको बहुमत स्वामित्व वा नियन्त्रणमा रहेको कम्पनीका लागि होइन; र तपाईं, वा तपाईंले जुन कम्पनीका लागि प्रयोग गर्दै हुनुहुन्छ, यूरोपेली संघ, संयुक्त राष्ट्रसंघ वा संयुक्त राज्य अमेरिकाको प्रतिबन्धको अधीनमा हुनुहुन्छ भने होइन (KIFF का सर्तहरू, §4)।</p>
			</section>
			<section id="what-a-taf-does">
				<h2>3. taf ले के गर्छ</h2>
				<p>tafs मा तपाईंले काम एउटा taf लाई सुम्पनुहुन्छ: यो तपाईंले जोडेका औजारहरूसँग तालिकाअनुसार काम गर्ने, तपाईंले यसका लागि जारी गरेका KIFF Card हरूभित्र चल्ने AI एजेन्ट हो। यसले प्रयोग गर्ने AI मोडेल Anthropic ले उपलब्ध गराउँछ। tafs मा AI एजेन्ट Setup ले औजार जोड्न र taf सेट गर्न मद्दत गर्छ, तर आफैं केही जोड्दैन: तपाईं औजारको आफ्नै प्रदायकमा साइन इन गर्नुहुन्छ, र हरेक जडान, taf ले प्रयोग गर्न सक्ने औजारहरू र यसका Card हरू आफ्नो उपकरणमा स्वीकृत गर्नुहुन्छ।</p>
				<p>taf का प्रतिवेदन, सन्देश र मेमोरी नोटहरू AI मोडेलले लेख्छ र गलत हुन सक्छन्। भरोसा गर्नुअघि महत्त्वपूर्ण कुरा जाँच्नुहोस्। Taf ले तपाईंको कम्पनीबाहिरका कसैलाई लेखेको कुनै पनि कुराले AI एजेन्टले लेखेको भनेर बताउँछ।</p>
			</section>
			<section id="control">
				<h2>4. तपाईंको नियन्त्रण: Card र स्वीकृति</h2>
				<p>Taf ले तपाईंका औजारमा KIFF मार्फत मात्र पुग्छ, जसले हरेक कललाई पठाउनुअघि taf का Card हरूसँग जाँच्छ। तपाईंले जारी गरेको Card भित्रको कल तपाईंको निर्देशनमा गरिन्छ। Card बाहिरको कल Card ले भनेअनुसार रोकिन्छ वा अस्वीकार गरिन्छ। रोकिएको कल तपाईंको खाताले रोकिएका कलको जवाफ दिन अनुमति दिएको कसैले स्वीकृत गरेपछि मात्र गरिन्छ।</p>
				<p>तपाईं हरेक taf को काम र Card हरू छान्नुहुन्छ, यसका रोकिएका कलको जवाफ दिनुहुन्छ, र आफूले जोडेका औजार र खाताहरू प्रयोग गर्ने अधिकार छ भनी सुनिश्चित गर्नुहुन्छ। तपाईं एउटा taf वा सबै रोक्न, taf लाई विराम दिन, यसको कुनै पनि Card रद्द गर्न, वा हटाउन सक्नुहुन्छ। तपाईंले taf रोकेको वा Card रद्द गरेको क्षणदेखि KIFF ले त्यो taf वा त्यो Card अन्तर्गत नयाँ कल अनुमति दिँदैन। औजार प्रदायकलाई पहिल्यै पठाइएको अनुरोध पूरा हुन सक्छ: हामी नयाँ कल रोक्छौं, तर प्रदायकले गरिसकेको कुरा फर्काउन सक्दैनौं। विवरण <a href="/ne/terms#tafs">KIFF का सर्तहरू, §3A</a> मा छन्। जब taf ले त्यो साइटमा सुरक्षित गरिएको विधिबाट चेकआउटमा भुक्तानी गर्छ, त्यो Card भित्र मात्र र तपाईंले फोनमा त्यो भुक्तानी स्वीकृत गरेपछि मात्र गर्छ; साइट र त्यसको भुक्तानी प्रदायकले त्यसलाई प्रशोधन गर्छन्, र KIFF र planque ले तपाईंको पैसा कहिल्यै राख्दैनन्, तपाईंको कार्ड विवरण कहिल्यै भण्डारण गर्दैनन्, र taf ले कार्ड नम्बर कहिल्यै टाइप गर्दैन।</p>
				<p>EU को AI ऐनअन्तर्गत Kiff Agents OÜ tafs को प्रदायक हो र तपाईं यसको प्रयोगकर्ता हुनुहुन्छ। tafs केवल यसले प्रस्ताव गर्ने कामहरूका लागि प्रयोग गर्नुहोस्, AI ऐनले निषेध गरेको वा उच्च जोखिम भनी वर्गीकृत गरेको कुनै पनि प्रयोगका लागि होइन, जस्तै कसैको रोजगारी, ऋण वा आवश्यक सेवाहरूमा पहुँचबारे निर्णयहरू।</p>
			</section>
			<section id="acceptable-use">
				<h2>5. स्वीकार्य प्रयोग</h2>
				<p>तपाईं, तपाईंका मानिसहरू र तपाईंका taf हरूले <a href="/acceptable-use">स्वीकार्य प्रयोग नीति</a> (अङ्ग्रेजीमा) पालना गर्नुपर्छ। एजेन्टको कार्य तपाईंको कार्य हो। अन्य कुराहरूका साथै, तपाईंले tafs लाई कानुन उल्लंघन गर्न, प्रयोग गर्ने अधिकार नभएको प्रणाली वा खातामा कार्य गर्न, आफ्नो दिन नमिल्ने साइन इनबाट औजार जोड्न, स्प्याम पठाउन, वा Card, सीमा वा रोकावट छल्न प्रयोग गर्नु हुँदैन। विश्वसनीय उल्लंघनमा हामी तुरुन्तै निलम्बन गर्न सक्छौं।</p>
			</section>
			<section id="fees">
				<h2>6. शुल्क</h2>
				<p>यो अद्यावधिकको समयमा, Solo महिनाको { tafsCostNE.money(TafsSoloCents) } हो, VAT सहित, महिनाको { tafsCostNE.number(TafsSoloCredits) } क्रेडिटसहित, एपमा App Store वा Google Play मार्फत बेचिन्छ। एपमा किनिएका क्रेडिटका प्याकहरू { tafsCostNE.money(TafsPackCents[TafsSoloCredits]) } बाट सुरु हुन्छन्; तिनको म्याद सकिँदैन। Taf को हरेक रनले प्रयोग गरेको AI का लागि क्रेडिट खर्च गर्छ। Coach, र taf सेट गर्ने काम Coach को उचित प्रयोगभित्र समावेश छन्। यी यूरो क्षेत्रका मूल्य हुन्। अन्यत्र, App Store वा Google Play ले तपाईंको मुद्रामा मूल्य देखाउँछ, त्यस देशको नियमले चाहेअनुसार स्थानीय करसहित वा बिना, र त्यो नै तपाईंले तिर्ने मूल्य हो। हालका मूल्य <a href="/pricing">मूल्य पृष्ठ</a> (अङ्ग्रेजीमा) मा छन्; tafs KIFF को Company योजनाको पनि हिस्सा हो।</p>
				<p>कुनै परीक्षण छैन। एपमा किनिएको Solo तपाईंका Apple वा Google Play सदस्यताहरूमा व्यवस्थापन र रद्द गरिन्छ, भुक्तानी, नवीकरण र फिर्ताबारे त्यस स्टोरका सर्तअनुसार। योजना तपाईंले तिरेको अवधिको अन्त्यसम्म चल्छ। यदि तपाईं EU मा उपभोक्ता हुनुहुन्छ भने, खरिदको 14 दिनभित्र फिर्ता लिन सक्नुहुन्छ। विवरण <a href="/ne/terms#fees">KIFF का सर्तहरू, §8</a> मा छन्।</p>
			</section>
			<section id="liability">
				<h2>7. उत्तरदायित्व</h2>
				<p>tafs KIFF का सर्तहरूका ग्यारेन्टी (§10) बाहेक "जस्तो छ त्यस्तै" र "उपलब्ध भएअनुसार" दिइन्छ। कानुनले अनुमति दिएसम्म, कुनै पक्ष अप्रत्यक्ष वा परिणामस्वरूप हानिको लागि उत्तरदायी हुँदैन, र प्रत्येक पक्षको कुल उत्तरदायित्व <a href="/ne/terms#liability">KIFF का सर्तहरू, §12</a> ले भनेअनुसार सीमित छ। कानुनले सीमित गर्न नदिने उत्तरदायित्वलाई कुनै कुराले सीमित गर्दैन।</p>
			</section>
			<section id="termination">
				<h2>8. समाप्ति</h2>
				<p>तपाईं जुनसुकै बेला रोक्न सक्नुहुन्छ: एपमा आफ्नो खाता मेट्नुहोस्, खाता → <em>खाता मेट्नुहोस्</em> मा। पहिले आफ्ना च्याटहरू निर्यात गर्नुहोस्, खाता → मेरा च्याटहरू निर्यात गर्नुहोस् बाट। सूचनाको तीस दिनभित्र निराकरण नगरिएको भौतिक उल्लंघन, वा स्वीकार्य प्रयोगको उल्लंघनमा हामी तुरुन्तै तपाईंको प्रयोग समाप्त गर्न सक्छौं। छोड्ने र आफ्नो डेटा साथमा लैजाने तपाईंको अधिकार <a href="/ne/terms#term">KIFF का सर्तहरू, §9</a> मा छन्।</p>
			</section>
			<section id="governing-law">
				<h2>9. परिवर्तन र लागू हुने कानुन</h2>
				<p>हामी यी सर्तहरू KIFF का सर्तहरूले आफ्नाका लागि भनेको तरिका (§16) ले परिवर्तन गर्छौं। तिनमा एस्टोनिया गणतन्त्रका कानुन लागू हुन्छन्, र विवाद तालिनको हार्जु काउन्टी अदालतमा जान्छन्। यदि तपाईं अर्को EU सदस्य राष्ट्रमा उपभोक्ता हुनुहुन्छ भने, तपाईंको गृह देशका अनिवार्य उपभोक्ता सुरक्षा नियमहरू अझै लागू हुन्छन्।</p>
			</section>
			<section id="contact">
				<h2>10. सम्पर्क</h2>
				<p>सम्झौताबारे प्रश्नहरू: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>। एपसम्बन्धी सहयोग: <a href="mailto:support@kiff.dev">support@kiff.dev</a>। गोपनीयता: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>, र tafs ले व्यक्तिगत डेटा कसरी सम्हाल्छ भन्ने कुरा <a href="/ne/tafs/privacy">tafs को गोपनीयता नीति</a> मा छ।</p>
			</section>
		</article>
	}
}
