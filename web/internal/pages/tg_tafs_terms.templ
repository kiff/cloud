package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsTermsTG is tafs's terms (/tafs/terms) in Tajik, at /tg/tafs/terms.
// It is a translation of TafsTerms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Tajik has the legal
// texts only, so a link to any other page goes to English and says so.
templ TafsTermsTG() {
	@components.LayoutSiteWithMeta("Шартҳои tafs", "Шартҳо барои tafs, барномаи KIFF: кӣ онро пешниҳод мекунад, ҳисоби шумо, taf чӣ кор мекунад ва шумо онро чӣ гуна идора мекунед, истифодаи иҷозатдодашуда, ҳаққӣ хизмат, масъулият ва қатъ.", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · шартҳо</p>
				<h1>Шартҳои tafs</h1>
				<p class="legal-meta"><strong>Навсозии охирин:</strong> 22 ноябри 2026.</p>
				<p class="legal-disclaimer">Ин шартҳо барои tafs, барномаи KIFF барои iPhone, iPad, Android ва компютерҳо, ва хизмати паси он мебошанд. tafs қисми KIFF Cloud аст; ин саҳифа он чиро, ки <a href="/tg/terms">Шартҳои хизматрасонии KIFF</a> дар ин бора мегӯянд, такрор мекунад ва ба онҳо чизе илова намекунад. Шартҳои KIFF ба ҳар чизе, ки ин саҳифа фаро намегирад, татбиқ мешаванд. Саволҳо: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.</p>
			</header>
			<section id="provider">
				<h2>1. tafs-ро кӣ пешниҳод мекунад</h2>
				<p>tafs-ро <strong>Kiff Agents OÜ</strong>, ҷамъияти саҳомии хусусии ба масъулияти маҳдуд дар Эстония (рамзи қайд 17372313), бо суроға Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Эстония пешниҳод мекунад. Бо эҷоди ҳисоб ё ба тарзи дигар истифода бурдани tafs шумо ба ин шартҳо ва ба Шартҳои KIFF розӣ мешавед. Агар шумо аз номи ширкат қабул кунед, тасдиқ мекунед, ки ҳаққи вобастакунии онро доред.</p>
			</section>
			<section id="account">
				<h2>2. Ҳисоби шумо</h2>
				<p>Шумо ба tafs бо ҳисоби KIFF ворид мешавед. Маълумоти дақиқ диҳед, маълумоти воридшавии худро махфӣ нигоҳ доред; шумо барои тамоми фаъолият дар зери ҳисоби худ ва барои ҳар касе, ки ба он роҳ медиҳед, масъул ҳастед. Синни шумо бояд на камтар аз 16 сол ё синни розигии рақамӣ дар ҷои зисти шумо, ҳар кадом, ки бештар аст, бошад. tafs-ро танҳо аз кишвар ё минтақае истифода бурдан мумкин аст, ки Anthropic хизмати худро дар он пешниҳод мекунад, ончунон ки <a href="https://www.anthropic.com/supported-countries">Anthropic онҳоро номбар кардааст</a>; на барои ширкате, ки қароргоҳаш берун аз он рӯйхат аст, ё аксарияти моликият ё назорати он ба ширкате тааллуқ дорад, ки қароргоҳаш берун аз он рӯйхат аст; ва на агар шумо ё ширкате, ки шумо барои он истифода мебаред, ба таҳримҳои Иттиҳоди Аврупо, Созмони Милали Муттаҳид ё Иёлоти Муттаҳида дучор бошед (Шартҳои KIFF, §4).</p>
			</section>
			<section id="what-a-taf-does">
				<h2>3. taf чӣ кор мекунад</h2>
				<p>Дар tafs шумо кореро ба taf месупоред: агенти AI, ки аз рӯи ҷадвал бо абзорҳое, ки шумо пайваст мекунед, дар дохили KIFF Card-ҳое, ки шумо барои он медиҳед, кор мекунад. Модели AI-ро, ки он истифода мебарад, Anthropic пешниҳод мекунад. Setup, агенти AI дар tafs, ба шумо дар пайвастани абзор ва танзими taf кӯмак мекунад, вале худ аз худ чизеро пайваст намекунад: шумо дар назди таъминкунандаи худи абзор ворид мешавед ва ҳар як пайвастшавӣ, абзорҳое, ки taf метавонад истифода барад, ва Card-ҳои онро дар дастгоҳи худ тасдиқ мекунед.</p>
				<p>Ҳисоботҳо, паёмҳо ва ёддоштҳои хотираи taf-ро модели AI менависад ва онҳо метавонанд хато бошанд. Пеш аз такя ба онҳо чизҳои муҳимро санҷед. Ҳар чизе, ки taf ба касе берун аз ширкати шумо менависад, нишон медиҳад, ки онро агенти AI навиштааст.</p>
			</section>
			<section id="control">
				<h2>4. Назорати шумо: Card ва тасдиқҳо</h2>
				<p>taf ба абзорҳои шумо танҳо тавассути KIFF мерасад, ки ҳар занги пеш аз фиристодан бо Card-ҳои taf месанҷад. Занге, ки дар дохили Card-и аз ҷониби шумо додашуда аст, мувофиқи дастури шумо иҷро мешавад. Занге, ки берун аз Card аст, чунон ки Card мегӯяд, нигоҳ дошта мешавад ё рад карда мешавад. Занги нигоҳдошташуда танҳо пас аз он иҷро мешавад, ки касе, ки ҳисоби шумо ба ӯ иҷозат медиҳад ба занги нигоҳдошташуда ҷавоб диҳад, онро тасдиқ кунад.</p>
				<p>Шумо кор ва Card-ҳои ҳар як taf-ро интихоб мекунед, ба занги нигоҳдошташудаи он ҷавоб медиҳед ва боварӣ ҳосил мекунед, ки ҳаққи истифодаи абзорҳо ва ҳисобҳоеро, ки пайваст мекунед, доред. Шумо метавонед як taf ё ҳамаро қатъ кунед, taf-ро таваққуф кунед, ҳар Card-и онро бекор кунед ё онро хориҷ кунед. Аз лаҳзае, ки шумо taf-ро қатъ мекунед ё Card-ро бекор мекунед, KIFF ягон занги нави он taf ё дар зери он Card-ро иҷозат намедиҳад. Дархосте, ки аллакай ба таъминкунандаи абзор фиристода шудааст, метавонад ҳанӯз анҷом ёбад: мо занги навро қатъ мекунем, вале он чиро, ки таъминкунанда кардааст, бозгардонда наметавонем. Тафсилот дар <a href="/tg/terms#tafs">Шартҳои KIFF, §3A</a> оварда шудааст. Вақте ки taf дар саҳифаи пардохт бо усуле, ки дар он сайт захира кардаед, пардохт мекунад, ин корро танҳо дар дохили Card ва танҳо пас аз он мекунад, ки шумо ин пардохтро дар телефон тасдиқ кардед; сайт ва провайдери пардохти он онро коркард мекунанд ва KIFF ва planque ҳаргиз пули шуморо нигоҳ намедоранд, маълумоти кортатонро ҳаргиз захира намекунанд ва taf ҳаргиз рақами кортро ворид намекунад.</p>
				<p>Тибқи Қонуни AI-и ИА, Kiff Agents OÜ таъминкунандаи tafs ва шумо истифодабарандаи он ҳастед. tafs-ро танҳо барои корҳое, ки он пешниҳод мекунад, истифода баред, на барои ягон истифодае, ки Қонуни AI манъ мекунад ё хавфи баланд меҳисобад, масалан қарорҳо дар бораи шуғл, қарз ё дастрасии шахс ба хизматрасониҳои зарурӣ.</p>
			</section>
			<section id="acceptable-use">
				<h2>5. Истифодаи иҷозатдодашуда</h2>
				<p>Шумо, одамони шумо ва tafs-и шумо бояд <a href="/acceptable-use">Сиёсати истифодаи иҷозатдодашуда</a> (бо забони англисӣ)-ро риоя кунед. Амали агент амали шумост. Аз ҷумла, шумо наметавонед tafs-ро барои вайрон кардани қонун, амал дар низом ё ҳисобе, ки ба истифодаи он иҷозат надоред, пайваст кардани абзор бо воридшавие, ки аз они шумо нест, фиристодани спам ё гузаштан аз Card, маҳдудият ё нигоҳдорӣ истифода баред. Мо метавонем дар сурати вайронкунии боэътимод фавран таваққуф кунем.</p>
			</section>
			<section id="fees">
				<h2>6. Ҳаққи хизмат</h2>
				<p>Дар вақти ин навсозӣ, Solo дар як моҳ { tafsCostTG.money(TafsSoloCents) } аст, бо ҳисоби ААИ, бо { tafsCostTG.number(TafsSoloCredits) } кредит дар як моҳ, ки дар барнома тавассути App Store ё Google Play фурӯхта мешавад. Бастаҳои кредит, ки дар барнома харида мешаванд, аз { tafsCostTG.money(TafsPackCents[TafsSoloCredits]) } оғоз мешаванд; онҳо мӯҳлат надоранд. Ҳар як иҷрои taf барои AI-е, ки истифода бурдааст, кредит сарф мекунад. Coach ва танзими tafs дар доираи истифодаи одилонаи Coach дохил мешаванд. Инҳо нархҳо дар минтақаи евро ҳастанд. Дар ҷои дигар App Store ё Google Play нархро бо асъори шумо бо андози маҳаллӣ ё бе он, чунон ки қоидаҳои он кишвар талаб мекунанд, нишон медиҳад ва ин нархест, ки шумо месупоред. Нархҳои ҷорӣ дар <a href="/pricing">саҳифаи нархҳо</a> (бо забони англисӣ) мебошанд; tafs инчунин қисми нақшаи Company-и KIFF аст.</p>
				<p>Давраи озмоишӣ вуҷуд надорад. Solo, ки дар барнома харида шудааст, дар обунаҳои Apple ё Google Play-и шумо, мувофиқи шартҳои он мағоза оид ба пардохт, нав кардан ва бозгардонидани маблағ, идора ва бекор карда мешавад. Нақша то охири давраи пардохтшуда амал мекунад. Агар шумо дар ИА истеъмолкунанда бошед, метавонед дар давоми 14 рӯзи харид даст кашед. Тафсилот дар <a href="/tg/terms#fees">Шартҳои KIFF, §8</a> оварда шудааст.</p>
			</section>
			<section id="liability">
				<h2>7. Масъулият</h2>
				<p>tafs "чунон ки ҳаст" ва "чунон ки дастрас аст" пешниҳод мешавад, ба истиснои кафолатҳо дар Шартҳои KIFF (§10). То ҳадде, ки қонун иҷозат медиҳад, ҳеҷ як тараф барои зарари ғайримустақим ё натиҷавӣ масъул нест ва масъулияти умумии ҳар тараф чунон ки <a href="/tg/terms#liability">Шартҳои KIFF, §12</a> мегӯянд, маҳдуд аст. Ҳеҷ чиз масъулиятеро, ки қонун маҳдуд кардани онро иҷозат намедиҳад, маҳдуд намекунад.</p>
			</section>
			<section id="termination">
				<h2>8. Қатъ</h2>
				<p>Шумо метавонед ҳар вақт қатъ кунед: ҳисоби худро дар барнома дар Ҳисоб → <em>Ҳисобро нест кунед</em> нест кунед. Аввал сӯҳбатҳои худро аз Ҳисоб → Содироти сӯҳбатҳои ман содир кунед. Мо метавонем истифодаи шуморо барои вайронкунии ҷиддие, ки дар давоми сӣ рӯз пас аз огоҳӣ бартараф нашудааст, ё фавран барои вайронкунии Истифодаи иҷозатдодашуда қатъ кунем. Ҳуқуқи шумо ба рафтан ва бо худ бурдани маълумоти худ дар <a href="/tg/terms#term">Шартҳои KIFF, §9</a> оварда шудааст.</p>
			</section>
			<section id="governing-law">
				<h2>9. Тағйирот ва қонуни ҳаматбиқшаванда</h2>
				<p>Мо ин шартҳоро ҳамон тавр тағйир медиҳем, ки Шартҳои KIFF барои худашон мегӯянд (§16). Онҳо тибқи қонунҳои Ҷумҳурии Эстония танзим мешаванд ва баҳсҳо ба Суди ноҳияи Харю дар Таллин мераванд. Агар шумо дар давлати дигари узви ИА истеъмолкунанда бошед, қоидаҳои ҳатмии ҳимояи истеъмолкунандагони кишвари худи шумо ҳанӯз татбиқ мешаванд.</p>
			</section>
			<section id="contact">
				<h2>10. Тамос бо мо</h2>
				<p>Саволҳои шартномавӣ: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>. Кӯмак бо барнома: <a href="mailto:support@kiff.dev">support@kiff.dev</a>. Махфият: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>, ва ин ки tafs маълумоти шахсиро чӣ гуна коркард мекунад, дар <a href="/tg/tafs/privacy">Сиёсати махфияти tafs</a> оварда шудааст.</p>
			</section>
		</article>
	}
}
