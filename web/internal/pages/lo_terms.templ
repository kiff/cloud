package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// TermsLO is KIFF's terms (/terms) in Lao, at /lo/terms.
// It is a translation of Terms: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Lao has the legal
// texts only, so a link to any other page goes to English and says so.
templ TermsLO() {
	@components.LayoutSite("KIFF — terms of service", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@termsHeadLO()
			@termsDefinitionsLO()
			@termsAgreementLO()
			@termsServiceLO()
			@termsTafsLO()
			@termsAccountLO()
			@termsAcceptableUseLO()
			@termsCustomerDataLO()
			@termsConfidentialityLO()
			@termsFeesLO()
			@termsTermLO()
			@termsWarrantiesLO()
			@termsDisclaimerLO()
			@termsLiabilityLO()
			@termsIndemnityLO()
			@termsSLALO()
			@termsServiceModsLO()
			@termsTermsModsLO()
			@termsForceMajeureLO()
			@termsGoverningLawLO()
			@termsGeneralLO()
			@termsContactLO()
		</article>
	}
}

templ termsHeadLO() {
	<header class="legal-head">
		<p class="legal-badge">ເງື່ອນໄຂການໃຫ້ບໍລິການ · v0.1</p>
		<h1>ເງື່ອນໄຂການໃຫ້ບໍລິການ</h1>
		<p class="legal-meta">
			<strong>ອັບເດດຄັ້ງຫຼ້າສຸດ:</strong> 22 ພະຈິກ 2026. <strong>ມີຜົນບັງຄັບໃຊ້ຕັ້ງແຕ່:</strong> 24 ພຶດສະພາ 2026.
		</p>
		<p class="legal-disclaimer">
			<strong>ມີຫຍັງປ່ຽນ:</strong> ສັນຍາຂອງທ່ານເປັນກັບໃຜ ເມື່ອທຸລະກິດອື່ນແນະນຳທ່ານ (§2), ແລະ ວິສາຫະກິດຂະໜາດຈິ໋ວ (§8). ກ່ອນໜ້ານັ້ນ: ໃຜໃຊ້ບໍລິການໄດ້, ຕາມພາກພື້ນ, ຄວາມເປັນເຈົ້າຂອງ ແລະ ມາດຕະການລົງໂທດ (§4); ແອັບ tafs ໃນ Android, ແລະ Solo ທີ່ຊື້ຜ່ານ Google Play (§1, §8). ກ່ອນນັ້ນອີກ: ແຜນແບບຈ່າຍເງິນ (§3A, §8), <a href="/legal/sla">ຂໍ້ຕົກລົງລະດັບການບໍລິການ</a> (ເປັນພາສາອັງກິດ) (§14), ແລະ ລາຍການການໃຊ້ທີ່ຫ້າມ, ເຊິ່ງຕອນນີ້ຢູ່ໃນ <a href="/acceptable-use">ນະໂຍບາຍການໃຊ້ທີ່ຍອມຮັບໄດ້</a> (ເປັນພາສາອັງກິດ) (§5).
		</p>
		<p class="legal-disclaimer">
			ເງື່ອນໄຂເຫຼົ່ານີ້ຄວບຄຸມການໃຊ້ KIFF Cloud, ລວມທັງ tafs. ຄຳຖາມດ້ານສັນຍາ: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</header>
}

templ termsDefinitionsLO() {
	<section id="definitions">
		<h2>1. ຄຳນິຍາມ</h2>
		<ul>
			<li><strong>"Kiff Agents OÜ"</strong>, <strong>"ພວກເຮົາ"</strong>, <strong>"ພວກເຮົາ"</strong>, <strong>"ຂອງພວກເຮົາ"</strong> — ບໍລິສັດຈຳກັດຄວາມຮັບຜິດຊອບເອກະຊົນຂອງເອສໂຕເນຍທີ່ໃຫ້ບໍລິການ. ລະຫັດຈົດທະບຽນ 17372313.</li>
			<li><strong>"ລູກຄ້າ"</strong>, <strong>"ທ່ານ"</strong>, <strong>"ຂອງທ່ານ"</strong> — ບຸກຄົນທຳມະດາ ຫຼື ນິຕິບຸກຄົນທີ່ຕົກລົງຕາມເງື່ອນໄຂເຫຼົ່ານີ້.</li>
			<li><strong>"ຜູ້ໃຊ້"</strong> — ບຸກຄົນໃດກໍຕາມທີ່ລູກຄ້າອະນຸຍາດໃຫ້ເຂົ້າເຖິງບໍລິການຜ່ານບັນຊີຂອງລູກຄ້າ.</li>
			<li><strong>"ບໍລິການ"</strong> — ຜະລິດຕະພັນ KIFF Cloud, ລວມທັງ <code>api.kiff.dev</code>, <code>app.kiff.dev</code>, <code>kiff.dev</code>, tafs, ແລະ ເອກະສານ, ແດຊບອດ ແລະ API ທີ່ພວກເຮົາເຜີຍແຜ່ຢູ່ບ່ອນນັ້ນ.</li>
			<li><strong>"tafs"</strong> — ແອັບ tafs ສຳລັບ iPhone, iPad, Android ແລະ ຄອມພິວເຕີ (Mac, Windows ແລະ Linux) ແລະ ບໍລິການທີ່ຢູ່ເບື້ອງຫຼັງ, ລວມທັງ Setup ແລະ planque (§3A), ເຊິ່ງລູກຄ້າມອບວຽກໃຫ້ຕົວແທນ AI ທີ່ເຮັດວຽກພາຍໃນ KIFF Card. <strong>"taf"</strong> ແມ່ນຕົວແທນໜຶ່ງອັນດັ່ງກ່າວ.</li>
			<li><strong>"Tenant"</strong> — ພື້ນທີ່ເຮັດວຽກທີ່ແຍກກັນທາງເຫດຜົນພາຍໃນບໍລິການ ທີ່ເປັນຂອງລູກຄ້າຜູ້ດຽວ.</li>
			<li><strong>"ຂໍ້ມູນການກວດສອບ"</strong> — ເຫດການ, ການຕັດສິນ, ການກະທຳ, ການອະນຸມັດ ແລະ ໃບຮັບທີ່ບໍລິການເກັບໄວ້ໃນນາມລູກຄ້າຜ່ານ runtime.</li>
			<li><strong>"ຂໍ້ມູນ tafs"</strong> — ສິ່ງທີ່ tafs ເກັບໄວ້ໃນນາມລູກຄ້າ: ການເຮັດວຽກ ແລະ ການສົນທະນາຂອງ taf ແຕ່ລະອັນ (ລວມທັງສິ່ງທີ່ເຄື່ອງມືທີ່ເຊື່ອມຕໍ່ຂອງລູກຄ້າສົ່ງຄືນໃຫ້ມັນ), ລາຍງານ, ບັນທຶກຄວາມຈຳ, ແລະ ໂທລະສັບທີ່ລົງທະບຽນເພື່ອຮັບການແຈ້ງເຕືອນຂອງມັນ.</li>
			<li><strong>"ໃບຮັບ"</strong> — ບັນທຶກການຕັດສິນທີ່ລົງນາມ ແລະ ມີເວີຊັນ ທີ່ບໍລິການອອກໃຫ້ສຳລັບແຕ່ລະການກະທຳທີ່ຖືກຄວບຄຸມ.</li>
			<li><strong>"ເອກະສານ"</strong> — ເອກະສານທາງເທັກນິກຂອງບໍລິການ ແລະ ມາດຕະການຄວາມປອດໄພໃນສະບັບທີ່ລົງວັນທີ ເຊິ່ງລິ້ງຈາກເງື່ອນໄຂເຫຼົ່ານີ້ (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>). ບໍ່ລວມເອກະສານຍຸດທະສາດ (whitepaper), ເອກະສານການຕະຫຼາດ ແລະ ເອກະສານຂອງເຟຣມເວີກໂອເພນຊອດທີ່ມີໃບອະນຸຍາດແຍກຕ່າງຫາກ.</li>
			<li><strong>"DPA"</strong> — ຂໍ້ຕົກລົງການປະມວນຜົນຂໍ້ມູນທີ່ <a href="/legal/dpa">/legal/dpa</a> (ເປັນພາສາອັງກິດ), ທີ່ຄວບຄຸມຄວາມສຳພັນຂອງພວກເຮົາໃນຖານະຜູ້ປະມວນຜົນ.</li>
		</ul>
	</section>
}

templ termsAgreementLO() {
	<section id="agreement">
		<h2>2. ຂໍ້ຕົກລົງ</h2>
		<p>
			ເງື່ອນໄຂເຫຼົ່ານີ້ຄວບຄຸມການໃຊ້ບໍລິການຂອງທ່ານ. ໂດຍການສ້າງບັນຊີ, ສ້າງກຸນແຈ API ຫຼື ໃຊ້ບໍລິການດ້ວຍວິທີອື່ນ, ທ່ານຕົກລົງຕາມເງື່ອນໄຂເຫຼົ່ານີ້. ຖ້າທ່ານຍອມຮັບໃນນາມບໍລິສັດ ຫຼື ນິຕິບຸກຄົນອື່ນ, ທ່ານຢືນຢັນວ່າທ່ານມີອຳນາດຜູກມັດນິຕິບຸກຄົນນັ້ນ, ແລະ "ທ່ານ" ກັບ "ຂອງທ່ານ" ໝາຍເຖິງນິຕິບຸກຄົນນັ້ນ.
		</p>
		<p>
			ຖ້ານັກພັດທະນາ, ຄູ່ຮ່ວມງານ ຫຼື ທຸລະກິດອື່ນແນະນຳທ່ານໃຫ້ຮູ້ຈັກ KIFF ຫຼື ສ້າງຕົວແທນທີ່ທ່ານໃຊ້, ສັນຍາສຳລັບບໍລິການຂອງທ່ານແມ່ນກັບພວກເຮົາໂດຍກົງ, ພາຍໃຕ້ເງື່ອນໄຂເຫຼົ່ານີ້, ແລະ ທ່ານຍອມຮັບມັນດ້ວຍຕົນເອງ. ທຸລະກິດນັ້ນບໍ່ແມ່ນຕົວແທນຂອງພວກເຮົາ: ມັນຍອມຮັບເງື່ອນໄຂເຫຼົ່ານີ້, ໃຫ້ຄວາມຍິນຍອມ ຫຼື ອະນຸມັດການຈ່າຍເງິນແທນທ່ານບໍ່ໄດ້, ແລະ ມັນບໍ່ໄດ້ຂາຍບໍລິການແທນພວກເຮົາ.
		</p>
		<p>
			ພວກເຮົາອາດເຜີຍແຜ່ເງື່ອນໄຂເພີ່ມເຕີມສຳລັບຄຸນສົມບັດສະເພາະ (ຄຸນສົມບັດເບຕ້າ, ການເຊື່ອມຕໍ່ຂອງບຸກຄົນທີສາມ). ຖ້າມັນຂັດກັບເງື່ອນໄຂເຫຼົ່ານີ້, ເງື່ອນໄຂເພີ່ມເຕີມມີອຳນາດເໜືອສຳລັບຄຸນສົມບັດສະເພາະນັ້ນ.
		</p>
	</section>
}

templ termsServiceLO() {
	<section id="service">
		<h2>3. ບໍລິການ</h2>
		<p>
			KIFF Cloud ເປັນບໍລິການທີ່ໂຮສຕິງໄວ້ເພື່ອຄວບຄຸມການກະທຳທີ່ມອບໝາຍ. ມັນປະເມີນຄຳຂໍເທິຍບກັບສິດ ແລະ Card ທີ່ລູກຄ້າຕັ້ງຄ່າໄວ້, ອາດຮຽກຮ້ອງການອະນຸມັດຈາກຄົນ, ແລະ ບັນທຶກການຕັດສິນດ້ານການຄວບຄຸມ. ຂຶ້ນກັບການເຊື່ອມຕໍ່ທີ່ຕັ້ງຄ່າ, KIFF ສົ່ງຕໍ່ຄຳຂໍທີ່ໄດ້ຮັບອະນຸຍາດ ຫຼື ໃຫ້ການອະນຸຍາດທີ່ລະບົບທີ່ໄດ້ຮັບການປົກປ້ອງກວດສອບ. ລະບົບທີ່ເຊື່ອມຕໍ່ເປັນຜູ້ເຮັດການກະທຳພື້ນຖານ.
		</p>
		<p>
			ພຶດຕິກຳທາງເທັກນິກ, ຫຼັກຖານ, ຂໍ້ກຳນົດການເຊື່ອມຕໍ່ ແລະ ຂີດຈຳກັດການປະຕິບັດທີ່ໃຊ້ໄດ້ ຖືກລະບຸໄວ້ໃນເອກະສານທີ່ລົງວັນທີ ເຊິ່ງລິ້ງຈາກເງື່ອນໄຂເຫຼົ່ານີ້. <a href="/whitepaper">whitepaper</a> (ເປັນພາສາອັງກິດ) ດ້ານຍຸດທະສາດອະທິບາຍຫຼັກການ ແລະ ແບບຈຳລອງຂອງ KIFF; ມັນບໍ່ໄດ້ຖືກລວມເປັນເອກະສານທາງເທັກນິກພາຍໃຕ້ເງື່ອນໄຂເຫຼົ່ານີ້.
		</p>
		<p>
			ບໍລິການຄວບຄຸມຂອງ KIFF Cloud <em>ບໍ່ແມ່ນ</em> ເຟຣມເວີກຕົວແທນ, ເຄື່ອງຈັກເວີກໂຟລ, ເກດເວແບບຈຳລອງ ຫຼື ແພລດຟອມຕົວແທນທີ່ຈັດການໃຫ້. ມັນເຮັດວຽກຮ່ວມກັບສິ່ງໃດກໍຕາມທີ່ທ່ານໃຊ້ຢູ່ແລ້ວ. ເບິ່ງລາຍການທີ່ຊັດເຈນທີ່ <a href="/#not">"KIFF ບໍ່ແມ່ນຫຍັງ"</a> (ເປັນພາສາອັງກິດ) ໃນໜ້າທຳອິດ. tafs ເປັນສ່ວນດຽວຂອງບໍລິການທີ່ໃຫ້ຕົວແທນເຮັດວຽກແທນທ່ານ, ພາຍໃນ Card ທີ່ທ່ານອອກໃຫ້; §3A ອະທິບາຍມັນ.
		</p>
		<p>
			ເຟຣມເວີກໂອເພນຊອດ <a href="https://github.com/kiff/kiff" target="_blank" rel="noopener">kiff/kiff</a> ຢູ່ພາຍໃຕ້ໃບອະນຸຍາດ MIT ຂອງມັນເອງ ແລະ ຢູ່ນອກເງື່ອນໄຂເຫຼົ່ານີ້. ເມື່ອທ່ານໃຊ້ເຟຣມເວີກໃນໂຄງສ້າງພື້ນຖານຂອງທ່ານເອງ, ບໍ່ມີສັນຍາກັບ Kiff Agents OÜ ເກີດຂຶ້ນ.
		</p>
	</section>
}

templ termsTafsLO() {
	<section id="tafs">
		<h2>3A. tafs</h2>
		<p>
			ໃນ tafs ທ່ານມອບວຽກ (ຕົວຢ່າງ ການຄືນເງິນ, ການຈ່າຍບິນ ຫຼື ການໂຕ້ແຍ້ງບັດ) ໃຫ້ taf: ຕົວແທນ AI ທີ່ເຮັດວຽກຕາມຕາຕະລາງດ້ວຍເຄື່ອງມືທີ່ທ່ານເຊື່ອມຕໍ່, ພາຍໃນ KIFF Card ທີ່ທ່ານອອກໃຫ້ມັນ. taf ແຕ່ລະອັນເຮັດວຽກເທິງ runtime ຕົວແທນຂອງພວກເຮົາ, ແລະ Anthropic ໃຫ້ແບບຈຳລອງ AI ທີ່ມັນໃຊ້. ທ່ານຕອບການເອີ້ນທີ່ຖືກພັກຂອງມັນໃນແອັບ tafs.
		</p>
		<p>
			<strong>ການເຊື່ອມຕໍ່ເຄື່ອງມືຂອງທ່ານ.</strong> Setup, ຕົວແທນ AI ໃນ tafs ທີ່ເຮັດວຽກຄືກັບ taf, ຊ່ວຍທ່ານເຊື່ອມຕໍ່ເຄື່ອງມື ແລະ ຕັ້ງ taf ສຳລັບວຽກ. ມັນບໍ່ເຊື່ອມຕໍ່ຫຍັງດ້ວຍຕົນເອງ. ທ່ານເຂົ້າສູ່ລະບົບທີ່ຜູ້ໃຫ້ບໍລິການຂອງເຄື່ອງມືເອງ (ຕົວຢ່າງ Stripe), ແລະ ທ່ານອະນຸມັດໃນອຸປະກອນຂອງທ່ານແຕ່ລະການເຊື່ອມຕໍ່, ເຄື່ອງມືທີ່ taf ໃຊ້ໄດ້, ແລະ Card ຂອງມັນ. token ຈາກການເຂົ້າສູ່ລະບົບນັ້ນຖືກເກັບໂດຍ planque, ບໍລິການເຊື່ອມຕໍ່ຂອງພວກເຮົາ. ມັນຖືກເຂົ້າລະຫັດ, ໃຊ້ເພື່ອເຮັດການເອີ້ນທີ່ KIFF ຕັດສິນແລ້ວເທົ່ານັ້ນ, ແລະ ບໍ່ເຄີຍໃຫ້ແກ່ taf. ການຕັດການເຊື່ອມຕໍ່ເຄື່ອງມືຖອນ token ທີ່ຜູ້ໃຫ້ບໍລິການ ແລະ ລຶບມັນ.
		</p>
		<p>
			<strong>Card ຂອງທ່ານຄືຄຳແນະນຳຂອງທ່ານ.</strong> taf ເຂົ້າເຖິງເຄື່ອງມືຂອງທ່ານຜ່ານ KIFF ເທົ່ານັ້ນ, ເຊິ່ງກວດທຸກການເອີ້ນກັບ Card ຂອງ taf ກ່ອນສົ່ງ. ການເອີ້ນພາຍໃນ Card ທີ່ທ່ານອອກແມ່ນເຮັດຕາມຄຳແນະນຳຂອງທ່ານ. ການເອີ້ນນອກ Card ຖືກພັກ ຫຼື ປະຕິເສດ, ຕາມທີ່ Card ກຳນົດ. ການເອີ້ນທີ່ຖືກພັກຖືກເຮັດຫຼັງຈາກຄົນທີ່ບັນຊີຂອງທ່ານອະນຸຍາດໃຫ້ຕອບການເອີ້ນທີ່ຖືກພັກອະນຸມັດເທົ່ານັ້ນ. ໃນແອັບ tafs, ຄຳຕອບມີລາຍເຊັນຈາກອຸປະກອນຂອງເຂົາເຈົ້າທີ່ KIFF ກວດສອບ, ແລະ ໃບຮັບເກັບຫຼັກຖານນັ້ນ. ບັນຊີຂອງທ່ານຍັງຕອບໄດ້ໃນ KIFF ເອງ (ແດຊບອດ, ເຄື່ອງມືບັນທັດຄຳສັ່ງຂອງມັນ ຫຼື ຜູ້ອະນຸມັດທີ່ທ່ານມອບສິດຢູ່ບ່ອນນັ້ນ); ໃບຮັບຈະບັນທຶກວ່າໃຜຕອບ ແລະ ດ້ວຍວິທີໃດ.
		</p>
		<p>
			<strong>ການຈ່າຍເງິນ.</strong> ເມື່ອ taf ຈ່າຍແທນທ່ານຢູ່ໜ້າຊຳລະເງິນຂອງເວັບໄຊ ດ້ວຍບັດ ຫຼື ວິທີຈ່າຍເງິນອື່ນທີ່ທ່ານໄດ້ບັນທຶກໄວ້ໃນເວັບໄຊນັ້ນ ມັນເຮັດແນວນັ້ນພາຍໃນ Card ເທົ່ານັ້ນ ແລະ ຫຼັງຈາກທ່ານອະນຸມັດການຈ່າຍເງິນນັ້ນໃນໂທລະສັບຂອງທ່ານ. ການອະນຸມັດຂອງທ່ານອະນຸຍາດພຽງການຈ່າຍເງິນນັ້ນຄັ້ງດຽວແທນທ່ານ. ເວັບໄຊ ແລະ ຜູ້ໃຫ້ບໍລິການຊຳລະເງິນຂອງມັນປະມວນຜົນມັນ. KIFF ແລະ planque ບໍ່ເຄີຍຖືເງິນຂອງທ່ານ ບໍ່ເຄີຍເກັບລາຍລະອຽດບັດຂອງທ່ານ ແລະ taf ບໍ່ເຄີຍພິມເລກບັດ.
		</p>
		<p>
			<strong>ສິ່ງທີ່ຢູ່ກັບທ່ານ.</strong> ທ່ານເລືອກວຽກ ແລະ Card ຂອງ taf ແຕ່ລະອັນ, ຕອບການເອີ້ນທີ່ຖືກພັກຂອງມັນ, ແລະ ຮັບປະກັນວ່າທ່ານມີສິດໃຊ້ເຄື່ອງມື ແລະ ບັນຊີທີ່ທ່ານເຊື່ອມຕໍ່. ລາຍງານ, ຂໍ້ຄວາມ ແລະ ບັນທຶກຄວາມຈຳຂອງ taf ຖືກຂຽນໂດຍແບບຈຳລອງ AI ແລະ ອາດຜິດພາດ; ກວດສິ່ງສຳຄັນກ່ອນທ່ານເຊື່ອຖື.
		</p>
		<p>
			<strong>ການຢຸດ taf.</strong> ທ່ານຢຸດ taf ໜຶ່ງອັນ ຫຼື ທັງໝົດ, ພັກ taf, ຖອນ Card ໃດກໍໄດ້ຂອງມັນ, ຫຼື ລຶບມັນ. ຕັ້ງແຕ່ເວລາທີ່ທ່ານຢຸດ taf ຫຼື ຖອນ Card, KIFF ບໍ່ອະນຸຍາດການເອີ້ນໃໝ່ພາຍໃຕ້ມັນ. ແອັບ tafs ສະແດງ taf ວ່າຢຸດແລ້ວກໍຕໍ່ເມື່ອ KIFF ແລະ planque ຢືນຢັນການຢຸດທັງສອງ; ຕັ້ງແຕ່ນັ້ນ planque ບໍ່ສົ່ງການເອີ້ນໃດຂອງມັນ, ລວມທັງອັນທີ່ KIFF ອະນຸຍາດກ່ອນໜ້ານັ້ນບໍ່ດົນ. ຄຳຂໍທີ່ສົ່ງໄປຫາຜູ້ໃຫ້ບໍລິການຂອງເຄື່ອງມືແລ້ວອາດຍັງສຳເລັດ: ພວກເຮົາຢຸດການເອີ້ນໃໝ່, ແຕ່ຍົກເລີກສິ່ງທີ່ຜູ້ໃຫ້ບໍລິການເຮັດແລ້ວບໍ່ໄດ້. ເຄື່ອງມືທີ່ກວດໃບອະນຸຍາດຂອງ KIFF ເອງ, ໂດຍບໍ່ຜ່ານ planque, ອາດຍັງຮັບໃບອະນຸຍາດທີ່ KIFF ອອກກ່ອນໜ້ານັ້ນບໍ່ດົນ, ຫຼາຍທີ່ສຸດ 90 ວິນາທີ. ການສືບຕໍ່ taf ທີ່ຢຸດຕ້ອງໄດ້ການອະນຸມັດຂອງທ່ານໃນອຸປະກອນຂອງທ່ານ, ແລະ ບໍ່ມີສິ່ງໃດທີ່ຖືກພັກ ຫຼື ຢູ່ໃນຄິວກ່ອນການຢຸດທີ່ຈະເຮັດຫຼັງຈາກນັ້ນ.
		</p>
		<p>
			<strong>ການລຶບ taf</strong> ຢຸດຕາຕະລາງຂອງມັນ ແລະ ລຶບການເຮັດວຽກ, ການສົນທະນາ, ຄວາມຈຳ ແລະ ກຸນແຈທີ່ມັນໃຊ້. ແມ່ນແຕ່ກ່ອນນັ້ນ, ສິ່ງທີ່ເຄື່ອງມືຂອງທ່ານສົ່ງຄືນໃຫ້ taf ຖືກເກັບໄວ້ຈົນກວ່າການເຮັດວຽກຂອງມັນສິ້ນສຸດເທົ່ານັ້ນ (ສິ່ງທີ່ການສົນທະນາພຽງອ່ານ, ເຂົ້າລະຫັດ, ສຳລັບຂໍ້ຄວາມຕໍ່ໄປຂອງມັນ: ໃຊ້ຫຼາຍທີ່ສຸດສີ່ຊົ່ວໂມງ, ແລ້ວລຶບ), ແລະ ການເຮັດວຽກກັບການສົນທະນາຂອງມັນ 30 ວັນ. KIFF ເກັບໃບຮັບຂອງສິ່ງທີ່ມັນເຮັດ.
		</p>
		<p>
			<strong>ກົດໝາຍ AI ຂອງສະຫະພາບເອີຣົບ.</strong> ສຳລັບ tafs, Kiff Agents OÜ ເປັນຜູ້ໃຫ້ບໍລິການລະບົບ AI ແລະ ທ່ານເປັນຜູ້ນຳໃຊ້ມັນ. ພວກເຮົາຮັບປະກັນວ່າທຸກສິ່ງທີ່ taf ຂຽນເຖິງຄົນນອກບໍລິສັດຂອງທ່ານບອກວ່າຕົວແທນ AI ເປັນຜູ້ຂຽນ. ທ່ານໃຊ້ tafs ສຳລັບວຽກທີ່ມັນສະເໜີເທົ່ານັ້ນ, ແລະ ບໍ່ໃຊ້ສຳລັບການໃຊ້ໃດທີ່ກົດໝາຍ AI ຫ້າມ ຫຼື ຈັດເປັນຄວາມສ່ຽງສູງ, ເຊັ່ນ ການຕັດສິນກ່ຽວກັບການຈ້າງງານ, ສິນເຊື່ອ ຫຼື ການເຂົ້າເຖິງບໍລິການທີ່ຈຳເປັນຂອງບຸກຄົນ. ທ່ານຮັກສາການອະນຸມັດຈາກຄົນທີ່ Card ຂອງທ່ານຮຽກຮ້ອງ, ແລະ ຮັບປະກັນວ່າຄົນທີ່ໃຊ້ tafs ໃຫ້ທ່ານເຂົ້າໃຈວ່າມັນເຮັດຫຍັງ ແລະ ຂີດຈຳກັດຂອງມັນ.
		</p>
		<p>
			<strong>ຄ່າໃຊ້ຈ່າຍ.</strong> tafs ເປັນສ່ວນໜຶ່ງຂອງແຜນ KIFF ຂອງທ່ານ (§8): ການເຮັດວຽກແຕ່ລະຄັ້ງຂອງ taf ໃຊ້ເຄຣດິດສຳລັບ AI ທີ່ມັນໃຊ້. Coach, ແລະ ການຕັ້ງ tafs, ລວມຢູ່ໃນການໃຊ້ຢ່າງເປັນທຳຂອງ Coach.
		</p>
	</section>
}

templ termsAccountLO() {
	<section id="account">
		<h2>4. ບັນຊີ ແລະ ການເຂົ້າເຖິງ</h2>
		<p>
			ເພື່ອໃຊ້ບໍລິການ ທ່ານຕ້ອງສ້າງບັນຊີ. ທ່ານຕົກລົງທີ່ຈະໃຫ້ຂໍ້ມູນການລົງທະບຽນທີ່ຖືກຕ້ອງ, ຮັກສາຂໍ້ມູນການເຂົ້າສູ່ລະບົບເປັນຄວາມລັບ, ແລະ ຮັບຜິດຊອບຕໍ່ກິດຈະກຳທັງໝົດພາຍໃຕ້ບັນຊີຂອງທ່ານ.
		</p>
		<p>
			ທ່ານຕ້ອງມີອາຍຸຢ່າງໜ້ອຍ 16 ປີ, ຫຼື ອາຍຸຂອງການຍິນຍອມດິຈິຕອນໃນເຂດອຳນາດຂອງທ່ານ, ອັນໃດສູງກວ່າ. ບໍລິການບໍ່ໄດ້ມຸ່ງໄປຫາເດັກ.
		</p>
		<p>
			ບໍລິການສະເໜີສະເພາະໃນປະເທດ ແລະ ພາກພື້ນທີ່ Anthropic, ຜູ້ໃຫ້ແບບຈຳລອງ AI ຂອງມັນ, ສະເໜີບໍລິການຂອງຕົນເອງ, ຕາມທີ່ <a href="https://www.anthropic.com/supported-countries">Anthropic ລະບຸໄວ້</a>. ທ່ານບໍ່ອາດໃຊ້ມັນຈາກບ່ອນອື່ນ. ບໍລິສັດບໍ່ອາດໃຊ້ມັນຖ້າມີສຳນັກງານໃຫຍ່ຢູ່ ຫຼື ເປັນເຈົ້າຂອງສ່ວນໃຫຍ່ ຫຼື ຖືກຄວບຄຸມໂດຍບໍລິສັດທີ່ມີສຳນັກງານໃຫຍ່ຢູ່ປະເທດ ຫຼື ພາກພື້ນນອກລາຍຊື່ນັ້ນ, ບໍ່ວ່າຜູ້ໃຊ້ຂອງມັນຢູ່ໃສ. ທ່ານກໍບໍ່ອາດໃຊ້ມັນຖ້າທ່ານ, ຫຼື ບໍລິສັດທີ່ທ່ານໃຊ້ໃຫ້, ຢູ່ພາຍໃຕ້ມາດຕະການລົງໂທດຂອງສະຫະພາບເອີຣົບ, ສະຫະປະຊາຊາດ ຫຼື ສະຫະລັດອາເມລິກາ. ພວກເຮົາປະຕິເສດບັນຊີທີ່ລະເມີດກົດນີ້ ແລະ ອາດໂຈະບັນຊີນັ້ນ.
		</p>
		<p>
			ທ່ານຮັບຜິດຊອບຕໍ່ການກະທຳຂອງຜູ້ໃຊ້ທຸກຄົນທີ່ທ່ານອະນຸຍາດໃນບັນຊີຂອງທ່ານ. ພວກເຮົາອາດໂຈະບັນຊີ ຫຼື ຖອນການເຂົ້າເຖິງດ້ວຍການແຈ້ງລ່ວງໜ້າຢ່າງສົມເຫດສົມຜົນ ຖ້າພວກເຮົາກວດພົບການລະເມີດເງື່ອນໄຂເຫຼົ່ານີ້ທີ່ເຊື່ອຖືໄດ້. ສຳລັບການລະເມີດການໃຊ້ທີ່ຍອມຮັບໄດ້ (ເບິ່ງ §5) ການໂຈະອາດເກີດຂຶ້ນທັນທີ.
		</p>
	</section>
}

templ termsAcceptableUseLO() {
	<section id="acceptable-use">
		<h2>5. ການໃຊ້ທີ່ຍອມຮັບໄດ້</h2>
		<p>
			ທ່ານ, ຜູ້ໃຊ້ຂອງທ່ານ ແລະ ຕົວແທນຂອງທ່ານຕ້ອງປະຕິບັດຕາມ <a href="/acceptable-use">ນະໂຍບາຍການໃຊ້ທີ່ຍອມຮັບໄດ້</a> (ເປັນພາສາອັງກິດ). ມັນເປັນສ່ວນໜຶ່ງຂອງເງື່ອນໄຂເຫຼົ່ານີ້ ແລະ ລະບຸສິ່ງທີ່ບໍ່ອາດໃຊ້ບໍລິການເພື່ອ.
		</p>
		<p>
			ພວກເຮົາອາດໂຈະທັນທີເມື່ອມີການລະເມີດ AUP ທີ່ເຊື່ອຖືໄດ້. ພວກເຮົາບໍ່ມີພັນທະຕິດຕາມເນື້ອຫາຂອງລູກຄ້າ ແຕ່ອາດດຳເນີນການຕາມລາຍງານທີ່ເຊື່ອຖືໄດ້.
		</p>
	</section>
}

templ termsCustomerDataLO() {
	<section id="customer-data">
		<h2>6. ຂໍ້ມູນ ແລະ ເນື້ອຫາຂອງລູກຄ້າ</h2>
		<p>
			ທ່ານເປັນເຈົ້າຂອງຂໍ້ມູນການກວດສອບຂອງທ່ານ. ທ່ານໃຫ້ Kiff Agents OÜ ໃບອະນຸຍາດທີ່ຈຳກັດ, ບໍ່ສະເພາະ, ບໍ່ມີຄ່າລິຂະສິດ, ທົ່ວໂລກ ເພື່ອໂຮສ, ສຳເນົາ, ສົ່ງ, ສະແດງ ແລະ ປະມວນຜົນຂໍ້ມູນການກວດສອບຂອງທ່ານດ້ວຍວິທີອື່ນ ສະເພາະເທົ່າທີ່ຈຳເປັນເພື່ອດຳເນີນ, ບຳລຸງຮັກສາ ແລະ ປັບປຸງບໍລິການໃຫ້ທ່ານ.
		</p>
		<p>
			ພວກເຮົາເຮັດໜ້າທີ່ເປັນ <strong>ຜູ້ປະມວນຜົນ</strong> ຂອງຂໍ້ມູນການກວດສອບ ແລະ ຂໍ້ມູນ tafs ຂອງທ່ານຕາມມາດຕາ 28 GDPR; <a href="/legal/dpa">DPA</a> (ເປັນພາສາອັງກິດ) ຄວບຄຸມຄວາມສຳພັນນັ້ນຢ່າງລະອຽດ. ພວກເຮົາເຮັດໜ້າທີ່ເປັນ <strong>ຜູ້ຄວບຄຸມ</strong> ຂອງຂໍ້ມູນເມຕາຂອງບັນຊີທ່ານ; <a href="/lo/privacy">ນະໂຍບາຍຄວາມເປັນສ່ວນຕົວ</a> ຄວບຄຸມຄວາມສຳພັນນັ້ນ.
		</p>
		<p>
			ທ່ານຢືນຢັນວ່າທ່ານມີສິດທັງໝົດທີ່ຈຳເປັນເພື່ອສົ່ງຂໍ້ມູນທີ່ທ່ານສົ່ງ, ແລະ ການສົ່ງນັ້ນປະຕິບັດຕາມກົດໝາຍທີ່ໃຊ້ໄດ້ (ລວມທັງກົດໝາຍປົກປ້ອງຂໍ້ມູນ ແລະ, ເມື່ອໃຊ້ໄດ້, ກົດໝາຍ AI ຂອງສະຫະພາບເອີຣົບ).
		</p>
	</section>
}

templ termsConfidentialityLO() {
	<section id="confidentiality">
		<h2>7. ການຮັກສາຄວາມລັບ</h2>
		<p>
			ແຕ່ລະຝ່າຍອາດໄດ້ຮັບຂໍ້ມູນທີ່ບໍ່ເປີດເຜີຍຈາກອີກຝ່າຍ ("ຂໍ້ມູນລັບ"). ຝ່າຍຜູ້ຮັບຈະໃຊ້ຂໍ້ມູນລັບສະເພາະເທົ່າທີ່ຈຳເປັນເພື່ອປະຕິບັດພັນທະ ແລະ ໃຊ້ສິດຂອງຕົນພາຍໃຕ້ເງື່ອນໄຂເຫຼົ່ານີ້, ແລະ ຈະປົກປ້ອງມັນດ້ວຍລະດັບການດູແລຢ່າງໜ້ອຍເທົ່າກັບທີ່ໃຊ້ກັບຂໍ້ມູນລັບຂອງຕົນເອງ.
		</p>
		<p>
			ຂໍ້ມູນລັບບໍ່ລວມຂໍ້ມູນທີ່ (ກ) ເປັນ ຫຼື ກາຍເປັນສາທາລະນະໂດຍບໍ່ມີການລະເມີດ, (ຂ) ຝ່າຍຜູ້ຮັບຮູ້ແລ້ວກ່ອນການເປີດເຜີຍ, (ຄ) ພັດທະນາຂຶ້ນເອງໂດຍບໍ່ໃຊ້ຂໍ້ມູນລັບ, ຫຼື (ງ) ຕ້ອງເປີດເຜີຍຕາມກົດໝາຍ (ພ້ອມແຈ້ງອີກຝ່າຍເມື່ອອະນຸຍາດ).
		</p>
	</section>
}

templ termsFeesLO() {
	<section id="fees">
		<h2>8. ຄ່າທຳນຽມ ແລະ ການຊຳລະ</h2>
		<p>
			<strong>ແຜນ.</strong> ແຕ່ລະບັນຊີມີໜຶ່ງແຜນ. ລາຄາປັດຈຸບັນຢູ່ທີ່ <a href="/pricing">ໜ້າລາຄາ</a> (ເປັນພາສາອັງກິດ); ໃນເວລາທີ່ອັບເດດນີ້:
		</p>
		<ul>
			<li><strong>Solo:</strong> ໜຶ່ງຄົນ, ສຳລັບ tafs, ຂາຍໃນແອັບ tafs ຜ່ານ App Store ຫຼື Google Play ໃນລາຄາ €12,50 ຕໍ່ເດືອນ, ລວມ VAT, ລວມ 500 ເຄຣດິດຕໍ່ເດືອນ.</li>
			<li><strong>Company:</strong> €10,50 ຕໍ່ເດືອນຕໍ່ບ່ອນນັ່ງ, ມີ 500 ເຄຣດິດຕໍ່ເດືອນຕໍ່ບ່ອນນັ່ງ, ໃຊ້ຮ່ວມກັນ, ແລະ, ສຳລັບການເອີ້ນຂອງຕົວແທນຂອງທ່ານເອງຜ່ານ KIFF Cloud, 500 ການກະທຳຕໍ່ເດືອນຕໍ່ບ່ອນນັ່ງ, ໃຊ້ຮ່ວມກັນ.</li>
			<li><strong>ຂໍ້ຕົກລົງ:</strong> ຄ່າທຳນຽມ ແລະ ເງື່ອນໄຂໃນໃບສັ່ງຊື້ຂອງມັນ.</li>
		</ul>
		<p>
			ບ່ອນນັ່ງແມ່ນແອດມິນ ແລະ ຜູ້ແກ້ໄຂຂອງບັນຊີ. ຜູ້ອະນຸມັດ ແລະ ຜູ້ເບິ່ງບໍ່ເສຍເງິນໃນທຸກແຜນ. ໃນ Company, ເກີນກວ່າທີ່ລວມ, ເຄຣດິດລາຄາ €0,01 ແລະ ການກະທຳລາຄາ €0,02. ເຄຣດິດທີ່ເກີນກວ່າທີ່ລວມຖືກເກັບເງິນຈົນຮອດຂີດຈຳກັດການໃຊ້ຈ່າຍລາຍເດືອນທີ່ບັນຊີຕັ້ງ (€50 ເມື່ອເລີ່ມ): ເມື່ອເຖິງຂີດຈຳກັດ, KIFF ບໍ່ເລີ່ມການເຮັດວຽກໃໝ່ຂອງ taf ຂອງບັນຊີຈົນກວ່າຮອບໃໝ່ຈະເລີ່ມ, ຫຼື ຄົນທີ່ຈັດການການເກັບເງິນເພີ່ມຂີດຈຳກັດ.
		</p>
		<p>
			<strong>ແພັກເຄຣດິດ.</strong> ໃນ Solo, ເຄຣດິດທີ່ເກີນກວ່າທີ່ລວມໃນເດືອນມາຈາກແພັກເຄຣດິດ, ຊື້ໃນແອັບ tafs. ແພັກຖືກຊື້ຄັ້ງດຽວ, ບໍ່ໝົດອາຍຸ, ແລະ ບໍ່ແມ່ນການສະໝັກສະມາຊິກ; ເຄຣດິດຂອງມັນຖືກໃຊ້ຫຼັງຈາກທີ່ລວມໃນເດືອນ, ແພັກເກົ່າທີ່ສຸດກ່ອນ. ແພັກທີ່ການຊຳລະຖືກຄືນເງິນເຕັມຈຳນວນຖືກເອົາຄືນ, ພ້ອມເຄຣດິດທີ່ເຫຼືອ. ເມື່ອເຄຣດິດຂອງເດືອນ ແລະ ແພັກຖືກໃຊ້ໝົດ, KIFF ບໍ່ເລີ່ມການເຮັດວຽກໃໝ່ຂອງ taf ຂອງບັນຊີຈົນກວ່າຮອບໃໝ່ຈະເລີ່ມ ຫຼື ເພີ່ມແພັກ. ເຄຣດິດໂບນັດທີ່ KIFF ເພີ່ມໃຫ້ບັນຊີກໍບໍ່ໝົດອາຍຸຄືກັນ, ຄືກັບແພັກ.
		</p>
		<p>
			<strong>ສິ່ງທີ່ນັບ.</strong> <em>ເຄຣດິດ</em> ຈ່າຍສຳລັບ AI ທີ່ການເຮັດວຽກຂອງ taf ໃຊ້, ເປັນເຄຣດິດເຕັມ, ປັດຂຶ້ນຄັ້ງດຽວຕໍ່ການເຮັດວຽກ ແລະ ນັບຄັ້ງດຽວ, ເມື່ອການເຮັດວຽກສິ້ນສຸດ. ການເຮັດວຽກທີ່ KIFF ປະຕິເສດການເອີ້ນຂອງມັນກໍໃຊ້ AI ຂອງມັນແລ້ວ. ບໍ່ເຄີຍນັບ: Coach, ແລະ ການຕັ້ງ tafs, ໃນການໃຊ້ຢ່າງເປັນທຳຂອງ Coach; ການທົດລອງເວີຊັນໃໝ່, ທີ່ບໍ່ສົ່ງຫຍັງ; ແລະ ການເຮັດວຽກທີ່ລົ້ມເຫຼວຝ່າຍພວກເຮົາ. <em>ການກະທຳ</em> ແມ່ນການເອີ້ນໂດຍຕົວແທນຂອງທ່ານເອງຜ່ານ KIFF Cloud ທີ່ເຮັດໃຫ້ມີຜົນ: KIFF ອະນຸຍາດ, ມັນຖືກສົ່ງ, ແລະ ເຄື່ອງມືລາຍງານວ່າສຳເລັດ. ບໍ່ເຄີຍນັບເປັນການກະທຳ: ການເອີ້ນທີ່ຖືກປະຕິເສດ, ຖືກພັກແລ້ວປະຕິເສດ, ຖືກຢຸດໂດຍການຢຸດ, ບໍ່ຖືກຕ້ອງ, ລົ້ມເຫຼວທີ່ເຄື່ອງມື, ຫຼື ບໍ່ຮູ້ຜົນ, ແລະ ການເອີ້ນທີ່ພຽງອ່ານ.
		</p>
		<p>
			<strong>ບໍ່ມີການທົດລອງ.</strong> ບັນຊີຈ່າຍຕັ້ງແຕ່ມື້ທຳອິດ. ກ່ອນແຜນເລີ່ມ, KIFF ບໍ່ເລີ່ມການເຮັດວຽກຂອງ taf, ນອກຈາກການຕັ້ງຂອງ Coach; ບໍ່ມີຫຍັງຖືກລຶບ.
		</p>
		<p>
			<strong>ການຊຳລະ ແລະ ໃບແຈ້ງໜີ້.</strong> ແຜນຖືກເກັບເງິນໃນບ່ອນດຽວ. ແຜນທີ່ຊື້ໃນ kiff.dev ຖືກຊື້, ປ່ຽນ ແລະ ຍົກເລີກຢູ່ບ່ອນນັ້ນ ແລະ ໃນພອດທັນການເກັບເງິນທີ່ມັນລິ້ງໄປ, ແລະ ການຊຳລະຂອງມັນຖືກປະມວນຜົນໂດຍ Stripe. Solo ທີ່ຊື້ໃນແອັບ tafs ຖືກຂາຍຜ່ານ App Store ໃນ iPhone ແລະ iPad, ຫຼື Google Play ໃນ Android, ແລະ ຈັດການໃນການສະໝັກສະມາຊິກ Apple ຫຼື Google Play ຂອງທ່ານ, ພາຍໃຕ້ເງື່ອນໄຂຂອງຮ້ານນັ້ນສຳລັບການຊຳລະ, ການຕໍ່ອາຍຸ ແລະ ການຄືນເງິນ. ແພັກເຄຣດິດຖືກຊື້ໃນແອັບ. Company ຖືກຊື້ໃນ kiff.dev. ຄ່າທຳນຽມຖືກເກັບລາຍເດືອນລ່ວງໜ້າ; ການໃຊ້ທີ່ເກີນກວ່າທີ່ລວມຖືກເກັບກັບໃບແຈ້ງໜີ້ຕໍ່ໄປ. ການປ່ຽນຈຳນວນຄົນມີຜົນຕັ້ງແຕ່ໃບແຈ້ງໜີ້ຕໍ່ໄປ. ຖ້າການຊຳລະລົ້ມເຫຼວ ແລະ ບໍ່ໄດ້ແກ້ໄຂ, ແຜນສິ້ນສຸດ ແລະ KIFF ປະຕິເສດການເອີ້ນຂອງບັນຊີຈົນກວ່າຈະເລືອກແຜນ.
		</p>
		<p>
			<strong>ການຍົກເລີກ.</strong> ທ່ານຍົກເລີກໄດ້ທຸກເວລາໃນພອດທັນການເກັບເງິນ, ຫຼື, ສຳລັບ Solo ທີ່ຊື້ໃນແອັບ, ໃນການສະໝັກສະມາຊິກ Apple ຫຼື Google Play ຂອງທ່ານ. ແຜນດຳເນີນຈົນສິ້ນສຸດຮອບທີ່ທ່ານຈ່າຍ, ແລະ ບໍ່ຕໍ່ອາຍຸ. ຍົກເວັ້ນທີ່ກົດໝາຍກຳນົດ, ຄ່າທຳນຽມທີ່ຈ່າຍແລ້ວບໍ່ຄືນເງິນ. ຖ້າທ່ານເປັນຜູ້ບໍລິໂພກໃນສະຫະພາບເອີຣົບ, ທ່ານຖອນໄດ້ພາຍໃນ 14 ວັນຫຼັງການຊື້ໂດຍບໍ່ຕ້ອງໃຫ້ເຫດຜົນ, ແລະ ພວກເຮົາຄືນສິ່ງທີ່ທ່ານຈ່າຍ ລົບສ່ວນຂອງວັນທີ່ແຜນໄດ້ດຳເນີນໄປແລ້ວ. ການຊື້ Solo ຄືນເງິນຜ່ານ App Store ຫຼື Google Play, ພາຍໃຕ້ເງື່ອນໄຂຂອງພວກເຂົາ.
		</p>
		<p>
			<strong>ວິສາຫະກິດຂະໜາດຈິ໋ວ.</strong> ຖ້າທຸລະກິດຂອງທ່ານມີຄົນຕ່ຳກວ່າ 10 ຄົນ ແລະ ລາຍຮັບປະຈຳປີ ຫຼື ຍອດລວມຂອງໃບດຸນດ່ຽງບໍ່ເກີນ €2 ລ້ານ, ພວກເຮົາຖືວ່າມັນເປັນຜູ້ບໍລິໂພກສຳລັບທຸກກົດໃນເງື່ອນໄຂເຫຼົ່ານີ້ກ່ຽວກັບການຊຳລະດ້ວຍບັດ, ລວມທັງ Company.
		</p>
		<p>
			<strong>VAT.</strong> ລາຄາຂອງ Company ບໍ່ລວມ VAT; Solo ແລະ ແພັກເຄຣດິດຖືກຂາຍໂດຍ App Store ຫຼື Google Play ລວມ VAT. Kiff Agents OÜ (ເລກ VAT EE102924327) ເພີ່ມ VAT ຂອງເອສໂຕເນຍບ່ອນທີ່ໃຊ້ໄດ້. ການຂາຍທຸລະກິດຕໍ່ທຸລະກິດໃນສະຫະພາບເອີຣົບໃຫ້ລູກຄ້ານອກເອສໂຕເນຍທີ່ມີເລກປະຈຳຕົວ VAT ທີ່ຖືກຕ້ອງ ອອກໃບແຈ້ງໜີ້ພາຍໃຕ້ກົນໄກ reverse-charge ຂອງສະຫະພາບເອີຣົບ.
		</p>
		<p>
			<strong>ການປ່ຽນແປງ.</strong> ພວກເຮົາແຈ້ງບັນຊີທີ່ໃຊ້ງານຢ່າງໜ້ອຍສາມສິບວັນເປັນລາຍລັກອັກສອນກ່ອນການຂຶ້ນລາຄາ (§16). ການຫຼຸດລາຄາມີຜົນຕັ້ງແຕ່ໃບແຈ້ງໜີ້ຕໍ່ໄປ.
		</p>
	</section>
}

templ termsTermLO() {
	<section id="term">
		<h2>9. ໄລຍະເວລາ ແລະ ການສິ້ນສຸດ</h2>
		<p>
			ເງື່ອນໄຂເຫຼົ່ານີ້ມີຜົນເມື່ອທ່ານໃຊ້ບໍລິການຄັ້ງທຳອິດ ແລະ ດຳເນີນຕໍ່ໄປຈົນກວ່າຈະສິ້ນສຸດ.
		</p>
		<p>
			ທ່ານສິ້ນສຸດໄດ້ທຸກເວລາໂດຍການລຶບບັນຊີຂອງທ່ານ. ພວກເຮົາອາດສິ້ນສຸດ (ກ) ເມື່ອມີການລະເມີດຢ່າງຮ້າຍແຮງທີ່ບໍ່ໄດ້ແກ້ໄຂພາຍໃນສາມສິບວັນຫຼັງການແຈ້ງເປັນລາຍລັກອັກສອນ, ຫຼື (ຂ) ທັນທີສຳລັບການລະເມີດການໃຊ້ທີ່ຍອມຮັບໄດ້ ຫຼື ກໍລະນີລົ້ມລະລາຍ.
		</p>
		<p id="leaving">
			<strong>ການອອກໄປ, ແລະ ການເອົາຂໍ້ມູນຂອງທ່ານໄປນຳ.</strong> ທ່ານສົ່ງອອກຂໍ້ມູນຂອງທ່ານໄດ້ທຸກເວລາ, ໃນຮູບແບບທີ່ມີໂຄງສ້າງ ແລະ ເຄື່ອງອ່ານໄດ້: ໃນ KIFF, ການຕັ້ງຄ່າ → ຂໍ້ມູນ ໃຫ້ໄຟລ໌ JSON ທີ່ມີບັນຊີຂອງທ່ານ, Card ຂອງທ່ານພ້ອມທຸກເວີຊັນ, ການຕັດສິນໃນບັນທຶກຂອງທ່ານ (10.000 ອັນລ່າສຸດ; ຂໍເພີ່ມຈາກພວກເຮົາ), ໃບຮັບທີ່ລົງນາມຂອງແຕ່ລະອັນທີ່ KIFF ອະນຸຍາດ, ແລະ ລາຍລະອຽດຂອງກຸນແຈ API ຂອງທ່ານ (ບໍ່ເຄີຍມີກຸນແຈເອງ). ໃນແອັບ tafs, ແຕ່ລະຄົນສົ່ງອອກການສົນທະນາ, ໄຟລ໌ ແລະ ບັນທຶກຂອງຕົນເອງຈາກ ບັນຊີ → ສົ່ງອອກການສົນທະນາຂອງຂ້ອຍ; ການສົນທະນາຖືກເກັບສາມສິບວັນໃນທຸກກໍລະນີ, ຕາມທີ່ນະໂຍບາຍຄວາມເປັນສ່ວນຕົວບອກ. ການລຶບບັນຊີຂອງທ່ານສິ້ນສຸດບໍລິການທັນທີ, ສະນັ້ນສົ່ງອອກກ່ອນ.
		</p>
		<p>
			ທ່ານອາດອອກໄປດ້ວຍການແຈ້ງແທນ, ເພື່ອປ່ຽນໄປຜູ້ໃຫ້ບໍລິການອື່ນ ຫຼື ລະບົບຂອງທ່ານເອງ, ໂດຍຂຽນຫາ <a href="mailto:support@kiff.dev">support@kiff.dev</a>. ພວກເຮົາບໍ່ເຄີຍຮຽກຮ້ອງການແຈ້ງເກີນສອງເດືອນ: ການແຈ້ງຂອງທ່ານມີຜົນໃນວັນທີ່ທ່ານເລືອກ, ບໍ່ຊ້າກວ່າສອງເດືອນຫຼັງທ່ານສົ່ງ. ຕັ້ງແຕ່ວັນນັ້ນ, ໄລຍະປ່ຽນຜ່ານສາມສິບວັນຕາມມາ, ເຊິ່ງບໍລິການດຳເນີນຕໍ່, ທ່ານສົ່ງອອກຂໍ້ມູນ ແລະ ຍ້າຍວຽກຂອງທ່ານ, ແລະ ພວກເຮົາຊ່ວຍຕາມຄຳຂໍທີ່ສົມເຫດສົມຜົນ. ທ່ານຂະຫຍາຍໄລຍະປ່ຽນຜ່ານໄດ້ຄັ້ງດຽວ, ດົນເທົ່າທີ່ຕ້ອງການ. ຖ້າພວກເຮົາບໍ່ສາມາດເຮັດສຳເລັດທາງເທັກນິກໃນສາມສິບວັນ, ພວກເຮົາແຈ້ງທ່ານພາຍໃນສິບສີ່ວັນທຳການຫຼັງການແຈ້ງຂອງທ່ານ, ພ້ອມເຫດຜົນ ແລະ ໄລຍະໃໝ່ບໍ່ເກີນເຈັດເດືອນ. ຫຼັງໄລຍະປ່ຽນຜ່ານ, ຂໍ້ມູນຂອງທ່ານຍັງສົ່ງອອກໄດ້ຢ່າງໜ້ອຍສາມສິບວັນອີກ. ຄ່າທຳນຽມຂອງແຜນດຳເນີນຕາມປົກກະຕິຈົນໄລຍະປ່ຽນຜ່ານສິ້ນສຸດ. Solo ທີ່ຊື້ໃນ App Store ຫຼື Google Play ຖືກຍົກເລີກໃນຮ້ານ; ໄລຍະປ່ຽນຜ່ານ ແລະ ການສົ່ງອອກໃຊ້ແບບດຽວກັນ.
		</p>
		<p>
			ພວກເຮົາບໍ່ເກັບເງິນສຳລັບການອອກໄປ, ການປ່ຽນ ຫຼື ການສົ່ງອອກຂໍ້ມູນຂອງທ່ານ. ພາກນີ້ໃຫ້ສິດການປ່ຽນຜູ້ໃຫ້ບໍລິການຂອງໝວດ VI ຂອງກົດໝາຍຂໍ້ມູນຂອງສະຫະພາບເອີຣົບ (ກົດລະບຽບ (EU) 2023/2854) ແກ່ລູກຄ້າທຸກຄົນ.
		</p>
		<p>
			ເມື່ອສິ້ນສຸດ, ແລະ ຫຼັງໄລຍະປ່ຽນຜ່ານ ແລະ ການສົ່ງອອກໃດໆ, ພວກເຮົາລຶບຂໍ້ມູນການກວດສອບ, ຂໍ້ມູນ tafs ແລະ ຂໍ້ມູນເມຕາຂອງບັນຊີຂອງທ່ານຕາມກົດການເກັບຮັກສາໃນ <a href="/lo/privacy#retention">ນະໂຍບາຍຄວາມເປັນສ່ວນຕົວ</a>.
		</p>
		<p>
			ພາກທີ່ໂດຍທຳມະຊາດຄວນຢູ່ລອດຫຼັງການສິ້ນສຸດ ກໍຢູ່ລອດ — ລວມທັງການຮັກສາຄວາມລັບ, ຊັບສິນທາງປັນຍາ, ການຊົດໃຊ້, ຂີດຈຳກັດຄວາມຮັບຜິດຊອບ, ການປະຕິເສດ, ກົດໝາຍທີ່ໃຊ້ບັງຄັບ ແລະ ຄ່າທຳນຽມທີ່ຄ້າງ.
		</p>
	</section>
}

templ termsWarrantiesLO() {
	<section id="warranties">
		<h2>10. ການຮັບປະກັນ</h2>
		<p>
			ແຕ່ລະຝ່າຍຢືນຢັນວ່າຕົນມີສິດ ແລະ ອຳນາດເຂົ້າສູ່ ແລະ ປະຕິບັດເງື່ອນໄຂເຫຼົ່ານີ້.
		</p>
		<p>
			ພວກເຮົາຮັບປະກັນວ່າພວກເຮົາຈະໃຫ້ບໍລິການຢ່າງເປັນມືອາຊີບ ແລະ ສອດຄ່ອງຢ່າງສຳຄັນກັບເອກະສານ. ການແກ້ໄຂດຽວຂອງທ່ານສຳລັບການລະເມີດການຮັບປະກັນນີ້ແມ່ນ, ຕາມທາງເລືອກຂອງພວກເຮົາ, ການປະຕິບັດຄືນໃໝ່ ຫຼື ການຄືນຄ່າທຳນຽມຕາມສັດສ່ວນທີ່ກ່ຽວກັບບໍລິການທີ່ໄດ້ຮັບຜົນກະທົບໃນໄລຍະການລະເມີດ.
		</p>
		<p>
			ທ່ານຮັບປະກັນວ່າການໃຊ້ບໍລິການຂອງທ່ານປະຕິບັດຕາມກົດໝາຍທີ່ໃຊ້ໄດ້ ແລະ ເງື່ອນໄຂເຫຼົ່ານີ້.
		</p>
	</section>
}

templ termsDisclaimerLO() {
	<section id="disclaimer">
		<h2>11. ການປະຕິເສດ</h2>
		<p>
			ຍົກເວັ້ນການຮັບປະກັນຢ່າງຊັດແຈ້ງໃນ §10, ບໍລິການຖືກສະໜອງ <strong>"ຕາມສະພາບ" ແລະ "ຕາມທີ່ມີ"</strong>. ໃນຂອບເຂດສູງສຸດທີ່ກົດໝາຍອະນຸຍາດ, ພວກເຮົາປະຕິເສດການຮັບປະກັນອື່ນທັງໝົດ, ບໍ່ວ່າຈະຊັດແຈ້ງ, ໂດຍນັຍ ຫຼື ຕາມກົດໝາຍ, ລວມທັງການຮັບປະກັນຄວາມສາມາດໃນການຄ້າ, ຄວາມເໝາະສົມສຳລັບຈຸດປະສົງສະເພາະ, ການບໍ່ລະເມີດ, ແລະ ການຮັບປະກັນໃດທີ່ເກີດຈາກການດຳເນີນທຸລະກິດ ຫຼື ຮີດຄອງການຄ້າ.
		</p>
		<p>
			ພວກເຮົາບໍ່ຮັບປະກັນວ່າບໍລິການຈະບໍ່ຂັດຂ້ອງ, ບໍ່ມີຂໍ້ຜິດພາດ, ຫຼື ບໍ່ມີສ່ວນປະກອບທີ່ເປັນອັນຕະລາຍ, ຫຼື ວ່າຂໍ້ມູນໃດຈະບໍ່ສູນຫາຍ ຫຼື ເສຍຫາຍ. ທ່ານຮັບຜິດຊອບສຳຮອງຂໍ້ມູນຂອງທ່ານ.
		</p>
	</section>
}

templ termsLiabilityLO() {
	<section id="liability">
		<h2>12. ຂີດຈຳກັດຄວາມຮັບຜິດຊອບ</h2>
		<p>
			ໃນຂອບເຂດສູງສຸດທີ່ກົດໝາຍອະນຸຍາດ, ທັງສອງຝ່າຍບໍ່ຮັບຜິດຊອບຕໍ່ອີກຝ່າຍສຳລັບຄວາມເສຍຫາຍທາງອ້ອມ, ບັງເອີນ, ຕາມມາ, ພິເສດ, ເປັນແບບຢ່າງ ຫຼື ລົງໂທດ, ລວມທັງກຳໄລທີ່ສູນເສຍ, ລາຍຮັບທີ່ສູນເສຍ, ຂໍ້ມູນທີ່ສູນເສຍ ຫຼື ການຂັດຂວາງທຸລະກິດ, ທີ່ເກີດຈາກ ຫຼື ກ່ຽວຂ້ອງກັບເງື່ອນໄຂເຫຼົ່ານີ້ ຫຼື ບໍລິການ, ເຖິງແມ່ນໄດ້ຮັບແຈ້ງເຖິງຄວາມເປັນໄປໄດ້ຂອງຄວາມເສຍຫາຍດັ່ງກ່າວ.
		</p>
		<p>
			ຄວາມຮັບຜິດຊອບລວມຂອງແຕ່ລະຝ່າຍທີ່ເກີດຈາກ ຫຼື ກ່ຽວຂ້ອງກັບເງື່ອນໄຂເຫຼົ່ານີ້ຈະບໍ່ເກີນຈຳນວນທີ່ສູງກວ່າລະຫວ່າງ (ກ) ຄ່າທຳນຽມທີ່ລູກຄ້າຈ່າຍ ຫຼື ຕ້ອງຈ່າຍໃຫ້ Kiff Agents OÜ ໃນສິບສອງເດືອນກ່ອນເຫດການທີ່ເຮັດໃຫ້ເກີດຄວາມຮັບຜິດຊອບ, ຫຼື (ຂ) ໜຶ່ງແສນເອີໂຣ (€100.000).
		</p>
		<p>
			ບໍ່ມີຫຍັງໃນເງື່ອນໄຂເຫຼົ່ານີ້ຈຳກັດ ຫຼື ຍົກເວັ້ນຄວາມຮັບຜິດຊອບທີ່ຈຳກັດ ຫຼື ຍົກເວັ້ນບໍ່ໄດ້ພາຍໃຕ້ກົດໝາຍທີ່ໃຊ້ໄດ້, ລວມທັງຄວາມຮັບຜິດຊອບຕໍ່ການເສຍຊີວິດ, ການບາດເຈັບສ່ວນບຸກຄົນທີ່ເກີດຈາກຄວາມປະໝາດ, ການສໍ້ໂກງ ຫຼື ການກະທຳໂດຍເຈດຕະນາ, ແລະ ຄວາມຮັບຜິດຊອບຕໍ່ຜະລິດຕະພັນທີ່ມີຂໍ້ບົກພ່ອງພາຍໃຕ້ກົດໝາຍທີ່ບັງຄັບໃຊ້ຄຳສັ່ງ (EU) 2024/2853 ວ່າດ້ວຍຄວາມຮັບຜິດຊອບຕໍ່ຜະລິດຕະພັນທີ່ມີຂໍ້ບົກພ່ອງ.
		</p>
	</section>
}

templ termsIndemnityLO() {
	<section id="indemnification">
		<h2>13. ການຊົດໃຊ້</h2>
		<p>
			ພວກເຮົາຈະປ້ອງກັນທ່ານຈາກການຮຽກຮ້ອງຂອງບຸກຄົນທີສາມວ່າບໍລິການ, ດັ່ງທີ່ພວກເຮົາສະໜອງ ແລະ ທ່ານໃຊ້ຕາມເງື່ອນໄຂເຫຼົ່ານີ້, ລະເມີດສິດຊັບສິນທາງປັນຍາຂອງບຸກຄົນທີສາມນັ້ນ, ແລະ ພວກເຮົາຈະຈ່າຍຄ່າເສຍຫາຍທີ່ຕັດສິນສຸດທ້າຍຕໍ່ທ່ານ (ຫຼື ຈຳນວນການປະນີປະນອມທີ່ຕົກລົງ) ສຳລັບການຮຽກຮ້ອງດັ່ງກ່າວ.
		</p>
		<p>
			ທ່ານຈະປ້ອງກັນພວກເຮົາຈາກການຮຽກຮ້ອງຂອງບຸກຄົນທີສາມທີ່ເກີດຈາກ (ກ) ຂໍ້ມູນ ຫຼື ເນື້ອຫາລູກຄ້າຂອງທ່ານ; (ຂ) ການໃຊ້ບໍລິການຂອງທ່ານທີ່ລະເມີດເງື່ອນໄຂເຫຼົ່ານີ້ (ລວມທັງ AUP); ຫຼື (ຄ) ຄວາມປະໝາດຮ້າຍແຮງ ຫຼື ການກະທຳໂດຍເຈດຕະນາຂອງທ່ານ, ແລະ ທ່ານຈະຈ່າຍຄ່າເສຍຫາຍທີ່ຕັດສິນສຸດທ້າຍຕໍ່ພວກເຮົາ (ຫຼື ຈຳນວນການປະນີປະນອມທີ່ຕົກລົງ) ສຳລັບການຮຽກຮ້ອງດັ່ງກ່າວ.
		</p>
		<p>
			ການຊົດໃຊ້ມີເງື່ອນໄຂວ່າໄດ້ແຈ້ງການຮຽກຮ້ອງທັນທີ, ຜູ້ຊົດໃຊ້ຄວບຄຸມການປ້ອງກັນ ແລະ ການປະນີປະນອມພຽງຜູ້ດຽວ, ແລະ ຜູ້ຮັບການຊົດໃຊ້ໃຫ້ຄວາມຮ່ວມມືຢ່າງສົມເຫດສົມຜົນ. ຜູ້ຊົດໃຊ້ບໍ່ອາດປະນີປະນອມການຮຽກຮ້ອງທີ່ກຳນົດພັນທະແກ່ຜູ້ຮັບການຊົດໃຊ້ໂດຍບໍ່ໄດ້ຮັບຄວາມຍິນຍອມ.
		</p>
	</section>
}

templ termsSLALO() {
	<section id="sla">
		<h2>14. ຄຳໝັ້ນສັນຍາລະດັບການບໍລິການ</h2>
		<p>
			ໃນແຜນແບບຈ່າຍເງິນ, <a href="/legal/sla">ຂໍ້ຕົກລົງລະດັບການບໍລິການ</a> (ເປັນພາສາອັງກິດ) ກຳນົດຄວາມພ້ອມໃຊ້ທີ່ພວກເຮົາໝັ້ນສັນຍາ, ວິທີນັບຄຳຂໍທີ່ຊ້າ ຫຼື ລົ້ມເຫຼວ, ເວລາຕອບສະໜອງຂອງການສະໜັບສະໜູນ, ແລະ ເຄຣດິດບໍລິການເມື່ອພວກເຮົາບໍ່ຖືກຕາມທີ່ກຳນົດ. ມັນເປັນສ່ວນໜຶ່ງຂອງເງື່ອນໄຂເຫຼົ່ານີ້.
		</p>
		<p>
			ການປະຕິບັດງານ, ການຕອບສະໜອງເຫດການ, ແລະ ຄຳໝັ້ນສັນຍາການແຈ້ງການລະເມີດ ຖືກບັນທຶກໄວ້ໃນສະບັບທີ່ລົງວັນທີ ເຊິ່ງລິ້ງຈາກເງື່ອນໄຂເຫຼົ່ານີ້ (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>); <a href="/security">/security</a> (ເປັນພາສາອັງກິດ) ສະແດງການປະຕິບັດປັດຈຸບັນ.
		</p>
	</section>
}

templ termsServiceModsLO() {
	<section id="service-mods">
		<h2>15. ການປ່ຽນແປງບໍລິການ</h2>
		<p>
			ພວກເຮົາອາດເພີ່ມ, ປ່ຽນ ຫຼື ລຶບຄຸນສົມບັດໄດ້ທຸກເວລາ. ການຫຼຸດຟັງຊັນຢ່າງສຳຄັນ ຫຼື ການເຊົາໃຊ້ພື້ນຜິວ API ທີ່ເຮັດໃຫ້ພຶດຕິກຳທີ່ບັນທຶກໄວ້ເສຍຫາຍ ຖືກແຈ້ງລູກຄ້າທີ່ໃຊ້ງານຢ່າງໜ້ອຍສາມສິບວັນລ່ວງໜ້າ, ພ້ອມກຳນົດການເຊົາໃຊ້ທີ່ເຜີຍແຜ່. ການປ່ຽນແປງດ້ານຄວາມປອດໄພອາດເຮັດໂດຍບໍ່ແຈ້ງ ເມື່ອການແຈ້ງຈະສ້າງຄວາມສ່ຽງເອງ.
		</p>
	</section>
}

templ termsTermsModsLO() {
	<section id="terms-mods">
		<h2>16. ການປ່ຽນແປງເງື່ອນໄຂເຫຼົ່ານີ້</h2>
		<p>
			ພວກເຮົາອາດແກ້ໄຂເງື່ອນໄຂເຫຼົ່ານີ້ເປັນບາງຄັ້ງ. ການປ່ຽນແປງທີ່ສຳຄັນຖືກແຈ້ງທາງອີເມວ ແລະ ແບນເນີທີ່ເດັ່ນຊັດໃນໜ້ານີ້ຢ່າງໜ້ອຍສາມສິບວັນລ່ວງໜ້າ. ການປ່ຽນແປງທີ່ບໍ່ສຳຄັນ (ການຊີ້ແຈງ, ການອ້າງອີງ) ຖືກເຜີຍແຜ່ພ້ອມວັນທີ "ອັບເດດຄັ້ງຫຼ້າສຸດ" ໃໝ່. ການທີ່ທ່ານສືບຕໍ່ໃຊ້ບໍລິການຫຼັງວັນທີມີຜົນຂອງການອັບເດດ ຖືວ່າເປັນການຍອມຮັບ.
		</p>
	</section>
}

templ termsForceMajeureLO() {
	<section id="force-majeure">
		<h2>17. ເຫດສຸດວິໄສ</h2>
		<p>
			ທັງສອງຝ່າຍບໍ່ຮັບຜິດຊອບຕໍ່ຄວາມລົ້ມເຫຼວ ຫຼື ຄວາມຊັກຊ້າໃນການປະຕິບັດ ໃນຂອບເຂດທີ່ເກີດຈາກສະຖານະການນອກເໜືອການຄວບຄຸມທີ່ສົມເຫດສົມຜົນ, ລວມທັງໄພທຳມະຊາດ, ສົງຄາມ, ການກໍ່ການຮ້າຍ, ຄວາມວຸ້ນວາຍພົນລະເມືອງ, ຂໍ້ຂັດແຍ້ງແຮງງານ, ໄຟໄໝ້, ໄພພິບັດທຳມະຊາດ, ມາດຕະການຂອງລັດຖະບານທີ່ກ່ຽວກັບການລະບາດ, ອິນເຕີເນັດ ຫຼື ໄຟຟ້າຂັດຂ້ອງ, ຫຼື ການກະທຳຂອງຜູ້ໃຫ້ບໍລິການໂທລະຄົມມະນາຄົມ ຫຼື ໂຄງສ້າງພື້ນຖານໂຮສຕິງຂອງບຸກຄົນທີສາມ.
		</p>
	</section>
}

templ termsGoverningLawLO() {
	<section id="governing-law">
		<h2>18. ກົດໝາຍທີ່ໃຊ້ບັງຄັບ ແລະ ສະຖານທີ່ພິຈາລະນາ</h2>
		<p>
			ເງື່ອນໄຂເຫຼົ່ານີ້ຢູ່ພາຍໃຕ້ກົດໝາຍຂອງສາທາລະນະລັດເອສໂຕເນຍ, ໂດຍບໍ່ຄຳນຶງເຖິງກົດຂັດກັນຂອງກົດໝາຍ. ສານສະເພາະສຳລັບຂໍ້ຂັດແຍ້ງແມ່ນສານເຂດ Harju ໃນ Tallinn.
		</p>
		<p>
			ບ່ອນທີ່ທ່ານເປັນຜູ້ບໍລິໂພກທີ່ອາໄສຢູ່ໃນລັດສະມາຊິກ EU ອື່ນ, ກົດປົກປ້ອງຜູ້ບໍລິໂພກທີ່ບັງຄັບຂອງເຂດອຳນາດບ້ານເກີດຂອງທ່ານຍັງໃຊ້ຕໍ່ໄປ ໃນຂອບເຂດທີ່ມັນໃຫ້ສິດທີ່ທ່ານສະລະດ້ວຍສັນຍາບໍ່ໄດ້; ຂໍ້ນີ້ບໍ່ໄດ້ຕັດສິດການປົກປ້ອງຂອງກົດເຫຼົ່ານັ້ນຂອງທ່ານ.
		</p>
	</section>
}

templ termsGeneralLO() {
	<section id="general">
		<h2>19. ທົ່ວໄປ</h2>
		<p>
			<strong>ຂໍ້ຕົກລົງທັງໝົດ.</strong> ເງື່ອນໄຂເຫຼົ່ານີ້, ພ້ອມນະໂຍບາຍຄວາມເປັນສ່ວນຕົວ, DPA, ໃບສັ່ງຊື້ໃດໆ, ແລະ ເງື່ອນໄຂເພີ່ມເຕີມທີ່ລວມຢ່າງຊັດແຈ້ງ, ເປັນຂໍ້ຕົກລົງທັງໝົດລະຫວ່າງພວກເຮົາໃນຫົວຂໍ້ຂອງມັນ ແລະ ແທນທີ່ຄວາມເຂົ້າໃຈກ່ອນໜ້າ ຫຼື ພ້ອມກັນໃດໆ.
		</p>
		<p>
			<strong>ການແຍກໄດ້.</strong> ຖ້າຂໍ້ກຳນົດໃດຖືກຖືວ່າບັງຄັບໃຊ້ບໍ່ໄດ້, ສ່ວນທີ່ເຫຼືອຍັງມີຜົນ.
		</p>
		<p>
			<strong>ການໂອນສິດ.</strong> ທ່ານບໍ່ອາດໂອນເງື່ອນໄຂເຫຼົ່ານີ້ໂດຍບໍ່ໄດ້ຮັບຄວາມຍິນຍອມເປັນລາຍລັກອັກສອນຂອງພວກເຮົາ. ພວກເຮົາອາດໂອນໂດຍບໍ່ຕ້ອງໄດ້ຮັບຄວາມຍິນຍອມກ່ຽວກັບການຄວບລວມ, ການຊື້ກິດຈະການ ຫຼື ການຂາຍຊັບສິນທັງໝົດ ຫຼື ເກືອບທັງໝົດຂອງພວກເຮົາ, ໂດຍແຈ້ງທ່ານ.
		</p>
		<p>
			<strong>ການບໍ່ສະລະສິດ.</strong> ການບໍ່ບັງຄັບໃຊ້ຂໍ້ກຳນົດໃດບໍ່ແມ່ນການສະລະສິດທີ່ຈະບັງຄັບໃຊ້ມັນພາຍຫຼັງ.
		</p>
		<p>
			<strong>ການແຈ້ງການ.</strong> ການແຈ້ງການຫາ Kiff Agents OÜ ສົ່ງໄປທີ່ <a href="mailto:legal@kiff.dev">legal@kiff.dev</a> ຫຼື, ທາງໄປສະນີ, ໄປທີ່ Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, ເອສໂຕເນຍ. ການແຈ້ງການຫາທ່ານສົ່ງໄປທີ່ອີເມວທີ່ກ່ຽວຂ້ອງກັບບັນຊີຂອງທ່ານ ຫຼື, ຖ້າທ່ານໃຫ້ໄວ້, ທີ່ຢູ່ແຈ້ງການທາງກົດໝາຍທີ່ທ່ານກຳນົດ.
		</p>
		<p>
			<strong>ຜູ້ຮັບເໝົາເອກະລາດ.</strong> ບໍ່ມີຫຍັງໃນເງື່ອນໄຂເຫຼົ່ານີ້ສ້າງຄວາມສຳພັນຫຸ້ນສ່ວນ, ຕົວແທນ, ວິສາຫະກິດຮ່ວມ ຫຼື ການຈ້າງງານ.
		</p>
		<p>
			<strong>ຜູ້ໄດ້ຮັບຜົນປະໂຫຍດຂອງບຸກຄົນທີສາມ.</strong> ບໍ່ມີ, ຍົກເວັ້ນໃນຂອບເຂດທີ່ບໍລິສັດໃນເຄືອທີ່ໄດ້ຮັບການຊົດໃຊ້ຖືກລະບຸຢ່າງຊັດແຈ້ງ.
		</p>
	</section>
}

templ termsContactLO() {
	<section id="contact">
		<h2>20. ຕິດຕໍ່ພວກເຮົາ</h2>
		<p>
			ຄຳຖາມທາງການຄ້າ ແລະ ສັນຍາ: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
		<p>
			ຄຳຖາມທົ່ວໄປກ່ຽວກັບຜະລິດຕະພັນ: <a href="mailto:hello@kiff.dev">hello@kiff.dev</a>. ຄຳຖາມກ່ຽວກັບຄວາມເປັນສ່ວນຕົວ: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>. ການເປີດເຜີຍດ້ານຄວາມປອດໄພ: <a href="mailto:security@kiff.dev">security@kiff.dev</a>.
		</p>

		<hr/>

		<p class="legal-footnote">
			<strong>ເວີຊັນເອກະສານ:</strong> v0.1.<br/> <strong>ອັບເດດຄັ້ງຫຼ້າສຸດ:</strong> 22 ພະຈິກ 2026.
		</p>
	</section>
}
