package pages

import "github.com/kiff/cloud/web/internal/components"

// PrivacySK is the privacy policy (/privacy) in Slovak, at /sk/privacy.
// It is a translation of Privacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English
// page governs. Change the English page first, then this one. Slovak has
// the legal texts only, so a link to any other page goes to English and
// says so.
templ PrivacySK() {
	@components.LayoutSite("KIFF — zásady ochrany osobných údajov", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@privacyHeadSK()
			@privacyWhoWeAreSK()
			@privacyScopeSK()
			@privacyRolesSK()
			@privacyCategoriesSK()
			@privacyLawfulBasesSK()
			@privacySubprocessorsSK()
			@privacyTransfersSK()
			@privacyRetentionSK()
			@privacyRightsSK()
			@privacyCookiesSK()
			@privacySecuritySK()
			@privacyChildrenSK()
			@privacyAutomatedSK()
			@privacyChangesSK()
			@privacyContactSK()
		</article>
	}
}

templ privacyHeadSK() {
	<header class="legal-head">
		<p class="legal-badge">Zásady ochrany osobných údajov · v0.1</p>
		<h1>Zásady ochrany osobných údajov</h1>
		<p class="legal-meta">
			<strong>Posledná aktualizácia:</strong> 24. novembra 2026.
			<strong>Dátum účinnosti:</strong> 24. mája 2026.
		</p>
		<p class="legal-disclaimer">
			Tieto zásady vysvetľujú, ako KIFF Cloud spracúva osobné
			údaje na webe, v ovládacom paneli, v API a v aplikácii tafs
			pre iPhone, iPad, Android a počítače. Otázky:
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</header>
}

templ privacyWhoWeAreSK() {
	<section id="who-we-are">
		<h2>1. Kto sme</h2>
		<p>
			KIFF Cloud prevádzkuje <strong>Kiff Agents OÜ</strong>,
			spoločnosť s ručením obmedzeným založená v Estónsku.
			Údaje z registra:
		</p>
		<ul>
			<li><strong>Registračný kód:</strong> 17372313 (estónsky obchodný register e-Business Register)</li>
			<li><strong>IČ DPH:</strong> EE102924327</li>
			<li><strong>Sídlo:</strong> Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estónsko</li>
			<li><strong>Kontakt pre ochranu osobných údajov:</strong> <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a></li>
			<li><strong>Formálne právne oznámenia:</strong> <a href="mailto:legal@kiff.dev">legal@kiff.dev</a></li>
		</ul>
		<p>
			Keďže Kiff Agents OÜ je usadená v Európskej únii, na naše
			spracúvanie sa priamo vzťahuje všeobecné nariadenie EÚ
			o ochrane údajov
			(<abbr title="General Data Protection Regulation">GDPR</abbr>).
			Nepotrebujeme zástupcu v EÚ podľa článku 27.
		</p>
	</section>
}

templ privacyScopeSK() {
	<section id="scope">
		<h2>2. Rozsah týchto zásad</h2>
		<p>
			Tieto zásady sa vzťahujú na osobné údaje, ktoré spracúvame,
			keď používate:
		</p>
		<ul>
			<li><a href="https://kiff.dev"><code>kiff.dev</code></a> — náš marketingový web, túto stránku so zásadami a verejné zobrazenie potvrdení.</li>
			<li><a href="https://app.kiff.dev"><code>app.kiff.dev</code></a> — náš ovládací panel, ktorý vyžaduje prihlásenie.</li>
			<li><a href="https://api.kiff.dev"><code>api.kiff.dev</code></a> — naše HTTP API.</li>
			<li id="tafs"><strong>tafs</strong> — našu aplikáciu pre iPhone, iPad, Android a počítače (Mac, Windows a Linux) a službu za ňou (vrátane Setupu, ktorý pripája nástroje spoločnosti, a planque, ktorý tieto pripojenia uchováva), v ktorej spoločnosť zverí úlohu AI agentovi, ktorý pracuje v rámci KIFF Cards.</li>
		</ul>
		<p>
			Tieto zásady sa <em>nevzťahujú</em> na open-source framework
			<code>kiff/kiff</code>, ktorý môžete prevádzkovať sami.
			Keď framework prevádzkujete na vlastnej infraštruktúre, ste
			prevádzkovateľom všetkých údajov, ktoré spracúva, a Kiff
			Agents OÜ sa na tomto spracúvaní nepodieľa.
		</p>
	</section>
}

templ privacyRolesSK() {
	<section id="roles">
		<h2>3. Naše úlohy podľa GDPR</h2>
		<p>
			Podľa druhu údajov vystupujeme v dvoch úlohách:
		</p>
		<ul>
			<li>
				<strong>Prevádzkovateľ</strong> pri metaúdajoch účtu
				a prihlásenia, fakturačných údajoch (ak je fakturácia
				aktívna), marketingových oznámeniach, na ktorých odber
				sa prihlásite, a prevádzkovej telemetrii našej vlastnej
				služby.
			</li>
			<li>
				<strong>Sprostredkovateľ</strong> pri auditných údajoch,
				záznamoch o akciách, potvrdeniach rozhodnutí a ďalšom
				obsahu, ktorý prechádza runtime prostredím v mene našich
				zákazníkov, a pri tom, čo pre nich uchováva tafs (behy každého tafu, chaty, hlásenia, poznámky v pamäti a súbory, ktoré doručia).
				Prevádzkovateľmi týchto údajov sú zákazníci (tenanti);
				dávajú nám pokyny prostredníctvom nastavení svojho účtu
				a konfigurácie domény. Tento vzťah upravuje zmluva
				o spracúvaní osobných údajov
				(<abbr title="Data Processing Agreement">DPA</abbr>);
				zverejnené podmienky nájdete vo
				<a href="/legal/dpa">vzore DPA</a> (v angličtine).
			</li>
		</ul>
		<p>
			Tieto zásady sa zaoberajú predovšetkým spracúvaním, pri
			ktorom sme prevádzkovateľom. Tam, kde spomíname údaje,
			pri ktorých sme sprostredkovateľom, je konkrétnejším
			dokumentom DPA.
		</p>
	</section>
}

templ privacyCategoriesSK() {
	<section id="categories">
		<h2>4. Kategórie osobných údajov, ktoré spracúvame</h2>
		<p>
			Kategórie uvedené nižšie zodpovedajú technickému prehľadu na
			<a href="/security#data-we-process">/security#data-we-process</a> (v angličtine).
			Ak sa tieto dve stránky líšia, rozhoduje technická stránka
			a tento oddiel upravíme tak, aby jej zodpovedal.
		</p>
		<ul>
			<li>
				<strong>Identifikátory účtu</strong> — váš identifikátor
				pri nadradenom overovaní (vydaný naším poskytovateľom
				identity) a e-mailová adresa, ktorou sa prihlasujete.
				Dnes sa ukladajú v pôvodnej podobe; ukladanie
				v hašovanej podobe sa plánuje.
				Ak zapnete prihlasovanie kódom poslaným e-mailom (je vypnuté, kým to neurobíte), KIFF uchováva toto nastavenie s vaším prihlasovacím ID a dátumom zmeny. Kód, ktorý vám pošleme e-mailom, sa uchováva len ako kľúčovaný odtlačok, kým sa nepoužije alebo neuplynie desať minút. Aby sme obmedzili zneužitie, uchovávame až jeden deň počet požiadaviek podľa kľúčovaného odtlačku adresy, ktorá o kód požiadala, a IP adresy. Po prihlásení kódom si to poznačíme na štvrť hodiny, aby vás zmeny vyžadujúce čerstvé prihlásenie vyzvali na prihlásenie iným spôsobom.
			</li>
			<li>
				<strong>Metaúdaje tenanta</strong> — ID tenanta, slug,
				zobrazovaný názov, časová pečiatka vytvorenia a jazyk,
				ktorý naposledy používala aplikácia každej osoby, aby
				e-maily, ktoré jej KIFF posiela, prichádzali v tomto jazyku.
			</li>
			<li>
				<strong>Prístupové údaje k API</strong> — nepriehľadné
				záznamy kľúčov API (ukladáme haše, nikdy nie čistý text).
			</li>
			<li>
				<strong>Údaje relačného cookie</strong> — relačné cookie
				podpísané pomocou HMAC, nastavené po prihlásení. Pozrite
				oddiel o cookies nižšie.
			</li>
			<li>
				<strong>Metaúdaje požiadaviek HTTP</strong> — IP adresa,
				user agent, cesta požiadavky, stav odpovede, latencia.
				Uchovávajú sa v prístupových záznamoch nášho reverzného
				proxy počas obmedzeného obdobia kvôli bezpečnosti
				a predchádzaniu zneužitiu.
			</li>
			<li>
				<strong>Obsah riadený tenantom</strong> — údaje
				<code>parameters</code>, <code>actor</code>
				a <code>entity</code>, ktoré posielate do runtime
				prostredia. Uchovávame ich <em>ako sprostredkovateľ</em>
				v mene zákazníka; za to, čo sa odošle, zodpovedá
				zákazník. Konfigurácia začiernenia pre jednotlivé
				domény sa plánuje.
			</li>
			<li>
				<strong>Komunikácia</strong> — e-maily, ktoré posielate
				do našich schránok podpory, obchodu, bezpečnosti alebo
				ochrany osobných údajov.
			</li>
			<li>
				<strong>Aplikácia tafs</strong> — do tafs sa prihlasujete
				svojím účtom KIFF. Na telefóne alebo tablete aplikácia
				uchováva vašu reláciu v Keychain zariadenia (v Androide
				v jeho šifrovanom úložisku). Na počítači ju uchováva
				zapečatenú pre váš používateľský účet: na počítači
				s Windows pomocou vlastnej ochrany údajov Windows,
				v Linuxe vo vašej kľúčenke, v Macu v jeho Keychain.
				Relácia na počítači trvá najviac 90 dní.
				Aplikácia vytvorí podpisový kľúč, ktorý nikdy neopustí
				zariadenie: v Secure Enclave iPhonu, iPadu alebo Macu,
				v Keystore zariadenia s Androidom alebo v TPM počítača
				s Windows. V Linuxe a na Macu bez Secure Enclave je
				kľúč softvérový kľúč uchovávaný vo vašej kľúčenke alebo
				v Keychain a taký počítač môže zobraziť, čo na vás
				čaká, ale nemôže to schváliť; schvaľujete na telefóne{ macSecurityKey("sk") }. Počítač s Windows
				bez TPM sa do tafs prihlásiť nemôže. KIFF uchováva verejnú polovicu kľúča, názov
				a platformu zariadenia a kedy bolo pridané a naposledy
				použité, aby mohol overovať vaše odpovede na pozdržané
				volania a vaše schválenia pripojení. Ak schvaľujete
				prístupovým kľúčom na počítači, napríklad
				Windows Hello alebo bezpečnostným kľúčom, vaša tvár,
				odtlačok prsta alebo PIN zostáva vo vlastnom systéme
				počítača; KIFF uchováva verejný kľúč prístupového kľúča,
				jeho ID, počítadlo a názov, nikdy nič tajné, a odmietne
				prístupový kľúč, ktorý sa synchronizuje do iných
				zariadení. Ak zapnete upozornenia na telefóne, tablete
				alebo Macu s aplikáciou pre iPad, uchovávame push token
				zariadenia s vaším ID osoby v KIFF a jazyk, ktorý
				aplikácia zobrazovala, aby jeho upozornenia prichádzali
				v tomto jazyku. Služba tafs uchováva aj jazyk účtu, podľa
				toho, kto naposledy chatoval s Coachom, najviac tri
				mesiace, aby hlásenia tafu prichádzali v tomto jazyku.
				Upozornenie telefónu prechádza cez Apple alebo Google
				iba s tým, o ktorý taf ide a čo chce, a v upozornení
				dverí s menom alebo e-mailovou adresou toho, kto napísal:
				nikdy so sumou ani podrobnosťami požiadavky. Tie doplní
				aplikácia priamo v zariadení, od KIFF, takže upozornenie
				na odomknutom telefóne môže zobraziť sumu, obchodníka
				alebo osobu. Na zamknutom telefóne s Androidom zobrazí
				iba „Taf vás potrebuje“ a na zamknutom iPhone tiež, ak
				ste nenastavili, aby sa jeho náhľady zobrazovali vždy. <strong>Vaše hodinky:</strong> hodinky neuchovávajú žiadne heslo ani kľúč, komunikujú iba s vaším spárovaným telefónom a nikdy nič neschvaľujú. To, čo poviete Coachovi alebo tafu, ktorý ste zvolili, posielajú iba ako text, cez telefón, a to až potom, čo povolíte AI. Vaše slová na tento text prevádza vlastná služba rozpoznávania reči hodiniek, od Applu alebo Googlu. Ak vo Wear OS skončí skôr, ako dohovoríte, urobí to namiesto nej vlastný rozpoznávač vášho telefónu, priamo v telefóne. Odmietnuť, zastaviť alebo poslať niečo Coachovi či tafu môžu hodinky iba vtedy, keď majú zámku obrazovky alebo kód a sú odomknuté. To, čo pošlete tafu, sa dostane do vlastného chatu tohto tafu, ako keby ste to napísali na telefóne. Chat tafu, vrátane súm, sa číta cez telefón vždy, keď je otvorený, a hodinky uchovávajú len nedávne správy opísané v ich časti nižšie. <strong>Apple Watch:</strong> zobrazujú vaše tafy a ich stránky bez toho, aby ich uchovávali. Uchovávajú vaše Doručené, v súbore, ktorý nemôžu čítať, keď sú zamknuté: každé pozdržané volanie ako názov jeho tafu a to, o čo žiada, nikdy sumu, a odpovede Coacha na to, čo ste poslali z hodiniek, ako text. Ak sa na hodinkách odhlásite, uchovávajú aj to, že ste to urobili, kým sa na hodinkách znova neprihlásite. Okrem toho neuchovávajú nič, ak hodinky nemajú kód. Doručené zmiznú, keď sa odhlásite na hodinkách alebo sa odhlási váš iPhone, alebo keď sa aplikácia nabudúce otvorí alebo zatvorí bez kódu. Nevytvárajú žiadny záznam a jediné upozornenia, ktoré zobrazujú, sú upozornenia vášho iPhonu. Aby sa konverzácia otvorila hneď, uchovávajú aj posledných 30 správ z každej z najviac 20 konverzácií, ktoré ste na nich otvorili, od Coacha a vašich tafov, len ako text a nikdy nie sumu, zamknuté ako schránka Doručené; zmiznú spolu so schránkou a keď konverzácia nebola otvorená 30 dní. <strong>Wear OS:</strong> zobrazujú e-mail vášho účtu a dnešný kalendár bez toho, aby ich uchovávali. Aby sa otvorili okamžite, uchovávajú šifrovane počet toho, čo na vás čaká, a názov každého tafu a to, či je zastavený alebo pozastavený: nikdy sumu, podrobnosti pozdržaného volania ani chat tafu. To sa vymaže, keď sa odhlásite, keď sa hodinky zamknú alebo ich zložíte zo zápästia, a po 24 hodinách. Uchovávajú vaše Doručené, kde je každý riadok názov tafu a to, čo hovorí, nikdy suma, a jednu správu odloženú na neskôr, ako text. Odhlásenie, na hodinkách alebo na telefóne, to všetko vymaže. Pre svoju dlaždicu uchovávajú aj počet toho, čo na vás čaká, zobrazený iba vtedy, keď sú hodinky odomknuté, a vymazaný, keď sa odhlásite, alebo keď sa dlaždica nabudúce zobrazí, keď sú hodinky zamknuté alebo nemajú zámku obrazovky. Po odhlásení na hodinkách si uchovajú poznámku, že ste to urobili, kým sa znova neprihlásite. Doručené zmiznú aj vtedy, keď sa aplikácia nabudúce otvorí alebo zatvorí, keď sú hodinky zamknuté alebo nemajú zámku obrazovky. Správa odložená na neskôr zostáva, kým ju neodošlete alebo nevymažete, pretože ste požiadali o jej odoslanie. Ak služba rozpoznávania reči hodiniek skončí skôr, ako dohovoríte, hodinky pošlú nahrávku do vášho telefónu, ktorý ju prevedie na text priamo v telefóne, nikdy nie na serveri. Aby sa konverzácia otvorila hneď, uchovávajú aj posledných 30 správ z každej z najviac 20 konverzácií, ktoré ste na nich otvorili, od Coacha a vašich tafov, len ako text a nikdy nie sumu, šifrované; zmiznú, keď sa odhlásite na hodinkách alebo v telefóne, a keď konverzácia nebola otvorená 30 dní, a hodinky bez zámky obrazovky neuchovávajú žiadnu. Nahrávka sa vymaže na oboch zariadeniach, len čo sa text vráti alebo akciu zrušíte, a najneskôr po 2 minútach. Coachovi alebo vášmu tafu pokračuje iba text. Výsledok tafu môže zostať v upozorneniach hodiniek, kým ho nezavriete alebo sa na hodinkách neodhlásite. Na počítači s Windows,
				počítači s Linuxom alebo Macu s aplikáciou pre macOS 12
				vytvára upozornenia sama aplikácia, kým beží, bez push
				tokenu a bez akejkoľvek inej spoločnosti. Vo Windows
				a Linuxe zobrazujú, o ktorý taf ide, čo chce urobiť,
				sumu, prečo a do kedy; v aplikácii pre macOS 12 zobrazujú
				slová KIFF pre dané volanie, keď ich zapnete, a zamknutá
				obrazovka zobrazí to, čo dovolí nastavenie náhľadov Macu.
				Vo Windows sú vypnuté,
				kým ich nezapnete, a keď je obrazovka zamknutá,
				zobrazujú iba „Taf vás potrebuje“. Upozornenie zobrazené
				pred zamknutím obrazovky si svoje podrobnosti
				ponechá v zozname oznámení Windows. V Linuxe sú
				zapnuté, kým ich nevypnete, a čo zobrazí zamknutá
				obrazovka, závisí od vášho prostredia pracovnej plochy.
				Keď pripájate nástroj, prihlasujete sa u jeho vlastného poskytovateľa. Pri aplikácii, do ktorej sa planque prihlasuje sám, napríklad Stripe, alebo pri kľúči, ktorý zadáte, uchováva planque tento token alebo kľúč pre vašu spoločnosť šifrovane; pri spravovanom pripojení drží prihlásenie Composio, služba na pripojenie, s ktorou planque spolupracuje, a planque uchováva iba záznam o pripojení a nástroje, ktoré ste schválili (všetko ako sprostredkovateľ, pozrite nižšie). Ak spárujete rozšírenie tafs, môže taf aj čítať stránky webov, ktoré povolíte, a konať na nich, vo vašom vlastnom Chrome (ako sprostredkovateľ; <a href="/sk/tafs/privacy">stránka Ochrana osobných údajov tafs</a> hovorí, čo sa číta, čo sa uchováva a ako dlho). Záznam o pripojení môže obsahovať účet, ku ktorému je prihlásené (jeho meno alebo e-mail), aby vám aplikácia mohla ukázať, o ktorý ide. KIFF používa spravované pripojenia iba pre aplikácie uvedené na <a href="/subprocessors#composio">/subprocessors</a> (v angličtine). Aplikácia neobsahuje žiadne analytické ani
				reklamné sledovacie nástroje.
			</li>
			<li>
				<strong>Nákupy v App Store</strong> — keď si v tafs kúpite
				Solo alebo balík kreditov, predáva vám ich Apple: Apple je
				predávajúcim, prijíma platbu a uchováva vaše platobné
				údaje. Apple nám oznámi, čo bolo zakúpené, pre ktorý
				účet KIFF (náhodné ID, ktoré aplikácia pripojí k nákupu),
				kedy, ID transakcie v Apple a pri Solo, kedy obdobie
				končí alebo sa obnovuje. Používame to na pripísanie
				kreditov alebo plánu na váš účet. Apple nám neoznamuje
				vaše Apple ID, meno, e-mailovú adresu ani kartu.
			</li>
			<li>
				<strong>Nákupy v Google Play</strong> — v Androide
				prechádzajú rovnaké nákupy fakturáciou Google Play:
				Google prijíma platbu a uchováva vaše platobné
				údaje. Google nám oznámi, čo bolo zakúpené, pre ktorý
				účet KIFF (to isté náhodné ID), kedy, token a ID
				objednávky nákupu a pri Solo, kedy obdobie končí alebo
				sa obnovuje, a používame to rovnakým spôsobom.
				Google nám neoznamuje váš účet Google, meno,
				e-mailovú adresu ani kartu.
			</li>
		</ul>
	</section>
}

templ privacyLawfulBasesSK() {
	<section id="lawful-bases">
		<h2>5. Právne základy spracúvania</h2>
		<p>
			Podľa článku 6 GDPR sa opierame o tieto právne
			základy:
		</p>
		<ul>
			<li>
				<strong>Plnenie zmluvy</strong> (čl.
				6 ods. 1 písm. b)) — pre založenie účtu, overovanie,
				prevádzku runtime prostredia vo vašom mene, fakturáciu
				(ak je aktívna) a hlavné časti služby.
			</li>
			<li>
				<strong>Oprávnené záujmy</strong> (čl. 6 ods. 1 písm. f))
				— pre bezpečnosť, predchádzanie podvodom, odhaľovanie
				zneužitia, prevádzkovú telemetriu a ochranu služby.
				Svoje záujmy vyvažujeme s vašimi právami a na požiadanie
				vám oznámime, k akému výsledku tento test vyváženosti
				viedol.
			</li>
			<li>
				<strong>Súhlas</strong> (čl. 6 ods. 1 písm. a)) — pre AI v aplikácii tafs: čo sa posiela modelu AI, ktorý poháňa Coacha a vaše tafy, ako je opísané <a href="#ai-in-tafs">nižšie</a>. Nič sa neodošle, kým to nepovolíte, a súhlas môžete odvolať v Účte. O súhlas by sme vás požiadali aj pred akýmikoľvek analytickými cookies, voliteľnými marketingovými oznámeniami alebo novým spracúvaním, ktoré podstatne rozširuje naše využívanie vašich údajov. Neprevádzkujeme žiadnu analytiku, žiadnu reklamu a žiadne nepodstatné sledovanie.
			</li>
			<li>
				<strong>Zákonná povinnosť</strong> (čl. 6 ods. 1 písm. c))
				— pre daňové záznamy (estónsky zákon o účtovníctve §12, 7
				rokov), odpovede na zákonné žiadosti orgánov a uchovávanie
				vyžadované predpismi proti praniu špinavých peňazí, ak sa
				uplatnia.
			</li>
		</ul>
		<h3 id="ai-in-tafs">AI v aplikácii tafs</h3>
		<p>Aplikácia tafs sa vás opýta skôr, ako čokoľvek odíde do AI, týmito slovami:</p>
		<ul>
			<li>tafs používa pre Coacha a vaše tafy AI Claude od spoločnosti Anthropic.</li>
			<li>Coach a vaše tafy sú AI agenti: to, čo píšu, generuje AI a môže to byť nesprávne. Správa, ktorú taf pošle mimo vašej spoločnosti, uvádza, že ju napísal AI agent.</li>
			<li>Čo sa do nej posiela: čo píšete Coachovi a svojim tafom, súbory, ktoré priložíte, čo vaše pripojené aplikácie vracajú tafu počas práce, a čo je na vašej obrazovke, keď vám Coach v aplikácii pomáha.</li>
			<li>Čo sa nikdy neposiela: heslá a kľúče, ktoré používajú vaše pripojené aplikácie, ani váš odtlačok prsta.</li>
			<li>Anthropic to používa na odpoveď a uchováva to najviac 30 dní.</li>
			<li>Nič sa neodošle, kým to nepovolíte. Súhlas môžete odvolať v Účte.</li>
		</ul>
		<p>Taf, ktorý beží bez toho, aby pri tom v tej chvíli niekto bol (podľa svojho plánu alebo keď niečo príde), sa opiera o súhlas osoby, ktorá ho vytvorila alebo prevzala, inak o súhlas prvej osoby, ktorá spravuje tafy účtu a povolí ho.</p>
		<p><strong>Keď súhlas odvoláte,</strong> Coach a vaše tafy vám prestanú odpovedať. Taf, ktorého behy sa opierajú o váš súhlas, sa pozastaví: jeho plány sa zastavia a to, čo príde, čaká. Pokračuje, len čo je súhlas znova udelený alebo ho svojím vlastným súhlasom prevezme niekto, kto spravuje tafy účtu. Odvolanie nemení nič na tom, čo bolo odoslané predtým.</p>
		<p>Anthropic je uvedený na <a href="/subprocessors">/subprocessors</a> (v angličtine), spolu s tým, kde údaje spracúva a kedy ich môže uchovávať dlhšie.</p>
	</section>
}

templ privacySubprocessorsSK() {
	<section id="sub-processors">
		<h2>6. Ďalší sprostredkovatelia</h2>
		<p>Vaše osobné údaje nepredávame a nezdieľame ich na reklamu.</p>
		<p>
			Na poskytovanie služby využívame malý okruh dodávateľov.
			Oficiálny aktuálny zoznam je na
			<a href="/subprocessors">/subprocessors</a> (v angličtine);
			táto stránka sa aktualizuje do 30 dní od každej zmeny.
			Od každého ďalšieho sprostredkovateľa požadujeme na základe
			písomných zmlúv ochranu rovnocennú tej našej, vrátane
			štandardných zmluvných doložiek EÚ, ak osobné údaje
			opúšťajú EÚ.
		</p>
		<p>
			O podstatnom pridaní alebo nahradení ďalších
			sprostredkovateľov, ktoré sa týka osobných údajov,
			informujeme aktívnych zákazníkov vopred, s právom namietať.
		</p>
	</section>
}

templ privacyTransfersSK() {
	<section id="transfers">
		<h2>7. Medzinárodné prenosy</h2>
		<p>
			Niektorí z našich ďalších sprostredkovateľov sú usadení mimo
			Európskeho hospodárskeho priestoru, predovšetkým
			v Spojených štátoch. Pri každom takom prenose sa opierame
			aspoň o jednu z týchto záruk:
		</p>
		<ul>
			<li>
				<strong>Rámec ochrany údajov EÚ – USA</strong> — pre
				ďalších sprostredkovateľov v USA, ktorí získali
				certifikáciu podľa tohto rámca. Rozhodnutie o primeranosti
				platí od polovice roka 2023; sledujeme akúkoľvek zmenu
				jeho stavu.
			</li>
			<li>
				<strong>Štandardné zmluvné doložky</strong> —
				modul 2 (prevádzkovateľ – sprostredkovateľ) pre našich
				priamych ďalších sprostredkovateľov a modul 3
				(sprostredkovateľ – ďalší sprostredkovateľ) tam, kde ide
				o reťazec sprostredkovateľov. Používame doložky
				schválené Komisiou v roku 2021.
			</li>
			<li>
				<strong>Doplnkové opatrenia</strong> — tam, kde posúdenie
				rizík ukazuje, že sú namieste ďalšie záruky (šifrovanie
				pri prenose aj pri uložení, zaznamenávanie prístupu,
				minimalizácia údajov).
			</li>
		</ul>
		<p>
			Konkrétny nástroj prenosu použiteľný na daného ďalšieho
			sprostredkovateľa si môžete vyžiadať e-mailom na
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
		<p><strong>Vaša krajina.</strong> Zákony niektorých krajín vyžadujú viac, ako hovoria tieto zásady. Čo dopĺňajú, v angličtine a v jazyku danej krajiny, nájdete na stránke <a href="/privacy/countries">Vaša krajina</a>.</p>
	</section>
}

templ privacyRetentionSK() {
	<section id="retention">
		<h2>8. Uchovávanie</h2>
		<p>
			Osobné údaje uchovávame počas najkratšieho obdobia, ktoré
			zodpovedá účelom, na ktoré ich spracúvame, a prípadnej
			uplatniteľnej zákonnej povinnosti.
		</p>
		<ul>
			<li>
				<strong>Metaúdaje účtu a prihlásenia</strong> —
				do vymazania účtu. V aplikácii tafs ho vlastník vymaže
				v Účet → <em>Vymazať
				účet</em>. Účet vytvorený na webe sa vymaže
				na základe e-mailu na
				<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>,
				v mesačnej lehote podľa čl. 12 ods. 3 GDPR.
				V oboch prípadoch kľúče účtu okamžite prestanú fungovať.
				Vymazanie v aplikácii tafs nemožno vrátiť späť: chaty,
				poznámky a pripojenia jeho tafs sa okamžite vymažú a to,
				čo uchováva KIFF, sa vymaže do 30 dní. Pri vymazaní na
				webe uchovávame jeho údaje počas ochrannej lehoty 30 dní,
				ak by ich vlastník chcel späť, a potom ich vymažeme.
			</li>
			<li>
				<strong>Záznamy kľúčov API</strong> — do vymazania účtu,
				aj potom, čo je kľúč odvolaný. Kľúč, ktorý patrí
				k pripojeniu agenta cez prihlásenie, sa vymaže spolu
				s týmto pripojením, 30 dní po jeho skončení.
			</li>
			<li>
				<strong>Relačné cookies</strong> — do uplynutia platnosti
				(predvolene 24 hodín) alebo do odhlásenia.
			</li>
			<li>
				<strong>Prístupové záznamy reverzného proxy</strong> — najviac 90
				dní, potom sa agregujú alebo vymažú.
			</li>
			<li>
				<strong>Záznamy služieb</strong> — čo služby KIFF
				a planque zaznamenávajú počas behu: chyby a požiadavky,
				ktoré môžu uvádzať účet, osobu alebo agenta. 30
				dní, potom sa vymažú.
			</li>
			<li>
				<strong>Zálohy</strong> — databáza KIFF sa zálohuje
				denne, šifrovane, a každá záloha sa uchováva 7 dní,
				takže vymazaný záznam z nich zmizne do 7 dní.
				Úložiská tafs a planque uchovávajú šifrované kópie
				k určitému okamihu počas 35 dní, ktoré slúžia iba
				na obnovenie úložiska po zlyhaní, takže vymazaný záznam
				z nich zmizne do 35 dní.
			</li>
			<li>
				<strong>Auditné údaje tenanta</strong> — uchovávané ako
				sprostredkovateľ podľa konfigurácie tenanta zákazníka.
				Predvolené nastavenie: uchovávajú sa počas celej
				existencie tenanta; vymažú sa s vymazaním tenanta. Pozrite
				<a href="/security#deletion">/security#deletion</a> (v angličtine).
			</li>
			<li>
				<strong>Volania cez bránu KIFF</strong> — argumenty
				volania do jeho odoslania, odmietnutia alebo zlyhania,
				potom sa vymažú; výsledok nástroja počas 24 hodín, potom
				sa vymaže. Záznam o rozhodnutí a haš
				argumentov sa uchovávajú ako auditné údaje tenanta. Pozrite
				<a href="/security#data-kept">/security#data-kept</a> (v angličtine).
			</li>
			<li>
				<strong>Využitie</strong> — pri každom volaní cez
				bránu, len čo skončí: ktorý agent ho uskutočnil, nástroj
				a či sa počítalo ako akcia, alebo bolo zadarmo (a
				prečo). Pri každom behu tafu alebo Coacha, len čo
				skončí: taf, kedy, kredity, ktoré jeho AI spotrebovala,
				a či sa započítali, alebo prečo nie. Do vymazania účtu;
				to, čo sa hlási nášmu spracovateľovi platieb na
				fakturáciu, sa uchováva spolu s fakturačnými záznamami.
			</li>
			<li>
				<strong>Pripojenia agentov cez prihlásenie</strong> — ktorý
				agent, názov aplikácie, kto ho povolil, kedy a jeho
				posledné použitie: počas doby, keď je pripojenie aktívne,
				potom 30 dní po jeho skončení (počas tejto doby zostáva
				uvedené v ovládacom paneli), potom sa vymaže spolu s jeho
				tokenmi a kľúčom API. Všetko sa vymaže spolu s účtom.
			</li>
			<li>
				<strong>tafs</strong> — push token zariadenia, kým sa
				z aplikácie neodhlásite, zariadenie neodstránite alebo Apple
				či Google neoznámi, že token zanikol. Verejný kľúč
				zariadenia, názov, platformu a dátumy počas doby, keď ho
				používate; len čo ho odhlásite, označí sa ako odstránené
				a uchováva sa do vymazania účtu, aby KIFF mohol odmietnuť
				jeho oneskorenú odpoveď a ukázať, ktoré zariadenie
				podpísalo skoršiu. Verejný kľúč, ID a názov prístupového
				kľúča sa uchovávajú ako údaje jeho zariadenia. Počítač
				uchováva svoju reláciu najviac 90 dní alebo do
				odhlásenia. To, čo tafs uchováva pre vašu spoločnosť, sa
				uchováva ako sprostredkovateľ: behy a chaty tafu, so
				súhrnom chatu (a Setupu), počas 30 dní, to, čo vracajú
				vaše nástroje, iba do skončenia behu (v chate sa to, čo
				iba čítal, uchováva šifrovane pre jeho ďalšie správy,
				používa sa, kým chat nie je hodinu nečinný, a najviac
				štyri hodiny po načítaní, potom sa automaticky vymaže,
				v priebehu niekoľkých dní), a jeho poznámky v pamäti
				do odstránenia
				tafu; súbory, ktoré doručí, 30 dní od behu, ktorý ich vytvoril, potom sa automaticky vymažú do jedného dňa, alebo skôr, ak niektorý z nich vymaže niekto z vášho účtu; token alebo kľúč pripojenia v planque, alebo prihlásenie spravovaného pripojenia v Composio, kým pripojenie neodpojíte (ak ten istý účet u daného dodávateľa môže používať iné z vašich pripojení, uchováva sa nepoužívaný, kým neodpojíte aj to), a záznam o jeho schváleniach
				do zániku účtu; pozrite
				<a href="/legal/dpa#annex-4">prílohu 4 k DPA</a> (v angličtine).
			</li>
			<li>
				<strong>Fakturačné záznamy</strong> — 7 rokov od
				konca účtovného obdobia (estónsky zákon o účtovníctve
				§12).
			</li>
			<li>
				<strong>Nákupy v App Store a Google Play</strong> —
				to, čo nám Apple alebo Google oznámili o každom nákupe,
				zostáva vo vašom účte do vymazania účtu. Ich
				prehľady predajov a výplat, ktoré uchovávame ako
				fakturačné záznamy 7 rokov, vás neuvádzajú.
			</li>
			<li>
				<strong>Korešpondencia s podporou</strong> — 3 roky
				od poslednej interakcie, potom sa vymaže.
			</li>
		</ul>
	</section>
}

templ privacyRightsSK() {
	<section id="rights">
		<h2>9. Vaše práva</h2>
		<p>
			Podľa GDPR máte vo vzťahu k svojim osobným údajom tieto
			práva:
		</p>
		<ul>
			<li><strong>Prístup</strong> (článok 15) — potvrdenie, či vaše údaje spracúvame, a ich kópia.</li>
			<li><strong>Oprava</strong> (článok 16) — oprava nesprávnych alebo neúplných údajov.</li>
			<li><strong>Vymazanie</strong> (článok 17) — vymazanie vašich údajov, s výhradou výnimiek pre zákonné uchovávanie.</li>
			<li><strong>Obmedzenie</strong> (článok 18) — pozastavenie spracúvania, kým sa spor nevyrieši.</li>
			<li><strong>Prenosnosť</strong> (článok 20) — strojovo čitateľný export údajov, ktoré ste poskytli.</li>
			<li><strong>Námietka</strong> (článok 21) — proti spracúvaniu na základe oprávnených záujmov; prestaneme, pokiaľ nepreukážeme závažné dôvody, ktoré prevažujú.</li>
			<li><strong>Odvolanie súhlasu</strong> (čl. 7 ods. 3) — pri akomkoľvek spracúvaní založenom na súhlase, napríklad AI v aplikácii tafs (v Účte, ako je uvedené <a href="#ai-in-tafs">vyššie</a>). Odvolanie nemá vplyv na predchádzajúce zákonné spracúvanie.</li>
		</ul>
		<p>
			Ktorékoľvek z týchto práv uplatníte e-mailom na
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
			Odpovieme bez zbytočného odkladu, najneskôr do jedného mesiaca, podľa čl. 12 ods. 3; pri
			zložitých žiadostiach môžeme lehotu predĺžiť najviac
			o ďalšie dva mesiace a v takom prípade vám to oznámime.
		</p>
		<h3 id="export-chats">Vaše vlastné chaty v tafs</h3>
		<p>
			V aplikácii tafs voľba Účet →  Exportovať moje chaty
			stiahne vaše vlastné chaty s každým tafom, vrátane chatov
			s Coachom, názvy súborov, ktoré ste priložili, a vaše
			vlastné poznámky, ako čitateľný súbor a ako JSON.
			Exportovať ich môžete iba vy: správca ani vlastník účtu to
			nemôže a export účtu od KIFF ich neobsahuje.
		</p>
		<h3 id="delete-account">Vymazanie vášho účtu tafs</h3>
		<p>
			tafs je aplikácia spoločnosti KIFF. Vymazanie účtu tafs
			a jeho údajov:
		</p>
		<ol>
			<li>Otvorte aplikáciu tafs a prihláste sa.</li>
			<li>Prejdite do Účtu a ťuknite na <em>Vymazať účet</em>.</li>
			<li>Potvrďte. Vymazanie účtu nemožno vrátiť späť.</li>
		</ol>
		<p>
			<em>Vymazať účet</em> sa zobrazuje tomu, kto smie vymazať
			účet spoločnosti, zvyčajne jej vlastníkovi. Ak túto
			voľbu nevidíte alebo už aplikáciu nemáte, napíšte na
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			z adresy, ktorou sa prihlasujete, a vaše údaje vymažeme bez zbytočného odkladu, najneskôr do jedného mesiaca.
		</p>
		<p>
			Čo sa vymaže: kľúče účtu okamžite prestanú fungovať. Jeho
			tafy, chaty, poznámky, priložené súbory a pripojenia sa
			okamžite vymažú, a z ich kópií k určitému okamihu do
			35 dní. To, čo KIFF pre účet uchováva, sa
			vymaže do 30 dní a zo záloh do 7 dní
			potom. Záznamy služieb, ktoré účet uvádzajú, zmiznú
			do 30 dní. Auditné údaje tenanta sa vymažú spolu
			s tenantom. Pre každý druh údajov pozrite <a href="#retention">Uchovávanie</a>.
		</p>
		<p id="delete-data">
			Vymazanie časti údajov so zachovaním účtu: v
			aplikácii vymažte chat a jeho správy a priložené
			súbory zmiznú s ním; odstráňte taf a jeho chaty, poznámky
			a pripojenia zmiznú s ním. Pri čomkoľvek inom napíšte na
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			a uveďte, čo vymazať. Urobíme to bez zbytočného odkladu, najneskôr do jedného mesiaca.
		</p>
		<p>
			Máte právo podať sťažnosť dozornému
			orgánu. Naším vedúcim dozorným orgánom
			je
			<a href="https://www.aki.ee/en" target="_blank" rel="noopener">estónsky Inšpektorát ochrany údajov (Andmekaitse Inspektsioon)</a>.
			Sťažnosť môžete podať aj dozornému orgánu
			členského štátu, v ktorom máte bydlisko.
		</p>
		<p><strong>Vaša krajina.</strong> Zákony niektorých krajín vyžadujú viac, ako hovoria tieto zásady. Čo dopĺňajú, v angličtine a v jazyku danej krajiny, nájdete na stránke <a href="/privacy/countries">Vaša krajina</a>.</p>
	</section>
}

templ privacyCookiesSK() {
	<section id="cookies">
		<h2>10. Cookies</h2>
		<p>
			Nastavujeme tri cookies, všetky nevyhnutne potrebné,
			vlastné, posielané iba cez HTTPS a nečitateľné pre skripty
			na stránke. Podľa pravidiel EÚ pre ePrivacy nevyžadujú
			súhlas; uvádzame ich, aby ste o nich vedeli. Podrobnosti
			obsahujú <a href="/cookies">zásady používania cookies</a> (v angličtine).
		</p>
		<ul>
			<li>
				<strong><code>kiff_session</code></strong> — udržiava vás
				prihlásených. Podpísané relačné cookie nesúce ID vášho
				prihlásenia, e-mail a meno a prístupový údaj, ktorý
				za vás používa ovládací panel. Nastavené pre <code>.kiff.dev</code>.
				Platí 24 hodín alebo do odhlásenia.
			</li>
			<li>
				<strong><code>kiff_flash</code></strong> — prenáša
				jednorazovú správu na ďalšiu stránku, napríklad „váš kľúč
				bol vytvorený“. Podpísané; nový kľúč v ňom nikdy nie je.
				Nastavené pre <code>.kiff.dev</code>. Vymaže sa, keď ho
				ďalšia stránka prečíta, a najneskôr po 5 minútach.
			</li>
			<li>
				<strong><code>kiff_cb_attempts</code></strong> — počíta, ako
				často sa prihlasovacia stránka znova načítala, aby sa
				prihlásenie, ktoré sa zacyklí, zastavilo. Posiela sa iba
				na túto stránku. Platí 5
				minút a vymaže sa, keď prihlásenie začne alebo uspeje.
			</li>
		</ul>
		<p>
			Nepoužívame analytické cookies, reklamné cookies ani
			žiadne sledovacie nástroje tretích strán. Ak by sme
			nejaké niekedy pridali, pred nastavením cookie zobrazíme
			lištu so súhlasom, v súlade s ePrivacy a usmerneniami
			EDPB z roku 2023 k technológiám sledovania.
		</p>
		<p>
			Ak sa prihlasujete cez Clerk (nášho ďalšieho
			sprostredkovateľa pre overovanie), Clerk nastavuje cookies
			aj na svojej vlastnej frontendovej doméne (<code>clerk.kiff.dev</code>). Tieto
			cookies sú nevyhnutné na to, aby vás Clerk rozpoznal počas
			svojho prihlasovacieho postupu, a riadia sa zásadami
			ochrany osobných údajov Clerku aj našimi. Podrobnosti
			nájdete v zozname ďalších sprostredkovateľov.
		</p>
	</section>
}

templ privacySecuritySK() {
	<section id="security">
		<h2>11. Bezpečnosť</h2>
		<p>
			Naše technické a organizačné bezpečnostné opatrenia sú
			opísané na <a href="/security">/security</a> (v angličtine). Patrí
			medzi ne oddelenie tenantov na úrovni databázy,
			TLS 1.2+ pri prenose, šifrovanie pri uložení pomocou
			predvolených nastavení spravovaného poskytovateľa a riadenie
			prístupu podľa princípu najnižších oprávnení.
		</p>
		<p>
			O porušení ochrany osobných údajov informujeme dotknutých
			zákazníkov bez zbytočného odkladu a do 72 hodín od jeho
			potvrdenia, v súlade s článkom 33 GDPR. Oznámenie obsahuje
			povahu porušenia, kategórie a približný počet dotknutých
			osôb a záznamov, pravdepodobné dôsledky
			a prijaté alebo navrhované opatrenia.
		</p>
	</section>
}

templ privacyChildrenSK() {
	<section id="children">
		<h2>12. Deti</h2>
		<p>
			KIFF Cloud je produkt vývojárskej infraštruktúry, ktorý
			nie je určený deťom. Vedome nezhromažďujeme osobné údaje
			detí mladších ako 16 rokov. Ak sa domnievate, že nám
			dieťa poskytlo osobné údaje, kontaktujte
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			a údaje vymažeme.
		</p>
	</section>
}

templ privacyAutomatedSK() {
	<section id="automated">
		<h2>13. Automatizované rozhodovanie</h2>
		<p>
			Runtime prostredie KIFF Cloud prijíma deterministické
			rozhodnutia podľa pravidiel nad údajmi, ktoré posielajú
			naši zákazníci. Nejde o rozhodnutia o vás, ktoré by mali
			právne alebo podobne významné účinky v zmysle článku 22
			GDPR; ide o rozhodnutia o akciách zákazníka (vrátenia
			peňazí, objednávky, správy a podobne) vykonávaných podľa
			vlastných pravidiel zákazníka.
		</p>
		<p>
			Zákazníci, ktorí používajú KIFF Cloud na rozhodovanie
			ovplyvňujúce ich vlastných koncových používateľov, sami
			zodpovedajú za dodržiavanie článku 22. Naše potvrdenia
			o riadení sú navrhnuté tak, aby týmto zákazníkom poskytli
			auditnú stopu, ktorú potrebujú na preukázanie ľudského
			dohľadu, ale právnu povinnosť tento dohľad zabezpečiť
			nesie zákazník.
		</p>
	</section>
}

templ privacyChangesSK() {
	<section id="changes">
		<h2>14. Zmeny týchto zásad</h2>
		<p>
			Tieto zásady môžeme z času na čas aktualizovať.
			O podstatných zmenách informujeme aktívnych zákazníkov
			e-mailom a výrazným bannerom na tejto stránke najmenej
			30 dní. Nepodstatné zmeny zverejňujeme s novým dátumom
			„poslednej aktualizácie“.
		</p>
	</section>
}

