package pages

import "github.com/kiff/cloud/web/internal/components"

// TafsPrivacyUR is tafs's own privacy policy (/tafs/privacy) in Urdu, at
// /ur/tafs/privacy. It is a translation of TafsPrivacy: the same sections,
// anchors, links and figures, held to it by TestTranslationsKeepTheEnglishPage.
// The English page governs. Change the English page first, then this one.
// Urdu has the legal texts only, so a link to any other page goes to English
// and says so. It is written right to left (components.IsRightToLeft).
templ TafsPrivacyUR() {
	@components.LayoutSiteWithMeta("tafs رازداری کی پالیسی", "KIFF کی ایپ tafs ذاتی ڈیٹا کو کیسے سنبھالتی ہے، بشمول وہ ڈیٹا جو آپ کا Google اکاؤنٹ جوڑنے پر اسے Google سے ملتا ہے۔", "website", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			<header class="legal-head">
				<p class="legal-badge">tafs · رازداری کی پالیسی</p>
				<h1>tafs رازداری کی پالیسی</h1>
				<p class="legal-meta"><strong>آخری تازہ کاری:</strong> 24 نومبر 2026۔</p>
				<p class="legal-disclaimer">یہ پالیسی بتاتی ہے کہ KIFF کی ایپ tafs (iPhone، iPad، Android اور کمپیوٹرز کے لیے) ذاتی ڈیٹا کو کیسے سنبھالتی ہے۔ tafs، KIFF Cloud کا حصہ ہے، اس لیے <a href="/ur/privacy">KIFF کی رازداری کی پالیسی</a> بھی اس پر لاگو ہوتی ہے، اور اس ہر بات پر جو اس صفحے میں نہیں ہے۔ سوالات: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>۔</p>
			</header>
			<section id="who-we-are">
				<h2>1. ہم کون ہیں</h2>
				<p>tafs کو <strong>Kiff Agents OÜ</strong> فراہم کرتی ہے، جو ایسٹونیا میں رجسٹرڈ ایک نجی محدود ذمہ داری کمپنی ہے (رجسٹریشن کوڈ 17372313، VAT نمبر EE102924327)، پتہ: Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416، ایسٹونیا۔ یورپی یونین کا جنرل ڈیٹا پروٹیکشن ریگولیشن (GDPR) ہماری پراسیسنگ پر لاگو ہوتا ہے۔</p>
			</section>
			<section id="scope">
				<h2>2. یہ پالیسی کیا احاطہ کرتی ہے</h2>
				<p>iPhone، iPad، Android اور کمپیوٹرز (Mac، Windows اور Linux) کے لیے tafs ایپ اور اس کے پیچھے کی سروس، جس میں کمپنی کے ٹولز جوڑنے والا Setup اور ان کنکشنز کو رکھنے والا planque شامل ہیں۔ tafs میں کمپنی ایک AI ایجنٹ، یعنی taf، کو کام سونپتی ہے، جو KIFF Card کے اندر کام کرتا ہے۔</p>
			</section>
			<section id="roles">
				<h2>3. ہمارے کردار</h2>
				<p>ہم آپ کے اکاؤنٹ اور سائن اِن ڈیٹا کے، اور اپنی سروس کے آپریشنل ڈیٹا کے <strong>کنٹرولر</strong> ہیں۔ tafs آپ کی کمپنی کے لیے جو رکھتا ہے، یعنی ہر taf کے رن، چیٹس، رپورٹیں، میموری نوٹس اور ان کی فراہم کردہ فائلیں، ان کے لیے ہم آپ کی کمپنی کی طرف سے <strong>پراسیسر</strong> کے طور پر کام کرتے ہیں۔ اس ڈیٹا کی کنٹرولر آپ کی کمپنی ہے، اور اس تعلق کو <a href="/legal/dpa">DPA</a> منظم کرتا ہے۔</p>
			</section>
			<section id="data">
				<h2>4. tafs کیا جمع کرتا ہے</h2>
				<ul>
					<li><strong>آپ کا اکاؤنٹ:</strong> آپ tafs میں اپنے KIFF اکاؤنٹ سے سائن اِن کرتے ہیں۔ فون یا ٹیبلیٹ پر ایپ آپ کا سیشن آلے کے Keychain میں (Android پر اس کی خفیہ کردہ اسٹوریج میں) رکھتی ہے۔ کمپیوٹر پر وہ اسے آپ کے صارف اکاؤنٹ کے لیے سیل کر کے رکھتی ہے: Windows PC پر Windows کے اپنے ڈیٹا تحفظ سے، Linux پر آپ کی کی رنگ میں، Mac پر اس کے Keychain میں۔ کمپیوٹر کا سیشن 90 دن تک چلتا ہے۔</li>
					<li><strong>آپ کا آلہ:</strong> ایپ ایک دستخطی کلید بناتی ہے جو آلے سے کبھی باہر نہیں جاتی: iPhone، iPad یا Mac کے Secure Enclave میں، Android آلے کے Keystore میں، یا Windows PC کے TPM میں۔ Linux پر، اور Secure Enclave کے بغیر Mac پر، کلید ایک سافٹ ویئر کلید ہے جو آپ کی کی رنگ یا Keychain میں رہتی ہے، اور وہ کمپیوٹر یہ دکھا سکتا ہے کہ آپ کا کیا انتظار ہو رہا ہے مگر اسے منظور نہیں کر سکتا؛ آپ اپنے فون پر منظور کرتے ہیں{ macSecurityKey("ur") }۔ TPM کے بغیر Windows PC tafs میں سائن اِن نہیں کر سکتا۔ KIFF کلید کا عوامی آدھا حصہ، آلے کا نام اور پلیٹ فارم، اور یہ کہ وہ کب شامل ہوا اور آخری بار کب استعمال ہوا، رکھتا ہے، تاکہ روکی گئی کالز پر آپ کے جوابات اور کنکشنز کی آپ کی منظوریاں جانچ سکے۔</li>
					<li><strong>آپ کی گھڑی:</strong> گھڑی میں کوئی پاس ورڈ یا کلید نہیں ہوتی، وہ صرف آپ کے جوڑے ہوئے فون سے بات کرتی ہے، اور کبھی منظور نہیں کرتی۔ آپ Coach یا اپنے منتخب taf سے جو کہتے ہیں وہ AI کی اجازت دینے کے بعد، فون کے ذریعے، صرف ٹیکسٹ کی شکل میں بھیجتی ہے۔ گھڑی کی اپنی بول چال کی سروس، Apple کی یا Google کی، آپ کے الفاظ کو اس ٹیکسٹ میں بدلتی ہے۔ Wear OS پر، اگر آپ کے مکمل کرنے سے پہلے وہ رک جائے، تو آپ کے فون کی اپنی شناخت کی سروس یہ کام فون پر ہی کرتی ہے۔ وہ مسترد کرنے، روکنے یا Coach یا taf کو بھیجنے کا کام صرف تب کر سکتی ہے جب اس میں اسکرین لاک یا پاس کوڈ ہو اور وہ ان لاک ہو۔ آپ taf کو جو بھیجتے ہیں وہ اس taf کی اپنی چیٹ میں جاتا ہے، گویا آپ نے اسے اپنے فون پر لکھا ہو۔ taf کی چیٹ، رقوم سمیت، گھڑی پر صرف تب تک دکھائی دیتی ہے جب تک وہ کھلی ہے، ہر بار فون کے ذریعے پڑھی جاتی ہے؛ گھڑی اس میں سے کچھ نہیں رکھتی۔</li>
					<li><strong>Apple Watch:</strong> وہ آپ کے tafs اور ان کے صفحات بغیر رکھے دکھاتی ہے۔ وہ صرف آپ کا Inbox رکھتی ہے، ایک ایسی فائل میں جسے لاک رہتے وہ پڑھ نہیں سکتی: ہر روکی گئی کال taf کے نام اور وہ کیا مانگتا ہے کی شکل میں، کبھی کوئی رقم نہیں، اور گھڑی سے آپ کے بھیجے پر Coach کے جوابات، ٹیکسٹ کی شکل میں۔ اگر آپ گھڑی پر سائن آؤٹ کرتے ہیں، تو وہ یہ بھی رکھتی ہے کہ آپ نے کیا، جب تک آپ گھڑی پر دوبارہ سائن اِن نہ کریں۔ اس کے علاوہ، گھڑی میں پاس کوڈ نہ ہو تو وہ کچھ نہیں رکھتی۔ Inbox تب چلا جاتا ہے جب آپ گھڑی پر سائن آؤٹ کرتے ہیں یا آپ کا iPhone سائن آؤٹ ہوتا ہے، یا ایپ اگلی بار بغیر پاس کوڈ کے کھلتی یا بند ہوتی ہے۔ وہ کوئی ریکارڈنگ نہیں کرتی، اور جو اطلاعات دکھاتی ہے وہ صرف آپ کے iPhone کی ہوتی ہیں۔ اگر آپ Coach کے لیے کوئی پیغام بعد کے لیے رکھتے ہیں، تو وہ وہ ایک پیغام بھی متن کی صورت میں ان باکس کی طرح لاک کی گئی اپنی الگ فائل میں رکھتی ہے، اور آپ کا iPhone واپس آنے پر اسے بھیج دیتی ہے۔ بھیجے جانے کے بعد، آپ کے حذف کرنے پر، آپ یا آپ کے iPhone کے سائن آؤٹ ہونے پر، یا گھڑی میں پاس کوڈ نہ رہنے پر یہ حذف ہو جاتا ہے۔</li>
					<li><strong>Wear OS:</strong> وہ آپ کے اکاؤنٹ کا ای میل اور آج کا کیلنڈر بغیر رکھے دکھاتی ہے۔ فوراً کھلنے کے لیے وہ خفیہ کردہ شکل میں آپ کا انتظار کرنے والی چیزوں کی گنتی، اور ہر taf کا نام اور وہ رکا یا تھما ہوا ہے یا نہیں رکھتی: کبھی کوئی رقم، روکی گئی کال کی تفصیل یا taf کی چیٹ نہیں۔ یہ تب صاف ہو جاتا ہے جب آپ سائن آؤٹ کرتے ہیں، جب گھڑی لاک ہوتی ہے یا کلائی سے اتاری جاتی ہے، اور 24 گھنٹے بعد۔ وہ آپ کا Inbox رکھتی ہے، جس میں ہر سطر taf کا نام اور وہ جو کہتا ہے ہے، کبھی کوئی رقم نہیں، اور بعد کے لیے رکھا ایک پیغام، ٹیکسٹ کی شکل میں۔ گھڑی یا فون پر سائن آؤٹ کرنے سے یہ سب صاف ہو جاتا ہے۔ اپنی ٹائل کے لیے وہ آپ کا انتظار کرنے والی چیزوں کی گنتی بھی رکھتی ہے، جو صرف گھڑی کے ان لاک رہتے دکھائی دیتی ہے، اور جب آپ سائن آؤٹ کرتے ہیں، یا اگلی بار ٹائل گھڑی کے لاک یا بغیر اسکرین لاک کے رہتے دکھائی دیتی ہے، تب صاف ہو جاتی ہے۔ گھڑی پر سائن آؤٹ کے بعد وہ اس کا نوٹ رکھتی ہے کہ آپ نے کیا، جب تک آپ دوبارہ سائن اِن نہ کریں۔ Inbox بھی تب چلا جاتا ہے جب ایپ اگلی بار گھڑی کے لاک یا بغیر اسکرین لاک کے رہتے کھلتی یا بند ہوتی ہے۔ بعد کے لیے رکھا پیغام تب تک رہتا ہے جب تک آپ اسے بھیجیں یا حذف کریں، کیونکہ آپ نے اسے بھیجنے کو کہا تھا۔ اگر گھڑی کی بول چال کی سروس آپ کے مکمل کرنے سے پہلے رک جائے، تو گھڑی ریکارڈنگ آپ کے فون کو بھیجتی ہے، جو اسے فون پر ہی ٹیکسٹ میں بدلتا ہے، کبھی کسی سرور پر نہیں۔ ٹیکسٹ واپس آنے یا آپ کے منسوخ کرنے پر، اور زیادہ سے زیادہ 2 منٹ بعد، ریکارڈنگ دونوں جگہ مٹا دی جاتی ہے۔ صرف ٹیکسٹ آگے Coach یا آپ کے taf تک جاتا ہے۔ taf کا نتیجہ گھڑی کی اطلاعات میں تب تک رہ سکتا ہے جب تک آپ اسے مسترد نہ کریں یا گھڑی پر سائن آؤٹ نہ کریں۔</li>
					<li><strong>Passkey:</strong> جب آپ اپنے کمپیوٹر پر passkey سے منظور کرتے ہیں، جیسے Windows Hello یا سیکیورٹی کلید، تو آپ کا چہرہ، فنگر پرنٹ یا PIN کمپیوٹر کے اپنے سسٹم میں رہتا ہے۔ KIFF passkey کی عوامی کلید، اس کی id، ایک کاؤنٹر اور ایک نام رکھتا ہے، کبھی کچھ خفیہ نہیں، اور دوسرے آلات پر سنک ہونے والی passkey کو مسترد کرتا ہے۔</li>
					<li><strong>الرٹس:</strong> فون، ٹیبلیٹ یا iPad ایپ چلانے والے Mac پر، جب آپ انہیں آن کرتے ہیں، تو ہم آلے کا push ٹوکن آپ کی KIFF شخص id کے ساتھ، اور ایپ نے جو زبان دکھائی وہ رکھتے ہیں۔ الرٹ Apple یا Google سے ہو کر صرف یہ بتا کر جاتا ہے کہ کون سا taf اور وہ کیا چاہتا ہے، اور کسی دروازے کے الرٹ میں لکھنے والے کا نام یا ای میل پتہ: کبھی کوئی رقم یا درخواست کی تفصیل نہیں۔ ایپ یہ باتیں آلے پر ہی، KIFF سے، جوڑتی ہے، اس لیے ان لاک فون کا الرٹ رقم، تاجر یا شخص دکھا سکتا ہے۔ لاک Android فون پر وہ صرف "کسی taf کو آپ کی ضرورت ہے" دکھاتا ہے، اور لاک iPhone پر بھی، جب تک آپ نے اس کے پیش منظر ہمیشہ دکھانے پر نہ رکھے ہوں۔ Windows PC، Linux کمپیوٹر یا macOS 12 ایپ والے Mac پر الرٹس ایپ خود چلتے ہوئے بناتی ہے، بغیر push ٹوکن کے اور کسی اور کمپنی کے ذریعے نہیں۔ Windows اور Linux پر وہ دکھاتے ہیں کہ کون سا taf، وہ کیا کرنا چاہتا ہے، رقم، کیوں اور کب تک؛ macOS 12 ایپ پر، آپ کے انہیں آن کرنے کے بعد، وہ کال کے لیے KIFF کے الفاظ دکھاتے ہیں، اور لاک اسکرین وہ دکھاتی ہے جو Mac کی پیش منظر سیٹنگ اجازت دے۔ Windows پر وہ آپ کے آن کرنے تک بند رہتے ہیں، اور اسکرین لاک ہونے پر صرف "کسی taf کو آپ کی ضرورت ہے" دکھاتے ہیں۔ اسکرین لاک ہونے سے پہلے دکھایا گیا الرٹ اپنی تفصیل Windows کی اطلاعات کی فہرست میں رکھتا ہے۔ Linux پر وہ آپ کے بند کرنے تک آن رہتے ہیں، اور لاک اسکرین کیا دکھاتی ہے وہ آپ کے ڈیسک ٹاپ پر منحصر ہے۔</li>
					<li><strong>زبان:</strong> tafs سروس اکاؤنٹ کی زبان، جس نے آخری بار Coach سے چیٹ کی اس کی، تین ماہ تک رکھتی ہے، تاکہ taf کی رپورٹیں اسی میں آئیں۔</li>
					<li><strong>آپ کے ٹولز:</strong> جب آپ کوئی ٹول جوڑتے ہیں، تو آپ ٹول کے اپنے فراہم کنندہ پر سائن اِن کرتے ہیں۔ جس ایپ میں planque خود سائن اِن کرتا ہے، جیسے Stripe، یا آپ کی دی ہوئی key کے لیے، planque وہ ٹوکن یا key آپ کی کمپنی کے لیے خفیہ کردہ شکل میں رکھتا ہے۔ منظم کنکشن کے لیے، planque کی ساتھی کنکشن سروس Composio سائن اِن رکھتی ہے، اور planque صرف کنکشن کا ریکارڈ اور آپ کے منظور کیے ہوئے ٹولز رکھتا ہے (دیکھیں: <a href="#google">Google صارف ڈیٹا</a>)۔ کنکشن کے ریکارڈ میں وہ اکاؤنٹ (اس کا نام یا ای میل) ہو سکتا ہے جس میں وہ سائن اِن ہے، تاکہ ایپ آپ کو دکھا سکے کہ وہ کون سا ہے۔ KIFF منظم کنکشنز صرف <a href="/subprocessors#composio">/subprocessors</a> پر بتائی گئی ایپس کے لیے استعمال کرتا ہے۔</li>
					<li><strong>آپ کا براؤزر (Chrome):</strong> جب آپ tafs ایکسٹینشن کو اپنے فون سے جوڑتے ہیں، تو taf آپ کے جوڑے ہوئے Chrome پروفائل میں کام کر سکتا ہے، صرف ان سائٹس پر جو اس کے کنکشن میں درج ہیں۔ وہ اپنے ٹیبز ایک ایسے ٹیب گروپ میں کھولتا ہے جسے آپ دیکھ، روک یا بند کر سکتے ہیں، اور جب آپ ان میں سے کسی کو چھوتے ہیں تو وہ رک جاتا ہے۔ وہ ان صفحات کو ٹیکسٹ اور فارم فیلڈز کی شکل میں پڑھتا ہے، پاس ورڈ، کارڈ اور کوڈ فیلڈز ہٹا کر، کبھی آپ کے دوسرے ٹیبز یا دوسری سائٹس نہیں۔ وہ ٹیکسٹ رن کے حصے کے طور پر ہمارے AI فراہم کنندہ کو جاتا ہے، اور کسی ٹول کے نتیجے کی طرح رن کے ساتھ رکھا جاتا ہے۔ ہر قدم سائٹ اور فیلڈ کے نام کے ساتھ Record میں جاتا ہے، خفیہ فیلڈ میں جو ٹائپ ہوا وہ کبھی نہیں۔ taf کی ہر تبدیلی کے لیے KIFF صفحے کو پہلے اور بعد میں، ان فیلڈز ہٹا کر ٹیکسٹ کی شکل میں، زیادہ سے زیادہ 30 دن رکھتا ہے، اور آپ کے ڈسکنیکٹ کرنے یا اکاؤنٹ حذف کرنے پر اس سے پہلے حذف کر دیتا ہے۔ ان صفحات میں دوسروں کی تفصیل ہو سکتی ہے، جیسے آپ کے گاہکوں کی؛ KIFF انہیں آپ کے لیے پراسیسر کے طور پر پراسیس کرتا ہے۔ ایکسٹینشن آپ کے کمپیوٹر پر صرف اپنی کلید رکھتا ہے، آپ کے پاس ورڈ کبھی نہیں: سائن اِن صفحے پر taf رک جاتا ہے اور آپ سے کہتا ہے کہ اپنے ٹیب میں خود سائن اِن کریں۔ آپ ایکسٹینشن کے سائیڈ پینل سے Coach سے بات بھی کر سکتے ہیں۔ جب آپ وہاں سے اسے پیغام بھیجتے ہیں تو سامنے والا صفحہ صرف اپنے نظر آنے والے متن کے طور پر اس پیغام کے ساتھ جاتا ہے، آپ کا ٹائپ کیا ہوا کبھی نہیں، سوائے بینک، ادائیگی، میل یا صحت کی سائٹ یا اس سائٹ کے جسے آپ نے Coach کے لیے بند کیا ہو۔ یہ صرف اسی پیغام کے لیے ہمارے AI فراہم کنندہ کو جاتا ہے؛ tafs صفحہ صرف جواب مکمل ہونے تک رکھتا ہے، اور سائٹ کا نام آپ کی چیٹ کے ساتھ «پڑھ رہا ہے:» کے طور پر 30 دن رکھتا ہے۔ Coach کا جواب صفحے سے اقتباس دے سکتا ہے اور کسی بھی جواب کی طرح آپ کی چیٹ کے ساتھ رکھا جاتا ہے۔ پیئرنگ ہٹانے یا اَن انسٹال کرنے سے وہ سب مٹ جاتا ہے جو ایکسٹینشن رکھتی ہے۔ taf آپ کے فون پر آپ کی منظوری کے بغیر کبھی ادائیگی نہیں کرتا۔ عمل والے ہر قدم (کلک، ٹائپنگ، سبمٹ) کے لیے، آپ کے منظور کردہ قدم سمیت، وہ عمل سے ٹھیک پہلے لیے گئے صفحے کا ایک اسکرین شاٹ ریکارڈ کے لیے رکھتا ہے؛ صرف پڑھے جانے والے صفحے کے لیے کبھی نہیں، بینک، والٹ، پاس ورڈ مینیجر، ادائیگی، صحت یا سرکاری سائٹ پر کبھی نہیں، اور پاس ورڈ، کارڈ اور کوڈ فیلڈز اس کے لینے سے پہلے چھپا دیے جاتے ہیں۔ کارڈ نمبر یا کلید جیسا دکھنے والا ٹیکسٹ بھی کالا کر دیا جاتا ہے، مگر کسی اور طرح لکھی چیز پھر بھی دکھائی دے سکتی ہے۔ اسکرین شاٹس خفیہ کردہ اسٹوریج میں، اس قدم سے جڑے، 30 دن رکھے جاتے ہیں، پھر خود بخود مٹ جاتے ہیں، یا آپ کے ڈسکنیکٹ کرنے، Chrome کی پیئرنگ ہٹانے یا اکاؤنٹ حذف کرنے پر اس سے پہلے، اور وہ کبھی ہمارے AI فراہم کنندہ کے پاس نہیں جاتے۔ آپ ہر ایک کو taf کی سرگرمی میں اس کے قدم کے نیچے دیکھتے ہیں۔</li>
					<li><strong>آپ کے taf کا کام:</strong> ہر taf کے رن، چیٹس، رپورٹیں، میموری نوٹس اور ان کی فراہم کردہ فائلیں، پراسیسر کے طور پر رکھی جاتی ہیں۔ آپ کے اکاؤنٹ کا ہر شخص آپ کے taf کی فراہم کردہ فائلیں دیکھ سکتا ہے۔</li>
					<li><strong>دروازے:</strong> جب آپ کوئی دروازہ کھولتے ہیں تاکہ لوگ ای میل، Slack یا Telegram سے کسی taf کو لکھ سکیں، تو tafs سروس آپ کے جوڑے ہوئے ہر بھیجنے والے کو اس کے ای میل پتے، Slack ممبر ID یا Telegram یوزر ID (WhatsApp دروازے کے لیے فون نمبر) سے، آپ کے دیے ہوئے نام کے ساتھ، اس وقت تک رکھتی ہے جب تک آپ دروازہ یا taf ہٹا نہ دیں۔ جسے آپ نے نہیں جوڑا اس کا پیغام دستک کے طور پر، کس نے لکھا اور اس میں کیا ہے سمیت، آخری دستک کے بعد 30 دن تک آپ کا منتظر رہتا ہے۔ جوڑے ہوئے بھیجنے والے کا پیغام taf کی چیٹ میں جاتا ہے اور باقی چیٹ کی طرح رکھا جاتا ہے۔ Slack اور Telegram پیغامات اپنی شرائط پر پہنچاتے ہیں۔</li>
					<li><strong>خریداریاں:</strong> Solo اور کریڈٹ پیک Apple کی طرف سے App Store کے ذریعے، یا Google کی طرف سے Google Play کی بلنگ سے بیچے جاتے ہیں۔ وہ ہمیں بتاتے ہیں کہ کیا خریدا گیا، کس KIFF اکاؤنٹ کے لیے (ایک بے ترتیب id)، کب، اور ان کے لین دین یا آرڈر کے حوالے۔ وہ ہمیں آپ کا Apple ID یا Google اکاؤنٹ، نام، ای میل پتہ یا کارڈ نہیں دیتے۔</li>
				</ul>
				<p>ایپ میں کوئی اینالیٹکس یا اشتہاری ٹریکر نہیں ہیں۔</p>
			</section>
			<section id="ai">
				<h2>5. tafs میں AI</h2>
				<p>tafs، Coach اور آپ کے tafs کے لیے Anthropic کا Claude AI استعمال کرتا ہے۔ اسے کچھ بھی جانے سے پہلے ایپ آپ سے پوچھتی ہے۔</p>
				<ul>
					<li>اسے کیا بھیجا جاتا ہے: آپ Coach اور اپنے tafs کو جو لکھتے ہیں، آپ کی جوڑی ہوئی فائلیں، کام کرتے وقت آپ کی جڑی ایپس taf کو جو لوٹاتی ہیں، اور ایپ میں Coach آپ کی مدد کرتے وقت آپ کی اسکرین پر کیا ہے۔</li>
					<li>Chrome سے: سامنے والا صفحہ، جب آپ ایکسٹینشن کے سائیڈ پینل میں Coach کو لکھتے ہیں۔</li>
					<li>جو کبھی نہیں بھیجا جاتا: آپ کی جڑی ایپس کے استعمال کیے گئے پاس ورڈ اور کلیدیں، یا آپ کا فنگر پرنٹ۔</li>
					<li>Anthropic اسے جواب دینے کے لیے استعمال کرتی ہے اور 30 دن تک رکھتی ہے۔</li>
					<li>آپ کے اجازت دینے تک کچھ نہیں بھیجا جاتا۔ آپ اکاؤنٹ میں واپس لے سکتے ہیں۔</li>
				</ul>
				<p>جب آپ واپس لیتے ہیں، تو Coach اور آپ کے tafs آپ کو جواب دینا بند کر دیتے ہیں، اور وہ taf جس کے رن آپ کی رضامندی پر ٹکے ہیں تھم جاتا ہے۔ تفصیل <a href="/ur/privacy#ai-in-tafs">KIFF کی رازداری کی پالیسی</a> میں ہے۔</p>
			</section>
			@tafsPrivacyGoogleUR()
			<section id="sharing">
				<h2>7. ڈیٹا اور کس کو ملتا ہے</h2>
				<p>ہم آپ کا ذاتی ڈیٹا نہیں بیچتے، اور اشتہار کے لیے شیئر نہیں کرتے۔</p>
				<p>tafs کے لیے ہم یہ کمپنیاں استعمال کرتے ہیں: Amazon Web Services (ہوسٹنگ، جس میں tafs کا اسٹور اور planque کے کنکشنز شامل ہیں)، Clerk (KIFF اکاؤنٹس کے لیے سائن اِن)، Anthropic (AI ماڈل)، Composio (منظم کنکشنز کے سائن اِن، اور وہ کالز جو planque اس سے کرواتا ہے)، Apple (push الرٹس)، Google (Android پر push الرٹس، اور Google Play کی بلنگ)، اور Resend (taf کا ای میل دروازہ)۔ سرکاری، موجودہ فہرست، ہر ایک کیا چھوتا ہے اور کہاں کے ساتھ، <a href="/subprocessors">/subprocessors</a> (انگریزی میں) پر ہے۔</p>
				<p>ان میں سے کچھ یورپی اقتصادی علاقے سے باہر ہیں، زیادہ تر ریاستہائے متحدہ میں۔ ان منتقلیوں کی حفاظت کیسے کی جاتی ہے، یہ <a href="/ur/privacy#transfers">KIFF کی رازداری کی پالیسی</a> بتاتی ہے۔</p>
				<p><strong>آپ کا ملک۔</strong> کچھ ممالک کے قوانین اس پالیسی سے زیادہ مانگتے ہیں۔ وہ جو شامل کرتے ہیں، انگریزی میں اور اس ملک کی زبان میں، <a href="/privacy/countries">آپ کا ملک</a> (انگریزی میں) پر ہے۔</p>
			</section>
			<section id="retention">
				<h2>8. ہم اسے کتنی دیر رکھتے ہیں</h2>
				<ul>
					<li>آپ کے ٹولز taf کو جو لوٹاتے ہیں: صرف رن ختم ہونے تک۔ چیٹ میں، جو اس نے صرف پڑھا وہ اس کے اگلے پیغامات کے لیے خفیہ کردہ شکل میں رکھا جاتا ہے، چیٹ کے ایک گھنٹہ غیر فعال رہنے تک اور پڑھنے کے بعد زیادہ سے زیادہ چار گھنٹے تک استعمال ہوتا ہے، پھر چند دنوں کے اندر خود بخود مٹا دیا جاتا ہے۔</li>
					<li>taf کے رن اور چیٹس، چیٹ کے خلاصے کے ساتھ: 30 دن۔ اس کے میموری نوٹس: taf کے ہٹائے جانے تک۔</li>
					<li>Coach کے اگلے جواب کے لیے مختصر نوٹس، جیسے چیٹ میں کنکشن کیوں نہ بن سکا، یا Card منظور ہوا: اس جواب کے انہیں لینے تک، زیادہ سے زیادہ 7 دن؛ اس کے بعد، اس چیٹ کے حصے کے طور پر، جب تک چیٹ رکھی جاتی ہے۔ دوبارہ بھیجے گئے پیغام کو وہی نوٹ ملے، اس لیے ایک کاپی 24 گھنٹے رکھی جاتی ہے۔ چیٹ کا نوٹ صرف اسی چیٹ میں استعمال ہوتا ہے۔</li>
					<li>چیٹ میں آپ کی جوڑی ہوئی فائلیں: جس پیغام سے جڑی ہیں اس کے ساتھ، 30 دن، یا چیٹ ہٹنے پر اس سے پہلے، اور ہر صورت میں 38 دن کے اندر۔ جس فائل کو کوئی پیغام استعمال نہیں کرتا وہ اپ لوڈ کے تقریباً ایک گھنٹے بعد ہٹا دی جاتی ہے۔ اکاؤنٹ حذف کرنے سے وہ مٹ جاتی ہیں۔</li>
					<li>آپ کے tafs کی فراہم کردہ فائلیں: رن کے انہیں بنانے سے 30 دن، پھر ایک دن کے اندر خود بخود مٹا دی جاتی ہیں۔ آپ کے اکاؤنٹ کا کوئی بھی شخص اسے ابھی حذف کریں سے پہلے حذف کر سکتا ہے: فائل خود فوراً چلی جاتی ہے، کوئی کاپی نہیں رکھی جاتی؛ اس کا نام، سائز اور اسے بنانے والا taf اور رن tafs کے اسٹور کی خفیہ کردہ پوائنٹ ان ٹائم کاپیوں میں 35 دن تک رہ سکتے ہیں، صرف ناکامی کے بعد اسے بحال کرنے کے لیے استعمال ہوتے ہیں۔ taf ہٹانے یا آپ کا اکاؤنٹ حذف کرنے سے اس کی فائلیں مٹ جاتی ہیں۔ فائل شیئر کرنے سے فائل خود بھیجی جاتی ہے، اور آپ کی شیئر کی ہوئی کاپی اس ایپ کے پاس رہتی ہے جسے آپ نے بھیجی۔ فائل ڈاؤن لوڈ کرنے کے لیے ہم آپ کے اکاؤنٹ کے سائن اِن رکن کے لیے ایک لنک بناتے ہیں جو ایک منٹ بعد کام کرنا بند کر دیتا ہے؛ اس کا کوئی اور لنک نہیں بناتے۔</li>
					<li>planque کے ہر کال کے ریکارڈ میں ٹول نے جو لوٹایا: 24 گھنٹے۔ اس کے بعد ریکارڈ صرف یہ رکھتا ہے کہ کال بھیجی گئی یا نہیں، تاکہ وہ کبھی دو بار نہ بھیجی جائے۔</li>
					<li>planque میں کنکشن کا ٹوکن یا key، یا Composio پر منظم کنکشن کا سائن اِن: آپ کے ڈسکنیکٹ کرنے تک۔ اگر آپ کا کوئی اور کنکشن اس وینڈر پر وہی اکاؤنٹ استعمال کر سکتا ہو، تو وہ، غیر استعمال شدہ، تب تک رکھا جاتا ہے جب تک وہ بھی ڈسکنیکٹ نہ ہو جائے، پھر منسوخ کر دیا جاتا ہے۔ اس کی منظوریوں کا ریکارڈ: اکاؤنٹ ختم ہونے تک۔</li>
					<li>آلے کا push ٹوکن: آپ کے ایپ سے سائن آؤٹ کرنے، آلہ ہٹانے، یا Apple یا Google کے ٹوکن کے جانے کی اطلاع دینے تک۔ آلے کی عوامی کلید، نام، پلیٹ فارم اور تاریخیں: جب تک آپ اسے استعمال کرتے ہیں؛ اسے سائن آؤٹ کرنے کے بعد وہ ہٹایا ہوا نشان زد ہوتا ہے اور اکاؤنٹ حذف ہونے تک رکھا جاتا ہے، تاکہ KIFF اس سے دیر سے آیا جواب مسترد کر سکے اور دکھا سکے کہ پہلے والے پر کس آلے نے دستخط کیے تھے۔ Passkey کی عوامی کلید، id اور نام: اس کے آلے کی طرح۔ کمپیوٹر کا سیشن: 90 دن تک، یا آپ کے سائن آؤٹ کرنے تک۔</li>
					<li>آپ کا اکاؤنٹ: اس کے حذف ہونے تک۔ سروس لاگز: 30 دن۔ tafs اور planque کے اسٹورز خفیہ کردہ پوائنٹ ان ٹائم کاپیاں 35 دن رکھتے ہیں، صرف ناکامی کے بعد اسٹور بحال کرنے کے لیے استعمال ہوتی ہیں۔</li>
				</ul>
				<p>باقی سب کچھ <a href="/ur/privacy#retention">KIFF کے برقرار رکھنے کے حصے</a> میں ہے۔</p>
			</section>
			<section id="lawful-bases">
				<h2>9. قانونی بنیادیں</h2>
				<p>معاہدے کی تکمیل، آپ کے اکاؤنٹ اور آپ کے tafs کو چلانے کے لیے۔ جائز مفادات، سیکیورٹی، دھوکہ دہی کی روک تھام اور غلط استعمال کی نشاندہی کے لیے۔ رضامندی، tafs میں AI کے لیے (<a href="#ai">حصہ 5</a>)۔ قانونی ذمہ داری، ٹیکس ریکارڈ کے لیے۔ تفصیل <a href="/ur/privacy#lawful-bases">KIFF کی رازداری کی پالیسی</a> میں ہے۔</p>
			</section>
			<section id="rights">
				<h2>10. آپ کے حقوق</h2>
				<p>GDPR کے تحت آپ اپنے ڈیٹا تک رسائی، اس کی درستی، مٹانے، پابندی یا قابلِ منتقلی کاپی کی درخواست کر سکتے ہیں، جائز مفادات پر مبنی پراسیسنگ پر اعتراض کر سکتے ہیں، اور رضامندی واپس لے سکتے ہیں۔ <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a> پر ای میل کریں؛ ہم ایک ماہ کے اندر جواب دیتے ہیں۔ ایپ میں، اکاؤنٹ ← میری چیٹس ایکسپورٹ کریں آپ کی اپنی چیٹس اور نوٹس ڈاؤن لوڈ کرتا ہے۔</p>
				<p>اپنا tafs اکاؤنٹ حذف کرنے کے لیے ایپ کھولیں، اکاؤنٹ پر جائیں اور <em>اکاؤنٹ حذف کریں</em> پر ٹیپ کریں، پھر تصدیق کریں۔ اسے واپس نہیں کیا جا سکتا۔ کیا اور کب حذف ہوتا ہے، اور ای میل سے کیسے درخواست کریں، یہ <a href="/ur/privacy#delete-account">KIFF کی رازداری کی پالیسی</a> بتاتی ہے۔</p>
				<p>آپ <a href="https://www.aki.ee/en" target="_blank" rel="noopener">ایسٹونیا کے ڈیٹا پروٹیکشن انسپکٹوریٹ (Andmekaitse Inspektsioon)</a> سے، یا اپنی رہائش کی جگہ کے نگران ادارے سے شکایت کر سکتے ہیں۔</p>
				<p><strong>آپ کا ملک۔</strong> کچھ ممالک کے قوانین اس پالیسی سے زیادہ مانگتے ہیں۔ وہ جو شامل کرتے ہیں، انگریزی میں اور اس ملک کی زبان میں، <a href="/privacy/countries">آپ کا ملک</a> (انگریزی میں) پر ہے۔</p>
			</section>
			<section id="more">
				<h2>11. سیکیورٹی، بچے اور تبدیلیاں</h2>
				<p>ہمارے سیکیورٹی اقدامات <a href="/security">/security</a> (انگریزی میں) پر ہیں۔ tafs بچوں کے لیے نہیں ہے، اور ہم جان بوجھ کر 16 سال سے کم عمر کے بچوں سے ذاتی ڈیٹا جمع نہیں کرتے۔ ہم اس پالیسی کو اسی طرح بدلتے ہیں جیسا <a href="/ur/privacy#changes">KIFF کی رازداری کی پالیسی</a> اپنے لیے کہتی ہے۔</p>
			</section>
			<section id="contact">
				<h2>12. رابطہ</h2>
				<p>رازداری سے متعلق سوالات اور درخواستیں: <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>۔ رسمی قانونی نوٹسز: <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>۔ ایپ کی اپنی شرائط <a href="/ur/tafs/terms">/tafs/terms</a> پر ہیں۔</p>
			</section>
		</article>
	}
}

// tafsPrivacyGoogleUR is what tafs does with the data it receives from Google,
// for Google's review of tafs's sign-in, with the Limited Use statement in
// Google's own words.
templ tafsPrivacyGoogleUR() {
	<section id="google">
		<h2>6. Google صارف ڈیٹا</h2>
		if len(googleManaged()) == 0 && len(googleInHouse("ur")) > 0 {
			<p>جب آپ کہتے ہیں، تو tafs کسی taf کو آپ کے Google اکاؤنٹ سے جوڑتا ہے، جیسے اس کے کام میں استعمال ہونے والی Google Sheets یا Google Calendar سے، ایپ کے Connect apps میں۔ یہ حصہ بتاتا ہے کہ tafs اس ڈیٹا کے ساتھ کیا کرتا ہے جو اسے Google سے ملتا ہے۔</p>
		} else {
			<p>جب آپ کہتے ہیں، تو tafs کسی taf کو آپ کے Google اکاؤنٹ سے جوڑتا ہے، جیسے آپ کے Gmail سے، یا اس کے کام میں استعمال ہونے والی Google Calendar یا Google Sheets سے، ایپ کے Connect apps میں۔ یہ حصہ بتاتا ہے کہ tafs اس ڈیٹا کے ساتھ کیا کرتا ہے جو اسے Google سے ملتا ہے۔</p>
		}
		<ul>
			if len(googleManaged()) == 0 && len(googleInHouse("ur")) > 0 {
				<li><strong>وہ کیا پڑھتا اور لکھتا ہے:</strong> جو taf کے کام کے لیے درکار ہے: جو اسپریڈ شیٹس وہ اپ ڈیٹ رکھتا ہے، یا جن کیلنڈرز کی وہ دیکھ بھال کرتا ہے ان کے ایونٹس۔ وہ انہیں صرف وہیں بدلتا ہے جہاں taf کا Card اجازت دیتا ہے، اور Card کی حدوں سے اوپر کچھ بھی آپ کی منظوری کا انتظار کرتا ہے۔</li>
			} else {
				<li><strong>وہ کیا پڑھتا اور لکھتا ہے:</strong> جو taf کے کام کے لیے درکار ہے۔ آپ کے Gmail میں وہ ان پیغامات اور تھریڈز کو پڑھتا ہے جن کا جواب چاہیے، اور مسودے لکھتا ہے؛ وہ میل صرف وہیں بھیجتا ہے جہاں taf کا Card اجازت دیتا ہے۔ Google Calendar اور Google Sheets میں وہ جن کیلنڈرز کی دیکھ بھال کرتا ہے ان کے ایونٹس، یا جو اسپریڈ شیٹس اپ ڈیٹ رکھتا ہے انہیں پڑھتا ہے، اور انہیں صرف وہیں بدلتا ہے جہاں taf کا Card اجازت دیتا ہے۔
					if googleListed("Google Tasks") {
						Google Tasks میں وہ جن ٹاسک لسٹس کی دیکھ بھال کرتا ہے انہیں پڑھتا ہے، اور ٹاسکس صرف وہیں شامل کرتا، مکمل کرتا، منتقل کرتا یا حذف کرتا ہے جہاں taf کا Card اجازت دیتا ہے۔
					}
					Card کی حدوں سے اوپر کچھ بھی آپ کی منظوری کا انتظار کرتا ہے۔</li>
			}
			<li><strong>کیوں:</strong> صرف اس taf کے لیے آپ کے طے کیے کام کو کرنے کے لیے، اور آپ کو یہ دکھانے کے لیے کہ وہ کس Google اکاؤنٹ سے جڑا ہے: اس کا ای میل پتہ، جو کنکشن کے ساتھ آپ کے ڈسکنیکٹ کرنے تک رکھا جاتا ہے۔</li>
			if len(googleManaged()) > 0 || len(googleInHouse("ur")) > 0 {
				<li>
					<strong>ہر Google ایپ کیسے جڑتی ہے:</strong>
					<ul>
						if len(googleManaged()) > 0 {
							<li>ہمارے سائن اِن ساتھی کے ذریعے، جو <a href="/subprocessors">/subprocessors</a> (انگریزی میں) پر درج ہے: { appList(googleManaged()) }.</li>
						}
						if len(googleInHouse("ur")) > 0 {
							<li>tafs کے اپنے Google سائن اِن کے ذریعے، بیچ میں کسی اور کمپنی کے بغیر: { appList(googleInHouseNames()) }.</li>
						}
					</ul>
					if googleBoth() {
						جو ایپ دونوں کے تحت نامزد ہے وہ آپ کے اکاؤنٹ کے مطابق ایک یا دوسرے طریقے سے جڑتی ہے۔ Google کا اپنا سائن اِن صفحہ دکھاتا ہے کہ آپ کسے اجازت دے رہے ہیں۔
					}
				</li>
			}
			if googleBoth() {
				<li>
					<strong>آپ کیا اجازت دیتے ہیں:</strong> آپ Google کے اپنے صفحے پر سائن اِن کرتے ہیں اور چنتے ہیں کہ کیا اجازت دیں۔
					<ul>
						<li><strong>ہمارے سائن اِن ساتھی کے ذریعے:</strong> tafs صرف وہی رسائی مانگتا ہے جو taf کے ٹولز کو چاہیے۔ اگر وہ تنگ رسائی ممکن نہ ہو، تو وہ ایپ کی عام رسائی مانگتا ہے، اور سائن اِن سے پہلے یہ بتاتا ہے۔ اگر عام رسائی میں ایسا ذاتی ڈیٹا آئے جو taf استعمال نہیں کرتا، تو tafs نہیں جوڑتا۔</li>
						<li><strong>tafs کے اپنے Google سائن اِن کے ذریعے:</strong> سائن اِن اس ایپ کے لیے نیچے درج ساری رسائی ایک ساتھ مانگتا ہے، چاہے taf صرف پڑھتا ہو۔</li>
					</ul>
				</li>
			} else if len(googleInHouse("ur")) > 0 {
				<li><strong>آپ کیا اجازت دیتے ہیں:</strong> آپ Google کے اپنے صفحے پر سائن اِن کرتے ہیں اور چنتے ہیں کہ کیا اجازت دیں۔ سائن اِن اس ایپ کے لیے نیچے درج ساری رسائی ایک ساتھ مانگتا ہے، چاہے taf صرف پڑھتا ہو۔</li>
			} else {
				<li><strong>آپ کیا اجازت دیتے ہیں:</strong> آپ Google کے اپنے صفحے پر سائن اِن کرتے ہیں اور چنتے ہیں کہ کیا اجازت دیں۔ tafs صرف وہی رسائی مانگتا ہے جو taf کے ٹولز کو چاہیے۔ اگر وہ تنگ رسائی ممکن نہ ہو، تو وہ ایپ کی عام رسائی مانگتا ہے، اور سائن اِن سے پہلے یہ بتاتا ہے۔ اگر عام رسائی میں ایسا ذاتی ڈیٹا آئے جو taf استعمال نہیں کرتا، تو tafs نہیں جوڑتا۔</li>
			}
			<li><strong>taf اسے کیسے استعمال کرتا ہے:</strong> taf صرف اپنے Card پر منظور شدہ ٹولز استعمال کرتا ہے۔ بھیجنے سے پہلے ہر کال کو اسی ٹول اور انہی دلائل کے لیے ایک اجازت نامے سے جانچا جاتا ہے، اور آپ کی دی ہوئی رسائی سے باہر کی کال مسترد کی جاتی ہے۔ کون سے اعمال ہر بار آپ کی منظوری مانگتے ہیں، یہ Card پر طے ہے۔</li>
			if len(googleInHouse("ur")) > 0 {
				<li>
					if googleBoth() {
						<strong>tafs کے اپنے Google سائن اِن کی مانگی ہوئی رسائی:</strong>
					} else {
						<strong>tafs کی مانگی ہوئی رسائی:</strong>
					}
					<ul>
						for _, a := range googleInHouse("ur") {
							<li>
								{ a.Name }
								<ul>
									for _, s := range a.Scopes {
										<li><code>{ s.ID }</code>: { s.What }</li>
									}
								</ul>
							</li>
						}
					</ul>
					سائن اِن جتنی بھی اجازت دے، taf صرف اپنے Card کے ٹولز استعمال کرتا ہے۔
				</li>
			}
			if googleBoth() {
				<li>
					<strong>آپ کا سائن اِن کون رکھتا ہے:</strong>
					<ul>
						<li><strong>ہمارے سائن اِن ساتھی کے ذریعے:</strong> آپ کا Google سائن اِن ہمارا سائن اِن ساتھی رکھتا ہے، جو <a href="/subprocessors">/subprocessors</a> (انگریزی میں) پر درج ہے، اور وہ کبھی کسی taf یا planque کو نہیں دیا جاتا۔ نہ taf، نہ tafs آپ کا پاس ورڈ یا Google ٹوکنز دیکھتا ہے۔ وہی رسائی چاہنے والا آپ کا کوئی اور taf سائن اِن کا دوبارہ استعمال کرتا ہے، اور ہر taf صرف وہی ٹولز استعمال کرتا ہے جو آپ نے اس کے لیے منظور کیے۔</li>
						<li><strong>tafs کے اپنے Google سائن اِن کے ذریعے:</strong> tafs کی اپنی کنکشن سروس planque آپ کا Google ٹوکن آپ کی کمپنی کے لیے یورپی یونین (آئرلینڈ) میں AWS KMS سے خفیہ کر کے رکھتی ہے، اور اسے صرف ایسی کال کرنے کے لیے استعمال کرتی ہے جس کی taf کا Card اجازت دیتا ہے۔ وہ کبھی کسی taf کو نہیں دیا جاتا، اور نہ taf، نہ AI ماڈل آپ کا پاس ورڈ یا Google ٹوکنز دیکھتا ہے۔ وہی رسائی چاہنے والا آپ کا کوئی اور taf سائن اِن کا دوبارہ استعمال کرتا ہے، اور ہر taf صرف وہی ٹولز استعمال کرتا ہے جو آپ نے اس کے لیے منظور کیے۔</li>
					</ul>
				</li>
			} else if len(googleInHouse("ur")) > 0 {
				<li><strong>آپ کا سائن اِن کون رکھتا ہے:</strong> tafs کی اپنی کنکشن سروس planque آپ کا Google ٹوکن آپ کی کمپنی کے لیے یورپی یونین (آئرلینڈ) میں AWS KMS سے خفیہ کر کے رکھتی ہے، اور اسے صرف ایسی کال کرنے کے لیے استعمال کرتی ہے جس کی taf کا Card اجازت دیتا ہے۔ وہ کبھی کسی taf کو نہیں دیا جاتا، اور نہ taf، نہ AI ماڈل آپ کا پاس ورڈ یا Google ٹوکنز دیکھتا ہے۔ وہی رسائی چاہنے والا آپ کا کوئی اور taf سائن اِن کا دوبارہ استعمال کرتا ہے، اور ہر taf صرف وہی ٹولز استعمال کرتا ہے جو آپ نے اس کے لیے منظور کیے۔</li>
			} else {
				<li><strong>آپ کا سائن اِن کون رکھتا ہے:</strong> آپ کا Google سائن اِن ہمارا سائن اِن ساتھی رکھتا ہے، جو <a href="/subprocessors">/subprocessors</a> (انگریزی میں) پر درج ہے، اور وہ کبھی کسی taf یا planque کو نہیں دیا جاتا۔ نہ taf، نہ tafs آپ کا پاس ورڈ یا Google ٹوکنز دیکھتا ہے۔ وہی رسائی چاہنے والا آپ کا کوئی اور taf سائن اِن کا دوبارہ استعمال کرتا ہے، اور ہر taf صرف وہی ٹولز استعمال کرتا ہے جو آپ نے اس کے لیے منظور کیے۔</li>
			}
			if googleBoth() {
				<li>
					<strong>اسے اور کون پاتا ہے:</strong> taf جو Google سے پڑھتا ہے وہ، صرف آپ کے اجازت دینے کے بعد (دیکھیں: <a href="#ai">tafs میں AI</a>)، taf کو چلانے والے AI ماڈل کو جاتا ہے، جو اسے اپنے فراہم کنندہ کی شرائط کے تحت 30 دن تک رکھتا ہے۔
					<ul>
						<li><strong>ہمارے سائن اِن ساتھی کے ذریعے:</strong> وہ ہر کال کرنے والے ہمارے سائن اِن ساتھی سے بھی ہو کر گزرتا ہے۔</li>
						<li><strong>tafs کے اپنے Google سائن اِن کے ذریعے:</strong> planque خود Google کو کال کرتا ہے، اس لیے کوئی اور کمپنی کال نہیں کرتی یا آپ کا سائن اِن نہیں رکھتی۔</li>
					</ul>
					دونوں <a href="/subprocessors">/subprocessors</a> (انگریزی میں) پر درج ہیں۔
				</li>
			} else if len(googleInHouse("ur")) > 0 {
				<li><strong>اسے اور کون پاتا ہے:</strong> taf جو Google سے پڑھتا ہے وہ، صرف آپ کے اجازت دینے کے بعد (دیکھیں: <a href="#ai">tafs میں AI</a>)، taf کو چلانے والے AI ماڈل کو جاتا ہے، جو اسے اپنے فراہم کنندہ کی شرائط کے تحت 30 دن تک رکھتا ہے۔ planque خود Google کو کال کرتا ہے، اس لیے کوئی اور کمپنی کال نہیں کرتی یا آپ کا سائن اِن نہیں رکھتی۔ AI ماڈل کا فراہم کنندہ <a href="/subprocessors">/subprocessors</a> (انگریزی میں) پر درج ہے۔</li>
			} else {
				<li><strong>اسے اور کون پاتا ہے:</strong> taf جو Google سے پڑھتا ہے وہ، صرف آپ کے اجازت دینے کے بعد (دیکھیں: <a href="#ai">tafs میں AI</a>)، taf کو چلانے والے AI ماڈل کو جاتا ہے، جو اسے اپنے فراہم کنندہ کی شرائط کے تحت 30 دن تک رکھتا ہے۔ وہ ہر کال کرنے والے ہمارے سائن اِن ساتھی سے بھی ہو کر گزرتا ہے۔ دونوں <a href="/subprocessors">/subprocessors</a> (انگریزی میں) پر درج ہیں۔</li>
			}
			<li><strong>AI کی تربیت:</strong> Google صارف ڈیٹا AI ماڈلز کی تربیت کے لیے استعمال نہیں ہوتا۔</li>
			<li><strong>تصاویر:</strong> tafs تصاویر یا ویڈیو نہیں بناتا یا ایڈٹ کرتا: اس کا AI ٹیکسٹ لکھتا ہے۔ وہ Google APIs یا Google صارف ڈیٹا کو کبھی کسی کی قریبی تصاویر (بغیر رضامندی کی قریبی تصاویر، NCII)، یا کسی شخص کی کوئی اور تصویر بنانے، ایڈٹ کرنے یا شیئر کرنے کے لیے استعمال نہیں کرتا۔</li>
			if len(googleManaged()) == 0 && len(googleInHouse("ur")) > 0 {
				<li><strong>کتنی دیر، اور کہاں:</strong> آپ کی اسپریڈ شیٹس اور ایونٹس آپ کے Google اکاؤنٹ میں رہتے ہیں۔ tafs کے اپنے اسٹور میں، ٹول جو لوٹاتا ہے وہ صرف taf کے رن ختم ہونے تک رکھا جاتا ہے۔ planque، جو ہر کال آگے بڑھاتا ہے، Google جو لوٹاتا ہے اسے 24 گھنٹے رکھتا ہے، تاکہ دہرائی گئی کال کو وہی جواب ملے اور وہ کبھی دو بار نہ بھیجی جائے؛ اس کے بعد وہ صرف یہ رکھتا ہے کہ کال بھیجی گئی یا نہیں۔ چیٹ میں، جو صرف پڑھا گیا وہ خفیہ کردہ شکل میں رکھا جاتا ہے، چیٹ کے ایک گھنٹہ غیر فعال رہنے تک اور پڑھنے کے بعد زیادہ سے زیادہ چار گھنٹے تک استعمال ہوتا ہے، پھر چند دنوں کے اندر خود بخود مٹا دیا جاتا ہے۔ رن کا ریکارڈ اور اس کی چیٹ 30 دن رکھے جاتے ہیں، اور taf کے نوٹس آپ کے taf کو ہٹانے تک (دیکھیں: <a href="#retention">ہم اسے کتنی دیر رکھتے ہیں</a>)۔</li>
			} else {
				<li><strong>کتنی دیر، اور کہاں:</strong> آپ کے مسودے، ایونٹس اور اسپریڈ شیٹس آپ کے Google اکاؤنٹ میں رہتے ہیں۔ tafs کے اپنے اسٹور میں، ٹول جو لوٹاتا ہے وہ صرف taf کے رن ختم ہونے تک رکھا جاتا ہے۔ planque، جو ہر کال آگے بڑھاتا ہے، Google جو لوٹاتا ہے اسے 24 گھنٹے رکھتا ہے، تاکہ دہرائی گئی کال کو وہی جواب ملے اور وہ کبھی دو بار نہ بھیجی جائے؛ اس کے بعد وہ صرف یہ رکھتا ہے کہ کال بھیجی گئی یا نہیں۔ چیٹ میں، جو صرف پڑھا گیا وہ خفیہ کردہ شکل میں رکھا جاتا ہے، چیٹ کے ایک گھنٹہ غیر فعال رہنے تک اور پڑھنے کے بعد زیادہ سے زیادہ چار گھنٹے تک استعمال ہوتا ہے، پھر چند دنوں کے اندر خود بخود مٹا دیا جاتا ہے۔ رن کا ریکارڈ اور اس کی چیٹ 30 دن رکھے جاتے ہیں، اور taf کے نوٹس آپ کے taf کو ہٹانے تک (دیکھیں: <a href="#retention">ہم اسے کتنی دیر رکھتے ہیں</a>)۔</li>
			}
			<li>
				<strong>اسے روکنا:</strong>
				<ul>
					<li>ایپ میں، Connect apps میں یا taf کے Card ٹیب پر، Google کو ڈسکنیکٹ کریں۔ اس کے Google ٹولز فوراً رک جاتے ہیں، اور tafs Google سے سائن اِن فوراً منسوخ کرنے کو کہتا ہے؛ یہ تھوڑی دیر بعد مکمل ہو سکتا ہے۔</li>
					<li>کسی taf کو ہٹائیں، اور اس کے کنکشنز اس کے ساتھ ختم ہو جاتے ہیں۔ جس Google سائن اِن کا آپ کا کوئی اور taf اب بھی استعمال کرتا ہے، وہ آخری taf کے جانے تک رہتا ہے۔</li>
					<li>tafs کی رسائی کسی بھی وقت اپنے Google Account میں ہٹائیں، <a href="https://myaccount.google.com/permissions">myaccount.google.com/permissions</a> پر۔ آپ کے tafs Google تک پہنچنا بند کر دیتے ہیں، اور ایپ آپ کو بتاتی ہے کہ Google کنکشن سائن آؤٹ ہے۔</li>
					<li>اپنا اکاؤنٹ حذف کریں: اس کے taf، چیٹس، نوٹس، فائلیں اور کنکشنز فوراً مٹ جاتے ہیں، اور ان کی پوائنٹ ان ٹائم کاپیوں سے 35 دن کے اندر، اور اس کے Google ٹوکنز وہاں منسوخ کر دیے جاتے ہیں جہاں Google اجازت دیتا ہے۔</li>
				</ul>
			</li>
		</ul>
		<p lang="en">tafs's use and transfer to any other app of information received from Google APIs will adhere to <a href="https://developers.google.com/terms/api-services-user-data-policy">Google API Services User Data Policy</a>, including the Limited Use requirements.</p>
	</section>
