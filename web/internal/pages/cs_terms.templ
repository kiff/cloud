package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// TermsCS is the Terms of Service (/terms) in Czech, at /cs/terms. It is
// a translation of Terms: the same sections, anchors, links and figures,
// held to it by TestTranslationsKeepTheEnglishPage. The English page
// governs. Change the English page first, then this one. Czech has the
// legal texts only, so a link to any other page goes to English and says
// so.
templ TermsCS() {
	@components.LayoutSite("KIFF — podmínky služby", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@termsHeadCS()
			@termsDefinitionsCS()
			@termsAgreementCS()
			@termsServiceCS()
			@termsTafsCS()
			@termsAccountCS()
			@termsAcceptableUseCS()
			@termsCustomerDataCS()
			@termsConfidentialityCS()
			@termsFeesCS()
			@termsTermCS()
			@termsWarrantiesCS()
			@termsDisclaimerCS()
			@termsLiabilityCS()
			@termsIndemnityCS()
			@termsSLACS()
			@termsServiceModsCS()
			@termsTermsModsCS()
			@termsForceMajeureCS()
			@termsGoverningLawCS()
			@termsGeneralCS()
			@termsContactCS()
		</article>
	}
}

templ termsHeadCS() {
	<header class="legal-head">
		<p class="legal-badge">Podmínky služby · v0.1</p>
		<h1>Podmínky služby</h1>
		<p class="legal-meta">
			<strong>Poslední aktualizace:</strong> 22. listopadu 2026.
			<strong>Datum účinnosti:</strong> 24. května 2026.
		</p>
		<p class="legal-disclaimer">
			<strong>Co se změnilo:</strong> s kým máte smlouvu, když vás představil jiný podnik (§2), a mikropodniky (§8). Dříve: kdo smí Službu používat, podle regionu, vlastnictví a sankcí (§4); aplikace tafs v Androidu a
			Solo zakoupené přes Google Play (§1, §8). Ještě předtím: placené
			tarify (§3A, §8),
			<a href="/legal/sla">smlouva o úrovni služeb</a> (anglicky) (§14) a
			seznam zakázaných způsobů užití, který je nyní v
			<a href="/acceptable-use">zásadách přijatelného užívání</a> (anglicky) (§5).
		</p>
		<p class="legal-disclaimer">
			Tyto podmínky upravují používání KIFF Cloud, včetně tafs. Smluvní
			dotazy:
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>.
		</p>
	</header>
}

templ termsDefinitionsCS() {
	<section id="definitions">
		<h2>1. Definice</h2>
		<ul>
			<li><strong>„Kiff Agents OÜ“</strong>, <strong>„my“</strong>, <strong>„nás“</strong>, <strong>„náš“</strong> — estonská společnost s ručením omezeným, která poskytuje Službu. Registrační kód 17372313.</li>
			<li><strong>„Zákazník“</strong>, <strong>„vy“</strong>, <strong>„váš“</strong> — fyzická nebo právnická osoba, která souhlasí s těmito podmínkami.</li>
			<li><strong>„Uživatel“</strong> — každá fyzická osoba, které Zákazník povolí přístup ke Službě prostřednictvím účtu Zákazníka.</li>
			<li><strong>„Služba“</strong> — produkt KIFF Cloud, včetně <code>api.kiff.dev</code>, <code>app.kiff.dev</code>, <code>kiff.dev</code>, tafs a dokumentace, ovládacích panelů a API, které tam zveřejňujeme.</li>
			<li><strong>„tafs“</strong> — aplikace tafs pro iPhone, iPad, Android a počítače (Mac, Windows a Linux) a služba za ní, včetně Setupu a planque (§3A), v níž Zákazník svěří úlohu AI agentovi, který pracuje v mezích KIFF Cards. <strong>„Taf“</strong> je jeden takový agent.</li>
			<li><strong>„Tenant“</strong> — logicky oddělený pracovní prostor ve Službě, který patří jedinému Zákazníkovi.</li>
			<li><strong>„Auditní údaje“</strong> — události, rozhodnutí, akce, schválení a potvrzení, které Služba uchovává jménem Zákazníka prostřednictvím běhového prostředí.</li>
			<li><strong>„Údaje tafs“</strong> — to, co tafs uchovává jménem Zákazníka: běhy a chaty každého tafu (včetně toho, co mu vracejí připojené nástroje Zákazníka), jeho hlášení, jeho poznámky v paměti a telefony registrované pro jeho upozornění.</li>
			<li><strong>„Potvrzení“</strong> — podepsaný verzovaný záznam o rozhodnutí, který Služba vydává pro každou řízenou akci.</li>
			<li><strong>„Dokumentace“</strong> — technická dokumentace Služby a bezpečnostní opatření v datované revizi, na kterou odkazují tyto Podmínky (<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>). Nezahrnuje strategický whitepaper, marketingové materiály ani dokumentaci k samostatně licencovanému open-source frameworku.</li>
			<li><strong>„DPA“</strong> — smlouva o zpracování osobních údajů na <a href="/legal/dpa">/legal/dpa</a> (anglicky), která upravuje náš vztah v roli zpracovatele.</li>
		</ul>
	</section>
}

templ termsAgreementCS() {
	<section id="agreement">
		<h2>2. Smlouva</h2>
		<p>
			Tyto podmínky upravují vaše používání Služby. Založením
			účtu, vygenerováním klíče API nebo jiným používáním
			Služby s těmito podmínkami souhlasíte. Pokud je přijímáte
			jménem společnosti nebo jiné právnické osoby, prohlašujete,
			že jste oprávněni tuto osobu zavázat, a „vy“
			a „váš“ označují tuto osobu.
		</p>
		<p>
			Pokud vás ke KIFF přivedl nebo agenta, kterého používáte, vytvořil vývojář, partner nebo jiný podnik, uzavíráte smlouvu o Službě přímo s námi, podle těchto podmínek, a přijímáte je sami. Tento podnik není náš zástupce: nemůže za vás přijmout tyto podmínky, udělit souhlas ani schválit platbu a neprodává Službu naším jménem.
		</p>
		<p>
			Pro konkrétní funkce (funkce ve verzi beta, integrace
			třetích stran) můžeme zveřejnit doplňkové podmínky. Pokud
			jsou v rozporu s těmito podmínkami, mají pro danou funkci
			přednost doplňkové podmínky.
		</p>
	</section>
}

templ termsServiceCS() {
	<section id="service">
		<h2>3. Služba</h2>
		<p>
			KIFF Cloud je hostovaná služba pro řízení delegovaných
			akcí. Posuzuje požadavky podle oprávnění a Cardů, které
			Zákazník nastavil, může vyžadovat lidské schválení
			a zaznamenává rozhodnutí o řízení. Podle nastavené
			integrace KIFF autorizovaný požadavek předá dál, nebo
			poskytne autorizaci, kterou ověří chráněný systém.
			Samotnou akci provede připojený systém.
		</p>
		<p>
			Použitelné technické chování, důkazy, požadavky na
			integraci a limity provádění jsou stanoveny v datované
			Dokumentaci, na kterou odkazují tyto Podmínky. Strategický
			<a href="/whitepaper">whitepaper</a> (anglicky) vysvětluje
			principy a model KIFF; podle těchto Podmínek není součástí
			technické Dokumentace.
		</p>
		<p>
			Služba řízení KIFF Cloud <em>není</em> agentní framework,
			nástroj pro pracovní postupy, brána k modelům ani
			spravovaná agentní platforma. Kombinuje se s čímkoli, co
			už používáte. Výslovný výčet najdete v části <a href="/#not">„Čím KIFF není“</a> (anglicky)
			na domovské stránce. tafs je jediná
			část Služby, která za vás provozuje agenty, v mezích
			Cardů, které vydáte; popisuje ji §3A.
		</p>
		<p>
			Open-source framework <a href="https://github.com/kiff/kiff" target="_blank" rel="noopener">kiff/kiff</a>
			se řídí vlastní licencí MIT a nespadá pod tyto
			podmínky. Když framework provozujete na vlastní
			infrastruktuře, nevzniká žádná smlouva s Kiff Agents OÜ.
		</p>
	</section>
}

templ termsTafsCS() {
	<section id="tafs">
		<h2>3A. tafs</h2>
		<p>
			V tafs svěříte úlohu (například refundace, placení účtů
			nebo spory u karet) tafu: AI agentovi, který pracuje podle
			plánu s nástroji, které připojíte, v mezích KIFF Cards,
			které pro něj vydáte. Každý taf běží v našem agentním
			běhovém prostředí a model AI, který používá, poskytuje
			Anthropic. Na jeho zadržená volání odpovídáte v aplikaci tafs.
		</p>
		<p>
			<strong>Připojení vašich nástrojů.</strong> Setup, AI agent
			v tafs, který běží jako taf, vám pomůže připojit nástroj
			a nastavit taf pro určitou úlohu. Sám nic
			nepřipojuje. Přihlašujete se u vlastního poskytovatele
			nástroje (například Stripe) a na svém zařízení schvalujete
			každé připojení, nástroje, které taf smí používat, a jeho
			Cardy. Token z tohoto přihlášení uchovává planque, naše
			služba pro připojení. Je šifrovaný, používá se jen
			k provedení volání, o kterém KIFF rozhodl, a nikdy se
			nepředává tafu. Odpojením nástroje se token
			u poskytovatele odvolá a smaže.
		</p>
		<p>
			<strong>Vaše Cardy jsou vaše pokyny.</strong> Taf
			se k vašim nástrojům dostane jen přes KIFF, který každé
			volání před odesláním ověří podle Cardů tafu. Volání
			v mezích Cardu, který jste vydali, se provádí na váš pokyn.
			Volání mimo Card se zadrží nebo odmítne, jak Card stanoví.
			Zadržené volání se provede, až když ho schválí někdo, komu
			váš účet dovoluje odpovídat na zadržená volání. V aplikaci
			tafs nese odpověď podpis z jeho zařízení, který KIFF
			ověří, a potvrzení tento důkaz uchovává. Váš účet může
			odpovídat také přímo v KIFF (v ovládacím panelu, jeho
			nástroji pro příkazový řádek nebo prostřednictvím
			schvalovatele, kterého tam pověříte); potvrzení pak
			zaznamená, kdo odpověděl a jak.
		</p>
		<p>
			<strong>Platby.</strong> Když taf platí za vás v pokladně nějakého webu kartou nebo jinou platební metodou, kterou jste na tomto webu uložili, dělá to jen uvnitř Cardu a až poté, co danou platbu schválíte ve svém telefonu. Vaše schválení opravňuje právě tuto jednu platbu vaším jménem. Web a jeho poskytovatel plateb ji zpracují. KIFF a planque nikdy nedrží vaše peníze, nikdy neukládají údaje o vaší kartě a taf nikdy nezadává číslo karty.
		</p>
		<p>
			<strong>Co zůstává na vás.</strong> Volíte úlohu a Cardy
			každého tafu, odpovídáte na jeho zadržená volání a zajistíte,
			že smíte používat nástroje a účty, které připojujete. Hlášení,
			zprávy a poznámky v paměti tafu píše model AI a mohou
			být chybné; než se na to, na čem záleží, spolehnete,
			ověřte si to.
		</p>
		<p>
			<strong>Zastavení tafu.</strong> Můžete zastavit jeden taf
			nebo všechny, pozastavit taf, odvolat kterýkoli z jeho Cardů
			nebo ho odebrat. Od okamžiku, kdy taf zastavíte nebo Card
			odvoláte, KIFF podle něj nepovolí žádné nové volání. Aplikace
			tafs zobrazí taf jako zastavený až poté, co zastavení
			potvrdí KIFF i planque; od té chvíle planque neodešle
			žádné jeho volání, ani takové, které KIFF povolil těsně
			předtím. Požadavek, který už byl odeslán poskytovateli
			nástroje, se může ještě dokončit: nová volání zastavíme,
			ale nemůžeme vrátit, co poskytovatel udělal. Nástroj,
			který si povolení KIFF ověřuje sám, bez planque, může ještě
			přijmout povolení, které KIFF vydal těsně předtím, nejdéle
			90 sekund. Obnovení zastaveného tafu vyžaduje vaše
			schválení na zařízení a nic, co bylo před zastavením
			zadrženo nebo zařazeno do fronty, se po něm neprovede.
		</p>
		<p>
			<strong>Odebrání tafu</strong> zastaví jeho
			plán a smaže jeho běhy, chaty, paměť a klíč, který
			používal. I předtím se to, co vaše nástroje vracejí tafu,
			uchovává jen do skončení jeho běhu (to, co chat pouze četl,
			šifrovaně, pro jeho další zprávy: používá se nejdéle čtyři
			hodiny, poté se smaže), a jeho běhy a chaty po dobu 30 dní. KIFF uchovává potvrzení o tom, co udělal.
		</p>
		<p>
			<strong>Akt EU o umělé inteligenci.</strong> U tafs je Kiff Agents OÜ
			poskytovatelem systému AI a vy jste jeho zavádějícím
			subjektem. Zajišťujeme, aby vše, co taf napíše někomu
			mimo vaši společnost, uvádělo, že to napsal AI agent.
			tafs používáte jen pro úlohy, které nabízí, a ne pro
			žádné použití, které akt o AI zakazuje nebo řadí mezi
			vysoce riziková, například rozhodování o zaměstnání
			osoby, úvěru nebo přístupu k základním službám.
			Zachováváte lidská schválení, která vaše Cardy vyžadují,
			a zajistíte, aby lidé, kteří za vás tafs používají,
			rozuměli tomu, co dělá, a jeho limitům.
		</p>
		<p>
			<strong>Náklady.</strong> tafs je součástí vašeho tarifu KIFF
			(§8): každý běh tafu spotřebuje kredity za AI, kterou použil.
			Coach a nastavování tafů jsou zahrnuty v rámci přiměřeného
			užívání Coache.
		</p>
	</section>
}

templ termsAccountCS() {
	<section id="account">
		<h2>4. Účty a přístup</h2>
		<p>
			K používání Služby si musíte založit účet. Zavazujete se
			uvádět přesné registrační údaje, zachovávat důvěrnost
			svých přístupových údajů a odpovídat za veškerou
			činnost ve svém účtu.
		</p>
		<p>
			Musí vám být alespoň 16 let, nebo věk digitálního
			souhlasu ve vaší jurisdikci, podle toho, který je vyšší.
			Služba není určena dětem.
		</p>
		<p>
			Služba se nabízí pouze v zemích a regionech, kde svou vlastní službu nabízí Anthropic, který poskytuje její model AI, jak je <a href="https://www.anthropic.com/supported-countries">Anthropic uvádí</a>. Odjinud ji používat nesmíte. Společnost ji nesmí používat, pokud má sídlo v zemi nebo regionu mimo tento seznam, nebo je ve většinovém vlastnictví či pod kontrolou společnosti se sídlem v takové zemi nebo regionu, bez ohledu na to, kde jsou její uživatelé. Nesmíte ji používat ani tehdy, pokud vy nebo společnost, pro kterou ji používáte, podléháte sankcím Evropské unie, Organizace spojených národů nebo Spojených států. Účty, které toto pravidlo porušují, odmítáme a takový účet můžeme pozastavit.
		</p>
		<p>
			Odpovídáte za jednání každého Uživatele, kterému ve svém
			účtu udělíte oprávnění. Pokud zjistíme důvěryhodné
			porušení těchto podmínek, můžeme s přiměřeným předstihem
			pozastavit účet nebo odvolat přístup. Při porušení zásad
			přijatelného užívání (viz §5) může být pozastavení okamžité.
		</p>
	</section>
}

templ termsAcceptableUseCS() {
	<section id="acceptable-use">
		<h2>5. Přijatelné užívání</h2>
		<p>
			Vy, vaši uživatelé a vaši agenti musíte dodržovat
			<a href="/acceptable-use">zásady přijatelného užívání</a> (anglicky). Jsou
			součástí těchto podmínek a uvádějí, k čemu se Služba
			nesmí používat.
		</p>
		<p>
			Při důvěryhodném porušení těchto zásad můžeme okamžitě
			pozastavit přístup. Nejsme povinni sledovat obsah
			Zákazníka, ale můžeme jednat na základě důvěryhodných
			oznámení.
		</p>
	</section>
}

templ termsCustomerDataCS() {
	<section id="customer-data">
		<h2>6. Údaje a obsah Zákazníka</h2>
		<p>
			Vaše Auditní údaje patří vám. Udělujete Kiff Agents OÜ
			omezenou, nevýhradní, bezúplatnou, celosvětovou licenci
			k hostování, kopírování, přenosu, zobrazování a jinému
			zpracování vašich Auditních údajů výhradně v rozsahu
			nezbytném k provozu, údržbě a zlepšování Služby pro vás.
		</p>
		<p>
			U vašich Auditních údajů a vašich Údajů tafs vystupujeme
			jako <strong>zpracovatel</strong> podle článku 28 GDPR;
			tento vztah podrobně upravuje
			<a href="/legal/dpa">DPA</a> (anglicky). U metadat vašeho
			účtu vystupujeme jako <strong>správce</strong>; tento
			vztah upravují
			<a href="/cs/privacy">zásady ochrany osobních údajů</a>.
		</p>
		<p>
			Prohlašujete, že máte všechna práva nezbytná k předání
			údajů, které předáváte, a že jejich předání je v souladu
			s platnými právními předpisy (včetně předpisů o ochraně
			osobních údajů a případně aktu EU o umělé inteligenci).
		</p>
	</section>
}

templ termsConfidentialityCS() {
	<section id="confidentiality">
		<h2>7. Důvěrnost</h2>
		<p>
			Každá strana může od druhé obdržet neveřejné informace
			(„Důvěrné informace“). Přijímající strana použije Důvěrné
			informace jen v rozsahu nezbytném k plnění svých
			povinností a výkonu svých práv podle těchto podmínek
			a bude je chránit alespoň se stejnou péčí, jakou věnuje
			svým vlastním důvěrným informacím.
		</p>
		<p>
			Důvěrnými informacemi nejsou informace, které (a) jsou nebo
			se stanou veřejně dostupnými bez porušení povinnosti,
			(b) byly přijímající straně známy před jejich sdělením,
			(c) byly vytvořeny nezávisle bez použití Důvěrných
			informací, nebo (d) musí být zpřístupněny ze zákona
			(s oznámením druhé straně, pokud je to dovoleno).
		</p>
	</section>
}

templ termsFeesCS() {
	<section id="fees">
		<h2>8. Poplatky a platby</h2>
		<p>
			<strong>Tarify.</strong> Každý účet má jeden tarif.
			Aktuální ceny jsou na <a href="/pricing">stránce
			s ceníkem</a> (anglicky); v době této aktualizace:
		</p>
		<ul>
			<li><strong>Solo:</strong> jedna osoba, pro tafs, prodává se v aplikaci tafs přes App Store nebo Google Play za 12,50 € měsíčně včetně DPH, s 500 kredity měsíčně v ceně.</li>
			<li><strong>Company:</strong> 10,50 € měsíčně za každé místo, s 500 kredity měsíčně za každé místo, sdílenými, a pro volání vašich vlastních agentů přes KIFF Cloud 500 akcemi měsíčně za každé místo, sdílenými.</li>
			<li><strong>Smlouva:</strong> poplatky a podmínky podle její objednávky.</li>
		</ul>
		<p>
			Místa jsou správci a editoři účtu. Schvalovatelé
			a čtenáři jsou v každém tarifu zdarma. V tarifu Company
			stojí nad rámec toho, co je v ceně, kredit 0,01 € a akce 0,02 €.
			Kredity nad rámec těch v ceně se účtují až do
			měsíčního limitu útraty, který si účet nastaví (na začátku 50 €):
			po dosažení limitu KIFF nespustí žádný nový běh tafů
			účtu, dokud nezačne další období nebo dokud limit nezvýší
			někdo, kdo spravuje fakturaci.
		</p>
		<p>
			<strong>Balíčky kreditů.</strong> V tarifu Solo pocházejí
			kredity nad rámec měsíčních kreditů v ceně z balíčků
			kreditů, které se kupují v aplikaci tafs. Balíček se kupuje
			jednorázově, jeho platnost nevyprší a není to předplatné;
			jeho kredity se spotřebují po měsíčních kreditech v ceně,
			nejstarší balíček jako první. Balíček, jehož platba je
			v plné výši vrácena, se odebere i se zbývajícími kredity.
			Když se spotřebují měsíční kredity i balíčky, KIFF
			nespustí žádný nový běh tafů účtu, dokud nezačne další
			období nebo se nepřidá balíček.
			Platnost bonusových kreditů, které KIFF připíše na účet,
			také nevyprší, stejně jako u balíčků.
		</p>
		<p>
			<strong>Co se započítává.</strong> <em>Kredit</em> platí
			za AI, kterou použil běh tafu, v celých kreditech,
			zaokrouhleno nahoru jednou za běh a započteno jednou, když
			běh skončí. Běh, jehož volání KIFF odmítl, svou AI přesto
			použil. Nikdy se nezapočítává: Coach a nastavování tafů
			v rámci přiměřeného užívání Coache; zkouška nové verze,
			která nic neodesílá; a běh, který selhal na naší straně.
			<em>Akce</em> je volání vašeho vlastního agenta přes KIFF
			Cloud, které něco provedlo: KIFF ho povolil, bylo odesláno
			a nástroj ohlásil úspěch. Nikdy se nepočítá jako akce:
			volání, které bylo odmítnuto, zadrženo a poté odmítnuto,
			zastaveno zastavením, neplatné, selhalo v nástroji nebo
			jeho výsledek není znám, a volání, které pouze čte.
		</p>
		<p>
			<strong>Žádná zkušební verze.</strong> Účet platí od prvního
			dne. Než tarif začne, KIFF nespustí žádný běh jeho tafů,
			kromě nastavování s Coachem; nic se nesmaže.
		</p>
		<p>
			<strong>Platby a faktury.</strong> Tarif se účtuje na
			jednom místě. Tarif koupený na kiff.dev se tam kupuje, mění
			a ruší, a také na fakturačním portálu, na který odkazuje,
			a jeho platby zpracovává Stripe. Solo koupené v aplikaci
			tafs se prodává přes App Store na iPhonu a iPadu nebo
			Google Play v Androidu a spravuje se ve vašich předplatných
			Apple nebo předplatných Google Play, podle podmínek daného
			obchodu pro platby, obnovení a refundace. Balíčky kreditů
			se kupují v aplikaci. Company se kupuje na
			kiff.dev. Poplatky se účtují měsíčně předem;
			využití nad rámec toho, co je v ceně, se účtuje s další
			fakturou. Změna počtu osob platí od další
			faktury. Pokud platba selže a není uhrazena, tarif
			skončí a KIFF odmítá volání účtu, dokud není zvolen
			tarif.
		</p>
		<p>
			<strong>Zrušení.</strong> Zrušit můžete kdykoli
			na fakturačním portálu, nebo u Solo koupeného v aplikaci
			ve svých předplatných Apple nebo předplatných Google Play. Tarif trvá do konce
			zaplaceného období a neobnoví se. S výjimkou případů, kdy
			to vyžaduje zákon, se již zaplacené poplatky nevracejí.
			Pokud jste spotřebitel v EU, můžete od nákupu odstoupit do
			14 dní bez udání důvodu a vrátíme vám, co jste
			zaplatili, sníženou o podíl za dny, po které tarif již běžel.
			Nákupy Solo se refundují přes App Store nebo Google Play, podle jejich podmínek.
		</p>
		<p>
			<strong>Mikropodniky.</strong> Pokud má váš podnik méně než 10 osob a roční obrat nebo bilanční sumu nejvýše 2 miliony eur, zacházíme s ním jako se spotřebitelem u všech pravidel těchto podmínek týkajících se plateb kartou, včetně tarifu Company.
		</p>
		<p>
			<strong>DPH.</strong> Ceny Company jsou bez DPH; Solo
			a balíčky kreditů prodává App Store nebo Google
			Play včetně DPH. Kiff Agents OÜ
			(DIČ pro DPH EE102924327) připočítává estonskou DPH tam,
			kde se uplatní. Prodeje mezi podniky v EU Zákazníkovi
			mimo Estonsko s platným identifikačním číslem pro DPH se
			fakturují v režimu přenesení daňové povinnosti v EU.
		</p>
		<p>
			<strong>Změny.</strong> O zvýšení ceny informujeme aktivní
			účty písemně nejméně třicet dní předem (§16). Snížení
			ceny platí od další faktury.
		</p>
	</section>
}

templ termsTermCS() {
	<section id="term">
		<h2>9. Doba trvání a ukončení</h2>
		<p>
			Tyto podmínky nabývají účinnosti, jakmile Službu poprvé
			použijete, a trvají až do ukončení.
		</p>
		<p>
			Ukončit je můžete kdykoli smazáním svého účtu.
			My je můžeme ukončit (a) při podstatném porušení, které
			nebude napraveno do třiceti dní od písemného oznámení,
			nebo (b) okamžitě při porušení zásad přijatelného užívání
			nebo v případě úpadku.
		</p>
		<p id="leaving">
			<strong>Odchod a odnesení vašich údajů s sebou.</strong>
			Své údaje můžete kdykoli exportovat ve strukturovaném,
			strojově čitelném formátu: v KIFF poskytne volba Nastavení → Data
			soubor JSON s vaším účtem, vašimi Cardy se všemi verzemi,
			rozhodnutími ve vašem Záznamu (posledních 10 000; o další
			nás požádejte), podepsaným potvrzením každého, které KIFF
			povolil, a údaji o vašich klíčích API (nikdy samotné
			klíče). V aplikaci tafs každá osoba exportuje své vlastní
			chaty, soubory a poznámky z Účet →  Exportovat mé
			chaty; chaty se v každém případě uchovávají třicet dní, jak
			uvádějí zásady ochrany osobních údajů. Smazáním účtu Služba
			okamžitě končí, proto nejprve exportujte.
		</p>
		<p>
			Místo toho můžete odejít s výpovědí, abyste přešli k jinému
			poskytovateli nebo na vlastní systémy, a to dopisem na
			<a href="mailto:support@kiff.dev">support@kiff.dev</a>.
			Nikdy nevyžadujeme výpovědní lhůtu delší než dva měsíce:
			vaše výpověď nabývá účinnosti ke dni, který zvolíte, nejpozději
			dva měsíce po jejím odeslání. Od tohoto dne následuje
			přechodné období třiceti dní, během něhož Služba dál
			běží, vy exportujete své údaje a přesouváte svou práci a my
			vám s tím pomáháme při přiměřených požadavcích. Přechodné
			období můžete jednou prodloužit, na tak dlouho, jak potřebujete.
			Pokud ho technicky nemůžeme dokončit do třiceti dní, sdělíme
			vám to do čtrnácti pracovních dnů od vaší výpovědi, s uvedením
			důvodů a nového období nepřesahujícího sedm měsíců.
			Po skončení přechodného období zůstávají vaše údaje
			k dispozici pro export ještě nejméně třicet dní. Poplatky
			za tarif běží jako obvykle až do konce přechodného období.
			Solo koupené v App Storu nebo Google Play se ruší v daném
			obchodě; přechodné období a období pro export platí stejně.
		</p>
		<p>
			Za odchod, přechod ani export vašich údajů si nic
			neúčtujeme. Tento oddíl přiznává každému zákazníkovi práva
			na přechod podle kapitoly VI aktu EU o datech (nařízení
			(EU) 2023/2854).
		</p>
		<p>
			Při ukončení a po uplynutí případného přechodného období
			a období pro export smažeme vaše Auditní údaje, vaše Údaje
			tafs a metadata účtu v souladu s pravidly uchovávání
			v <a href="/cs/privacy#retention">zásadách ochrany osobních údajů</a>.
		</p>
		<p>
			Ustanovení, která by svou povahou měla ukončení přetrvat,
			trvají i nadále — včetně důvěrnosti, duševního
			vlastnictví, odškodnění, omezení odpovědnosti,
			vyloučení záruk, rozhodného práva a veškerých vzniklých
			poplatků.
		</p>
	</section>
}

templ termsWarrantiesCS() {
	<section id="warranties">
		<h2>10. Záruky</h2>
		<p>
			Každá strana prohlašuje, že má právo a oprávnění uzavřít
			tyto podmínky a plnit je.
		</p>
		<p>
			Zaručujeme, že budeme Službu poskytovat profesionálně
			a v podstatném souladu s Dokumentací. Vaším jediným
			prostředkem nápravy při porušení této záruky je podle
			naší volby opětovné plnění nebo poměrná refundace
			poplatků připadajících na dotčenou Službu za dobu
			porušení.
		</p>
		<p>
			Zaručujete, že vaše používání Služby je v souladu
			s platnými právními předpisy a těmito podmínkami.
		</p>
	</section>
}

templ termsDisclaimerCS() {
	<section id="disclaimer">
		<h2>11. Vyloučení záruk</h2>
		<p>
			S výjimkou výslovných záruk v §10 se Služba poskytuje
			<strong>„tak, jak je“ a „podle dostupnosti“</strong>.
			V maximálním rozsahu povoleném zákonem vylučujeme všechny
			ostatní záruky, ať výslovné, předpokládané nebo zákonné,
			včetně záruk prodejnosti, vhodnosti pro určitý účel,
			neporušování práv a jakékoli záruky vyplývající ze
			zavedené praxe nebo obchodních zvyklostí.
		</p>
		<p>
			Nezaručujeme, že Služba bude nepřerušená, bez chyb nebo
			bez škodlivých součástí, ani že se žádné údaje neztratí
			nebo nepoškodí. Za zálohování svých údajů odpovídáte vy.
		</p>
	</section>
}

templ termsLiabilityCS() {
	<section id="liability">
		<h2>12. Omezení odpovědnosti</h2>
		<p>
			V maximálním rozsahu povoleném zákonem neodpovídá žádná
			ze stran druhé straně za nepřímé, vedlejší, následné,
			zvláštní, exemplární ani sankční škody, včetně ušlého
			zisku, ušlých příjmů, ztráty údajů nebo přerušení
			podnikání, vyplývající z těchto podmínek nebo ze Služby
			nebo s nimi související, i když byla na možnost takových
			škod upozorněna.
		</p>
		<p>
			Celková odpovědnost každé strany vyplývající z těchto
			podmínek nebo s nimi související nepřesáhne vyšší z částek
			(a) poplatky zaplacené nebo splatné Zákazníkem společnosti
			Kiff Agents OÜ za dvanáct měsíců předcházejících události,
			která odpovědnost založila, nebo (b) sto tisíc
			eur (100 000 €).
		</p>
		<p>
			Nic v těchto podmínkách neomezuje ani nevylučuje
			odpovědnost, kterou nelze omezit ani vyloučit podle
			platných právních předpisů, včetně odpovědnosti za smrt,
			újmu na zdraví způsobenou nedbalostí, podvod nebo úmyslné
			protiprávní jednání a odpovědnosti za vadný výrobek podle
			předpisů provádějících směrnici (EU) 2024/2853
			o odpovědnosti za vadné výrobky.
		</p>
	</section>
}

templ termsIndemnityCS() {
	<section id="indemnification">
		<h2>13. Odškodnění</h2>
		<p>
			Budeme vás bránit proti nárokům třetích stran, že Služba,
			jak ji poskytujeme a jak ji používáte v souladu s těmito
			podmínkami, porušuje práva duševního vlastnictví této
			třetí strany, a zaplatíme škody, které vám budou
			pravomocně přiznány k úhradě (nebo dohodnutou částku
			narovnání), za takové nároky.
		</p>
		<p>
			Vy nás budete bránit proti nárokům třetích stran
			vyplývajícím z (a) vašich údajů nebo obsahu Zákazníka;
			(b) vašeho používání Služby v rozporu s těmito podmínkami
			(včetně zásad přijatelného užívání); nebo (c) vaší hrubé
			nedbalosti nebo úmyslného protiprávního jednání,
			a zaplatíte škody, které nám budou pravomocně přiznány
			k úhradě (nebo dohodnutou částku narovnání), za takové
			nároky.
		</p>
		<p>
			Odškodnění je podmíněno včasným oznámením nároku,
			výhradní kontrolou obrany a narovnání odškodňující stranou
			a přiměřenou součinností odškodňované strany. Odškodňující
			strana nesmí bez souhlasu uzavřít narovnání nároku, které
			ukládá povinnosti odškodňované straně.
		</p>
	</section>
}

templ termsSLACS() {
	<section id="sla">
		<h2>14. Závazek úrovně služeb</h2>
		<p>
			U placeného tarifu stanoví <a href="/legal/sla">smlouva
			o úrovni služeb</a> (anglicky) dostupnost, ke které se
			zavazujeme, jak se počítá pomalý nebo neúspěšný požadavek,
			naše doby odezvy podpory a kredity za službu, když
			nedostojíme svému závazku. Je součástí těchto podmínek.
		</p>
		<p>
			Provozní postupy, reakce na incidenty a závazky
			k oznamování porušení zabezpečení jsou popsány v datované
			revizi, na kterou odkazují tyto Podmínky
			(<a href="https://kiff.dev/docs/archive/2026-10-10">kiff.dev/docs/archive/2026-10-10</a>);
			stránka <a href="/security">/security</a> (anglicky) ukazuje
			aktuální postupy.
		</p>
	</section>
}

templ termsServiceModsCS() {
	<section id="service-mods">
		<h2>15. Změny Služby</h2>
		<p>
			Funkce můžeme kdykoli přidávat, měnit nebo odebírat.
			O podstatném omezení funkčnosti nebo ukončení podpory
			části API, které naruší zdokumentované chování,
			informujeme aktivní zákazníky nejméně třicet dní
			předem, se zveřejněným harmonogramem ukončení podpory.
			Změny z bezpečnostních důvodů můžeme provést bez
			oznámení, pokud by samotné oznámení vytvořilo riziko.
		</p>
	</section>
}

templ termsTermsModsCS() {
	<section id="terms-mods">
		<h2>16. Změny těchto podmínek</h2>
		<p>
			Tyto podmínky můžeme čas od času měnit. O podstatných
			změnách informujeme e-mailem a výrazným bannerem na
			této stránce nejméně třicet dní předem. Nepodstatné
			změny (upřesnění, odkazy) zveřejňujeme s novým datem
			„poslední aktualizace“. Pokračováním v používání
			Služby po dni účinnosti aktualizace vyjadřujete
			souhlas.
		</p>
	</section>
}

templ termsForceMajeureCS() {
	<section id="force-majeure">
		<h2>17. Vyšší moc</h2>
		<p>
			Žádná ze stran neodpovídá za neplnění nebo prodlení
			s plněním v rozsahu, v jakém je způsobily okolnosti mimo
			její přiměřenou kontrolu, včetně přírodních událostí,
			války, terorismu, občanských nepokojů, pracovních sporů,
			požáru, přírodní katastrofy, vládních opatření
			souvisejících s pandemií, výpadků internetu nebo
			elektřiny nebo jednání poskytovatelů telekomunikačních
			služeb či hostingové infrastruktury třetích stran.
		</p>
	</section>
}

templ termsGoverningLawCS() {
	<section id="governing-law">
		<h2>18. Rozhodné právo a místo řešení sporů</h2>
		<p>
			Tyto podmínky se řídí právem Estonské republiky,
			bez ohledu na jeho kolizní normy. Výlučně příslušným
			soudem pro spory je okresní soud Harju (Harju Maakohus)
			v Tallinnu.
		</p>
		<p>
			Pokud jste spotřebitel s bydlištěm v jiném členském
			státě EU, kogentní pravidla na ochranu spotřebitele vaší
			domovské jurisdikce se nadále uplatní v rozsahu, v jakém
			vám přiznávají práva, kterých se nemůžete smluvně vzdát;
			toto ustanovení vás nezbavuje ochrany těchto pravidel.
		</p>
	</section>
}

templ termsGeneralCS() {
	<section id="general">
		<h2>19. Obecná ustanovení</h2>
		<p>
			<strong>Úplná smlouva.</strong> Tyto podmínky spolu
			se zásadami ochrany osobních údajů, DPA, případnými
			objednávkami a jakýmikoli doplňkovými podmínkami, které
			jsou do nich výslovně začleněny, tvoří úplnou dohodu mezi
			námi o jejich předmětu a nahrazují veškerá předchozí nebo
			souběžná ujednání.
		</p>
		<p>
			<strong>Oddělitelnost.</strong> Pokud je některé ustanovení
			shledáno nevymahatelným, ostatní zůstávají v platnosti.
		</p>
		<p>
			<strong>Postoupení.</strong> Tyto podmínky nesmíte
			postoupit bez našeho písemného souhlasu. My je můžeme
			postoupit bez souhlasu v souvislosti s fúzí, akvizicí
			nebo prodejem veškerého nebo v podstatě veškerého našeho
			majetku, s oznámením vám.
		</p>
		<p>
			<strong>Žádné vzdání se práva.</strong> Nevymáhání
			kteréhokoli ustanovení neznamená vzdání se práva
			vymáhat ho později.
		</p>
		<p>
			<strong>Oznámení.</strong> Oznámení pro Kiff Agents OÜ se
			zasílají na <a href="mailto:legal@kiff.dev">legal@kiff.dev</a>
			nebo poštou na adresu Tööstuse tn 75-71, Põhja-Tallinna
			linnaosa, Tallinn 10416, Estonsko. Oznámení pro vás se
			zasílají na e-mail spojený s vaším účtem, nebo, pokud jste
			ji uvedli, na vámi určenou adresu pro právní oznámení.
		</p>
		<p>
			<strong>Nezávislé smluvní strany.</strong> Nic v těchto
			podmínkách nezakládá společnost, zastoupení, společný
			podnik ani pracovní poměr.
		</p>
		<p>
			<strong>Oprávněné třetí strany.</strong> Žádné nejsou,
			s výjimkou případů, kdy jsou odškodňované přidružené
			osoby výslovně určeny.
		</p>
	</section>
}

