package pages

import (
	"github.com/kiff/cloud/web/internal/components"
)

// PrivacyFR is the privacy policy (/privacy) in French, at /fr/privacy.
// It is a translation of Privacy: the same sections, anchors, links and
// figures, held to it by TestTranslationsKeepTheEnglishPage. The English
// page governs. Change the English page first, then this one.
templ PrivacyFR() {
	@components.LayoutSite("KIFF — politique de confidentialité", "", "css/prose.css", "css/legal.css") {
		<article class="legal prose">
			@privacyHeadFR()
			@privacyWhoWeAreFR()
			@privacyScopeFR()
			@privacyRolesFR()
			@privacyCategoriesFR()
			@privacyLawfulBasesFR()
			@privacySubprocessorsFR()
			@privacyTransfersFR()
			@privacyRetentionFR()
			@privacyRightsFR()
			@privacyCookiesFR()
			@privacySecurityFR()
			@privacyChildrenFR()
			@privacyAutomatedFR()
			@privacyChangesFR()
			@privacyContactFR()
		</article>
	}
}

templ privacyHeadFR() {
	<header class="legal-head">
		<p class="legal-badge">Politique de confidentialité · v0.1</p>
		<h1>Politique de confidentialité</h1>
		<p class="legal-meta">
			<strong>Dernière mise à jour :</strong> 17 novembre 2026.
			<strong>Date d'entrée en vigueur :</strong> 24 mai 2026.
		</p>
		<p class="legal-disclaimer">
			Cette politique explique comment KIFF Cloud traite les
			données personnelles sur le site web, le tableau de bord,
			l'API et l'app tafs pour iPhone, iPad, Android et ordinateurs.
			Questions :
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
	</header>
}

templ privacyWhoWeAreFR() {
	<section id="who-we-are">
		<h2>1. Qui nous sommes</h2>
		<p>
			KIFF Cloud est exploité par <strong>Kiff Agents OÜ</strong>,
			une société à responsabilité limitée immatriculée en
			Estonie. Informations du registre :
		</p>
		<ul>
			<li><strong>Code d'immatriculation :</strong> 17372313 (registre du commerce estonien, e-Business Register)</li>
			<li><strong>Numéro de TVA :</strong> EE102924327</li>
			<li><strong>Siège social :</strong> Tööstuse tn 75-71, Põhja-Tallinna linnaosa, Tallinn 10416, Estonie</li>
			<li><strong>Contact confidentialité :</strong> <a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a></li>
			<li><strong>Notifications juridiques formelles :</strong> <a href="mailto:legal@kiff.dev">legal@kiff.dev</a></li>
		</ul>
		<p>
			Kiff Agents OÜ étant établie dans l'Union européenne, le
			règlement général sur la protection des données de l'UE
			(<abbr title="Règlement général sur la protection des données">RGPD</abbr>)
			s'applique directement à nos traitements. Nous n'avons pas
			besoin d'un représentant dans l'UE au titre de l'article 27.
		</p>
	</section>
}

templ privacyScopeFR() {
	<section id="scope">
		<h2>2. Champ d'application de cette politique</h2>
		<p>
			Cette politique couvre les données personnelles que nous
			traitons lorsque vous utilisez :
		</p>
		<ul>
			<li><a href="https://kiff.dev"><code>kiff.dev</code></a> — notre site de présentation, la page de cette politique et l'affichage public des reçus.</li>
			<li><a href="https://app.kiff.dev"><code>app.kiff.dev</code></a> — notre tableau de bord, accessible après connexion.</li>
			<li><a href="https://api.kiff.dev"><code>api.kiff.dev</code></a> — notre API HTTP.</li>
			<li id="tafs"><strong>tafs</strong> — notre app pour iPhone, iPad, Android et ordinateurs (Mac, Windows et Linux), et le service qui la fait fonctionner (y compris Setup, qui connecte les apps d'une entreprise, et planque, qui conserve ces connexions), dans laquelle une entreprise confie une mission à un agent IA qui travaille dans des Cards KIFF.</li>
		</ul>
		<p>
			Cette politique ne couvre <em>pas</em> le framework open
			source <code>kiff/kiff</code>, que vous pouvez faire tourner
			vous-même. Quand vous faites tourner le framework sur votre
			propre infrastructure, vous êtes le responsable du
			traitement de toutes les données qu'il traite, et Kiff
			Agents OÜ n'intervient pas dans ce traitement.
		</p>
	</section>
}

templ privacyRolesFR() {
	<section id="roles">
		<h2>3. Nos rôles au titre du RGPD</h2>
		<p>
			Nous agissons en deux qualités, selon les données :
		</p>
		<ul>
			<li>
				<strong>Responsable du traitement</strong> pour les
				métadonnées de compte et de connexion, les données de
				facturation (quand la facturation est active), les
				communications marketing que vous choisissez de
				recevoir, et la télémétrie opérationnelle de notre
				propre service.
			</li>
			<li>
				<strong>Sous-traitant</strong> pour les données d'audit,
				les enregistrements d'actions, les reçus de décision et
				les autres contenus qui passent par le runtime pour le
				compte de nos clients, et pour ce que tafs conserve pour
				eux (les exécutions, les chats, les rapports et les notes de mémoire de chaque taf et les fichiers qu'il livre).
				Les clients (les locataires) sont responsables du
				traitement de ces données ; ils nous donnent leurs
				instructions par les réglages de leur compte et la
				configuration de leur domaine. L'accord de traitement
				des données
				(<abbr title="accord de traitement des données">DPA</abbr>)
				régit cette relation ; voir le
				<a href="/fr/legal/dpa">modèle de DPA</a>
				pour les conditions publiées.
			</li>
		</ul>
		<p>
			Cette politique porte principalement sur nos traitements en
			tant que responsable du traitement. Lorsque nous évoquons
			des données traitées en tant que sous-traitant, le DPA est
			le document le plus précis.
		</p>
	</section>
}

templ privacyCategoriesFR() {
	<section id="categories">
		<h2>4. Catégories de données personnelles que nous traitons</h2>
		<p>
			Les catégories ci-dessous suivent l'inventaire technique
			publié sur
			<a href="/fr/security#data-we-process">/security#data-we-process</a>.
			En cas de divergence, la page technique fait référence et
			nous mettons cette section à jour pour qu'elle y
			corresponde.
		</p>
		<ul>
			<li>
				<strong>Identifiants de compte</strong> — votre
				identifiant d'authentification en amont (émis par notre
				fournisseur d'identité) et l'adresse e-mail avec
				laquelle vous vous connectez. Stockés tels quels
				aujourd'hui ; leur stockage sous forme d'empreinte est
				prévu.
			</li>
			<li>
				<strong>Métadonnées du locataire</strong> — identifiant
				du locataire, slug, nom affiché, horodatage de création,
				et la dernière langue utilisée par l'app de chaque
				personne, pour que les e-mails que KIFF lui envoie
				soient dans cette langue.
			</li>
			<li>
				<strong>Identifiants d'API</strong> — des
				enregistrements opaques de clés d'API (nous stockons des
				empreintes, jamais la clé en clair).
			</li>
			<li>
				<strong>Données du cookie de session</strong> — un
				cookie de session signé par HMAC, déposé après la
				connexion. Voir la section sur les cookies ci-dessous.
			</li>
			<li>
				<strong>Métadonnées des requêtes HTTP</strong> — adresse
				IP, agent utilisateur, chemin de la requête, statut de
				la réponse, latence. Conservées dans les journaux
				d'accès de notre proxy inverse pendant une durée
				limitée, pour la sécurité et la prévention des abus.
			</li>
			<li>
				<strong>Contenu contrôlé par le locataire</strong> — les
				données <code>parameters</code>, <code>actor</code> et
				<code>entity</code> que vous envoyez au runtime.
				Nous les détenons <em>en tant que sous-traitant</em>
				pour le compte du client ; le client est responsable de
				ce qui nous est transmis. Une configuration de masquage
				par domaine est prévue.
			</li>
			<li>
				<strong>Communications</strong> — les e-mails que vous
				envoyez à nos adresses d'assistance, commerciale, de
				sécurité ou de confidentialité.
			</li>
			<li>
				<strong>L'app tafs</strong> — vous vous connectez à tafs
				avec votre compte KIFF. Sur un téléphone ou une
				tablette, l'app garde votre session dans le trousseau
				(Keychain) de l'appareil (sur Android, dans son stockage
				chiffré). Sur un ordinateur, elle la garde scellée pour
				votre compte utilisateur : sur un PC Windows avec la
				protection des données propre à Windows, sur Linux dans
				votre trousseau de clés, sur un Mac dans son trousseau
				(Keychain). La session d'un ordinateur dure 90 jours au
				plus. L'app crée une clé de signature qui ne quitte
				jamais l'appareil : dans la Secure Enclave d'un iPhone,
				d'un iPad ou d'un Mac, dans le Keystore d'un appareil
				Android, ou dans le TPM d'un PC Windows. Sur Linux, et
				sur un Mac sans Secure Enclave, la clé est une clé
				logicielle conservée dans votre trousseau de clés ou
				votre trousseau (Keychain), et cet ordinateur peut
				afficher ce qui vous attend mais pas l'approuver ; vous
				approuvez sur votre téléphone{ macSecurityKey("fr") }. Un PC Windows sans TPM ne
				peut pas se connecter à tafs. KIFF conserve la moitié
				publique de la clé, le nom et la plateforme de
				l'appareil, et les dates de son ajout et de sa
				dernière utilisation, pour pouvoir vérifier vos
				réponses aux appels retenus et vos approbations de
				connexions. Si vous approuvez avec une clé d'accès
				(passkey) sur votre ordinateur, comme Windows Hello ou
				une clé de sécurité, votre visage, votre empreinte
				digitale ou votre code PIN restent dans le système
				propre à l'ordinateur ; KIFF conserve la clé publique de
				la clé d'accès, son identifiant, un compteur et un nom,
				jamais rien de secret, et refuse une clé d'accès
				synchronisée avec d'autres appareils. Si vous activez
				les alertes sur un téléphone, une tablette ou un Mac qui exécute l'app iPad,
				nous conservons le jeton push de l'appareil avec votre
				identifiant de personne KIFF, et la langue affichée par
				l'app, pour que ses alertes soient dans cette langue. Le
				service tafs conserve aussi la langue du compte, celle
				de la dernière personne qui a discuté avec Coach,
				pendant trois mois au plus, pour que les rapports d'un
				taf soient dans cette langue. L'alerte d'un téléphone
				passe par Apple ou Google avec seulement quel taf et ce
				qu'il veut, et, dans l'alerte d'une porte, le nom ou
				l'adresse e-mail de la personne qui a écrit : jamais de
				montant ni de détails d'une demande. L'app les ajoute
				sur l'appareil lui-même, depuis KIFF, si bien que
				l'alerte d'un téléphone déverrouillé peut afficher un
				montant, un commerçant ou une personne. Sur un téléphone
				Android verrouillé, elle n'affiche que « Un taf vous attend », et sur un iPhone verrouillé aussi, sauf si vous avez réglé ses aperçus pour qu'ils s'affichent toujours.
				<strong>Votre montre :</strong> une montre ne détient ni mot de passe ni clé, ne communique qu'avec votre téléphone associé, et n'approuve jamais. Elle n'envoie ce que vous dites à Coach, ou au taf que vous avez choisi, que sous forme de texte, via le téléphone, une fois que vous avez autorisé l'IA. C'est le service de reconnaissance vocale de la montre elle-même, celui d'Apple ou de Google, qui transforme vos paroles en ce texte. Elle ne peut refuser, bloquer ou envoyer à Coach ou à un taf que lorsqu'elle a un verrouillage d'écran ou un code et qu'elle est déverrouillée. Ce que vous envoyez à un taf va dans le chat de ce taf, comme si vous l'aviez écrit sur votre téléphone. Le chat d'un taf, montants compris, ne s'affiche sur la montre que tant qu'il est ouvert, lu via le téléphone à chaque fois ; la montre n'en garde rien. <strong>Apple Watch :</strong> elle affiche vos tafs et leurs pages sans les garder. Elle ne garde que votre Boîte de réception, dans un fichier qu'elle ne peut pas lire tant qu'elle est verrouillée : chaque appel retenu sous la forme du nom de son taf et de ce qu'il demande, jamais un montant, et les réponses de Coach à ce que vous avez envoyé depuis la montre, sous forme de texte. Si vous vous déconnectez sur la montre, elle garde aussi une trace de cette déconnexion, jusqu'à ce que vous vous reconnectiez sur la montre. À part cela, elle ne garde rien si la montre n'a pas de code. La Boîte de réception est effacée quand vous vous déconnectez sur la montre ou que votre iPhone se déconnecte, ou la prochaine fois que l'app s'ouvre ou se ferme sans code. Elle ne fait aucun enregistrement, et les seules notifications qu'elle affiche sont celles de votre iPhone. <strong>Wear OS :</strong> elle affiche l'adresse e-mail de votre compte, le calendrier du jour et les pages de vos tafs sans les garder. Elle garde votre Boîte de réception, où chaque ligne est le nom d'un taf et ce qu'il dit, jamais un montant, et un message gardé pour plus tard, sous forme de texte. Vous déconnecter, sur la montre ou sur le téléphone, efface tout cela. Pour sa carte, elle garde aussi le nombre de ce qui vous attend, affiché seulement quand la montre est déverrouillée, et effacé quand vous vous déconnectez, ou la prochaine fois que la carte s'affiche alors que la montre est verrouillée ou n'a pas de verrouillage d'écran. Après une déconnexion sur la montre, elle garde une trace de cette déconnexion, jusqu'à ce que vous vous reconnectiez. La Boîte de réception est aussi effacée la prochaine fois que l'app s'ouvre ou se ferme alors que la montre est verrouillée ou n'a pas de verrouillage d'écran. Un message gardé pour plus tard reste jusqu'à ce que vous l'envoyiez ou le supprimiez, puisque vous avez demandé qu'il soit envoyé. La montre ne garde aucun enregistrement. Le résultat d'un taf peut rester dans les notifications de la montre jusqu'à ce que vous le fermiez ou que vous vous déconnectiez sur la montre. Sur un PC Windows, un ordinateur Linux ou un Mac avec l'app macOS 12, les alertes sont créées par l'app elle-même pendant qu'elle tourne, sans jeton push et sans passer par aucune autre société. Sous Windows et Linux, elles indiquent quel taf, ce qu'il veut faire, le montant, pourquoi et pour quand ; dans l'app macOS 12, elles affichent les mots de KIFF pour l'appel, une fois que vous les avez activées, et un écran verrouillé affiche ce que permet le réglage d'aperçu du Mac.
				Sous Windows, elles sont désactivées jusqu'à ce que vous
				les activiez, et n'affichent que « Un taf vous attend »
				quand l'écran est verrouillé. Une alerte affichée avant
				le verrouillage de l'écran garde ses détails dans la
				liste de notifications de Windows. Sous Linux, elles
				sont activées jusqu'à ce que vous les désactiviez, et ce
				qu'affiche un écran verrouillé dépend de votre bureau.
				Quand vous connectez une app,
				vous vous connectez chez le fournisseur de l'app lui-même. Pour une app à laquelle planque se connecte lui-même, comme Stripe, ou une clé que vous fournissez, planque conserve ce jeton ou cette clé pour votre entreprise, chiffrés ; pour une connexion gérée, Composio, le service de connexion avec lequel planque travaille, détient l'authentification, et planque ne conserve que l'enregistrement de la connexion et les outils que vous avez approuvés (le tout en tant que sous-traitant, voir ci-dessous). L'enregistrement de chaque connexion comprend le compte avec lequel l'authentification a été faite (son nom ou son adresse e-mail), pour que l'app puisse vous montrer lequel c'est. KIFF n'utilise des connexions gérées que pour les apps citées sur <a href="/fr/subprocessors#composio">/subprocessors</a>.
				L'app ne contient aucun traceur d'analyse ou de
				publicité.
			</li>
			<li>
				<strong>Achats sur l'App Store</strong> — quand vous
				achetez Solo ou un pack de crédits dans tafs, c'est
				Apple qui vous le vend : Apple est le vendeur officiel,
				encaisse le paiement et conserve vos informations de
				paiement. Apple nous indique ce qui a été acheté, pour
				quel compte KIFF (un identifiant aléatoire que l'app
				joint à l'achat), quand, l'identifiant de transaction
				d'Apple et, pour Solo, quand la période se termine ou se
				renouvelle. Nous nous en servons pour ajouter les
				crédits ou le forfait à votre compte. Apple ne nous
				donne ni votre identifiant Apple, ni votre nom, ni votre
				adresse e-mail, ni votre carte.
			</li>
			<li>
				<strong>Achats sur Google Play</strong> — sur Android,
				les mêmes achats passent par la facturation de Google
				Play : Google encaisse le paiement et conserve vos
				informations de paiement. Google nous indique ce qui a
				été acheté, pour quel compte KIFF (le même identifiant
				aléatoire), quand, le jeton de l'achat et l'identifiant
				de la commande et, pour Solo, quand la période se
				termine ou se renouvelle, et nous nous en servons de la
				même façon. Google ne nous donne ni votre compte Google,
				ni votre nom, ni votre adresse e-mail, ni votre carte.
			</li>
		</ul>
	</section>
}

templ privacyLawfulBasesFR() {
	<section id="lawful-bases">
		<h2>5. Bases juridiques du traitement</h2>
		<p>
			Au titre de l'article 6 du RGPD, nous nous appuyons sur les
			bases juridiques suivantes :
		</p>
		<ul>
			<li>
				<strong>L'exécution d'un contrat</strong> (article 6,
				paragraphe 1, point b)) — pour la création du compte,
				l'authentification, l'exploitation du runtime pour votre
				compte, la facturation (quand elle est active) et les
				fonctions essentielles du service.
			</li>
			<li>
				<strong>Les intérêts légitimes</strong> (article 6,
				paragraphe 1, point f))
				— pour la sécurité, la prévention de la fraude, la
				détection des abus, la télémétrie opérationnelle et la
				protection du service. Nous mettons en balance nos
				intérêts et vos droits, et nous vous dirons sur demande
				ce que cette mise en balance a donné.
			</li>
			<li>
				<strong>Le consentement</strong> (article 6, paragraphe 1, point a)) — pour l'IA de l'app tafs : ce qui est envoyé au modèle d'IA qui fait fonctionner Coach et vos tafs, décrit <a href="#ai-in-tafs">ci-dessous</a>. Rien n'est envoyé tant que vous ne l'autorisez pas, et vous pouvez retirer votre accord dans Compte. C'est aussi le consentement que nous demanderions avant tout cookie d'analyse, toute communication marketing facultative ou tout nouveau traitement qui étendrait de façon importante notre usage de vos données. Nous ne faisons ni analyse, ni publicité, ni suivi non essentiel.
			</li>
			<li>
				<strong>L'obligation légale</strong> (article 6,
				paragraphe 1, point c))
				— pour les pièces fiscales (loi comptable estonienne,
				§ 12, 7 ans), les réponses aux demandes légales des
				autorités, et la conservation exigée par les règles de
				lutte contre le blanchiment d'argent, le cas échéant.
			</li>
		</ul>
		<h3 id="ai-in-tafs">L'IA dans l'app tafs</h3>
		<p>L'app tafs vous demande votre accord avant que quoi que ce soit parte vers l'IA, avec ces mots :</p>
		<ul>
			<li>tafs utilise l'IA Claude d'Anthropic pour faire fonctionner Coach et vos tafs.</li>
			<li>Coach et vos tafs sont des agents d'IA : ce qu'ils écrivent est généré par une IA et peut être faux. Un message qu'un taf envoie hors de votre entreprise indique qu'il a été rédigé par un agent d'IA.</li>
			<li>Ce qui lui est envoyé : ce que vous écrivez à Coach et à vos tafs, les fichiers que vous joignez, ce que vos apps connectées renvoient à un taf pendant qu'il travaille, et ce qui est à l'écran quand Coach vous aide dans l'app.</li>
			<li>Ce qui n'est jamais envoyé : les mots de passe et clés qu'utilisent vos apps connectées, ni votre empreinte.</li>
			<li>Anthropic s'en sert pour répondre et le garde jusqu'à 30 jours.</li>
			<li>Rien n'est envoyé tant que vous ne l'autorisez pas. Vous pouvez retirer votre accord dans Compte.</li>
		</ul>
		<p>Un taf qui s'exécute sans personne présente à ce moment-là (selon son horaire, ou quand quelque chose arrive) repose sur le consentement de la personne qui l'a créé ou repris, sinon sur celui de la première personne qui gère les tafs du compte à l'avoir autorisé.</p>
		<p><strong>Quand vous retirez votre accord,</strong> Coach et vos tafs ne vous répondent plus. Un taf dont les exécutions reposent sur votre consentement se met en pause : ses horaires s'arrêtent et ce qui arrive attend. Il reprend dès que le consentement est donné à nouveau, ou qu'une personne qui gère les tafs du compte le reprend avec le sien. Le retrait ne change rien à ce qui a été envoyé avant.</p>
		<p>Anthropic figure sur <a href="/fr/subprocessors">/subprocessors</a>, avec le lieu du traitement et les cas où il peut garder des données plus longtemps.</p>
	</section>
}

templ privacySubprocessorsFR() {
	<section id="sub-processors">
		<h2>6. Sous-traitants ultérieurs</h2>
		<p>Nous ne vendons pas vos données personnelles et ne les partageons pas à des fins publicitaires.</p>
		<p>
			Nous faisons appel à un petit nombre de prestataires pour
			fournir le service. La liste officielle et à jour se trouve
			sur
			<a href="/fr/subprocessors">/subprocessors</a> ;
			cette page est mise à jour dans les 30 jours suivant toute
			modification. Nous exigeons de chaque sous-traitant
			ultérieur, par des accords écrits, des protections
			équivalentes aux nôtres, y compris les clauses
			contractuelles types de l'UE lorsque des données
			personnelles quittent l'UE.
		</p>
		<p>
			Les ajouts ou remplacements substantiels de sous-traitants
			ultérieurs qui touchent des données personnelles sont
			notifiés à l'avance aux clients actifs, qui ont un droit
			d'opposition.
		</p>
	</section>
}

templ privacyTransfersFR() {
	<section id="transfers">
		<h2>7. Transferts internationaux</h2>
		<p>
			Certains de nos sous-traitants ultérieurs sont établis hors
			de l'Espace économique européen, principalement aux
			États-Unis. Pour chacun de ces transferts, nous nous
			appuyons sur au moins une des garanties suivantes :
		</p>
		<ul>
			<li>
				<strong>Le cadre de protection des données UE–États-Unis</strong> —
				pour les sous-traitants ultérieurs américains qui sont
				certifiés au titre de ce cadre. Décision d'adéquation en
				vigueur depuis mi-2023 ; nous surveillons tout
				changement de son statut.
			</li>
			<li>
				<strong>Les clauses contractuelles types</strong> —
				module 2 (de responsable du traitement à sous-traitant)
				pour nos sous-traitants ultérieurs directs et module 3
				(de sous-traitant à sous-traitant ultérieur) lorsque des
				sous-traitants s'enchaînent. Nous utilisons les clauses
				contractuelles types approuvées par la Commission en
				2021.
			</li>
			<li>
				<strong>Des mesures supplémentaires</strong> — lorsque
				l'évaluation des risques indique que des garanties
				additionnelles se justifient (chiffrement en transit et
				au repos, journalisation des accès, minimisation des
				données).
			</li>
		</ul>
		<p>
			Vous pouvez demander l'instrument de transfert précis qui
			s'applique à un sous-traitant ultérieur donné en écrivant à
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
		<p><strong>Votre pays.</strong> Dans certains pays, la loi demande davantage que ce que dit cette politique. Ce qu'elle ajoute figure, en anglais et dans la langue du pays, sur <a href="/privacy/countries">Votre pays</a>.</p>
	</section>
}

templ privacyRetentionFR() {
	<section id="retention">
		<h2>8. Conservation</h2>
		<p>
			Nous conservons les données personnelles pendant la durée
			la plus courte compatible avec les finalités pour
			lesquelles nous les traitons et avec toute obligation
			légale applicable.
		</p>
		<ul>
			<li>
				<strong>Métadonnées de compte et de connexion</strong> —
				jusqu'à la suppression du compte. Dans l'app tafs, un
				propriétaire le supprime dans Compte → <em>Supprimer
				le compte</em>. Un compte créé sur le web est supprimé
				en écrivant à
				<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>,
				dans le délai d'un mois de l'article 12, paragraphe 3,
				du RGPD. Dans les deux cas, les clés du compte cessent
				de fonctionner immédiatement. S'il est supprimé dans
				l'app tafs, c'est irréversible : ses chats, ses notes et ses
				connexions tafs sont effacés immédiatement, et ce que
				KIFF conserve est effacé sous 30 jours. S'il est supprimé
				sur le web, nous gardons ses données pendant un délai de grâce
				de 30 jours, au cas où le propriétaire voudrait le
				récupérer, puis nous les effaçons.
			</li>
			<li>
				<strong>Enregistrements de clés d'API</strong> —
				jusqu'à la suppression du compte, y compris après la
				révocation d'une clé. Une clé qui appartient à une
				connexion d'agent par authentification est supprimée
				avec cette connexion, 30 jours après sa fin.
			</li>
			<li>
				<strong>Cookies de session</strong> — jusqu'à leur
				expiration (24 heures par défaut) ou jusqu'à votre
				déconnexion.
			</li>
			<li>
				<strong>Journaux d'accès du proxy inverse</strong> —
				jusqu'à 90 jours, puis agrégés ou supprimés.
			</li>
			<li>
				<strong>Journaux de service</strong> — ce que les
				services de KIFF et planque enregistrent en
				fonctionnant : les erreurs, et les requêtes, qui peuvent
				nommer un compte, une personne ou un agent. 30 jours,
				puis supprimés.
			</li>
			<li>
				<strong>Sauvegardes</strong> — la base de données de
				KIFF est sauvegardée chaque jour, chiffrée, et chaque
				sauvegarde est gardée 7 jours : un enregistrement
				supprimé en a donc disparu sous 7 jours. Les stockages de
				tafs et de planque gardent pendant 35 jours des copies
				chiffrées à un instant donné, qui ne servent qu'à
				restaurer un stockage après une panne : un enregistrement
				supprimé en a donc disparu sous 35 jours.
			</li>
			<li>
				<strong>Données d'audit du locataire</strong> — détenues
				en tant que sous-traitant, selon la configuration du
				locataire du client. Par défaut : conservées aussi
				longtemps que le locataire existe ; supprimées à la
				suppression du locataire. Voir
				<a href="/fr/security#deletion">/security#deletion</a>.
			</li>
			<li>
				<strong>Appels par la passerelle KIFF</strong> — les
				arguments d'un appel jusqu'à ce qu'il soit envoyé,
				refusé ou qu'il échoue, puis supprimés ; le résultat de
				l'outil pendant 24 heures, puis supprimé.
				L'enregistrement de la décision et une empreinte des
				arguments sont conservés comme données d'audit du
				locataire. Voir
				<a href="/fr/security#data-kept">/security#data-kept</a>.
			</li>
			<li>
				<strong>Utilisation</strong> — pour chaque appel par la
				passerelle, une fois terminé : quel agent l'a fait,
				l'outil, et s'il a compté comme une action ou était
				gratuit (et pourquoi). Pour chaque exécution d'un taf ou
				de Coach, une fois terminée : le taf, quand, les crédits
				que son IA a utilisés, et s'ils ont compté ou pourquoi
				non. Jusqu'à la suppression du compte ; ce qui est
				transmis à notre prestataire de paiement pour la
				facturation est conservé avec les pièces de facturation.
			</li>
			<li>
				<strong>Connexions d'agent par authentification</strong> —
				quel agent, le nom de l'app, qui l'a autorisée, quand,
				et sa dernière utilisation : tant que la connexion est
				active, puis 30 jours après sa fin (elle reste listée
				dans le tableau de bord pendant ce temps), puis elle
				est supprimée avec ses jetons et sa clé d'API. Tout est
				supprimé avec le compte.
			</li>
			<li>
				<strong>tafs</strong> — le jeton push d'un appareil
				jusqu'à ce que vous vous déconnectiez de l'app, que vous
				retiriez l'appareil, ou qu'Apple ou Google signale que
				le jeton n'existe plus. La clé publique, le nom, la plateforme et les dates d'un
				appareil pendant que vous l'utilisez ; une fois que vous
				le déconnectez, il est marqué comme retiré et conservé
				jusqu'à la suppression du compte, pour que KIFF puisse
				refuser une réponse tardive venant de lui et montrer
				quel appareil a signé une réponse antérieure. La clé
				publique, l'identifiant et le nom d'une clé d'accès sont
				conservés comme ceux de son appareil. Un ordinateur
				garde sa session 90 jours au plus, ou jusqu'à ce que
				vous vous déconnectiez. Ce que tafs conserve pour votre entreprise est détenu en
				tant que sous-traitant : les exécutions et les chats
				d'un taf, avec le résumé d'un chat (et celui de
				Setup), pendant 30 jours, ce que vos apps
				renvoient seulement jusqu'à la fin d'une exécution (dans
				un chat, ce qu'il a seulement lu est conservé chiffré
				pour ses messages suivants, utilisé jusqu'à ce que le
				chat soit resté inactif une heure, et au plus quatre
				heures après la lecture, puis supprimé automatiquement,
				sous quelques jours), et ses notes de mémoire
				jusqu'à la
				suppression du taf ; les fichiers qu'il livre 30 jours à partir de l'exécution qui les a créés, puis supprimés automatiquement dans un délai d'un jour, ou plus tôt si quelqu'un de votre compte en supprime un ; le jeton ou la clé d'une connexion dans planque, ou l'authentification d'une connexion gérée chez Composio, jusqu'à ce que vous la déconnectiez, et
				l'enregistrement de ses approbations jusqu'à la clôture du
				compte ; voir l'<a href="/fr/legal/dpa#annex-4">annexe 4 du DPA</a>.
			</li>
			<li>
				<strong>Pièces de facturation</strong> — 7 ans à
				compter de la fin de l'exercice (loi comptable
				estonienne, § 12).
			</li>
			<li>
				<strong>Achats sur l'App Store et Google Play</strong> —
				ce qu'Apple ou Google nous a indiqué sur chaque achat
				reste dans votre compte jusqu'à sa suppression. Leurs
				rapports de ventes et de versements, que nous gardons
				comme pièces de facturation pendant 7 ans, ne vous
				nomment pas.
			</li>
			<li>
				<strong>Correspondance avec l'assistance</strong> —
				3 ans à compter du dernier échange, puis supprimée.
			</li>
		</ul>
	</section>
}

templ privacyRightsFR() {
	<section id="rights">
		<h2>9. Vos droits</h2>
		<p>
			Au titre du RGPD, vous disposez des droits suivants sur vos
			données personnelles :
		</p>
		<ul>
			<li><strong>Accès</strong> (article 15) — la confirmation que nous traitons ou non vos données, et une copie de celles-ci.</li>
			<li><strong>Rectification</strong> (article 16) — la correction de données inexactes ou incomplètes.</li>
			<li><strong>Effacement</strong> (article 17) — la suppression de vos données, sous réserve des exceptions liées à la conservation légale.</li>
			<li><strong>Limitation</strong> (article 18) — la suspension du traitement pendant qu'un litige est résolu.</li>
			<li><strong>Portabilité</strong> (article 20) — un export, lisible par machine, des données que vous avez fournies.</li>
			<li><strong>Opposition</strong> (article 21) — au traitement fondé sur les intérêts légitimes ; nous arrêtons, sauf si nous pouvons démontrer des motifs impérieux.</li>
			<li><strong>Retrait du consentement</strong> (article 7, paragraphe 3) — pour tout traitement fondé sur le consentement, comme l'IA de l'app tafs (dans Compte, voir <a href="#ai-in-tafs">plus haut</a>). Le retrait n'affecte pas le traitement licite antérieur.</li>
		</ul>
		<p>
			Pour exercer l'un de ces droits, écrivez à
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
			Nous répondons dans un délai d'un mois, conformément à
			l'article 12, paragraphe 3 ; nous pouvons prolonger ce
			délai de deux mois au plus pour les demandes complexes, et
			nous vous le dirons si nous le faisons.
		</p>
		<h3 id="export-chats">Vos propres chats tafs</h3>
		<p>
			Dans l'app tafs, Compte →  Exporter mes chats
			télécharge vos propres chats avec chaque taf, ceux avec
			Coach compris, les noms des fichiers que vous avez joints,
			et vos propres notes, sous forme de fichier lisible et de
			JSON. Vous seul pouvez les exporter : un administrateur ou
			le propriétaire du compte ne le peut pas, et l'export du
			compte KIFF ne les contient pas.
		</p>
		<h3 id="delete-account">Supprimer votre compte tafs</h3>
		<p>
			tafs est l'app de KIFF. Pour supprimer votre compte tafs et
			ses données :
		</p>
		<ol>
			<li>Ouvrez l'app tafs et connectez-vous.</li>
			<li>Allez dans Compte, puis touchez <em>Supprimer le compte</em>.</li>
			<li>Confirmez. La suppression d'un compte est irréversible.</li>
		</ol>
		<p>
			<em>Supprimer le compte</em> s'affiche pour la personne qui
			a le droit de supprimer le compte de l'entreprise, en
			général son propriétaire. Si vous ne le voyez pas, ou si
			vous n'avez plus l'app, écrivez à
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			depuis l'adresse avec laquelle vous vous connectez, et nous
			supprimons vos données dans un délai d'un mois.
		</p>
		<p>
			Ce qui est supprimé : les clés du compte cessent de
			fonctionner immédiatement. Ses tafs, ses chats, ses notes,
			ses fichiers joints et ses connexions sont effacés
			immédiatement, et de leurs copies à un instant donné sous
			35 jours. Ce que KIFF conserve pour le compte est
			effacé sous 30 jours, et des sauvegardes dans les 7 jours
			qui suivent. Les journaux de service qui nomment le compte
			disparaissent sous 30 jours. Les données d'audit du locataire sont
			supprimées avec le locataire. Voir
			<a href="#retention">Conservation</a> pour chaque type de
			données.
		</p>
		<p id="delete-data">
			Pour supprimer une partie de vos données et garder le
			compte : dans l'app, supprimez un chat, et ses messages et
			ses fichiers joints partent avec lui ; supprimez un taf, et
			ses chats, ses notes et ses connexions partent avec lui.
			Pour tout le reste, écrivez à
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			en indiquant ce qu'il faut supprimer. Nous le faisons dans
			un délai d'un mois.
		</p>
		<p>
			Vous avez le droit d'introduire une réclamation auprès
			d'une autorité de contrôle. Notre autorité de contrôle chef
			de file est
			l'<a href="https://www.aki.ee/en" target="_blank" rel="noopener">Inspection estonienne de la protection des données (Andmekaitse Inspektsioon)</a>.
			Vous pouvez aussi vous adresser à l'autorité de contrôle de
			l'État membre où vous résidez.
		</p>
		<p><strong>Votre pays.</strong> Dans certains pays, la loi demande davantage que ce que dit cette politique. Ce qu'elle ajoute figure, en anglais et dans la langue du pays, sur <a href="/privacy/countries">Votre pays</a>.</p>
	</section>
}

templ privacyCookiesFR() {
	<section id="cookies">
		<h2>10. Cookies</h2>
		<p>
			Nous déposons trois cookies, tous strictement nécessaires,
			internes, envoyés uniquement en HTTPS et illisibles par les
			scripts de la page. Selon les règles européennes ePrivacy,
			ils ne demandent pas de consentement ; nous les listons
			pour que vous sachiez qu'ils existent. La
			<a href="/fr/cookies">politique relative aux cookies</a> en
			donne le détail.
		</p>
		<ul>
			<li>
				<strong><code>kiff_session</code></strong> — vous garde
				connecté. Un cookie de session signé qui contient votre
				identifiant de connexion, votre adresse e-mail et votre nom, et
				l'identifiant d'accès que le tableau de bord utilise
				pour vous. Déposé pour <code>.kiff.dev</code>. Il dure
				24 heures, ou jusqu'à votre déconnexion.
			</li>
			<li>
				<strong><code>kiff_flash</code></strong> — porte un
				message ponctuel jusqu'à la page suivante, par exemple
				« votre clé a été créée ». Signé ; une nouvelle clé ne
				s'y trouve jamais. Déposé pour
				<code>.kiff.dev</code>. Supprimé quand la page suivante
				le lit, et au plus tard après 5 minutes.
			</li>
			<li>
				<strong><code>kiff_cb_attempts</code></strong> — compte
				combien de fois la page de connexion s'est rechargée,
				pour arrêter une connexion qui tourne en boucle. Envoyé
				uniquement à cette page. Il dure 5 minutes, et il est
				effacé quand une connexion commence ou réussit.
			</li>
		</ul>
		<p>
			Nous n'utilisons ni cookies d'analyse, ni cookies
			publicitaires, ni aucun traceur tiers. Si nous en ajoutons
			un jour, nous afficherons un bandeau de consentement avant
			que le cookie ne soit déposé, conformément aux règles
			ePrivacy et aux lignes directrices 2023 du CEPD sur les
			technologies de traçage.
		</p>
		<p>
			Si vous vous connectez via Clerk (notre sous-traitant
			ultérieur pour l'authentification), Clerk dépose aussi des
			cookies sur son propre domaine d'interface
			(<code>clerk.kiff.dev</code>). Ces cookies sont nécessaires
			pour que Clerk vous reconnaisse tout au long de son
			parcours de connexion, et ils sont régis par la politique
			de confidentialité de Clerk ainsi que par la nôtre. Voir la
			liste des sous-traitants ultérieurs pour le détail.
		</p>
	</section>
}

templ privacySecurityFR() {
	<section id="security">
		<h2>11. Sécurité</h2>
		<p>
			Nos mesures de sécurité techniques et organisationnelles
			sont décrites sur <a href="/fr/security">/security</a>.
			Elles comprennent l'isolation des locataires au niveau de
			la base de données, TLS 1.2+ en transit, le chiffrement au
			repos avec les réglages par défaut du service géré, et
			des contrôles d'accès fondés sur le principe du moindre
			privilège.
		</p>
		<p>
			Nous notifions aux clients concernés toute violation de
			données personnelles dans les meilleurs délais et dans les
			72 heures suivant sa confirmation, conformément à
			l'article 33 du RGPD. La notification comprend la nature de
			la violation, les catégories et le nombre approximatif de
			personnes concernées et d'enregistrements concernés, les
			conséquences probables, et les mesures prises ou
			proposées.
		</p>
	</section>
}

templ privacyChildrenFR() {
	<section id="children">
		<h2>12. Enfants</h2>
		<p>
			KIFF Cloud est un produit d'infrastructure pour
			développeurs, qui ne s'adresse pas aux enfants. Nous ne
			collectons pas sciemment de données personnelles d'enfants
			de moins de 16 ans. Si vous pensez qu'un enfant nous a
			fourni des données personnelles, contactez
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>
			et nous les supprimerons.
		</p>
	</section>
}

templ privacyAutomatedFR() {
	<section id="automated">
		<h2>13. Décisions automatisées</h2>
		<p>
			Le runtime de KIFF Cloud prend des décisions de politique
			déterministes sur les données envoyées par nos clients. Ce
			ne sont pas des décisions à votre sujet qui produisent des
			effets juridiques ou vous affectent de manière
			significative de façon similaire, au sens de l'article 22
			du RGPD ; ce sont des décisions sur les actions du client
			(remboursements, commandes, messages, etc.), exécutées
			selon la politique propre au client.
		</p>
		<p>
			Les clients qui utilisent KIFF Cloud pour prendre des
			décisions touchant leurs propres utilisateurs finaux sont
			eux-mêmes responsables du respect de l'article 22. Nos
			reçus de gouvernance sont conçus pour donner à ces clients
			la piste d'audit dont ils ont besoin pour démontrer un
			contrôle humain, mais l'obligation légale d'assurer ce
			contrôle incombe au client.
		</p>
	</section>
}

templ privacyChangesFR() {
	<section id="changes">
		<h2>14. Modifications de cette politique</h2>
		<p>
			Nous pouvons mettre à jour cette politique de temps à
			autre. Les modifications substantielles sont notifiées par
			e-mail aux clients actifs et par un bandeau bien visible
			sur cette page pendant au moins 30 jours. Les modifications
			non substantielles sont publiées avec une nouvelle date de
			« dernière mise à jour ».
		</p>
	</section>
}

templ privacyContactFR() {
	<section id="contact">
		<h2>15. Nous contacter</h2>
		<p>
			Questions de confidentialité et demandes d'exercice de
			droits :
			<a href="mailto:privacy@kiff.dev">privacy@kiff.dev</a>.
		</p>
		<p>
			Notifications juridiques formelles à Kiff Agents OÜ :
			<a href="mailto:legal@kiff.dev">legal@kiff.dev</a>,
			ou par courrier à Tööstuse tn 75-71, Põhja-Tallinna
			linnaosa, Tallinn 10416, Estonie.
		</p>
		<p>
			Autorité de contrôle chef de file pour les réclamations :
			<a href="https://www.aki.ee/en" target="_blank" rel="noopener">Inspection estonienne de la protection des données (Andmekaitse Inspektsioon)</a>.
		</p>

		<hr/>

		<p class="legal-footnote">
			<strong>Version du document :</strong> v0.1.<br/>
			<strong>Dernière mise à jour :</strong> 17 novembre 2026.
		</p>
	</section>
}
