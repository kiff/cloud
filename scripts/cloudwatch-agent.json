{
  "agent": {
    "run_as_user": "root",
    "metrics_collection_interval": 60
  },
  "metrics": {
    "namespace": "KiffCloud/Healthz",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "mem": {
        "measurement": [
          "mem_used_percent",
          "mem_available"
        ]
      },
      "swap": {
        "measurement": [
          "swap_used_percent"
        ]
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/lib/caddy/logs/caddy-api.log",
            "log_group_name": "/kiff/caddy",
            "log_stream_name": "{instance_id}/api",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/lib/caddy/logs/caddy-web.log",
            "log_group_name": "/kiff/caddy",
            "log_stream_name": "{instance_id}/web",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/lib/caddy/logs/caddy-mcp.log",
            "log_group_name": "/kiff/caddy",
            "log_stream_name": "{instance_id}/mcp",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/lib/caddy/logs/caddy-app.log",
            "log_group_name": "/kiff/caddy",
            "log_stream_name": "{instance_id}/app",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/kiff/kiff-api-*.log",
            "publish_multi_logs": true,
            "log_group_name": "/kiff/api",
            "log_stream_name": "{instance_id}/api",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/kiff/kiff-gateway-*.log",
            "publish_multi_logs": true,
            "log_group_name": "/kiff/api",
            "log_stream_name": "{instance_id}/gateway",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/kiff/kiff-web-*.log",
            "publish_multi_logs": true,
            "log_group_name": "/kiff/web",
            "log_stream_name": "{instance_id}/web",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
