[Unit]
Description=Refresh kiff-api credentials after RDS secret rotation
Documentation=https://github.com/kiff/cloud
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/kiff/db-refresh.env
ExecStart=/opt/kiff/bin/refresh-db-credentials.sh
User=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/kiff
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kiff-db-credential-refresh
