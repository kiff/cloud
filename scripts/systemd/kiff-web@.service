[Unit]
Description=kiff-cloud web binary (web)
Documentation=https://github.com/kiff/cloud
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/kiff/web.env
ExecStart=/opt/kiff/bin/kiff-web -addr=127.0.0.1:%i
Restart=on-failure
RestartSec=5
# To a file the CloudWatch agent ships: the agent can't
# read the journal. systemd opens it as root, before the sandbox below.
StandardOutput=append:/var/log/kiff/kiff-web-%i.log
StandardError=append:/var/log/kiff/kiff-web-%i.log
SyslogIdentifier=kiff-web

# Unprivileged: a dynamic user per unit. systemd reads EnvironmentFile
# as root before dropping privileges, so the service never needs to
# read /etc/kiff itself, and cannot read other units' env files
# (gateway.env is 0600 root).
DynamicUser=yes
NoNewPrivileges=true
# No instance metadata: the instance role can read every secret in
# Secrets Manager, and this service needs none of them at runtime (its
# secrets arrive in the EnvironmentFile). Only root-run units (deploy,
# credential refresh, healthz, CloudWatch agent) use the role.
IPAddressDeny=169.254.169.254/32 fd00:ec2::254/128
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
